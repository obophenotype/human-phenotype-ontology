    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000537">
        <obo:IAO_0000115 xml:lang="fr">Pli de peau commençant au niveau de la face médiale de la paupière inférieure ou juste en dessous et s&apos;incurvant vers le haut pour couvrir, s&apos;étendre devant et latéralement au canthus médial.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Epicanthus inversus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000537"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Pli de peau commençant au niveau de la face médiale de la paupière inférieure ou juste en dessous et s&apos;incurvant vers le haut pour couvrir, s&apos;étendre devant et latéralement au canthus médial.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000537 (Epicanthus inversus)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A fold of skin starting at or just below the medial aspect of the lower lid and arching upward to cover, extend in front of and lateral to the medial canthus.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
