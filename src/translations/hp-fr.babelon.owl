        <owl:annotatedTarget xml:lang="fr">&quot;Une forme de strabisme avec un ou les deux yeux tournés vers l&apos;intérieur (&quot;&quot;croisés&quot;&quot;) à un degré relativement sévère, généralement défini comme 10 dioptries ou plus.&quot;</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000565 (Esotropia)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of strabismus with one or both eyes turned inward (&apos;crossed&apos;) to a relatively severe degree, usually defined as 10 diopters or more.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
