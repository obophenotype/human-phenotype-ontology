    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000518">
        <obo:IAO_0000115 xml:lang="fr">Une cataracte est une opacité ou un trouble qui se développe dans le cristallin de l&apos;œil ou dans sa capsule.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Opacité du cristallin</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000518"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une cataracte est une opacité ou un trouble qui se développe dans le cristallin de l&apos;œil ou dans sa capsule.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000518 (Cataract)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cataract is an opacity or clouding that develops in the crystalline lens of the eye or in its capsule.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000518"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Opacité du cristallin</owl:annotatedTarget>
        <babelon:comment>label of HP:0000518 (Cataract)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cataract</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000519">
        <obo:IAO_0000115 xml:lang="fr">Cataracte congénitale résultant d&apos;un défaut de développement, contrairement à la majorité des cataractes qui surviennent à l&apos;âge adulte à la suite de changements dégénératifs du cristallin.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Cataracte congénitale</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000519"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Cataracte congénitale résultant d&apos;un défaut de développement, contrairement à la majorité des cataractes qui surviennent à l&apos;âge adulte à la suite de changements dégénératifs du cristallin.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000519 (Developmental cataract)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cataract that occurs congenitally as the result of a developmental defect, in contrast to the majority of cataracts that occur in adulthood as the result of degenerative changes of the lens.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000519"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Cataracte congénitale</owl:annotatedTarget>
        <babelon:comment>label of HP:0000519 (Developmental cataract)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Developmental cataract</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000520">
        <obo:IAO_0000115 xml:lang="fr">Un œil qui fait saillie vers l&apos;avant par rapport au plan du visage dans une mesure plus importante que la norme.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Proptose</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000520"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Un œil qui fait saillie vers l&apos;avant par rapport au plan du visage dans une mesure plus importante que la norme.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000520 (Proptosis)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An eye that is protruding anterior to the plane of the face to a greater extent than is typical.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000520"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Proptose</owl:annotatedTarget>
        <babelon:comment>label of HP:0000520 (Proptosis)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
