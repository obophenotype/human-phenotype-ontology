    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000081">
        <obo:IAO_0000115 xml:lang="fr">Une duplication du système collecteur du rein, défini comme un rein avec deux (au lieu d&apos;un seul, normalement) systèmes pyélocaliciaires. Le système pyélocaliciel est composé du bassin rénal et des calices. Le système collecteur rénal dédoublé peut être associé à un seul uretère ou à des uretères doubles. Dans ce dernier cas, les deux uretères se jettent séparément dans la vessie ou fusionnent pour former un seul orifice urétéral.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Système collecteur rénal dupliqué</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000081"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une duplication du système collecteur du rein, défini comme un rein avec deux (au lieu d&apos;un seul, normalement) systèmes pyélocaliciaires. Le système pyélocaliciel est composé du bassin rénal et des calices. Le système collecteur rénal dédoublé peut être associé à un seul uretère ou à des uretères doubles. Dans ce dernier cas, les deux uretères se jettent séparément dans la vessie ou fusionnent pour former un seul orifice urétéral.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000081 (Duplicated collecting system)  ; abnormality of the genitourinary system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A duplication of the collecting system of the kidney, defined as a kidney with two (instead of, normally, one) pyelocaliceal systems. The pyelocaliceal system is comprised of the renal pelvis and calices. The duplicated renal collecting system can be associated with a single ureter or with double ureters. In the latter case, the two ureters empty separately into the bladder or fuse to form a single ureteral orifice.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000081"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Système collecteur rénal dupliqué</owl:annotatedTarget>
        <babelon:comment>label of HP:0000081 (Duplicated collecting system)  ; abnormality of the genitourinary system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Duplicated collecting system</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000083">
        <obo:IAO_0000115 xml:lang="fr">Réduction du niveau de performance des reins dans les domaines fonctionnels comprenant la concentration de l&apos;urine, l&apos;élimination des déchets, le maintien de l&apos;équilibre électrolytique, l&apos;homéostasie de la pression sanguine et le métabolisme du calcium.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Insuffisance rénale</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000083"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Réduction du niveau de performance des reins dans les domaines fonctionnels comprenant la concentration de l&apos;urine, l&apos;élimination des déchets, le maintien de l&apos;équilibre électrolytique, l&apos;homéostasie de la pression sanguine et le métabolisme du calcium.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000083 (Renal insufficiency)  ; abnormality of the genitourinary system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduction in the level of performance of the kidneys in areas of function comprising the concentration of urine, removal of wastes, the maintenance of electrolyte balance, homeostasis of blood pressure, and calcium metabolism.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
