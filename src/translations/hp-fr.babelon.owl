        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000253">
        <obo:IAO_0000115 xml:lang="fr">Une microcéphalie progressive est diagnostiquée lorsque le périmètre crânien est progressivement inférieur aux normes établies en fonction de l&apos;âge et du sexe.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Microcéphalie progressive</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000253"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une microcéphalie progressive est diagnostiquée lorsque le périmètre crânien est progressivement inférieur aux normes établies en fonction de l&apos;âge et du sexe.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000253 (Progressive microcephaly)  ; abnormality of the nervous system ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Progressive microcephaly is diagnosed when the head circumference falls progressively behind age- and gender-dependent norms.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
