    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000175">
        <obo:IAO_0000115 xml:lang="fr">La fente palatine est un défaut de développement du palais résultant d&apos;un défaut de fusion des apophyses palatines et se manifestant par une séparation du toit de la bouche (palais mou et palais dur).</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Fente palatine</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000175"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">La fente palatine est un défaut de développement du palais résultant d&apos;un défaut de fusion des apophyses palatines et se manifestant par une séparation du toit de la bouche (palais mou et palais dur).</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000175 (Cleft palate)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cleft palate is a developmental defect of the palate resulting from a failure of fusion of the palatine processes and manifesting as a separation of the roof of the mouth (soft and hard palate).</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000175"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Fente palatine</owl:annotatedTarget>
        <babelon:comment>label of HP:0000175 (Cleft palate)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cleft palate</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000176">
        <obo:IAO_0000115 xml:lang="fr">Les fentes sous-muqueuses du palais dur sont caractérisées par des défauts osseux sur la ligne médiane du palais osseux qui sont recouverts par la muqueuse du palais. Il peut être possible de détecter une fente sous-muqueuse du palais dur à la palpation en observant une encoche dans le palais osseux.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Fente sous-muqueuse du palais dur</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000176"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Les fentes sous-muqueuses du palais dur sont caractérisées par des défauts osseux sur la ligne médiane du palais osseux qui sont recouverts par la muqueuse du palais. Il peut être possible de détecter une fente sous-muqueuse du palais dur à la palpation en observant une encoche dans le palais osseux.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000176 (Submucous cleft hard palate)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hard-palate submucous clefts are characterized by bony defects in the midline of the bony palate that are covered by the mucous membrane of the roof of the mouth. It may be possible to detect a submucous cleft hard palate upon palpation as a notch in the bony palate.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000176"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Fente sous-muqueuse du palais dur</owl:annotatedTarget>
        <babelon:comment>label of HP:0000176 (Submucous cleft hard palate)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Submucous cleft hard palate</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
