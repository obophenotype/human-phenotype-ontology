    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000463">
        <obo:IAO_0000115 xml:lang="fr">Les narines orientées vers l&apos;avant, vues avec la tête à l&apos;horizontale de Francfort et les yeux de l&apos;observateur au même niveau que les yeux du sujet. Cela donne l&apos;apparence d&apos;un nez retroussé (pointe nasale retroussée).</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Narines antéversées</rdfs:label>
    </rdf:Description>
