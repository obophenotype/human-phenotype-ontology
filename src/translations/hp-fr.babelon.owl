        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Face étroite</owl:annotatedTarget>
        <babelon:comment>label of HP:0000275 (Narrow face)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Narrow face</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000276">
        <obo:IAO_0000115 xml:lang="fr">La hauteur (longueur) du visage est supérieure à 2 écarts-types au-dessus de la moyenne (objective) ; ou, une augmentation apparente de la hauteur (longueur) du visage (subjective).</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Face longue</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
