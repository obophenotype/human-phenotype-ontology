    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000303">
        <obo:IAO_0000115 xml:lang="fr">Une proéminence anormale du menton liée à une augmentation de la longueur de la mandibule.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Prognathisme mandibulaire</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000303"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une proéminence anormale du menton liée à une augmentation de la longueur de la mandibule.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000303 (Mandibular prognathia)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal prominence of the chin related to increased length of the mandible.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
