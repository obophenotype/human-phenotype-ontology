    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000047">
        <obo:IAO_0000115 xml:lang="fr">Position anormale du méat urétral sur la partie ventrale du pénis (dessous) caractérisée par le déplacement du méat urétral de l&apos;extrémité du gland pénien vers la surface ventrale du pénis, du scrotum ou du périnée</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Hypospadias</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000047"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Position anormale du méat urétral sur la partie ventrale du pénis (dessous) caractérisée par le déplacement du méat urétral de l&apos;extrémité du gland pénien vers la surface ventrale du pénis, du scrotum ou du périnée</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000047 (Hypospadias)  ; abnormality of the genitourinary system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal position of urethral meatus on the ventral penile shaft (underside) characterized by displacement of the urethral meatus from the tip of the glans penis to the ventral surface of the penis, scrotum, or perineum.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
