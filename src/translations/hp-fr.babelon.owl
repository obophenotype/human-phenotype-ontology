        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000250">
        <obo:IAO_0000115 xml:lang="fr">Une augmentation anormale de la densité des os constituant la calvaria.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Calvaria dense</rdfs:label>
    </rdf:Description>
