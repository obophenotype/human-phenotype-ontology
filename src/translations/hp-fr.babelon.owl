        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypometric saccades</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000572">
        <obo:IAO_0000115 xml:lang="fr">&quot;Perte d&apos;acuité visuelle (impliquant que la vision était meilleure à un certain moment de la vie). Dans le cas contraire, il convient d&apos;utiliser le terme &quot;&quot;acuité visuelle réduite&quot;&quot; (ou une sous-classe de ce terme).&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Cécité</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000572"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">&quot;Perte d&apos;acuité visuelle (impliquant que la vision était meilleure à un certain moment de la vie). Dans le cas contraire, il convient d&apos;utiliser le terme &quot;&quot;acuité visuelle réduite&quot;&quot; (ou une sous-classe de ce terme).&quot;</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000572 (Visual loss)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Loss of visual acuity (implying that vision was better at a certain time point in life). Otherwise the term reduced visual acuity should be used (or a subclass of that).</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000572"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Cécité</owl:annotatedTarget>
        <babelon:comment>label of HP:0000572 (Visual loss)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Visual loss</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000573">
        <obo:IAO_0000115 xml:lang="fr">Hémorragie dans la rétine</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Hémorragie rétinienne</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000573"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Hémorragie dans la rétine</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000573 (Retinal hemorrhage)  ; abnormality of the cardiovascular system ; abnormality of the eye ; abnormality of blood and blood-forming tissues</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bleeding located within the retina. Retinal hemorrhages range from the smallest dot and blot hemorrhage to massive sub-hyaloid hemorrhage.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
