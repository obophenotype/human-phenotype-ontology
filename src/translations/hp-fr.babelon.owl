        <owl:annotatedTarget xml:lang="fr">Anomalie de la taille du crâne</owl:annotatedTarget>
        <babelon:comment>label of HP:0000240 (Abnormality of skull size)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of skull size</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000242">
        <obo:IAO_0000115 xml:lang="fr">La bosse pariétale est une proéminence marquée dans la région pariétale.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Proéminence pariétale</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000242"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">La bosse pariétale est une proéminence marquée dans la région pariétale.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000242 (Parietal bossing)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Parietal bossing is a marked prominence in the parietal region.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000242"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Proéminence pariétale</owl:annotatedTarget>
        <babelon:comment>label of HP:0000242 (Parietal bossing)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Parietal bossing</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000243">
        <obo:IAO_0000115 xml:lang="fr">Tête cunéiforme ou triangulaire, avec le sommet du triangle sur la ligne médiane du front et la base du triangle sur l&apos;occiput.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Trigonocéphalie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000243"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Tête cunéiforme ou triangulaire, avec le sommet du triangle sur la ligne médiane du front et la base du triangle sur l&apos;occiput.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000243 (Trigonocephaly)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Wedge-shaped, or triangular head, with the apex of the triangle at the midline of the forehead and the base of the triangle at the occiput.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000243"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Trigonocéphalie</owl:annotatedTarget>
        <babelon:comment>label of HP:0000243 (Trigonocephaly)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Trigonocephaly</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000244">
        <obo:IAO_0000115 xml:lang="fr">Hauteur verticale anormale du crâne et raccourcissement de sa longueur antéro-postérieure, fréquemment associés à des malformations de la région occipitale.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Brachyturricéphalie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000244"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Hauteur verticale anormale du crâne et raccourcissement de sa longueur antéro-postérieure, fréquemment associés à des malformations de la région occipitale.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000244 (Brachyturricephaly)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal vertical height of the skull and a shortening of its anterior-posterior length, frequently combined with malformations of the occipital region.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000244"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Brachyturricéphalie</owl:annotatedTarget>
        <babelon:comment>label of HP:0000244 (Brachyturricephaly)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Brachyturricephaly</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000245">
        <obo:IAO_0000115 xml:lang="fr">Anomalie des sinus paranasaux (crâniens), qui sont des espaces remplis d&apos;air situés dans les os du crâne et de la face et qui communiquent avec la cavité nasale. Ils comprennent les sinus maxillaires, les sinus frontaux, les sinus ethmoïdaux et les sinus sphénoïdaux.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Anomalie des sinus paranasaux</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000245"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie des sinus paranasaux (crâniens), qui sont des espaces remplis d&apos;air situés dans les os du crâne et de la face et qui communiquent avec la cavité nasale. Ils comprennent les sinus maxillaires, les sinus frontaux, les sinus ethmoïdaux et les sinus sphénoïdaux.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000245 (Abnormality of the paranasal sinuses)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of the paranasal (cranial) sinuses, which are air-filled spaces that are located within the bones of the skull and face and communicate with the nasal cavity. They comprise the maxillary sinuses, the frontal sinuses, the ethmoid sinuses, and the sphenoid sinuses.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000245"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie des sinus paranasaux</owl:annotatedTarget>
        <babelon:comment>label of HP:0000245 (Abnormality of the paranasal sinuses)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal paranasal sinus morphology</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000246">
        <obo:IAO_0000115 xml:lang="fr">Inflammation des sinus paranasaux due à une infection virale, bactérienne ou fongique, à une allergie ou à une réaction auto-immune.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Sinusite</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000246"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Inflammation des sinus paranasaux due à une infection virale, bactérienne ou fongique, à une allergie ou à une réaction auto-immune.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000246 (Sinusitis)  ; abnormality of head or neck ; abnormality of the immune system ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inflammation of the paranasal sinuses owing to a viral, bacterial, or fungal infection, allergy, or an autoimmune reaction.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
