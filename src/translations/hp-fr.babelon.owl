    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000558">
        <obo:IAO_0000115 xml:lang="fr">Malformation congénitale du segment antérieur caractérisée par une malformation irido-cornéenne, un glaucome, une hypoplasie du stroma de l&apos;iris, un embryotoxon postérieur et des opacités cornéennes.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Anomalie de Rieger</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
