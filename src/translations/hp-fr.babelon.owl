        <owl:annotatedTarget xml:lang="fr">Anomalie des organes génitaux internes de la femme</owl:annotatedTarget>
        <babelon:comment>label of HP:0000008 (Abnormality of female internal genitalia)  ; abnormality of the genitourinary system</babelon:comment>
