        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000568">
        <obo:IAO_0000115 xml:lang="fr">Anomalie du développement caractérisée par la petitesse anormale d&apos;un œil ou des deux yeux</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Microphtalmie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000568"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie du développement caractérisée par la petitesse anormale d&apos;un œil ou des deux yeux</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000568 (Microphthalmia)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A developmental anomaly characterized by abnormal smallness of one or both eyes.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
