    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000541">
        <obo:IAO_0000115 xml:lang="fr">Séparation des couches internes de la rétine (rétine neurale) de l&apos;épithélium pigmentaire</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Décollement de rétine</rdfs:label>
