    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000381">
        <obo:IAO_0000115 xml:lang="fr">L&apos;ankylose de l&apos;étrier désigne la fixation congénitale ou acquise de l&apos;étrier (petit os ou osselet de l&apos;oreille moyenne en forme d&apos;étrier), qui est associée à une surdité de transmission résultant d&apos;une déficience du mécanisme de conduction du son (le conduit auditif externe, la membrane tympanique et/ou les osselets de l&apos;oreille moyenne).</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Ankylose de l&apos;étrier</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000381"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">L&apos;ankylose de l&apos;étrier désigne la fixation congénitale ou acquise de l&apos;étrier (petit os ou osselet de l&apos;oreille moyenne en forme d&apos;étrier), qui est associée à une surdité de transmission résultant d&apos;une déficience du mécanisme de conduction du son (le conduit auditif externe, la membrane tympanique et/ou les osselets de l&apos;oreille moyenne).</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000381 (Stapes ankylosis)  ; abnormality of the ear</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Stapes ankylosis refers to congenital or acquired fixation of the stapes (the stirrup-shaped small bone or ossicle in the middle ear), which is associated with conductive hearing resulting from impairment of the sound-conduction mechanism (the external auditory canal, tympanic membrane, and/or middle-ear ossicles).</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000381"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Ankylose de l&apos;étrier</owl:annotatedTarget>
        <babelon:comment>label of HP:0000381 (Stapes ankylosis)  ; abnormality of the ear</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Stapes ankylosis</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
