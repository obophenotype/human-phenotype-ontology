    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000358">
        <obo:IAO_0000115 xml:lang="fr">Un type de localisation anormale des oreilles dans lequel la position des oreilles est caractérisée par une rotation postérieure (la partie supérieure des oreilles est tournée vers l&apos;arrière de la tête, et la partie inférieure des oreilles vers l&apos;avant).</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">oreilles en rotation postérieure</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000358"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Un type de localisation anormale des oreilles dans lequel la position des oreilles est caractérisée par une rotation postérieure (la partie supérieure des oreilles est tournée vers l&apos;arrière de la tête, et la partie inférieure des oreilles vers l&apos;avant).</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000358 (Posteriorly rotated ears)  ; abnormality of the ear</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of abnormal location of the ears in which the position of the ears is characterized by posterior rotation (the superior part of the ears is rotated towards the back of the head, and the inferior part of the ears towards the front).</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
