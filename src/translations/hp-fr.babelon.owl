        <owl:annotatedTarget xml:lang="fr">Otosclérose</owl:annotatedTarget>
        <babelon:comment>label of HP:0000362 (Otosclerosis)  ; abnormality of the ear</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Otosclerosis</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
