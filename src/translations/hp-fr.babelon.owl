        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000306">
        <obo:IAO_0000115 xml:lang="fr">Anomalie du menton, c&apos;est-à-dire de la partie inférieure du visage située en dessous de la lèvre inférieure et comprenant la proéminence centrale de la mâchoire inférieure.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Anomalie du menton</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000306"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie du menton, c&apos;est-à-dire de la partie inférieure du visage située en dessous de la lèvre inférieure et comprenant la proéminence centrale de la mâchoire inférieure.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000306 (Abnormality of the chin)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the chin, i.e., of the inferior portion of the face lying inferior to the lower lip and including the central prominence of the lower jaw.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000306"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie du menton</owl:annotatedTarget>
