        <babelon:source_value>A lack of facial expression often with staring eyes and a slightly open mouth.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
