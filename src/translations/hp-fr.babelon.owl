    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000190">
        <obo:IAO_0000115 xml:lang="fr">Anomalie du frein lingual, c&apos;est-à-dire du petit repli de la muqueuse qui attache la langue au plancher de la bouche, ou présence de créneaux accessoires dans la cavité buccale.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Anomalie morphologique du frein lingual</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
