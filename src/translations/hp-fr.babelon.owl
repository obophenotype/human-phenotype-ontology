        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000538">
        <obo:IAO_0000115 xml:lang="fr">Disque optique apparent en l&apos;absence d&apos;hypertension intra-crânienne</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Pseudo-oedème papillaire</rdfs:label>
