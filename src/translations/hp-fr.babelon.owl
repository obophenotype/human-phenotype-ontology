    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000340">
        <obo:IAO_0000115 xml:lang="fr">Inclinaison de la surface antérieure du front par rapport à la verticale supérieure à deux écarts-types au-dessus de la moyenne (objectif) ; ou inclinaison postérieure apparemment excessive du front en vue latérale.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">front étroit, fuyant</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000340"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Inclinaison de la surface antérieure du front par rapport à la verticale supérieure à deux écarts-types au-dessus de la moyenne (objectif) ; ou inclinaison postérieure apparemment excessive du front en vue latérale.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000340 (Sloping forehead)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inclination of the anterior surface of the forehead from the vertical more than two standard deviations above the mean (objective); or apparently excessive posterior sloping of the forehead in a lateral view.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
