    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000054">
        <obo:IAO_0000115 xml:lang="fr">Pénis anormalement petit. À la naissance, le pénis normal mesure environ 3 cm (longueur étirée du tubercule pubien à l&apos;extrémité du pénis) et le micropénis est inférieur à 2,0-2,5 cm.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Micropénis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000054"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Pénis anormalement petit. À la naissance, le pénis normal mesure environ 3 cm (longueur étirée du tubercule pubien à l&apos;extrémité du pénis) et le micropénis est inférieur à 2,0-2,5 cm.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000054 (Micropenis)  ; abnormality of the genitourinary system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormally small penis. At birth, the normal penis is about 3 cm (stretched length from pubic tubercle to tip of penis) with micropenis less than 2.0-2.5 cm.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
