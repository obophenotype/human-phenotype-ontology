        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Prominent supraorbital ridges</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000337">
        <obo:IAO_0000115 xml:lang="fr">Largeur du front ou distance entre les frontotemporaux supérieure à deux écarts-types au-dessus de la moyenne (objective) ; ou distance apparemment accrue entre les deux côtés du front.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Front large</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000337"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Largeur du front ou distance entre les frontotemporaux supérieure à deux écarts-types au-dessus de la moyenne (objective) ; ou distance apparemment accrue entre les deux côtés du front.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000337 (Broad forehead)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Width of the forehead or distance between the frontotemporales is more than two standard deviations above the mean (objective); or apparently increased distance between the two sides of the forehead.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000337"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Front large</owl:annotatedTarget>
        <babelon:comment>label of HP:0000337 (Broad forehead)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Broad forehead</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000338">
        <obo:IAO_0000115 xml:lang="fr">Un degré réduit de mouvement des muscles sous la peau du visage, souvent associé à une réduction de la formation des plis du visage.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Hypomimie faciale</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000338"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Un degré réduit de mouvement des muscles sous la peau du visage, souvent associé à une réduction de la formation des plis du visage.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000338 (Hypomimic face)  ; abnormality of the musculature ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduced degree of motion of the muscles beneath the skin of the face, often associated with reduced facial crease formation.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000338"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Hypomimie faciale</owl:annotatedTarget>
