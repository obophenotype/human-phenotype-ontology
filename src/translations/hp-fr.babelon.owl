    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000037">
        <obo:IAO_0000115 xml:lang="fr">L’hermaphrodisme désigne une divergence entre la morphologie des gonades et celle des organes génitaux externes. Dans le cas d&apos;une variation du développement génital masculin, le génotype est masculin (XY) et les organes génitaux externes sont soit masculins mais peu développés, ambigus, ou entièrement féminins. Si les gonades sont présentes, il s&apos;agira de testicules</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Pseudohermaphrodisme masculin</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000037"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">L’hermaphrodisme désigne une divergence entre la morphologie des gonades et celle des organes génitaux externes. Dans le cas d&apos;une variation du développement génital masculin, le génotype est masculin (XY) et les organes génitaux externes sont soit masculins mais peu développés, ambigus, ou entièrement féminins. Si les gonades sont présentes, il s&apos;agira de testicules</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000037 (Male pseudohermaphroditism)  ; abnormality of the genitourinary system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hermaphroditism refers to a discrepancy between the morphology of the gonads and that of the external genitalia. In male pseudohermaphroditism, the genotype is male (XY) and the external genitalia are imcompletely virilized, ambiguous, or complete female. If gonads are present, they are testes.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000037"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Pseudohermaphrodisme masculin</owl:annotatedTarget>
        <babelon:comment>label of HP:0000037 (Male pseudohermaphroditism)  ; abnormality of the genitourinary system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Male pseudohermaphroditism</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000039">
        <obo:IAO_0000115 xml:lang="fr">Malposition urétrale, ouvert sur la face dorsale (supérieur) du pénis</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Epispadias</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000039"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Malposition urétrale, ouvert sur la face dorsale (supérieur) du pénis</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000039 (Epispadias)  ; abnormality of the genitourinary system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Epispadias is a urogenital malformation characterized by the failure of the urethral tube to tubularize on the dorsal aspect. Unlike in hypospadias, where the meatus is on the ventral aspect, children with epispadias have a wide-open urethral plate on the dorsum. It is commonly seen as a component in the spectrum of bladder exstrophy-epispadias-complex. Isolated epispadias constitutes less than 10 percent of the total cases of epispadias.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000039"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Epispadias</owl:annotatedTarget>
        <babelon:comment>label of HP:0000039 (Epispadias)  ; abnormality of the genitourinary system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Epispadias</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000040">
