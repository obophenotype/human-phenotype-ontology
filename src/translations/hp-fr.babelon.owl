    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000360">
        <obo:IAO_0000115 xml:lang="fr">Un acouphène est une perception auditive qui peut être décrite comme l&apos;expérience d&apos;un son, dans l&apos;oreille ou dans la tête, en l&apos;absence de stimulation acoustique externe.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Acouphène</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000360"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Un acouphène est une perception auditive qui peut être décrite comme l&apos;expérience d&apos;un son, dans l&apos;oreille ou dans la tête, en l&apos;absence de stimulation acoustique externe.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000360 (Tinnitus)  ; abnormality of the ear</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tinnitus is an auditory perception that can be described as the experience of sound, in the ear or in the head, in the absence of external acoustic stimulation.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000360"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Acouphène</owl:annotatedTarget>
        <babelon:comment>label of HP:0000360 (Tinnitus)  ; abnormality of the ear</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tinnitus</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000362">
        <obo:IAO_0000115 xml:lang="fr">Dans l&apos;otospongiose, un cal osseux s&apos;accumule sur l&apos;étrier, créant une fixation partielle. Cela limite le mouvement de l&apos;étrier, ce qui entraîne une perte d&apos;audition.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Otosclérose</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000362"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Dans l&apos;otospongiose, un cal osseux s&apos;accumule sur l&apos;étrier, créant une fixation partielle. Cela limite le mouvement de l&apos;étrier, ce qui entraîne une perte d&apos;audition.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000362 (Otosclerosis)  ; abnormality of the ear</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>In otosclerosis, a callus of bone accumulates on the stapes creating a partial fixation. This limits the movement of the stapes bone, which results in hearing loss.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
