        <babelon:source_value>Hypomimic face</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000339">
        <obo:IAO_0000115 xml:lang="fr">Caractéristiques faciales grossières rappelant celles d&apos;un boxeur</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Facies pugilistique</rdfs:label>
