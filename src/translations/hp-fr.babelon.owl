    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000602">
        <obo:IAO_0000115 xml:lang="fr">Paralysie d&apos;un ou de plusieurs muscles extraoculaires responsables des mouvements oculaires.</obo:IAO_0000115>
