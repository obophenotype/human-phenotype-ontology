    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000100">
        <obo:IAO_0000115 xml:lang="fr">Le syndrome néphrotique est un ensemble d&apos;observations résultant d&apos;un dysfonctionnement glomérulaire avec une augmentation de la perméabilité de la paroi capillaire glomérulaire associée à une protéinurie prononcée. Le syndrome néphrotique désigne la constellation d&apos;observations cliniques résultant d&apos;une perte rénale grave de protéines, avec protéinurie et hypoalbuminémie, œdème et hyperlipidémie.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Syndrome néphrotique</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000100"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Le syndrome néphrotique est un ensemble d&apos;observations résultant d&apos;un dysfonctionnement glomérulaire avec une augmentation de la perméabilité de la paroi capillaire glomérulaire associée à une protéinurie prononcée. Le syndrome néphrotique désigne la constellation d&apos;observations cliniques résultant d&apos;une perte rénale grave de protéines, avec protéinurie et hypoalbuminémie, œdème et hyperlipidémie.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000100 (Nephrotic syndrome)  ; abnormality of the genitourinary system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nephrotic syndrome is a collection of findings resulting from glomerular dysfunction with an increase in glomerular capillary wall permeability associated with pronounced proteinuria. Nephrotic syndrome refers to the constellation of clinical findings that result from severe renal loss of protein, with Proteinuria and hypoalbuminemia, edema, and hyperlipidemia.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000100"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Syndrome néphrotique</owl:annotatedTarget>
        <babelon:comment>label of HP:0000100 (Nephrotic syndrome)  ; abnormality of the genitourinary system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nephrotic syndrome</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
