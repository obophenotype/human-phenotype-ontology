    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000179">
        <obo:IAO_0000115 xml:lang="fr">Épaisseur accrue de la lèvre inférieure, entraînant un aspect proéminent de la lèvre inférieure. La hauteur du vermillon de la lèvre inférieure sur la ligne médiane est supérieure de plus de 2 DS &amp; à la moyenne. Ou bien, une hauteur apparemment accrue du vermillon de la lèvre inférieure en vue frontale (subjective).</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Lèvre inférieure épaisse</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000179"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Épaisseur accrue de la lèvre inférieure, entraînant un aspect proéminent de la lèvre inférieure. La hauteur du vermillon de la lèvre inférieure sur la ligne médiane est supérieure de plus de 2 DS &amp; à la moyenne. Ou bien, une hauteur apparemment accrue du vermillon de la lèvre inférieure en vue frontale (subjective).</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000179 (Thick lower lip vermilion)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased thickness of the lower lip, leading to a prominent appearance of the lower lip. The height of the vermilion of the lower lip in the midline is more than 2 SD above the mean. Alternatively, an apparently increased height of the vermilion of the lower lip in the frontal view (subjective).</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000179"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Lèvre inférieure épaisse</owl:annotatedTarget>
        <babelon:comment>label of HP:0000179 (Thick lower lip vermilion)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Thick lower lip vermilion</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000180">
        <obo:IAO_0000115 xml:lang="fr">Multiples indentations et/ou élévations sur le bord et/ou la surface de la langue produisant un contour de surface irrégulier.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Langue lobulée</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000180"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Multiples indentations et/ou élévations sur le bord et/ou la surface de la langue produisant un contour de surface irrégulier.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000180 (Lobulated tongue)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Multiple indentations and/or elevations on the edge and/or surface of the tongue producing an irregular surface contour.</babelon:source_value>
