    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000565">
        <obo:IAO_0000115 xml:lang="fr">&quot;Une forme de strabisme avec un ou les deux yeux tournés vers l&apos;intérieur (&quot;&quot;croisés&quot;&quot;) à un degré relativement sévère, généralement défini comme 10 dioptries ou plus.&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Esotropie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000565"/>
