        <owl:annotatedTarget xml:lang="fr">Vessie neurologique</owl:annotatedTarget>
        <babelon:comment>label of HP:0000011 (Neurogenic bladder)  ; abnormality of the genitourinary system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
