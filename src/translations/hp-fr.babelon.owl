    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000526">
        <obo:IAO_0000115 xml:lang="fr">Anomalie de l&apos;iris caractérisée par une hypoplasie complète ou partielle de l&apos;iris, généralement bilatérale. Le phénotype va de légères anomalies du stroma de l&apos;iris antérieur à l&apos;absence quasi-totale de l&apos;iris.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Aniridie</rdfs:label>
    </rdf:Description>
