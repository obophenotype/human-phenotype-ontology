        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une réduction fixe de la distance verticale entre les paupières supérieures et inférieures avec des fissures palpébrales courtes.</owl:annotatedTarget>
