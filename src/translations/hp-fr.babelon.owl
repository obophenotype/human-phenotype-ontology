        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Prominent occiput</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000270">
        <obo:IAO_0000115 xml:lang="fr">Les nourrissons ont normalement deux fontanelles à la naissance, la fontanelle antérieure en forme de losange à la jonction des sutures coronale et sagittale, et la fontanelle postérieure à l&apos;intersection des os occipital et pariétal. La fontanelle postérieure se ferme généralement vers la 8e semaine de vie, et la fontanelle antérieure se ferme vers le 18e mois de vie en moyenne. Ce terme s&apos;applique en cas de retard de la fermeture des fontanelles au-delà de l&apos;âge normal.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Retard de soudure des sutures crâniennes</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000270"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Les nourrissons ont normalement deux fontanelles à la naissance, la fontanelle antérieure en forme de losange à la jonction des sutures coronale et sagittale, et la fontanelle postérieure à l&apos;intersection des os occipital et pariétal. La fontanelle postérieure se ferme généralement vers la 8e semaine de vie, et la fontanelle antérieure se ferme vers le 18e mois de vie en moyenne. Ce terme s&apos;applique en cas de retard de la fermeture des fontanelles au-delà de l&apos;âge normal.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000270 (Delayed cranial suture closure)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Infants normally have two fontanels at birth, the diamond-shaped anterior fontanelle at the junction of the coronal and sagittal sutures, and the posterior fontanelle at the intersection of the occipital and parietal bones. The posterior fontanelle usually closes by the 8th week of life, and the anterior fontanel closes by the 18th month of life on average. This term applies if there is delay of closure of the fontanelles beyond the normal age.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000270"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Retard de soudure des sutures crâniennes</owl:annotatedTarget>
        <babelon:comment>label of HP:0000270 (Delayed cranial suture closure)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Delayed cranial suture closure</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
