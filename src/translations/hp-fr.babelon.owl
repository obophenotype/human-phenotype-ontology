        <babelon:source_value>Long face</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000277">
        <obo:IAO_0000115 xml:lang="fr">Toute anomalie de la mandibule, l&apos;os de la mâchoire inférieure</obo:IAO_0000115>
