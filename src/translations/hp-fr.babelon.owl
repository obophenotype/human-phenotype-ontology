    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000556">
        <obo:IAO_0000115 xml:lang="fr">La dystrophie rétinienne est une anomalie de la rétine associée à un processus héréditaire. Les dystrophies rétiniennes se définissent par une hérédité principalement monogénique et sont fréquemment associées à une perte ou à un dysfonctionnement des cellules photoréceptrices en tant qu&apos;événement primaire ou secondaire.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Dystrophie rétinienne</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000556"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">La dystrophie rétinienne est une anomalie de la rétine associée à un processus héréditaire. Les dystrophies rétiniennes se définissent par une hérédité principalement monogénique et sont fréquemment associées à une perte ou à un dysfonctionnement des cellules photoréceptrices en tant qu&apos;événement primaire ou secondaire.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000556 (Retinal dystrophy)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinal dystrophy is an abnormality of the retina associated with a hereditary process. Retinal dystrophies are defined by their predominantly monogenic inheritance and they are frequently associated with loss or dysfunction of photoreceptor cells as a primary or secondary event.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000556"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Dystrophie rétinienne</owl:annotatedTarget>
        <babelon:comment>label of HP:0000556 (Retinal dystrophy)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinal dystrophy</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000557">
