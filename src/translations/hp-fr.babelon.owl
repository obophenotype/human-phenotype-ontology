        <rdfs:label xml:lang="fr">Anomalie de la musculature faciale</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000301"/>
