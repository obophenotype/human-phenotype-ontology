    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000539">
        <obo:IAO_0000115 xml:lang="fr">Anomalie dans le processus de focalisation de la lumière par l&apos;œil afin de produire une image nette sur la rétine.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Anomalie de la réfraction</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000539"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie dans le processus de focalisation de la lumière par l&apos;œil afin de produire une image nette sur la rétine.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000539 (Abnormality of refraction)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality in the process of focusing of light by the eye in order to produce a sharp image on the retina.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
