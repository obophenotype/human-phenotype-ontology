        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000250"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une augmentation anormale de la densité des os constituant la calvaria.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000250 (Dense calvaria)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal increase of density of the bones making up the calvaria.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
