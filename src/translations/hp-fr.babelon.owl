    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000321">
        <obo:IAO_0000115 xml:lang="fr">Les contours du visage, vus de face, montrent une face supérieure/crâne et une face inférieure/mandibule larges, créant une apparence carrée.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Face carrée</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000321"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Les contours du visage, vus de face, montrent une face supérieure/crâne et une face inférieure/mandibule larges, créant une apparence carrée.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000321 (Square face)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Facial contours, as viewed from the front, show a broad upper face/cranium and lower face/mandible, creating a square appearance.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000321"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Face carrée</owl:annotatedTarget>
        <babelon:comment>label of HP:0000321 (Square face)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Square face</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000322">
        <obo:IAO_0000115 xml:lang="fr">Distance entre la base nasale et le bord vermillon de la ligne médiane de la lèvre supérieure inférieure de plus de 2 ET à la moyenne. Ou encore, une distance apparemment réduite entre la base du nez et le bord vermillon de la ligne médiane de la lèvre supérieure.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Philtrum court</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000322"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Distance entre la base nasale et le bord vermillon de la ligne médiane de la lèvre supérieure inférieure de plus de 2 ET à la moyenne. Ou encore, une distance apparemment réduite entre la base du nez et le bord vermillon de la ligne médiane de la lèvre supérieure.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000322 (Short philtrum)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Distance between nasal base and midline upper lip vermilion border more than 2 SD below the mean. Alternatively, an apparently decreased distance between nasal base and midline upper lip vermilion border.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000322"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Philtrum court</owl:annotatedTarget>
        <babelon:comment>label of HP:0000322 (Short philtrum)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Short philtrum</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000324">
        <obo:IAO_0000115 xml:lang="fr">Une différence anormale entre les côtés gauche et droit du visage.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Asymétrie faciale</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000324"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une différence anormale entre les côtés gauche et droit du visage.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000324 (Facial asymmetry)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal difference between the left and right sides of the face.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000324"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Asymétrie faciale</owl:annotatedTarget>
