    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000212">
        <obo:IAO_0000115 xml:lang="fr">Hyperplasie de la gencive (c&apos;est-à-dire un épaississement du tissu mou recouvrant la crête alvéolaire. Le degré d&apos;épaississement va de l&apos;implication des papilles interdentaires seules à une prolifération gingivale couvrant toute la couronne dentaire.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Hypertrophie gingivale</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000212"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Hyperplasie de la gencive (c&apos;est-à-dire un épaississement du tissu mou recouvrant la crête alvéolaire. Le degré d&apos;épaississement va de l&apos;implication des papilles interdentaires seules à une prolifération gingivale couvrant toute la couronne dentaire.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000212 (Gingival overgrowth)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hyperplasia of the gingiva (that is, a thickening of the soft tissue overlying the alveolar ridge. The degree of thickening ranges from involvement of the interdental papillae alone to gingival overgrowth covering the entire tooth crown.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000212"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Hypertrophie gingivale</owl:annotatedTarget>
        <babelon:comment>label of HP:0000212 (Gingival overgrowth)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Gingival overgrowth</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000214">
        <obo:IAO_0000115 xml:lang="fr">Télangiectasie (c&apos;est-à-dire la présence de petits vaisseaux sanguins superficiels dilatés) des lèvres.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Télangiectasie labiale</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000214"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Télangiectasie (c&apos;est-à-dire la présence de petits vaisseaux sanguins superficiels dilatés) des lèvres.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000214 (Lip telangiectasia)  ; abnormality of the integument ; abnormality of head or neck ; abnormality of the cardiovascular system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Telangiectasia (that is, the presence of small dilated superficial blood vessels) of the lips.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
