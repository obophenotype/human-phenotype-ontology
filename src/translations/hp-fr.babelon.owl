    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000458">
        <obo:IAO_0000115 xml:lang="fr">Une incapacité à percevoir les odeurs. Il s&apos;agit d&apos;un terme général décrivant l&apos;incapacité à sentir qui survient à n&apos;importe quel stade du processus de l&apos;odorat, depuis l&apos;absorption des substances odorantes dans le mucus nasal recouvrant l&apos;épithélium olfactif, la diffusion vers les cils, la liaison aux sites récepteurs olfactifs, la génération de potentiels d&apos;action dans les neurones olfactifs et la perception d&apos;une odeur.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Anosmie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000458"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une incapacité à percevoir les odeurs. Il s&apos;agit d&apos;un terme général décrivant l&apos;incapacité à sentir qui survient à n&apos;importe quel stade du processus de l&apos;odorat, depuis l&apos;absorption des substances odorantes dans le mucus nasal recouvrant l&apos;épithélium olfactif, la diffusion vers les cils, la liaison aux sites récepteurs olfactifs, la génération de potentiels d&apos;action dans les neurones olfactifs et la perception d&apos;une odeur.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000458 (Anosmia)  ; abnormality of the nervous system ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An inability to perceive odors. This is a general term describing inability to smell arising in any part of the process of smelling from absorption of odorants into the nasal mucous overlying the olfactory epithelium, diffusion to the cilia, binding to olfactory receptor sites, generation of action potentials in olfactory neurons, and perception of a smell.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000458"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Anosmie</owl:annotatedTarget>
        <babelon:comment>label of HP:0000458 (Anosmia)  ; abnormality of the nervous system ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anosmia</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000460">
        <obo:IAO_0000115 xml:lang="fr">Distance interalaire inférieure de plus de 2 DS à la moyenne pour l&apos;âge, ou alternativement, une largeur apparemment réduite de la base nasale et des alae.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Nez étroit</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
