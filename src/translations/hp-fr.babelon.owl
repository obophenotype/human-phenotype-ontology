    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000074">
        <obo:IAO_0000115 xml:lang="fr">Blocage de l&apos;écoulement de l&apos;urine du bassinet rénal vers l&apos;uretère proximal.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Obstruction de la jonction pyélo-urétérale</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000074"/>
