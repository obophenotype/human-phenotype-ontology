        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinal hemorrhage</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000574">
        <obo:IAO_0000115 xml:lang="fr">Augmentation de la densité/du nombre/du diamètre de la pilosité des sourcils</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Sourcils épais</rdfs:label>
