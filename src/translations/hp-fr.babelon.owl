    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000493">
        <obo:IAO_0000115 xml:lang="fr">Une anomalie de la fovéa centrale, la zone centrale de la macula qui assure la médiation de la vision centrale à haute résolution et qui contient la plus grande concentration de cônes de la rétine.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Anomalie morphologique de la fovea</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000493"/>
