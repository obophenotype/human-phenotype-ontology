    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000275">
        <obo:IAO_0000115 xml:lang="fr">La largeur des os bizygomatiques (partie supérieure de la face) et des os bigonaux (partie inférieure de la face) est inférieure de plus de 2 écarts-types à la moyenne (objectif) ; ou, une réduction apparente de la largeur des parties supérieure et inférieure de la face (subjectif).</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Face étroite</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000275"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">La largeur des os bizygomatiques (partie supérieure de la face) et des os bigonaux (partie inférieure de la face) est inférieure de plus de 2 écarts-types à la moyenne (objectif) ; ou, une réduction apparente de la largeur des parties supérieure et inférieure de la face (subjectif).</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000275 (Narrow face)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bizygomatic (upper face) and bigonial (lower face) width are both more than 2 standard deviations below the mean (objective); or, an apparent reduction in the width of the upper and lower face (subjective).</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
