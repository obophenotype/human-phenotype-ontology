    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000396">
        <obo:IAO_0000115 xml:lang="fr">État dans lequel l&apos;hélix est replié à un degré supérieur à la normale. C&apos;est-à-dire un enroulement excessif du bord de l&apos;hélix, le bord libre étant parallèle au plan de l&apos;oreille.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Oreilles trop ourlées</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000396"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">État dans lequel l&apos;hélix est replié à un degré supérieur à la normale. C&apos;est-à-dire un enroulement excessif du bord de l&apos;hélix, le bord libre étant parallèle au plan de l&apos;oreille.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000396 (Overfolded helix)  ; abnormality of the ear</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A condition in which the helix is folded over to a greater degree than normal. That is, excessive curling of the helix edge, whereby the free edge is parallel to the plane of the ear.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
