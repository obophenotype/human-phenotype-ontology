    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000603">
        <obo:IAO_0000115 xml:lang="fr">Une zone de dépression visuelle située au point de fixation et qui interfère avec la vision centrale.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Scotome central</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000603"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
