    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000286">
        <obo:IAO_0000115 xml:lang="fr">Un pli de peau commençant au-dessus de la partie médiale de la paupière supérieure et s&apos;incurvant vers le bas pour couvrir, passer devant et sur le côté du canthus médial.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Epicanthus</rdfs:label>
