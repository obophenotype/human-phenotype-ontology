    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000011">
        <obo:IAO_0000115 xml:lang="fr">Une incapacité à vider complètement la vessie au cours de la miction en raison d&apos;une maladie neurologique</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Vessie neurologique</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000011"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une incapacité à vider complètement la vessie au cours de la miction en raison d&apos;une maladie neurologique</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000011 (Neurogenic bladder)  ; abnormality of the genitourinary system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of bladder dysfunction caused by neurologic damage. Neurogenic bladder can be flaccid or spastic. Common manifestatios of neurogenic bladder are overflow incontinence, frequency, urgency, urge incontinence, and retention.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
