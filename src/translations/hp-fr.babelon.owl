    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000085">
        <obo:IAO_0000115 xml:lang="fr">Connexion entre le rein droit et le rein gauche par un isthme de parenchyme rénal fonctionnel ou de tissu fibreux qui traverse la ligne médiane.</obo:IAO_0000115>
