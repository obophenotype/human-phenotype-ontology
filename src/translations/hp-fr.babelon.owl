    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000280">
        <obo:IAO_0000115 xml:lang="fr">Absence d&apos;aspect fin et net des sourcils, du nez, des lèvres, de la bouche et du menton, généralement en raison de traits arrondis et lourds ou d&apos;un épaississement de la peau avec ou sans épaississement des tissus sous-cutanés et osseux.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Traits grossiers du visage</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000280"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Absence d&apos;aspect fin et net des sourcils, du nez, des lèvres, de la bouche et du menton, généralement en raison de traits arrondis et lourds ou d&apos;un épaississement de la peau avec ou sans épaississement des tissus sous-cutanés et osseux.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000280 (Coarse facial features)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of fine and sharp appearance of brows, nose, lips, mouth, and chin, usually because of rounded and heavy features or thickened skin with or without thickening of subcutaneous and bony tissues.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
