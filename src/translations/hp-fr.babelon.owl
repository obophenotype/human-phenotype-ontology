        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of the chin</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000307">
        <obo:IAO_0000115 xml:lang="fr">Un rétrécissement marqué de la partie inférieure de la face jusqu&apos;au menton.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Menton pointu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000307"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Un rétrécissement marqué de la partie inférieure de la face jusqu&apos;au menton.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000307 (Pointed chin)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A marked tapering of the lower face to the chin.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
