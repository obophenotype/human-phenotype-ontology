    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000505">
        <obo:IAO_0000115 xml:lang="fr">La déficience visuelle (ou trouble de la vision) est une perte de vision (d&apos;une personne) à un degré tel qu&apos;elle peut être considérée comme un besoin d&apos;aide supplémentaire en raison d&apos;une limitation significative de la capacité visuelle résultant d&apos;une maladie, d&apos;un traumatisme ou d&apos;une affection congénitale ou dégénérative qui ne peut être corrigée par des moyens conventionnels, tels qu&apos;une correction réfractive, des médicaments ou une intervention chirurgicale.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Vision altérée</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000505"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">La déficience visuelle (ou trouble de la vision) est une perte de vision (d&apos;une personne) à un degré tel qu&apos;elle peut être considérée comme un besoin d&apos;aide supplémentaire en raison d&apos;une limitation significative de la capacité visuelle résultant d&apos;une maladie, d&apos;un traumatisme ou d&apos;une affection congénitale ou dégénérative qui ne peut être corrigée par des moyens conventionnels, tels qu&apos;une correction réfractive, des médicaments ou une intervention chirurgicale.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000505 (Visual impairment)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Visual impairment (or vision impairment) is vision loss (of a person) to such a degree as to qualify as an additional support need through a significant limitation of visual capability resulting from either disease, trauma, or congenital or degenerative conditions that cannot be corrected by conventional means, such as refractive correction, medication, or surgery.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000505"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Vision altérée</owl:annotatedTarget>
        <babelon:comment>label of HP:0000505 (Visual impairment)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Visual impairment</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000506">
        <obo:IAO_0000115 xml:lang="fr">Distance entre les canthi internes supérieure à deux écarts types au-dessus de la moyenne (objectif) ; ou distance apparemment perçue comme accrue entre les canthi internes (subjectif).</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Télécanthus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000506"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Distance entre les canthi internes supérieure à deux écarts types au-dessus de la moyenne (objectif) ; ou distance apparemment perçue comme accrue entre les canthi internes (subjectif).</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000506 (Telecanthus)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Distance between the inner canthi more than two standard deviations above the mean (objective); or, apparently increased distance between the inner canthi.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000506"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Télécanthus</owl:annotatedTarget>
        <babelon:comment>label of HP:0000506 (Telecanthus)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Telecanthus</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000508">
        <obo:IAO_0000115 xml:lang="fr">Le bord de la paupière supérieure est positionné 3 mm ou plus plus bas que d&apos;habitude et couvre la partie supérieure de l&apos;iris (objectif) ; ou le bord de la paupière supérieure obscurcit au moins une partie de la pupille (subjectif).</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Ptosis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000508"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Le bord de la paupière supérieure est positionné 3 mm ou plus plus bas que d&apos;habitude et couvre la partie supérieure de l&apos;iris (objectif) ; ou le bord de la paupière supérieure obscurcit au moins une partie de la pupille (subjectif).</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000508 (Ptosis)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The upper eyelid margin is positioned 3 mm or more lower than usual and covers the superior portion of the iris (objective); or, the upper lid margin obscures at least part of the pupil (subjective).</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000508"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Ptosis</owl:annotatedTarget>
        <babelon:comment>label of HP:0000508 (Ptosis)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ptosis</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000509">
        <obo:IAO_0000115 xml:lang="fr">Inflammation de la conjonctive</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Conjonctivite</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000509"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Inflammation de la conjonctive</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000509 (Conjunctivitis)  ; abnormality of head or neck ; abnormality of the cardiovascular system ; abnormality of the immune system ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inflammation of the conjunctiva.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000509"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Conjonctivite</owl:annotatedTarget>
        <babelon:comment>label of HP:0000509 (Conjunctivitis)  ; abnormality of head or neck ; abnormality of the cardiovascular system ; abnormality of the immune system ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Conjunctivitis</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000510">
        <obo:IAO_0000115 xml:lang="fr">Un sous-type de maladie rétinienne héréditaire dans laquelle les photorécepteurs à bâtonnets semblent être plus gravement touchés que les photorécepteurs à cônes. La présentation typique est une nyctalopie (due au dysfonctionnement des bâtonnets) suivie d&apos;une perte du champ de vision périphérique moyen, qui s&apos;étend progressivement et laisse à de nombreux patients un petit îlot de vision centrale en raison de la préservation des cônes maculaires.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Dystrophie des bâtonnets rétiniens</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000510"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Un sous-type de maladie rétinienne héréditaire dans laquelle les photorécepteurs à bâtonnets semblent être plus gravement touchés que les photorécepteurs à cônes. La présentation typique est une nyctalopie (due au dysfonctionnement des bâtonnets) suivie d&apos;une perte du champ de vision périphérique moyen, qui s&apos;étend progressivement et laisse à de nombreux patients un petit îlot de vision centrale en raison de la préservation des cônes maculaires.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000510 (Rod-cone dystrophy)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An inherited retinal disease subtype in which the rod photoreceptors appear to be more severely affected than the cone photoreceptors. Typical presentation is with nyctalopia (due to rod dysfunction) followed by loss of mid-peripheral field of vision, which gradually extends and leaves many patients with a small central island of vision due to the preservation of macular cones.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000510"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Dystrophie des bâtonnets rétiniens</owl:annotatedTarget>
        <babelon:comment>label of HP:0000510 (Rod-cone dystrophy)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Rod-cone dystrophy</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000511">
        <obo:IAO_0000115 xml:lang="fr">La paralysie supranucléaire du regard est une incapacité à regarder dans une direction verticale résultant d&apos;une déficience cérébrale. Il y a une perte de l&apos;aspect volontaire des mouvements oculaires, mais, comme le tronc cérébral est encore intact, tous les mouvements oculaires conjugués réflexes sont normaux.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Paralysie supranucléaire du regard vertical (syndrome de Parinaud)</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000511"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">La paralysie supranucléaire du regard est une incapacité à regarder dans une direction verticale résultant d&apos;une déficience cérébrale. Il y a une perte de l&apos;aspect volontaire des mouvements oculaires, mais, comme le tronc cérébral est encore intact, tous les mouvements oculaires conjugués réflexes sont normaux.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000511 (Vertical supranuclear gaze palsy)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A supranuclear gaze palsy is an inability to look in a vertical direction as a result of cerebral impairment. There is a loss of the voluntary aspect of eye movements, but, as the brainstem is still intact, all the reflex conjugate eye movements are normal.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000511"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Paralysie supranucléaire du regard vertical (syndrome de Parinaud)</owl:annotatedTarget>
        <babelon:comment>label of HP:0000511 (Vertical supranuclear gaze palsy)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Vertical supranuclear gaze palsy</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000512">
        <obo:IAO_0000115 xml:lang="fr">Toute anomalie de réponse électrique des différents types de cellules de la rétine, mesurée par électrorétinographie.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Electrorétinogramme anormal</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000512"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Toute anomalie de réponse électrique des différents types de cellules de la rétine, mesurée par électrorétinographie.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000512 (Abnormal electroretinogram)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any abnormality of the electrical responses of various cell types in the retina as measured by electroretinography.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000512"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Electrorétinogramme anormal</owl:annotatedTarget>
        <babelon:comment>label of HP:0000512 (Abnormal electroretinogram)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal electroretinogram</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000514">
        <obo:IAO_0000115 xml:lang="fr">Une vitesse anormalement lente des mouvements saccadés des yeux.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Mouvements oculaires saccadés lents</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000514"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une vitesse anormalement lente des mouvements saccadés des yeux.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000514 (Slow saccadic eye movements)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormally slow velocity of the saccadic eye movements.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000514"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Mouvements oculaires saccadés lents</owl:annotatedTarget>
        <babelon:comment>label of HP:0000514 (Slow saccadic eye movements)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Slow saccadic eye movements</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000517">
        <obo:IAO_0000115 xml:lang="fr">Anomalie du cristallin</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Anomalie du cristallin</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000517"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie du cristallin</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000517 (Abnormality of the lens)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the lens.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
