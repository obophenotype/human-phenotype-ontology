    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000540">
        <obo:IAO_0000115 xml:lang="fr">Anomalie de la réfraction caractérisée par la capacité à voir clairement les objets éloignés, alors que les objets proches apparaissent flous.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Hypermétropie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000540"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie de la réfraction caractérisée par la capacité à voir clairement les objets éloignés, alors que les objets proches apparaissent flous.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000540 (Hypermetropia)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of refraction characterized by the ability to see objects in the distance clearly, while objects nearby appear blurry.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
