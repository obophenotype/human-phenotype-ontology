    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000599">
        <obo:IAO_0000115 xml:lang="fr">Anomalie de l&apos;emplacement ou de la forme de la ligne d&apos;implantation des cheveux (trichion) sur le front, c&apos;est-à-dire la limite entre la peau du front qui a des cheveux et celle qui n&apos;en a pas.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Anomalie de l&apos;implantation frontale des cheveux</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000599"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie de l&apos;emplacement ou de la forme de la ligne d&apos;implantation des cheveux (trichion) sur le front, c&apos;est-à-dire la limite entre la peau du front qui a des cheveux et celle qui n&apos;en a pas.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000599 (Abnormality of the frontal hairline)  ; abnormality of the integument ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly in the placement or shape of the hairline (trichion) on the forehead, that is, the border between skin on the forehead that has head hair and that does not.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
