    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000564">
        <obo:IAO_0000115 xml:lang="fr">Trouble du développement du système de drainage lacrymal qui affecte le plus souvent l&apos;ostium lacrymal et entraîne la non-ouverture du canal lacrymo-nasal. Il résulte généralement d&apos;une non-canalisation du canal lacrymal.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Atrésie du canal lacrymal</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000564"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Trouble du développement du système de drainage lacrymal qui affecte le plus souvent l&apos;ostium lacrymal et entraîne la non-ouverture du canal lacrymo-nasal. Il résulte généralement d&apos;une non-canalisation du canal lacrymal.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000564 (Lacrimal duct atresia)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A developmental disorder of the lacrimal drainage system that most often affects the lacrimal ostium and resulting in non-opening of the nasolacrimal duct. It usually results from a non-canalization of the nasolacrimal duct.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
