        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000308">
        <obo:IAO_0000115 xml:lang="fr">Une forme d&apos;hypoplasie développementale de la mandibule dans laquelle la mandibule est mal localisée postérieurement.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Microrétrognathie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000308"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une forme d&apos;hypoplasie développementale de la mandibule dans laquelle la mandibule est mal localisée postérieurement.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000308 (Microretrognathia)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of developmental hypoplasia of the mandible in which the mandible is mislocalised posteriorly.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000308"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Microrétrognathie</owl:annotatedTarget>
        <babelon:comment>label of HP:0000308 (Microretrognathia)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Microretrognathia</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000309">
        <obo:IAO_0000115 xml:lang="fr">Une anomalie de la face moyenne, qui est une région et non un terme anatomique. Elle s&apos;étend, en haut, du bord inférieur de l&apos;orbite jusqu&apos;au niveau de la base du nez, en bas. Elle est formée par le maxillaire (mâchoire supérieure) et le zygoma, ainsi que par les joues et la région malaire. Traditionnellement, le nez et le prémaxillaire ne sont pas inclus dans la face moyenne.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Anomalie de l&apos;étage moyen de la face</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000309"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une anomalie de la face moyenne, qui est une région et non un terme anatomique. Elle s&apos;étend, en haut, du bord inférieur de l&apos;orbite jusqu&apos;au niveau de la base du nez, en bas. Elle est formée par le maxillaire (mâchoire supérieure) et le zygoma, ainsi que par les joues et la région malaire. Traditionnellement, le nez et le prémaxillaire ne sont pas inclus dans la face moyenne.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000309 (Abnormality of the midface)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly of the midface, which is a region and not an anatomical term. It extends, superiorly, from the inferior orbital margin to, inferiorly, the level of nasal base. It is formed by the maxilla (upper jaw) and zygoma and cheeks and malar region. Traditionally, the nose and premaxilla are not included in the midface.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000309"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie de l&apos;étage moyen de la face</owl:annotatedTarget>
        <babelon:comment>label of HP:0000309 (Abnormality of the midface)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal midface morphology</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000311">
        <obo:IAO_0000115 xml:lang="fr">L&apos;aspect du visage, vu de face, est plus circulaire que d&apos;habitude.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Face ronde</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000311"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">L&apos;aspect du visage, vu de face, est plus circulaire que d&apos;habitude.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000311 (Round face)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The facial appearance is more circular than usual as viewed from the front.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
