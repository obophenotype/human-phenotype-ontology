        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000215">
        <obo:IAO_0000115 xml:lang="fr">Hauteur du vermillon de la lèvre supérieure sur la ligne médiane supérieure à 2 DS au-dessus de la moyenne. Ou encore, une hauteur apparemment plus importante du vermillon de la lèvre supérieure en vue frontale (subjective).</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Lèvre supérieure épaisse</rdfs:label>
    </rdf:Description>
