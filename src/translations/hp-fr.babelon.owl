    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000601">
        <obo:IAO_0000115 xml:lang="fr">Une distance interpupillaire inférieure à 2 DS par rapport à la moyenne (ou l&apos;apparition d&apos;une distance interpupillaire réduite ou d&apos;yeux très rapprochés)</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Hypotélorisme</rdfs:label>
