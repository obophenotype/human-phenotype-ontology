    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000073">
        <obo:IAO_0000115 xml:lang="fr">Anomalie du développement caractérisée par la présence de deux uretères, au lieu d&apos;un seul, reliant un rein à la vessie.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Duplication uretérale</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000073"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie du développement caractérisée par la présence de deux uretères, au lieu d&apos;un seul, reliant un rein à la vessie.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000073 (Ureteral duplication)  ; abnormality of the genitourinary system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A developmental anomaly characterized by the presence of two, instead of one, ureter connecting a kidney to the bladder.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
