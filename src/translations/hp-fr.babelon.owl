        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Facial asymmetry</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000325">
        <obo:IAO_0000115 xml:lang="fr">Contour du visage, vu de face, de forme triangulaire, large au niveau des tempes et s&apos;effilant vers un menton étroit.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Faciès triangulaire</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000325"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Contour du visage, vu de face, de forme triangulaire, large au niveau des tempes et s&apos;effilant vers un menton étroit.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000325 (Triangular face)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Facial contour, as viewed from the front, triangular in shape, with breadth at the temples and tapering to a narrow chin.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000325"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Faciès triangulaire</owl:annotatedTarget>
        <babelon:comment>label of HP:0000325 (Triangular face)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Triangular face</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000326">
        <obo:IAO_0000115 xml:lang="fr">Anomalie du maxillaire (os de la mâchoire supérieure)</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Anomalie du maxillaire</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000326"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie du maxillaire (os de la mâchoire supérieure)</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000326 (Abnormality of the maxilla)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the Maxilla (upper jaw bone).</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000326"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie du maxillaire</owl:annotatedTarget>
        <babelon:comment>label of HP:0000326 (Abnormality of the maxilla)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal maxilla morphology</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000327">
        <obo:IAO_0000115 xml:lang="fr">Dimension anormalement petite du maxillaire. Elle crée généralement une malocclusion ou un mauvais alignement entre les dents supérieures et inférieures ou entraîne une projection insuffisante de la base du nez et de la région inférieure du milieu du visage.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Hypoplasie maxillaire</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000327"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Dimension anormalement petite du maxillaire. Elle crée généralement une malocclusion ou un mauvais alignement entre les dents supérieures et inférieures ou entraîne une projection insuffisante de la base du nez et de la région inférieure du milieu du visage.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000327 (Hypoplasia of the maxilla)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormally small dimension of the Maxilla. Usually creating a malocclusion or malalignment between the upper and lower teeth or resulting in a deficient amount of projection of the base of the nose and lower midface region.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000327"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Hypoplasie maxillaire</owl:annotatedTarget>
        <babelon:comment>label of HP:0000327 (Hypoplasia of the maxilla)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypoplasia of the maxilla</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000329">
        <obo:IAO_0000115 xml:lang="fr">Hémangiome, une tumeur bénigne des cellules endothéliales vasculaires, survenant au niveau du visage.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Hémangiome facial</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000329"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Hémangiome, une tumeur bénigne des cellules endothéliales vasculaires, survenant au niveau du visage.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000329 (Facial hemangioma)  ; abnormality of head or neck ; neoplasm ; abnormality of the cardiovascular system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hemangioma, a benign tumor of the vascular endothelial cells, occurring in the face.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
