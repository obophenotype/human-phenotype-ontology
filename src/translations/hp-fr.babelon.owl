        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000570">
        <obo:IAO_0000115 xml:lang="fr">Anomalie des mouvements oculaires caractérisée par une altération des mouvements oculaires rapides (saccades).</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Saccades oculaires altérées</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000570"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie des mouvements oculaires caractérisée par une altération des mouvements oculaires rapides (saccades).</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000570 (Abnormal saccadic eye movements)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of eye movement characterized by impairment of fast (saccadic) eye movements.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000570"/>
