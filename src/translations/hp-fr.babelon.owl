        <owl:annotatedTarget xml:lang="fr">Télangiectasie labiale</owl:annotatedTarget>
        <babelon:comment>label of HP:0000214 (Lip telangiectasia)  ; abnormality of the integument ; abnormality of head or neck ; abnormality of the cardiovascular system</babelon:comment>
