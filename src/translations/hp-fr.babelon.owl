    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000567">
        <obo:IAO_0000115 xml:lang="fr">Absence d&apos;une région de la rétine, de l&apos;épithélium pigmentaire rétinien et de la choroïde.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Colobome choriorétinien</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000567"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Absence d&apos;une région de la rétine, de l&apos;épithélium pigmentaire rétinien et de la choroïde.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000567 (Chorioretinal coloboma)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of a region of the retina, retinal pigment epithelium, and choroid.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
