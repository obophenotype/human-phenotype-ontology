    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000480">
        <obo:IAO_0000115 xml:lang="fr">Entaille ou fente de la rétine</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Colobome rétinien</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000480"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Entaille ou fente de la rétine</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000480 (Retinal coloboma)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A notch or cleft of the retina or choroid, located vertically below the optic disc.</babelon:source_value>
