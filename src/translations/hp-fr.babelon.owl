        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Hémangiome facial</owl:annotatedTarget>
        <babelon:comment>label of HP:0000329 (Facial hemangioma)  ; abnormality of head or neck ; neoplasm ; abnormality of the cardiovascular system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Facial hemangioma</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000331">
        <obo:IAO_0000115 xml:lang="fr">Diminution de la distance verticale entre le bord vermillon de la lèvre inférieure et le point le plus bas du menton.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Menton court</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000331"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Diminution de la distance verticale entre le bord vermillon de la lèvre inférieure et le point le plus bas du menton.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000331 (Short chin)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased vertical distance from the vermilion border of the lower lip to the inferior-most point of the chin.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000331"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Menton court</owl:annotatedTarget>
        <babelon:comment>label of HP:0000331 (Short chin)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Short chin</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000336">
        <obo:IAO_0000115 xml:lang="fr">Projection avant et/ou latérale de la partie supra-orbitaire des os frontaux supérieure à la moyenne.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Rebord orbitaire saillant</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000336"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Projection avant et/ou latérale de la partie supra-orbitaire des os frontaux supérieure à la moyenne.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000336 (Prominent supraorbital ridges)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Greater than average forward and/or lateral protrusion of the supraorbital portion of the frontal bones.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000336"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Rebord orbitaire saillant</owl:annotatedTarget>
