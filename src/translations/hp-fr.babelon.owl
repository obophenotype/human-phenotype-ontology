        <owl:annotatedTarget xml:lang="fr">Paralysie d&apos;un ou de plusieurs muscles extraoculaires responsables des mouvements oculaires.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000602 (Ophthalmoplegia)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Paralysis of one or more extraocular muscles that are responsible for eye movements.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
