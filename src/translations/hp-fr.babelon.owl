        <babelon:comment>definition of HP:0000603 (Central scotoma)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An area of depressed vision located at the point of fixation and that interferes with central vision.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
