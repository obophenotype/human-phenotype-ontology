    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000248">
        <obo:IAO_0000115 xml:lang="fr">Anomalie de la forme du crâne caractérisée par un diamètre antérieur-postérieur réduit. C&apos;est-à-dire un indice céphalique supérieur à 81 %. Ou encore, une dimension antéro-postérieure (longueur) de la tête apparemment raccourcie par rapport à la largeur.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Brachycéphalie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000248"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie de la forme du crâne caractérisée par un diamètre antérieur-postérieur réduit. C&apos;est-à-dire un indice céphalique supérieur à 81 %. Ou encore, une dimension antéro-postérieure (longueur) de la tête apparemment raccourcie par rapport à la largeur.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000248 (Brachycephaly)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of skull shape characterized by a decreased anterior-posterior diameter. That is, a cephalic index greater than 81%. Alternatively, an apparently shortened anteroposterior dimension (length) of the head compared to width.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000248"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Brachycéphalie</owl:annotatedTarget>
        <babelon:comment>label of HP:0000248 (Brachycephaly)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
