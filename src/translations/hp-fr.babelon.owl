        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Chordée pénienne</owl:annotatedTarget>
        <babelon:comment>label of HP:0000041 (Chordee)  ; abnormality of the genitourinary system</babelon:comment>
