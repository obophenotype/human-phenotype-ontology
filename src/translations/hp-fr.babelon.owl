    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000294">
        <obo:IAO_0000115 xml:lang="fr">Distance entre la ligne des cheveux (trichion) et la glabelle (le point le plus proéminent de l&apos;os frontal au-dessus de la racine du nez), sur la ligne médiane, inférieure de plus de deux écarts-types à la moyenne. Alternativement, une distance apparemment réduite entre la ligne des cheveux et la glabelle.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Implantation basse des cheveux sur le front</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000294"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Distance entre la ligne des cheveux (trichion) et la glabelle (le point le plus proéminent de l&apos;os frontal au-dessus de la racine du nez), sur la ligne médiane, inférieure de plus de deux écarts-types à la moyenne. Alternativement, une distance apparemment réduite entre la ligne des cheveux et la glabelle.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000294 (Low anterior hairline)  ; abnormality of the integument ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Distance between the hairline (trichion) and the glabella (the most prominent point on the frontal bone above the root of the nose), in the midline, more than two SD below the mean. Alternatively, an apparently decreased distance between the hairline and the glabella.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
