        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Smooth philtrum</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000320">
        <rdfs:label xml:lang="fr">Faciès d&apos;oiseau</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000320"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Faciès d&apos;oiseau</owl:annotatedTarget>
        <babelon:comment>label of HP:0000320 (Bird-like facies)  ; abnormality of head or neck</babelon:comment>
