    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000075">
        <obo:IAO_0000115 xml:lang="fr">Anomalie congénitale des voies urinaires, dans laquelle le rein est dédoublé et est drainé par deux bassines rénales et deux uretères distincts.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Duplication rénale</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000075"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie congénitale des voies urinaires, dans laquelle le rein est dédoublé et est drainé par deux bassines rénales et deux uretères distincts.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000075 (Renal duplication)  ; abnormality of the genitourinary system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A congenital anomaly of the urinary tract, in which the kidney is duplicated and is drained via two separate renal pelves and ureters.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
