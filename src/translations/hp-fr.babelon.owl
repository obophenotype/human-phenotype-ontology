        <rdfs:label xml:lang="fr">Sténose des choanes</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000452"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Rétrécissement anormal des choanes (l&apos;ouverture nasale postérieure).</owl:annotatedTarget>
