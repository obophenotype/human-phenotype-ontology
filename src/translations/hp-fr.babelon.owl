    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000252">
        <obo:IAO_0000115 xml:lang="fr">Circonférence occipito-frontale (tête) inférieure à -3 écarts-types par rapport aux normes normales appropriées, appariées selon l&apos;âge (Ross JJ,1977.PMID:9683597). Alternativement, une diminution de la taille du crâne.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Microcéphalie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000252"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Circonférence occipito-frontale (tête) inférieure à -3 écarts-types par rapport aux normes normales appropriées, appariées selon l&apos;âge (Ross JJ,1977.PMID:9683597). Alternativement, une diminution de la taille du crâne.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000252 (Microcephaly)  ; abnormality of the nervous system ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Head circumference below 2 standard deviations below the mean for age and gender.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
