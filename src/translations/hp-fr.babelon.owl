    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000580">
        <obo:IAO_0000115 xml:lang="fr">Anomalie de la rétine caractérisée par un dépôt de pigments. Elle est généralement associée à la migration et à la prolifération de macrophages ou de cellules épithéliales du pigment rétinien dans la rétine ; la mélanine de ces cellules est à l&apos;origine des changements pigmentaires. La rétinopathie pigmentaire est une voie finale commune à de nombreuses affections rétiniennes et est souvent associée à une perte de vision.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Rétinopathie pigmentaire</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000580"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie de la rétine caractérisée par un dépôt de pigments. Elle est généralement associée à la migration et à la prolifération de macrophages ou de cellules épithéliales du pigment rétinien dans la rétine ; la mélanine de ces cellules est à l&apos;origine des changements pigmentaires. La rétinopathie pigmentaire est une voie finale commune à de nombreuses affections rétiniennes et est souvent associée à une perte de vision.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000580 (Pigmentary retinopathy)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the retina characterized by pigment deposition. It is typically associated with migration and proliferation of macrophages or retinal pigment epithelial cells into the retina; melanin from these cells causes the pigmentary changes. Pigmentary retinopathy is a common final pathway of many retinal conditions and is often associated with visual loss.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000580"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Rétinopathie pigmentaire</owl:annotatedTarget>
        <babelon:comment>label of HP:0000580 (Pigmentary retinopathy)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pigmentary retinopathy</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000581">
        <obo:IAO_0000115 xml:lang="fr">Une réduction fixe de la distance verticale entre les paupières supérieures et inférieures avec des fissures palpébrales courtes.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Blépharophimosis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
