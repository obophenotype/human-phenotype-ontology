    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000029">
        <obo:IAO_0000115 xml:lang="fr">Dégénérescence (atrophie) des testicules (les gonades mâles) qui se traduit par une diminution de la taille des testicules et éventuellement une perte de la fertilité</obo:IAO_0000115>
