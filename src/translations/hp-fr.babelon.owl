    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000600">
        <obo:IAO_0000115 xml:lang="fr">Une anomalie du pharynx, c&apos;est-à-dire de la structure tubulaire qui s&apos;étend de la base du crâne, en haut, à l&apos;entrée de l&apos;œsophage, en bas.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Anomalie du pharynx</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000600"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une anomalie du pharynx, c&apos;est-à-dire de la structure tubulaire qui s&apos;étend de la base du crâne, en haut, à l&apos;entrée de l&apos;œsophage, en bas.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000600 (Abnormality of the pharynx)  ; abnormality of head or neck</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly of the pharynx, i.e., of the tubular structure extending from the base of the skull superiorly to the esophageal inlet inferiorly.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
