    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000481">
        <obo:IAO_0000115 xml:lang="fr">Toute anomalie de la cornée, qui est le tissu transparent situé à l&apos;avant de l&apos;œil et qui recouvre l&apos;iris, la pupille et la chambre antérieure.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Morphologie de la cornée anormale</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000481"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Toute anomalie de la cornée, qui est le tissu transparent situé à l&apos;avant de l&apos;œil et qui recouvre l&apos;iris, la pupille et la chambre antérieure.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000481 (Abnormal cornea morphology)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any abnormality of the cornea, which is the transparent tissue at the front of the eye that covers the iris, pupil, and anterior chamber.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000481"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Morphologie de la cornée anormale</owl:annotatedTarget>
        <babelon:comment>label of HP:0000481 (Abnormal cornea morphology)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal cornea morphology</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000482">
        <obo:IAO_0000115 xml:lang="fr">Anomalie congénitale de la cornée : la cornée et le segment antérieur de l&apos;œil sont plus petits que la normale. Le diamètre horizontal de la cornée n&apos;atteint pas 10 mm, même à l&apos;âge adulte.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Microcornée</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000482"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Anomalie congénitale de la cornée : la cornée et le segment antérieur de l&apos;œil sont plus petits que la normale. Le diamètre horizontal de la cornée n&apos;atteint pas 10 mm, même à l&apos;âge adulte.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000482 (Microcornea)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A congenital abnormality of the cornea in which the cornea and the anterior segment of the eye are smaller than normal. The horizontal diameter of the cornea does not reach 10 mm even in adulthood.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000482"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Microcornée</owl:annotatedTarget>
        <babelon:comment>label of HP:0000482 (Microcornea)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Microcornea</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000483">
        <obo:IAO_0000115 xml:lang="fr">Un type d&apos;astigmatisme associé à des courbures anormales sur la surface antérieure et/ou postérieure de la cornée.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Astigmatisme</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000483"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Un type d&apos;astigmatisme associé à des courbures anormales sur la surface antérieure et/ou postérieure de la cornée.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000483 (Astigmatism)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of refraction error associated with abnormal curvatures on the anterior and/or posterior surface of the cornea.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000483"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Astigmatisme</owl:annotatedTarget>
        <babelon:comment>label of HP:0000483 (Astigmatism)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Astigmatism</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000484">
        <obo:IAO_0000115 xml:lang="fr">Forme d&apos;astigmatisme dans laquelle un méridien est hypermétrope alors que celui qui lui fait face à angle droit ne présente pas d&apos;erreur de réfraction.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Astigmatisme hyperopique</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000484"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Forme d&apos;astigmatisme dans laquelle un méridien est hypermétrope alors que celui qui lui fait face à angle droit ne présente pas d&apos;erreur de réfraction.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000484 (Hyperopic astigmatism)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of astigmatism in which one meridian is hyperopic while the one at a right angle to it has no refractive error.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000484"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Astigmatisme hyperopique</owl:annotatedTarget>
        <babelon:comment>label of HP:0000484 (Hyperopic astigmatism)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hyperopic astigmatism</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000485">
        <obo:IAO_0000115 xml:lang="fr">Un élargissement de la cornée avec une clarté et une fonction normales. La mégalocornée est diagnostiquée lorsque le diamètre horizontal de la cornée est de 12 mm ou plus à la naissance ou de 13 mm ou plus après l&apos;âge de deux ans.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Mégacornée</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000485"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Un élargissement de la cornée avec une clarté et une fonction normales. La mégalocornée est diagnostiquée lorsque le diamètre horizontal de la cornée est de 12 mm ou plus à la naissance ou de 13 mm ou plus après l&apos;âge de deux ans.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000485 (Megalocornea)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An enlargement of the cornea with normal clarity and function. Megalocornea is diagnosed with a horizontal corneal diameter of 12 mm or more at birth or 13 mm or more after two years of age.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000485"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Mégacornée</owl:annotatedTarget>
        <babelon:comment>label of HP:0000485 (Megalocornea)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Megalocornea</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000486">
        <obo:IAO_0000115 xml:lang="fr">Un défaut d&apos;alignement des yeux tel que les axes visuels s&apos;écartent de la fixation bifovéale. La classification du strabisme peut se fonder sur un certain nombre de caractéristiques, notamment la position relative des yeux, le caractère latent ou manifeste, intermittent ou constant, concomitant ou non, l&apos;âge d&apos;apparition et la pertinence de toute erreur de réfraction associée.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Strabisme</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000486"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Un défaut d&apos;alignement des yeux tel que les axes visuels s&apos;écartent de la fixation bifovéale. La classification du strabisme peut se fonder sur un certain nombre de caractéristiques, notamment la position relative des yeux, le caractère latent ou manifeste, intermittent ou constant, concomitant ou non, l&apos;âge d&apos;apparition et la pertinence de toute erreur de réfraction associée.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000486 (Strabismus)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A misalignment of the eyes so that the visual axes deviate from bifoveal fixation. The classification of strabismus may be based on a number of features including the relative position of the eyes, whether the deviation is latent or manifest, intermittent or constant, concomitant or otherwise and according to the age of onset and the relevance of any associated refractive error.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000486"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Strabisme</owl:annotatedTarget>
        <babelon:comment>label of HP:0000486 (Strabismus)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Strabismus</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000488">
        <obo:IAO_0000115 xml:lang="fr">Toute maladie non inflammatoire de la rétine. Ce terme non spécifique est conservé ici en raison de sa large utilisation dans la littérature, mais si possible, les nouvelles annotations doivent indiquer le type précis d&apos;anomalie rétinienne.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Rétinopathie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000488"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Toute maladie non inflammatoire de la rétine. Ce terme non spécifique est conservé ici en raison de sa large utilisation dans la littérature, mais si possible, les nouvelles annotations doivent indiquer le type précis d&apos;anomalie rétinienne.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000488 (Retinopathy)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any noninflammatory disease of the retina. This nonspecific term is retained here because of its wide use in the literature, but if possible new annotations should indicate the precise type of retinal abnormality.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000488"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Rétinopathie</owl:annotatedTarget>
        <babelon:comment>label of HP:0000488 (Retinopathy)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000490">
        <obo:IAO_0000115 xml:lang="fr">Un œil plus profondément enfoncé dans le plan du visage que d&apos;habitude.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Enophtalmie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000490"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Un œil plus profondément enfoncé dans le plan du visage que d&apos;habitude.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000490 (Deeply set eye)  ; abnormality of the eye</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An eye that is more deeply recessed into the plane of the face than is typical.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000490"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Enophtalmie</owl:annotatedTarget>
        <babelon:comment>label of HP:0000490 (Deeply set eye)  ; abnormality of the eye</babelon:comment>
