    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000445">
        <obo:IAO_0000115 xml:lang="fr">Distance interalaire supérieure de plus de deux écarts-types à la moyenne pour l&apos;âge, c&apos;est-à-dire une largeur apparemment accrue de la base nasale et de l&apos;aileron.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Nez large</rdfs:label>
    </rdf:Description>
