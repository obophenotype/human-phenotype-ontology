    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000076">
        <obo:IAO_0000115 xml:lang="fr">Mouvement anormal (rétrograde) de l&apos;urine de la vessie vers les uretères ou les reins, lié à une insuffisance du mécanisme valvulaire à la jonction urétéro-vésiculaire ou à d&apos;autres causes.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Reflux vésico-urétéral</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000076"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Mouvement anormal (rétrograde) de l&apos;urine de la vessie vers les uretères ou les reins, lié à une insuffisance du mécanisme valvulaire à la jonction urétéro-vésiculaire ou à d&apos;autres causes.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000076 (Vesicoureteral reflux)  ; abnormality of the genitourinary system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal (retrograde) movement of urine from the bladder into ureters or kidneys related to inadequacy of the valvular mechanism at the ureterovesicular junction or other causes.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
