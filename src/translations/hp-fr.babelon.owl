    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000268">
        <obo:IAO_0000115 xml:lang="fr">Une anomalie de la forme du crâne caractérisée par une augmentation du diamètre antéro-postérieur, c&apos;est-à-dire une augmentation de la dimension antéro-postérieure du crâne. Un indice céphalique inférieur à 76 %. Alternativement, une longueur antéro-postérieure de la tête apparemment accrue par rapport à la largeur. Souvent due à une fermeture prématurée de la suture sagittale.</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Dolichocéphalie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000268"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Une anomalie de la forme du crâne caractérisée par une augmentation du diamètre antéro-postérieur, c&apos;est-à-dire une augmentation de la dimension antéro-postérieure du crâne. Un indice céphalique inférieur à 76 %. Alternativement, une longueur antéro-postérieure de la tête apparemment accrue par rapport à la largeur. Souvent due à une fermeture prématurée de la suture sagittale.</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000268 (Dolichocephaly)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of skull shape characterized by a increased anterior-posterior diameter, i.e., an increased antero-posterior dimension of the skull. Cephalic index less than 76%. Alternatively, an apparently increased antero-posterior length of the head compared to width. Often due to premature closure of the sagittal suture.</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000268"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="fr">Dolichocéphalie</owl:annotatedTarget>
        <babelon:comment>label of HP:0000268 (Dolichocephaly)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dolichocephaly</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000269">
        <obo:IAO_0000115 xml:lang="fr">Augmentation de la convexité de l&apos;occiput (partie postérieure du crâne).</obo:IAO_0000115>
        <rdfs:label xml:lang="fr">Proéminence occipitale</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000269"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="fr">Augmentation de la convexité de l&apos;occiput (partie postérieure du crâne).</owl:annotatedTarget>
        <babelon:comment>definition of HP:0000269 (Prominent occiput)  ; abnormality of head or neck ; abnormality of the skeletal system</babelon:comment>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased convexity of the occiput (posterior part of the skull).</babelon:source_value>
        <babelon:translation_language>fr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000269"/>
