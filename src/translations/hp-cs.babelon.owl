    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032208">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená koncentrace N-terminálního telopeptidu (NTx) kolagenu typu 1 v moči. Obecně se test provádí po určitou dobu, např. lze odebrat 10 cm3 ranní moči po 12 hodinách nočního lačnění nebo po dobu 24 hodin.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená hladina N-terminálního telopeptidu kolagenu typu 1 v moči</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032208"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená koncentrace N-terminálního telopeptidu (NTx) kolagenu typu 1 v moči. Obecně se test provádí po určitou dobu, např. lze odebrat 10 cm3 ranní moči po 12 hodinách nočního lačnění nebo po dobu 24 hodin.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An increased concentration of type 1 collagen N-terminal telopeptide (NTx) level in the urine. Generally the test is performed over a period of time, for instance, 10 cc of morning urine can be collected following 12 hours overnight fasting or for 24 hours.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
