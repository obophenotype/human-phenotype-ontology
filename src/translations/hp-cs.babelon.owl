    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025361">
        <obo:IAO_0000115 xml:lang="cs">Strukturální anomálie pyramid dospělé ledviny, což je kónická struktura, která svou širokou bazí naléhá na kůru ledviny a její úzká špička je nazvaná papilla.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Morfologická abnormalita dřenových pyramid ledviny</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025361"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Strukturální anomálie pyramid dospělé ledviny, což je kónická struktura, která svou širokou bazí naléhá na kůru ledviny a její úzká špička je nazvaná papilla.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A structural anomaly of the pyramid of the adult kidney, cone-shaped structures with a broad base adjacent to the renal cortex and the narrow apex that is termed papilla.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025361"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Morfologická abnormalita dřenových pyramid ledviny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal medullary pyramid morphology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025362">
        <obo:IAO_0000115 xml:lang="cs">Nedostatečně vyrostlá pyramida dospělé ledviny, což je kónická struktura, která svou širokou bazí naléhá na kůru ledviny a její úzká špička je nazvaná papilla.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hypoplazie pyramid dřeně ledviny</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025362"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nedostatečně vyrostlá pyramida dospělé ledviny, což je kónická struktura, která svou širokou bazí naléhá na kůru ledviny a její úzká špička je nazvaná papilla.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Undergrowth of the pyramid of the adult kidney, cone-shaped structures with a broad base adjacent to the renal cortex and the narrow apex that is termed papilla.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025362"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hypoplazie pyramid dřeně ledviny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Renal medullary pyramid hypoplasia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025363">
        <obo:IAO_0000115 xml:lang="cs">Hypercelularita v důsledku zvýšeného počtu buněk v luminu glomerulární kapiláry, což způsobuje zúžení lumina.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Glomerulární endokapilární hypercelularita</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025363"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Hypercelularita v důsledku zvýšeného počtu buněk v luminu glomerulární kapiláry, což způsobuje zúžení lumina.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypercellularity due to increased number of cells within glomerular capillary lumina, causing narrowing of the lumina.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025363"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Glomerulární endokapilární hypercelularita</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Glomerular endocapillary hypercellularity</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025364">
        <obo:IAO_0000115 xml:lang="cs">Hypercelularita (zvýšené množství buněk) v glomerulu ledviny ale mimo glomerulární kapiláry, t.j. v Bownanově pouzdrě, kde je více než jedna vrstva parietálních nebo viscerálních epiteliálních buněk.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Glomerulární extrakapilární hypercelularita</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025364"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Hypercelularita (zvýšené množství buněk) v glomerulu ledviny ale mimo glomerulární kapiláry, t.j. v Bownanově pouzdrě, kde je více než jedna vrstva parietálních nebo viscerálních epiteliálních buněk.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypercellularity (increased number of cells) in the renal glomerulus but external to the glomerular capillaries, i.e., in the Bowman space or more than one layer of parietal or visceral epithelial cells.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025364"/>
