        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Arcuate artery intimal mucoid edema</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033916">
        <obo:IAO_0000115 xml:lang="cs">Ztluštění intimy s fibrózou a/nebo duplikací elastické laminy ve venae arcuatae</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Venoskleróza intimy/medie vena arcuata</rdfs:label>
