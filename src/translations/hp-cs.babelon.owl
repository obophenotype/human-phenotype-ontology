    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001007">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně zvýšený růst ochlupení vykazující mužský vzor ochlupení (androgenní ochlupení)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hirsutizmus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001007"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně zvýšený růst ochlupení vykazující mužský vzor ochlupení (androgenní ochlupení)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormally increased hair growth referring to a male pattern of body hair (androgenic hair).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
