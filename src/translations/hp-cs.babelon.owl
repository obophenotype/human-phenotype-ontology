    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031418">
        <obo:IAO_0000115 xml:lang="cs">Anomálně zvýšený poměr hmotnosti k výšce na druhou, který se vypočítá tak, že se individuální hmotnost v kilogramech vydělí druhou mocninou tělesné výšky v metrech a tento poměr je používán jako indikátor nadváhy ve srovnání s průměrnými populačními hodnotami.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšený index tělesné hmotnosti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031418"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomálně zvýšený poměr hmotnosti k výšce na druhou, který se vypočítá tak, že se individuální hmotnost v kilogramech vydělí druhou mocninou tělesné výšky v metrech a tento poměr je používán jako indikátor nadváhy ve srovnání s průměrnými populačními hodnotami.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormally increased weight-to-height squared ratio, calculated by dividing the individual&apos;s weight in kilograms by the square of the individual&apos;s height in meters and used as an indicator of overweight compared to averages.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031418"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
