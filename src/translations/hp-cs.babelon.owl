    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0410251">
        <obo:IAO_0000115 xml:lang="cs">Porucha štěpení L-selektinu při navádění neutrofilů do místa infekce. Proteolytické štěpení L-selektinu má za následek jeho rychlé odlučování z povrchu buněk, což má význam pro stáčení neutrofilů a jejich hromadění v místě infekce.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální vylučování L-selektinu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410251"/>
