    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003118">
        <obo:IAO_0000115 xml:lang="cs">Nadprodukce hormonu kortizolu kůrou nadledvin, která vede k charakteristické kombinaci klinických příznaků označovaných jako Cushingův syndrom, s obezitou trupu, kulatým, plným obličejem, striae atrophicae a akné, svalovou slabostí a dalšími příznaky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená hladina cirkulující kortizolu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
