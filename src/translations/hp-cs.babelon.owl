    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004362">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita střevního nervového systému, který zahrnuje dva typy ganglií, myenterický (Auerbachův) a podslizniční (Meissnerův) plexus. Funkce střevního nervového systému spočívá v řízení pohybu střeva, výměny tekutin mezi střevem a jeho lumenem a místního průtoku krve.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormalita morfologie střevních ganglií</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004362"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita střevního nervového systému, který zahrnuje dva typy ganglií, myenterický (Auerbachův) a podslizniční (Meissnerův) plexus. Funkce střevního nervového systému spočívá v řízení pohybu střeva, výměny tekutin mezi střevem a jeho lumenem a místního průtoku krve.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the enteric nervous system, which comprises two types of ganglia, the myenteric (Auerbach&apos;s) and submucosal (Meissner&apos;s) plexuses. The enteric nervous system functions to control gut movement, fluid exchange between the gut and its lumen, and local blood flow.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004362"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita morfologie střevních ganglií</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
