        <babelon:source_value>Constant exotropia for near and distance, presenting after 6 months of age.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
