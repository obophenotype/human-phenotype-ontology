        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032017">
        <obo:IAO_0000115 xml:lang="cs">Zvýšený podíl eozinofilů ve sputu dle diferenciálního rozpočtu buněk</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Eosinofilie sputa</rdfs:label>
    </rdf:Description>
