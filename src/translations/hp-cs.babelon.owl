    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000032">
        <obo:IAO_0000115 xml:lang="cs">Vjem, že se tělo pohybuje nebo houpe, přestože se nepohybuje.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Falešné vnímání vlastního pohybu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000032"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vjem, že se tělo pohybuje nebo houpe, přestože se nepohybuje.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A perception that one&apos;s body is moving or swaying despite lack of motion of the body.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000032"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Falešné vnímání vlastního pohybu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>False perception of self-motion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000033">
        <obo:IAO_0000115 xml:lang="cs">Závratě, kdy se člověk cítí nestabilní, ale který se nevyznačuje točivým pocitem jako při klasické závrati, ale spíše pocitem oscilace (houpání, pohupování nebo kymácení navzdory skutečnosti, že se subjekt nehýbe).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Netočivé vertigo</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000033"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Závratě, kdy se člověk cítí nestabilní, ale který se nevyznačuje točivým pocitem jako při klasické závrati, ale spíše pocitem oscilace (houpání, pohupování nebo kymácení navzdory skutečnosti, že se subjekt nehýbe).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A perception of unsteadiness of dizziness that is not characterized bythe spinning sensation of classic vertigo, but rather by an oscillatory perception (rocking, bobbing, or swaying despite the fact that the subject is not moving).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000033"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Netočivé vertigo</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Non-spinning vertigo</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
