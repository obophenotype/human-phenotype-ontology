        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0040228">
        <obo:IAO_0000115 xml:lang="cs">Snížená hladina plasminogenu</obo:IAO_0000115>
