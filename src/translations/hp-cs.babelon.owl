        <owl:annotatedTarget xml:lang="cs">Zúžení foramen obturatorium. Foramen obturatorium (taktéž známé jako foramen obturatum) je otvor mezi sedacími a stydkými kostmi pánve.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased width of the foramen obturatorium. The foramen obturatorium (also known as the obturator foramen) is a hole located between the ischium and pubis bones of the pelvis.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
