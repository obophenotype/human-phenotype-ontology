    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012183">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost mnohočetných hyperplastických polypů v tlustém střevě. Hyperplastické polypy jsou obvykle velké asi 5 mm a vykazují hyperplastickou proliferaci sliznice.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hyperplastická polypóza tlustého střeva</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012183"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost mnohočetných hyperplastických polypů v tlustém střevě. Hyperplastické polypy jsou obvykle velké asi 5 mm a vykazují hyperplastickou proliferaci sliznice.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Presence of multiple hyperplastic polyps in the colon. Hyperplastic polyps are generally about 5 mm in size and show hyperplastic mucosal proliferation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
