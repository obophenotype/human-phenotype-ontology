    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010693">
        <obo:IAO_0000115 xml:lang="cs">Druh vrozené katarakty, která je charakterizována dutým sférickým útvarem bodových zákalů zasahujících zahrnující fetální jádro čočky a která se obvykle vyskytuje oboustranně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pulverulentní katarakta</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010693"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Druh vrozené katarakty, která je charakterizována dutým sférickým útvarem bodových zákalů zasahujících zahrnující fetální jádro čočky a která se obvykle vyskytuje oboustranně.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A kind of congenital cataract that is characterized by a hollow sphere of punctate opacities involving the fetal nucleus and that usually occurs bilaterally.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
