        <babelon:source_value>Focal impaired awareness cognitive seizure with anomia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032792">
        <obo:IAO_0000115 xml:lang="cs">Tonický záchvat je typ motorického záchvatu charakterizovaný jednostranným nebo oboustranným ztuhnutím nebo elevací končetin, často se ztuhnutím krku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Tonický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032792"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Tonický záchvat je typ motorického záchvatu charakterizovaný jednostranným nebo oboustranným ztuhnutím nebo elevací končetin, často se ztuhnutím krku.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A tonic seizure is a type of motor seizure characterized by unilateral or bilateral limb stiffening or elevation, often with neck stiffening.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032792"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Tonický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032793">
        <obo:IAO_0000115 xml:lang="cs">Fokální kognitivní záchvat s receptivní dysfázií / afázií charakterizovaný poruchou vědomí v určitém okamžiku záchvatu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kognitivní záchvat s poruchou vědomí a s receptivní dysfázií/afázií</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032793"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kognitivní záchvat s receptivní dysfázií / afázií charakterizovaný poruchou vědomí v určitém okamžiku záchvatu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal cognitive seizure with receptive dysphasia / aphasia characterized by impairment of awareness at some point during the seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032793"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kognitivní záchvat s poruchou vědomí a s receptivní dysfázií/afázií</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal impaired awareness cognitive seizure with receptive dysphasia/aphasia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032794">
        <obo:IAO_0000115 xml:lang="cs">Myoklonický záchvat je typ motorického záchvatu charakterizovaný náhlou, krátkou (100 ms) mimovolní kontrakcí jednoho nebo více svalů nebo svalových skupin s různou topografií (axiální, proximální končetiny, distální). Myoklonus je méně pravidelně se opakující a méně trvalý než klonus.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Myoklonický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032794"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Myoklonický záchvat je typ motorického záchvatu charakterizovaný náhlou, krátkou (100 ms) mimovolní kontrakcí jednoho nebo více svalů nebo svalových skupin s různou topografií (axiální, proximální končetiny, distální). Myoklonus je méně pravidelně se opakující a méně trvalý než klonus.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A myoclonic seizure is a type of motor seizure characterized by sudden, brief (&lt;100 ms) involuntary single or multiple contraction of muscles or muscle groups of variable topography (axial, proximal limb, distal). Myoclonus is less regularly repetitive and less sustained than is clonus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032794"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Myoklonický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Myoclonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032795">
        <obo:IAO_0000115 xml:lang="cs">Generalizované myoklonicko-tonicko-klonické křeče jsou typem generalizované motorické křeče charakterizované jedním nebo více záškuby končetin oboustranně, po nichž následuje tonická a klonická fáze. Počáteční záškuby lze považovat buď za krátké období klonu, nebo za myoklonus.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Generalizované myoklonicko-tonicko-klonické křeče</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032795"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Generalizované myoklonicko-tonicko-klonické křeče jsou typem generalizované motorické křeče charakterizované jedním nebo více záškuby končetin oboustranně, po nichž následuje tonická a klonická fáze. Počáteční záškuby lze považovat buď za krátké období klonu, nebo za myoklonus.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A generalized myoclonic-tonic-clonic seizure is a type of generalized motor seizure characterized by a single or multiple jerks of limbs bilaterally, followed by tonic and clonic phases. The initial jerks can be considered to be either a brief period of clonus or myoclonus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032795"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Generalizované myoklonicko-tonicko-klonické křeče</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Generalized myoclonic-tonic-clonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032796">
        <obo:IAO_0000115 xml:lang="cs">Fokální kognitivní křeč s levopravou dezorientací charakterizovanou poruchou vědomí v určitém okamžiku křeče.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální porucha vědomí s kognitivním záchvatem s levopravou dezorientací</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032796"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kognitivní křeč s levopravou dezorientací charakterizovanou poruchou vědomí v určitém okamžiku křeče.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal cognitive seizure with left-right confusion characterized by impairment of awareness at some point during the seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032796"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální porucha vědomí s kognitivním záchvatem s levopravou dezorientací</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
