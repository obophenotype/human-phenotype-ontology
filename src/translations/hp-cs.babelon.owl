        <babelon:source_value>Mild</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012826">
        <obo:IAO_0000115 xml:lang="cs">Se středním stupněm závažnosti. U kvantitativních znaků odchylka mezi třemi a čtyřmi směrodatnými odchylkami od příslušného populačního průměru.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Střední</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012826"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Se středním stupněm závažnosti. U kvantitativních znaků odchylka mezi třemi a čtyřmi směrodatnými odchylkami od příslušného populačního průměru.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Having a medium degree of severity. For quantitative traits, a deviation of between three and four standard deviations from the appropriate population mean.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
