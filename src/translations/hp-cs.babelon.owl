        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034194"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Štěpení v suprabazální buněčné vrstvě epidermis, která leží přímo nad bazální vrstvou a je složena z pěti až deseti vrstev buněk.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cleavage within the suprabasal cell layer of the epidermis, which lies directly above the basal layer and is composed of five to ten layers of cells.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034194"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Suprabazální štěpení</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Suprabasal cleavage</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034195">
        <obo:IAO_0000115 xml:lang="cs">Vztahuje se na příznak nebo symptom, který je vyvolán nebo způsoben působením svalového relaxancia, jako je suxamethonium a mivakurium.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vyvoláno svalovým relaxantem</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034195"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vztahuje se na příznak nebo symptom, který je vyvolán nebo způsoben působením svalového relaxancia, jako je suxamethonium a mivakurium.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Applies to a sign or symptom that is provoked or brought about by exposure to a muscle relaxant such as suxamethonium and mivacurium.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
