        <owl:annotatedTarget xml:lang="cs">Kyklopie je vrozená abnormalita, kdy je přítomno pouze jedno oko. Oko je centrálně umístěno v oblasti, kde se bežně nachází kořen nosu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cyclopia is a congenital abnormality in which there is only one eye. That eye is centrally placed in the area normally occupied by the root of the nose.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
