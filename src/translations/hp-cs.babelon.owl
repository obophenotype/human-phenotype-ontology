    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031922">
        <obo:IAO_0000115 xml:lang="cs">Renální arterie zabezpečují přívod krve z aorty do ledvin. Obvykle je přítomná jedna renální arterie na každé straně těla. Zdvojení renální arterie vyjadřuje stav, kdy se místo jedné nachází dvě renální arterie na jedné straně těla.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zdvojená renální arterie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031922"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Renální arterie zabezpečují přívod krve z aorty do ledvin. Obvykle je přítomná jedna renální arterie na každé straně těla. Zdvojení renální arterie vyjadřuje stav, kdy se místo jedné nachází dvě renální arterie na jedné straně těla.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The renal arteries carry blood from the aorta to the kidney; normally one renal artery is present on each side of the body. Renal artery duplication refers to the presence of two rather than one renal artery on a given side of the body.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031922"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zdvojená renální arterie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Renal artery duplication</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031923">
        <obo:IAO_0000115 xml:lang="cs">Hromadění krve v pochvě obvykle v důsledku vaginální obstrukce.</obo:IAO_0000115>
