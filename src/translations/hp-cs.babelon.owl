    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0410255">
        <obo:IAO_0000115 xml:lang="cs">Přechodné snížení počtu neutrofilů v periferní krvi. Přechodná neutropenie je nejčastěji spojena s virovou infekcí, ale další příčiny zahrnují léky a autoimunitu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Přechodná neutropenie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410255"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přechodné snížení počtu neutrofilů v periferní krvi. Přechodná neutropenie je nejčastěji spojena s virovou infekcí, ale další příčiny zahrnují léky a autoimunitu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal decrease of the absolute number of neutrophils in the blood, per microlitre, compared to a reference range for a given sex and age-group, which persists for less than 3 months and then spontaneously recovers, but does not recur cyclically.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
