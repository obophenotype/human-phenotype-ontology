    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030050">
        <obo:IAO_0000115 xml:lang="cs">Abnormální jev charakterizovaný klasickou tetrádou nadměrné denní ospalosti s neodolatelnými atakami ospalosti, kataplexií (náhlá oboustranná ztráta svalového tonu), s hypnagogickýma halucinacema a spánkovým ochrnutím</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Narkolepsie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030050"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální jev charakterizovaný klasickou tetrádou nadměrné denní ospalosti s neodolatelnými atakami ospalosti, kataplexií (náhlá oboustranná ztráta svalového tonu), s hypnagogickýma halucinacema a spánkovým ochrnutím</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal phenomenon characterized by a classic tetrad of excessive daytime sleepiness with irresistible sleep attacks, cataplexy (sudden bilateral loss of muscle tone), hypnagogic hallucination, and sleep paralysis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
