    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033882">
        <obo:IAO_0000115 xml:lang="cs">Amorfní extracelulární látka ve vnitřní nebo střední vrstvě venae arcuatae ledvin. Amyloidóza se barví pozitivně konžskou červení s typicky jablkově zeleným dvojlomem na polarizační mikroskopii a 8-12 nm širokými fibrily v elektronové mikroskopii.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Amyloidóza intimy/medie vena arcuata</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033882"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Amorfní extracelulární látka ve vnitřní nebo střední vrstvě venae arcuatae ledvin. Amyloidóza se barví pozitivně konžskou červení s typicky jablkově zeleným dvojlomem na polarizační mikroskopii a 8-12 nm širokými fibrily v elektronové mikroskopii.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Amorphous extracellular substance in the inner or middle layer of the arcuate veins of the kidney. Amyloidosis stains Congo-red positive with typically an apple green birerfingence on polarization microscopy, and 8-12 nm fibrils on electron microscopy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
