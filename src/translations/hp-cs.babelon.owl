        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012037">
        <obo:IAO_0000115 xml:lang="cs">Ochabování prsních svalů, tj. musculus pectoralis major a musculus pectoralis minor</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Amyotrofie prsních svalů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012037"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Ochabování prsních svalů, tj. musculus pectoralis major a musculus pectoralis minor</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Wasting of the pectoral muscles, i.e., of the pectoralis major and pectoralis minor. This finding is often manifested by prominent axillary creases or double axillary creases.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012037"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Amyotrofie prsních svalů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pectoralis amyotrophy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012038">
        <obo:IAO_0000115 xml:lang="cs">Rohovková guttata jsou kapkovité nahromadění nepruhovaného kolagenu na zadním povrchu Descemetovy membrány. Přítomnost fokálních ztluštění Descemetovy membrány se histologicky nazývá gutty. Guttata rohovku lze snadno diagnostikovat in vivo a ex vivo pomocí zrcadlového mikroskopu, protože se v něm objevují tmavé oblasti, kde nejsou viditelné endotelové buňky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Cornea guttata</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012038"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Rohovková guttata jsou kapkovité nahromadění nepruhovaného kolagenu na zadním povrchu Descemetovy membrány. Přítomnost fokálních ztluštění Descemetovy membrány se histologicky nazývá gutty. Guttata rohovku lze snadno diagnostikovat in vivo a ex vivo pomocí zrcadlového mikroskopu, protože se v něm objevují tmavé oblasti, kde nejsou viditelné endotelové buňky.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Corneal guttata are droplet-like accumulations of non-banded collagen on the posterior surface of Descemet&apos;s membrane. The presence of focal thickenings of Descemet&apos;s membrane histologically named guttae. Cornea guttata can be easily diagnosed in vivo and ex vivo by means of specular microscopy as it gives dark areas where no endothelial cells are visible.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012038"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Cornea guttata</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Corneal guttata</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012039">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost záhybů v Descemetově membráně, což je bazální membrána endoteliální (vnitřní) buněčné vrstvy rohovky. Záhyby Descemetovy membrány jsou obecně projevem zánětu nebo otoku rohovky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Záhyby Descemetovy membrány</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012039"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost záhybů v Descemetově membráně, což je bazální membrána endoteliální (vnitřní) buněčné vrstvy rohovky. Záhyby Descemetovy membrány jsou obecně projevem zánětu nebo otoku rohovky.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Presence of folds in the Descemet membrane, which is the basement membrane of the endothelial (inner) cell layer of the cornea. Descemet membrane folds are generally a manifestation of inflammation or edema of the cornea.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012039"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Záhyby Descemetovy membrány</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Descemet Membrane Folds</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012040">
