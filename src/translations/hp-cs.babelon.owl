        <obo:IAO_0000115 xml:lang="cs">Neobvykle závažná infekce způsobená virem ifluenzy</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Závažná infekce virem influenzy</rdfs:label>
    </rdf:Description>
