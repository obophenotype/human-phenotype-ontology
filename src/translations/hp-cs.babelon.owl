        <owl:annotatedTarget xml:lang="cs">Maligní melanom vycházející z oka. Nádor pochází z melanocytů uvey (která zahrnuje duhovku, řasnaté tělísko a cévnatku)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A malignant melanoma originating within the eye. The tumor originates from the melanocytes in the uvea (which comprises the iris, ciliary body, and choroid).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
