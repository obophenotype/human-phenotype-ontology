    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0008148"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální reakce na adrenalin, která se projevuje sníženou nebo chybějící agregací krevních destiček po přidání adrenalinu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
