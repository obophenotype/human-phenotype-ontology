        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000651">
        <obo:IAO_0000115 xml:lang="cs">Diplopie je stav, v níž je jeden objekt vnímán jako dva obrazy, také známý jako dvojité vidění</obo:IAO_0000115>
