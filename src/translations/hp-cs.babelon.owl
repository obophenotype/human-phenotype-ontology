    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000316">
        <obo:IAO_0000115 xml:lang="cs">Interpupilární vzdálenost více než 2 SD. Alternativně, očividně zvětšená interpupilární vzdálenost či daleko od sebe posazené oči</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hypertelorizmus</rdfs:label>
