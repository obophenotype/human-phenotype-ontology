    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012203">
        <obo:IAO_0000115 xml:lang="cs">Plísňová infekce nehtů na nohou nebo rukou, která způsobuje jejich zesílení, změnu barvy, znetvoření a štěpení</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Onychomykóza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012203"/>
