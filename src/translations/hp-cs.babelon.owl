        <rdfs:label xml:lang="cs">Cervikální ectopia cordis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011583"/>
