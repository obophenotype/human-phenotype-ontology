        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011604">
        <obo:IAO_0000115 xml:lang="cs">Vrozená anomálie s abnormálním spojením mezi aortou a hlavní plicní tepnou, které vede k aortopulmonálnímu zkratu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Aortopulmonální okno</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011604"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vrozená anomálie s abnormálním spojením mezi aortou a hlavní plicní tepnou, které vede k aortopulmonálnímu zkratu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A congenital anomaly with an abnormal connection between the aorta and the main pulmonary artery resulting in an aortopulmonary shunt.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011604"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Aortopulmonální okno</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aortopulmonary window</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011605">
        <obo:IAO_0000115 xml:lang="cs">Vrozená transpozice velkých tepen s defektem komorového septa: otvor mezi dvěma dolními komorami (komůrkami) srdce. Defekt komorového septa je soustředěn kolem nejsvrchnější části komorové přepážky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vrozená transpozice velkých tepen s defektem komorového septa</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011605"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vrozená transpozice velkých tepen s defektem komorového septa: otvor mezi dvěma dolními komorami (komůrkami) srdce. Defekt komorového septa je soustředěn kolem nejsvrchnější části komorové přepážky.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A congenitally corrected transposition of the great arteries with a ventricular septal defect: a hole between the two bottom chambers (ventricles) of the heart. The ventricular septal defect is centered around the most superior aspect of the ventricular septum</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011605"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Vrozená transpozice velkých tepen s defektem komorového septa</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>obsolete Congenitally corrected transposition of the great arteries with ventricular septal defect</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011608">
        <obo:IAO_0000115 xml:lang="cs">Truncus arteriosus (jediná velká tepna opouštějící bazi srdce, která vede ke koronárním, plicním a systémovým tepnám), přičemž každá plicní tepna vzniká odděleně od sebe na zadní nebo laterální straně trunku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Truncus arteriosus typu II</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011608"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Truncus arteriosus (jediná velká tepna opouštějící bazi srdce, která vede ke koronárním, plicním a systémovým tepnám), přičemž každá plicní tepna vzniká odděleně od sebe na zadní nebo laterální straně trunku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Truncus arteriosus (single great artery leaving the base of the heart, giving rise to the coronary, pulmonary, and systemic arteries) with each pulmonary artery arising separate from each other on the posterior or lateral aspect of the truncus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011608"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Truncus arteriosus typu II</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Type II truncus arteriosus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011609">
        <obo:IAO_0000115 xml:lang="cs">Truncus arteriosus (jediná velká tepna opouštějící základ srdce, která vede ke koronární, plicní a systémové tepně), přičemž jedna ze dvou rozvětvených plicních tepen nevychází ze společného kmene plicnice, ale z ductus arteriosus nebo přímo z aorty</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Truncus arteriosus typu III</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011609"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Truncus arteriosus (jediná velká tepna opouštějící základ srdce, která vede ke koronární, plicní a systémové tepně), přičemž jedna ze dvou rozvětvených plicních tepen nevychází ze společného kmene plicnice, ale z ductus arteriosus nebo přímo z aorty</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Truncus arteriosus (single great artery leaving the base of the heart, giving rise to the coronary, pulmonary, and systemic arteries) whereby one of the two pulmonary artery branched does not arise from the common pulmonary trunk, but instead from the ductus arteriosus or directly from the aorta.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011609"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Truncus arteriosus typu III</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Type III truncus arteriosus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011610">
        <obo:IAO_0000115 xml:lang="cs">Truncus arteriosus (jediná velká tepna opouštějící základ srdce, která vede ke vzniku koronárních, plicních a systémových tepen), přičemž oblouk aorty je hypoplastický nebo přerušený a je přítomen velký otevřený ductus arteriosus</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Truncus arteriosus typu IV</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011610"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Truncus arteriosus (jediná velká tepna opouštějící základ srdce, která vede ke vzniku koronárních, plicních a systémových tepen), přičemž oblouk aorty je hypoplastický nebo přerušený a je přítomen velký otevřený ductus arteriosus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Truncus arteriosus (single great artery leaving the base of the heart, giving rise to the coronary, pulmonary, and systemic arteries) whereby the aortic arch is hypoplastic or interrupted, and a large patent ductus arteriosus is present.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011610"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Truncus arteriosus typu IV</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Type IV truncus arteriosus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011611">
        <obo:IAO_0000115 xml:lang="cs">Diskontinuita aortálního oblouku s atrézií či chybějícím segmentem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Přerušení aortálního oblouku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011611"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Diskontinuita aortálního oblouku s atrézií či chybějícím segmentem.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Non-continuity of the arch of aorta with an atretic point or absent segment.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
