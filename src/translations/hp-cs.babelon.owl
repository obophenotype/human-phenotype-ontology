        <babelon:source_value>Abnormal anterior fontanelle morphology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000237">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně malá velká (přední) fontanela vzhlede k věku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Malá přední fontanela</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
