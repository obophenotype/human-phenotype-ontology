    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009697">
        <obo:IAO_0000115 xml:lang="cs">Chronická ztráta kloubního pohybu v jednom nebo více distálních interfalangeálních kloubech prstů na ruce</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kontraktura distálního interfalangeálního kloubu prstů na ruce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009697"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Chronická ztráta kloubního pohybu v jednom nebo více distálních interfalangeálních kloubech prstů na ruce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic loss of joint motion in one or more distal interphalangeal joints of the fingers.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
