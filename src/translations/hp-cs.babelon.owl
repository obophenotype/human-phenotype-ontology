        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005170">
        <obo:IAO_0000115 xml:lang="cs">Typ srdeční blokády třetího stupně, při které únikový rytmus vzniká v relativně nízké části převodního systému (pod atrioventrikulárním uzlem), který produkuje široký QRS komplex</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kompletní blokáda s širokými QRS komplexy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005170"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ srdeční blokády třetího stupně, při které únikový rytmus vzniká v relativně nízké části převodního systému (pod atrioventrikulárním uzlem), který produkuje široký QRS komplex</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of third degree heart block in which the escape rhythm arises at a relatively low part of the conduction system (below the atrioventricular node), which produces a wide QRS complex.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005170"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kompletní blokáda s širokými QRS komplexy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complete heart block with broad QRS complexes</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005172">
        <obo:IAO_0000115 xml:lang="cs">Kondukční blok v zadní větvi levého Tawarova ramínka.</obo:IAO_0000115>
