    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000280">
        <obo:IAO_0000115 xml:lang="cs">Absence jasně a ostře definovaného vzhledu obočí, nosu, rtů, úst, brady, obvykle pro zaoblené a masivní rysy, či ztluštelou kůži s či bez ztluštění podkožních a kostních tkání. V extrémním případě gargoylismus.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hrubé rysy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
