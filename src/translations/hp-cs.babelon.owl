    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002576">
        <obo:IAO_0000115 xml:lang="cs">Anomálie střeva, při níž část střeva invaginuje (teleskopuje) do jiné části střeva.</obo:IAO_0000115>
