        <owl:annotatedTarget xml:lang="cs">Abnormální morfologie sacculu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal vestibular saccule morphology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031000">
        <obo:IAO_0000115 xml:lang="cs">Ztráta či degenerace tkáně sacculu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vestibulární sakulární degenerace</rdfs:label>
    </rdf:Description>
