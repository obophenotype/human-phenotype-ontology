        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001008">
        <rdfs:label xml:lang="cs">Akumulace melanosomů v melanocytech</rdfs:label>
