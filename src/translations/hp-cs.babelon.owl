        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000320"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Ptačí obličej</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bird-like facies</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000321">
        <obo:IAO_0000115 xml:lang="cs">Kontury obličeje vytvářející dojem čtvercového obličeje. Způsobeno širší vrchní etáží obličeje/širší lebkou a širší dolní etáží obličeje/mandibulou</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Čtvercový obličej</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000321"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kontury obličeje vytvářející dojem čtvercového obličeje. Způsobeno širší vrchní etáží obličeje/širší lebkou a širší dolní etáží obličeje/mandibulou</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Facial contours, as viewed from the front, show a broad upper face/cranium and lower face/mandible, creating a square appearance.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000321"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Čtvercový obličej</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Square face</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000322">
        <obo:IAO_0000115 xml:lang="cs">Zkrácená vzdálenost mezi bazí nosu a horní hranicí retní červeně, menší než -2 SD. Alternativně, očividně kratší vzdálenost mezi bazí nosu a horním rtem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Krátké filtrum</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000322"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zkrácená vzdálenost mezi bazí nosu a horní hranicí retní červeně, menší než -2 SD. Alternativně, očividně kratší vzdálenost mezi bazí nosu a horním rtem.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Distance between nasal base and midline upper lip vermilion border more than 2 SD below the mean. Alternatively, an apparently decreased distance between nasal base and midline upper lip vermilion border.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
