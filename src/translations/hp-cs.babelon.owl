        <obo:IAO_0000115 xml:lang="cs">Přítomnost megakaryocytů v kostní dřeni, jejichž jádra jsou méně laločnatá, než se vzhledem k velikosti jádra očekává</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hypolobulace jádra megakaryocytů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
