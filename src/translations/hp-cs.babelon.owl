    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100033">
        <obo:IAO_0000115 xml:lang="cs">Opakované, definované, intermitentní, mimovolné pohyby či části pohybů, které pacient může na krátkou chvíli vůlí potlačit, obvykle jsou asociované s touhou provést daný pohyb</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Tiky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100033"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Opakované, definované, intermitentní, mimovolné pohyby či části pohybů, které pacient může na krátkou chvíli vůlí potlačit, obvykle jsou asociované s touhou provést daný pohyb</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Repeated, individually recognizable, intermittent movements or movement fragments that are almost always briefly suppressible and are usually associated with awareness of an urge to perform the movement.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
