        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011690">
        <obo:IAO_0000115 xml:lang="cs">Nepřetržitá ortodromní tachykardie s anterográdním vedením přes atrioventrikulární uzel a retrográdním vedením přes akcesorní dráhu obvykle lokalizovanou v posteroseptální oblasti s pomalým a dekrementálním vedením.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Permanentní junkční reciproční tachykardie</rdfs:label>
    </rdf:Description>
