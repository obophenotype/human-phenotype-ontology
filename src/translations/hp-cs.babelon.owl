    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030376">
        <obo:IAO_0000115 xml:lang="cs">Odchylka od normálního podílu nezralých B buněk (CD19+/CD21low) v cirkulaci vzhledem k celkovému počtu B buněk. Nezralé B buňky (IgM+) jsou v kostní dřeni stále v závěrečné fázi vývoje. Naivní B buňky jsou ty, které opustily kostní dřeň ještě předtím, než se naváží na antigen, pro který jsou specifické (IgM+/IgD+).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální podíl nezralých B buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030376"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Odchylka od normálního podílu nezralých B buněk (CD19+/CD21low) v cirkulaci vzhledem k celkovému počtu B buněk. Nezralé B buňky (IgM+) jsou v kostní dřeni stále v závěrečné fázi vývoje. Naivní B buňky jsou ty, které opustily kostní dřeň ještě předtím, než se naváží na antigen, pro který jsou specifické (IgM+/IgD+).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deviation from normal proportion of immature B cells (CD19+/ CD21low) in circulation relative to total number of B cells. Immature B cells (IgM+) are still in final stages of development within the bone marrow. Naive B cells are those which have left the bone marrow, before they bind to the antigen for which they&apos;re specific (IgM+/IgD+).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
