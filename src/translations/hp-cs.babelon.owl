        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007917">
        <obo:IAO_0000115 xml:lang="cs">Typ odchlípení sítnice vznikající v důsledku kombinace kontrahujících se retinálních membrán, abnormálních vitreoretinálních adhezí a změn sklivce. Obvykle se vyskytuje v souvislosti s onemocněními, která vyvolávají fibrovaskulární odpověď, např. diabetes.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Trakční odchlípení sítnice</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007917"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ odchlípení sítnice vznikající v důsledku kombinace kontrahujících se retinálních membrán, abnormálních vitreoretinálních adhezí a změn sklivce. Obvykle se vyskytuje v souvislosti s onemocněními, která vyvolávají fibrovaskulární odpověď, např. diabetes.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of retinal detachment arising due to a combination of contracting retinal membranes, abnormal vitreoretinal adhesions, and vitreous changes, in the absence of a full-thickness retinal defect.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
