        <owl:annotatedTarget xml:lang="cs">Stav spojený se zvýšenou sérovou koncentrací hormonu stimulujícího štítnou žlázu (TSH), ale s normální hodnotou volného tyroxinu (FT4).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
