    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003829">
        <obo:IAO_0000115 xml:lang="cs">Popis stavů, kdy ne všichni jedinci s daným genotypem vykazují dané onemocnění. Penetrance je podíl osob, u nichž se onemocnění vyvine při délce života 80 let.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Typická neúplná penetrance</rdfs:label>
    </rdf:Description>
