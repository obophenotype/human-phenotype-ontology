    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001685">
        <obo:IAO_0000115 xml:lang="cs">Myokardiální fibróza je charakterizována dysregulovaným obratem kolagenu (zvýšená syntéza převažuje nad nezměněnou nebo sníženou degradací) a nadměrným nahromaděním kolagenu v interstitiálních a perivaskulárních prostorech, jakož i fenotypově transformovaných vláken zvaných myofibroblasty</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Myokardiální fibróza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001685"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Myokardiální fibróza je charakterizována dysregulovaným obratem kolagenu (zvýšená syntéza převažuje nad nezměněnou nebo sníženou degradací) a nadměrným nahromaděním kolagenu v interstitiálních a perivaskulárních prostorech, jakož i fenotypově transformovaných vláken zvaných myofibroblasty</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Myocardial fibrosis is characterized by dysregulated collagen turnover (increased synthesis predominates over unchanged or decreased degradation) and excessive diffuse collagen accumulation in the interstitial and perivascular spaces as well as by phenotypically transformed fibroblasts, termed myofibroblasts.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
