        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Převážně lokalizavané v malých kloubech</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Predominant small joint localization</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032545">
        <obo:IAO_0000115 xml:lang="cs">Mimovolní stažení břišního svalstva, které vzniká jako reakce na dotek na břiše, aby se zabránilo bolesti. Ztuhlost se může objevit v přítomnosti zánětu břicha a obvykle se týká pouze zanícené oblasti.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abdominální rigidita</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032545"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Mimovolní stažení břišního svalstva, které vzniká jako reakce na dotek na břiše, aby se zabránilo bolesti. Ztuhlost se může objevit v přítomnosti zánětu břicha a obvykle se týká pouze zanícené oblasti.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Involuntary tightening of the abdominal musculature that occurs in response to touching the abdomen to avoid pain. Rigidity can occur in the presence of abdominal inflammation and usually involves only the inflamed area.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032545"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abdominální rigidita</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abdominal rigidity</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032546">
        <obo:IAO_0000115 xml:lang="cs">Volní kontrakce svalstva břišní stěny, aby se zabránilo bolesti.</obo:IAO_0000115>
