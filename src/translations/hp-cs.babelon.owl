        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Snížený merosin v svalovém vláknu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced muscle fiber merosin</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030093">
        <obo:IAO_0000115 xml:lang="cs">Odchylka od normálu množství lamininu beta 1 ve tkáni svalového vlákna. Laminin 2 je hlavní složkou bazální laminy buněk kosterního svalstva. Jedná se o heterotrimer složený ze 3 řetězců: merosinu (lamininový alfa 2 řetězec), beta 1 a gama 1</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální laminin beta 1 ve svalovém vlákně</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030093"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Odchylka od normálu množství lamininu beta 1 ve tkáni svalového vlákna. Laminin 2 je hlavní složkou bazální laminy buněk kosterního svalstva. Jedná se o heterotrimer složený ze 3 řetězců: merosinu (lamininový alfa 2 řetězec), beta 1 a gama 1</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deviation from normal of the amount of laminin beta 1 in muscle fiber tissue. Laminin 2 is a major component of the basal lamina of skeletal muscle cells. It is a heterotrimer composed of 3 chains: merosin (laminin alpha 2 chain), beta 1, and gamma 1.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
