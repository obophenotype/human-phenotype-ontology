    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033806">
        <obo:IAO_0000115 xml:lang="cs">Abnormální struktura stratum granulosum, což je tenká vrstva buněk v epidermis ležící nad stratum spinosum a pod stratum corneum.</obo:IAO_0000115>
