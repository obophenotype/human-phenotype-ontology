        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Trikuspidální regurgitace</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tricuspid regurgitation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005181">
        <obo:IAO_0000115 xml:lang="cs">Zmenšení průměru koronárních tepen v důsledku nahromadění ateromatózních plátů ve stěnách koronárních tepen před 45. rokem věku.</obo:IAO_0000115>
