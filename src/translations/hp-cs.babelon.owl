        <owl:annotatedTarget xml:lang="cs">Strukturální anomálie kapilárního systému krvního řečiště v ledviných glomerulech.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A structural anomaly of the capillary blood vessels in the renal glomerulus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
