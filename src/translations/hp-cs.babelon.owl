    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032515">
        <obo:IAO_0000115 xml:lang="cs">Typ invazivní dermatofytové infekce hluboké dermis charakterizované rozsáhlou infiltrací kůže houbovými elementy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hluboká dermatofytóza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032515"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ invazivní dermatofytové infekce hluboké dermis charakterizované rozsáhlou infiltrací kůže houbovými elementy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of invasive dermatophyte infection of the deep dermis characterized by extensive dermal infiltration by fungal elements.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
