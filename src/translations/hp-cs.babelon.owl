    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010498">
        <obo:IAO_0000115 xml:lang="cs">Vývojová vada, ke které dochází v případě, když k sobě nesrostou dvě části patelly v dětství.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Patella bipartita</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010498"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vývojová vada, ke které dochází v případě, když k sobě nesrostou dvě části patelly v dětství.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A developmental defect that occurs if the two halves of the patella fail to fuse in early childhood.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
