        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená osmotická rezistence erytrocytů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased red cell osmotic resistance</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005547">
        <obo:IAO_0000115 xml:lang="cs">Proliferace (nadměrná produkce) hematopoeticky aktivní tkáně nebo tkáně, která má embryonální hematopoetický potenciál</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Myeloproliferativní porucha</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005547"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Proliferace (nadměrná produkce) hematopoeticky aktivní tkáně nebo tkáně, která má embryonální hematopoetický potenciál</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Proliferation (excess production) of hemopoietically active tissue or of tissue which has embryonic hemopoietic potential.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005547"/>
