        <babelon:source_value>Abnormal B cell morphology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002847">
        <obo:IAO_0000115 xml:lang="cs">Narušená produkce paměťových buněk, tzn. B buněk přetrvávajících roky či celý život a které umožňují rychlou a zesílenou odpověď na sekundární výzvy</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Narušená tvorba paměťových B buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002847"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Narušená produkce paměťových buněk, tzn. B buněk přetrvávajících roky či celý život a které umožňují rychlou a zesílenou odpověď na sekundární výzvy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired production of memory cells, the B cells that persist for years or an entire lifetime and which confer rapid and enhanced response to secondary challenge.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002847"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Narušená tvorba paměťových B buněk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired memory B cell generation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002848">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost normálních celkových hladin imunoglobulinů s deficiencí specifických imunoglobulinů proti bakteriálním polysacharidům</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená hladina specifických antipolysacharidových protilátek</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002848"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost normálních celkových hladin imunoglobulinů s deficiencí specifických imunoglobulinů proti bakteriálním polysacharidům</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of normal overall immunoglobulin levels with deficiency of specific immunoglobulins directed against bacterial polysaccharides.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002848"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Snížená hladina specifických antipolysacharidových protilátek</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased specific anti-polysaccharide antibody concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002849">
        <obo:IAO_0000115 xml:lang="cs">Absence zárodečných center v lymfatických uzlinách. Germinální centra jsou části lymfatických uzlin, ve kterých se B lymfocyty proliferují, diferencují, mutují prostřednictvím somatické hypermutace a přepínají třídy během protilátkových odpovědí.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Absence zárodečného centra lymfatické uzliny</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002849"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Absence zárodečných center v lymfatických uzlinách. Germinální centra jsou části lymfatických uzlin, ve kterých se B lymfocyty proliferují, diferencují, mutují prostřednictvím somatické hypermutace a přepínají třídy během protilátkových odpovědí.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of germinal centers in lymph nodes. Germinal centers are the parts of lymph nodes in which B lymphocytes proliferate, differentiate, mutate through somatic hypermutation and class switch during antibody responses.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002849"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Absence zárodečného centra lymfatické uzliny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of lymph node germinal center</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002850">
        <obo:IAO_0000115 xml:lang="cs">Neobvykle snížení hladina imunoglobulinů M (IgM) v krvi</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená hladina celkového cirkulujícího IgM</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002850"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neobvykle snížení hladina imunoglobulinů M (IgM) v krvi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormally decreased level of immunoglobulin M (IgM) in blood.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002850"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Snížená hladina celkového cirkulujícího IgM</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased circulating IgM concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002851">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně zvýšený podíl CD4 negativních, CD8 negativních (double negativních nebo DN) alfa-beta regulačních T buněk (Treg) v porovnání s celkovým počtem T buněk.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšený podíl CD4 negativních, CD8 negativních, alfa-beta regulačních T buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002851"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně zvýšený podíl CD4 negativních, CD8 negativních (double negativních nebo DN) alfa-beta regulačních T buněk (Treg) v porovnání s celkovým počtem T buněk.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal increase of double negative (DN) CD3+CD4-CD8- T cells, measured as percentage of total CD3+ T cells in the blood, compared to a reference range for a given sex and age-group. These are usually measured within the TCR alpha/beta positive population.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002851"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšený podíl CD4 negativních, CD8 negativních, alfa-beta regulačních T buněk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased double-negative T cell number</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002853">
        <obo:IAO_0000115 xml:lang="cs">Zvýšený podíl T-buněk exprimujících lidský leukocytární antigen (HLA)-DR. HLA-DR je povrchový buněčný receptor MHC II. třídy, který prezentuje antigeny (peptidy o délce nejméně 9 aminokyselin), a představuje tak ligand pro T-buněčný receptor. HLA-DR může být regulován v reakci na imunitní stimulaci.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšený podíl HLA-DR+ T buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002853"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšený podíl T-buněk exprimujících lidský leukocytární antigen (HLA)-DR. HLA-DR je povrchový buněčný receptor MHC II. třídy, který prezentuje antigeny (peptidy o délce nejméně 9 aminokyselin), a představuje tak ligand pro T-buněčný receptor. HLA-DR může být regulován v reakci na imunitní stimulaci.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal increase of the activated HLA-DR+ CD4+ T cell subpopulation, measured as percentage of total CD4+ T cells in the blood, compared to a reference range for a given sex and age-group.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002853"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšený podíl HLA-DR+ T buněk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased HLA-DR+ CD4+ T cell proportion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002857">
        <obo:IAO_0000115 xml:lang="cs">Nohy jsou vbočené směrem dovnitř, takže kolena jsou blíže k sobě a kotníky od sebe</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Genu valgum</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002857"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nohy jsou vbočené směrem dovnitř, takže kolena jsou blíže k sobě a kotníky od sebe</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The legs angle inward, such that the knees are close together and the ankles far apart.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002857"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Genu valgum</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Genu valgum</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002858">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost meningeomu, tj. nezhoubného nádoru pocházejícího z tvrdé pleny mozkové nebo arachnoidey</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Meningiom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002858"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost meningeomu, tj. nezhoubného nádoru pocházejícího z tvrdé pleny mozkové nebo arachnoidey</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of a meningioma, i.e., a benign tumor originating from the dura mater or arachnoid mater.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002858"/>
