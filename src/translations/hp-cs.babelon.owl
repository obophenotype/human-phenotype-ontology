        <obo:IAO_0000115 xml:lang="cs">Snížení maximálního výdechového průtoku za minutu, které lze použít k měření rychlosti výdechu subjektu, jakož i k posouzení síly výdechových svalů a stavu velkých dýchacích cest</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížený vrcholový výdechový průtok (PEF)</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032355"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížení maximálního výdechového průtoku za minutu, které lze použít k měření rychlosti výdechu subjektu, jakož i k posouzení síly výdechových svalů a stavu velkých dýchacích cest</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduction in the maximum expiratory flow per minute, which can be used to measure how fast a subject can exhale as well as to judge the strength of the expiratory muscles and the condition of the large airways.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
