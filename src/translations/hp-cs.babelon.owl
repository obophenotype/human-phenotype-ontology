    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012588">
        <obo:IAO_0000115 xml:lang="cs">Forma nefrotického syndromu, která nereaguje na léčbu steroidy, definovaná jako přetrvávající proteinurie navzdory 60mg/m2 nebo 2mg/kg po dobu 8 týdnů, po vyloučení infekce nebo nedodržování léčby</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Steroid-rezistentní nefrotický syndrom</rdfs:label>
    </rdf:Description>
