    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010021">
        <obo:IAO_0000115 xml:lang="cs">Epifýzy 1. metakarpální kosti jsou tvrdé a hutné jako slonovina. Taková epifýza má uniformně denzní vzhled na rentgenovém snímku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Slonovinová epifýza 1. metakarpální kosti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010021"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Epifýzy 1. metakarpální kosti jsou tvrdé a hutné jako slonovina. Taková epifýza má uniformně denzní vzhled na rentgenovém snímku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The epiphysis of the 1st metacarpal appears hard and dense like ivory. An ivory epiphysis has a uniformly dense appearance on radiographs.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010021"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Slonovinová epifýza 1. metakarpální kosti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ivory epiphysis of the 1st metacarpal</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010022">
        <obo:IAO_0000115 xml:lang="cs">Epifýza první metakarpální kosti je umístněná na jejim proximálním konci, zatímco akcesorní epifýza může být umístnění na distálním konci metakarpální kosti</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pseudoepifýza 1. metakarpální kosti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010022"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Epifýza první metakarpální kosti je umístněná na jejim proximálním konci, zatímco akcesorní epifýza může být umístnění na distálním konci metakarpální kosti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The epiphysis of the first metacarpal is localized at the proximal end of the metacarpal bone although an accessory epiphysis may be located at the distal end of the metacarpal.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
