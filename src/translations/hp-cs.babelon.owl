    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002427">
        <obo:IAO_0000115 xml:lang="cs">Porucha řečové exprese s relativním zachováním receptivních jazykových schopností. To znamená, že pacient rozumí jazyku (řeči, písmu), ale nedokáže se vyjadřovat.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Expresivní afázie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002427"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Porucha řečové exprese s relativním zachováním receptivních jazykových schopností. To znamená, že pacient rozumí jazyku (řeči, písmu), ale nedokáže se vyjadřovat.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impairment of expressive language and relative preservation of receptive language abilities. That is, the patient understands language (speech, writing) but cannot express it.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
