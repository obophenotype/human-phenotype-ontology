        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ivory epiphyses of the proximal phalanges of the hand</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010275">
        <obo:IAO_0000115 xml:lang="cs">Druhotné osifikační centrum proximálních falangů na ruce, které je odlišné od běžné epifýzy a které nepřispívá k longitudinálnímu růstu dlouhé kosti</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pseudoepifýzy proximálních falangů na ruce</rdfs:label>
    </rdf:Description>
