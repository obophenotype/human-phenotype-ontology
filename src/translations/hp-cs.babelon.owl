    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030048">
        <obo:IAO_0000115 xml:lang="cs">Kolpocefalie je anatomický nález v mozku projevující se neúměrně zvětšenými okcipitálními rohy ve srovnání s ostatními částmi postranních komor.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Colpocefalie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030048"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kolpocefalie je anatomický nález v mozku projevující se neúměrně zvětšenými okcipitálními rohy ve srovnání s ostatními částmi postranních komor.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Colpocephaly is an anatomic finding in the brain manifested by occipital horns that are disproportionately enlarged in comparison with other parts of the lateral ventricles.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
