    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034273">
        <obo:IAO_0000115 xml:lang="cs">Povislé tváře více, než by se dalo očekávat na daný věk. Může k tomu vést nadbytek kůže a/anebo ztráta elastický částí či akumulace tuku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Předčasně povislé tváře</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034273"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Povislé tváře více, než by se dalo očekávat na daný věk. Může k tomu vést nadbytek kůže a/anebo ztráta elastický částí či akumulace tuku.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Drooping or sinking of tissues of the cheeks more than would be expected at a given age. Sagging can occur due to a relative excess of skin and/or lack of elastic recoil as well as fat accumulation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
