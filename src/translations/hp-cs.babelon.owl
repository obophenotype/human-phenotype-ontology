    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030986">
        <obo:IAO_0000115 xml:lang="cs">Hyperplázie výstelkového epitelu septa a velkých žlučovodů projevující se jako mikropapilární výběžky nebo jako rozvrstvení epitelu s dilatací lumen žlučovodu nebo bez ní.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hyperplázie žlučového epitelu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030986"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Hyperplázie výstelkového epitelu septa a velkých žlučovodů projevující se jako mikropapilární výběžky nebo jako rozvrstvení epitelu s dilatací lumen žlučovodu nebo bez ní.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hyperplasia of lining epithelia of the septal and large bile ducts manifesting as micropapillary projections or as a stratification of the epithelium with or without dilatation of the duct lumen.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
