        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032008">
        <obo:IAO_0000115 xml:lang="cs">Uvolnění tukových útvarů do žilního oběhu, čímž se zablokuje krevní oběh do plic.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Plicní tuková embolie</rdfs:label>
    </rdf:Description>
