    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100580">
        <obo:IAO_0000115 xml:lang="cs">Abnormální změna (metaplazie) v buňkách dolní části jícnu. Normální dlaždicový epitel vystýlající jícen je nahrazen metaplastickým sloupcovitým epitelem. Sloupcovitý epitel označuje typ buněk, který se obvykle nachází v distálnějších částech gastrointestinálního systému</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Barrettův jícen</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100580"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální změna (metaplazie) v buňkách dolní části jícnu. Normální dlaždicový epitel vystýlající jícen je nahrazen metaplastickým sloupcovitým epitelem. Sloupcovitý epitel označuje typ buněk, který se obvykle nachází v distálnějších částech gastrointestinálního systému</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal change (metaplasia) in the cells of the inferior portion of the esophagus. The normal squamous epithelium lining of the esophagus is replaced by metaplastic columnar epithelium. Columnar epithelium refers to a cell type that is typically found in more distal parts of the gastrointestinal system.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100580"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Barrettův jícen</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Barrett esophagus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100581">
