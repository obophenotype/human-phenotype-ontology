        <owl:annotatedTarget xml:lang="cs">Malý vzurůst se zkráceným trupem s nástupem v kojeneckém věku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Infancy onset short-trunk short stature</babelon:source_value>
