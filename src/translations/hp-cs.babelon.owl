        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tracheal tug on inspiration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025009">
        <obo:IAO_0000115 xml:lang="cs">Horní řezáky jsou odkloněny od normálního úhlu, tj. přibližně paralelní stav vzhledem k povrchu obličeje, a místo toho jsou skloněny více směrem zevně a nahoru.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dopředu směrující horní řezáky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025009"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Horní řezáky jsou odkloněny od normálního úhlu, tj. přibližně paralelní stav vzhledem k povrchu obličeje, a místo toho jsou skloněny více směrem zevně a nahoru.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The upper incisors deviate from the normal angle of being roughly parallel to the surface of the face and instead slant outwards.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025009"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Dopředu směrující horní řezáky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Forward slanting upper incisors</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025010">
        <obo:IAO_0000115 xml:lang="cs">Částečná nebo úplná ztráta foveální tkáně, která byla kdysi přítomna.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Atrofie fovea centralis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025010"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Částečná nebo úplná ztráta foveální tkáně, která byla kdysi přítomna.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A nonspecific term denoting wasting, especially as a result of degeneration, of the retinal pigment epithelium (RPE) and neurosensory retinal cells in the fovea.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025010"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Atrofie fovea centralis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Foveal atrophy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025011">
        <obo:IAO_0000115 xml:lang="cs">Zúžení apertura piriformis, tj. hruškovitého otvoru kostí lebky který tvoří vchod do nosních dutin.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Stenóza apertury piriformis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025011"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zúžení apertura piriformis, tj. hruškovitého otvoru kostí lebky který tvoří vchod do nosních dutin.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Narrowing of the anterior nasal aperture (piriform or pyriform aperture), which is a pear-shaped opening in the skull that forms the bony inlet of the nose.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025011"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Stenóza apertury piriformis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pyriform aperture stenosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025012">
        <obo:IAO_0000115 xml:lang="cs">Difuzně rozšířené perivaskulární prostory v bazálních gangliích, postihující zejména corpus striatum. Status cribrosum je obvykle symetrický, s perivaskulárními prostory vykazujícími CSF signál a bez omezení difuze. Slovo cribriform znamená sítovitý, s více perforacemi.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Status cribrosum</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025012"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Difuzně rozšířené perivaskulární prostory v bazálních gangliích, postihující zejména corpus striatum. Status cribrosum je obvykle symetrický, s perivaskulárními prostory vykazujícími CSF signál a bez omezení difuze. Slovo cribriform znamená sítovitý, s více perforacemi.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Diffusely widened perivascular spaces in the basal ganglia, affecting especially the corpus striatum. Status cribrosum is usually symmetrical, with the perivascular spaces showing CSF signal and without diffusion restriction. The word cribriform means sievelike, with multiple perforations.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025012"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Status cribrosum</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Status cribrosum</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025013">
        <obo:IAO_0000115 xml:lang="cs">Typ rigidity, který se projevuje přehnaným držením extenzorů všech končetin</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Decerebrační rigidita</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
