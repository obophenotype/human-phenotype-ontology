    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032570">
        <obo:IAO_0000115 xml:lang="cs">Lakuny jsou infarkty o průměru menším než 15 mm v kortikální bílé hmotě nebo v corona radiata,capsula interna, centrum semiovale, thalamu, bazálních gangliích nebo pontu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pontinní ischemické lakuny</rdfs:label>
    </rdf:Description>
