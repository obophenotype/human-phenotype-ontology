    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025521">
        <obo:IAO_0000115 xml:lang="cs">Procentuální podíl tuku na celkové tělesné hmotnosti nad normou, obvykle definovaný jako 32 % u žen a 25 % u mužů.</obo:IAO_0000115>
