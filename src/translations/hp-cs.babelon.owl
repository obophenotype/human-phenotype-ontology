        <owl:annotatedTarget xml:lang="cs">Abnormální snížení alveolární ventilace během spánku. Je charakterizováno vzestupem arteriálního oxidu uhličitého.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal reduction in alveolar ventilation occurring during sleep. This is characterized by a rise in arterial carbon dioxide.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
