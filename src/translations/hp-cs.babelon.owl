    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033584">
        <obo:IAO_0000115 xml:lang="cs">Jednotný (všechny léze jsou ve stejném vývojovém stadiu) obraz difuzního zánětlivého intersticiálního procesu, většinou symetrický v celé plíci, zahrnující především alveolární septa.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nespecifická intersticiální pneumonie</rdfs:label>
    </rdf:Description>
