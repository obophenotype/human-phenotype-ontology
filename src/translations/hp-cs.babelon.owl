    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0008138">
        <obo:IAO_0000115 xml:lang="cs">Abnormální plantární flexe kalkanea vzhledem k podélné ose tibie. Výsledkem je, že úhel mezi dlouhou osou tibie a dlouhou osou patní kosti (calcaneus) je větší než 90 stupňů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Equinus calcaneus</rdfs:label>
