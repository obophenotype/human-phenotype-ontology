    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001722">
        <obo:IAO_0000115 xml:lang="cs">Forma srdečního selhání charakterizovaná zvýšeným srdečním výdejem. Může být pozorována u pacientů se srdečním selháním a hypertyreózou, anémií, těhotenstvím, arteriovenózní píštělí a podobně</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Městnavé srdeční selhání</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001722"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Forma srdečního selhání charakterizovaná zvýšeným srdečním výdejem. Může být pozorována u pacientů se srdečním selháním a hypertyreózou, anémií, těhotenstvím, arteriovenózní píštělí a podobně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of heart failure characterized by elevated cardiac output. This may be seen in patients with heart failure and hyperthyroidism, anemia, pregnancy, arteriovenous fistulae, and others.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
