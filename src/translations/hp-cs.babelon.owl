        <babelon:source_value>Glomerular deposits</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030950">
        <obo:IAO_0000115 xml:lang="cs">Abnormální zvýšení tlaku v plicních žilách, obvykle v důsledku hypertenze levé síně</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Plicní venózní hypertenze</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030950"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální zvýšení tlaku v plicních žilách, obvykle v důsledku hypertenze levé síně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal increase in pressure in the pulmonary veins, usually as a result of left atrial hypertension.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
