    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006834">
        <obo:IAO_0000115 xml:lang="cs">Stagnace vývoje dítěte v oblastech motorických dovedností, řeči a jazyka, kognitivních schopností a sociální a/nebo emoční schopnosti, manifestovaná po nástupu epilepsie</obo:IAO_0000115>
