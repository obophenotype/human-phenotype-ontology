        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031358">
        <obo:IAO_0000115 xml:lang="cs">Absence bdělosti a vědomí, ale (na rozdíl od kómatu) se svévolným otevřením očí a pohyby (jako je skřípání zubů, zívání nebo mlácení končetinami)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vegetativní stav</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031358"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Absence bdělosti a vědomí, ale (na rozdíl od kómatu) se svévolným otevřením očí a pohyby (jako je skřípání zubů, zívání nebo mlácení končetinami)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The absence of wakefulness and consciousness, but in contrast to a coma, there is involuntary opening of the eyes and movements such as teeth grinding, yawning, or thrashing of the extremities.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
