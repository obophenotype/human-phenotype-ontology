    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004468">
        <obo:IAO_0000115 xml:lang="cs">Anomálie prstenců hyalinní chrupavky ve tvaru písmene C, kterých je obvykle 16 až 20 a které zaujímají přední dvě třetiny obvodu průdušnice (zadní část prstence je doplněna vláknitou a hladkou svalovou tkání)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Anomálie tracheálních chrupavek</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
