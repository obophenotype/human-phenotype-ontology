        <babelon:source_value>Secondary esotropia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031724">
        <obo:IAO_0000115 xml:lang="cs">Heterotropie s malým úhlem (obvykle 10 dioptrií nebo méně), při níž se vyskytuje forma binokulárního jednoduchého vidění.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mikrotropie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031724"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Heterotropie s malým úhlem (obvykle 10 dioptrií nebo méně), při níž se vyskytuje forma binokulárního jednoduchého vidění.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A small angle heterotropia (usually of 10 diopters or less) in which a form of binocular single vision occurs.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031724"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mikrotropie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Microtropia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031725">
        <obo:IAO_0000115 xml:lang="cs">Forma latentního strabismu (heteroforie), při které se při disociaci okludované oko odchyluje směrem dolů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hypoforie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031725"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Forma latentního strabismu (heteroforie), při které se při disociaci okludované oko odchyluje směrem dolů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of latent strabismus (heterophoria) in which, on dissociation, the occluded eye deviates downwards.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031725"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hypoforie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypophoria</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031726">
        <obo:IAO_0000115 xml:lang="cs">Typ cyklotropie (torze jednoho nebo obou očí kolem zrakové osy), kdy jsou horní póly očních koulí vůči sobě natočeny dovnitř (mediálně).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Incyklotropie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031726"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ cyklotropie (torze jednoho nebo obou očí kolem zrakové osy), kdy jsou horní póly očních koulí vůči sobě natočeny dovnitř (mediálně).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of cyclotropia (torsion of one or both eye around the visual axis of the eyes) in which the upper poles of the globes are rotated inward (medially) to each other.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031726"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Incyklotropie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Incyclotropia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031727">
        <obo:IAO_0000115 xml:lang="cs">Typ cyklotropie (torze jednoho nebo obou očí kolem zrakové osy očí), při kterém jsou horní póly očních koulí natočeny vzájemně směrem ven (do stran).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Excyklotropie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031727"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ cyklotropie (torze jednoho nebo obou očí kolem zrakové osy očí), při kterém jsou horní póly očních koulí natočeny vzájemně směrem ven (do stran).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of cyclotropia (torsion of one or both eye around the visual axis of the eyes) in which the upper poles of the globes are rotated outward (laterally) to each other.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031727"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Excyklotropie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Excyclotropia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031728">
        <obo:IAO_0000115 xml:lang="cs">Forma hypermetropie s maximálně +2,00 dioptriemi.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mírná hypermetropie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031728"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Forma hypermetropie s maximálně +2,00 dioptriemi.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of hypermetropia with not more than +2.00 diopters.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031728"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mírná hypermetropie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mild hypermetropia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031729">
        <obo:IAO_0000115 xml:lang="cs">Forma hypermetropie v rozmezí od +2,00 dioptrií do +5,00 dioptrií.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Středně závažná hypermetropie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031729"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Forma hypermetropie v rozmezí od +2,00 dioptrií do +5,00 dioptrií.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of hypermetropia with more than +2.00 diopters but not more than +5.00 diopters.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031729"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Středně závažná hypermetropie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Moderate hypermetropia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031730">
        <obo:IAO_0000115 xml:lang="cs">Forma krátkozrakosti spojená s abnormální osovou délkou, která je příliš velká vzhledem k lomivosti celého optického systému oka.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Axiální myopie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031730"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Forma krátkozrakosti spojená s abnormální osovou délkou, která je příliš velká vzhledem k lomivosti celého optického systému oka.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of myopia related to an axial length above the norm and too long for the refractive power of the whole optical system of the eye.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031730"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Axiální myopie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Axial myopia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031731">
        <obo:IAO_0000115 xml:lang="cs">Zvýšené slzení v důsledku nadprodukce slz.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená produkce slz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031731"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšené slzení v důsledku nadprodukce slz.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased lacrimation owing to overproduction of tears.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031731"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená produkce slz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased tear production</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031732">
        <obo:IAO_0000115 xml:lang="cs">Typ slzícího oka při nadprodukci slz z důvodu nadměrné aktivity parasympatiku v sekretorní části slzotvorného systému - v slzní žláze. Toto může být způsobeno medikamentózně (e.g. pilokarpin) nebo poruchou autonomního nervového systému.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená bazální produkce slz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031732"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ slzícího oka při nadprodukci slz z důvodu nadměrné aktivity parasympatiku v sekretorní části slzotvorného systému - v slzní žláze. Toto může být způsobeno medikamentózně (e.g. pilokarpin) nebo poruchou autonomního nervového systému.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of watery eye associated with overproduction of tears due to an increased parasympathetic drive to the secretory component of the lacrimal system (lacrimal gland); this could be due to pro-secretory drug use (e.g. pilocarpine) or autonomic disturbance.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031732"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená bazální produkce slz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased basal tear production</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031733">
        <obo:IAO_0000115 xml:lang="cs">Forma slzení oka spojená s nadprodukcí slz v důsledku reflexního slzení jako reakce na místní dráždidlo (např. trichiáza nebo cizí těleso), chronické onemocnění povrchu oka (např. blefaritída) nebo systémové onemocnění (např. oční onemocnění štítné žlázy).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Reflexní slzení</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031733"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Forma slzení oka spojená s nadprodukcí slz v důsledku reflexního slzení jako reakce na místní dráždidlo (např. trichiáza nebo cizí těleso), chronické onemocnění povrchu oka (např. blefaritída) nebo systémové onemocnění (např. oční onemocnění štítné žlázy).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of watery eye associated with overproduction of tears due to reflex tearing in response to a local irritant (e.g. trichiasis or foreign body), chronic ocular surface disease (e.g. blepharitis) or systemic disease (e.g. thyroid eye disease).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031733"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Reflexní slzení</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reflex tearing</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031734">
        <obo:IAO_0000115 xml:lang="cs">Forma slzení očí spojená s abnormálním tonusem a/nebo polohou víček. První z nich je způsobeno ochabnutím víček (běžná involuční změna u starších osob) nebo slabým musculus orbicularis (např. v důsledku obrny VII. hlavového nervu). Druhý případ je obvykle spojen s ektropiem, které způsobuje everzi punctum.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Selhání lakrimální pumpy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031734"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Forma slzení očí spojená s abnormálním tonusem a/nebo polohou víček. První z nich je způsobeno ochabnutím víček (běžná involuční změna u starších osob) nebo slabým musculus orbicularis (např. v důsledku obrny VII. hlavového nervu). Druhý případ je obvykle spojen s ektropiem, které způsobuje everzi punctum.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of watery eye associated with abnormal lid tone and/or lid position. The former is due to lid laxity (common involutional change in the elderly) or a weak orbicularis muscle (e.g. due to VII cranial nerve palsy). The latter is typically associated with ectropion causing punctal eversion.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031734"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Selhání lakrimální pumpy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lacrimal pump failure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031736">
        <obo:IAO_0000115 xml:lang="cs">Abnormální inverze očního víčka směrem k bulbu, příčinou je ochablost tkání a obrna pretarzální části m. orbicularis oculi.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Involuční entropium</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031736"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální inverze očního víčka směrem k bulbu, příčinou je ochablost tkání a obrna pretarzální části m. orbicularis oculi.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal inversion of the eyelid towards the globe resulting from inferior retractor muscle dysfunction with tissue laxity and, possibly, overriding of the preseptal orbicularis muscle over the pretarsal orbicularis muscle.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031736"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Involuční entropium</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Involutional entropion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031737">
        <obo:IAO_0000115 xml:lang="cs">Abnormální inverze (otočení dovnitř) očního víčka směrem k bulbu asociovaná s jizvením, které vertikálně zkrátí posteriorní lamelu očního víčka.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Jizevnaté entropium</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031737"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální inverze (otočení dovnitř) očního víčka směrem k bulbu asociovaná s jizvením, které vertikálně zkrátí posteriorní lamelu očního víčka.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal inversion (turning inward) of the eyelid towards the globe associated with scarring that vertically shortens the posterior lamella of the eyelid.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031737"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Jizevnaté entropium</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cicatricial entropion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031738">
        <obo:IAO_0000115 xml:lang="cs">Typ entropia (abnormální stočení očních víček směrem k bulbu), který je způsobený mechanicky, lézí (např. tumor).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mechanické entropium</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031738"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ entropia (abnormální stočení očních víček směrem k bulbu), který je způsobený mechanicky, lézí (např. tumor).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of entropion (abnormal inversion of the eyelid towards the globe) that is related to a mass effect of a lesion (e.g., a tumor) that pulls the eyelid margin away from the globe.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031738"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mechanické entropium</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mechanical entropion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
