    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033429">
        <obo:IAO_0000115 xml:lang="cs">Aktivace vrozeného imunitního systému mozku v reakci na zánětlivý podnět, která je charakterizována řadou buněčných a molekulárních změn v mozku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neurozánět</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033429"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Aktivace vrozeného imunitního systému mozku v reakci na zánětlivý podnět, která je charakterizována řadou buněčných a molekulárních změn v mozku.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Activation of the brain&apos;s innate immune system in response to an inflammatory challenge and is characterized by a host of cellular and molecular changes within the brain.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
