    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012526">
        <obo:IAO_0000115 xml:lang="cs">Nedostatek alfa granulí krevních destiček. To obvykle vede k šedému vzhledu krevních destiček v krevních nátěrech obarvených giemsou.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Chybění alfa granul</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
