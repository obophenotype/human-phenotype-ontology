    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034039">
        <obo:IAO_0000115 xml:lang="cs">Dvě po sobě následovné předčasné komorové kontrakce (extrasystoly) bez přítomnosti normálního stahu srdce.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Komorový kuplet</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034039"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Dvě po sobě následovné předčasné komorové kontrakce (extrasystoly) bez přítomnosti normálního stahu srdce.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Two consecutive premature ventricular contractions (PVCs) with no intervening normal beats.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
