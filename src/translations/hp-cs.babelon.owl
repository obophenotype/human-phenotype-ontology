    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003185">
        <obo:IAO_0000115 xml:lang="cs">Sakroiliakální kloub spojuje křížovou kost a kost kyčelní pávne, které jsou spojeny pevnými vazy. Zářez je umístněn superiorně přímo nad koubem. Tento termín odkazuje na snížení zářezu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Krátká incisura ischiadica major</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003185"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Sakroiliakální kloub spojuje křížovou kost a kost kyčelní pávne, které jsou spojeny pevnými vazy. Zářez je umístněn superiorně přímo nad koubem. Tento termín odkazuje na snížení zářezu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The sacroiliac joint in the bony pelvis connects the sacrum and the ilium of the pelvis, which are joined by strong ligaments. The notch is located directly superior to the joint. This term refers to a reduction in the height of the notch.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
