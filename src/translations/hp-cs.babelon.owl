        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025019">
        <obo:IAO_0000115 xml:lang="cs">Náhlé roztržení tepny, které vede k úniku krve z oběhu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Ruptura arterie</rdfs:label>
