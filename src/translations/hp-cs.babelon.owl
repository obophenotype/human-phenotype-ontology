    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0410151">
        <obo:IAO_0000115 xml:lang="cs">Četná infiltrace eosinofilama (obvykle víc než 15 v zorném poli pri nějvětším zvětšení) v skvamózním epitelu jícnu a vytvoření vrstvy eosinofilů na povrchu jícnu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Eozinofilní infiltrace jícnu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410151"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Četná infiltrace eosinofilama (obvykle víc než 15 v zorném poli pri nějvětším zvětšení) v skvamózním epitelu jícnu a vytvoření vrstvy eosinofilů na povrchu jícnu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Infiltration of numerous eosinophils (usually greater than 15 per high power field) into the squamous epithelium of the esophagus, and layering of eosinophils on the surface layer of the esophagus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410151"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Eozinofilní infiltrace jícnu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Eosinophilic infiltration of the esophagus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0410152">
        <obo:IAO_0000115 xml:lang="cs">Tvorba malých lokalizovaných kolekcí eozinofilů (eozinofilní mikroabsces) v jícnu. Obvykle jsou patrné shluky větší nebo rovné 4 eozinofilům, které se jeví jako exsudáty nebo bílé skvrny či bílé plaky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Tvorba eozinofilních mikroabscesů v jícnu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410152"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Tvorba malých lokalizovaných kolekcí eozinofilů (eozinofilní mikroabsces) v jícnu. Obvykle jsou patrné shluky větší nebo rovné 4 eozinofilům, které se jeví jako exsudáty nebo bílé skvrny či bílé plaky.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The formation of small localized collection of eosinophiles (an eosinophilic microabscess) in the esophagus. Usually clusters of greater than or equal to 4 eosinophils are seen, that appear as exudates or white spots or white plaques.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410152"/>
