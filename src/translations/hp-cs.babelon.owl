    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034305">
        <obo:IAO_0000115 xml:lang="cs">Typ atrioventrikulární blokády druhého stupně, kdy každá druhá vlna P není vedena přes AV uzel, takže pouze po každé druhé vlně P následuje komplex QRS.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">2:1 atrioventrikulární blokáda</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034305"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ atrioventrikulární blokády druhého stupně, kdy každá druhá vlna P není vedena přes AV uzel, takže pouze po každé druhé vlně P následuje komplex QRS.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of second-degree atrioventricular block in which every other P wave is not conducted through the AV node such that only every other P wave is followed by a QRS complex.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
