        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absent TSH response to thyrotrophin-releasing hormone stimulation test</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033082">
        <obo:IAO_0000115 xml:lang="cs">Nižší než normální odpověď TSH na stimulační test hormonu uvolňujícího tyreotropin</obo:IAO_0000115>
