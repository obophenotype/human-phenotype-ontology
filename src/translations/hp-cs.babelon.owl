        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025641"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená koncentrace cirkulujícího glykolátu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elevated circulating glycolate concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025643">
        <obo:IAO_0000115 xml:lang="cs">Cysta nervového kořene naplněná mozkomíšním mokem, nejčastěji lokalizovaná v oblasti křížové páteře.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Tarlovova cysta</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025643"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Cysta nervového kořene naplněná mozkomíšním mokem, nejčastěji lokalizovaná v oblasti křížové páteře.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cerebrospinal fluid-filled nerve root cyst most often localized in the sacral spine.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025643"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Tarlovova cysta</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tarlov cyst</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025644">
        <obo:IAO_0000115 xml:lang="cs">Fixation off sensitivity (FOS) je charakterizována posteriorními nebo generalizovanými epileptiformními výboji, které se trvale objevují za podmínek, které vylučují centrální vidění, jako jsou zavřené oči, úplná tma, modifikovaná Ganzfeldova stimulace (pomocí velké bílé plochy bez vizuálních podnětů) a Frenzelovy čočky. Obraz elektroencefalogramu (EEG) FOS se obvykle skládá z hrotů/polyspiků a vln lokalizovaných v okcipitálních oblastech (bilaterálně nebo unilaterálně) nebo generalizovaných výbojů. Obvykle je inhibován fixací pohledu, pozorováním vzorů nebo přerušovanou fotostimulací (např. blikajícím světlem nebo vzory používanými jako podněty během záznamu EEG).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Epileptiformní aktivita při změně/odstranění visuální fixace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025644"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fixation off sensitivity (FOS) je charakterizována posteriorními nebo generalizovanými epileptiformními výboji, které se trvale objevují za podmínek, které vylučují centrální vidění, jako jsou zavřené oči, úplná tma, modifikovaná Ganzfeldova stimulace (pomocí velké bílé plochy bez vizuálních podnětů) a Frenzelovy čočky. Obraz elektroencefalogramu (EEG) FOS se obvykle skládá z hrotů/polyspiků a vln lokalizovaných v okcipitálních oblastech (bilaterálně nebo unilaterálně) nebo generalizovaných výbojů. Obvykle je inhibován fixací pohledu, pozorováním vzorů nebo přerušovanou fotostimulací (např. blikajícím světlem nebo vzory používanými jako podněty během záznamu EEG).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fixation off sensitivity (FOS) is characterized by posterior or generalized epileptiform discharges that consistently occur with conditions that eliminate central vision, such as closed eyes, complete darkness, modified Ganzfeld stimulation (using a large white surface without visual cues), and Frenzel lenses. The FOS electroencephalogram (EEG) pattern usually consists of spikes/polyspikes and waves localized in occipital regions (bilateral or unilateral) or generalized discharges. It is usually inhibited by fixation of gaze, observing patterns, or intermittent photic stimulation (e.g., flashing light or patterns used as stimuli during the recording of the EEG).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025644"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Epileptiformní aktivita při změně/odstranění visuální fixace</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fixation-off epileptiform discharges</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025646">
        <obo:IAO_0000115 xml:lang="cs">Polymikrogyrie, která postihuje obě nebo některou z obou mozkových hemisfér.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Bilaterální polymikrogyrie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025646"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Polymikrogyrie, která postihuje obě nebo některou z obou mozkových hemisfér.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Polymicrogyria that affects all or some of both cerebral hemispheres.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025646"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Bilaterální polymikrogyrie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bilateral polymicrogyria</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025647">
        <obo:IAO_0000115 xml:lang="cs">Typ nefrotického syndromu, při kterém je kompletní remise (negativní/stopová hladina albuminu v moči nebo proteinurie &lt; 4 mg/m2/den nebo poměr proteinů ke kreatininu v moči &lt; 200 mg/g (&lt; 20 mg/mmol) po 3 po sobě jdoucí dny) dosaženo během prvních 4 týdnů léčby kortikosteroidy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Steroid-senzitivní nefrotický syndrom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025647"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ nefrotického syndromu, při kterém je kompletní remise (negativní/stopová hladina albuminu v moči nebo proteinurie &lt; 4 mg/m2/den nebo poměr proteinů ke kreatininu v moči &lt; 200 mg/g (&lt; 20 mg/mmol) po 3 po sobě jdoucí dny) dosaženo během prvních 4 týdnů léčby kortikosteroidy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of nephrotic syndrome in which complete remission (albumin urine dipstick negative/trace or proteinuria &lt;4mg/m2/d or urinary protein to creatinine ratio &lt;200mg/g (&lt;20 mg/mmol) for 3 consecutive days) is achieved within initial 4 weeks of corticosteroid therapy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025647"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Steroid-senzitivní nefrotický syndrom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Steroid-sensitive nephrotic syndrome</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025648">
        <obo:IAO_0000115 xml:lang="cs">Typ nefrotického syndromu citlivého na steroidy, při kterém dochází k relapsům s frekvencí jednoho relapsu (orientační chemické vyšetření močovým papírkem na albumin alespoň 3+ nebo proteinurie nad 40 mg/m2/den nebo poměr bílkovin v moči ke kreatininu alespoň 2 000 mg/g 3 po sobě jdoucí dnů) do 6 měsíců od počáteční odpovědi nebo jednoho až tří relapsů v jakémkoli 12měsíčním období.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Steroid-senzitivní nefrotický syndrom s občasnými relapsy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025648"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ nefrotického syndromu citlivého na steroidy, při kterém dochází k relapsům s frekvencí jednoho relapsu (orientační chemické vyšetření močovým papírkem na albumin alespoň 3+ nebo proteinurie nad 40 mg/m2/den nebo poměr bílkovin v moči ke kreatininu alespoň 2 000 mg/g 3 po sobě jdoucí dnů) do 6 měsíců od počáteční odpovědi nebo jednoho až tří relapsů v jakémkoli 12měsíčním období.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of steroid-sensitive nephrotic syndrome in which relapses occur at a frequency of one relapse (albumin urine dipstick at least 3+ or proteinuria over 40 mg/m2/d or urinary protein to creatinine ratio at least 2000 mg/g for 3 consecutive days) within 6 months of initial response, or one to three relapses in any 12-month period.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025648"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Steroid-senzitivní nefrotický syndrom s občasnými relapsy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Steroid-sensitive nephrotic syndrome with infrequent relapses</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025649">
        <obo:IAO_0000115 xml:lang="cs">Typ nefrotického syndromu citlivého na steroidy, při kterém dochází k relapsům s frekvencí dvou a více relapsů (orientační chemické vyšetření močovým papírkem na albumin alespoň 3+ nebo proteinurie nad 40 mg/m2/den nebo poměr bílkovin v moči ke kreatininu alespoň 2 000 mg/g 3 po sobě jdoucí dnů) do 6 měsíců od počáteční odpovědi nebo čtyřech a více relapsů v jakémkoli 12měsíčním období.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Steroid-senzitivní nefrotický syndrom s častými relapsy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025649"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ nefrotického syndromu citlivého na steroidy, při kterém dochází k relapsům s frekvencí dvou a více relapsů (orientační chemické vyšetření močovým papírkem na albumin alespoň 3+ nebo proteinurie nad 40 mg/m2/den nebo poměr bílkovin v moči ke kreatininu alespoň 2 000 mg/g 3 po sobě jdoucí dnů) do 6 měsíců od počáteční odpovědi nebo čtyřech a více relapsů v jakémkoli 12měsíčním období.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of steroid-sensitive nephrotic syndrome in which relapses occur at a frequency of two or more relapses (albumin urine dipstick at least 3+ or proteinuria over 40 mg/m2/d or urinary protein to creatinine ratio at least 2000 mg/g for 3 consecutive days) within 6 months of initial response or four or more relapses in any 12-month period.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025649"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Steroid-senzitivní nefrotický syndrom s častými relapsy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Steroid-sensitive nephrotic syndrome with frequent relapses</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025650">
        <obo:IAO_0000115 xml:lang="cs">Typ nefrotického syndromu, při kterém se během léčby kortikosteroidy vyskytnou dva po sobě jdoucí relapsy (orientační chemické vyšetření močovým papírkem na albumin alespoň 3+ nebo proteinurie větší než 40 mg/m2/den nebo poměr bílkoviny a kreatininu v moči alespoň 2000 mg/g po dobu 3 po sobě jdoucích dnů), nebo do 14 dnů po ukončení léčby.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Steroid-dependentní nefrotický syndrom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025650"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ nefrotického syndromu, při kterém se během léčby kortikosteroidy vyskytnou dva po sobě jdoucí relapsy (orientační chemické vyšetření močovým papírkem na albumin alespoň 3+ nebo proteinurie větší než 40 mg/m2/den nebo poměr bílkoviny a kreatininu v moči alespoň 2000 mg/g po dobu 3 po sobě jdoucích dnů), nebo do 14 dnů po ukončení léčby.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of nephrotic syndrome in which two consecutive relapses (albumin urine dipstick at least 3+ or proteinuria greater than 40 mg/m2/d or urinary protein to creatinine ratio at least 2000 mg/g for 3 consecutive days) occur during corticosteroid therapy, or within 14 days of ceasing therapy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025650"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Steroid-dependentní nefrotický syndrom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Steroid-dependent nephrotic syndrome</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025652">
        <obo:IAO_0000115 xml:lang="cs">Abnormální adheze placenty je charakterizována patologickým přilnutím placenty ke stěně dělohy. Na základě stupně adheze lze placentární invazi rozdělit na accreta, increta nebo percreta</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální adheze placenty do děložní stěny</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025652"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální adheze placenty je charakterizována patologickým přilnutím placenty ke stěně dělohy. Na základě stupně adheze lze placentární invazi rozdělit na accreta, increta nebo percreta</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal placental adhesion is characterized by an anomalous adherence of the placenta to the uterine wall. Based on the degree of adhesion, placental invasion can be classified into accreta, increta, or percreta.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025652"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální adheze placenty do děložní stěny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal placental adhesion into the uterine wall</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025653">
        <obo:IAO_0000115 xml:lang="cs">Placenta percreta je vzácná forma patologicky adherentní placenty, která proniká přes myometrium a dosahuje serózy a dokonce i přilehlých pánevních orgánů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Placenta percreta</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025653"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Placenta percreta je vzácná forma patologicky adherentní placenty, která proniká přes myometrium a dosahuje serózy a dokonce i přilehlých pánevních orgánů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Placenta percreta is a rare form of morbidly adherent placenta with penetration through the myometrium reaching serosa and even adjacent pelvic organs.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025653"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Placenta percreta</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Placenta percreta</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025654">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně pevné přilnutí placenty ke stěně dělohy</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Placenta acreta</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025654"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně pevné přilnutí placenty ke stěně dělohy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormally firm adherence of the placenta to the uterine wall.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025654"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Placenta acreta</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Placenta accreta</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025655">
