        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031433"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Deficit v emočním uvědomování charakterizovaný obtížemi při rozpoznávání a vyjadřování pocitů a emocí, který se projevuje omezenou schopností reagovat na výraz tváře nebo jiné známky emocí u druhých, často doprovázený odtažitým vztahem k ostatním.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Alexithymia is characterized by an impaired ability to be aware of, explicitly identify, and describe one&apos;s feelings.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031433"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Alexithymie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Alexithymia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031434">
        <obo:IAO_0000115 xml:lang="cs">Anomálie zvukových vlastností řeči, které zahrnují intonaci, přízvuk, kolísání hlasitosti, tempo řeči, rytmizace, artikukace a rytmus</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormálně řečová prozódie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031434"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomálie zvukových vlastností řeči, které zahrnují intonaci, přízvuk, kolísání hlasitosti, tempo řeči, rytmizace, artikukace a rytmus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Prosody refers to the patterns of rhythm, stress, and intonation in spoken language. Abnormal prosody refers to abnormalities in the patterns of rhythm, stress, or intonation of speech or vocalization that can be heard by the observer. In general, this refers to overt and clear deviations in patterns from culturally accepted norms but many also include differences noted in comparison to the usual patterns of the individual (a quiet person suddenly becomes loud or vice versa).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031434"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně řečová prozódie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal prosody</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031435">
        <obo:IAO_0000115 xml:lang="cs">Řečový vzorec typický abnormálně sníženou nebo chybějící variabilitou posazení hlasu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Monotónní řeč</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031435"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Řečový vzorec typický abnormálně sníženou nebo chybějící variabilitou posazení hlasu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A speech pattern characterized by a persistently abnormal lack of tone in the voice. Monotonic speech is typically ongoing, lasting throughout the day, but may have a diurnal variation in the pattern, i.e. slower at specific times of the day.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031435"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Monotónní řeč</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Monotonic speech</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031436">
        <obo:IAO_0000115 xml:lang="cs">Řečový vzorec typický abnormálně zvýšenou variabilitou posazení hlasu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená variabilita posazení hlasu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031436"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Řečový vzorec typický abnormálně zvýšenou variabilitou posazení hlasu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A speech pattern characterized by abnormal fluctuations in the pitch of the voice.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031436"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená variabilita posazení hlasu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Singsong Intonation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031437">
        <obo:IAO_0000115 xml:lang="cs">Vystavení těhotných žen toxinům z jakéhokoliv zdroje, jako jsou environmentální toxiny nebo chemické látky, které mohou potenciálně způsobit problémy jako potrat, předčasný porod, nízkou porodní hmotnost a v některých případech vývojové opoždění u dětí</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Expozice v těhotenství</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031437"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vystavení těhotných žen toxinům z jakéhokoliv zdroje, jako jsou environmentální toxiny nebo chemické látky, které mohou potenciálně způsobit problémy jako potrat, předčasný porod, nízkou porodní hmotnost a v některých případech vývojové opoždění u dětí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Exposure of pregnant women to toxins from any source, such as environmental toxins or chemicals, that may potentially cause problems such as miscarriage, preterm delivery, low birth weight, and, in some cases, developmental delays in infants.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031437"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Expozice v těhotenství</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pregnancy exposure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
