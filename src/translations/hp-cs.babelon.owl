    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032051">
        <obo:IAO_0000115 xml:lang="cs">Typ fokální kortikální dysplázie, která se vyznačuje narušenou kortikální laminací a specifickými cytologickými abnormalitami.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kortikální dysplázie typ II</rdfs:label>
    </rdf:Description>
