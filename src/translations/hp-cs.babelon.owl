        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025333">
        <obo:IAO_0000115 xml:lang="cs">Stenčení tloušťky vnější kůry (kortexu) kostí chodidla</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kortikálná ztenčení kostí chodidla</rdfs:label>
