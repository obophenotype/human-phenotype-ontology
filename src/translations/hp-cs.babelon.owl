        <babelon:source_value>Temporomandibular joint ankylosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012479">
        <obo:IAO_0000115 xml:lang="cs">Při pohybech temporomandibulárního kloubu (např. žvýkání) dochází k vzniku nechtěných zvuků kloubem. Krepitus temporomandibulárního kloubu bývá popisován jako klikání, praskání, pukání, škrábání.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Krepitace temporomandibulárního kloubu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012479"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Při pohybech temporomandibulárního kloubu (např. žvýkání) dochází k vzniku nechtěných zvuků kloubem. Krepitus temporomandibulárního kloubu bývá popisován jako klikání, praskání, pukání, škrábání.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Noises from the temporomandibular joint during mandibular movement (e.g., chewing). Temporomandibular joint crepitus is often described as a clicking, popping, grating sound.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012479"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Krepitace temporomandibulárního kloubu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Temporomandibular joint crepitus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012480">
