        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Microlissencephaly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0045029">
        <obo:IAO_0000115 xml:lang="cs">Zánět a ztluštění (lokalizovaná fibróza) fascie, tkáně pod kůží a nad svalem, obvykle spojené s nahromaděním eozinofilů ve svalech a tkáních</obo:IAO_0000115>
