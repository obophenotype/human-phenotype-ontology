        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025255">
        <obo:IAO_0000115 xml:lang="cs">Vztahuje se ke příznaku nebo projevu, který zmírněn nebo je snesitelnější těhotenstvím</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zlepšeno těhotenstvím</rdfs:label>
    </rdf:Description>
