    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002566">
        <obo:IAO_0000115 xml:lang="cs">Porucha rotace a fixace střeva, ke které normálně dochází během vývoje střeva. To může vést k volvulu neboli zkroucení střeva, které způsobuje obstrukci a nekrózu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Střevní malrotace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002566"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Porucha rotace a fixace střeva, ke které normálně dochází během vývoje střeva. To může vést k volvulu neboli zkroucení střeva, které způsobuje obstrukci a nekrózu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the intestinal rotation and fixation that normally occurs during the development of the gut. This can lead to volvulus, or twisting of the intestine that causes obstruction and necrosis.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002566"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Střevní malrotace</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Intestinal malrotation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002570">
        <obo:IAO_0000115 xml:lang="cs">Větší množství tuku ve stolici, než je obvyklé. Je to důsledek špatného vstřebávání lipidů v tenkém střevě a výsledkem je pěnivý páchnoucí výkal, který plave na hladině.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Steatorea</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002570"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Větší množství tuku ve stolici, než je obvyklé. Je to důsledek špatného vstřebávání lipidů v tenkém střevě a výsledkem je pěnivý páchnoucí výkal, který plave na hladině.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Greater than normal amounts of fat in the feces. This is a result of malabsorption of lipids in the small intestine and results in frothy foul-smelling fecal matter that floats.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002570"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Steatorea</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Steatorrhea</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002571">
        <obo:IAO_0000115 xml:lang="cs">Porucha motility jícnu charakterizovaná neschopností uvolnit dolní jícnový svěrač při polykání a nedostatečnou nebo chybějící peristaltikou v dolní polovině těla jícnu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Achalázie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002571"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Porucha motility jícnu charakterizovaná neschopností uvolnit dolní jícnový svěrač při polykání a nedostatečnou nebo chybějící peristaltikou v dolní polovině těla jícnu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A disorder of esophageal motility characterized by the inability of the lower esophageal sphincter to relax during swallowing and by inadequate or lacking peristalsis in the lower half of the body of the esophagus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002571"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Achalázie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Achalasia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002572">
        <obo:IAO_0000115 xml:lang="cs">Paroxyzmální, opakující se epizody zvracení</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Epizodické zvracení</rdfs:label>
    </rdf:Description>
