    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012562">
        <obo:IAO_0000115 xml:lang="cs">Zástava růstu v místě epifyzární (růstové) ploténky, což je ploténka hyalinní chrupavky v metafýze. Zástava růstu je přítomná v jedné nebo více záprstních kostech a to v dřívějším věku, než je obvyklé a v důsledu toho postižená kost přestane růst a je zkrácená.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Predčasný epimetafyzální srůst na ruce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012562"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zástava růstu v místě epifyzární (růstové) ploténky, což je ploténka hyalinní chrupavky v metafýze. Zástava růstu je přítomná v jedné nebo více záprstních kostech a to v dřívějším věku, než je obvyklé a v důsledu toho postižená kost přestane růst a je zkrácená.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Stop of growth at the epiphyseal plate the hyaline cartilage plate in the metaphysis at one or more long bones in the hand, at an earlier than normal age, resulting in growth arrest and shortening of the involved bone.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012562"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Predčasný epimetafyzální srůst na ruce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Premature epimetaphyseal fusion in hand</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
