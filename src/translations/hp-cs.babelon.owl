        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025313">
        <obo:IAO_0000115 xml:lang="cs">Forma strabismu s jedním nebo oběma očima šilhajícími směrem ven do mírnějšího stupně než u exotropie.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Exoforie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025313"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
