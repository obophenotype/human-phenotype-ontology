    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034185">
        <obo:IAO_0000115 xml:lang="cs">Typ mírného rozštěpu rtu, u kterého je centrální hrbolek horního rtu nahrazen slizničním rozštěpem ve středové čáře.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Středový pseudorozštěp rtu</rdfs:label>
