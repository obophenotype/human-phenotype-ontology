        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000920">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně zvýšená velikost kostochondrálního spojení. Kostochondrální spojení se nacházejí mezi distální částí žebra a chrupavčitou částí žebra, chrupavka spojuje žebra s hrudní kostí</obo:IAO_0000115>
