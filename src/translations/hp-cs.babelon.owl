        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031991">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená koncentrace beta-1-galaktosyl-O-hydroxylysinu (Gal-Hyl) v moči. Jedná se o biochemický marker kostní resorpce.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšené vylučování galaktosyl-hydroxylysinu močí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031991"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená koncentrace beta-1-galaktosyl-O-hydroxylysinu (Gal-Hyl) v moči. Jedná se o biochemický marker kostní resorpce.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An increased concentration of beta-1-galactosyl-O-hydroxylysine (Gal-Hyl) in the urine. This is a biochemical marker of bone resorption.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
