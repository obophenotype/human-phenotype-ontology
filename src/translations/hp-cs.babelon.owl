    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011861">
        <obo:IAO_0000115 xml:lang="cs">Obě plíce mají tři laloky. Levá plíce má normálně dva laloky, zatímco pravá plíce má tři laloky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Bilaterálně trojlaločné plíce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011861"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Obě plíce mají tři laloky. Levá plíce má normálně dva laloky, zatímco pravá plíce má tři laloky.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Both lungs have three lobes. Normally, the left lung has two lobes, whereas the right lung has three lobes.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
