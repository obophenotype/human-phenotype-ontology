        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Tubulointersticiální mykobakteriální infiltrace</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tubulointerstitial mycobacterial infiltration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032611">
        <obo:IAO_0000115 xml:lang="cs">Tubulární epitelové buňky obsahující cytoplazmatický hemosiderin, hnědozlatý granulární pigment</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hemosiderin v renálních tubulárních epiteliálních buňkách</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032611"/>
