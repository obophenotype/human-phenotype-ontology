    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031847">
        <obo:IAO_0000115 xml:lang="cs">Snížená schopnost chůze (pohybu) pozpátku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Obtížná chůze pozpátku</rdfs:label>
    </rdf:Description>
