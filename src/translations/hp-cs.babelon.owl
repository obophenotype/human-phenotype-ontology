    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000558">
        <obo:IAO_0000115 xml:lang="cs">Vrozená malformace předního segmentu oka charakterizovaná přítomností následovných vad: iridokorneální malformace, glaukom, hypoplázie duhovky, zadní embryotoxon a rohovkové opacity</obo:IAO_0000115>
