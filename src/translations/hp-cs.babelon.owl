    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000179">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená tloušťka spodního rtu, vedoucí k prominujícímu vzhledu spodního rtu. Výška vermilion spodního rtu ve střední čáře je víc než 2 SD nad průměrem. Nebo viditelně zvýšená výška vermilion spodního rtu při předním pohledu (subjektivně)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Silný dolní ret</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000179"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená tloušťka spodního rtu, vedoucí k prominujícímu vzhledu spodního rtu. Výška vermilion spodního rtu ve střední čáře je víc než 2 SD nad průměrem. Nebo viditelně zvýšená výška vermilion spodního rtu při předním pohledu (subjektivně)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased thickness of the lower lip, leading to a prominent appearance of the lower lip. The height of the vermilion of the lower lip in the midline is more than 2 SD above the mean. Alternatively, an apparently increased height of the vermilion of the lower lip in the frontal view (subjective).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000179"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Silný dolní ret</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Thick lower lip vermilion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000180">
        <obo:IAO_0000115 xml:lang="cs">Vícenásobné indentace či elevace okrajů a/nebo povrchu jazyka mající za následek jeho nepravidelný tvar, lobulace jazyka</obo:IAO_0000115>
