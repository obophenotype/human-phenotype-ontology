        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0008202">
        <obo:IAO_0000115 xml:lang="cs">Snížená hladina prolaktinu v krevním oběhu. Prolaktin je bílkovinný hormon, který je vylučován laktotropy v přední části hypofýzy a který stimuluje vývoj mléčné žlázy a produkci mléka.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená koncentrace cirkulujícího prolaktinu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0008202"/>
