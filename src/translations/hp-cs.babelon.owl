        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Punding neboli nutkavé repetitivní chování je stereotypní motorické chování charakterizované intenzivní fascinací opakovaným, nadměrným a necíleně orientovaným zacházením a zkoumáním předmětů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Punding is a stereotypical motor behavior characterized by an intense fascination with repetitive, excessive and non-goal oriented handling, and examining of objects.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
