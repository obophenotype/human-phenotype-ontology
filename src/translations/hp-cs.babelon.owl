    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030864">
        <obo:IAO_0000115 xml:lang="cs">Vtažení měkkých tkání mezi žebry dovnitř při nádechu. Je známkou zvýšeného používání svalů hrudníku k dýchání a projevem dechové tísně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Interkostální retrakce</rdfs:label>
    </rdf:Description>
