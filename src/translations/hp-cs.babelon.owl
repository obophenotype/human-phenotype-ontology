        <owl:annotatedTarget xml:lang="cs">Charakteristický výzor tváře (obličeje) u myopatií. Tvážře je byz výrazu, s probadlými tvářemi, bilaterální ptózou, a neschopností zvednout koutky úst z důvodu svalové slabosti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A facial appearance characteristic of myopathic conditions. The face appears expressionless with sunken cheeks, bilateral ptosis, and inability to elevate the corners of the mouth, due to muscle weakness.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
