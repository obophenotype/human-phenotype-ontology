        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000690">
        <obo:IAO_0000115 xml:lang="cs">Ageneze jednoho nebo více maxilárních řezáků, primárních či sekundárních</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Ageneze horních laterálních řezáků</rdfs:label>
