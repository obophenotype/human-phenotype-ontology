        <owl:annotatedTarget xml:lang="cs">Přetrvávající kašel definovaný jako kašel trvající déle než osm týdnů u dospělých nebo déle než čtyři týdny u dětí.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A persistent cough, defined as a cough lasting longer than eight weeks in adults or longer than four weeks in children.</babelon:source_value>
