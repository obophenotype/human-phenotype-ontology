        <owl:annotatedTarget xml:lang="cs">Typ mezenterické cysty, která je vystlána tenkým endotelem nebo mezotelem a vyplněna chylózní a lymfatickou tekutinou.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
