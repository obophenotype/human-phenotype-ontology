        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Pseudofakie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pseudophakia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500086">
        <obo:IAO_0000115 xml:lang="cs">Charakteristický vzhled břidlicově šedé oblasti pigmentace v rámci okrajů disku, která se běžně objevuje podél inferotemporálního nebo temporálního neuroretinálního okraje.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Šedý půlměsíc zrakového nervu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
