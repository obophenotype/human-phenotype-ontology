    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000947">
        <obo:IAO_0000115 xml:lang="cs">Abnormální tvar dlouhých kostí, podobajících se na činky - krátká středová část se dvěma rozšířenými konci, tzn. dlouhá kost je zkrácená s rozšířenými metafýzami</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kosti tvaru činky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
