        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Difficulty initiating sleep, that is, increased sleep onset latency, refers to the condition where it takes 30 minutes or more to fall asleep.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
