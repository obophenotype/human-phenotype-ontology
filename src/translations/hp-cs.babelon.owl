        <babelon:source_value>Elevated circulating ribitol concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025551">
        <obo:IAO_0000115 xml:lang="cs">Abnormální dekusace zrakové dráhy, typicky identifikovaná pomocí vizuálních evokovaných potenciálů (VEP) (asymetrická distribuce VEP na zadní části hlavy).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Chybné křížení zrakového nervu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025551"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální dekusace zrakové dráhy, typicky identifikovaná pomocí vizuálních evokovaných potenciálů (VEP) (asymetrická distribuce VEP na zadní části hlavy).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal decussation of the visual pathways, typically identified using visual evoked potentials (VEP) (asymmetrical distribution of the VEP over the posterior scalp).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025551"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Chybné křížení zrakového nervu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Optic nerve misrouting</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025552">
        <obo:IAO_0000115 xml:lang="cs">Vícečetné rudé/fialové skvrny na kůži kolem očí které neblednou pod tlakem. Purpura je způsobená subkutánním krvácením.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Periorbitální purpura</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025552"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vícečetné rudé/fialové skvrny na kůži kolem očí které neblednou pod tlakem. Purpura je způsobená subkutánním krvácením.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Multiple red/purple spots on the skin that surrounds the eyes that do not blanch (whiten) upon pressure. Purpura is caused by subcutaneous bleeding.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025552"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Periorbitální purpura</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Periorbital purpura</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025553">
        <obo:IAO_0000115 xml:lang="cs">Periorbitální subkutánní krvácení s průměrem větším než 1 cm (ekchymóza). Krvácení nezasahuje tarzální ploténku, protože je odděleno anatomickou strukturou zvanou orbitální septum, které limituje extravazaci krve za tarzální ploténku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Periorbitální ekchymózy se zachováním tarzální ploténky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025553"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Periorbitální subkutánní krvácení s průměrem větším než 1 cm (ekchymóza). Krvácení nezasahuje tarzální ploténku, protože je odděleno anatomickou strukturou zvanou orbitální septum, které limituje extravazaci krve za tarzální ploténku.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Subcutaneous bleeding with a diameter greater than 1 cm (ecchymosis). The bleeding does not extend into the tarsal plate (the comparatively thick, elongated plates of dense connective tissue within the eyelid) due to an anatomic structure called the orbital septum, which limits extravasation of blood beyond the tarsal plate.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025553"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Periorbitální ekchymózy se zachováním tarzální ploténky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Periorbital ecchymosis with tarsal plate sparing</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025554">
        <obo:IAO_0000115 xml:lang="cs">Typ kožního uzlíku (léze, která je větší než 10 mm na šířku i do hloubky a nejčastěji je soustředěna v dermis nebo podkožním tuku) se žlutavým zbarvením (které odráží vysoký obsah lipidů v lézi).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Žluté noduly</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025554"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ kožního uzlíku (léze, která je větší než 10 mm na šířku i do hloubky a nejčastěji je soustředěna v dermis nebo podkožním tuku) se žlutavým zbarvením (které odráží vysoký obsah lipidů v lézi).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of skin nodule (a lesions that is greater than either 10mm in both width and depth, and most frequently centered in the dermis or subcutaneous fat) with a yellowish coloration (that reflects a high lipid content of the lesion).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025554"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Žluté noduly</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Yellow nodule</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025555">
        <obo:IAO_0000115 xml:lang="cs">Telangiektázie (malé rozšířené cévy) v blízkosti nehtů na rukou nebo nohou.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Periunguální teleangiektázie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025555"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Telangiektázie (malé rozšířené cévy) v blízkosti nehtů na rukou nebo nohou.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Telangiectasia (small dilated blood vessels) located near to the fingernails or toenails.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025555"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Periunguální teleangiektázie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Periungual teleangiectasia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025558">
        <obo:IAO_0000115 xml:lang="cs">Lamelární katarakta s asociovanými lineárními opacitami čočky radiálně zasahujícím k periferii čočky</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Lamelární katarakta s jezdci</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025558"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Lamelární katarakta s asociovanými lineárními opacitami čočky radiálně zasahujícím k periferii čočky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lamellar cataracts with associated linear lens opacities radially extending towards the periphery of the lens.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025558"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Lamelární katarakta s jezdci</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lamellar cataract with riders</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025559">
        <obo:IAO_0000115 xml:lang="cs">Typ katarakty charakterizovaný kyjovitými a bodovými opacitami umístěnými radiálně v kortexu. Tyto opacity obklopují jádro a výsledná vzhled připomíná korunu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Koronární katarakta</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025559"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ katarakty charakterizovaný kyjovitými a bodovými opacitami umístěnými radiálně v kortexu. Tyto opacity obklopují jádro a výsledná vzhled připomíná korunu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of cataract characterized by club-shaped and dot opacities distributed radially in the deep cortex. These lens opacities surround the nucleus in an appearance that is though to resemble a crown.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025559"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Koronární katarakta</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Coronary cataract</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025560">
        <obo:IAO_0000115 xml:lang="cs">Drobná ložiska odpovídající buňkám plovoucím v přední oční komoře. Tento vzhled je obvykle spojen s nitroočním zánětem, který vede k narušení hemato-vodné bariéry a má za následek zvýšení počtu buněk a ve vodném moku. Třídění (SUN Working Group) se provádí odhadem počtu buněk v poli o rozměrech 1 × 1 mm za použití přiměřené intenzity světla a zvětšení na štěrbinové lampě.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Buňky přední komory</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025560"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Drobná ložiska odpovídající buňkám plovoucím v přední oční komoře. Tento vzhled je obvykle spojen s nitroočním zánětem, který vede k narušení hemato-vodné bariéry a má za následek zvýšení počtu buněk a ve vodném moku. Třídění (SUN Working Group) se provádí odhadem počtu buněk v poli o rozměrech 1 × 1 mm za použití přiměřené intenzity světla a zvětšení na štěrbinové lampě.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tiny deposits corresponding to cells floating in the anterior chamber of the eye. This appearance is typically associated with intraocular inflammation leading to breakdown of the blood-aqueous barrier and resulting in an increase in the number of cells and in the aqueous humor. Grading (SUN Working Group) is performed by estimating the number of cells in a 1 mm by 1 mm slit beam field, employing adequate light intensity and magnification on a slit lamp.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025560"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Buňky přední komory</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anterior chamber cells</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025561">
        <obo:IAO_0000115 xml:lang="cs">Buňky přední komory s 6-15 buňkami v poli štěrbinového paprsku o rozměrech 1 × 1 mm, při použití dostatečné intenzity světla a zvětšení na štěrbinové lampě.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Buňky přední komory třídy 1+</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025561"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Buňky přední komory s 6-15 buňkami v poli štěrbinového paprsku o rozměrech 1 × 1 mm, při použití dostatečné intenzity světla a zvětšení na štěrbinové lampě.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anterior chamber cells with 6-15 cells in a 1 mm by 1 mm slit beam field, employing adequate light intensity and magnification on a slit lamp.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025561"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Buňky přední komory třídy 1+</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anterior chamber cells grade 1+</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
