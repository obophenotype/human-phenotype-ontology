        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal mean corpuscular volume</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025066">
        <obo:IAO_0000115 xml:lang="cs">Snížení středního objemu erytrocytů (mean corpuscular volume, MCV), který je obvykle definován jako MCV pod 80 femtolitrů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížený střední objem erytrocytů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025066"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížení středního objemu erytrocytů (mean corpuscular volume, MCV), který je obvykle definován jako MCV pod 80 femtolitrů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduction from normal of the mean corpuscular volume, or mean cell volume (MCV) of red blood cells (usually defined as an MCV below 80 femtoliters).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
