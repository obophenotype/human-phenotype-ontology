    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012557">
        <obo:IAO_0000115 xml:lang="cs">EEG s fokálními přechodnými ostrými vlnami z tcentroemporální oblasti (centrálního sulku), tj. fokální ostré vlny trvající méně než 80 ms, po nichž následuje pomalá vlna</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">EEG s centrotemporálními fokálními hroty a vlnami</rdfs:label>
    </rdf:Description>
