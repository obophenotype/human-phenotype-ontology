    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030900">
        <obo:IAO_0000115 xml:lang="cs">Pruritus je svědění nebo pocit, který člověka nutí ke škrábání. Tento termín označuje abnormálně zvýšený pocit svědění na kůži nohy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pruritus nohy</rdfs:label>
