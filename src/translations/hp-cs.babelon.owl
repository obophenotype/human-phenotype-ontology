        <obo:IAO_0000115 xml:lang="cs">Snížená aktivita reakce 5-oxo-L-prolin + ATP + 2 H(2)O = L-glutamát + ADP + 2 H(+) + fosfát</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená hladina 5-oxoprolinázy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040142"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížená aktivita reakce 5-oxo-L-prolin + ATP + 2 H(2)O = L-glutamát + ADP + 2 H(+) + fosfát</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Activity or concentration of 5-oxoprolinase in the blood circulation below the lower limit of normal. This enzyme catalyzes the reaction 5-oxo-L-proline + ATP + 2 H(2)O = L-glutamate + ADP + 2 H(+) + phosphate.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
