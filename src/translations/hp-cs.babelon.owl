    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007010">
        <obo:IAO_0000115 xml:lang="cs">Porucha schopnosti (dovednosti) provádět přesné pohyby malých svalů s úmyslem provést určitý úkon. Jemná motorika je nutná ke zprostředkování pohybů zápěstí, rukou, prstů, chodidel a prstů na nohou.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Špatná koordinace jemné motoriky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007010"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Porucha schopnosti (dovednosti) provádět přesné pohyby malých svalů s úmyslem provést určitý úkon. Jemná motorika je nutná ke zprostředkování pohybů zápěstí, rukou, prstů, chodidel a prstů na nohou.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the ability (skills) to perform a precise movement of small muscles with the intent to perform a specific act. Fine motor skills are required to mediate movements of the wrists, hands, fingers, feet, and toes.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007010"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Špatná koordinace jemné motoriky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Poor fine motor coordination</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007011">
        <obo:IAO_0000115 xml:lang="cs">Paralýza čtvrtého hlavového (trochleárního) nervu projevující se slabostí horního šikmého svalu, která způsobuje vertikální diplopii, která je maximální, když je postižené oko addukováno a směřuje dolů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Obrna čtvrtého hlavového nervu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007011"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Paralýza čtvrtého hlavového (trochleárního) nervu projevující se slabostí horního šikmého svalu, která způsobuje vertikální diplopii, která je maximální, když je postižené oko addukováno a směřuje dolů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Paralysis of the fourth cranial (trochlear) nerve manifested as weakness of the superior oblique muscle which causes vertical diplopia that is maximal when the affected eye is adducted and directed inferiorly.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007011"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Obrna čtvrtého hlavového nervu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fourth cranial nerve palsy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007015">
        <obo:IAO_0000115 xml:lang="cs">Porucha schopnosti (dovednosti) provádět přesné pohyby velkých svalů s úmyslem provést určitý úkon. Hrubá motorika je nutná ke zprostředkování pohybů rukou, nohou a dalších velkých částí těla.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Špatná koordinace hrubé motoriky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007015"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Porucha schopnosti (dovednosti) provádět přesné pohyby velkých svalů s úmyslem provést určitý úkon. Hrubá motorika je nutná ke zprostředkování pohybů rukou, nohou a dalších velkých částí těla.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the ability (skills) to perform a precise movement of large muscles with the intent to perform a specific act. Gross motor skills are required to mediate movements of the arms, legs, and other large body parts.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007015"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Špatná koordinace hrubé motoriky</owl:annotatedTarget>
