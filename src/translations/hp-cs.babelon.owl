        <owl:annotatedTarget xml:lang="cs">Zvětšená epifýza distálního falangu palce na ruce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Enlarged epiphysis of the distal phalanx of the thumb</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
