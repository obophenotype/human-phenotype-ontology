        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vůli neovlivnitelná kontrakce svalstva krku způsobující abnormální posturu a abormální pohyblivost krku</owl:annotatedTarget>
