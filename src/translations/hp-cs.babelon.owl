        <owl:annotatedTarget xml:lang="cs">Epifýza proximální falangy palce na noze svým tvarem písmena C obklopuje diafýzu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The epiphysis of the proximal phalanx of the hallux surrounds the diaphysis, having a bracket-like form.</babelon:source_value>
