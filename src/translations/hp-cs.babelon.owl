    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006042">
        <obo:IAO_0000115 xml:lang="cs">Metakarpální kosti ve tvaru Y jsou výsledkem částěčného srůstu dvou metakarpálních kostí, kdy dvě ramena Y směrují distálně. Metakarpální kosti ve tvaru Y mohou být přítomny v kombinaci s polydaktylií.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Metakarpální kost ve tvaru Y</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006042"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Metakarpální kosti ve tvaru Y jsou výsledkem částěčného srůstu dvou metakarpálních kostí, kdy dvě ramena Y směrují distálně. Metakarpální kosti ve tvaru Y mohou být přítomny v kombinaci s polydaktylií.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Y-shaped metacarpals are the result of a partial fusion of two metacarpal bones, with the two arms of the Y pointing in the distal direction. Y-shaped metacarpals may be seen in combination with polydactyly.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
