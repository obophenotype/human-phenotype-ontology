    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030737">
        <obo:IAO_0000115 xml:lang="cs">Typ sakrokokcygeálního teratomu, který je převážně zevní a vystupuje ze sakrokokcygeální oblasti a projevuje se deformací hýždí.</obo:IAO_0000115>
