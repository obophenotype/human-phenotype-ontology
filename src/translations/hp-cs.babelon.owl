    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005458">
        <obo:IAO_0000115 xml:lang="cs">Normálně se laterální fontanely a malá fontanela uzavřou do šesti měsíců věku, velká fontanela přibližně v polovině druhého roku života. Tento termín označuje situaci, kdy tomuto uzavření dojde předčasně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Předčasný uzávěr fontanel</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005458"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Normálně se laterální fontanely a malá fontanela uzavřou do šesti měsíců věku, velká fontanela přibližně v polovině druhého roku života. Tento termín označuje situaci, kdy tomuto uzavření dojde předčasně.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Normally, the posterior and lateral fontanelles are obliterated by about six months after birth, the anterior fontanelle closes by about the middle of the second year. This term refers to the situation in which the fontanelles close at an inappropriately early time point.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005458"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Předčasný uzávěr fontanel</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Premature closure of fontanelles</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005461">
