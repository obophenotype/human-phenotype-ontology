        <owl:annotatedTarget xml:lang="cs">Forma strabismu (konvergentní strabismus) u které jedno nebo obě oči směrují mediálně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of strabismus with one or both eyes turned inward (&apos;crossed&apos;) to a relatively severe degree, usually defined as 10 diopters or more.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
