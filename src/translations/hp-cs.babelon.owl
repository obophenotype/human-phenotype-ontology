    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032534">
        <obo:IAO_0000115 xml:lang="cs">Vztahuje se pro příznak nebo symptom, který se zhoršuje po požití potraviny obsahující methylxantinovou sloučeninu (např. káva, kofein, čokoláda).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zhoršuje se požitím metylxantinu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
