        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální elektrofyziologie kardiovaskulárního systému</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of cardiovascular system electrophysiology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030957">
        <obo:IAO_0000115 xml:lang="cs">Vyklenutí (vyboulení na jednu stranu) interventrikulárního septa o více než 15 mm na obou stranách u dospělých a 5 mm u dětí při normálním pohybu srdce.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Aneuryzma komorového septa</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030957"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vyklenutí (vyboulení na jednu stranu) interventrikulárního septa o více než 15 mm na obou stranách u dospělých a 5 mm u dětí při normálním pohybu srdce.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A bowing (bulging to one side) of the interventricular septum of more than 15 mm on either side in adults and 5 mm in children during normal cardiac motion.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030957"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Aneuryzma komorového septa</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ventricular septal aneurysm</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030958">
        <obo:IAO_0000115 xml:lang="cs">Vyklenutí (vyboulení) membránové části interventrikulárního septa o více než 10-15 mm do dutiny sousední komory (obvykle do pravé komory).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Membranózní aneuryzma komorového septa</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030958"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vyklenutí (vyboulení) membránové části interventrikulárního septa o více než 10-15 mm do dutiny sousední komory (obvykle do pravé komory).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bowing (bulging out) of the membranous part of the interventricular septum of more than 10-15 mm into the cavity of an adjacent ventricle (usually into the right ventricle).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030958"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Membranózní aneuryzma komorového septa</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Membranous ventricular septal aneurysm</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030959">
        <obo:IAO_0000115 xml:lang="cs">Vyklenutí (vyboulení) svalové části interventrikulárního septa o více než 10-15 mm do dutiny sousední komory (obvykle do pravé komory).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Aneurysma muskulární části komorového septa</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030959"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vyklenutí (vyboulení) svalové části interventrikulárního septa o více než 10-15 mm do dutiny sousední komory (obvykle do pravé komory).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bowing (bulging out) of the muscular part of the interventricular septum of more than 10-15 mm into the cavity of an adjacent ventricle (usually into the right ventricle).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030959"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Aneurysma muskulární části komorového septa</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Muscular ventricular septal aneurysm</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030961">
        <obo:IAO_0000115 xml:lang="cs">Oční čočka je menší než normálně a má kulovitý tvar.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mikrosférofakie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030961"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Oční čočka je menší než normálně a má kulovitý tvar.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Microspherophakia is a rare congenital anomaly characterized by the abnormal spherical shape of the crystalline lens. It is characterized by an increased anteroposterior thickness of the lens associated with reduced equatorial diameter. The primary pathology lies in the development of zonules. The condition is often bilateral and is characterized by small, thick, and spherical lenses.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030961"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mikrosférofakie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Microspherophakia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
