        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011637">
        <obo:IAO_0000115 xml:lang="cs">Koronání arterie začína z arterie pulmonalis místo standardního začáku od aorty</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Anomální původ koronární tepny z plicní tepny</rdfs:label>
    </rdf:Description>
