        <babelon:source_value>Abnormal glomerular endothelial cell morphology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033273">
        <obo:IAO_0000115 xml:lang="cs">Ztráta kulatých až oválných diskontinuit normálně přítomných v cytoplazmě glomerulárních kapilárních endoteliálních buněk</obo:IAO_0000115>
