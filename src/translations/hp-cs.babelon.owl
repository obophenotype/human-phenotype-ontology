        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032889">
        <obo:IAO_0000115 xml:lang="cs">Záchvat charakterizovaný chuťovými vjemy včetně kyselé, hořké, slané, sladké nebo kovové chuti.</obo:IAO_0000115>
