    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033585">
        <obo:IAO_0000115 xml:lang="cs">Typ nespecifické intersticiální pneumonie, při níž je ztluštění intersticia způsobeno rovnoměrnou hustou nebo volnou fibrózou a mírným chronickým zánětem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fibrotická nespecifická intersticiální pneumonie</rdfs:label>
    </rdf:Description>
