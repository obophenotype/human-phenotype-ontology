        <babelon:source_value>Difficulty walking backward</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031848">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita chůze, kterou lze pozorovat u jedinců s dystonickým držením těla, kdy jedinec chodí s nataženým trupem a pokrčenými pažemi, přičemž se vzpíná na špičkách, aniž by se paty dotýkaly podlahy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kohoutí chůze</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031848"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita chůze, kterou lze pozorovat u jedinců s dystonickým držením těla, kdy jedinec chodí s nataženým trupem a pokrčenými pažemi, přičemž se vzpíná na špičkách, aniž by se paty dotýkaly podlahy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of gait that can be observed in individuals with dystonic posture in which the individual walks with an extended trunk and flexed arms, while strutting on the toes without the heels touching the floor.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031848"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kohoutí chůze</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cock-walk gait</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031849">
        <obo:IAO_0000115 xml:lang="cs">Převrácení spánkových návyků s tendencí spát přes den a být v noci vzhůru.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Inverze spánkového režimu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031849"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Převrácení spánkových návyků s tendencí spát přes den a být v noci vzhůru.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reversal of sleeping habits, with a tendency to sleep during the day and be awake at night.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031849"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Inverze spánkového režimu</owl:annotatedTarget>
