    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009197">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita proximální falangy pátého prstu na ruce, kdy je falangeální kost obklopena epifýzou tvaru písmena C a její osifikací v proximodistálním směru</obo:IAO_0000115>
