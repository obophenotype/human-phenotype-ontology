    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030681">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli strukturální anomálie svalových sloupců, které vyčnívají z vnitřního povrchu pravé a levé komory srdce (kardiální trabekuly, trabeculae carneae)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie myokardiálních trabekul</rdfs:label>
