        <babelon:source_value>Type 1 congenital pulmonary airway malformation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025726">
        <obo:IAO_0000115 xml:lang="cs">Typ vrozené malformace plicních dýchacích cest, pro kterou jsou charakteristické četné rovnoměrně rozmístěné cysty (houbovitý vzhled).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vrozená malformace plicních dýchacích cest typu 2</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025726"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ vrozené malformace plicních dýchacích cest, pro kterou jsou charakteristické četné rovnoměrně rozmístěné cysty (houbovitý vzhled).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of congenital pulmonary airway malformation that is characterized by multiple evenly spaced cysts (sponge-like appearance).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025726"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Vrozená malformace plicních dýchacích cest typu 2</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Type 2 congenital pulmonary airway malformation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025727">
        <obo:IAO_0000115 xml:lang="cs">Typ vrozené malformace plicních dýchacích cest, která se vyznačuje objemným pevným útvarem adenomatoidního vzhledu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vrozená malformace plicních dýchacích cest typu 3</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025727"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ vrozené malformace plicních dýchacích cest, která se vyznačuje objemným pevným útvarem adenomatoidního vzhledu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of congenital pulmonary airway malformation that is characterized by a bulky firm mass with an adenomatoid appearance.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
