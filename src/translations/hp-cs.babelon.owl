    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031134">
        <obo:IAO_0000115 xml:lang="cs">Vývojová anomálie srdce charakterizovaná přítomností tří síní, protože levá síň je rozdělena abnormálním septem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Cor triatrium sinister</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031134"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vývojová anomálie srdce charakterizovaná přítomností tří síní, protože levá síň je rozdělena abnormálním septem.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A developmental anomaly of the heart characterized by the presence of three atria because the left atrium is divided by an abnormal septum.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
