    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032011">
        <obo:IAO_0000115 xml:lang="cs">Heteroforie jsou latentní odchylky, které jsou řízeny fúzí. Za určitých okolností (specifické zrakové úkoly, únava, nemoc atd.) již nelze fúzi udržet a dochází k dekompenzaci.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Heteroforie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032011"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Heteroforie jsou latentní odchylky, které jsou řízeny fúzí. Za určitých okolností (specifické zrakové úkoly, únava, nemoc atd.) již nelze fúzi udržet a dochází k dekompenzaci.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Heterophorias are latent deviations that are controlled by fusion. In certain circumstances (specific visual tasks, fatigue, illness, etc.), fusion can no longer be maintained and decompensation occurs.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
