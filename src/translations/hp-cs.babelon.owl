    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002877">
        <obo:IAO_0000115 xml:lang="cs">Abnormální snížení alveolární ventilace během spánku. Je charakterizováno vzestupem arteriálního oxidu uhličitého.</obo:IAO_0000115>
