        <owl:annotatedTarget xml:lang="cs">Anormální zbarvení rtu, kde ret je světlejší či tmavší, můžou na něm být okrsky hypo či hyperpigmentace.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal coloring of the lip, whereby the lip discolored, blotchy, or darker or lighter than normal.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
