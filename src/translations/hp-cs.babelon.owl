        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Renální selhání</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Renal insufficiency</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000085">
        <obo:IAO_0000115 xml:lang="cs">Propojení pravé a levé ledviny isthmem tvořeným funkčním renálním parenchymem nebo vazivovou tkání přetínající střední čáru</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Podkovovitá ledvina</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000085"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Propojení pravé a levé ledviny isthmem tvořeným funkčním renálním parenchymem nebo vazivovou tkání přetínající střední čáru</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A connection of the right and left kidney by an isthmus of functioning renal parenchyma or fibrous tissue that crosses the midline.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
