        <owl:annotatedTarget xml:lang="cs">Vrozená vada srdce charakterizovaná odstupem arteria pulmonalis i aorty z morfologicky levé komory.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
