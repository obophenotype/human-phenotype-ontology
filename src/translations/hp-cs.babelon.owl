    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012628">
        <obo:IAO_0000115 xml:lang="cs">Anomálie závěsného vazu čočky, známá také jako ciliární zonula. Tyto vazy představují řadu vláken spojujících řasnaté těleso a oční čočku, která drží čočku na svém místě.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie závěsného vazu čočky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012628"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomálie závěsného vazu čočky, známá také jako ciliární zonula. Tyto vazy představují řadu vláken spojujících řasnaté těleso a oční čočku, která drží čočku na svém místě.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly of the suspensory ligament of lens, also known as the ciliary zonule. These ligaments represent a series of fibers connecting the ciliary body and lens of the eye, holding the lens in place.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
