    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0550003">
        <obo:IAO_0000115 xml:lang="cs">Symetrické ztluštění, napnutí a indurbace kůže prstů a kůže proximálně od metakarpofalangeálních nebo metatarzofalangeálních kloubů. Tyto změny se mohou týkat celé končetiny, obličeje, krku a trupu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Proximální sklerodermie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0550003"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Symetrické ztluštění, napnutí a indurbace kůže prstů a kůže proximálně od metakarpofalangeálních nebo metatarzofalangeálních kloubů. Tyto změny se mohou týkat celé končetiny, obličeje, krku a trupu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Symmetrical thickening, tightening and induration of the skin of the fingers and the skin proximal to the metacarpophalangeal or metatarsophalangeal joints. These changes can involve the entire limb, face, neck and trunk.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0550003"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Proximální sklerodermie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Proximal scleroderma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0550004">
        <obo:IAO_0000115 xml:lang="cs">Mírně vystouplá bradavice o průměru 2-5 mm často spojená s virovými infekcemi, běžně přetrvávající u jedinců s imunodeficiencí</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Verruca plana</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0550004"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Mírně vystouplá bradavice o průměru 2-5 mm často spojená s virovými infekcemi, běžně přetrvávající u jedinců s imunodeficiencí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Slightly raised wart 2-5 mm in diameter often associated with viral infections, commonly persistent in immunodeficient individuals.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0550004"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Verruca plana</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Verruca plana</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0550005">
        <obo:IAO_0000115 xml:lang="cs">Jedná se o bilaterální retikulární nález lineárních nebo lineonodulárních zvýšených hustot, které jsou nejvýraznější v bazilárních částech plic na standardním rentgenovém snímku hrudníku. Je to třetí vedlejší kritérium pro diagnostiku sklerodermie.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Bilaterální bazilární pulmonární fibróza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0550005"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jedná se o bilaterální retikulární nález lineárních nebo lineonodulárních zvýšených hustot, které jsou nejvýraznější v bazilárních částech plic na standardním rentgenovém snímku hrudníku. Je to třetí vedlejší kritérium pro diagnostiku sklerodermie.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>It is a bilateral reticular pattern of linear or lineonodular densities that are most pronounced in basilar portions of the lungs on standard chest x-ray. It is the third minor criterion for scleroderma diagnosis.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0550005"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Bilaterální bazilární pulmonární fibróza</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bilateral basilar pulmonary fibrosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
