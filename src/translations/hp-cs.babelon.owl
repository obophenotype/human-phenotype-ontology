    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012185">
        <obo:IAO_0000115 xml:lang="cs">Poranění nervus medianus způsobené jeho kompresi v karpálním tunelu. Klinicky je konstrikční neuropatie medianu charakterizována bolestí, parestezií a slabostí v oblasti ruky, kterou inervuje</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kompresivní neuropatie n. medianus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012185"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Poranění nervus medianus způsobené jeho kompresi v karpálním tunelu. Klinicky je konstrikční neuropatie medianu charakterizována bolestí, parestezií a slabostí v oblasti ruky, kterou inervuje</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Injury to the median nerve caused by its entrapment at the wrist as it traverses through the carpal tunnel. Clinically, constrictive median neuropathy is characterized by pain, paresthesia, and weakness in the median nerve distribution of the hand.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
