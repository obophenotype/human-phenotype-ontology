        <babelon:source_value>Areflexia of upper limbs</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012047">
        <obo:IAO_0000115 xml:lang="cs">Zraková vada charakterizovaná neschopností vidět tak jasně v jasném světle jako v šeru. Slovo hemeralopie doslova znamená denní slepota.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hemeralopie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012047"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zraková vada charakterizovaná neschopností vidět tak jasně v jasném světle jako v šeru. Slovo hemeralopie doslova znamená denní slepota.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A visual defect characterized by the inability to see as clearly in bright light as in dim light. The word hemeralopia literally means day blindness.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012047"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hemeralopie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hemeralopia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012048">
        <obo:IAO_0000115 xml:lang="cs">Druh fokální dystonie charakterizovaný silnými kontrakcemi obličeje, čelisti a/nebo jazyka způsobující potíže při otevírání a zavírání úst a často ovlivňující žvýkání a řeč.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Oromandibulární dystonie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012048"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Druh fokální dystonie charakterizovaný silnými kontrakcemi obličeje, čelisti a/nebo jazyka způsobující potíže při otevírání a zavírání úst a často ovlivňující žvýkání a řeč.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A kind of focal dystonia characterized by forceful contractions of the face, jaw, and/or tongue causing difficulty in opening and closing the mouth and often affecting chewing and speech.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012048"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Oromandibulární dystonie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Oromandibular dystonia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012049">
        <obo:IAO_0000115 xml:lang="cs">Typ fokální dystonie postihující hlasivky asociované s jejich mimovolnými kontrakcemi a způsobující přerušení řeči a postihující kvalitu hlasu a často vede k typickým opakovaným přestávkám v řeči</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Laryngelání dystonie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012049"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fokální dystonie postihující hlasivky asociované s jejich mimovolnými kontrakcemi a způsobující přerušení řeči a postihující kvalitu hlasu a často vede k typickým opakovaným přestávkám v řeči</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of focal dystonia that affects the vocal cords, associated with involuntary contractions of the vocal cords causing interruptions of speech and affecting the voice quality and often leading to patterned, repeated breaks in speech.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012049"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Laryngelání dystonie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Laryngeal dystonia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012050">
        <obo:IAO_0000115 xml:lang="cs">Extrémní forma generalizovaného masivního otoku v důsledku efuze tekutin do extracelulárního prostoru</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Anasarka</rdfs:label>
