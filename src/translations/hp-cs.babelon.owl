        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Glucagonoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030405">
        <obo:IAO_0000115 xml:lang="cs">Neuroendokrinní nádor pocházející z buňky slinivky břišní produkující hormony (buňky Langerhansových ostrůvků)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Endokrinní tumor slinivky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030405"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
