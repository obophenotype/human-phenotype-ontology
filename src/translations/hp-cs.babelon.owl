        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal impaired awareness behavior arrest seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032791">
        <obo:IAO_0000115 xml:lang="cs">Fokální kognitivní záchvat s anomií charakterizovaný poruchou vědomí v určitém okamžiku během záchvatu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kognitivní záchvat s anomií a poruchou vědomí</rdfs:label>
    </rdf:Description>
