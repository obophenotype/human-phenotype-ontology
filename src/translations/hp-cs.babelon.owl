        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000691">
        <obo:IAO_0000115 xml:lang="cs">Zmenšená velikost zubů, která může být definována jako mesiodistální průměr zubu (šířka) míň než -2 SD. Alternativně, očividně zmenšená šířka zubů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mikrodoncie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000691"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zmenšená velikost zubů, která může být definována jako mesiodistální průměr zubu (šířka) míň než -2 SD. Alternativně, očividně zmenšená šířka zubů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased size of the teeth, which can be defined as a mesiodistal tooth diameter (width) more than 2 SD below mean. Alternatively, an apparently decreased maximum width of tooth.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
