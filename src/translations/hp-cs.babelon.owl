    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033635">
        <obo:IAO_0000115 xml:lang="cs">Postkapilární plicní hypertenze je hemodynamický stav charakterizovaný zvýšeným středním tlakem v plicnici (mPAP větší než 20 mmHg) a tlakem v zaklínění plicnice (PAWP větší než 15 mmHg) a plicní vaskulární rezistencí (PVR menší než 3 Woodovy jednotky).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Postkapilární plicní hypertenze</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033635"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Postkapilární plicní hypertenze je hemodynamický stav charakterizovaný zvýšeným středním tlakem v plicnici (mPAP větší než 20 mmHg) a tlakem v zaklínění plicnice (PAWP větší než 15 mmHg) a plicní vaskulární rezistencí (PVR menší než 3 Woodovy jednotky).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Post-capillary pulmonary hypertension is a hemodynamic condition characterized by elevated mean pulmonary artery pressure (mPAP greater than 20 mmHg) and pulmonary artery wedge pressure (PAWP greater than 15 mmHg) and pulmonary vascular resistance (PVR less than 3 Wood units).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033635"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Postkapilární plicní hypertenze</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Post-capillary pulmonary hypertension</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033636">
        <obo:IAO_0000115 xml:lang="cs">Kombinovaná pre- a postkapilární plicní hypertenze je hemodynamický stav charakterizovaný zvýšeným středním tlakem v plicnici (mPAP nad 20 mmHg) a tlakem v zaklínění plicnice (PAWP nad 15 mmHg) a plicní vaskulární rezistencí (PVR alespoň 3 Woddovy jednotky).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kombinovaná prekapilární a postkapilární plicní hypertenze</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033636"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kombinovaná pre- a postkapilární plicní hypertenze je hemodynamický stav charakterizovaný zvýšeným středním tlakem v plicnici (mPAP nad 20 mmHg) a tlakem v zaklínění plicnice (PAWP nad 15 mmHg) a plicní vaskulární rezistencí (PVR alespoň 3 Woddovy jednotky).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Combined pre- and post-capillary pulmonary hypertension is a haemodynamic condition characterized by elevated mean pulmonary artery pressure (mPAP over 20 mmHg) and pulmonary artery wedge pressure (PAWP over 15 mmHg) and pulmonary vascular resistance (PVR at least 3 Wodd units).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
