        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033483">
        <obo:IAO_0000115 xml:lang="cs">Vnoření cytoplazmatických výběžků podocytů do glomerulární bazální membrány (GBM) se ztluštěním lamina densa a mikrosférami a/nebo mikrotubulárními strukturami v GBM</obo:IAO_0000115>
