        <babelon:source_value>Decreased mean platelet volume</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005539">
        <obo:IAO_0000115 xml:lang="cs">Forma lymfoidní leukémie nebo lymfomu, při které se v krvi, kostní dřeni a tkáních nachází příliš mnoho T-lymfoblastů. Klasifikace leukémie nebo lymfomu závisí na převažujícím znaku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Chronický T- lymfocytární lymfom/leukémie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005539"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Forma lymfoidní leukémie nebo lymfomu, při které se v krvi, kostní dřeni a tkáních nachází příliš mnoho T-lymfoblastů. Klasifikace leukémie nebo lymfomu závisí na převažujícím znaku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of lymphoid leukemia or lymphoma in which too many T-cell lymphoblasts are found in the blood, bone marrow, and tissues. Leukemia or lymphoma classification depends on which feature is more prominent.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005539"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Chronický T- lymfocytární lymfom/leukémie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>T cell chronic lymphocytic lymphoma/leukemia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005540">
        <obo:IAO_0000115 xml:lang="cs">Forma poikilocytózy, při níž mají abnormálně tvarované erytrocyty zářezy, jejichž výsledkem jsou výběžky připomínající rohy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Keratocytóza červených krvinek</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005540"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Forma poikilocytózy, při níž mají abnormálně tvarované erytrocyty zářezy, jejichž výsledkem jsou výběžky připomínající rohy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of poikilocytosis in which the abnormally shaped erythrocytes have notches that results in projections that look like horns</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005540"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Keratocytóza červených krvinek</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>obsolete Red blood cell keratocytosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005541">
        <obo:IAO_0000115 xml:lang="cs">Vrozené znatelné snížení počtu granulocytů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kongenitální agranulocytóza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005541"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vrozené znatelné snížení počtu granulocytů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Persistent absence of detectable circulating granulocytes in the blood with no detected secondary cause. Usually a value of less than 50 granulocytes per microliter is considered to be an absence.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005541"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kongenitální agranulocytóza</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Congenital agranulocytosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005542">
        <obo:IAO_0000115 xml:lang="cs">Abnormální prodloužení (zpoždění) doby potřebné k vytvoření viditelné sraženiny v krvi</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Prodloužená doba srážení krve</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005542"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální prodloužení (zpoždění) doby potřebné k vytvoření viditelné sraženiny v krvi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal prolongation (delay) in the time required by whole blood to produce a visible clot.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005542"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Prodloužená doba srážení krve</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Prolonged whole-blood clotting time</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005543">
        <obo:IAO_0000115 xml:lang="cs">Porucha koagulace související se sníženou koncentrací vitamín K-dependentního proteinu C. Protein C je aktivován na protein Ca trombinem navázaným na trombomodulin. Aktivovaný protein C degraduje faktory VIIIa a Va.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená aktivita proteinu C</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005543"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Porucha koagulace související se sníženou koncentrací vitamín K-dependentního proteinu C. Protein C je aktivován na protein Ca trombinem navázaným na trombomodulin. Aktivovaný protein C degraduje faktory VIIIa a Va.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of coagulation related to a decreased concentration of vitamin K-dependent protein C. Protein C is activated to protein Ca by thrombin bound to thrombomodulin. Activated protein C degrades factors VIIIa and Va.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005543"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Snížená aktivita proteinu C</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced protein C activity</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005546">
        <rdfs:label xml:lang="cs">Zvýšená osmotická rezistence erytrocytů</rdfs:label>
