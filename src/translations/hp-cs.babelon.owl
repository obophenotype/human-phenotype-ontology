    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025149">
        <obo:IAO_0000115 xml:lang="cs">Částečný nebo úplný úbytek (ztráta) kdysi přítomné tkáně muscularis propria. Atrofie může zahrnovat výraznou vakuolární degeneraci myocytů, ztrátu svalových vláken a v některých případech velmi charakteristickou voštinovitou fibrózu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Atrofická muscularis propria</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025149"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Částečný nebo úplný úbytek (ztráta) kdysi přítomné tkáně muscularis propria. Atrofie může zahrnovat výraznou vakuolární degeneraci myocytů, ztrátu svalových vláken a v některých případech velmi charakteristickou voštinovitou fibrózu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Partial or complete wasting (loss) of muscularois propria tissue that was once present. The atrophy may involve a marked vacuolar degeneration of myocytes, loss of muscle fibers and some cases a highly characteristic honeycomb fibrosis.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
