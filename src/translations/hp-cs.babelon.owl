        <owl:annotatedTarget xml:lang="cs">Akrální nebo periorificiální léze, které se vyvíjejí v opakujících se výsevech s prstencovitým a migrujícím rozložením.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
