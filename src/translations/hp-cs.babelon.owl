    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002107">
        <obo:IAO_0000115 xml:lang="cs">Nahromadění vzduchu v pleurální dutině vedoucí k částečnému nebo úplnému kolapsu plic</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pneumotorax</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002107"/>
