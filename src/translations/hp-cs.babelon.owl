        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032098">
        <obo:IAO_0000115 xml:lang="cs">Snížení koncentrace manganu v krvi pod normální hodnotu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hypomanganesémie</rdfs:label>
