        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>&quot;Nephrosclerosis refers to thickening or scarring (&quot;&quot;sclerosis&quot;&quot;) resulting from damage to the renal arterioles, also referred to as arteriosclerosis of the kidney arteries.&quot;</babelon:source_value>
