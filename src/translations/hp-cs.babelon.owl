        <owl:annotatedTarget xml:lang="cs">Regionální a patologický nárůst prahu detekce světla v jakémkoli regionu ve vizuálním poli obklopený polem s normálním nebo relativně dobře zachovalým viděním</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
