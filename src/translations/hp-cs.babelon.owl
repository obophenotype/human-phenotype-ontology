    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001629">
        <obo:IAO_0000115 xml:lang="cs">Otvor v septu mezi komorami srdce. Vada je obvykle v místě nejvyššího bodu komorového septa</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Defekt komorového septa</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001629"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Otvor v septu mezi komorami srdce. Vada je obvykle v místě nejvyššího bodu komorového septa</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A hole between the two bottom chambers (ventricles) of the heart. The defect is centered around the most superior aspect of the ventricular septum.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001629"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Defekt komorového septa</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ventricular septal defect</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001631">
        <obo:IAO_0000115 xml:lang="cs">Defekt septa síní (ASD) je vrozená abnormalita septa mezi síněmi, která umožňuje průtok krve mezi levou a pravou síní přes interatriální septum</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Defekt septa síní</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001631"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Defekt septa síní (ASD) je vrozená abnormalita septa mezi síněmi, která umožňuje průtok krve mezi levou a pravou síní přes interatriální septum</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrial septal defect (ASD) is a congenital abnormality of the interatrial septum that enables blood flow between the left and right atria via the interatrial septum.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001631"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Defekt septa síní</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrial septal defect</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001633">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli konstrukční anomálie mitrální chlopně</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie mitrální chlopně</rdfs:label>
