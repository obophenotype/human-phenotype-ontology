    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0045059">
        <obo:IAO_0000115 xml:lang="cs">Ohraničená, pevná vyvýšenina kůže bez viditelné tekutiny o velikosti od špendlíkové hlavičky po méně než 10 mm v průměru v nejširším místě, která je tvořena lokalizovanou hyperkeratózou (tu lze prokázat histopatologicky).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hyperkeratotická papula</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0045059"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Ohraničená, pevná vyvýšenina kůže bez viditelné tekutiny o velikosti od špendlíkové hlavičky po méně než 10 mm v průměru v nejširším místě, která je tvořena lokalizovanou hyperkeratózou (tu lze prokázat histopatologicky).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A circumscribed, solid elevation of skin with no visible fluid, varying in size from a pinhead to less than 10mm in diameter at the widest point that is composed of localized hyperkeratosis (the latter may be demonstrated histopathologically).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
