    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031631">
        <obo:IAO_0000115 xml:lang="cs">Takzvaná voština (cysty různé velikosti na pozadí hustě zjizvené tkáně) lokalizované v subpleurálním prostoru</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Subpleurální voština</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031631"/>
