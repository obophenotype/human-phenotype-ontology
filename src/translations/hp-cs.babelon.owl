    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002204">
        <obo:IAO_0000115 xml:lang="cs">Embolus (tj. abnormální částice cirkulující v krvi), který se nachází v plicní tepně a blokuje tak krevní oběh do plic. Obvykle se jedná o krevní sraženinu, která se vytvořila v končetině (například hluboká žilní trombóza), odloučila se a putovala krevním oběhem, než uvízla v plicní tepně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Plicní embolie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002204"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Embolus (tj. abnormální částice cirkulující v krvi), který se nachází v plicní tepně a blokuje tak krevní oběh do plic. Obvykle se jedná o krevní sraženinu, která se vytvořila v končetině (například hluboká žilní trombóza), odloučila se a putovala krevním oběhem, než uvízla v plicní tepně.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An embolus (that is, an abnormal particle circulating in the blood) located in the pulmonary artery and thereby blocking blood circulation to the lung. Usually the embolus is a blood clot that has developed in an extremity (for instance, a deep venous thrombosis), detached, and traveled through the circulation before becoming trapped in the pulmonary artery.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002204"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Plicní embolie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pulmonary embolism</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
