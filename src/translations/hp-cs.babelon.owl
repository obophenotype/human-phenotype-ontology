    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011726">
        <obo:IAO_0000115 xml:lang="cs">Systémová desaturace živě narozeného dítěte v důsledku přetrvávající plicní hypertenze s otevřeným ductus arteriosus a otevřeným foramen ovale, takže cirkulace v postnatálním životě sleduje průběh plodu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Peristující fetální cirkulace</rdfs:label>
    </rdf:Description>
