        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010456">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita incisura ischiadica major, t.j. výhřezu na zadní hraně pánevní kosti v místě spojení os ilium (kyčelní kosti) a os ischium (sedací kosti)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie incisura ischiadica major</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010456"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita incisura ischiadica major, t.j. výhřezu na zadní hraně pánevní kosti v místě spojení os ilium (kyčelní kosti) a os ischium (sedací kosti)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the sacrosciatic notch, i.e., the deep indentation in the posterior border of the hip bone at the point of union of the ilium and ischium.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
