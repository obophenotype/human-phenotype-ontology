    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031909">
        <obo:IAO_0000115 xml:lang="cs">Děloha, která má jenom jeden děložný roh a má tvar podobný banánu. Může ale nemusí mít druhý rudimentární děložní roh.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Unicornuate uterus</rdfs:label>
    </rdf:Description>
