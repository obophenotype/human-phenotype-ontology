    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032404">
        <obo:IAO_0000115 xml:lang="cs">Abnormální vyboulení nebo bulka ve varleti. Útvary na varleti mají širokou diferenciální diagnostiku včetně testikulární torze, epididymitidy, akutní orchitidy, strangulované kýly a rakoviny varlat</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Útvar na varleti</rdfs:label>
    </rdf:Description>
