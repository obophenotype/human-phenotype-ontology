        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010804">
        <obo:IAO_0000115 xml:lang="cs">Trojúhelníkový vzhled orální apertury s vrcholem ve středu horní červeně rtu. Dolní červeň rtu tvoří základnu trojúhelníku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Červeň horního rtu stanového tvaru</rdfs:label>
