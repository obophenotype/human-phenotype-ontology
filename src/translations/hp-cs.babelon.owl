    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004384">
        <obo:IAO_0000115 xml:lang="cs">Truncus arteriosus (jediná velká tepna opouštějící bazi srdce, která vede ke koronárním, plicním a systémovým tepnám) s krátkým plicním kmenem vycházíjím z truncus arteriosus, čímž vznikají obě plicní tepny</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Truncus arteriosus typu I</rdfs:label>
    </rdf:Description>
