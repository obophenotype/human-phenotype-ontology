    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033694">
        <obo:IAO_0000115 xml:lang="cs">Falešné vnímání hmatových smyslových vstupů, které vytváří halucinační pocit fyzického kontaktu s imaginárním předmětem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hmatové halucinace</rdfs:label>
