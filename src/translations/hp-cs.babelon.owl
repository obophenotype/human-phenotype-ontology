        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032035"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Laxicita dolního očního víčka</owl:annotatedTarget>
