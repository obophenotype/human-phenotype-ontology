    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010287">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita slinné žlázy submandibulární, která se nachází pod spodinou ústní dutiny, nad musculus digastricus.</obo:IAO_0000115>
