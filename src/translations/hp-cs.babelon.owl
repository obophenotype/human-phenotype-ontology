    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031290">
        <obo:IAO_0000115 xml:lang="cs">Typ xantomu charakterizovaný nodulární formou. Tuberózní xantomy jsou pevné podkožní uzlíky, přičemž kůže na jejich povrchu může mít červené nebo červenožluté barevné změny.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Tuberózní xantom</rdfs:label>
    </rdf:Description>
