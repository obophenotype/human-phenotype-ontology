    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0008035">
        <obo:IAO_0000115 xml:lang="cs">Retinitis pigmentosa inversa je forma degenerace sítnice charakterizovaná oblastmi retinální/chorioretinální degenerace s migrací pigmentu v makulární oblasti (na rozdíl od retinitis pigmentosa, která v časných stadiích onemocnění postihuje převážně periferii sítnice).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Retinitis pigmentosa inversa</rdfs:label>
    </rdf:Description>
