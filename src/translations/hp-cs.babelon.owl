    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030051">
        <obo:IAO_0000115 xml:lang="cs">Abnormální vzorec chůze charakterizovaný nedostatkem kontaktu paty s podlahou na začátku postoje během chůze</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Chůze po špičkách</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030051"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
