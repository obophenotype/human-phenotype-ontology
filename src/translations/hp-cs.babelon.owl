    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000092">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost ledvinných tubulů se ztluštělou bazální laminou, nebo zmenšení poloměru tubulů o více než 50% v porovnání se sousedními neatrofickými tubuly</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Renální tubulární atrofie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000092"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost ledvinných tubulů se ztluštělou bazální laminou, nebo zmenšení poloměru tubulů o více než 50% v porovnání se sousedními neatrofickými tubuly</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of renal tubules with thick redundant basement membranes, or a reduction of greater than 50% in tubular diameter compared to surrounding non-atrophic tubules.</babelon:source_value>
