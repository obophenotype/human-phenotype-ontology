    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030673">
        <obo:IAO_0000115 xml:lang="cs">Forma vitreoretinopatie charakterizovaná ztenčením (erozí) pigmentového epitelu sítnice, která umožňuje zvýšenou vizualizaci cév cévnatky.</obo:IAO_0000115>
