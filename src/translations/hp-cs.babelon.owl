        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100283"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kontinuální elektromyografická aktivita motorických jednotek v klidu, tj. bez volního pohybu svalů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Continuous electromyographic activity of motor units at rest, i.e., without voluntary movement of the muscles.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100283"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">EMG: kontinuální aktivita motorických jednotek v klidu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>EMG: continuous motor unit activity at rest</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100284">
        <obo:IAO_0000115 xml:lang="cs">Vysokofrekvenční výboje v elektromyografii (EMG), které se liší amplitudou a frekvencí, nepřetržitě klesají a klesají s frekvencí střelby od 150/s do 20/s a vydávají zvuk, který byl označován jako zvuk střemhlavého bombardéru.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">EMG: myotonické výboje</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100284"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vysokofrekvenční výboje v elektromyografii (EMG), které se liší amplitudou a frekvencí, nepřetržitě klesají a klesají s frekvencí střelby od 150/s do 20/s a vydávají zvuk, který byl označován jako zvuk střemhlavého bombardéru.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>High frequency discharges in electromyography (EMG) that vary in amplitude and frequency, waxing and waning continuously with firing frequencies ranging from 150/second down to 20/second and producing a sound that has been referred to as a dive bomber sound.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100284"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">EMG: myotonické výboje</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>EMG: myotonic discharges</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100285">
        <obo:IAO_0000115 xml:lang="cs">Elektromyografický nález spojený s nepravidelným nebo chybějícím neuromuskulárním přenosem s nepravidelnými, momentálními změnami tvaru potenciálu motorické jednotky (MUP)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">EMG: porucha neuromuskulárního přenosu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100285"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Elektromyografický nález spojený s nepravidelným nebo chybějícím neuromuskulárním přenosem s nepravidelnými, momentálními změnami tvaru potenciálu motorické jednotky (MUP)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An electromyographic finding associated with erratic or absent neuromuscular transmission with erratic, moment-to-moment changes in the shape of the motor unit potential (MUP).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100285"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">EMG: porucha neuromuskulárního přenosu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>EMG: impaired neuromuscular transmission</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100287">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost snížené rychlosti vedení motorickými nervy při elektromyografii.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">EMG: pomalé motorické vedení</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100287"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost snížené rychlosti vedení motorickými nervy při elektromyografii.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of reduced conduction velocity of motor nerves on electromyography.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100287"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">EMG: pomalé motorické vedení</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>EMG: slow motor conduction</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100288">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost sérií spontánních rychle se spouštějících potenciálů, které se opakují v pravidelných intervalech 2-10 za sekundu a nejsou ovlivněny volním úsilím. Jedná se o elektromyografický (EMG) nález.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">EMG: myokymické výboje</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100288"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost sérií spontánních rychle se spouštějících potenciálů, které se opakují v pravidelných intervalech 2-10 za sekundu a nejsou ovlivněny volním úsilím. Jedná se o elektromyografický (EMG) nález.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of spontaneous bursts of rapidly firing potentials that recur at regular intervals of 2-10 per second and are unaffected by voluntary effort. This is an electromyographic (EMG) finding.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100288"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">EMG: myokymické výboje</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>EMG: myokymic discharges</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
