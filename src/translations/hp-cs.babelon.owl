    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003554">
        <obo:IAO_0000115 xml:lang="cs">Atrofie (ochabování) postihující primární svalová vlákna typu 2. Tento znak lze obecně pozorovat pouze při svalové biopsii.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Atrofie svalových vláken typu 2</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003554"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Atrofie (ochabování) postihující primární svalová vlákna typu 2. Tento znak lze obecně pozorovat pouze při svalové biopsii.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrophy (wasting) affecting primary type 2 muscle fibers. This feature in general can only be observed on muscle biopsy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
