        <owl:annotatedTarget xml:lang="cs">Akutní lymfoblastická leukémie původem z T-buněk. Zahrnuje asi 15 % dětských případů a 25 % dospělých případů. Je častější u mužů než u žen</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Acute lymphoblastic leukemia of T-cell origin. It comprises about 15% of childhood cases and 25% of adult cases. It is more common in males than females.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
