        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cavity within the cerebral hemisphere, filled with cerebrospinal fluid, that communicates directly with the ventricular system.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
