        <owl:annotatedTarget xml:lang="cs">&quot;Radiolucentní lokální defekt těla posteriorní části těla žebra. &quot;&quot;Mezery&quot;&quot; mohou vést k nestabilitě hrudní stěny.&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
