    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033817">
        <obo:IAO_0000115 xml:lang="cs">Vyznačuje se četnými malými lézemi, které prý připomínají semínka prosa.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Miliární</rdfs:label>
    </rdf:Description>
