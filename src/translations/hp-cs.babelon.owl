        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Paralytic ectropion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500070">
        <obo:IAO_0000115 xml:lang="cs">Léze konjunktivy tvořená tukovou tkání a hustou pojivovou tkání. Tento typ choristomu složeného z kožních elementů se normálně vyskytuje při vnějším kantu a má gelatinózní vzhled. Klasicky mívá nejasnou zadní hranici (léze často expanduje do orbity) a jasně ohraničenou přední část, několik milimetrů za limbem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Konjunktivální dermolipom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500070"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Léze konjunktivy tvořená tukovou tkání a hustou pojivovou tkání. Tento typ choristomu složeného z kožních elementů se normálně vyskytuje při vnějším kantu a má gelatinózní vzhled. Klasicky mívá nejasnou zadní hranici (léze často expanduje do orbity) a jasně ohraničenou přední část, několik milimetrů za limbem.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A conjuctival lesion composed of adipose tissue and dense connective tissue. Such choristomas of dermal elements are normally found at the outer canthus, and have a gelatinous appearance. Classically, there is an indistinct posterior border (with the lesion frequently extending into the orbit) and a well-demarcated anterior border several millimeters posterior to the limbus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500070"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Konjunktivální dermolipom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Conjunctival dermolipoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500072">
        <obo:IAO_0000115 xml:lang="cs">Excentrická fixace, ve které se úhel excentricity rovná objektivnímu úhlu odchylky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Absolutní excentrická fixace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500072"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Excentrická fixace, ve které se úhel excentricity rovná objektivnímu úhlu odchylky.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Eccentric fixation in which the angle of eccentricity equals the objective angle of deviation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
