    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025680">
        <obo:IAO_0000115 xml:lang="cs">Facilitace amplitudy sumačného akčního potenciálu svalu (CMAP) znamená zvýšení šlacho-svalových reflexů, síly, nebo amplitudy CMAP po deseti vteřinách maximální vědomé kontrakce.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Facilitace amplitudy sumačního svalového akčního potenciálu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
