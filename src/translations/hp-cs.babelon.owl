    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030829">
        <obo:IAO_0000115 xml:lang="cs">Anomální (náhodný) zvuk vznikající při dýchání</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální zvuk dechu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030829"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
