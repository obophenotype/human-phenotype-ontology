        <obo:IAO_0000115 xml:lang="cs">Zúžení choan (zadního otvoru nosní dutiny)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Choanální stenóza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000452"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
