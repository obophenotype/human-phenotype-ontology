        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030750">
        <obo:IAO_0000115 xml:lang="cs">Intraventrikulární krvácení, ke kterému dochází u předčasně narozených dětí a které vede k dilataci komor</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Intraventrikulární hemoragie III u nedonošenců</rdfs:label>
