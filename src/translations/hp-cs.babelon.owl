    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003682">
        <obo:IAO_0000115 xml:lang="cs">Vztahuje se na projevy nemoci, které rychle nabývají na rozsahu nebo závažnosti s různou rychlostí. Například progrese může být v jednom časovém období pomalá a v jiném rychlá.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Variabilní míra progrese</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
