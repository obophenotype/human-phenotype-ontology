    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025471">
        <obo:IAO_0000115 xml:lang="cs">Hamartomatózní proliferace obsahující malformované vlasové folikuly v různých stadiích vývoje. Panfolikulomy jsou dobře ohraničené léze vykazující všechna stadia folikulární diferenciace.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vrozený panfolikulární névus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025471"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Hamartomatózní proliferace obsahující malformované vlasové folikuly v různých stadiích vývoje. Panfolikulomy jsou dobře ohraničené léze vykazující všechna stadia folikulární diferenciace.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A hamartomatous proliferation containing malformed hair follicles in various stages of development. Panfolliculomas are well-circumscribed lesions demonstrating all stages of follicular differentiation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025471"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Vrozený panfolikulární névus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Congenital panfollicular nevus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025472">
        <obo:IAO_0000115 xml:lang="cs">Opakované plísňové infekce na chodidle, které se obvykle projevují šupinatěním, macerací a svěděním</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Opakované plantární mykózy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025472"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Opakované plísňové infekce na chodidle, které se obvykle projevují šupinatěním, macerací a svěděním</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A history of repeated fungal infections located on the sole of the foot, usually manifested by scaling, maceration, and itching.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025472"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Opakované plantární mykózy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Recurrent plantar mycosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025473">
        <obo:IAO_0000115 xml:lang="cs">Papula (ohraničená, pevná vyvýšenina kůže bez viditelné tekutiny, o velikosti od špendlíkové hlavičky po méně než 10 mm v průměru v nejširším místě), která vykazuje zvýšenou pigmentaci (je tmavší) ve srovnání s okolní kůží.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hyperpigmentovaná papula</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025473"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Papula (ohraničená, pevná vyvýšenina kůže bez viditelné tekutiny, o velikosti od špendlíkové hlavičky po méně než 10 mm v průměru v nejširším místě), která vykazuje zvýšenou pigmentaci (je tmavší) ve srovnání s okolní kůží.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A papule (circumscribed, solid elevation of skin with no visible fluid, varying in size from a pinhead to less than 10mm in diameter at the widest point) that exhibits increased pigmentation (is darker) compared to the surrounding skin.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025473"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hyperpigmentovaná papula</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hyperpigmented papule</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025474">
        <obo:IAO_0000115 xml:lang="cs">Plak (pevná, vyvýšená, plošná léze o průměru větším než 1 cm) s červenou nebo načervenalou barvou, často spojená se zánětem nebo podrážděním.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Erytematózní plak</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025474"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Plak (pevná, vyvýšená, plošná léze o průměru větším než 1 cm) s červenou nebo načervenalou barvou, často spojená se zánětem nebo podrážděním.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A plaque (a solid, raised, plateau-like (flat-topped) lesion greater than 1 cm in diameter) with a red or reddish color often associated with inflammation or irritation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025474"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Erytematózní plak</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Erythematous plaque</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025475">
        <obo:IAO_0000115 xml:lang="cs">Makula (plochá, zřetelná, odbarvená oblast kůže o šířce menší než 1 cm, která nezahrnuje žádnou změnu tloušťky nebo struktury kůže) s červenou nebo načervenalou barvou, často spojená se zánětem nebo podrážděním.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Erytematózní skvrna</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025475"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Makula (plochá, zřetelná, odbarvená oblast kůže o šířce menší než 1 cm, která nezahrnuje žádnou změnu tloušťky nebo struktury kůže) s červenou nebo načervenalou barvou, často spojená se zánětem nebo podrážděním.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A macule (flat, distinct, discolored area of skin less than 1 cm wide that does not involve any change in the thickness or texture of the skin) with a red or reddish color often associated with inflammation or irritation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025475"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Erytematózní skvrna</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Erythematous macule</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025476">
        <obo:IAO_0000115 xml:lang="cs">Mnohočetná ložiska adipocytů v testikulárním intersticiu, obvykle se projevující jako mnohočetné bilaterální špatně ohraničené hyperechogenní intratestikulární léze různých velikostí, obvykle však o maximálním průměru 4 mm.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Testikulární lipomatóza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025476"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Mnohočetná ložiska adipocytů v testikulárním intersticiu, obvykle se projevující jako mnohočetné bilaterální špatně ohraničené hyperechogenní intratestikulární léze různých velikostí, obvykle však o maximálním průměru 4 mm.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Multiple foci of adipocytes within the testicular interstitium, usually presenting as multiple bilateral ill-defined hyperechoic intratesticular lesions of different sizes but generally with maximum diameter of 4 mm.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
