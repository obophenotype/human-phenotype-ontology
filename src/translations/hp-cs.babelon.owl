        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A degree of pneumatization that is increased compared to age-related norms.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010540"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Pokročilá pneumatizace paranasálních dutin</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Advanced pneumatization of cranial sinuses</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010541">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost zkroucených záhybů a rýh na hlavě tvořených ztluštělou kůží skalpu vytvářející obraz podobný gyrifikaci mozku. Skalp pokrývají elevované, zkroucené záhyby, 1 až 2 cm hrubé. Záhyby obvykle nelze vyrovnat trakcí.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Cutis gyrata skalpu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010541"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost zkroucených záhybů a rýh na hlavě tvořených ztluštělou kůží skalpu vytvářející obraz podobný gyrifikaci mozku. Skalp pokrývají elevované, zkroucené záhyby, 1 až 2 cm hrubé. Záhyby obvykle nelze vyrovnat trakcí.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of convoluted folds and furrows formed from thickened skin of the scalp, resembling cerebriform pattern. The scalp has convoluted and elevated folds, 1 to 2 cm in thickness. The convolutions generally cannot be flattened by traction.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010541"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Cutis gyrata skalpu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cutis gyrata of scalp</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010542">
        <obo:IAO_0000115 xml:lang="cs">Nystagmus v důsledku narušení vestibulárního systému; pohyby očí jsou rytmické, s pomalými a rychlými složkami</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vestibulární nystagmus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010542"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nystagmus v důsledku narušení vestibulárního systému; pohyby očí jsou rytmické, s pomalými a rychlými složkami</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nystagmus due to disturbance of the vestibular system; eye movements are rhythmic, with slow and fast components.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010542"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Vestibulární nystagmus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Vestibular nystagmus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010543">
        <obo:IAO_0000115 xml:lang="cs">Záblesky vícesměrných sakád s velkou amplitudou bez intersakadického intervalu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Opsoklonus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010543"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Záblesky vícesměrných sakád s velkou amplitudou bez intersakadického intervalu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bursts of large-amplitude multidirectional saccades without intersaccadic interval</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010543"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Opsoklonus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Opsoclonus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010544">
        <obo:IAO_0000115 xml:lang="cs">Vertikální nystagmus se může projevovat buď pohyby očí směrem nahoru, nebo dolů, případně oběma způsoby. Pokud je přítomen v poloze přímého pohledu, označuje se jako nystagmus s kmitáním nahoru nebo nystagmus s kmitáním dolů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vertikální nystagmus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010544"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vertikální nystagmus se může projevovat buď pohyby očí směrem nahoru, nebo dolů, případně oběma způsoby. Pokud je přítomen v poloze přímého pohledu, označuje se jako nystagmus s kmitáním nahoru nebo nystagmus s kmitáním dolů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Vertical nystagmus may present with either up-beating or down-beating eye movements or both. When present in the straight-ahead position of gaze it is referred to as upbeat nystagmus or downbeat nystagmus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010544"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Vertikální nystagmus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Vertical nystagmus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010545">
        <obo:IAO_0000115 xml:lang="cs">Downbeat nystagmus je typem fixačního nystagmu, jehož rychlá fáze bije směrem dolů. Obvykle se zvyšuje při pohledu do strany a dolů a při ležení na zádech.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Downbeat nystagmus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010545"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Downbeat nystagmus je typem fixačního nystagmu, jehož rychlá fáze bije směrem dolů. Obvykle se zvyšuje při pohledu do strany a dolů a při ležení na zádech.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Downbeat nystagmus is a type of fixation nystagmus with the fast phase beating in a downward direction. It generally increases when looking to the side and down and when lying prone.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010545"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Downbeat nystagmus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Downbeat nystagmus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010546">
        <obo:IAO_0000115 xml:lang="cs">Jemné, rychlé záškuby jednotlivých svalových vláken s malým nebo žádným pohybem svalu jako celku. Pokud je motoneuron nebo jeho axon zničen, dochází k denervační atrofii svalových vláken, která inervuje. To vede k přecitlivělosti jednotlivých svalových vláken na acetylcholin, takže se mohou spontánně stahovat. Izolovaná aktivita jednotlivých svalových vláken je obvykle tak jemná, že ji nelze přes neporušenou kůži vidět, ačkoli ji lze zaznamenat jako krátce trvající hrot v EMG.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Svalová fibrilace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010546"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jemné, rychlé záškuby jednotlivých svalových vláken s malým nebo žádným pohybem svalu jako celku. Pokud je motoneuron nebo jeho axon zničen, dochází k denervační atrofii svalových vláken, která inervuje. To vede k přecitlivělosti jednotlivých svalových vláken na acetylcholin, takže se mohou spontánně stahovat. Izolovaná aktivita jednotlivých svalových vláken je obvykle tak jemná, že ji nelze přes neporušenou kůži vidět, ačkoli ji lze zaznamenat jako krátce trvající hrot v EMG.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fine, rapid twitching of individual muscle fibers with little or no movement of the muscle as a whole as ascertained by electromyography (EMG). If a motor neuron or its axon is destroyed, the muscle fibers it innervates undergo denervation atrophy. This leads to hypersensitivity of individual muscle fibers to acetyl choline so that they may contract spontaneously. Isolated activity of individual muscle fibers is generally so fine it cannot be seen through the intact skin, although it can be recorded as a short-duration spike in the EMG.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010546"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Svalová fibrilace</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Muscle fibrillation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010547">
        <obo:IAO_0000115 xml:lang="cs">Typ ochrnutí, při kterém sval změkne a podvolí se pasivnímu protažení, které je důsledkem ztráty všech nebo prakticky všech periferních motorických nervů, které inervovaly sval. Svalový tonus je snížen a postižené svaly podléhají extrémní atrofii během měsíců po ztrátě inervace.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Ochablost svalů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010547"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ ochrnutí, při kterém sval změkne a podvolí se pasivnímu protažení, které je důsledkem ztráty všech nebo prakticky všech periferních motorických nervů, které inervovaly sval. Svalový tonus je snížen a postižené svaly podléhají extrémní atrofii během měsíců po ztrátě inervace.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of paralysis in which a muscle becomes soft and yields to passive stretching, which results from loss of all or practically all peripheral motor nerves that innervated the muscle. Muscle tone is reduced and the affected muscles undergo extreme atrophy within months of the loss of innervation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010547"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Ochablost svalů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Muscle flaccidity</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010548">
        <obo:IAO_0000115 xml:lang="cs">Lokalizovaná myotonická kontrakce ve svalu jako reakce na poklep (klepání prstem vyšetřujícího, gumovým kladívkem nebo podobným předmětem)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Poklepová myotonie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010548"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Lokalizovaná myotonická kontrakce ve svalu jako reakce na poklep (klepání prstem vyšetřujícího, gumovým kladívkem nebo podobným předmětem)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A localized myotonic contraction in a muscle in reaction to percussion (tapping with the examiner&apos;s finger, a rubber percussion hammer, or a similar object).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010548"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Poklepová myotonie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Percussion myotonia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010549">
        <obo:IAO_0000115 xml:lang="cs">Paralýza vůlí ovlivnitelných svalů znamená ztrátu kontrakce svalu kvůli poškození jedné nebo více motorických drah na ose mozok - sval. I když slovo paralýza se používá hodně volně a může značit úplnou i částečnou ztrátu svalové síly. Je preferované použít paralýza nebo plégie při závažné nebo úplné ztrátě a paréza při částečné či mírné ztrátě. Paralýza z důvodu poškození hlavných motorických drah je způsobená lézí kortikospinálních, kortikobulbárních nebo kmenových sestupných nervů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Slabost způsobená dysfunkcí horních motorických neuronů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010549"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Paralýza vůlí ovlivnitelných svalů znamená ztrátu kontrakce svalu kvůli poškození jedné nebo více motorických drah na ose mozok - sval. I když slovo paralýza se používá hodně volně a může značit úplnou i částečnou ztrátu svalové síly. Je preferované použít paralýza nebo plégie při závažné nebo úplné ztrátě a paréza při částečné či mírné ztrátě. Paralýza z důvodu poškození hlavných motorických drah je způsobená lézí kortikospinálních, kortikobulbárních nebo kmenových sestupných nervů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Paralysis of voluntary muscles means loss of contraction due to interruption of one or more motor pathways from the brain to the muscle fibers. Although the word paralysis is often used interchangeably to mean either complete or partial loss of muscle strength, it is preferable to use paralysis or plegia for complete or severe loss of muscle strength, and paresis for partial or slight loss. Paralysis due to lesions of the principle motor tracts is related to a lesion in the corticospinal, corticobulbar or brainstem descending (subcorticospinal) neurons.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010549"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Slabost způsobená dysfunkcí horních motorických neuronů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Weakness due to upper motor neuron dysfunction</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010550">
        <obo:IAO_0000115 xml:lang="cs">Těžká nebo úplná slabost obou dolních končetin, která nepostihuje horní končetiny.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Paraplegie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010550"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Těžká nebo úplná slabost obou dolních končetin, která nepostihuje horní končetiny.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Severe or complete weakness of both lower extremities with sparing of the upper extremities.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010550"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Paraplegie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Paraplegia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010551">
        <obo:IAO_0000115 xml:lang="cs">Slabost obou dolních končetin, která nepostihuje horní končetiny. Paraplegie znamená těžkou nebo úplnou ztrátu síly, zatímco paraparéza znamená relativně mírnou ztrátu síly.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Paraplegie/paraparéza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010551"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Slabost obou dolních končetin, která nepostihuje horní končetiny. Paraplegie znamená těžkou nebo úplnou ztrátu síly, zatímco paraparéza znamená relativně mírnou ztrátu síly.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Weakness of both lower extremities with sparing of the upper extremities. Paraplegia refers to a severe or complete loss of strength, whereas paraparesis refers to a relatively mild loss of strength.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010551"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Paraplegie/paraparéza</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Paraplegia/paraparesis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010553">
        <obo:IAO_0000115 xml:lang="cs">Akutní dystonická reakce s blefarospasmem, periorbitálními záškuby a protrahovanými epizodami upřeného zírání. Trvale může dojít k maximální odchylce očí směrem nahoru. Okulogyrická krize může být vyvolána řadou faktorů, včetně neuroleptických léků.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Okulogyrické krize</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010553"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Akutní dystonická reakce s blefarospasmem, periorbitálními záškuby a protrahovanými epizodami upřeného zírání. Trvale může dojít k maximální odchylce očí směrem nahoru. Okulogyrická krize může být vyvolána řadou faktorů, včetně neuroleptických léků.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An acute dystonic reaction with blepharospasm, periorbital twitches, and protracted fixed staring episodes. There may be a maximal upward deviation of the eyes in the sustained fashion. Oculogyric crisis can be triggered by a number of factors including neuroleptic medications.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010553"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Okulogyrické krize</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Oculogyric crisis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010554">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost měkkých tkání v A/P ose mezi dvěma prsty ruky, která zasahuje minimální do úrovně proximálních interfalangeálních kloubů nebo přítomnost měkkých tkání v A/P ose mezi dvěma prsty, které leží významně distálněji než flexní rýha která překrývající metakarpofalangeální kloub sousedních prstů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kožní syndaktylie prstů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010554"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost měkkých tkání v A/P ose mezi dvěma prsty ruky, která zasahuje minimální do úrovně proximálních interfalangeálních kloubů nebo přítomnost měkkých tkání v A/P ose mezi dvěma prsty, které leží významně distálněji než flexní rýha která překrývající metakarpofalangeální kloub sousedních prstů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A soft tissue continuity in the A/P axis between two fingers that extends distally to at least the level of the proximal interphalangeal joints, or a soft tissue continuity in the A/P axis between two fingers that lies significantly distal to the flexion crease that overlies the metacarpophalangeal joint of the adjacent fingers.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010554"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kožní syndaktylie prstů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cutaneous finger syndactyly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010557">
        <obo:IAO_0000115 xml:lang="cs">Prst spočívající na dorzální straně přilehlého prstu v době kdy je ruka volně položená</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Překrývající se prsty na ruce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010557"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Prst spočívající na dorzální straně přilehlého prstu v době kdy je ruka volně položená</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A finger resting on the dorsal surface of an adjacent digit when the hand is at rest.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010557"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Překrývající se prsty na ruce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Overlapping fingers</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010558">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita klivu (clivus), svažité části kosti v zadní jámě lebečné lokalizované mezi sella turcica a foramen magnum.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální clivus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010558"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita klivu (clivus), svažité části kosti v zadní jámě lebečné lokalizované mezi sella turcica a foramen magnum.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the clivus, which is the inclined bony region of the posterior cranial fossa located between the sella turcica and the foramen magnum.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010558"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální clivus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal clivus morphology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010559">
        <obo:IAO_0000115 xml:lang="cs">Abnormální vertikální orientce clivu (který normálně spíše svažuje směrem od sella turcica k oblasti foramen magnum)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vertikální clivus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010559"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální vertikální orientce clivu (který normálně spíše svažuje směrem od sella turcica k oblasti foramen magnum)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal vertical orientation of the clivus (which normally forms a kind of slope from the sella turcica down to the region of the foramen magnum).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
