    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001027">
        <obo:IAO_0000115 xml:lang="cs">Neobyčejně jemná kůže (na dotek až hedvábně jemná) mající tvárnou konzistenci jako těsto</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Jemná, těstovitá kůže</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001027"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neobyčejně jemná kůže (na dotek až hedvábně jemná) mající tvárnou konzistenci jako těsto</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A skin texture that is unusually soft (and may feel silky), and has a malleable consistency resembling that of dough.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
