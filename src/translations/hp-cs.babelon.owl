    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011125">
        <obo:IAO_0000115 xml:lang="cs">Porucha melanosomů, tj. buněčných organel, v nichž se syntetizují a ukládají melaninové pigmenty v melanocytech (buňkách produkujících pigment v dermis).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormality dermálních melanozomů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011125"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Porucha melanosomů, tj. buněčných organel, v nichž se syntetizují a ukládají melaninové pigmenty v melanocytech (buňkách produkujících pigment v dermis).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the melanosomes, i.e., of the cellular organelles in which melanin pigments are synthesized and stored within melanocytes (the cells that produce pigment in the dermis).</babelon:source_value>
