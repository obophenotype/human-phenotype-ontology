    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025432">
        <obo:IAO_0000115 xml:lang="cs">Nezhoubný epiteliální kožní nádor projevující se jako mírně vyvýšený kruhový plak nebo uzlík s červenou, růžovou nebo hnědou barvou a průměrem do 22 mm</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Akantom</rdfs:label>
