    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100253">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita dřeňové dutiny (kostní dřeň, uprostřed kosti), která je centální dutinou těla kosti, v které je umístněná červená a/nebo žlutá kostní dřeň (tuková tkáň).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormality dřeňové dutiny dlouhých kostí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100253"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita dřeňové dutiny (kostní dřeň, uprostřed kosti), která je centální dutinou těla kosti, v které je umístněná červená a/nebo žlutá kostní dřeň (tuková tkáň).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the medullary cavity (medulla, innermost part), which is the central cavity of bone shafts where red bone marrow and/or yellow bone marrow (adipose tissue) is stored.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
