    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032146">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost abnormálního typu hemoglobinu charakterizovaná substitucí kyseliny glutamové lysinem na 7 pozici za počátečním methioninem (6GAG&gt;6AAG). Přítomnost HbC lze stanovit elektroforézou hemoglobinu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">HbC hemoglobin</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032146"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost abnormálního typu hemoglobinu charakterizovaná substitucí kyseliny glutamové lysinem na 7 pozici za počátečním methioninem (6GAG&gt;6AAG). Přítomnost HbC lze stanovit elektroforézou hemoglobinu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Presence of an abnormal type of hemoglobin characterized by the substitution of a glutamic acid residue at position 7 following the initial methionine residue by a lysine (6GAG&gt;6AAG). The presence of HbC can be determined by hemoglobin electrophoresis.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032146"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">HbC hemoglobin</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>HbC hemoglobin</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032147">
        <obo:IAO_0000115 xml:lang="cs">Opakující se epizody zarudnutí, pálivé bolesti a tepla v končetinách po vystavení teplu nebo cvičení se symptomy postihujícími převážně nohy</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Erythromelalgie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032147"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Opakující se epizody zarudnutí, pálivé bolesti a tepla v končetinách po vystavení teplu nebo cvičení se symptomy postihujícími převážně nohy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Recurrent episodes of redness, burning pain, and warmth of the extremities following exposure to heat or exercise with symptoms predominantly involving the feet.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
