    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007716">
        <obo:IAO_0000115 xml:lang="cs">Maligní melanom vycházející z oka. Nádor pochází z melanocytů uvey (která zahrnuje duhovku, řasnaté tělísko a cévnatku)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Uveální melanom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007716"/>
