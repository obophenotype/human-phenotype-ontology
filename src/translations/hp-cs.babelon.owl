        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Subsarkolemální akumulace abnormálně tvarovaných mitochondrií</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Subsarcolemmal accumulations of abnormally shaped mitochondria</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003549">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli abnormalita měkkých tkání, včetně pojivové tkáně (šlachy, vazy, fascie, vazivové tkáně a tuk)</obo:IAO_0000115>
