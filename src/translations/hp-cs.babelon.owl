    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010841">
        <obo:IAO_0000115 xml:lang="cs">Abnormální elektrická aktivita mozku zaznamenaná při skalpovém EEG vycházející z více ložisek</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Multifokální epileptické výboje</rdfs:label>
    </rdf:Description>
