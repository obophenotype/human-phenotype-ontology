    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011681">
        <obo:IAO_0000115 xml:lang="cs">Defekt komorového septa, který leží pod semilunární chlopní (chlopněmi) v infundibulární či výtokové části septa.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Subarteriální defekt komorového septa</rdfs:label>
    </rdf:Description>
