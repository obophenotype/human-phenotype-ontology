        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033690">
        <obo:IAO_0000115 xml:lang="cs">Neschopnost vyvolat vzpomínky z dlouhodobé paměti, které byly získány před nástupem amnézie.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Retrográdní porucha paměti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033690"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neschopnost vyvolat vzpomínky z dlouhodobé paměti, které byly získány před nástupem amnézie.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inability to retrieve information from the long-term memory that was acquired before the onset of amnesia.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033690"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
