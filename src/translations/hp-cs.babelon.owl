    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031491">
        <obo:IAO_0000115 xml:lang="cs">Difúzní, bilaterální a nově i jednostranná nebo fokální hrot - vlna vyskytující se v pomalém spánku nebo spánku s pomalými pohyby očí (NREM)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kontinuální hroty a vlny během pomalého spánku</rdfs:label>
    </rdf:Description>
