        <obo:IAO_0000115 xml:lang="cs">Anomální původ levé plicní tepny, která vychází ze zadní části pravé plicní tepny a prochází mezi průdušnicí a jícnem, aby dosáhla levého plicího hilu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pulmonální arteriální sling</rdfs:label>
    </rdf:Description>
