    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002754">
        <obo:IAO_0000115 xml:lang="cs">Osteomyelitida je zánětlivý proces doprovázený destrukcí kostí a způsobený infekčním mikroorganismem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Osteomyelitida</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002754"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Osteomyelitida je zánětlivý proces doprovázený destrukcí kostí a způsobený infekčním mikroorganismem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Osteomyelitis is an inflammatory process accompanied by bone destruction and caused by an infecting microorganism.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
