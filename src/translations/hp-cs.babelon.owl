    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031711">
        <obo:IAO_0000115 xml:lang="cs">Aneuryzma břišní aorty, které není symetrické kolem své osy (není osově symetrické).</obo:IAO_0000115>
