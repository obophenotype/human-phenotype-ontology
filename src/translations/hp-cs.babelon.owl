    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030748">
        <obo:IAO_0000115 xml:lang="cs">Intraventrikulární krvácení, ke kterému dochází u předčasně narozeného dítěte a které je omezeno na subependymální oblast/germinální matrix, která je vidět v kaudotalamické rýze.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Intraventrikulární hemoragie I u nedonošenců</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030748"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Intraventrikulární krvácení, ke kterému dochází u předčasně narozeného dítěte a které je omezeno na subependymální oblast/germinální matrix, která je vidět v kaudotalamické rýze.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Intraventricular hemorrhage that occurs in a preterm infant and that is restricted to subependymal region/germline matrix which is seen in the caudothalamic groove.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
