        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Snížená koncentrace glycinu v CSF</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased CSF glycine concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034391">
        <obo:IAO_0000115 xml:lang="cs">Omezení rozsahu pasivního pohybu lokte v důsledku ztráty elasticity v periartikulárních tkáních z důvodu strukturálních změn tkání jako jsou svaly, šlachy, vazy, kloubní pouzdra nebo kůže, vyjma kostí</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kontraktura lokte</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034391"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Omezení rozsahu pasivního pohybu lokte v důsledku ztráty elasticity v periartikulárních tkáních z důvodu strukturálních změn tkání jako jsou svaly, šlachy, vazy, kloubní pouzdra nebo kůže, vyjma kostí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A limitation in the passive range of motion of the elbow resulting from loss of elasticity in the periarticular tissues owing to structural changes of non-bony tissues, such as muscles, tendons, ligaments, joint capsules or skin.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034391"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kontraktura lokte</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elbow contracture</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034392">
        <obo:IAO_0000115 xml:lang="cs">Omezení rozsahu pasivního pohybu lokte v důsledku ztráty elasticity v periartikulárních tkáních z důvodu strukturálních změn tkání jako jsou svaly, šlachy, vazy, kloubní pouzdra nebo kůže, vyjma kostí. Kontraktury brání pohybu související části těla</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kontraktura kloubu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034392"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Omezení rozsahu pasivního pohybu lokte v důsledku ztráty elasticity v periartikulárních tkáních z důvodu strukturálních změn tkání jako jsou svaly, šlachy, vazy, kloubní pouzdra nebo kůže, vyjma kostí. Kontraktury brání pohybu související části těla</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A limitation in the passive range of motion of a joint resulting from loss of elasticity in the periarticular tissues owing to structural changes of non-bony tissues, such as muscles, tendons, ligaments, joint capsules or skin. A contracture prevents movement of the associated body part.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034392"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kontraktura kloubu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Joint contracture</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034393">
        <obo:IAO_0000115 xml:lang="cs">Kontraktura lokte, která omezuje schopnost flexe v loketním kloubu (flexe loketního kloubu znamená ohnutí loketního kloubu, kdy se ruka přibližuje k rameni), což znamená, že je loket fixován v natažené (rovné) poloze</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Extenční kontraktura lokte</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034393"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kontraktura lokte, která omezuje schopnost flexe v loketním kloubu (flexe loketního kloubu znamená ohnutí loketního kloubu, kdy se ruka přibližuje k rameni), což znamená, že je loket fixován v natažené (rovné) poloze</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An elbow contracture that limits the ability of the elbow joint to flex (flexion of the the elbow joint refers to bending the elbow joint to bring the hand closer to the shoulder), meaning that the elbow is fixed in an extended (straight) position.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034393"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Extenční kontraktura lokte</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elbow extension contracture</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034394">
        <obo:IAO_0000115 xml:lang="cs">Kontraktura, která omezuje schopnost předloktí stabilizovat ruku v pronaci (pronací se rozumí rotace předloktí způsobující, že dlaň a předloktí směřují dolů), což znamená, že dlaň je fixována směrem vzhůru. Omezení supinace/pronace se může vyskytovat v lokti (humeroradiální kloub), v zápěstí (radioulnární kloub) a kdekoli mezi nimi</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Supinační kontraktura předloktí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034394"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kontraktura, která omezuje schopnost předloktí stabilizovat ruku v pronaci (pronací se rozumí rotace předloktí způsobující, že dlaň a předloktí směřují dolů), což znamená, že dlaň je fixována směrem vzhůru. Omezení supinace/pronace se může vyskytovat v lokti (humeroradiální kloub), v zápěstí (radioulnární kloub) a kdekoli mezi nimi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A contracture that limits the ability of the forearm to stabilize the hand in pronation (pronation refers to a rotation of the forearm that causes the palm and forearm to face downwards), meaning that the palm is fixed in a upward orientation. Restriction of supination/pronation can occur at the elbow (radial-humeral joint), at the wrist (radial-ulnar joint), and anywhere in between.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034394"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Supinační kontraktura předloktí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Forearm supination contracture</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034395">
        <obo:IAO_0000115 xml:lang="cs">Kontraktura, která omezuje schopnost předloktí stabilizovat ruku v supinaci (supinací se rozumí rotace předloktí způsobující, že dlaň a předloktí směřují vzhůru), což znamená, že dlaň je fixována směrem dolů. Omezení supinace/pronace se může vyskytovat v lokti (humeroradiální kloub), v zápěstí (radioulnární kloub) a kdekoli mezi nimi</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pronační kontraktura předloktí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034395"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kontraktura, která omezuje schopnost předloktí stabilizovat ruku v supinaci (supinací se rozumí rotace předloktí způsobující, že dlaň a předloktí směřují vzhůru), což znamená, že dlaň je fixována směrem dolů. Omezení supinace/pronace se může vyskytovat v lokti (humeroradiální kloub), v zápěstí (radioulnární kloub) a kdekoli mezi nimi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A contracture that limits the ability of the forearm to stabilize the hand in supiation (supination refers to a rotation of the forearm that causes the palm and forearm to face upwards), meaning that the palm is fixed in a downward orientation. Restriction of supination/pronation can occur at the elbow (radial-humeral joint), at the wrist (radial-ulnar joint), and anywhere in between.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034395"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Pronační kontraktura předloktí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Forearm pronation contracture</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034396">
        <obo:IAO_0000115 xml:lang="cs">Hippokampální malrotace, také nazývaná neúplná inverze hipokampu nebo hipokampální malformace, je stále více uznávaným nálezem neurozobrazování s neurčeným klinickým významem. Vyznačuje se znaky včetně (i) ​​kulatého nebo pyramidálního tvaru místo vejčitého tvaru; (ii) Mediální poloha hipokampu na hipokampálním sulku; (iii) kolaterální sulcus je příliš hluboký nebo svislý; (iv) Fimbrie umístěná mediálně od hippocampu; (v) malý nebo posunutý fornix; (vi) Zvětšený temporální roh a prázdná choroidální štěrbina; (vii) zesílené subikulum; (viii) Snížená horní horizontální část parahipokampálního gyru.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Maltrotace hippocampu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034396"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Hippokampální malrotace, také nazývaná neúplná inverze hipokampu nebo hipokampální malformace, je stále více uznávaným nálezem neurozobrazování s neurčeným klinickým významem. Vyznačuje se znaky včetně (i) ​​kulatého nebo pyramidálního tvaru místo vejčitého tvaru; (ii) Mediální poloha hipokampu na hipokampálním sulku; (iii) kolaterální sulcus je příliš hluboký nebo svislý; (iv) Fimbrie umístěná mediálně od hippocampu; (v) malý nebo posunutý fornix; (vi) Zvětšený temporální roh a prázdná choroidální štěrbina; (vii) zesílené subikulum; (viii) Snížená horní horizontální část parahipokampálního gyru.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hippocampal malrotation, also termed incomplete inversion of the hippocampus or hippocampal malformation, is an increasingly recognized neuroimaging finding of undetermined clinical significance. It is characterized by features including (i) Round or pyramidal shape instead of ovoid shape; (ii) Medial position of the hippocampus on the hippocampal sulcus; (iii) The collateral sulcus is excessively deep or verticalized; (iv) Fimbria located medial to the hippocampus; (v) Small or displaced fornix; (vi) Enlarged temporal horn and empty choroid fissure; (vii) Thickened subiculum; (viii) Reduced upper horizontal portion of the parahippocampal gyrus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034396"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Maltrotace hippocampu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hippocampal malrotation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034397">
        <obo:IAO_0000115 xml:lang="cs">Drápovité prsty jsou charakterizovány hyperextenzí v metatarzofalangeálních kloubech a flexí v interfalangeálních kloubech</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Drápovité prsty nohy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034397"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Drápovité prsty jsou charakterizovány hyperextenzí v metatarzofalangeálních kloubech a flexí v interfalangeálních kloubech</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Claw toes are characterized by hyperextension at the metatarsal-phalangeal joints and flexion of the interphalangeal joints.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034397"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Drápovité prsty nohy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Claw toe deformity</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034398">
        <obo:IAO_0000115 xml:lang="cs">Abnormální postavení článků prstů na nohou. Deformace prstů se často objevují postupně, mohou však být způsobeny úrazem. Hlavní deformity v sagitální rovině u dospělých zahrnují drápovité prsty, kladívkovité prsty a paličkovité prsty. K deformitám v axiální rovině patří zkřížené prsty na nohou</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Deformita prstu nohy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034398"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální postavení článků prstů na nohou. Deformace prstů se často objevují postupně, mohou však být způsobeny úrazem. Hlavní deformity v sagitální rovině u dospělých zahrnují drápovité prsty, kladívkovité prsty a paličkovité prsty. K deformitám v axiální rovině patří zkřížené prsty na nohou</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal positioning of toe phalanges. Deformities of the lesser toes often occur gradually, though they can be brought on by trauma. The main adult sagittal plane deformities consist of claw toes, hammer toes and mallet toes. Axial plane deformities include crossover toes.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034398"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Deformita prstu nohy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Toe deformity</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034399">
        <obo:IAO_0000115 xml:lang="cs">Prodloužená doba centrálního motorického kondukčního času (CMCT). CMCT odhaduje dobu vedení kortikospinálních vláken mezi motorickou kůrou a spinálními (nebo bulbárními) motoneurony. Zahrnuje doby pro excitaci kortikálních buněk, vedení přes kortikobulbárně-kortikospinální trakt a excitaci motoneuronu dostatečné k dosažení prahu spouštění. CMCT se vypočítá odečtením doby periferního vedení od MEP latence zaznamenané po kortikální stimulaci</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Prodloužená doba vedení centrálního motoneuronu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034399"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Prodloužená doba centrálního motorického kondukčního času (CMCT). CMCT odhaduje dobu vedení kortikospinálních vláken mezi motorickou kůrou a spinálními (nebo bulbárními) motoneurony. Zahrnuje doby pro excitaci kortikálních buněk, vedení přes kortikobulbárně-kortikospinální trakt a excitaci motoneuronu dostatečné k dosažení prahu spouštění. CMCT se vypočítá odečtením doby periferního vedení od MEP latence zaznamenané po kortikální stimulaci</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased duration of the central motor conduction time (CMCT). The CMCT estimates the conduction time of corticospinal fibers between motor cortex and spinal (or bulbar) motoneurons. It includes the times for excitation of cortical cells, conduction via the corticobulbar-corticospinal tract and excitation of the motoneuron sufficient to reach its firing threshold. CMCT is calculated by subtracting the peripheral conduction time from the MEP latency recorded after cortical stimulation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034399"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Prodloužená doba vedení centrálního motoneuronu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Prolonged central motor conduction time</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034400">
        <obo:IAO_0000115 xml:lang="cs">Prstencovité rýhy v kůži končetin z důvodu ohybů nadbytečné kůže.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Obvodové kožní rýhy na končetinách</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034400"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Prstencovité rýhy v kůži končetin z důvodu ohybů nadbytečné kůže.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ringed creases of the skin of the extremities related to folding of excess skin.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034400"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Obvodové kožní rýhy na končetinách</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Circumferential skin creases on extremities</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034401">
        <obo:IAO_0000115 xml:lang="cs">Agresivní maligní embryonální tumor vycházející z centrálního nervového systému. Skládá se z buněk s velkým excentrickým jádrem, prominentním jadérkem a bohatou cytoplazmou. Přítomny jsou mutace genu SMARCB1 nebo velmi vzácně genu SMARCA4 (BRG1). Naprostá většina případů se vyskytuje v dětství. Příznaky zahrnují letargii, zvracení, obrnu hlavových nervů, bolest hlavy a hemiplegii.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Atypický teratoidní/rabdoidní nádor</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034401"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Agresivní maligní embryonální tumor vycházející z centrálního nervového systému. Skládá se z buněk s velkým excentrickým jádrem, prominentním jadérkem a bohatou cytoplazmou. Přítomny jsou mutace genu SMARCB1 nebo velmi vzácně genu SMARCA4 (BRG1). Naprostá většina případů se vyskytuje v dětství. Příznaky zahrnují letargii, zvracení, obrnu hlavových nervů, bolest hlavy a hemiplegii.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An aggressive malignant embryonal neoplasm arising from the central nervous system. It is composed of cells with a large eccentric nucleus, prominent nucleolus, and abundant cytoplasm. Mutations of the SMARCB1 gene or very rarely SMARCA4 (BRG1) gene are present. The vast majority of cases occur in childhood. Symptoms include lethargy, vomiting, cranial nerve palsy, headache, and hemiplegia.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034401"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Atypický teratoidní/rabdoidní nádor</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atypical teratoid/rhabdoid tumor</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034402">
        <obo:IAO_0000115 xml:lang="cs">Rabdoidní nádor vycházející z ledviny. Vyskytuje se u dětí a je spojen s abnormalitami chromozomu 22. Je charakterizován přítomností buněk s velkým excentrickým jádrem, prominujícím jadérkem a hojnou cytoplazmou.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Rabdoidní nádor ledviny</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034402"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Rabdoidní nádor vycházející z ledviny. Vyskytuje se u dětí a je spojen s abnormalitami chromozomu 22. Je charakterizován přítomností buněk s velkým excentrickým jádrem, prominujícím jadérkem a hojnou cytoplazmou.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A highly aggressive, extremely rare neoplasm of the kidney that is usually seen in children. The term rhabdoid is used because the tumor cells resemble rhabdomyoblasts but lack myogenic markers, and pathologic diagnosis requires familiarity with these microscopic features plus awareness that adult onset is possible. It can be associated with abnormalities of chromosome 22. It is characterized by the presence of cells with a large eccentric nucleus, prominent nucleolus, and abundant cytoplasm.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034402"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Rabdoidní nádor ledviny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Rhabdoid tumor of the kidney</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034403">
        <obo:IAO_0000115 xml:lang="cs">Forma T-buněčného non-Hodgkinského lymfomu, ve kterém cytotoxické CD8+ T buňky infiltrují tukovou tkáň a tvoří podkožní noduly.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Subkutánní panniculitis-like T-buněčný lymfom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034403"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Forma T-buněčného non-Hodgkinského lymfomu, ve kterém cytotoxické CD8+ T buňky infiltrují tukovou tkáň a tvoří podkožní noduly.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of T-cell non-Hodgkin lymphoma in which cytotoxic CD8+ T cells infiltrate adipose tissue forming subcutaneous nodules.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034403"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Subkutánní panniculitis-like T-buněčný lymfom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Subcutaneous panniculitis-like T-cell lymphoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034404">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost hyf (dlouhých, rozvětvených, vláknitých struktur vytvářených houbami) ve sputu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mykotické hyfy ve sputu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034404"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost hyf (dlouhých, rozvětvených, vláknitých struktur vytvářených houbami) ve sputu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Presence of hyphae (long, branching, filamentous structures produced by fungi) in sputum.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034404"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mykotické hyfy ve sputu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fungal hyphae in sputum</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034405">
        <obo:IAO_0000115 xml:lang="cs">Zvětšená velikost tekta, což je oblast mesencephalon za mozkovým akvaductus Sylvius. Mesencephalon je nejvyšší částí mozkového kmene.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvětšené tectum</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034405"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvětšená velikost tekta, což je oblast mesencephalon za mozkovým akvaductus Sylvius. Mesencephalon je nejvyšší částí mozkového kmene.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increasaed size of the tectum, which is the region of the midbrain posterior to the cerebral aqueduct of Sylvius. The midbrain is the most superior portion of the brainstem.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034405"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvětšené tectum</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Enlarged tectum</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
