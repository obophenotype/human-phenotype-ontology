        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009269">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně malá epifýza umístněná na proximálním konci proximálního falangu 4. prstu na ruce s ohledem na věkové normy</obo:IAO_0000115>
