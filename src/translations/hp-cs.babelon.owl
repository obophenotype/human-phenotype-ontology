        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Slonovinová epifýza proximálního falangu 3. prstu na ruce</owl:annotatedTarget>
