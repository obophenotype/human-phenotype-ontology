        <babelon:source_value>Increased urinary excretion of galactosyl hydroxylysine</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031992">
        <obo:IAO_0000115 xml:lang="cs">Apical hypertrophic cardiomyopathy (AHCM) is diastolic dysfunction due to abnormal stiffness of the left ventricle during diastole, with resultant impaired ventricular filling. In AHCM thickened apical segments produce a crowded, spade-shaped, small apical cavity</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Apikální hypertrofická kardiomyopatie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031992"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Apical hypertrophic cardiomyopathy (AHCM) is diastolic dysfunction due to abnormal stiffness of the left ventricle during diastole, with resultant impaired ventricular filling. In AHCM thickened apical segments produce a crowded, spade-shaped, small apical cavity</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Apical hypertrophic cardiomyopathy (AHCM) is diastolic dysfunction due to abnormal stiffness of the left ventricle during diastole, with resultant impaired ventricular filling. In AHCM thickened apical segments produce a crowded, spade-shaped, small apical cavity.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
