    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025350">
        <obo:IAO_0000115 xml:lang="cs">Konjunktivální papily s průměrem větším, než 1 milimeter. Charakteristicky mají oploštěnou horní čásť, která se někdy dá demonstrovat obarvením fluoresceinem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Obrovské konjunktivální papily</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025350"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Konjunktivální papily s průměrem větším, než 1 milimeter. Charakteristicky mají oploštěnou horní čásť, která se někdy dá demonstrovat obarvením fluoresceinem.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Conjunctival papillae with a diameter greater than 1 millimeter. They characteristically have flattened tops which sometimes demonstrate staining with fluorescein.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
