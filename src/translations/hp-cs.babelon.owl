    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000845">
        <obo:IAO_0000115 xml:lang="cs">Akromegalie je stav vyplývající z nadprodukce růstového hormonu hypofýzou u osob s uzavřenými epifýzami, vyznačuje se zvětšením akrálních (distálních) částí těla. Obvod lebky se zvětšuje, nos se stává široký, jazyk se zvětšuje, zhrubnou obličejové rysy, dolní čelist nadměrně roste čím se rozestoupí zuby. Prsty na rukách a na nohou hlavně do šířky</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená koncentrace cirkulujícího růstového hormonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000845"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Akromegalie je stav vyplývající z nadprodukce růstového hormonu hypofýzou u osob s uzavřenými epifýzami, vyznačuje se zvětšením akrálních (distálních) částí těla. Obvod lebky se zvětšuje, nos se stává široký, jazyk se zvětšuje, zhrubnou obličejové rysy, dolní čelist nadměrně roste čím se rozestoupí zuby. Prsty na rukách a na nohou hlavně do šířky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Acromegaly is a condition resulting from overproduction of growth hormone by the pituitary gland in persons with closed epiphyses, and consists chiefly in the enlargement of the distal parts of the body. The circumference of the skull increases, the nose becomes broad, the tongue becomes enlarged, the facial features become coarsened, the mandible grows excessively, and the teeth become separated. The fingers and toes grow chiefly in thickness.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000845"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená koncentrace cirkulujícího růstového hormonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elevated circulating growth hormone concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
