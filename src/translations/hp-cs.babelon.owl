        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034249"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neobvykle závažná infekce způsobená virem ifluenzy</owl:annotatedTarget>
