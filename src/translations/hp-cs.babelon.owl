    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010533">
        <obo:IAO_0000115 xml:lang="cs">Kombinace pendulárního nystagmu, kývání hlavou a tortikolis.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Spasmus nutans</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010533"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
