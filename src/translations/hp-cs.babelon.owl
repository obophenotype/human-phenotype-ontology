        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Klidový třes</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Resting tremor</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002323">
        <obo:IAO_0000115 xml:lang="cs">Anencefalie je vývojová anomálie charakterizovaná plodem bez kalvy, s chyběním většiny nebo celé mozkové tkáně plodu. Anencefalie patří do kolektivní skupiny známé jako defekty neurální trubice (NTD) a je důsledkem toho, že se neurální trubice během vývoje plodu neuzavírá na svém rostrálním konci.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Anencefalie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002323"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anencefalie je vývojová anomálie charakterizovaná plodem bez kalvy, s chyběním většiny nebo celé mozkové tkáně plodu. Anencefalie patří do kolektivní skupiny známé jako defekty neurální trubice (NTD) a je důsledkem toho, že se neurální trubice během vývoje plodu neuzavírá na svém rostrálním konci.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anencephaly is a developmental anomaly characterized by a fetus that has no calvarium, with a lack of most or all of the fetus&apos; brain tissue. Anencephaly belongs to a collective group known as neural tube defects (NTD) and is a result of the neural tube failing to close in its rostral end during fetal development.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002323"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Anencefalie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anencephaly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002324">
        <obo:IAO_0000115 xml:lang="cs">Vývojová vada mozku charakterizovaná nahrazením větších částí mozkových hemisfér a corpus striatum mozkomíšním mokem (CSF) a gliovou tkání</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hydranencefalie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002324"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vývojová vada mozku charakterizovaná nahrazením větších částí mozkových hemisfér a corpus striatum mozkomíšním mokem (CSF) a gliovou tkání</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A defect of development of the brain characterized by replacement of greater portions of the cerebral hemispheres and the corpus striatum by cerebrospinal fluid (CSF) and glial tissue.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
