    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500009">
        <obo:IAO_0000115 xml:lang="cs">Vzácný, pomalu rostoucí tumor cerebella, někdy považován za hamartom, charakterizovaný difúzní hypertrofí stratum granulare cerebella.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dysplastický gangliocytom mozku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500009"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vzácný, pomalu rostoucí tumor cerebella, někdy považován za hamartom, charakterizovaný difúzní hypertrofí stratum granulare cerebella.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>It is a rare, slowly growing tumor of the cerebellum, a gangliocytoma sometimes considered to be a hamartoma, characterized by diffuse hypertrophy of the granular layer of the cerebellum.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
