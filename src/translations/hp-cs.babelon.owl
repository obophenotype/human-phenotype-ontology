        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ inkomitantního strabismu, při kterém se úhel odchylky mění podle toho, jak se pohled pacienta posouvá nahoru a/nebo dolů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of incomitant strabismus in which the angle of deviation varies as the patient&apos;s gaze shifts upwards and/or downwards.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
