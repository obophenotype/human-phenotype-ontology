        <babelon:source_value>An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to bone.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
