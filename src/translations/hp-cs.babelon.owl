        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009921">
        <obo:IAO_0000115 xml:lang="cs">Stav spojený s omezením horizontálního pohybu oka s retrakcí očního bulbu a zúžením palpebrální štěrbiny při addukci.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Duanův syndrom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009921"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Stav spojený s omezením horizontálního pohybu oka s retrakcí očního bulbu a zúžením palpebrální štěrbiny při addukci.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A condition associated with a limitation of the horizontal ocular movement with retraction of the globe and narrowing of the palpebral fissure on adduction</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009921"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Duanův syndrom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Duane anomaly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009922">
        <obo:IAO_0000115 xml:lang="cs">Může přetrvávat hyaloidní tepna, což je embryonální tepna, která vede od disku zrakového nervu k zadnímu pouzdru čočky; místo úponu může tvořit zákal. Hyaloidní tepna je větví oftalmické tepny a obvykle zcela regreduje před narozením.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Cévní zbytek vycházející z disku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009922"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Může přetrvávat hyaloidní tepna, což je embryonální tepna, která vede od disku zrakového nervu k zadnímu pouzdru čočky; místo úponu může tvořit zákal. Hyaloidní tepna je větví oftalmické tepny a obvykle zcela regreduje před narozením.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Persistence of the hyaloid artery, which is the embryonic artery that runs from the optic disc to the posterior lens capsule may persist; the site of attachment may form an opacity. The hyaloid artery is a branch of the ophthalmic artery, and usually regresses completely before birth.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009922"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Cévní zbytek vycházející z disku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Vascular remnant arising from the disk</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009924">
