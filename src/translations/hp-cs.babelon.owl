        <babelon:source_value>Double outlet right ventricle with non-committed ventricular septal defect and pulmonary stenosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011654">
        <obo:IAO_0000115 xml:lang="cs">Dvojvýtoková pravá komora s defektem septa komor bez vztahu k velkým tepnám, tzv. non-commited typ defektu septa komor. Pulmonální stenóza není přítomna.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dvojvýtoková pravá komora s nekompletním defektem komorového septa bez plicní stenózy</rdfs:label>
