    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033784">
        <obo:IAO_0000115 xml:lang="cs">Jedná se o sdružený pojem který zahrnuje krátké kořeny se špičatými konci, taurodontismus a intrapulpální kalcifikace.</obo:IAO_0000115>
