        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal lip pigmentation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032454">
        <obo:IAO_0000115 xml:lang="cs">Plochá, odlišitelná, nesprávně zbarvená oblast na rtu o šířce menší než 1 cm nesouvisející se změnou tloušťky nebo struktury rtu.</obo:IAO_0000115>
