        <babelon:source_value>Capillary malformation of the lip</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031488">
        <obo:IAO_0000115 xml:lang="cs">Cévní malformace lokalizovaná ve rtu, která je charakterizována přímým krevním shuntem z tepny do žíly v důsledku absence kapilárního řečiště. Tepna a žíla mohou být přímo spojeny píštělí nebo nepřímo spojeny abnormálním cévním kanálem nazývaným nidus.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Arteriovenózní malformace rtu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031488"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Cévní malformace lokalizovaná ve rtu, která je charakterizována přímým krevním shuntem z tepny do žíly v důsledku absence kapilárního řečiště. Tepna a žíla mohou být přímo spojeny píštělí nebo nepřímo spojeny abnormálním cévním kanálem nazývaným nidus.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A vascular malformation located in the lip that is characterized by direct blood shunting from an artery to a vein due to the absence of a capillary bed. The artery and vein can be directly connected by a fistula or indirectly connected by an abnormal vessel channel termed a nidus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031488"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Arteriovenózní malformace rtu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Arteriovenous malformation of the lip</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031489">
