        <owl:annotatedTarget xml:lang="cs">Abnormálně malé epifýzy umístněné na distálním konci metakarpálních kostí s ohledem na věkové normy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormally small size of the epiphyses located at the distal end of the metacarpals in respect to age-dependent norms.</babelon:source_value>
