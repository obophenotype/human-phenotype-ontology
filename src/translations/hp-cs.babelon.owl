    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011477">
        <obo:IAO_0000115 xml:lang="cs">V primární poloze se oči pomalu pohybují směrem dolů a poté spontánně stoupají vzhůru. Pohled vzhůru zvýrazňuje nystagmus. Související oscilopsie jsou často velmi dráždivé, ale příznaky jsou obvykle přechodné.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Upbeat nystagmus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011477"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">V primární poloze se oči pomalu pohybují směrem dolů a poté spontánně stoupají vzhůru. Pohled vzhůru zvýrazňuje nystagmus. Související oscilopsie jsou často velmi dráždivé, ale příznaky jsou obvykle přechodné.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>In primary position, the eyes drift slowly downward and then spontaneously beat upward. Upward gaze accentuates the nystagmus. The associated oscillopsias are often very irritating, but the symptoms are usually transient.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011477"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Upbeat nystagmus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Upbeat nystagmus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011478">
        <obo:IAO_0000115 xml:lang="cs">Absence očního bulbu, zrakového nervu, chiasmatu a optických drah. Žádný důkaz oční tkáně na MRI skenu nebo vyšetření.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Skutečná anoftalmie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011478"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Absence očního bulbu, zrakového nervu, chiasmatu a optických drah. Žádný důkaz oční tkáně na MRI skenu nebo vyšetření.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of globe, optic nerve, chiasm and optic tracts. No evidence of ocular tissue on MRI scan or examination.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
