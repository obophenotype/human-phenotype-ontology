        <babelon:source_value>Long hallux</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001848">
        <obo:IAO_0000115 xml:lang="cs">Jedná se o posturální deformitu, při které je noha umístěna proti tibii. Pata (calcaneus) je umístěna směrem dolů (to znamená, že kotník je ohnutý nahoru) a pata je otočena ven (valgozita).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kalkaneovalgózní deformita</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001848"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jedná se o posturální deformitu, při které je noha umístěna proti tibii. Pata (calcaneus) je umístěna směrem dolů (to znamená, že kotník je ohnutý nahoru) a pata je otočena ven (valgozita).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>This is a postural deformity in which the foot is positioned up against the tibia. The heel (calcaneus) is positioned downward (that is, the ankle is flexed upward), and the heel is turned outward (valgus).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001848"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kalkaneovalgózní deformita</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Calcaneovalgus deformity</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001849">
        <obo:IAO_0000115 xml:lang="cs">Vývojová vada vedoucí k přítomnosti menšího než normálního počtu prstů na dolní končetině</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Oligodaktylie nohy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
