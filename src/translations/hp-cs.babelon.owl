        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Skleróza epifýz 4. prstu na ruce, vedoucí k zvýšené radioopacitě (bílý nebo slonovinový vzhled) na rentgenovém snímku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
