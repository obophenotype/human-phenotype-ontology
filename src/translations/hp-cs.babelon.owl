        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034211">
        <obo:IAO_0000115 xml:lang="cs">Typ fetálního intrakraniálního krvácení s krvácením do parenchymu (tkáně) mozku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fetální krvácení do mozkového parenchymu</rdfs:label>
    </rdf:Description>
