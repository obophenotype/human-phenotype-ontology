    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002723">
        <obo:IAO_0000115 xml:lang="cs">Absence fáze zvýšené metabolické aktivity, při níž se zvyšuje spotřeba kyslíku u neutrofilů, monocytů a makrofágů krátce po fagocytaci materiálu. Zvýšená spotřeba kyslíku vede k produkci peroxidu vodíku (H2O2), superoxidových aniontů a hydroxylových radikálů a to systémem závislým na NADH. Kyslíkové radikály se podílí na na mikrobiocidní aktivitě.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Absence baktericidního oxidačního dýchání ve fagocytech</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002723"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Absence fáze zvýšené metabolické aktivity, při níž se zvyšuje spotřeba kyslíku u neutrofilů, monocytů a makrofágů krátce po fagocytaci materiálu. Zvýšená spotřeba kyslíku vede k produkci peroxidu vodíku (H2O2), superoxidových aniontů a hydroxylových radikálů a to systémem závislým na NADH. Kyslíkové radikály se podílí na na mikrobiocidní aktivitě.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An absence of the phase of elevated metabolic activity, during which oxygen consumption increases, that occurs in neutrophils, monocytes, and macrophages shortly after phagocytosing material. An enhanced uptake of oxygen leads to the production, by an NADH dependent system, of hydrogen peroxide (H2O2), superoxide anions and hydroxyl radicals, which play a part in microbiocidal activity.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002723"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Absence baktericidního oxidačního dýchání ve fagocytech</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of bactericidal oxidative respiratory burst in phagocytes</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
