    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003067">
        <obo:IAO_0000115 xml:lang="cs">Anomálie související s částečným uzávěrem nebo selháním vývoje ulnární strany distální radiální růstové ploténky, která vede k zástavě epifyzárního růstu mediální a volární části distálního radia. To vede ke zkrácení radia a relativnímu přerůstání ulny</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Madelungova deformita</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003067"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomálie související s částečným uzávěrem nebo selháním vývoje ulnární strany distální radiální růstové ploténky, která vede k zástavě epifyzárního růstu mediální a volární části distálního radia. To vede ke zkrácení radia a relativnímu přerůstání ulny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly related to partial closure, or failure of development of the ulnar side of the distal radial growth plate, which results in an arrest of epiphyseal growth of the medial and volar portions of the distal radius. This leads to shortening of the radius and relative overgrowth of the ulna.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
