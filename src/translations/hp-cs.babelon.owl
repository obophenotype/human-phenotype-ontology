        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025546">
        <obo:IAO_0000115 xml:lang="cs">Odchylka od normálního rozmezí průměrného množství hemoglobinu na červenou krvinku (27 až 31 pikogramů/buňka). Snížený střední korpuskulární hemoglobin (MCH) může indikovat hypochromní anémii, ale MCH může být normální, pokud je snížen jak celkový hemoglobin, tak počet červených krvinek.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální střední množství hemoglobinu v erytrocytech</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025546"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Odchylka od normálního rozmezí průměrného množství hemoglobinu na červenou krvinku (27 až 31 pikogramů/buňka). Snížený střední korpuskulární hemoglobin (MCH) může indikovat hypochromní anémii, ale MCH může být normální, pokud je snížen jak celkový hemoglobin, tak počet červených krvinek.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deviation from the normal range of the average amount of hemoglobin per red blood cell (27 to 31 picograms/cell). A reduced mean corpuscular hemoglobin (MCH) may indicate a hypochromic anemia, but the MCH may be normal if both the total hemoglobin and the red blood cell count are reduced.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025546"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální střední množství hemoglobinu v erytrocytech</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal mean corpuscular hemoglobin concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025547">
        <obo:IAO_0000115 xml:lang="cs">Snížení normálního rozmezí průměrného množství hemoglobinu na červenou krvinku (27 až 31 pikogramů/buňka). Snížený střední korpuskulární hemoglobin (MCH) může indikovat hypochromní anémii, ale MCH může být normální, pokud je snížen jak celkový hemoglobin, tak počet červených krvinek.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížené střední množství hemoglobinu v erytrocytech</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025547"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížení normálního rozmezí průměrného množství hemoglobinu na červenou krvinku (27 až 31 pikogramů/buňka). Snížený střední korpuskulární hemoglobin (MCH) může indikovat hypochromní anémii, ale MCH může být normální, pokud je snížen jak celkový hemoglobin, tak počet červených krvinek.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduction from the normal range of the average amount of hemoglobin per red blood cell (27 to 31 picograms/cell). A reduced mean corpuscular hemoglobin (MCH) may indicate a hypochromic anemia, but the MCH may be normal if both the total hemoglobin and the red blood cell count are reduced.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025547"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Snížené střední množství hemoglobinu v erytrocytech</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased mean corpuscular hemoglobin concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025548">
        <obo:IAO_0000115 xml:lang="cs">Zvýšení průměrného množství hemoglobinu na červenou krvinku nad normální rozsah (27 až 31 pikogramů/buňka)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšené střední množství hemoglobinu v erytrocytech</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025548"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšení průměrného množství hemoglobinu na červenou krvinku nad normální rozsah (27 až 31 pikogramů/buňka)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An elevation over the normal range of the average amount of hemoglobin per red blood cell (27 to 31 picograms/cell).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025548"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšené střední množství hemoglobinu v erytrocytech</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased mean corpuscular hemoglobin concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025549">
        <obo:IAO_0000115 xml:lang="cs">Uniokulární stav, kdy je předmět fixován jiným bodem než foveou. Tento bod přebírá hlavní vizuální směr. Stupeň excentrické fixace je definován její vzdáleností od fovey ve stupních.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Excentrická vizuální fixace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025549"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Uniokulární stav, kdy je předmět fixován jiným bodem než foveou. Tento bod přebírá hlavní vizuální směr. Stupeň excentrické fixace je definován její vzdáleností od fovey ve stupních.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A uniocular condition in which there is fixation of an object by a point other than the fovea. This point adopts the principal visual direction. The degree of the eccentric fixation is defined by its distance from the fovea in degrees.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025549"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Excentrická vizuální fixace</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Eccentric visual fixation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025550">
        <obo:IAO_0000115 xml:lang="cs">Zvýšení koncentrace ribitolu v krvi nad normální hodnotu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená koncentrace cirkulujícího ribitolu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025550"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšení koncentrace ribitolu v krvi nad normální hodnotu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The concentration of ribitol in the blood circulation is above the upper limit of normal.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025550"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená koncentrace cirkulujícího ribitolu</owl:annotatedTarget>
