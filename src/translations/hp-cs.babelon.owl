    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025478">
        <obo:IAO_0000115 xml:lang="cs">Síňové zastavení srdeční činnosti nebo tiché atrium je vzácný stav projevující se absencí elektrické a mechanické aktivity v síních. Projevuje se absencí P vln, bradykardií a širokým QRS komplexem na elektrokardiogramu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Síňové zastavení srdeční činnosti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025478"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Síňové zastavení srdeční činnosti nebo tiché atrium je vzácný stav projevující se absencí elektrické a mechanické aktivity v síních. Projevuje se absencí P vln, bradykardií a širokým QRS komplexem na elektrokardiogramu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrial standstill or silent atrium is a rare condition presenting with the absence of electrical and mechanical activity in the atria. It presents with the absence of P waves, bradycardia, and wide QRS complex in the electrocardiogram.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
