        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>No pericardium is present on the righthand side of the heart. It is a congenital absence of pericardium rather than the result of a pericardectomy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
