        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Ventrální, laterální či ventrolaterální prohnutí těla a žaludu penisu o více než 30 stupňů</owl:annotatedTarget>
