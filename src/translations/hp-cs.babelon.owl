        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032890">
        <obo:IAO_0000115 xml:lang="cs">Fokální senzorický záchvat se somatosenzorickými projevy/fenomény, při kterém je vědomí v určitém okamžiku záchvatu částečně nebo úplně narušeno</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální senzorický záchvat se somatosenzorickými projevy /fenomény a s poruchou vědomí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032890"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální senzorický záchvat se somatosenzorickými projevy/fenomény, při kterém je vědomí v určitém okamžiku záchvatu částečně nebo úplně narušeno</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal sensory seizure with somatosensory features in which awareness is partially or fully impaired at some point during the seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032890"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální senzorický záchvat se somatosenzorickými projevy /fenomény a s poruchou vědomí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal impaired awareness sensory seizure with somatosensory features</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032891">
        <obo:IAO_0000115 xml:lang="cs">Fokální motorický verzivní záchvat charakterizovaný zachovaným vědomím po celou dobu záchvatu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální motorický verzivní záchvat bez poruchy vědomí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032891"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální motorický verzivní záchvat charakterizovaný zachovaným vědomím po celou dobu záchvatu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal motor seizure with version characterized by retained awareness throughout the seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032891"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální motorický verzivní záchvat bez poruchy vědomí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal aware motor seizure with version</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032892">
        <obo:IAO_0000115 xml:lang="cs">Záchvat spojený s předpokládanou nebo prokázanou infekcí (s výjimkou infekce centrálního nervového systému) nebo zánětlivým stavem bez alternativního původce, jako je metabolická porucha, a bez ohledu na přítomnost nebo nepřítomnost horečky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Záchvat spojený s infekcí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032892"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Záchvat spojený s předpokládanou nebo prokázanou infekcí (s výjimkou infekce centrálního nervového systému) nebo zánětlivým stavem bez alternativního původce, jako je metabolická porucha, a bez ohledu na přítomnost nebo nepřítomnost horečky.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Seizure associated with a presumed or proven infection (excluding infection of the central nervous system) or inflammatory state without an alternative precipitant such as metabolic derangement, and regardless of the presence or absence of a fever.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032892"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Záchvat spojený s infekcí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Infection-related seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032893">
        <obo:IAO_0000115 xml:lang="cs">Afebrilní (méně než 38,0 stupňů Celsia), krátké a generalizované záchvaty doprovázející gastroenteritidu bez alternativní příčiny.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Afebrilní záchvat spojený s gastrointestinální infekcí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032893"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Afebrilní (méně než 38,0 stupňů Celsia), krátké a generalizované záchvaty doprovázející gastroenteritidu bez alternativní příčiny.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Afebrile (less than 38.0 degrees Celcius), brief, and generalized seizures accompanying gastroenteritis without an alternative cause.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032893"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Afebrilní záchvat spojený s gastrointestinální infekcí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Gastroenteritis-related afebrile seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032894">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli forma záchvatu vyskytující se v době horečky (teplota 38,0 stupňů Celsia nebo vyšší) bez infekce centrálního nervového systému a bez alternativní příčiny, jako je těžká metabolická porucha, vyskytující se v jakémkoli věku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Záchvat vyvolaný horečnatou infekcí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032894"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoli forma záchvatu vyskytující se v době horečky (teplota 38,0 stupňů Celsia nebo vyšší) bez infekce centrálního nervového systému a bez alternativní příčiny, jako je těžká metabolická porucha, vyskytující se v jakémkoli věku.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any form of seizure occurring at the time of a fever (temperature at or above 38.0 degrees Celcius) without infection of the central nervous system, and without an alternative cause such as severe metabolic derangement, occurring at any age.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032894"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Záchvat vyvolaný horečnatou infekcí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Seizure precipitated by febrile infection</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032895">
        <obo:IAO_0000115 xml:lang="cs">Jakýkoli typ záchvatu (nyní často generalizovaný tonicko-klonický záchvat) vyskytující se s horečkou (alespoň 38,0 stupňů Celsia), ale bez infekce centrálního nervového systému, závažné metabolické poruchy nebo jiné alternativní příčiny u lidí mimo typické věkové rozmezí 3 měsíců -6 let a bez předchozí anamnézy afebrilních křečí.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Febrilní křeče mimo věk 3 měsíců až 6 let</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032895"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakýkoli typ záchvatu (nyní často generalizovaný tonicko-klonický záchvat) vyskytující se s horečkou (alespoň 38,0 stupňů Celsia), ale bez infekce centrálního nervového systému, závažné metabolické poruchy nebo jiné alternativní příčiny u lidí mimo typické věkové rozmezí 3 měsíců -6 let a bez předchozí anamnézy afebrilních křečí.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any type of seizure (most often a generalized tonic-clonic seizure) occurring with fever (at least 38.0 degrees Celsius) but in the absence of central nervous system infection, severe metabolic disturbance or other alternative precipitant in people beyond the typical arrange of 3 months-6 years with no prior history of afebrile seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032895"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Febrilní křeče mimo věk 3 měsíců až 6 let</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Febrile seizure outside the age of 3 months to 6 years</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032896">
        <obo:IAO_0000115 xml:lang="cs">Záchvat vyvolaný poslechem hudby nebo jiných komplexních zvuků</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hudbou vyvolaný záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032896"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Záchvat vyvolaný poslechem hudby nebo jiných komplexních zvuků</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Seizure precipitated by listening to music or other complex sounds.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032896"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hudbou vyvolaný záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Music-induced seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032897">
        <obo:IAO_0000115 xml:lang="cs">Fokální senzorický záchvat s chuťovými fenomény, při kterém je vědomí v určitém okamžiku záchvatu částečně nebo úplně narušeno</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální senzorický záchvat s chuťovými projevy/fenomény a s poruchou vědomí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032897"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální senzorický záchvat s chuťovými fenomény, při kterém je vědomí v určitém okamžiku záchvatu částečně nebo úplně narušeno</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal sensory seizure with gustatory features in which awareness is partially or fully impaired at some point during the seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032897"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální senzorický záchvat s chuťovými projevy/fenomény a s poruchou vědomí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal impaired awareness sensory seizure with gustatory features</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032898">
        <obo:IAO_0000115 xml:lang="cs">Fokální záchvat charakterizovaný na počátku koordinovanou motorickou aktivitou. To často připomíná dobrovolný pohyb a může sestávat z neadekvátního pokračování preiktální motorické aktivity</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální záchvat s automatismy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032898"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální záchvat charakterizovaný na počátku koordinovanou motorickou aktivitou. To často připomíná dobrovolný pohyb a může sestávat z neadekvátního pokračování preiktální motorické aktivity</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal seizure characterized at onset by coordinated motor activity. This often resembles a voluntary movement and may consist of an inappropriate continuation of preictal motor activity.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032898"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální záchvat s automatismy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal automatism seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032899">
        <obo:IAO_0000115 xml:lang="cs">Typ fokálního záchvatu a automatismy charakterizovaný orofaciálními automatismy na jeho počátku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální záchvat s orofaciálními automatismy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032899"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fokálního záchvatu a automatismy charakterizovaný orofaciálními automatismy na jeho počátku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of focal automatism seizure characterized by orofacial automatisms at onset.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032899"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální záchvat s orofaciálními automatismy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal orofacial automatism seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032900">
        <obo:IAO_0000115 xml:lang="cs">Typ fokálního záchvatu a automatismy charakterizovaný manuálními automatismy na jeho počátku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální záchvat s manuálními automatismy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032900"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fokálního záchvatu a automatismy charakterizovaný manuálními automatismy na jeho počátku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of focal automatism seizure characterized by manual automatisms at onset.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032900"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální záchvat s manuálními automatismy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal manual automatism seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032901">
        <obo:IAO_0000115 xml:lang="cs">Typ fokálního záchvatu s automatismy charakterizovaný koordinovanými bilaterálními nebo unilaterálními pohyby chodidel nebo nohou na počátku. Pohyby připomínají svou amplitudou spíše normální pohyby a jsou méně frenetické nebo rychlé ve srovnání s pohyby pozorovanými u fokálních hyperkinetických záchvatů zahrnujících nohy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální záchvat s pedálními automatismy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032901"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fokálního záchvatu s automatismy charakterizovaný koordinovanými bilaterálními nebo unilaterálními pohyby chodidel nebo nohou na počátku. Pohyby připomínají svou amplitudou spíše normální pohyby a jsou méně frenetické nebo rychlé ve srovnání s pohyby pozorovanými u fokálních hyperkinetických záchvatů zahrnujících nohy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of focal automatism seizure characterized by coordinated bilateral or unilateral movements of the feet or legs at onset. The movement is more reminiscent of normal movements in amplitude, and is less frenetic or rapid in comparison to the movements seen in focal hyperkinetic seizures involving the legs.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
