        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006518"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Podstatné zúžení nebo ucpání malých plicních žil v důsledku neorganizované hypertrofie hladkého svalstva a ukládání kolagenní matrix</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Substantial narrowing or blockage of small pulmonary veins as a result of disorganized smooth muscle hypertrophy and collagen matrix deposition.</babelon:source_value>
