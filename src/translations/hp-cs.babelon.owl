        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased platelet thromboxane A2 receptor</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031125">
        <obo:IAO_0000115 xml:lang="cs">Snížená koncentrace alfa-2A adrenergního receptoru v buněčné membráně, která je stimulována epinefrinem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížený destičkový alfa-2A-adrenergní receptor</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031125"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížená koncentrace alfa-2A adrenergního receptoru v buněčné membráně, která je stimulována epinefrinem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased cell membrane concentration of alpha-2A adrenergic receptor that is stimulated by epinephrine.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
