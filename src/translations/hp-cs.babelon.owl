    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010884">
        <obo:IAO_0000115 xml:lang="cs">Zkrácení končetin primárně postihující distální části končetin (ruce a chodidla) v srovnání s ostatními segmentami končetin</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Akromélie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010884"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zkrácení končetin primárně postihující distální části končetin (ruce a chodidla) v srovnání s ostatními segmentami končetin</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Shortening of the extremities affecting primarily the distal parts of the limbs (hands and feet) in relation to the other segments of the limbs.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
