        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011603">
        <obo:IAO_0000115 xml:lang="cs">Defekt nebo defekty morfogeneze aorty a pulmonálních arterií</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kongenitální malformace velkých tepen</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011603"/>
