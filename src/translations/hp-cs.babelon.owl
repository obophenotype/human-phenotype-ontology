        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal skinfold thickness measurement</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033171">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli odchylka od normálního rozmezí tloušťky tricepsové kožní řasy, která kvantifikuje množství podkožního tuku po stisknutí kůže pomocí specializovaných měřítek.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální tloušťka kožní řasy tricepsu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033171"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoli odchylka od normálního rozmezí tloušťky tricepsové kožní řasy, která kvantifikuje množství podkožního tuku po stisknutí kůže pomocí specializovaných měřítek.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any deviation from the normal range of the thickness of the triceps skinfold, which quantifies the amount of subcutaneous fat when the skin is pinched by specialized calipers.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
