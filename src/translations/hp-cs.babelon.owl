        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Bolest vyvolaná pohybem oka</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Eye movement-induced pain</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030858">
        <obo:IAO_0000115 xml:lang="cs">Opakující se vzorec chování, který je charakterizován neschopností odolat impulsu, pudu nebo pokušení provést čin, který je škodlivý pro danou osobu nebo pro ostatní. Opakované zapojení do tohoto chování nakonec narušuje fungování v jiných oblastech života.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Závislé chování</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030858"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Opakující se vzorec chování, který je charakterizován neschopností odolat impulsu, pudu nebo pokušení provést čin, který je škodlivý pro danou osobu nebo pro ostatní. Opakované zapojení do tohoto chování nakonec narušuje fungování v jiných oblastech života.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>When an activity, substance, object, or behavior becomes a major focus of a person&apos;s life, excluding other activities, or has begun to harm the individual or others physically, mentally, or socially, it can be considered addictive behavior. A person can become addicted or compulsively engaged with anything.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030858"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Závislé chování</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Addictive behavior</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
