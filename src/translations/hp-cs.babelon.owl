    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011873">
        <obo:IAO_0000115 xml:lang="cs">Abnormální počet krevních destiček na objem krve. U zdravých dospělých je normální počet trombocytů mezi 150 000 a 450 000 na mikrolitr krve</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální počet trombocytů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011873"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální počet krevních destiček na objem krve. U zdravých dospělých je normální počet trombocytů mezi 150 000 a 450 000 na mikrolitr krve</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal number of platelets per volume of blood. In a healthy adult, a normal platelet count is between 150,000 and 450,000 per microliter of blood.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
