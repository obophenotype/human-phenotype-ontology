        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031689">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost mikromegakaryocytů, s hylolobulací nebo bez lobulace jader megakaryocytů všech velikostí a s mnohočetnými široce oddělenými jádry.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dysplázie megakaryocytů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031689"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost mikromegakaryocytů, s hylolobulací nebo bez lobulace jader megakaryocytů všech velikostí a s mnohočetnými široce oddělenými jádry.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of micro-megakaryocytes, hypo-lobed, or non-lobed nuclei in megakaryocytes of all sizes and multiple, widely-separated nuclei.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
