        <owl:annotatedTarget xml:lang="cs">Podtřída lupusové nefritidy s nejméně 90 % glomerulů globálně sklerotizovaných bez zbytkové aktivity</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A subclass of lupus nephritis with at least 90% of glomeruli globally sclerosed without residual activity.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
