        <owl:annotatedTarget xml:lang="cs">Elastická vlákna v dermis vykazují zvýšený počet zlomů spojených s dezorganizací struktury elastických vláken</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
