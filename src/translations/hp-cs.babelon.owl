        <babelon:source_value>Prominent supraorbital ridges</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000337">
        <obo:IAO_0000115 xml:lang="cs">Šířka čela, respektive vzdálenost dvou frontotemporale bodů větší než 2 SD. Alternativně, očividně široké čelo</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Široké čelo</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000337"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Šířka čela, respektive vzdálenost dvou frontotemporale bodů větší než 2 SD. Alternativně, očividně široké čelo</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Width of the forehead or distance between the frontotemporales is more than two standard deviations above the mean (objective); or apparently increased distance between the two sides of the forehead.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
