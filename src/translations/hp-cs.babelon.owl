        <owl:annotatedTarget xml:lang="cs">Abnormalita štítné žlázy způsobená přítomností fibrózní cysty, která je výsledkem perzistence tyreoglosálního vývodu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the thyroid gland owing to the presence of a fibrous cyst resulting from the persistence of the thyroglossal duct.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
