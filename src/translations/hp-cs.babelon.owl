        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Závažná infekce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Severe infection</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032170">
        <obo:IAO_0000115 xml:lang="cs">Neobvykle závažná forma infekce virem Varicella zoster (VZV). Ve většině případů, zejména u dětí, je varicella velmi mírnou infekcí charakterizovanou kožními lézemi, nízkou horečkou a malátností. Těžká infekce je charakterizována projevy zahrnujícími VZV pneumonii, hepatitidu, meningitidu a diseminovanou varicellu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Těžká infekce virem Varicella Zoster</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032170"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neobvykle závažná forma infekce virem Varicella zoster (VZV). Ve většině případů, zejména u dětí, je varicella velmi mírnou infekcí charakterizovanou kožními lézemi, nízkou horečkou a malátností. Těžká infekce je charakterizována projevy zahrnujícími VZV pneumonii, hepatitidu, meningitidu a diseminovanou varicellu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An unusually severe form of varicella zoster virus (VZV) infection. In the majority of the cases, especially in children, varicella is a very mild infection characterized by skin lesions, low grade fever and malaise. Severe infection is characterized by manifestations including VZV pneumonia, hepatitis, meningitis, and disseminated varicella.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032170"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Těžká infekce virem Varicella Zoster</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Severe varicella zoster infection</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032171">
        <obo:IAO_0000115 xml:lang="cs">Nepříjemný pocit charakterizovaný fyzickým diskomfortem (jako je píchání, pulzování nebo bolest) lokalizovaný v močovém měchýři. Bolest močového měchýře může být výraznější při plném močovém měchýři a zmírnit se při močení, ale není tomu tak vždy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Bolest v oblasti močového měchýře</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032171"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nepříjemný pocit charakterizovaný fyzickým diskomfortem (jako je píchání, pulzování nebo bolest) lokalizovaný v močovém měchýři. Bolest močového měchýře může být výraznější při plném močovém měchýři a zmírnit se při močení, ale není tomu tak vždy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the urinary bladder. Bladder pain may be more pronounced with a full bladder and relieved upon urination, but this is not always the case.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032171"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Bolest v oblasti močového měchýře</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bladder pain</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032172">
        <obo:IAO_0000115 xml:lang="cs">Srpek vzduchu obklopující masu měkkých tkání v plicní dutině a lze jej vidět jak na prostém rentgenovém snímku, tak na CT skenu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Air-crescent sign</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032172"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Srpek vzduchu obklopující masu měkkých tkání v plicní dutině a lze jej vidět jak na prostém rentgenovém snímku, tak na CT skenu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A crescent of air surrounding a soft-tissue mass in a pulmonary cavity and can be seen in both plain X-ray and CT scan</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032172"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Air-crescent sign</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>obsolete Air crescent sign</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032173">
        <obo:IAO_0000115 xml:lang="cs">Tento příznak je pozorován u pseudomediastina, kdy je vzduch zadržován mezi dolním okrajem srdce a horní částí bránice, což se projevuje úplnou viditelností bránice na rentgenovém snímku, proto se nazývá příznakem kontinuální bránice</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Příznak kontinuální bránice</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032173"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Tento příznak je pozorován u pseudomediastina, kdy je vzduch zadržován mezi dolním okrajem srdce a horní částí bránice, což se projevuje úplnou viditelností bránice na rentgenovém snímku, proto se nazývá příznakem kontinuální bránice</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>This sign is seen in pneumomediastinum in which air accumulates between the lower border of the heart and the superior part of the diaphragm, which results in complete visualization of the diaphragm in chest X-ray, hence named continuous diaphragm sign.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032173"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Příznak kontinuální bránice</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Continuous diaphragm sign</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032174">
        <obo:IAO_0000115 xml:lang="cs">Změny vzhledu kvetoucího stromu představují centrilobulární větvené struktury, které připomínají pučící strom. Tneto nález odráží spektrum endo- a peribronchiolárních poruch, včetně mukoidní impakce, zánětu a/nebo fibrózy (viz obrázek 70 PMID:18195376)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Změny vzhledu kvetoucího stromu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032174"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Změny vzhledu kvetoucího stromu představují centrilobulární větvené struktury, které připomínají pučící strom. Tneto nález odráží spektrum endo- a peribronchiolárních poruch, včetně mukoidní impakce, zánětu a/nebo fibrózy (viz obrázek 70 PMID:18195376)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The tree-in-bud pattern represents centrilobular branching structures that resemble a budding tree. The pattern reflects a spectrum of endo- and peribronchiolar disorders, including mucoid impaction, inflammation, and/or fibrosis (See Figure 70 of PMID:18195376).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032174"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Změny vzhledu kvetoucího stromu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tree-in-bud pattern</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032175">
        <obo:IAO_0000115 xml:lang="cs">Tento nález se skládá z prstencovité opacity reprezentujícího dilatovaný bronchus v příčném řezu a menší přilehlé opacity reprezentující jeho plicní tepnu, přičemž kombinace připomíná pečetní (nebo perlový) prsten. Je základním znakem bronchiektázie plic na smínku z výpočné tomografie (CT).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Příznak pečetního prstenu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032175"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Tento nález se skládá z prstencovité opacity reprezentujícího dilatovaný bronchus v příčném řezu a menší přilehlé opacity reprezentující jeho plicní tepnu, přičemž kombinace připomíná pečetní (nebo perlový) prsten. Je základním znakem bronchiektázie plic na smínku z výpočné tomografie (CT).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>This finding is composed of a ring-shaped opacity representing a dilated bronchus in cross section and a smaller adjacent opacity representing its pulmonary artery, with the combination resembling a signet (or pearl) ring. It is the basic sign of bronchiectasis in pulmonary computed tomography imaging.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032175"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Příznak pečetního prstenu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Signet ring sign</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032176">
        <obo:IAO_0000115 xml:lang="cs">Apikální čepička je léze na vrcholu plic, obvykle způsobená intrapulmonální a pleurální fibrózou stahující extrapleurální tuk nebo způsobená chronickou ischemií vedoucí k tvorbě hyalinního plaku na viscerální pleuře. Prevalence se zvyšuje s věkem. Může být také pozorován u hematomu vzniklého v důsledku prasknutí aorty nebo v případě jiné nahromaděné tekutiny spojené s infekcí nebo nádorem, buď mimo parietální pleuru nebo lokalizované v pleurálním prostoru.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Apikální plicní opacita</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032176"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Apikální čepička je léze na vrcholu plic, obvykle způsobená intrapulmonální a pleurální fibrózou stahující extrapleurální tuk nebo způsobená chronickou ischemií vedoucí k tvorbě hyalinního plaku na viscerální pleuře. Prevalence se zvyšuje s věkem. Může být také pozorován u hematomu vzniklého v důsledku prasknutí aorty nebo v případě jiné nahromaděné tekutiny spojené s infekcí nebo nádorem, buď mimo parietální pleuru nebo lokalizované v pleurálním prostoru.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An apical cap is a caplike lesion at the lung apex, usually caused by intrapulmonary and pleural fibrosis pulling down extrapleural fat or possibly by chronic ischemia resulting in hyaline plaque formation on the visceral pleura. The prevalence increases with age. It can also be seen in hematoma resulting from aortic rupture or in other fluid collection associated with infection or tumor, either outside the parietal pleura or loculated within the pleural space.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032176"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Apikální plicní opacita</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Apical pulmonary opacity</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032177">
        <obo:IAO_0000115 xml:lang="cs">Konsolidate odkazuje na stav, kdy exudát či jiný produkt nemoci nahradí alveolární vzduch a plíce se tak jeví jako souvislá hmota (např. při infekční pneumonii)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Konsolidace parenchymu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032177"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Konsolidate odkazuje na stav, kdy exudát či jiný produkt nemoci nahradí alveolární vzduch a plíce se tak jeví jako souvislá hmota (např. při infekční pneumonii)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Consolidation refers to an exudate or other product of disease that replaces alveolar air, rendering the lung solid (as in infective pneumonia).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032177"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Konsolidace parenchymu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Parenchymal consolidation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032178">
        <obo:IAO_0000115 xml:lang="cs">Dermatóza charakterizovaná generalizovanými lesklými, sklovitými, hyperpigmentovanými šupinami v nepravidelném vzoru. Šupiny se mohou odlupovat nebo deskvamovat, spíše jako stará, sluncem spálená puchýřovitá barva, často s oblastmi základní hypopigmentace. To vedlo k označení odlupující se barva nebo šupinatá dermatóza (viz obrázek v PMID:24285001).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Flaky paint dermatóza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032178"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Dermatóza charakterizovaná generalizovanými lesklými, sklovitými, hyperpigmentovanými šupinami v nepravidelném vzoru. Šupiny se mohou odlupovat nebo deskvamovat, spíše jako stará, sluncem spálená puchýřovitá barva, často s oblastmi základní hypopigmentace. To vedlo k označení odlupující se barva nebo šupinatá dermatóza (viz obrázek v PMID:24285001).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A dermatosis characterized by generalized shiny, enamel-like, hyperpigmented scales in an irregular pattern. The scales may peel or desquamate, rather like old, sun-baked blistered paint, often with areas of underlying hypopigmentation. This has led to the terms peeling paint or flaky paint dermatosis (See the Figure in PMID:24285001).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032178"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Flaky paint dermatóza</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Flaky paint dermatosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032179">
        <obo:IAO_0000115 xml:lang="cs">Abnormální koncentrace globulinů v krvi. Albumin tvoří více než polovinu celkového proteinu přítomného v séru. Zbývající krevní proteiny kromě albuminu a fibrinogenu (který není v séru) se označují jako globuliny. Globulinová frakce zahrnuje stovky sérových proteinů včetně vazných proteinů, enzymů, komplementu a imunoglobulinů. Většina z nich je syntetizována v játrech, ačkoli imunoglobuliny jsou syntetizovány plazmatickými buňkami. Globuliny se elektroforézou dělí do čtyř skupin. Čtyři frakce jsou alfa1, alfa2, beta a gama v závislosti na jejich migračním vzoru mezi anodou a katodou.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální koncentrace cirkulujících globulinů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032179"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální koncentrace globulinů v krvi. Albumin tvoří více než polovinu celkového proteinu přítomného v séru. Zbývající krevní proteiny kromě albuminu a fibrinogenu (který není v séru) se označují jako globuliny. Globulinová frakce zahrnuje stovky sérových proteinů včetně vazných proteinů, enzymů, komplementu a imunoglobulinů. Většina z nich je syntetizována v játrech, ačkoli imunoglobuliny jsou syntetizovány plazmatickými buňkami. Globuliny se elektroforézou dělí do čtyř skupin. Čtyři frakce jsou alfa1, alfa2, beta a gama v závislosti na jejich migračním vzoru mezi anodou a katodou.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any deviation from the normal concentration of globulins in the blood circulation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032179"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální koncentrace cirkulujících globulinů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal circulating globulin concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032180">
        <obo:IAO_0000115 xml:lang="cs">Abnormální hladina analytu měřeného v krvi</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální koncentrace cirkulujících metabolitů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032180"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální hladina analytu měřeného v krvi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal level of an analyte measured in the blood.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032180"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální koncentrace cirkulujících metabolitů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal circulating metabolite concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032181">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita hepatických žil, které normálně odvádějí deoxygenovanu krev z jater do vena cava inferior, v tomto případě ale hepatické žíly ústí do levé síně</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Anomální vyústění hepatických žil do levé síně</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032181"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita hepatických žil, které normálně odvádějí deoxygenovanu krev z jater do vena cava inferior, v tomto případě ale hepatické žíly ústí do levé síně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the hepatic veins, which normally drain de-oxygenated blood from the liver into the inferior vena cava, whereby the hepatic veins drain into the left atrium.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032181"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Anomální vyústění hepatických žil do levé síně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anomalous hepatic venous drainage into the left atrium</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032182">
        <obo:IAO_0000115 xml:lang="cs">Abnormální podíl paměťových T-buněk v porovnání s celkovým počtem T-buněk v krvi. Paměťové T-lymfocyty se již dříve setkaly s antigenem a reagovaly na něj a při opakovaném setkání s antigenem mohou reagovat rychleji a silněji.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální podíl paměťových T-buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032182"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální podíl paměťových T-buněk v porovnání s celkovým počtem T-buněk v krvi. Paměťové T-lymfocyty se již dříve setkaly s antigenem a reagovaly na něj a při opakovaném setkání s antigenem mohou reagovat rychleji a silněji.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal proportion of memory T cells compared to the total number of T cells in the blood. Memory T cells have previously encountered and responded to their cognate antigen and upon a repeated encounter with the antigen can mount a faster and stronger response.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032182"/>
