        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bronchitis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012388">
        <obo:IAO_0000115 xml:lang="cs">Zánět velkých dýchacích cest v plicích s rychlým nástupem a krátkým průběhem, obvykle spojený s kašlem, tvorbou hlenu, dušností, sípáním a pocitem tlaku na hrudi</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Akutní bronchitida</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012388"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zánět velkých dýchacích cest v plicích s rychlým nástupem a krátkým průběhem, obvykle spojený s kašlem, tvorbou hlenu, dušností, sípáním a pocitem tlaku na hrudi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inflammation of the large airways of the lung with rapid onset and short course usually associated with cough, mucus production, shortness of breath, wheezing, and chest tightness.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
