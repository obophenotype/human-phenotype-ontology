        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030760">
        <obo:IAO_0000115 xml:lang="cs">Fibróza ledvin je důsledkem nadměrné akumulace extracelulární matrix, která se vyskytuje prakticky ve všech typech chronických onemocnění ledvin</obo:IAO_0000115>
