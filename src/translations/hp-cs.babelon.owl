    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009648">
        <obo:IAO_0000115 xml:lang="cs">Distální falanga palce na ruce trojúhelníkového tvaru. Trojúhelníková nebo takzvaná deltová falanga vzniká důsledkem epifýzy ve tvaru písmena C postižené falangy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Trojúhelníková distální falanga palce na ruce</rdfs:label>
    </rdf:Description>
