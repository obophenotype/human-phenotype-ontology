    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033887">
        <obo:IAO_0000115 xml:lang="cs">Amorfní extracelulární látka v glomerulárních, intersticiálních nebo vaskulárních kompartmentech arteriae interlobulares ledvin. Barví se pozitivně konžskou červení s typicky jablkově zeleným dvojlomem na polarizační mikroskopii a fibrilami 8-12 nm širokými v elektronové mikroskopii.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Amyloidóza intimy/medie arteria corticalis radiata</rdfs:label>
    </rdf:Description>
