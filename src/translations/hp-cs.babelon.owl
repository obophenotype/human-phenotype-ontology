        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010288"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita sublinguálníc slinných žlaz, které se nacházejí pod spodinou dutiny ústní, anteriorně od submandibulárních žlaz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
