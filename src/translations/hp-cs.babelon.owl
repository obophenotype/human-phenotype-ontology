    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030122">
        <obo:IAO_0000115 xml:lang="cs">Imunohistochemie prokazuje ve svalové biopsii snížení množství perlekanu. Perlekan je protein specifický pro bazální membránu, konkrétně heparan sulfátový proteoglykan (HSPG) , známý také jako heparan sulfátový proteoglykan 2 (HSPG2).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížený svalový perlekan</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030122"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Imunohistochemie prokazuje ve svalové biopsii snížení množství perlekanu. Perlekan je protein specifický pro bazální membránu, konkrétně heparan sulfátový proteoglykan (HSPG) , známý také jako heparan sulfátový proteoglykan 2 (HSPG2).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Immunohistochemistry reveals reduced perlecan protein in the muscle biopsy. Perlecan is a basement membrane-specific heparan sulfate proteoglycan core protein (HSPG) also known as heparan sulfate proteoglycan 2 (HSPG2).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
