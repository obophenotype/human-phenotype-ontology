    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032684">
        <obo:IAO_0000115 xml:lang="cs">Fokální kognitivní záchvat se sluchovou agnózií charakterizovaný zachovaným vědomím po celou dobu záchvatu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kognitivní záchvat se sluchovou agnosií bez poruchy vědomí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032684"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kognitivní záchvat se sluchovou agnózií charakterizovaný zachovaným vědomím po celou dobu záchvatu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal cognitive seizure with auditory agnosia characterized by retained awareness throughout the seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
