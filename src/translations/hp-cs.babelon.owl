    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007872">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost mnohočetných hemangiomů cévnatky (choroidey). Obvykle jsou načervenalé nebo oranžové nebo mohou mít zvýšenou pigmentaci, takže je obtížné je odlišit od choroidálních melanomů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Choroidální hemangiom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
