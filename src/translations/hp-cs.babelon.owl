        <babelon:source_value>Retinopathy of prematurity prethreshold</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500066">
        <obo:IAO_0000115 xml:lang="cs">Rozdíl mezi celkovou a manifestní krátkozrakostí.</obo:IAO_0000115>
