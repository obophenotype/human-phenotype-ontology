        <owl:annotatedTarget xml:lang="cs">Vzácná cévní anomálie s přímou komunikací mezi arteria pulmonalis a vena pulmonalis bez mezilehlého kapilárního řečiště.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A rare vascular anomaly with a direct communication between pulmonary artery and pulmonary vein without an intervening capillary bed.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
