    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011638">
        <obo:IAO_0000115 xml:lang="cs">Levá hlavní koronární tepna začíná (odbočuje) z plicní tepny, nikoli jako obvykle z kořene aorty, nad levým cípem aortální chlopně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Anomální původ levé koronární tepny z plicní tepny</rdfs:label>
