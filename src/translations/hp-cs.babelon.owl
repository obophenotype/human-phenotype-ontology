    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003396">
        <obo:IAO_0000115 xml:lang="cs">Dilatovaná, gliami lemovaná dutina v míše. Tato dutina nekomunikuje s centrálním kanálem a obvykle se vyskytuje mezi columnae posteriores jednostranně nebo oboustranně podél strany míchy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Syringomyelie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003396"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Dilatovaná, gliami lemovaná dutina v míše. Tato dutina nekomunikuje s centrálním kanálem a obvykle se vyskytuje mezi columnae posteriores jednostranně nebo oboustranně podél strany míchy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dilated, glial-lined cavity in spinal cord. This cavity does not communicate with the central canal, and usually is between the dorsal columns unilaterally or bilaterally along the side of the cord.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
