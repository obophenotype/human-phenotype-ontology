    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032509">
        <obo:IAO_0000115 xml:lang="cs">Onychotillománie je charakterizována nutkavou nebo neodolatelnou potřebou pacientů trhat, strhávat nebo škodlivě kousat či žvýkat nehty.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Onychotillománie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032509"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Onychotillománie je charakterizována nutkavou nebo neodolatelnou potřebou pacientů trhat, strhávat nebo škodlivě kousat či žvýkat nehty.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Onychotillomania is characterized by the compulsive or irresistible urge in patients to pick at, pull off, or harmfully bite or chew their nails.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
