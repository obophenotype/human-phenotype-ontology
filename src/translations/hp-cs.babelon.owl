        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032010">
        <obo:IAO_0000115 xml:lang="cs">Trvalá exotropie do blízka i do dálky, projevující se po 6 měsících věku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Základní konstantní exotropie</rdfs:label>
