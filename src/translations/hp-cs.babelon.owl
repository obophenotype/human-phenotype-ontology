    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000556">
        <obo:IAO_0000115 xml:lang="cs">Retinální dystrofie je dědičně podmíněná abnormalita retiny. Retinální dystrofie jsou definovány převážně monogenní dědičností a často jsou spojeny se ztrátou nebo dysfunkcí fotoreceptorových buněk či už primárně nebo až sekundárně</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Retinální dystrofie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000556"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Retinální dystrofie je dědičně podmíněná abnormalita retiny. Retinální dystrofie jsou definovány převážně monogenní dědičností a často jsou spojeny se ztrátou nebo dysfunkcí fotoreceptorových buněk či už primárně nebo až sekundárně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinal dystrophy is an abnormality of the retina associated with a hereditary process. Retinal dystrophies are defined by their predominantly monogenic inheritance and they are frequently associated with loss or dysfunction of photoreceptor cells as a primary or secondary event.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000556"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Retinální dystrofie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinal dystrophy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000557">
        <obo:IAO_0000115 xml:lang="cs">Zvětšení celého očního bulbu v důsledku zvýšeného nitroočního tlaku</obo:IAO_0000115>
