        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Paroxyzmální komorová tachykardie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Paroxysmal ventricular tachycardia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004752">
        <obo:IAO_0000115 xml:lang="cs">Forma atrioventrikulární (AV) disociace (tj., atria a komory jsou pod kontrolou dvou samostatných pacemakrů) s vrozeným nástupem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kongenitální atrioventrikulární disociace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004752"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Forma atrioventrikulární (AV) disociace (tj., atria a komory jsou pod kontrolou dvou samostatných pacemakrů) s vrozeným nástupem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of atrioventricular (AV) dissociation (i.e., the atria and the ventricles are under the control of two separate pacemakers) with congenital onset.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004752"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kongenitální atrioventrikulární disociace</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Congenital atrioventricular dissociation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004754">
        <obo:IAO_0000115 xml:lang="cs">FS, kterou nelze úspěšně ukončit kardioverzí, a dlouhotrvající (více než 1 rok) FS, kdy kardioverze není indikována nebo se o ni nepokusili, se označuje jako trvalá</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Permanentní síňová fibrilace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004754"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">FS, kterou nelze úspěšně ukončit kardioverzí, a dlouhotrvající (více než 1 rok) FS, kdy kardioverze není indikována nebo se o ni nepokusili, se označuje jako trvalá</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrial fibrillation (AF) that cannot be successfully terminated by cardioversion, and longstanding (more than 1 year) AF, where cardioversion is not indicated or has not been attempted, is termed permanent.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004754"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Permanentní síňová fibrilace</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Permanent atrial fibrillation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004755">
        <obo:IAO_0000115 xml:lang="cs">Supraventrikulární tachykardie (SVT) je abnormálně zvýšená srdeční frekvence (přes 100 tepů za minutu v klidu) s původem nad úrovní komor</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Supraventrikulární tachykardie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004755"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Supraventrikulární tachykardie (SVT) je abnormálně zvýšená srdeční frekvence (přes 100 tepů za minutu v klidu) s původem nad úrovní komor</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Supraventricular tachycardia (SVT) is an abnormally increased heart rate (over 100 beats per minute at rest) with origin above the level of the ventricles.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004755"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Supraventrikulární tachykardie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Supraventricular tachycardia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004756">
        <obo:IAO_0000115 xml:lang="cs">Tachykardie pocházející z komor charakterizovaná rychlou srdeční frekvencí (nad 100 tepů za minutu) a širokými komplexy QRS (nad 120 ms)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Komorová tachykardie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004756"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Tachykardie pocházející z komor charakterizovaná rychlou srdeční frekvencí (nad 100 tepů za minutu) a širokými komplexy QRS (nad 120 ms)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A tachycardia originating in the ventricles characterized by rapid heart rate (over 100 beats per minute) and broad QRS complexes (over 120 ms).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004756"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Komorová tachykardie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ventricular tachycardia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004757">
        <obo:IAO_0000115 xml:lang="cs">Epizody síňové fibrilace které typicky trvají od několika hodin do jednoho dne a ustupují náhle</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Paroxyzmální síňová fibrilace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004757"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Epizody síňové fibrilace které typicky trvají od několika hodin do jednoho dne a ustupují náhle</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Episodes of atrial fibrillation that typically last for several hours up to one day and terminate spontaneously.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004757"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Paroxyzmální síňová fibrilace</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Paroxysmal atrial fibrillation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004758">
        <obo:IAO_0000115 xml:lang="cs">Polymorfní ventrikulární arytmie různé morfologie, které neexistují za klidových podmínek, ale objevují se pouze při fyzické námaze nebo podání katecholaminů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Námahou vyvolané polymorfní ventrikulární tachykardie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004758"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Polymorfní ventrikulární arytmie různé morfologie, které neexistují za klidových podmínek, ale objevují se pouze při fyzické námaze nebo podání katecholaminů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Polymorphic ventricular arrhythmias of varying morphologythat do not exist under resting conditions but appear only upon physical exercise or catecholamine administration.</babelon:source_value>
