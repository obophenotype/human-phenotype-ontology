        <owl:annotatedTarget xml:lang="cs">Interpupilární vzdálenost více než 2 SD. Alternativně, očividně zvětšená interpupilární vzdálenost či daleko od sebe posazené oči</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Interpupillary distance more than 2 SD above the mean (alternatively, the appearance of an increased interpupillary distance or widely spaced eyes).</babelon:source_value>
