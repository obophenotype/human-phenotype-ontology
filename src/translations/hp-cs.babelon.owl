        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033362">
        <obo:IAO_0000115 xml:lang="cs">Opakovaný výskyt epizod kašle, přičemž každá epizoda trvá nejméně pět minut nepřetržitého kašle.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Recidivující křeče při kašli</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033362"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Opakovaný výskyt epizod kašle, přičemž každá epizoda trvá nejméně pět minut nepřetržitého kašle.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Repeated occurrence of episodes of coughing, with each episode consisting of at least five minutes of continuous coughing.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033362"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Recidivující křeče při kašli</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Recurrent coughing spasms</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033363">
        <obo:IAO_0000115 xml:lang="cs">Hyalinní membrány jsou homogenní eozinofilní materiál složený z buněčných zbytků, plazmatických proteinů a surfaktantu, který je připevněn k alveolárním kanálkům a alveolárním stěnám. Hyalinní membrány se ukládají podél stěn alveolů, kde obvykle dochází k výměně plynů, a tím ztěžují výměnu plynů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hyalinní membrány</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033363"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Hyalinní membrány jsou homogenní eozinofilní materiál složený z buněčných zbytků, plazmatických proteinů a surfaktantu, který je připevněn k alveolárním kanálkům a alveolárním stěnám. Hyalinní membrány se ukládají podél stěn alveolů, kde obvykle dochází k výměně plynů, a tím ztěžují výměnu plynů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hyaline membranes are homogeneous eosinophilic material composed of cellular debris, plasma proteins, and surfactant plastered against alveolar ducts and alveolar walls. The hyaline membranes are deposited along the walls of the alveoli, where gas exchange typically occurs, thereby making gas exchange difficult.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033363"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hyalinní membrány</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hyaline membranes</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033364">
        <obo:IAO_0000115 xml:lang="cs">Specifická forma plicního zánětu, která je důsledkem hromadění lipidů v plicních sklípcích. Lipoidní pneumonie může mít exogenní nebo endogenní příčinu podle zdroje lipidů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Lipoidní pneumonie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033364"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Specifická forma plicního zánětu, která je důsledkem hromadění lipidů v plicních sklípcích. Lipoidní pneumonie může mít exogenní nebo endogenní příčinu podle zdroje lipidů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A specific form of lung inflammation that results from accumulation of lipids in the alveoli. Lipoid pneumonia can be either exogenous or endogenous in cause based on the source of the lipid.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033364"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Lipoidní pneumonie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lipoid pneumonia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033365">
        <obo:IAO_0000115 xml:lang="cs">Typ lipoidní pneumonie, při níž je zdrojem lipidů samotné tělo. Při obstrukci dýchacích cest se často stává, že distálně od obstrukce vyplní lumen odpojeného dýchacího prostoru makrofágy a obrovské buňky s lipidy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Endogenní lipoidní pneumonie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033365"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ lipoidní pneumonie, při níž je zdrojem lipidů samotné tělo. Při obstrukci dýchacích cest se často stává, že distálně od obstrukce vyplní lumen odpojeného dýchacího prostoru makrofágy a obrovské buňky s lipidy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of lipoid pneumonia in which the source of the lipids is the body itself. When an airway is obstructed, it is often the case that distal to the obstruction, lipid-laden macrophages and giant cells fill the lumen of the disconnected airspace.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033365"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Endogenní lipoidní pneumonie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Endogenous lipoid pneumonia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033366">
        <obo:IAO_0000115 xml:lang="cs">Typ lipoidní pneumonie, při níž je zdroj lipidů mimo tělo.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Exogenní lipoidní pneumonie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033366"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ lipoidní pneumonie, při níž je zdroj lipidů mimo tělo.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of lipoid pneumonia in which the source of the lipids is external to the body.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033366"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Exogenní lipoidní pneumonie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Exogenous lipoid pneumonia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033367">
        <obo:IAO_0000115 xml:lang="cs">Nízká hladina kyslíku v krvi způsobená změnou polohy vleže do vzpřímené polohy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Ortodeoxie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033367"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nízká hladina kyslíku v krvi způsobená změnou polohy vleže do vzpřímené polohy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Low level of blood oxygen induced by changing from a recumbent to an upright position.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033367"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Ortodeoxie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Orthodeoxia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033368">
        <obo:IAO_0000115 xml:lang="cs">Typ dyspnoe, ke které dochází, když postižený přechází z lehu do vzpřímené polohy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Platypnea</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033368"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ dyspnoe, ke které dochází, když postižený přechází z lehu do vzpřímené polohy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of dyspnea that occurs when the affected person changes from a recumbent to an upright position.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033368"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Platypnea</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Platypnea</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033369">
        <obo:IAO_0000115 xml:lang="cs">Typ leukodystrofie charakterizovaný mnohočetnými malými kavitacemi typicky v periventrikulární a hluboké mozkové bílé hmotě. Kavitace jsou viditelné jako centrální dutina s intenzitou signálu podobnou mozkomíšnímu moku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kavitující leukodystrofie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033369"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ leukodystrofie charakterizovaný mnohočetnými malými kavitacemi typicky v periventrikulární a hluboké mozkové bílé hmotě. Kavitace jsou viditelné jako centrální dutina s intenzitou signálu podobnou mozkomíšnímu moku.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of leukodystrophy characterized by multiple small cavitations typically in the periventricular and deep cerebral white matter. The cavitations are visible as a central cavity with cerebrospinal fluid-like signal intensity.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033369"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kavitující leukodystrofie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cavitating leukodystrophy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033370">
        <obo:IAO_0000115 xml:lang="cs">Telangiektázie (malé rozšířené krevní cévy nacházející se v blízkosti povrchu kůže nebo sliznic) nacházející se v trachoebronchiálním systému.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Bronchiální teleangiektázie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033370"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Telangiektázie (malé rozšířené krevní cévy nacházející se v blízkosti povrchu kůže nebo sliznic) nacházející se v trachoebronchiálním systému.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Telangiectasias (small dilated blood vessels located near the surface of the skin or mucous membranes) located in the trachoebronchial system.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033370"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Bronchiální teleangiektázie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bronchial telangiectasia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033371">
        <obo:IAO_0000115 xml:lang="cs">Granulomatózní zánět obklopující bronchi a bronchioly, nahrazující stěny průdušek a sliznici. U bronchocentrické granulomatózy obsahuje lumen dýchacích cest nekrotické zbytky. Lumen obklopují palisádové histiocyty.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Bronchocentrická granulomatóza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033371"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Granulomatózní zánět obklopující bronchi a bronchioly, nahrazující stěny průdušek a sliznici. U bronchocentrické granulomatózy obsahuje lumen dýchacích cest nekrotické zbytky. Lumen obklopují palisádové histiocyty.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Granulomatous inflammation that surrounds the bronchi and bronchioles, replacing bronchial walls and mucosa. In bronchocentric granulomatosis, the lumen of the airway contains necrotic debris, and palisaded histiocytes surround the lumen.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033371"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Bronchocentrická granulomatóza</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bronchocentric granulomatosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033372">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli odchylka od normálního rozmezí KCO. KCO je měřením rychlostní konstanty pro alveolární vychytávání CO během zadržení dechu při měření DLCO jedním dechem při plné inflaci plic. DLCO je odvozeno jako součin KCO a alveolárního objemu (VA) děleno PB-PH2O.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální KCO</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033372"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoli odchylka od normálního rozmezí KCO. KCO je měřením rychlostní konstanty pro alveolární vychytávání CO během zadržení dechu při měření DLCO jedním dechem při plné inflaci plic. DLCO je odvozeno jako součin KCO a alveolárního objemu (VA) děleno PB-PH2O.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any deviation from the normal range of KCO. The KCO is a measurement of the rate constant for alveolar uptake of CO during breath-holding in the single breath measurement of DLCO at full inflation. The DLCO is derived as the product of the KCO and the single breath alveolar volume (VA) divided by PB-PH2O.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033372"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální KCO</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal KCO</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033373">
        <obo:IAO_0000115 xml:lang="cs">Zvětšená difuzní kapacita plic pro rychlostní konstantu oxidu uhelnatého (CO)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšené KCO</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033373"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvětšená difuzní kapacita plic pro rychlostní konstantu oxidu uhelnatého (CO)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased diffusion capacity of the lung for carbon monoxide (CO) rate constant (efficiency index).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033373"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšené KCO</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased KCO</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033374">
        <obo:IAO_0000115 xml:lang="cs">Snížená difuzní kapacita plic pro rychlostní konstantu oxidu uhelnatého (CO)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížené KCO</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033374"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížená difuzní kapacita plic pro rychlostní konstantu oxidu uhelnatého (CO)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased diffusion capacity of the lung for carbon monoxide (CO) rate constant (efficiency index).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
