    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010731">
        <obo:IAO_0000115 xml:lang="cs">Obočí pokračuje směrem, nebo dokonce celou cestou k okraji horního víčka.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Prodloužení obočí směrem k hornímu víčku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010731"/>
