    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000919">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli anomálie kostochondrálního spojení. Kostochondrální spojení se nacházejí mezi distální částí žebra a chrupavčitou částí žebra, chrupavka spojuje žebra s hrudní kostí</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormality kostochondrální junkce</rdfs:label>
    </rdf:Description>
