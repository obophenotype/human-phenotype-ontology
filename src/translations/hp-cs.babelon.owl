        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031960"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ dystonie (abnormálně zvýšený svalový tonus způsobující fixované abnormální polohy), která postihuje svaly paží.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of dystonia (abnormally increased muscular tone causing fixed abnormal postures) that affects muscles of the arms.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031960"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Dystonie paží</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Arm dystonia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031961">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli odchylka od normální hodnoty anion gap v séru, která je vypočtena z elektrolytů naměřených v chemické laboratoři, je definována jako součet koncentrací sérových chloridů a bikarbonátů odečtených od koncentrace sodíku v séru.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnomrální sérový anion gap</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031961"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoli odchylka od normální hodnoty anion gap v séru, která je vypočtena z elektrolytů naměřených v chemické laboratoři, je definována jako součet koncentrací sérových chloridů a bikarbonátů odečtených od koncentrace sodíku v séru.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any deviation from the normal value of the serum anion gap, which is calculated from the electrolytes measured in the chemical laboratory, is defined as the sum of serum chloride and bicarbonate concentrations subtracted from the serum sodium concentration.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031961"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnomrální sérový anion gap</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal serum anion gap</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031962">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně vysoká hodnota anion gap v séru (součet koncentrací chloridů a bikarbonátů v séru odečtených od koncentrace sodíku v séru)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšený sérový anion gap</rdfs:label>
