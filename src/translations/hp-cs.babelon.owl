    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030389">
        <obo:IAO_0000115 xml:lang="cs">Odchylka od normální koncentrace tromboxanu v krevním oběhu. Tromboxany jsou odvozeny z prekurzorů prostaglandinů v krevních destičkách a stimulují agregaci krevních destiček a konstrikci krevních cév</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální koncentrace cirkulujícího tromboxanu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
