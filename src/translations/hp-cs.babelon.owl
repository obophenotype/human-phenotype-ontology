    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003552">
        <obo:IAO_0000115 xml:lang="cs">Stav, kdy nelze rychle pohybovat svaly bez doprovodné bolesti nebo křečí</obo:IAO_0000115>
