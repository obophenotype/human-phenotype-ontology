    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000712">
        <obo:IAO_0000115 xml:lang="cs">Nestabilní emoční prožitky a časté změny nálady; emoce vznikají snadno, jsou intenzivní, a/nebo nepoměrné k událostem a okolnostem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Emoční labilita</rdfs:label>
    </rdf:Description>
