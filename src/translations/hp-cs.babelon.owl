        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A neuroendocrine tumor originating in a hormone-producing cell (islet cell) of the pancreas.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030405"/>
