        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012054">
        <obo:IAO_0000115 xml:lang="cs">Zhoubný nádor melanocytů cévnatky. Klasický vzhled choroidálního melanomu je pigmentovaný kopulovitý nebo límcový knoflíkovitý nádor s přidruženým exsudativním odchlípením sítnice. Choroidální melanom je obvykle pigmentovaný, ale může být různě pigmentovaný a dokonce amelanotický (nepigmentovaný)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Choroidální melanom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012054"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zhoubný nádor melanocytů cévnatky. Klasický vzhled choroidálního melanomu je pigmentovaný kopulovitý nebo límcový knoflíkovitý nádor s přidruženým exsudativním odchlípením sítnice. Choroidální melanom je obvykle pigmentovaný, ale může být různě pigmentovaný a dokonce amelanotický (nepigmentovaný)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Malignant tumor of melanocytes of the choroid. The classic appearance of choroidal melanoma is a pigmented dome-shaped or collar button-shaped tumor with an associated exudative retinal detachment. Choroidal melanoma is usually pigmented, but can be variably pigmented and even amelanotic (non-pigmented).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012054"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Choroidální melanom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Choroidal melanoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012055">
        <obo:IAO_0000115 xml:lang="cs">Zhoubný nádor melanocytů řasnatého tělíska</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Melanom řasnatého tělíska</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012055"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
