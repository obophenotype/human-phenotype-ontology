        <owl:annotatedTarget xml:lang="cs">Přítomnost malých bílých sklivcových zákalů tvořených fosforečnanem vápenatým a komplexními vrstevnatými lipidovými usazeninami.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of small, white vitreous opacities consisting of calcium phosphate and complex, layered lipid deposits.</babelon:source_value>
