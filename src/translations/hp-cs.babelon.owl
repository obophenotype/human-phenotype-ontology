    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011902">
        <obo:IAO_0000115 xml:lang="cs">Anomálie v hladině nebo funkci hemoglobinu, bílkoviny přenášející kyslík v erytrocytech</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální hemoglobin</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011902"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomálie v hladině nebo funkci hemoglobinu, bílkoviny přenášející kyslík v erytrocytech</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anomaly in the level or the function of hemoglobin, the oxygen-carrying protein of erythrocytes.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
