    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100256">
        <obo:IAO_0000115 xml:lang="cs">Senilní plaky jsou extracelulární depozita amyloidu v šedé hmotě mozkové</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Senilní plaky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100256"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Senilní plaky jsou extracelulární depozita amyloidu v šedé hmotě mozkové</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Senile plaques are extracellular deposits of amyloid in the gray matter of the brain.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100256"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Senilní plaky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Senile plaques</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100257">
        <obo:IAO_0000115 xml:lang="cs">Stav, kdy chybí střední části rukou nebo chodidel (prsty a metakarpální nebo metatarsální kosti), což vypadá jako rozštěp. Závažnost je velmi variabilní od mírně hypoplastického třetího prstu ruky/nohy přes chybění druhého nebo třetího prstu ruky/nohy nebo až oligo- nebo monodaktylickou ruku/chodidlo.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Ektrodaktylie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100257"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Stav, kdy chybí střední části rukou nebo chodidel (prsty a metakarpální nebo metatarsální kosti), což vypadá jako rozštěp. Závažnost je velmi variabilní od mírně hypoplastického třetího prstu ruky/nohy přes chybění druhého nebo třetího prstu ruky/nohy nebo až oligo- nebo monodaktylickou ruku/chodidlo.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A condition in which middle parts of the hands and/or feet (digits and meta-carpals and -tarsals) are missing giving a cleft appearance. The severity is very variable ranging from slightly hypoplastic 3rd toe/fingers over absent 2nd or 3rd toes/fingers as far as oligo- or monodactyl hands and/or feet.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100257"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Ektrodaktylie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ectrodactyly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100258">
        <obo:IAO_0000115 xml:lang="cs">Typ polydaktylie, kdy se nadpočetný prst nebo prsty vyskytují na straně palce ruky nebo nohy</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Preaxiální polydaktylie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100258"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ polydaktylie, kdy se nadpočetný prst nebo prsty vyskytují na straně palce ruky nebo nohy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of polydactyly in which the extra digit or digits are localized on the side of the thumb or great toe.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100258"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Preaxiální polydaktylie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Preaxial polydactyly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100259">
        <obo:IAO_0000115 xml:lang="cs">Typ polydaktylie, kdy se nadpočetný prst nebo prsty vyskytují na straně pátého prstu ruky nebo nohy</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Postaxiální polydaktylie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100259"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ polydaktylie, kdy se nadpočetný prst nebo prsty vyskytují na straně pátého prstu ruky nebo nohy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of polydactyly in which the extra digit or digits are localized on the side of the fifth finger or fifth toe.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100259"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Postaxiální polydaktylie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Postaxial polydactyly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100260">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost nadpočetného prstu ruky nebo nohy (ale ne palce ruky nebo nohy), která zahrnuje třetí nebo čtvrtý metakarpál/tarsální kost s přidruženou kostěnou syndaktylií</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mesoaxiální polydaktylie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100260"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost nadpočetného prstu ruky nebo nohy (ale ne palce ruky nebo nohy), která zahrnuje třetí nebo čtvrtý metakarpál/tarsální kost s přidruženou kostěnou syndaktylií</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of a supernumerary finger or toe (not a thumb or hallux) involving the third or fourth metacarpal/tarsal with associated osseous syndactyly.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100260"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mesoaxiální polydaktylie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mesoaxial polydactyly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100261">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita struktury nebo tvaru šlach</obo:IAO_0000115>
