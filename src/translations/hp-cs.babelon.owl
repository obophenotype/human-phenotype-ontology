    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001310">
        <obo:IAO_0000115 xml:lang="cs">Typ ataxie charakterizovaný neschopností určit správný rozsah pohybu vyžadujícího více než jeden kloub, vede k nedotažení či přestřelení pohybu při pokusu uchopit předmět</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dysmetrie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001310"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ ataxie charakterizovaný neschopností určit správný rozsah pohybu vyžadujícího více než jeden kloub, vede k nedotažení či přestřelení pohybu při pokusu uchopit předmět</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of ataxia characterized by the inability to carry out movements with the correct range and motion across the plane of more than one joint related to incorrect estimation of the distances required for targeted movements.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001310"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Dysmetrie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dysmetria</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001311">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita funkce elektrických signálů, kterými nervové buňky komunikují mezi sebou nebo se svaly, měřeno elektrofyziologickým vyšetřením</obo:IAO_0000115>
