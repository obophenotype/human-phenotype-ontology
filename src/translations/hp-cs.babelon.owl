    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007443">
        <obo:IAO_0000115 xml:lang="cs">Absence pigmentu melaninu v různých oblastech, která se objevuje při narození a je trvalá. Léze se označují jako leukodermie a často se vyskytují na obličeji, trupu nebo končetinách.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Částečný albinismus</rdfs:label>
    </rdf:Description>
