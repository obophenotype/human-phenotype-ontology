    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032449">
        <obo:IAO_0000115 xml:lang="cs">Abnormální struktura nebo vzhled hemidesmozomů, multiproteinových komplexů, které usnadňují stabilní adhezi bazálních epiteliálních buněk k podkladové bazální membráně.</obo:IAO_0000115>
