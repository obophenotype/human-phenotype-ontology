    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005560">
        <obo:IAO_0000115 xml:lang="cs">Normální syntéza hemoglobinu je charakterizována produkcí stejného množství alfa a beta globinů. Tento termín označuje odchylku od tohoto vzorce a je hlavní charakteristikou různých forem talasemie.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nevyvážená syntéza hemoglobinu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005560"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Normální syntéza hemoglobinu je charakterizována produkcí stejného množství alfa a beta globinů. Tento termín označuje odchylku od tohoto vzorce a je hlavní charakteristikou různých forem talasemie.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Normal hemoglobin synthesis is characterized by production of equal amounts of alpha and beta globins. This term refers to a deviation from this pattern and is the main characteristic of the various forms of thalassemia.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005560"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nevyvážená syntéza hemoglobinu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Imbalanced hemoglobin synthesis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
