        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031018">
        <obo:IAO_0000115 xml:lang="cs">Ekrinní syringofibroadenom (ESFA) je benigní adnexální nádor vznikající nejčastěji na končetinách starších jedinců charakterizovaný anastomózou provazců kuboidních epiteliálních buněk obklopených fibrovaskulárním stromatem obsahujícím plazmatické buňky a duktální struktury. ESFA se pozitivně barví epiteliálním membránovým antigenem (EMA) a karcinoembryonálním antigenem (CEA)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Ekrinní syringofibroadenom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031018"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Ekrinní syringofibroadenom (ESFA) je benigní adnexální nádor vznikající nejčastěji na končetinách starších jedinců charakterizovaný anastomózou provazců kuboidních epiteliálních buněk obklopených fibrovaskulárním stromatem obsahujícím plazmatické buňky a duktální struktury. ESFA se pozitivně barví epiteliálním membránovým antigenem (EMA) a karcinoembryonálním antigenem (CEA)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Eccrine syringofibroadenoma (ESFA) is a benign adnexal tumor arising most often on the extremities of elderly individuals characterized by anastomosing cords of cuboidal epithelial cells surrounded by a fibrovascular stroma containing plasma cells and ductal structures. ESFA stains positively with epithelial membrane antigen (EMA) and carcinoembryonic antigen (CEA).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031018"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Ekrinní syringofibroadenom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Eccrine syringofibroadenoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031019">
        <obo:IAO_0000115 xml:lang="cs">Jaderné laloky neutrofilů v kostní dřeni jsou ztluštělé a kondenzované a jednotlivé laloky jsou spojeny neobvykle dlouhými chromatinovými vlákny.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pyknotické neutrofily kostní dřeně</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031019"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jaderné laloky neutrofilů v kostní dřeni jsou ztluštělé a kondenzované a jednotlivé laloky jsou spojeny neobvykle dlouhými chromatinovými vlákny.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nuclear lobes of neutrophils in the bone marrow are thickened and condensed, and individual lobes are connected by unusually long chromatin filaments.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031019"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Pyknotické neutrofily kostní dřeně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pyknotic bone marrow neutrophils</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031020">
        <obo:IAO_0000115 xml:lang="cs">Větší množství nebo procento krvetvorných buněk v poměru k tuku dřeně, než je běžný stav.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hypercelularita kostní dřeně</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031020"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Větší množství nebo procento krvetvorných buněk v poměru k tuku dřeně, než je běžný stav.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A larger than normal amount or percentage of hematopoietic cells relative to marrow fat.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031020"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hypercelularita kostní dřeně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bone marrow hypercellularity</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031021">
        <obo:IAO_0000115 xml:lang="cs">Benigní epiteliální novotvar charakterizovaný vzorem papilárního růstu a proliferací neoplastických dlaždicových buněk bez morfologického průkazu malignity [tezaurus NCI]</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Skvamózní papilom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031021"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Benigní epiteliální novotvar charakterizovaný vzorem papilárního růstu a proliferací neoplastických dlaždicových buněk bez morfologického průkazu malignity [tezaurus NCI]</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A benign epithelial neoplasm characterized by a papillary growth pattern and a proliferation of neoplastic squamous cells without morphologic evidence of malignancy [NCI thesaurus].</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031021"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Skvamózní papilom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Squamous Papilloma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031022">
        <obo:IAO_0000115 xml:lang="cs">Benigní exofyticky rostoucí novotvar, který vychází z orofaryngu. Je charakterizován přítomností jádra pojivové tkáně pokrytého vrstevnatým dlaždicovým epitelem [tezaurus NCI]</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Orofaryngeální skvamózní papilom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031022"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Benigní exofyticky rostoucí novotvar, který vychází z orofaryngu. Je charakterizován přítomností jádra pojivové tkáně pokrytého vrstevnatým dlaždicovým epitelem [tezaurus NCI]</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A benign exophytic neoplasm that arises from the oropharynx. It is characterized by the presence of a connective tissue core covered by stratified squamous epithelium [NCI thesaurus].</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031022"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Orofaryngeální skvamózní papilom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Oropharyngeal squamous papilloma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031023">
        <obo:IAO_0000115 xml:lang="cs">Mnohočetné, bolestivé, kupolovité, průsvitné, barvy od růžové po kožní papuly na ústní sliznici. Histologicky mohou léze vykazovat dermální proliferaci dobře ohraničených nervových svazků spojených s hojným mucinem a obklopených zřetelným perineurálním pouzdrem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mnohočetné slizniční neuromy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031023"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Mnohočetné, bolestivé, kupolovité, průsvitné, barvy od růžové po kožní papuly na ústní sliznici. Histologicky mohou léze vykazovat dermální proliferaci dobře ohraničených nervových svazků spojených s hojným mucinem a obklopených zřetelným perineurálním pouzdrem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Multiple painful, dome-shaped, translucent pink to skin-colored papules on oral mucosa. Histologically, the lesions may demonstrate dermal proliferation of well-demarcated nerve bundles associated with abundant mucin and surrounded by a distinct perineural sheath.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031023"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mnohočetné slizniční neuromy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Multiple mucosal neuromas</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031024">
        <obo:IAO_0000115 xml:lang="cs">Nezhoubný kožní adnexální nádor ekrinní diferenciace</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Cylindrom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031024"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nezhoubný kožní adnexální nádor ekrinní diferenciace</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A benign skin adnexal tumor of eccrine differentiation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031024"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Cylindrom</owl:annotatedTarget>
