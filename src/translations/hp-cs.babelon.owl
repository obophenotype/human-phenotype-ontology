        <obo:IAO_0000115 xml:lang="cs">Solidní nodulární heterotopie v oblasti peritrigonální optické dráhy za hlubokými šedými jádry.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nodulární subkortikální heterotopie v peritrigonálních oblastech</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032392"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Solidní nodulární heterotopie v oblasti peritrigonální optické dráhy za hlubokými šedými jádry.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Solid nodular heterotopia situated in the region of the peritrigonal optic pathway posterior to the deep gray nuclei.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032392"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nodulární subkortikální heterotopie v peritrigonálních oblastech</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nodular subcortical heterotopia in peritrigonal regions</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032393">
        <obo:IAO_0000115 xml:lang="cs">Subkortikální heterotopie sestávající z bilaterální a symetrické jediné souvislé, zvlněné páskovité vrstvy šedé hmoty nacházející se ve frontálním, parietálním a okcipitálním laloku. Nemá žádné viditelné spojení s kůrou nad ní.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Difúzní lemovitá subkortikální heterotopie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032393"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Subkortikální heterotopie sestávající z bilaterální a symetrické jediné souvislé, zvlněné páskovité vrstvy šedé hmoty nacházející se ve frontálním, parietálním a okcipitálním laloku. Nemá žádné viditelné spojení s kůrou nad ní.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Subcortical heterotopia consisting of a bilateral and symmetric single continuous, undulating ribbon-like layer of gray matter located in the frontal, parietal and occipital lobes. It has no visible connection to the overlying cortex.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
