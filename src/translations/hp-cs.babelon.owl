    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004057">
        <obo:IAO_0000115 xml:lang="cs">&quot;Srůst rukou a nohou tenkou kožní membránou (jizvením) pozorovanou u forem dystrofické epidermolysis bullosa a vedoucí k deformaci ruky, která vypadá jako rukavice &quot;&quot;palčák&quot;&quot;&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Deformita ruky ve tvaru rukavice bez prstů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004057"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">&quot;Srůst rukou a nohou tenkou kožní membránou (jizvením) pozorovanou u forem dystrofické epidermolysis bullosa a vedoucí k deformaci ruky, která vypadá jako rukavice &quot;&quot;palčák&quot;&quot;&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>&quot;Fusion of the hands and feet by a thin membrane of skin (scarring) seen in forms of dystrophic epidermolysis bullosa and leading to a &quot;&quot;mitten&quot;&quot; hand deformity.&quot;</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
