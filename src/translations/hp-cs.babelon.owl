    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012006">
        <obo:IAO_0000115 xml:lang="cs">Subjektivní pocit, že zážitek, který se odehrál dříve, zažíváte poprvé.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Jamais vu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012006"/>
