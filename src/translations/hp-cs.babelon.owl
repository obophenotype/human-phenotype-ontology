    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025660">
        <obo:IAO_0000115 xml:lang="cs">Typ Chiariho malformace, která se skládá z herniace mozkového kmene a vyčnívajícího mozečku a navyše jsou herniované tonsily mozečku a vermis v důsledku otevřeného distálního spinálního dysrafismu/myelomeningokély.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Chiariho malformace typ II</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025660"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ Chiariho malformace, která se skládá z herniace mozkového kmene a vyčnívajícího mozečku a navyše jsou herniované tonsily mozečku a vermis v důsledku otevřeného distálního spinálního dysrafismu/myelomeningokély.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of Chiari malformation that consists of brainstem herniation and a towering cerebellum in addition to the herniated cerebellar tonsils and vermis due to an open distal spinal dysraphism/myelomeningocele.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025660"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Chiariho malformace typ II</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chiari type II malformation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025661">
        <obo:IAO_0000115 xml:lang="cs">Typ Chiariho malformace, který zahrnuje herniaci zadního mozku (mozečku s mozkovým kmenem nebo bez něj) do nízké týlní nebo vysoké krční meningoencefalokély.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Chiariho malformace typ III</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025661"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ Chiariho malformace, který zahrnuje herniaci zadního mozku (mozečku s mozkovým kmenem nebo bez něj) do nízké týlní nebo vysoké krční meningoencefalokély.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of Chiari malformation that involves herniation of the hindbrain (cerebellum with or without the brainstem) into a low occipital or high cervical meningoencephalocele.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
