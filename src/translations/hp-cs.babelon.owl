        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal aware cognitive seizure with neglect</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032849">
        <obo:IAO_0000115 xml:lang="cs">Afázický status epilepticus je typ fokálního nekonvulzivního epileptického stavu bez kómatu charakterizovaný kognitivním (spíše než motorickým) řečovým deficitem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Afázický status epilepticus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032849"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Afázický status epilepticus je typ fokálního nekonvulzivního epileptického stavu bez kómatu charakterizovaný kognitivním (spíše než motorickým) řečovým deficitem.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aphasic status epilepticus is a type of focal non-convulsive status epilepticus without coma characterized by a cognitive (rather than motor) language deficit.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032849"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Afázický status epilepticus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aphasic status epilepticus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032850">
        <obo:IAO_0000115 xml:lang="cs">Fokální kognitivní záchvat s expresivní dysfázií/afázií charakterizovaný zachovaným vědomím po celou dobu záchvatu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kognitivní záchvat s expresivní dysfázií/afázií bez poruchy vědomí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032850"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kognitivní záchvat s expresivní dysfázií/afázií charakterizovaný zachovaným vědomím po celou dobu záchvatu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal cognitive seizure with expressive dysphasia / aphasia characterized by retained awareness throughout the seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032850"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kognitivní záchvat s expresivní dysfázií/afázií bez poruchy vědomí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal aware cognitive seizure with expressive dysphasia/aphasia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032851">
        <obo:IAO_0000115 xml:lang="cs">Záchvat charakterizovaný zrakovými halucinacemi, jako jsou blikající světla/barvy, tvary, jednoduché obrazce, skotomata nebo amauróza.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální senzorický záchvat s vizuálními fenomény bez poruchy vědomí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032851"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Záchvat charakterizovaný zrakovými halucinacemi, jako jsou blikající světla/barvy, tvary, jednoduché obrazce, skotomata nebo amauróza.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A seizure characterized by elementary visual hallucinations such as flashing or flickering lights/colors, or other shapes, simple patterns, scotomata, or amaurosis.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032851"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální senzorický záchvat s vizuálními fenomény bez poruchy vědomí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
