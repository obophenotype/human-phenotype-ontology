        <owl:annotatedTarget xml:lang="cs">Periferní cystoidní degenerace sítnice</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Peripheral cystoid retinal degeneration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
