        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vyšší než normální koncentrace manganu v krvi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The concentration of manganese cation in the blood circulation is above the upper limit of normal.</babelon:source_value>
