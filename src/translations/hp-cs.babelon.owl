        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100885">
        <obo:IAO_0000115 xml:lang="cs">Přetrvávání embryonálního hřbetního nebo sedacího žilního systému, který by měl normálně vymizet kolem 10. až 12. týdne nitroděložního života.</obo:IAO_0000115>
