    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030271">
        <obo:IAO_0000115 xml:lang="cs">Tento termín označuje nepřiměřeně nízkou koncentraci 2,3-DPG v erytrocytech. 2,3-difosfoglycerát (2,3-DPG) řídí pohyb kyslíku z červených krvinek do tkání. Anémie je obvykle doprovázena zvýšenou hladinou 2,3-DPG, aby se podpořilo okysličení tkáni.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená koncentrace 2,3-difosfoglycerátu v erytrocytech</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030271"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Tento termín označuje nepřiměřeně nízkou koncentraci 2,3-DPG v erytrocytech. 2,3-difosfoglycerát (2,3-DPG) řídí pohyb kyslíku z červených krvinek do tkání. Anémie je obvykle doprovázena zvýšenou hladinou 2,3-DPG, aby se podpořilo okysličení tkáni.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>This term refers to an inappropriate low 2,3-DPG concentration in erythrocytes. 2,3-diphosphoglycerate (2,3-DPG) controls the movement of oxygen from red blood cells to tissues. Anemia is usually accompanied by an increased level of 2,3-DPG in order to promote tissue oxygenation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030271"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Snížená koncentrace 2,3-difosfoglycerátu v erytrocytech</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced erythrocyte 2,3-diphosphoglycerate concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030272">
        <obo:IAO_0000115 xml:lang="cs">Změněná schopnost jakéhokoli enzymu působit jako katalyzátor v erytrocytech. Tento termín zahrnuje změny způsobené změněnou hladinou enzymu.</obo:IAO_0000115>
