        <owl:annotatedTarget xml:lang="cs">Snížení těchto hladin má za výsledek zvýšení inhibice fibrinolýzy a snížení inhibice koagulace.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
