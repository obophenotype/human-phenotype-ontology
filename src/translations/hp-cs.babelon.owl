    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011856">
        <obo:IAO_0000115 xml:lang="cs">Chuť a trvalé požívání nepotravinových látek, jako je jíl. Aby bylo možné diagnostikovat picu, toto chování musí přetrvávat po dobu alespoň jednoho měsíce</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pica</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011856"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Chuť a trvalé požívání nepotravinových látek, jako je jíl. Aby bylo možné diagnostikovat picu, toto chování musí přetrvávat po dobu alespoň jednoho měsíce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An appetite for and the persistent ingestion of non-food substances such as clay. In order to diagnose pica, this behavior must have persisted over a period of at least one month.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011856"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Pica</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pica</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011857">
        <obo:IAO_0000115 xml:lang="cs">Samostatná masa neoplastických monoklonálních plazmatických buněk buď v kostní dřeni nebo v extramedulární lokalizaci</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Plazmocytom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011857"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Samostatná masa neoplastických monoklonálních plazmatických buněk buď v kostní dřeni nebo v extramedulární lokalizaci</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A discrete mass of neoplastic monoclonal plasma cells either in the bone marrow or in an extramedullary location.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
