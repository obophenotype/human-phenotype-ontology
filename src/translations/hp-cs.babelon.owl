    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025530">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost mnohočetných xantomů v kůži umístněných v dlaňových rýhách. Xantomy jsou nažloutlé, pevné, lipidy vyplněné uzlíky v kůži</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Xantomy dlanových rýh</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025530"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost mnohočetných xantomů v kůži umístněných v dlaňových rýhách. Xantomy jsou nažloutlé, pevné, lipidy vyplněné uzlíky v kůži</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of multiple xanthomas (xanthomata) in the skin distributed in the creases of the palm of the hand. Xanthomas are yellowish, firm, lipid-laden nodules in the skin.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025530"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Xantomy dlanových rýh</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Xanthomas of the palmar creases</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025531">
        <obo:IAO_0000115 xml:lang="cs">Harlekýnský fenomén spočívá v náhlé změně barvy kůže, která má za následek dvě různé barvy těla, jednu na každé polovině těla.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fenomén Harlekýn</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025531"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Harlekýnský fenomén spočívá v náhlé změně barvy kůže, která má za následek dvě různé barvy těla, jednu na každé polovině těla.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The Harlequin phenomenon consists of a sudden change in skin color, resulting in two different body colors, one on each half of the body.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025531"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fenomén Harlekýn</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Harlequin phenomenon</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025532">
        <obo:IAO_0000115 xml:lang="cs">Při testu patergie se do kůže předloktí zavede malá sterilní jehla. Místo vpichu se obkrouží a pozoruje se po jednom a dvou dnech. Pokud se v místě vpichu jehly objeví malý červený hrbolek nebo puchýřek, považuje se test patergie za pozitivní (abnormální).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pozitivní test patergie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025532"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Při testu patergie se do kůže předloktí zavede malá sterilní jehla. Místo vpichu se obkrouží a pozoruje se po jednom a dvou dnech. Pokud se v místě vpichu jehly objeví malý červený hrbolek nebo puchýřek, považuje se test patergie za pozitivní (abnormální).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>With the pathergy test, a small, sterile needle is inserted into the skin of the forearm. The site of injectionis circuled and observed after one and two days. If a small red bump or pustule at the site of needle insertion occurs, the pathergy test is considered to have a positive (abnormal) result.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025532"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Pozitivní test patergie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Positive pathergy test</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025533">
        <rdfs:label xml:lang="cs">Pomerančová kůže</rdfs:label>
    </rdf:Description>
