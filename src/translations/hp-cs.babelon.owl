    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012664">
        <obo:IAO_0000115 xml:lang="cs">Snížení objemové frakce krve čerpané ze srdeční komory s každým srdečním cyklem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená ejekční frakce levé komory</rdfs:label>
