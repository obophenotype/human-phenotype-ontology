    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031073">
        <obo:IAO_0000115 xml:lang="cs">Anomální reakce na test, který je navržen tak, aby prozkoumal funkci endokrinního systému</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální reakce na endokrinní stimulační test</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031073"/>
