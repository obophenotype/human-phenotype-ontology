    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031411">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli strukturální anomálie chromozomu, což je vláknitá molekula sestávající z DNA a proteinů (chromatin), která obsahuje sekvence DNA pro geny a další genetické prvky v lineárním pořadí</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie chromozomu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031411"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoli strukturální anomálie chromozomu, což je vláknitá molekula sestávající z DNA a proteinů (chromatin), která obsahuje sekvence DNA pro geny a další genetické prvky v lineárním pořadí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any structural anomaly of a chromosome, which is a thread like molecule consisting of DNA and proteins (chromatin) that contains DNA sequences for genes and other genetic elements in linear order.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
