        <owl:annotatedTarget xml:lang="cs">Nepříjemný pocit charakterizovaný fyzickým nepohodlím (jako je píchání, pulzování nebo bolest), který má původ v krku.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) and perceived to originate in the throat.</babelon:source_value>
