    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010802">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená pigmentace kůže kolem vermilionu rtů, ať už ložisková, nebo generalizovaná.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hyperpigmentace kolem úst</rdfs:label>
    </rdf:Description>
