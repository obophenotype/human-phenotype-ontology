    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000396">
        <obo:IAO_0000115 xml:lang="cs">Helix zevního ucha je víc zavinutý než je obvyklé. Excesivní zavinutí zahnutého okraje helixu dovnitř, takže, že jeho zavinutý volný okraj je paralelní s rovinou ucha</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Overfolded helix</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000396"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Helix zevního ucha je víc zavinutý než je obvyklé. Excesivní zavinutí zahnutého okraje helixu dovnitř, takže, že jeho zavinutý volný okraj je paralelní s rovinou ucha</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A condition in which the helix is folded over to a greater degree than normal. That is, excessive curling of the helix edge, whereby the free edge is parallel to the plane of the ear.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
