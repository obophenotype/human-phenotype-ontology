        <owl:annotatedTarget xml:lang="cs">Rozšířené a zduřelé umbilikální žíly, které vycházejí z pupku přes celé břicho a spojují se se systémovými žilami.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
