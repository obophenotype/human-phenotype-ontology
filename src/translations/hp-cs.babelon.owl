    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009914">
        <obo:IAO_0000115 xml:lang="cs">Kyklopie je vrozená abnormalita, kdy je přítomno pouze jedno oko. Oko je centrálně umístěno v oblasti, kde se bežně nachází kořen nosu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kyklopie</rdfs:label>
    </rdf:Description>
