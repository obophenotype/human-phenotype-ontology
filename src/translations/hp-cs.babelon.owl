        <owl:annotatedTarget xml:lang="cs">Zvýšený počet megakaryocytů, tj. prekurzorů krevních destiček, přítomných v kostní dřeni</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased megakaryocyte number, i.e., of platelet precursor cells, present in the bone marrow.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
