        <owl:annotatedTarget xml:lang="cs">Zhoršená schopnost sledovat úspěch nebo neúspěch při řešení problémů a identifikovat a opravit chyby během plnění cíle.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
