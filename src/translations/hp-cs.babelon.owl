        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025522">
        <obo:IAO_0000115 xml:lang="cs">Abnormální zvětšení délky chordae tendinae mitrální chlopně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Prodloužené chordae tendinae mitrální chlopně</rdfs:label>
    </rdf:Description>
