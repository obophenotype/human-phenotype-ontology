        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033679"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoli strukturální anomálie nucleus ruber, části středního mozku zapojené do řízení pohybu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any structural anomaly of the red nucleus, a part of the midbrain involved in control of movement.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
