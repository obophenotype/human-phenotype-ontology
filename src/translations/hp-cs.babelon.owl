    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003645">
        <obo:IAO_0000115 xml:lang="cs">Prodloužený čas do koagulace v testu parciálního tromboplastinového času (PTT), který je měřítkem vnitřní a společné koagulační cesty. Fosfolipid, aktivátor a vápník se smíchají do antikoagulovaného vzorku plazmy a měří se doba, než se vytvoří trombus.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Prodloužený parciální tromboplastinový čas</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003645"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Prodloužený čas do koagulace v testu parciálního tromboplastinového času (PTT), který je měřítkem vnitřní a společné koagulační cesty. Fosfolipid, aktivátor a vápník se smíchají do antikoagulovaného vzorku plazmy a měří se doba, než se vytvoří trombus.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased time to coagulation in the partial thromboplastin time (PTT) test, a measure of the intrinsic and common coagulation pathways. Phospholipid, and activator, and calcium are mixed into an anticoagulated plasma sample, and the time is measured until a thrombus forms.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
