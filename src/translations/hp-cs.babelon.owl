    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032018">
        <obo:IAO_0000115 xml:lang="cs">Typ periferní neuropatie, ke kterému dochází, když dojde k poškození dvou nebo více různých nervových oblastí, vyznačující se periferní neuropatií jak motorických, tak senzorických nervů alespoň dvou různých nervových kmenů. Různé nervy jsou ovlivněny buď současně nebo postupně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mnohočetná mononeuropatie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032018"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ periferní neuropatie, ke kterému dochází, když dojde k poškození dvou nebo více různých nervových oblastí, vyznačující se periferní neuropatií jak motorických, tak senzorických nervů alespoň dvou různých nervových kmenů. Různé nervy jsou ovlivněny buď současně nebo postupně.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of peripheral neuropathy that happens when there is damage to two or more different nerve areas characterized by peripheral neuropathy of both the motor and sensory nerves of at least two different nerve trunks. Different nerves are affected either simultaneously or sequentially.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032018"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mnohočetná mononeuropatie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Multiple mononeuropathy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032019">
