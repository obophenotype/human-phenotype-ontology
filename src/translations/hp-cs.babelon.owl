        <owl:annotatedTarget xml:lang="cs">Rozštěp předního cípu mitrální chlopně, který není spojen s defektem atrioventrikulárního kanálu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cleft in the anterior mitral valve leaflet not associated with an atrioventricular canal defect.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011569"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Rozštěp předního cípu mitrální chlopně</owl:annotatedTarget>
