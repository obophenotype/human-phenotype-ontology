        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000070">
        <obo:IAO_0000115 xml:lang="cs">Silně omezené, fixované zájmy, které mají abnormální intenzitu nebo zaměření (např. silná vazba na neobvyklé předměty nebo zaujetí jimi, nadměrně omezené nebo vytrvalé zájmy).</obo:IAO_0000115>
