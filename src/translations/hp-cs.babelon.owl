        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inappropriate (ectopic) endometrial tissue proliferation within the uterine myometrium, often presenting clinically with painful menses and heavy menstrual bleeding.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
