    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032718">
        <obo:IAO_0000115 xml:lang="cs">Fokální motorický záchvat, jehož počátečním semiologickým projevem je trvalá kontrakce agonistických i antagonistických svalů vytvářející atetoidní nebo kroutivé pohyby, které vedou k abnormálnímu držení těla.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální motorický záchvat s dystoniemi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
