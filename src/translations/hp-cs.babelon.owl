        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031599">
        <obo:IAO_0000115 xml:lang="cs">Široká (120 ms nebo delší) a rozdvojená vlna P ve svodu II při EKG.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">P mitrale</rdfs:label>
    </rdf:Description>
