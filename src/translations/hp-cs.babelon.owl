        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrial standstill</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025479">
        <obo:IAO_0000115 xml:lang="cs">Zanedbávání vlastních potřeb a pohody</obo:IAO_0000115>
