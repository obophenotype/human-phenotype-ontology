    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000580">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita sítnice charakterizovaná tvorbou depozit pigmentu. Makrofágy nebo pigmentové buňky migrují do sítnice, melanin z těchto buňek zůsobuje změnu barvy. Pigmetová retinopatie je konečným stadiem mnoha retinálních onemocnění a je asociovaná se ztrátou zraku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pigmentová retinopatie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000580"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita sítnice charakterizovaná tvorbou depozit pigmentu. Makrofágy nebo pigmentové buňky migrují do sítnice, melanin z těchto buňek zůsobuje změnu barvy. Pigmetová retinopatie je konečným stadiem mnoha retinálních onemocnění a je asociovaná se ztrátou zraku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the retina characterized by pigment deposition. It is typically associated with migration and proliferation of macrophages or retinal pigment epithelial cells into the retina; melanin from these cells causes the pigmentary changes. Pigmentary retinopathy is a common final pathway of many retinal conditions and is often associated with visual loss.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000580"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Pigmentová retinopatie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pigmentary retinopathy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
