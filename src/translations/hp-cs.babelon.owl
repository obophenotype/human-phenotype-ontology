        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An increased amount of L-homocitrulline in the urine. L-homocitrulline is an L-lysine derivative that is L-lysine having a carbamoyl group at the N(6)-position. It is found in individuals with urea cycle disorders.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
