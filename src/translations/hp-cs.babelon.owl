    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003343">
        <obo:IAO_0000115 xml:lang="cs">Snížená aktivita enzymu glutathionsyntetázy, který katalyzuje poslední krok syntézy glutathionu, a nedostatek má za následek nízké hladiny glutathionu. Acidóza je způsobena sníženou zpětnovazební inhibicí gama-glutamylcysteinsyntetázy v gama-glutamylovém cyklu, což nakonec vede k nadprodukci a akumulaci 5-oxoprolinu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená hladina glutathionsyntetázy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003343"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížená aktivita enzymu glutathionsyntetázy, který katalyzuje poslední krok syntézy glutathionu, a nedostatek má za následek nízké hladiny glutathionu. Acidóza je způsobena sníženou zpětnovazební inhibicí gama-glutamylcysteinsyntetázy v gama-glutamylovém cyklu, což nakonec vede k nadprodukci a akumulaci 5-oxoprolinu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced level of the enzyme glutathione synthetase, which catalyzes the last step in the synthesis of glutathione and a deficiency results in low levels of glutathione. Acidosis is due to reduced feedback inhibition of gamma-glutamyl cysteine synthetase in the gamma-glutamyl cycle, which ultimately leads to overproduction and accumulation of 5-oxoproline.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003343"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Snížená hladina glutathionsyntetázy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced glutathione synthetase level</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
