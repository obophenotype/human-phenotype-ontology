    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011961">
        <obo:IAO_0000115 xml:lang="cs">Absence jakékoliv měřitelné úrovně spermií v spermatu z důvodu defektu predukce spermií ve varlatech. Od obstrukční azoospermie může být odlišen na základě biopsie varlete.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neobstrukční azoospermie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011961"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Absence jakékoliv měřitelné úrovně spermií v spermatu z důvodu defektu predukce spermií ve varlatech. Od obstrukční azoospermie může být odlišen na základě biopsie varlete.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of any measurable level of sperm in his semen, resulting from a defect in the production of spermatozoa in the testes. This can be differentiated from obstructive azoospermia on the basis of testicular biopsy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011961"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neobstrukční azoospermie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Non-obstructive azoospermia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011962">
        <obo:IAO_0000115 xml:lang="cs">Absence jakékoliv měřitelné úrovně spermií v spermatu z důvodu posttestikulární obstrukce nebo retrográdní ejakulace. Od neobstrukční azoospermie může být odlišen na základě biopsie varlete.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Obstrukční azoospermie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011962"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Absence jakékoliv měřitelné úrovně spermií v spermatu z důvodu posttestikulární obstrukce nebo retrográdní ejakulace. Od neobstrukční azoospermie může být odlišen na základě biopsie varlete.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of any measurable level of sperm in his semen, resulting from post-testicular obstruction or retrograde ejaculation. This can be differentiated from obstructive azoospermia on the basis of testicular biopsy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
