        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012186">
        <obo:IAO_0000115 xml:lang="cs">Kompresivní neuropatie ulnárního nervu vkcubitě (v lokti) charakterizovaná znecitlivěním prsteníčku a malíčků a slabostí vnitřních svalů na ruce</obo:IAO_0000115>
