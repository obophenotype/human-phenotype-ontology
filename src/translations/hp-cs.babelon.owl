    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033120">
        <obo:IAO_0000115 xml:lang="cs">Typ ekzému charakterizovaný svědivými skvrnami ve tvaru mince. Numulární ekzém se nejčastěji vyskytuje na končetinách, zejména na nohou, ale může se objevit kdekoli na trupu, rukou nebo nohou.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Numulární ekzém</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033120"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ ekzému charakterizovaný svědivými skvrnami ve tvaru mince. Numulární ekzém se nejčastěji vyskytuje na končetinách, zejména na nohou, ale může se objevit kdekoli na trupu, rukou nebo nohou.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of eczema characterized by pruritic coin-shaped patches on the skin. Nummular eczema most commonly occurs on the extremities, particularly the legs, but may occur anywhere on the trunk, hands, or feet</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
