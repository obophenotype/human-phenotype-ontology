    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011231">
        <obo:IAO_0000115 xml:lang="cs">Řasy, které si povšimnete, protože jsou příliš husté a/nebo dlouhé a/nebo kudrnaté, bez toho aby se ještě jednalo o trichomegalii.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Výrazné řasy</rdfs:label>
