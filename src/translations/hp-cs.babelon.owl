    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009899">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost abnormálně prominující crus helicis. To je vytvoření crus helicis až k úrovni kde běžně leží baze antehelixu nebo helixu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Prominující crus helicis</rdfs:label>
    </rdf:Description>
