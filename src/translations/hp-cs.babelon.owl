        <owl:annotatedTarget xml:lang="cs">Shlukování krevních destiček v krvi při testu agregace krevních destiček bez přidání látek, které se obvykle používají k vyvolání agregace.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Clumping together of platelets in the blood in a platelet aggregation test without addition of agents normally used to induce aggregation.</babelon:source_value>
