        <owl:annotatedTarget xml:lang="cs">Submukózní rozštěp měkkého patra</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Submucous cleft soft palate</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011820">
        <obo:IAO_0000115 xml:lang="cs">Absence normálního otvoru choan (apertury nasalis posterior) důsledkem obstrukce tohoo otvoru membránou, která může být tenká či tlustší.</obo:IAO_0000115>
