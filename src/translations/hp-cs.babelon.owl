        <owl:annotatedTarget xml:lang="cs">Snížené množství merosinu ve svalových vláknech. Tato vlastnost se obvykle posuzuje imunohistochemickým vyšetřením tkáně ze svalové biopsie.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduced amount of merosin in muscle fibers. This feature is usually assessed by immunohistochemical examination of muscle biopsy tissue.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
