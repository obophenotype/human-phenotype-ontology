    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007717">
        <obo:IAO_0000115 xml:lang="cs">Chronická iritativní konjunktivitis, často přítomna spolu s povšechnou iritací očí, oči jsou začervenalé, pálí, přítomny jsou pocity suchých očí či cizího tělesa v oku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Chronická dráždivá konjunktivitída</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007717"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Chronická iritativní konjunktivitis, často přítomna spolu s povšechnou iritací očí, oči jsou začervenalé, pálí, přítomny jsou pocity suchých očí či cizího tělesa v oku.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A chronic irritative conjunctivitis, which commonly presents with general irritation and redness of the eyes, with a burning, dry, or foreign-body sensation of the eyes.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
