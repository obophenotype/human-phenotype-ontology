        <obo:IAO_0000115 xml:lang="cs">Nález ložiska zvýšené echogenity při prenatálním ultrazvukovém vyšetření plodu. Ohnisko může být přítomno v jedné nebo v obou komorách. Echogenní intrakardiální ložisko (EICF) je definováno jako ložisko s echogenitou srovnatelnou s kostí v oblasti papilárního svalu v jedné nebo obou komorách srdce plodu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Echogenní intrakardiální ložisko</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010942"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nález ložiska zvýšené echogenity při prenatálním ultrazvukovém vyšetření plodu. Ohnisko může být přítomno v jedné nebo v obou komorách. Echogenní intrakardiální ložisko (EICF) je definováno jako ložisko s echogenitou srovnatelnou s kostí v oblasti papilárního svalu v jedné nebo obou komorách srdce plodu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A finding of a focus of increased echogenicity upon prenatal ultrasound examination of the fetus. The foci may be present in one or both ventricles. Echogenic intracardiac focus (EICF) is defined as a focus of echogenicity comparable to bone, in the region of the papillary muscle in either or both ventricles of the fetal heart.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010942"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Echogenní intrakardiální ložisko</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Echogenic intracardiac focus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010943">
        <obo:IAO_0000115 xml:lang="cs">Echogenní střevo je definováno jako střevo plodu s homogenními oblastmi echogenity, které jsou stejné nebo větší než oblasti okolních kostí.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Echogenní střeva plodu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010943"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Echogenní střevo je definováno jako střevo plodu s homogenními oblastmi echogenity, které jsou stejné nebo větší než oblasti okolních kostí.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Echogenic bowel is defined as fetal bowel with homogenous areas of echogenicity that are equal to or greater than that of surrounding bone.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010943"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Echogenní střeva plodu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Echogenic fetal bowel</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010944">
