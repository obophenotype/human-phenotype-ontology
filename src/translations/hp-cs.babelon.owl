    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004387">
        <obo:IAO_0000115 xml:lang="cs">Zánět tlustého a tenkého střeva. Většina onemocnění se však klasifikuje buď jako enteritida (zánět tenkého střeva), nebo kolitida (zánět tlustého střeva).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Enterokolitida</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004387"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zánět tlustého a tenkého střeva. Většina onemocnění se však klasifikuje buď jako enteritida (zánět tenkého střeva), nebo kolitida (zánět tlustého střeva).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An inflammation of the colon and small intestine. However, most conditions are either categorized as Enteritis (inflammation of the small intestine) or Colitis (inflammation of the large intestine).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
