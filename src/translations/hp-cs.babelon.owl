        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010447">
        <obo:IAO_0000115 xml:lang="cs">Abnormální spojení mezi epitelizovaným povrchem análního kanálu a perianální kůží.</obo:IAO_0000115>
