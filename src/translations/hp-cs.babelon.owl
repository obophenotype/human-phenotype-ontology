    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012657">
        <obo:IAO_0000115 xml:lang="cs">Funkční mozková anomálie detekovatelná pozitronovou emisní tomografií (PET). PET skenování je metoda pro funkční zobrazování mozku a její měření odrážejí množství mozkové aktivity v různých oblastech mozku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální pozitronová emisní tomografie mozku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012657"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Funkční mozková anomálie detekovatelná pozitronovou emisní tomografií (PET). PET skenování je metoda pro funkční zobrazování mozku a její měření odrážejí množství mozkové aktivity v různých oblastech mozku.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A functional brain anomaly detectable by positron emission tomography (PET). PET scanning is a method for functional brain imaging, and its measurements reflect the amount of brain activity in the various regions of the brain.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012657"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální pozitronová emisní tomografie mozku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal brain positron emission tomography</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012658">
        <obo:IAO_0000115 xml:lang="cs">Anomálie detekovatelná při skenování mozku [18F]-fluorodeoxyglukózou (FDG) pozitronovou emisní tomografií (PET). Vychytávání glukózy měřené pomocí FDG-PET je markerem neuronální metabolické aktivity.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální FDG (fluor-deoxy-glukóza) pozitronová emisní tomografie mozku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012658"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomálie detekovatelná při skenování mozku [18F]-fluorodeoxyglukózou (FDG) pozitronovou emisní tomografií (PET). Vychytávání glukózy měřené pomocí FDG-PET je markerem neuronální metabolické aktivity.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly detectable in [18F]-fluorodeoxyglucose (FDG) positron emission tomography (PET) brain scans. Glucose uptake measured with FDG-PET is a marker of neuronal metabolic activity.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
