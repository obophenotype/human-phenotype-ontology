    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032864"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fokálního smyslového záchvatu se sluchovými fenomény, během kterého je během záchvatu zachováno vědomí.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of focal sensory seizure with auditory features during which awareness is retained throughout the seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032864"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální senzorický záchvat se sluchovými projevy/fenomény bez poruchy vědomí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal aware sensory seizure with auditory features</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032865">
        <obo:IAO_0000115 xml:lang="cs">Myoklonický status epilepticus s absencí je typ generalizovaného nekonvulzivního status epilepticus bez kómatu, který je semiologicky prolongovaným záchvatem myoklonické absence. Myoklonický status epilepticus s absencí se skládá z proximálních, převážně myoklonických záškubů horních končetin, které korelují s výboji hrot-vlna o frekvenci 3 Hz na EEG.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Epileptický status myoklonických absencí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032865"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Myoklonický status epilepticus s absencí je typ generalizovaného nekonvulzivního status epilepticus bez kómatu, který je semiologicky prolongovaným záchvatem myoklonické absence. Myoklonický status epilepticus s absencí se skládá z proximálních, převážně myoklonických záškubů horních končetin, které korelují s výboji hrot-vlna o frekvenci 3 Hz na EEG.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Myoclonic absence status epilepticus is a type of generalized non-convulsive status epilepticus without coma that is semiologically a prolonged myoclonic absence seizure. Myoclonic absence status epilepticus consists of proximal, predominantly upper extremity myoclonic jerks corresponding with 3 Hz spike-wave discharges in the EEG.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032865"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Epileptický status myoklonických absencí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Myoclonic absence status epilepticus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032866">
        <obo:IAO_0000115 xml:lang="cs">Typ fokálního motorického status epilepticus charakterizovaný opakovanými a rychlými sakádami ve spojení s epileptickými výboji</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Okuloklonický status epilepticus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032866"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fokálního motorického status epilepticus charakterizovaný opakovanými a rychlými sakádami ve spojení s epileptickými výboji</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of focal motor status epilepticus characterized by repetitive and rapid saccades, in association with epileptic discharges.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032866"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Okuloklonický status epilepticus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Oculoclonic status epilepticus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032867">
        <obo:IAO_0000115 xml:lang="cs">Refrakterní status epilepticus je definován jako status epilepticus pokračující navzdory dvěma vhodně zvoleným a dávkovaným antiepileptikům, včetně benzodiazepinu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Refrakterní status epilepticus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032867"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Refrakterní status epilepticus je definován jako status epilepticus pokračující navzdory dvěma vhodně zvoleným a dávkovaným antiepileptikům, včetně benzodiazepinu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Refractory status epilepticus is defined as status epilepticus continuing despite two appropriately selected and dosed antiepileptic drugs, including a benzodiazepine.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032867"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Refrakterní status epilepticus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Refractory status epilepticus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032868">
        <obo:IAO_0000115 xml:lang="cs">Superrefrakterní status epilepticus je definován jako refrakterní epileptický status trvající 24 hodin nebo déle po zahájení anestetické medikace, včetně případů, kdy je dosaženo kontroly záchvatů po aplikaci anestetik, ale znovu se objeví po přerušení podávané léčby.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Super- efrakterní status epilepticus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032868"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Superrefrakterní status epilepticus je definován jako refrakterní epileptický status trvající 24 hodin nebo déle po zahájení anestetické medikace, včetně případů, kdy je dosaženo kontroly záchvatů po aplikaci anestetik, ale znovu se objeví po přerušení podávané léčby.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Super-refractory status epilepticus is defined as refractory status epilepticus continuing for 24 h or more following initiation of anesthetic medications, including cases in which seizure control is attained after induction of anesthetic drugs but recurs on weaning the patient off the anesthetic agent.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032868"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Super- efrakterní status epilepticus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Super-refractory status epilepticus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032869">
        <obo:IAO_0000115 xml:lang="cs">Fokální nekonvulzivní status epilepticus bez poruchy vědomí je typ fokálního nekonvulzivního epileptického statu, při kterém je zachováno vědomí.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální nekonvulzivní status epilepticus bez poruchoy vědomí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032869"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální nekonvulzivní status epilepticus bez poruchy vědomí je typ fokálního nekonvulzivního epileptického statu, při kterém je zachováno vědomí.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal non-convulsive status epilepticus without impairment of consciousness is a type of focal non-convulsive status epilepticus in which awareness remains intact.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032869"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální nekonvulzivní status epilepticus bez poruchoy vědomí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal non-convulsive status epilepticus without impairment of consciousness</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032870">
        <obo:IAO_0000115 xml:lang="cs">Fokální kognitivní záchvat s dyslexií/alexií charakterizovaný poruchou věsomí v určitém okamžiku během záchvatu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kognitivní záchvat s dylexií/alexií a s poruchou vědomí</rdfs:label>
