        <obo:IAO_0000115 xml:lang="cs">Snížená koncentrace volného tyroxinu (fT4) v krevním oběhu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená koncentrace cirkulujícího volného T4</rdfs:label>
    </rdf:Description>
