        <babelon:source_value>Abnormal response to human chorionic gonadotrophin stimulation test</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031084">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně vysoké zvýšení hladin inzulínu po glukagonovém stimulačním testu</obo:IAO_0000115>
