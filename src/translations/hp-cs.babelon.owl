    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032844">
        <obo:IAO_0000115 xml:lang="cs">Typ fokálního epileptického záchvatu, při kterém je v určitém okamžiku během záchvatu narušeno vědomí</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální epileptické spasmy s poruchou vědomí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032844"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fokálního epileptického záchvatu, při kterém je v určitém okamžiku během záchvatu narušeno vědomí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of focal-onset epileptic spasm in which awareness is impaired at some point during the seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
