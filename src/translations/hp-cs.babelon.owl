        <owl:annotatedTarget xml:lang="cs">Odchylka od normálního rozmezí manganu v krevním oběhu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any deviation from the normal concentration of manganese cation in the blood circulation.</babelon:source_value>
