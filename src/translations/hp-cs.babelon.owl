    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032394">
        <obo:IAO_0000115 xml:lang="cs">Subkortikální heterotopie táhnoucí se podél mesiální strany postranních komor s přímým spojením s mesiální polymikrogyriální kůrou na přední a zadní hranici heterotopie.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mesiální parasagitální subkortikální heterotopie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032394"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Subkortikální heterotopie táhnoucí se podél mesiální strany postranních komor s přímým spojením s mesiální polymikrogyriální kůrou na přední a zadní hranici heterotopie.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Subcortical heterotopia extending along the mesial aspect of the lateral ventricles, with direct connection to mesial polymicrogyria-like cortex at the anterior and posterior limits of the heterotopia.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032394"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mesiální parasagitální subkortikální heterotopie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mesial parasagittal subcortical heterotopia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032395">
        <obo:IAO_0000115 xml:lang="cs">Velká subkortikální heterotopie proměnlivé morfologie s pruhy a víry. Vždy se alespoň na jednom, ale obvykle na více místech spojují s kůrou. Uvnitř heterotopie jsou obvykle patrné prostory s intenzitou signálu jako likvor.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kurvilineární subkortikální heterotopie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032395"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Velká subkortikální heterotopie proměnlivé morfologie s pruhy a víry. Vždy se alespoň na jednom, ale obvykle na více místech spojují s kůrou. Uvnitř heterotopie jsou obvykle patrné prostory s intenzitou signálu jako likvor.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Large subcortical heterotopia of variable morphology with streaks and swirls. These always connect to the overlying cortex in at least one, but usually in multiple, locations. Spaces with the signal intensity of CSF are usually seen within the heterotopia.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032395"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kurvilineární subkortikální heterotopie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Curvilinear subcortical heterotopia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032396">
        <obo:IAO_0000115 xml:lang="cs">Lineární heterotopie táhnoucí se od mozkové kůry od pia k ependymu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Transkorová vertikální heterotopie</rdfs:label>
