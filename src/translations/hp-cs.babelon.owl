        <owl:annotatedTarget xml:lang="cs">Týká se příznaku nebo symptomu, který se zhoršil nebo exacerboval v důsledku úrazu hlavy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Applies to a sign or symptom that is worsened, aggravated, or exacerbated by head trauma.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
