        <obo:IAO_0000115 xml:lang="cs">Infekce vlasového folikulu, která se rozšíří podkožně a vytvoří absces.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Furunkl</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020083"/>
