    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025578">
        <obo:IAO_0000115 xml:lang="cs">Prolaps aortální chlopně lze diagnostikovat, pokud jeden nebo oba cípy pravé nebo nekoronární aortální chlopně (viditelné v příčném echokardiografickém zobrazení v dlouhé ose) vykazují vyklenutí dozadu směrem k levé komoře za linii spojující místa připojení cípů aortální chlopně k anulu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Prolaps aortání chlopně</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025578"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Prolaps aortální chlopně lze diagnostikovat, pokud jeden nebo oba cípy pravé nebo nekoronární aortální chlopně (viditelné v příčném echokardiografickém zobrazení v dlouhé ose) vykazují vyklenutí dozadu směrem k levé komoře za linii spojující místa připojení cípů aortální chlopně k anulu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aortic valve prolapse can be diagnosed when either or both of the right or non-coronary aortic valve cusps (seen in the cross sectional echocardiographic long axis view) show backward bowing towards the left ventricle beyond a line joining the points of attachment of the aortic valve leaflets to the annulus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025578"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Prolaps aortání chlopně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aortic valve prolapse</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
