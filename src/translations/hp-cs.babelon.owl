    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031099">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli odchylka od normální koncentrace iInhibinů, což jsou heterodimerní proteinové hormony vylučované granulózními buňkami vaječníků u žen a Sertoliho buňkami varlat u mužů. Inhibiny potlačují sekreci hormonu stimulujícího folikuly hypofýzy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální hladina cirkulujícího inhibinu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031099"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoli odchylka od normální koncentrace iInhibinů, což jsou heterodimerní proteinové hormony vylučované granulózními buňkami vaječníků u žen a Sertoliho buňkami varlat u mužů. Inhibiny potlačují sekreci hormonu stimulujícího folikuly hypofýzy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any deviation from the normal concentration of inhibins, which are heterodimeric protein hormones secreted by granulosa cells of the ovary in females and Sertoli cells of the testis in males. Inhibins suppress the secretion of pituitary follicle-stimulating hormone.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
