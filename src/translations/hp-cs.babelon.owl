    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011599">
        <obo:IAO_0000115 xml:lang="cs">Mezokardie je abnormální lokalizace srdce, které se nacházi ve středové části hrudníku a jeho podélná osa leží ve středové sagitální rovině.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mezokardie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011599"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Mezokardie je abnormální lokalizace srdce, které se nacházi ve středové části hrudníku a jeho podélná osa leží ve středové sagitální rovině.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mesocardia is an abnormal location of the heart in which the heart is in a midline position and the longitudinal axis of the heart lies in the mid-sagittal plane.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011599"/>
