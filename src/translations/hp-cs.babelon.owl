        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031520">
        <obo:IAO_0000115 xml:lang="cs">Nepříjemný pocit charakterizovaný fyzickým nepohodlím (jako je píchání, pulzování nebo bolest), který má původ v třísle</obo:IAO_0000115>
