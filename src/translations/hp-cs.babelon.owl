    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010540">
        <obo:IAO_0000115 xml:lang="cs">Zvýšený stupeň pneumatizace v srovnání s věkově odpovídajícími normami</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pokročilá pneumatizace paranasálních dutin</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010540"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
