    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003302">
        <obo:IAO_0000115 xml:lang="cs">Kompletní bilaterální fraktury pars interarticularis obratlů vedoucí k anteriornímu posunu obratlů</obo:IAO_0000115>
