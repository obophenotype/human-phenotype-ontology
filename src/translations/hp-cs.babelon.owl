        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032356">
        <obo:IAO_0000115 xml:lang="cs">Abnormální snížení množství vzduchu, které může osoba vydechnout po maximálním vdechnutí, přičemž test se provádí před podáním bronchodilatačního léku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená usilovná vitální kapacita před bronchodilatací</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032356"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální snížení množství vzduchu, které může osoba vydechnout po maximálním vdechnutí, přičemž test se provádí před podáním bronchodilatačního léku.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal reduction in the amount of air a person can expel following maximal insipiration, with the test being performed before the administration of a bronchodilating medication.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
