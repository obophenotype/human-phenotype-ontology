        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011560">
        <obo:IAO_0000115 xml:lang="cs">Vrozená vada s neotevíráním ústí mitrální chlopně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mitrální atrézie</rdfs:label>
