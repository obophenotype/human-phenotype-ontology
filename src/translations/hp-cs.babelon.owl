    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011561">
        <obo:IAO_0000115 xml:lang="cs">Atrioventrikulární chlopeň, která vede do obou komor. Chlopeň nasedá na interventrikulární septum nad defektem septa komor.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nasedající atrioventrikulární chlopeň</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011561"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Atrioventrikulární chlopeň, která vede do obou komor. Chlopeň nasedá na interventrikulární septum nad defektem septa komor.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An atrioventricular valve that empties into both ventricles. The valve overrides the interventricular septum above a ventricular septum defect.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011561"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nasedající atrioventrikulární chlopeň</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Overriding atrioventricular valve</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011562">
        <obo:IAO_0000115 xml:lang="cs">Anomální úpon chordae tendinae nebo papilárních svalů do kontralaterální komory v přítomnosti defektu komorového septa</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Obkročná atrioventrikulární chlopeň</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011562"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomální úpon chordae tendinae nebo papilárních svalů do kontralaterální komory v přítomnosti defektu komorového septa</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anomalous insertion of the chordae tendinae or papillary muscles into the contralateral ventricle in the presence of a ventricular septum defect.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011562"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Obkročná atrioventrikulární chlopeň</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Straddling atrioventricular valve</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011563">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita oběhového spojení mezi komorami a pulomální arterií a aortou</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální ventrikuloarteriální spojení</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011563"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita oběhového spojení mezi komorami a pulomální arterií a aortou</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the circulatory connection between the ventricles and the pulmonary artery and aorta.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011563"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální ventrikuloarteriální spojení</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal ventriculoarterial connection</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011564">
        <obo:IAO_0000115 xml:lang="cs">Patologickou arkádu mitrální chlopně diagnostikujeme na základě náledovných znaků: 1) Adekvátně velké mitrální orifícium; 2) krátké, tlusté a málo diferencované šlašinky, přímý úpon papilárních svalů na cípy chlopně; 3) úzký nebo téměř neexistující prostor mezi abnormálními šlašinkami; 4) větší diferenciace šlašinek upínajících se na zadní papilární svaly.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Arkáda mitrální chlopně</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011564"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Patologickou arkádu mitrální chlopně diagnostikujeme na základě náledovných znaků: 1) Adekvátně velké mitrální orifícium; 2) krátké, tlusté a málo diferencované šlašinky, přímý úpon papilárních svalů na cípy chlopně; 3) úzký nebo téměř neexistující prostor mezi abnormálními šlašinkami; 4) větší diferenciace šlašinek upínajících se na zadní papilární svaly.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anomalous mitral valve arcade is diagnosed based on the following features (1) An adequately sized mitral valve orifice; (2) short, thick, and poorly differentiated chordae with direct union of the papillary muscles to the anterior leaflet; (3) narrow or nearly nonexistent spaces between the abnormal chordae; and (4) greater differentiation of the chordae attached to the posterior papillary muscle.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011564"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Arkáda mitrální chlopně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mitral valve arcade</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011565">
        <obo:IAO_0000115 xml:lang="cs">Úplná absence mezisíňové přepážky se společnou atrioventrikulární chlopní a dvěma atrioventrikulárními spojeními.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Společná předsíň</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011565"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Úplná absence mezisíňové přepážky se společnou atrioventrikulární chlopní a dvěma atrioventrikulárními spojeními.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complete absence of the interatrial septum with common atrioventricular valve and two atrioventricular connections.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011565"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Společná předsíň</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Common atrium</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011566">
        <obo:IAO_0000115 xml:lang="cs">Vrozená anomálie s rozdělením pravé síně vytvářející triatriální srdce v důsledku přetrvávání pravé chlopně sinus venosus. Typicky je přepážka pravé síně způsobena nadměrnou fetální Eustachovou a Thebesiho chlopní, které společně tvoří neúplé septum napříč spodní částí síně.Toto septum může být od retikulárního až po septum tvořené podstatnou vrstvou tkáně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Cor triatriatum dexter</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011566"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vrozená anomálie s rozdělením pravé síně vytvářející triatriální srdce v důsledku přetrvávání pravé chlopně sinus venosus. Typicky je přepážka pravé síně způsobena nadměrnou fetální Eustachovou a Thebesiho chlopní, které společně tvoří neúplé septum napříč spodní částí síně.Toto septum může být od retikulárního až po septum tvořené podstatnou vrstvou tkáně.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A congenital anomaly with partitioning of the right atrium to form a triatrial heart caused by persistence of the right valve of the sinus venosus. Typically, the right atrial partition is due to exaggerated fetal eustachian and thebesian valves, which together form an incomplete septum across the lower part of the atrium. This septum may range from a reticulum to a substantial sheet of tissue.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011566"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Cor triatriatum dexter</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cor triatriatum dexter</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011567">
        <obo:IAO_0000115 xml:lang="cs">Interatriální komunikace způsobená defekt společné stěny mezi vena cava superior a pravostrannou vena pulmonalis. Tento defekt je obvykle asociován s anomálním návratem jedné nebo vícera plicních žil, které vytváří ješte další levo-pravý zkrat.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Defekt síňového septa typu sinus venosus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011567"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Interatriální komunikace způsobená defekt společné stěny mezi vena cava superior a pravostrannou vena pulmonalis. Tento defekt je obvykle asociován s anomálním návratem jedné nebo vícera plicních žil, které vytváří ješte další levo-pravý zkrat.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An interatrial communication caused by a deficiency of the common wall between the superior vena cava (SVC) and the right-sided pulmonary veins. SVASD is commonly associated with anomalous pulmonary venous connection (APVC) of some or all of the pulmonary veins, which produces additional left-to-right shunting.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011567"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Defekt síňového septa typu sinus venosus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sinus venosus atrial septal defect</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011568">
        <obo:IAO_0000115 xml:lang="cs">Levá atrioventrikulární chlopeň je tvořena dvěma anatomicky odlíšenými otvory separovanými akcesorní fibrózní tkání.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mitrální chlopeň se dvěma otvory</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011568"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Levá atrioventrikulární chlopeň je tvořena dvěma anatomicky odlíšenými otvory separovanými akcesorní fibrózní tkání.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The left atrio-ventricular connection consists of two anatomically distinct orifices separated by accessory fibrous tissue.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011568"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mitrální chlopeň se dvěma otvory</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Double orifice mitral valve</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011569">
        <obo:IAO_0000115 xml:lang="cs">Rozštěp předního cípu mitrální chlopně, který není spojen s defektem atrioventrikulárního kanálu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Rozštěp předního cípu mitrální chlopně</rdfs:label>
