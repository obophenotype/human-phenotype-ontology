        <owl:annotatedTarget xml:lang="cs">Kontraktura metakarpofalangeálního kloubu 5. prstu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Contracture of the metacarpophalangeal joint of the 5th finger</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009187">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita distální falangy pátého prstu na ruce, kdy je falangeální kost obklopena epifýzou tvaru písmena C a její osifikací v proximodistálním směru</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Distální falanga 5. prstu na ruce ve tvaru písmena C</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009187"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita distální falangy pátého prstu na ruce, kdy je falangeální kost obklopena epifýzou tvaru písmena C a její osifikací v proximodistálním směru</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the distal phalanx of the fifth finger in which the epiphysis surrounds a phalangeal bone, having a bracket-like form and reaching from the proximal side of a phalanx to the distal side.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009187"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Distální falanga 5. prstu na ruce ve tvaru písmena C</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bracket epiphysis of the distal phalanx of the 5th finger</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009188">
        <obo:IAO_0000115 xml:lang="cs">Druhotné osifikační centrum v distálním falangu pátého prstu na ruce, které je odlišné od běžné epifýzy a které nepřispívá k longitudinálnímu růstu dlouhé kosti</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pseudoepifýza distálního falangu 5. prstu na ruce</rdfs:label>
    </rdf:Description>
