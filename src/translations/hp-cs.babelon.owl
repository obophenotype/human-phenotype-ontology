    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001259">
        <obo:IAO_0000115 xml:lang="cs">Kvantitativní porucha vědomí - absence vědomí, absence odpovědi na jakékoliv externí stimuly</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kóma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001259"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kvantitativní porucha vědomí - absence vědomí, absence odpovědi na jakékoliv externí stimuly</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The complete absence of wakefulness and consciousness, which is evident through a lack of response to any form of external stimuli.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001259"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kóma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Coma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001260">
        <obo:IAO_0000115 xml:lang="cs">Dysartrická řeč je všeobecný popis označující neurologickou poruchu řeči charakterizovanou špatnou artikulací. V závislosti na příslušné neurologické struktuře může být dysartrie dále klasifikována jako spastická, chabá, ataktická, hyperkinetická a hypokinetická nebo smíšená</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dysartrie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001260"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Dysartrická řeč je všeobecný popis označující neurologickou poruchu řeči charakterizovanou špatnou artikulací. V závislosti na příslušné neurologické struktuře může být dysartrie dále klasifikována jako spastická, chabá, ataktická, hyperkinetická a hypokinetická nebo smíšená</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dysarthric speech is a general description referring to a neurological speech disorder characterized by poor articulation. Depending on the involved neurological structures, dysarthria may be further classified as spastic, flaccid, ataxic, hyperkinetic and hypokinetic, or mixed.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001260"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Dysartrie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dysarthria</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001262">
        <obo:IAO_0000115 xml:lang="cs">Stav neobvykle silné touhy po spánku během dne</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nadměrná denní somnolence</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001262"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Stav neobvykle silné touhy po spánku během dne</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A state of abnormally strong desire for sleep during the daytime.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001262"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nadměrná denní somnolence</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Excessive daytime somnolence</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001263">
        <obo:IAO_0000115 xml:lang="cs">Zpoždění v dosahování motorických nebo psychických milníků rozvoje dítěte, včetně motorických dovedností, řeči a jazyka, kognitivních dovedností a sociálních a emočních dovedností. Tento termín by měl být používán pouze k popisu dětí mladších pěti let</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Celkové vývojové opoždění</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001263"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zpoždění v dosahování motorických nebo psychických milníků rozvoje dítěte, včetně motorických dovedností, řeči a jazyka, kognitivních dovedností a sociálních a emočních dovedností. Tento termín by měl být používán pouze k popisu dětí mladších pěti let</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A delay in the achievement of motor or mental milestones in the domains of development of a child, including motor skills, speech and language, cognitive skills, and social and emotional skills. This term should only be used to describe children younger than five years of age.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001263"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Celkové vývojové opoždění</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Global developmental delay</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001264">
        <obo:IAO_0000115 xml:lang="cs">Spasticita (neuromuskulární hypertonie) především ve svalech dolních končetin</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Spastická diplegie</rdfs:label>
