    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012646">
        <obo:IAO_0000115 xml:lang="cs">Varle, které se nachází v horní části šourku nebo spodní části tříselného kanálu a může být manuálně staženo do šourku bez odporu, ale kremasterický reflex ho vrátí do původní polohy</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Retraktilní varle</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012646"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Varle, které se nachází v horní části šourku nebo spodní části tříselného kanálu a může být manuálně staženo do šourku bez odporu, ale kremasterický reflex ho vrátí do původní polohy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A testis that is located at the upper scrotum or lower inguinal canal and that can be made to descend completely into the scrotum without resistance by manual reduction but returns to its original position by the cremasteric reflex.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
