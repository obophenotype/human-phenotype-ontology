    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025463">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita procesů, které udržují redoxní prostředí buňky nebo kompartmentu buňky, tzn. rovnováhu mezi redukčními a oxidačními chemickými reakcemi.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormalita redoxní aktivity</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025463"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita procesů, které udržují redoxní prostředí buňky nebo kompartmentu buňky, tzn. rovnováhu mezi redukčními a oxidačními chemickými reakcemi.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the processes that maintain the redox environment of a cell or compartment within a cell, that is, the balance between reduction and oxidation chemical reactions.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025463"/>
