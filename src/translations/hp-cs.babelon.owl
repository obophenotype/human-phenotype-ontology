        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000076"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vodění druhých lidí za ruku na místa, kam si přejí, aby se přesunuli, nebo vodění někoho za ruku k předmětům, s nimiž chtějí manipulovat.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Moving another person&apos;s hand, body part, or body to communicate a desire, e.g. pushing or pulling someone toward a desired object or placing someone&apos;s hand on something.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000076"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Komunikace vedním za ruku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Use of another person&apos;s body to communicate</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000077">
        <obo:IAO_0000115 xml:lang="cs">Fixní zájem o konkrétní téma, které je atypické pro sociální kontext jednotlivce, např. témata nesociální povahy, jako jsou fosilie nebo vysavače.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fixovaný zájem s abnormálním zaměřením</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000077"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fixní zájem o konkrétní téma, které je atypické pro sociální kontext jednotlivce, např. témata nesociální povahy, jako jsou fosilie nebo vysavače.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A fixated interest in a specific topic that is atypical for the social context of the individual, such as topics of a non-social nature like fossils or vacuum cleaners.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000077"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fixovaný zájem s abnormálním zaměřením</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fixated interest with abnormal focus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000078">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně intenzivní zájem o téma nebo objekt, který je typický pro sociální kontext postižené osoby.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fixovaný zájem abnormální intenzity</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000078"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně intenzivní zájem o téma nebo objekt, který je typický pro sociální kontext postižené osoby.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormally intense interest in a topic or object that is not atypical for the social context of the affected person.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000078"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fixovaný zájem abnormální intenzity</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fixated interest with abnormal intensity</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000079">
        <obo:IAO_0000115 xml:lang="cs">Neobvyklý zájem o smyslové aspekty prostředí.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vyhledávání smyslových vjemů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000079"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neobvyklý zájem o smyslové aspekty prostředí.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Unusual interest in sensory aspects of the environment.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000079"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Vyhledávání smyslových vjemů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sensory seeking</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000080">
        <obo:IAO_0000115 xml:lang="cs">Neschopnost člověka zahájit sociální interakce s ostatními. Aby sociální interakce byla někým iniciována, musela po určitou dobu existovat absence sociálních interakcí u některé z obou stran. Interakce musí také nebýt vyžádaná druhou stranou.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nedostatek sociálních iniciativ</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000080"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neschopnost člověka zahájit sociální interakce s ostatními. Aby sociální interakce byla někým iniciována, musela po určitou dobu existovat absence sociálních interakcí u některé z obou stran. Interakce musí také nebýt vyžádaná druhou stranou.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Failure of a person to initiate social interactions with others. For a social interaction to have been initiated by someone, there must have been an absence of social interactions from either party for a period. The interaction must also be unprompted from another party</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000080"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nedostatek sociálních iniciativ</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>obsolete 4000080</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000081">
        <obo:IAO_0000115 xml:lang="cs">Snížené používání typických neverbálních konverzačních gest, jako je zatřesení hlavou na znamení ne nebo kývnutí hlavou na znamení ano.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Omezené používání typických gest</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000081"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížené používání typických neverbálních konverzačních gest, jako je zatřesení hlavou na znamení ne nebo kývnutí hlavou na znamení ano.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Diminished use of typical non-verbal conversational gestures such as shaking the head to indicate no or nodding the head to indicate yes.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000081"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Omezené používání typických gest</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced production of gestures</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000082">
        <obo:IAO_0000115 xml:lang="cs">Zhoršení schopnosti dítěte hrát si způsobem, který zahrnuje spolupráci vrstevníků. Kolaborativní hra zahrnuje věci, jako je verbální a neverbální komunikace (např. sebou iniciované interakce), střídání se v činnosti, sdílení, reciprocita a společné řešení problémů. Často je to kontrastováno s paralelní hrou, která zahrnuje formu sociální hry, ve které dvě děti dělají podobné činnosti blízko sebe a často se navzájem napodobují. Typicky se vyvíjející děti rozvíjejí společnou hru ve věku 4 až 5 let.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Omezená kooperativní hra</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000082"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zhoršení schopnosti dítěte hrát si způsobem, který zahrnuje spolupráci vrstevníků. Kolaborativní hra zahrnuje věci, jako je verbální a neverbální komunikace (např. sebou iniciované interakce), střídání se v činnosti, sdílení, reciprocita a společné řešení problémů. Často je to kontrastováno s paralelní hrou, která zahrnuje formu sociální hry, ve které dvě děti dělají podobné činnosti blízko sebe a často se navzájem napodobují. Typicky se vyvíjející děti rozvíjejí společnou hru ve věku 4 až 5 let.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impairment in a child&apos;s ability to be able to play in a way that involves peer collaboration. Collaborative play involves things such as verbal and non-verbal communication (e.g., self-initiated interactions), turn-taking, sharing, reciprocity, and collaborative problem-solving. It is often contrasted to parallel play, which involves a form of social play in which two children do similar activities near each other and often mimic each other. Typically developing children develop collaborative play between the ages of 4 and 5.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000082"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Omezená kooperativní hra</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced cooperative play</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000083">
        <obo:IAO_0000115 xml:lang="cs">Nezájem jedince o vrstevníky srovnatelných věkových a sociálních skupin.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Absence zájmu o vrstevníky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000083"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nezájem jedince o vrstevníky srovnatelných věkových a sociálních skupin.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lack of interest in peers of comparable age and social groups is evident when an individual, such as a child, shows more interest in socializing with adults rather than children their own age.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000083"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Absence zájmu o vrstevníky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lack of interest in peers</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000084">
        <obo:IAO_0000115 xml:lang="cs">Snížení sdílení zájmů s ostatníma.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Omezené sdílení zájmů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000084"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížení sdílení zájmů s ostatníma.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An absence or abnormally low frequency of engaging with others to share personal interests or topics. Interest sharing includes offers of information about oneself as a form of social interaction.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000084"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Omezené sdílení zájmů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced sharing of interests</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000085">
        <obo:IAO_0000115 xml:lang="cs">Absence nebo omezení sdílení objektů. Sdílení objektů je raně se objevující sociální dovednost, ve které chce dítě sdílet předměty s rodiči nebo vrstevníky během hry s předměty. Sdílení objektů se obvykle rozvíjí během prvních dvou let života.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Omezené sdílení objektů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000085"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Absence nebo omezení sdílení objektů. Sdílení objektů je raně se objevující sociální dovednost, ve které chce dítě sdílet předměty s rodiči nebo vrstevníky během hry s předměty. Sdílení objektů se obvykle rozvíjí během prvních dvou let života.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An absence or reduction in object sharing. Object sharing is an early emerging social skill in which a child will share objects such as toys, balls, or books with parents or peers during object play.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000085"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Omezené sdílení objektů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced object sharing</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000087">
        <obo:IAO_0000115 xml:lang="cs">Abnormální výraza obličeje (pohyby nebo pozice svalů obličeje, které pozorovatelům zprostředkovávají emoční stav jedince) zahrnující abnormality kvantity, rozsahu, vhodnosti kontextu a kvality.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální používání mimiky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000087"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální výraza obličeje (pohyby nebo pozice svalů obličeje, které pozorovatelům zprostředkovávají emoční stav jedince) zahrnující abnormality kvantity, rozsahu, vhodnosti kontextu a kvality.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal expressions (movements or position of muscles of the face that convey the emotional state of an individual to observers during social interactions) comprising abnormalities of quantity, range, context-appropriateness, and quality.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000087"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální používání mimiky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal communicative facial expressions</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000088">
        <obo:IAO_0000115 xml:lang="cs">Produkce výrazů obličeje, které nejsou v souladu se sociálním kontextem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Výraz obličeje neodpovídající situaci</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000088"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Produkce výrazů obličeje, které nejsou v souladu se sociálním kontextem.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Production of facial expressions that are misaligned with the social context.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000088"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Výraz obličeje neodpovídající situaci</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Facial expressions that do not match the context</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000089">
        <obo:IAO_0000115 xml:lang="cs">Spontánní produkce komunikativních výrazů obličeje, které mají špatnou kvalitu nebo jsou vnímány jako zvláštní či mechanické. To může zahrnovat nepřesnou mimiku typických výrazů obličeje.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Atypický výraz obličeje</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000089"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Spontánní produkce komunikativních výrazů obličeje, které mají špatnou kvalitu nebo jsou vnímány jako zvláštní či mechanické. To může zahrnovat nepřesnou mimiku typických výrazů obličeje.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Spontaneous production of communicative facial expressions that have poor quality or are exaggerated or muted.</babelon:source_value>
