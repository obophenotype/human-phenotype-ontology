        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Severe intellectual disability</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010865">
        <obo:IAO_0000115 xml:lang="cs">Trvalý vzorec nespolupracujícího, vzdorovitého a nepřátelského chování vůči autoritám, do kterého nepatří závažné antisociální chování, není na vrub vývojové fázi dítěte a vede k významnému funkčnímu poškození. U dětí a dospívajících je běžná určitá míra opozičního chování.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Porucha opozičního vzdoru</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010865"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Trvalý vzorec nespolupracujícího, vzdorovitého a nepřátelského chování vůči autoritám, do kterého nepatří závažné antisociální chování, není na vrub vývojové fázi dítěte a vede k významnému funkčnímu poškození. U dětí a dospívajících je běžná určitá míra opozičního chování.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A pervasive and characteristic pattern of arguing, defiance, and hostility toward others, particularly authority figures, that goes beyond the occasional oppositionality seen as a normal behavior in individuals at a certain age, e.g., during child and adolescent development.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010865"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Porucha opozičního vzdoru</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Age-inappropriate oppositional behavior</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
