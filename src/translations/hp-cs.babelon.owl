    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000331">
        <obo:IAO_0000115 xml:lang="cs">Zkrácená vertikální vzdálenost mezi hranicí červeně dolního rtu a dolním pólem brady</obo:IAO_0000115>
