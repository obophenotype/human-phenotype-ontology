        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Double depressor palsy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020043">
        <obo:IAO_0000115 xml:lang="cs">Typ inkomitantního strabismu, při kterém se úhel odchylky mění podle toho, jak se pohled pacienta posouvá nahoru a/nebo dolů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vertikální inkomitantní strabismus</rdfs:label>
    </rdf:Description>
