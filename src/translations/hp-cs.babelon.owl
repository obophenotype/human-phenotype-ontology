    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100884">
        <obo:IAO_0000115 xml:lang="cs">Skolióza, která vzniká v důsledku rozdílné délky spodních končetin (což může být v důsledku hemihypertrofie nebo hemihypotrofie nohy) a vede k naklánění pánve. V případě neléčení může toto časem vést k rozvoji skoliózy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kompenzační skolióza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100884"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Skolióza, která vzniká v důsledku rozdílné délky spodních končetin (což může být v důsledku hemihypertrofie nebo hemihypotrofie nohy) a vede k naklánění pánve. V případě neléčení může toto časem vést k rozvoji skoliózy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A scoliosis which is the results of a difference in leg length (which might be due to hemihypertrophy or hemihypotrophy of a leg) and the resulting tilting of the pelvis. If untreated this will lead to the development of scoliosis over time.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
