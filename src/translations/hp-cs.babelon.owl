        <babelon:source_value>Tics</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100034">
        <obo:IAO_0000115 xml:lang="cs">Pohybové tiky postihující jednotlivé svalové skupiny</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Motorické tiky</rdfs:label>
