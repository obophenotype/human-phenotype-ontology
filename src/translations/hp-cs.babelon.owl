    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033344">
        <obo:IAO_0000115 xml:lang="cs">Pleura dlaždicovitého vzhledu charakterizovaná nepravidelnými hrbolky obklopenými sníženými liniemi nalezená při otevřené plicní biopsii. Způsobeno jizvením způsobujícím stažení interlobulárních přepážek tam, kde se vkládají do pleury.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Cobblestone pleura</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
