    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025470">
        <obo:IAO_0000115 xml:lang="cs">Ztráta vlasů způsobena abnormálním nárustem vlasů v dormantním - telogenním stádiu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Telogenní efluvium</rdfs:label>
