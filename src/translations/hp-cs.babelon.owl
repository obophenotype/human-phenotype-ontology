        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033172">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená tloušťka tricepsové kožní řasy, která se měří v polovině hřbetu paže.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená tloušťka kožní řasy tricepsu</rdfs:label>
    </rdf:Description>
