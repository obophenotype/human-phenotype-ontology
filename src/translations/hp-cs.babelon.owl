        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011762">
        <obo:IAO_0000115 xml:lang="cs">Typ adenomu hypofýzy, který produkuje hormon stimulující štítnou žlázu (TSH)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Adenom hypofýzy z tyreotropních buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011762"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
