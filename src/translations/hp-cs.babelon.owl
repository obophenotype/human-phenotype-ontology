    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500007">
        <obo:IAO_0000115 xml:lang="cs">Mnohočetné cysty podél okraje zornice, které vypadají jako kulovité nebo slzovité pigmentové léze nebo zvrásněné útvary vycházející ze zornicového okraje duhovky.`</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Iris flocculi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
