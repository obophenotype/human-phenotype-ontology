        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0008200"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ hyperparathyreoidizmu způsobený primární abnormalitou příštitných žláz (např. adenom, karcinom, hyperplázie). Primárně je hyperparathyreoidizmus asociován s hyperkalcemií.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of hyperparathyroidism caused by a primary abnormality of the parathyroid glands (e.g., adenoma, carcinoma, hyperplasia). Primary hyperparathyroidism is associated with hyercalcemia.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
