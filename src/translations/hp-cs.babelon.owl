    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012391">
        <obo:IAO_0000115 xml:lang="cs">Snížená intenzita svalových šlachových reflexů na horních končetinách. Reflexy jsou vyvolány natažením šlachy svalu, např. poklepem.</obo:IAO_0000115>
