    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002131">
        <obo:IAO_0000115 xml:lang="cs">Periodické záchvaty špatné koordinace a nerovnováhy, tj. epizody ataxie trvající obvykle od 10 minut do několika hodin nebo dnů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Epizodická ataxie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002131"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Periodické záchvaty špatné koordinace a nerovnováhy, tj. epizody ataxie trvající obvykle od 10 minut do několika hodin nebo dnů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Periodic spells of incoordination and imbalance, that is, episodes of ataxia typically lasting from 10 minutes to several hours or days.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
