        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025158">
        <obo:IAO_0000115 xml:lang="cs">Zvýšené množství autofluorescence v sítnici zjištěné autofluorescenčním zobrazením fundu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hyperautofluorescenční léze sítnice</rdfs:label>
