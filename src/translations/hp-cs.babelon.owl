        <obo:IAO_0000115 xml:lang="cs">Zánět žlučových cest postihující intrahepatální nebo extrahepatální část nebo obojí</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Cholangitida</rdfs:label>
    </rdf:Description>
