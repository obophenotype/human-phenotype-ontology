    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000870">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost neobvykle zvýšených hladin prolaktinu v krvi. Prolaktin je peptidový hormon produkovaný přední hypofýzou, hraje roli v období těhotenství a kojení</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená koncentrace cirkulujícího prolaktinu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000870"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost neobvykle zvýšených hladin prolaktinu v krvi. Prolaktin je peptidový hormon produkovaný přední hypofýzou, hraje roli v období těhotenství a kojení</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of abnormally increased levels of prolactin in the blood. Prolactin is a peptide hormone produced by the anterior pituitary gland that plays a role in breast development and lactation during pregnancy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000870"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená koncentrace cirkulujícího prolaktinu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased circulating prolactin concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000871">
        <obo:IAO_0000115 xml:lang="cs">Funkční deficit hypofýzy ovlivňující všechny hormony přední hypofýzy (růstový hormon, TSH, FSH, LH, ACTH, prolaktin)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Panhypopituitarismus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000871"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Funkční deficit hypofýzy ovlivňující všechny hormony přední hypofýzy (růstový hormon, TSH, FSH, LH, ACTH, prolaktin)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A pituitary functional deficit affecting all the anterior pituitary hormones (growth hormone, thyroid-stimulating hormone, follicle-stimulating hormone, luteinizing hormone, adrenocorticotropic hormone, and prolactin).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
