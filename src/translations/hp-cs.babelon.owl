        <rdfs:label xml:lang="cs">Akinezie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002304"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neschopnost iniciovat změnu činnosti nebo pohybu a rychle a snadno provádět běžné volní pohyby.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inability to initiate changes in activity or movement and to perform ordinary volitional movements rapidly and easily.</babelon:source_value>
