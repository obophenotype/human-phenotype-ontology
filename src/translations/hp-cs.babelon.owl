        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fetal cerebral parenchymal hemorrhage</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034212">
        <obo:IAO_0000115 xml:lang="cs">Typ fetálního intrakraniálního krvácení mimo samotnou mozkovou tkáň (do epidurálního, subdurálního nebo arachnoidálního prostoru)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fetální extraaxiální krvácení</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034212"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fetálního intrakraniálního krvácení mimo samotnou mozkovou tkáň (do epidurálního, subdurálního nebo arachnoidálního prostoru)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of fetal intracranial hemorrhage with bleeding that occurs within the skull but outside of the brain tissue itself (into the epidural, subdural, or arachnoid space).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034212"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fetální extraaxiální krvácení</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fetal extra-axial hemorrhage</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034213">
        <obo:IAO_0000115 xml:lang="cs">Typ fetálního intrakraniálního krvácení, které se vyskytuje v zadní jámě lebeční, což je část lebeční dutiny, která se nachází mezi foramen magnum a tentorium cerebelli a obsahuje mozkový kmen a mozeček</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fetální hemoragie fossa cerebri posterior</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034213"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fetálního intrakraniálního krvácení, které se vyskytuje v zadní jámě lebeční, což je část lebeční dutiny, která se nachází mezi foramen magnum a tentorium cerebelli a obsahuje mozkový kmen a mozeček</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of fetal intracranial hemorrhage that occurs in the posterior cranial fossa, which is the part of the cranial cavity that is located between the foramen magnum and tentorium cerebelli and contains the brainstem and cerebellum.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034213"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fetální hemoragie fossa cerebri posterior</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fetal posterior fossa hemorrhage</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034214">
        <obo:IAO_0000115 xml:lang="cs">Typ fetálního intraventrikulárního krvácení charakterizovaný jasným přeléváním krvácení do komor vyplňujících méně než 50 % laterální komory a bez ventrikulomegalie větší než 15 mm v příčném průměru laterální komorové síně</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fetální intraventrikulární krvácení bez ventrikulomegalie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034214"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fetálního intraventrikulárního krvácení charakterizovaný jasným přeléváním krvácení do komor vyplňujících méně než 50 % laterální komory a bez ventrikulomegalie větší než 15 mm v příčném průměru laterální komorové síně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of fetal intraventricular hemorrhage characterized by clear hemorrhage spillover to the ventricles filling less than 50% of the lateral ventricle and without ventriculomegaly of greater than 15 mm in the transverse diameter of the lateral ventricular atrium.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034214"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fetální intraventrikulární krvácení bez ventrikulomegalie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fetal intraventricular hemorrhage without ventriculomegaly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034215">
        <obo:IAO_0000115 xml:lang="cs">Typ fetálního intrakraniálního krvácení, které se vyskytuje v hemisféře mozečku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fetální krvácení do mozečkové hemisféry</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034215"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fetálního intrakraniálního krvácení, které se vyskytuje v hemisféře mozečku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of fetal intracranial hemorrhage that occurs in the hemisphere of the cerebellum.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034215"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fetální krvácení do mozečkové hemisféry</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fetal cerebellar hemisphere hemorrhage</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034216">
        <obo:IAO_0000115 xml:lang="cs">Typ fetálního intrakraniálního krvácení, které se vyskytuje ve vermis mozečku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fetální hemoragie vermis mozečku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034216"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fetálního intrakraniálního krvácení, které se vyskytuje ve vermis mozečku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of fetal intracranial hemorrhage that occurs in the vermis of the cerebellum.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034216"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fetální hemoragie vermis mozečku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fetal cerebellar vermis hemorrhage</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034217">
        <obo:IAO_0000115 xml:lang="cs">Neschopnost zobrazit močový měchýř plodu při cíleném prenatálním sonografickém vyšetření. Fetální měchýř lze zobrazit sonograficky jako středovou, tekutinou naplněnou strukturu v pánvi již v 10.-12. týdnu gestace. Normální plod se vyprázdní alespoň jednou za hodinu, ale nikdy úplně nevyprázdní močový měchýř. Fetální měchýř by měl být jednoznačně (a trvale) zobrazen po 13. týdnu těhotenství</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Sonograficky nezobrazený močový měchýř plodu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034217"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neschopnost zobrazit močový měchýř plodu při cíleném prenatálním sonografickém vyšetření. Fetální měchýř lze zobrazit sonograficky jako středovou, tekutinou naplněnou strukturu v pánvi již v 10.-12. týdnu gestace. Normální plod se vyprázdní alespoň jednou za hodinu, ale nikdy úplně nevyprázdní močový měchýř. Fetální měchýř by měl být jednoznačně (a trvale) zobrazen po 13. týdnu těhotenství</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inability to visualize the fetal bladder on targeted prenatal sonography examination. The fetal bladder can be visualized with sonography as a midline, fluid-filled structure in the pelvis as early as 10-12 weeks of gestation. The normal fetus voids at least once an hour but never completely empties the urinary bladder. The fetal bladdder should be consistently imaged after 13 weeks of gestation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034217"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Sonograficky nezobrazený močový měchýř plodu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sonographic non-visualized fetal bladder</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034218">
        <obo:IAO_0000115 xml:lang="cs">Typ fetálního intraventrikulárního krvácení (IVH) charakterizovaný přeléváním do komor se zaplavením 50 % nebo více jedné nebo obou laterálních komor, které se nahromadilo doprovázející ventrikulomegalii, ale bez zjevného poškození mozkového parenchymu. Tento typ IVH lze definovat jako průměr přesahující 15 mm v příčném průměru laterální komory, jak je zobrazován prenatální sonografií</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fetální intraventrikulární krvácení s ventrikulomegalii</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034218"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fetálního intraventrikulárního krvácení (IVH) charakterizovaný přeléváním do komor se zaplavením 50 % nebo více jedné nebo obou laterálních komor, které se nahromadilo doprovázející ventrikulomegalii, ale bez zjevného poškození mozkového parenchymu. Tento typ IVH lze definovat jako průměr přesahující 15 mm v příčném průměru laterální komory, jak je zobrazován prenatální sonografií</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of fetal intraventricular hemorrhage (IVH) characterized by spillover to ventricles with flooding of 50% or more of one or both lateral ventricles accrued accompanying ventriculomegaly, but with no apparent brain parenchymal injury. This type of IVH may be defined as a diameter exceeding 15 mm in the transverse diameter of the lateral ventricular atrium as visualiuzed by prenatal sonography.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034218"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fetální intraventrikulární krvácení s ventrikulomegalii</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fetal intraventricular hemorrhage with ventriculomegaly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034219">
        <obo:IAO_0000115 xml:lang="cs">Typ fetálního intraventrikulárního krvácení, které navíc zahrnuje krvácení ve velké části periventrikulárního parenchymu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fetální intraventrikulární krvácení s periventrikulárním krvácením</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034219"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fetálního intraventrikulárního krvácení, které navíc zahrnuje krvácení ve velké části periventrikulárního parenchymu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of fetal intraventricular hemorrhage that additionally includes hemorrhage in a large part of the periventricular parenchyma.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
