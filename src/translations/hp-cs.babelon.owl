    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004417">
        <obo:IAO_0000115 xml:lang="cs">Intermitentní klaudikace je příznakem periferního arteriálního okluze. Po překonání individuálně specifické vzdálenosti pacienti pociťují bolest nebo křeče v lýtkách, chodidlech nebo stehnech, které obvykle ustupují při klidném stoji.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Intermitentní klaudikace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004417"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Intermitentní klaudikace je příznakem periferního arteriálního okluze. Po překonání individuálně specifické vzdálenosti pacienti pociťují bolest nebo křeče v lýtkách, chodidlech nebo stehnech, které obvykle ustupují při klidném stoji.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Intermittent claudication is a symptom of peripheral arterial occlusive disease. After having walked over a distance which is individually characteristic, the patients experience pain or cramps in the calves, feet or thighs which typically subsides on standing still.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
