    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001061">
        <obo:IAO_0000115 xml:lang="cs">Onemocnění kůže s nadměrnou produkcí mazu pilosebaceózním aparátem vedoucí k vzniku otevřených komedonů, uzavřených komedonů a pustulárních nodulů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Akné</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001061"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Onemocnění kůže s nadměrnou produkcí mazu pilosebaceózním aparátem vedoucí k vzniku otevřených komedonů, uzavřených komedonů a pustulárních nodulů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A skin condition in which there is an increase in sebum secretion by the pilosebaceous apparatus associated with open comedones (blackheads), closed comedones (whiteheads), and pustular nodules (papules, pustules, and cysts).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001061"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Akné</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Acne</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001062">
        <obo:IAO_0000115 xml:lang="cs">Velká pigmentová léze o průměru 5-15 mm s nepravidelnými, špatně definovanými hranicemi se zářezy. Barva se může pohybovat od barvy opálené kůže až po tmavě hnědé či růžové</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Atypický névus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001062"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Velká pigmentová léze o průměru 5-15 mm s nepravidelnými, špatně definovanými hranicemi se zářezy. Barva se může pohybovat od barvy opálené kůže až po tmavě hnědé či růžové</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A large pigmented lesion measuring 5-15 mm in diameter with irregular, notched, and ill defined border and with color that may range from tan to dark brown to pink.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
