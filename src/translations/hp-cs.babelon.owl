        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004349"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Pokles kostní minerální denzity, což je množství hmoty na kubický centimetr kosti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduction of bone mineral density, that is, of the amount of matter per cubic centimeter of bones.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
