    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012390">
        <obo:IAO_0000115 xml:lang="cs">Malá trhlina v tenké, vlhké tkáni (sliznici), která lemuje konečník. Vypadá jako prasklina nebo řezná rána ve sliznici konečníku.</obo:IAO_0000115>
