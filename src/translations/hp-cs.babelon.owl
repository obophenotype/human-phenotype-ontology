    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100661">
        <obo:IAO_0000115 xml:lang="cs">Neuropatická porucha charakterizovaná epizodami intenzivní bolesti v obličeji, pocházející z trigeminálního nervu. Postižena může být jedna, dvě nebo všechny tři větve nervu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neuralgie trigeminu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
