    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000873">
        <obo:IAO_0000115 xml:lang="cs">Stav nadměrného příjmu vody a hypotonické (diluční) polyurie. Diabetes insipidus může být způsoben selháním uvolňování vazopresinu (AVP), v tom případě mluvíme o centrálním nebo neurogenním diabetes insipidus nebo se jedná o neschopnost ledvin reagovat na AVP a v tom případe mluvíme o nefrogenním diabetes insipidus</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Diabetes insipidus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000873"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Stav nadměrného příjmu vody a hypotonické (diluční) polyurie. Diabetes insipidus může být způsoben selháním uvolňování vazopresinu (AVP), v tom případě mluvíme o centrálním nebo neurogenním diabetes insipidus nebo se jedná o neschopnost ledvin reagovat na AVP a v tom případe mluvíme o nefrogenním diabetes insipidus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A state of excessive water intake and hypotonic (dilute) polyuria. Diabetes insipidus may be due to failure of vasopressin (AVP) release (central or neurogenic diabetes insipidus) or to a failure of the kidney to respond to AVP (nephrogenic diabetes insipidus).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000873"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Diabetes insipidus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Diabetes insipidus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
