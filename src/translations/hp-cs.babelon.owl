    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000340">
        <obo:IAO_0000115 xml:lang="cs">Sklon předního povrchu čela od vertikální osy více než 2 SD od normy (objektivně), nebo očividně nadměrně posteriorně sklopené čelo v laterálním pohledy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Šikmé čelo</rdfs:label>
    </rdf:Description>
