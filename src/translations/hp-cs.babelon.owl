        <owl:annotatedTarget xml:lang="cs">Zvýšená hladina kyseliny acetoctové v krevním oběhu. Kyselina acetoctová je jednou z převládajících ketolátek.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An increased level of acetoacetic acid in the blood circulation. Acetoacetic acid is one of the predominant ketone bodies.</babelon:source_value>
