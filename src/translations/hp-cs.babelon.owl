    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500047">
        <obo:IAO_0000115 xml:lang="cs">Lymfom, který zahrňuje slzní vak.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Lymfom slzního vaku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500047"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Lymfom, který zahrňuje slzní vak.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of lymphoma that involves the nasolacrimal sac.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500047"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Lymfom slzního vaku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nasolacrimal sac lymphoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500048">
        <obo:IAO_0000115 xml:lang="cs">Velmi častý jev u kterého vývod nazolakrimálního duktu v nosní dutině není dostatečně kanalizovaný v novorozeneckém období.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Opožděná kanalizace nazolakrimálního duktu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500048"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Velmi častý jev u kterého vývod nazolakrimálního duktu v nosní dutině není dostatečně kanalizovaný v novorozeneckém období.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A very common condition in which the extreme end of the nasolacrimal duct underneath the inferior turbinate fails to complete its canalization in the newborn period.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500048"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Opožděná kanalizace nazolakrimálního duktu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Delayed canalization of nasolacrimal duct</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500049">
        <obo:IAO_0000115 xml:lang="cs">Vaskulární onemocnění sítnice postihující nedonošené děti a může vést k slepotě</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Retinopatie nedonošených</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500049"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vaskulární onemocnění sítnice postihující nedonošené děti a může vést k slepotě</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An avascular or abnormally vascularized retina that occurs in premature infants and can lead to blindness.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500049"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Retinopatie nedonošených</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500050">
        <obo:IAO_0000115 xml:lang="cs">Cévy sítnice se zastaví a pak je přítomna lineární plochá bílá linie, která obvykle probíhá po obvodu vaskulární části sítnice.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Retinopatie nedonošených stádium 1</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500050"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Cévy sítnice se zastaví a pak je přítomna lineární plochá bílá linie, která obvykle probíhá po obvodu vaskulární části sítnice.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The retinal vessels stop and then a linear flat white line is present that usually runs the circumference of the vascular retina.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500050"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Retinopatie nedonošených stádium 1</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 1</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500051">
        <obo:IAO_0000115 xml:lang="cs">Hromadící se neovaskularizace zesiluje a projevuje se jako lineární hrbol. Neovaskularizace zůstává podél povrchu sítnice a neprostupuje mimo sítnici do kortikálního sklivce.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Retinopatie nedonošených stádium 2</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500051"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Hromadící se neovaskularizace zesiluje a projevuje se jako lineární hrbol. Neovaskularizace zůstává podél povrchu sítnice a neprostupuje mimo sítnici do kortikálního sklivce.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The accumulating neovascularization thickens and manifests as a linear bump. The neovascularization remains along the surface of the retina and does not extend off the retina into the cortical vitreous.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500051"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Retinopatie nedonošených stádium 2</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 2</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500052">
        <obo:IAO_0000115 xml:lang="cs">Neovaskularizace se hromadí na okraji vaskularizované sítnice a zasahuje do sklivce (také se nazývá extraretinální fibrózní proliferace). V případě zóny 2 a zóny 3 může mít tvar klobásy. V případě posteriornějšího onemocnění Zóny 1 se stadium 3 může jevit jako přímé rozšíření normálních sítnicových cév, které se však tangenciálně rozšiřují přes avaskulární sítnici.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Retinopatie nedonošených stádium 3</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500052"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neovaskularizace se hromadí na okraji vaskularizované sítnice a zasahuje do sklivce (také se nazývá extraretinální fibrózní proliferace). V případě zóny 2 a zóny 3 může mít tvar klobásy. V případě posteriornějšího onemocnění Zóny 1 se stadium 3 může jevit jako přímé rozšíření normálních sítnicových cév, které se však tangenciálně rozšiřují přes avaskulární sítnici.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The neovascularization accumulates at the edge of the vascularized retina and extends into the vitreous (also called extra retinal fibrosis proliferation). In cases of Zone 2 and Zone 3, this may be sausage shaped. In more posterior Zone 1 disease, the stage 3 can appear as a direct extension of the normal retinal vessels but extending tangentially over the avascular retina.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500052"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Retinopatie nedonošených stádium 3</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 3</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500053">
        <obo:IAO_0000115 xml:lang="cs">Zjizvená tkáň, která tvoří souvislou vrstvu vycházející z okraje vaskularizované sítnice. Tato zjizvená tkáň může růst směrem ke sklivcové bázi/ zadnímu pouzdru čočky, což může vést k trakci, zkreslení a dokonce k odchlípení.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Retinopatie nedonošených stádium 4</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500053"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zjizvená tkáň, která tvoří souvislou vrstvu vycházející z okraje vaskularizované sítnice. Tato zjizvená tkáň může růst směrem ke sklivcové bázi/ zadnímu pouzdru čočky, což může vést k trakci, zkreslení a dokonce k odchlípení.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Scar tissue that forms a continuous sheet coming up from the edge of the vascularized retina. This scar tissue can grow toward the vitreous base/posterior lens capsule resulting in traction, distortion, and even detachment.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500053"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Retinopatie nedonošených stádium 4</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 4</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500054">
        <obo:IAO_0000115 xml:lang="cs">Odchlípení, které zahrnuje periferní sítnici, ale nepostihuje žlutou skvrnu (makulu)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Retinopatie nedonošených stádium 4a</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500054"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Odchlípení, které zahrnuje periferní sítnici, ale nepostihuje žlutou skvrnu (makulu)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A detachment that involves the peripheral retina that does not extend into the macula.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500054"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Retinopatie nedonošených stádium 4a</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 4a</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500055">
        <obo:IAO_0000115 xml:lang="cs">Odchlípení, které zahrnuje kromě periferní sítnice i žlutou skvrnu. Odchlípení obvykle začíná v temporálním kvadrantu, i když může postihovat i nazální kvadrant</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Retinopatie nedonošených stádium 4b</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500055"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Odchlípení, které zahrnuje kromě periferní sítnice i žlutou skvrnu. Odchlípení obvykle začíná v temporálním kvadrantu, i když může postihovat i nazální kvadrant</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A detachment that involves the peripheral retina that involves the macula itself. The detachment usually starts in the temporal periphery although can also involve the nasal retina as well.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500055"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Retinopatie nedonošených stádium 4b</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 4b</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500056">
        <obo:IAO_0000115 xml:lang="cs">Trychtýřovité odchlípení od sítnice s celkovou trakcí ve všech čtyřech kvadrantech.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Retinopatie nedonošených stádium 5</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500056"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Trychtýřovité odchlípení od sítnice s celkovou trakcí ve všech čtyřech kvadrantech.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Funnel detachment from the retina with generally traction in all four quadrants.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500056"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Retinopatie nedonošených stádium 5</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 5</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500057">
        <obo:IAO_0000115 xml:lang="cs">Otevřené trychtýřovité odchlípení sítnice s celkovou trakcí ve všech čtyřech kvadrantech.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Retinopatie nedonošených stádium 5a</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500057"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Otevřené trychtýřovité odchlípení sítnice s celkovou trakcí ve všech čtyřech kvadrantech.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An open funnel detachment of the retina with generally traction in all four quadrants.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500057"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Retinopatie nedonošených stádium 5a</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 5a</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500058">
        <obo:IAO_0000115 xml:lang="cs">Uzavřené trychtýřovité odchlípení sítnice s celkovou trakcí ve všech čtyřech kvadrantech.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Retinopatie nedonošených stádium 5b</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500058"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Uzavřené trychtýřovité odchlípení sítnice s celkovou trakcí ve všech čtyřech kvadrantech.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A closed funnel detachment of the retina with generally traction in all four quadrants.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500058"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Retinopatie nedonošených stádium 5b</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 5b</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500059">
        <obo:IAO_0000115 xml:lang="cs">Retinopatie, která sahá od středu terče zrakového nervu do dvojnásobku vzdálenosti od středu terče zrakového nervu ke středu makuly.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Retinopatie nedonošených stádium I</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500059"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Retinopatie, která sahá od středu terče zrakového nervu do dvojnásobku vzdálenosti od středu terče zrakového nervu ke středu makuly.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy which extends from the center of the optic disc to twice the distance from the center of the optic disc to the center of the macula.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500059"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Retinopatie nedonošených stádium I</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity zone I</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500060">
        <obo:IAO_0000115 xml:lang="cs">Retinopatie, která se rozšiřuje centrifugálně od okraje zóny I až po nazální ora serrata.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Retinopatie nedonošených stádium II</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500060"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Retinopatie, která se rozšiřuje centrifugálně od okraje zóny I až po nazální ora serrata.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy which extends centrifugally from the edge of zone I to the nasal ora serrata.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500060"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Retinopatie nedonošených stádium II</owl:annotatedTarget>
