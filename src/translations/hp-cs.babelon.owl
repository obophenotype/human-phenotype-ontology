        <rdfs:label xml:lang="cs">Karcinom Vaterovy ampuly</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031524"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Karcinom vycházející z Vaterovy ampuly (známé také jako hepatopankreatický vývod), která vzniká spojením pankreatického vývodu a společného žlučovodu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A carcinoma originating in the ampulla of Vater (also known as the hepatopancreatic duct), which is formed by the union of the pancreatic duct and the common bile duct.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
