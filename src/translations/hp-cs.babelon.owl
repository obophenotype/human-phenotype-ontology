        <babelon:source_value>A congenital inclusion cysts that arises from ectodermal cells that normally form skin cells being left behind in the nervous system during development.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012096"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Intrakraniální epidermoidní cysta</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Intracranial epidermoid cyst</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012097">
        <obo:IAO_0000115 xml:lang="cs">Vrozená cysta, která vzniká inkluzí ektodermálně vázaných buněk v době uzávěru neurální trubice (3.-5. týden embryogeneze). Pouzdro dermoidních cyst se skládá z jednoduchého epitelu neseného kolagenem. V silnějších částech je výstelka doplněna dermis obsahující vlasové folikuly, mazové a apokrinní žlázy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Intrakraniální dermoidní cysta</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012097"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vrozená cysta, která vzniká inkluzí ektodermálně vázaných buněk v době uzávěru neurální trubice (3.-5. týden embryogeneze). Pouzdro dermoidních cyst se skládá z jednoduchého epitelu neseného kolagenem. V silnějších částech je výstelka doplněna dermis obsahující vlasové folikuly, mazové a apokrinní žlázy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A congenital inclusion cysts that arises from the inclusion of ectodermally committed cells at the time of neural tube closure (3rd-5th week of embryogenesis). The capsule of dermoid cysts consists of simple epithelium supported by collagen. In thicker parts, the lining is supplemented with dermis containing hair follicles, sebaceous glands, and apocrine glands.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012097"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Intrakraniální dermoidní cysta</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
