    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012884">
        <obo:IAO_0000115 xml:lang="cs">Zkroucení vejcovodu. Obvyklým projevem je náhlý začátek s ostrou, kolikovitou pánevní bolestí spojenou s nevolností, zvracením, střevními příznaky a obtížemi močového měchýře.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Torze vejcovodu</rdfs:label>
    </rdf:Description>
