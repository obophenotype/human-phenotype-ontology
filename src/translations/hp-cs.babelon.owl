        <obo:IAO_0000115 xml:lang="cs">Okrouhlý, jakoby oteklý obličej s depozity tuku v temporální fosse a tvářích, s dvojitou bradou.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Měsíčkovitý obličej</rdfs:label>
    </rdf:Description>
