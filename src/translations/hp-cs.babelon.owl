    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033061">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená aktivita koagulačního faktoru IX. Faktor IX, který je sám aktivován faktorem Xa nebo faktorem VIIa za vzniku faktoru IXa, aktivuje faktor X na faktor Xa.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená aktivita faktoru IX</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
