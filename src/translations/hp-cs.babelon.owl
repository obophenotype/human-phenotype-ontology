    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006929">
        <obo:IAO_0000115 xml:lang="cs">Poškození mozku související se snížením hladiny glukózy v krvi pod kritickou úroveň (kolem 30 mg/dl), což může vést ke zmatenosti, letargii a deliriu následovanému záchvaty a kómatem. Dlouhodobá hypoglykémie může vést k nevratnému poškození mozku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hypoglykemická encefalopatie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006929"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Poškození mozku související se snížením hladiny glukózy v krvi pod kritickou úroveň (kolem 30 mg/dl), což může vést ke zmatenosti, letargii a deliriu následovanému záchvaty a kómatem. Dlouhodobá hypoglykémie může vést k nevratnému poškození mozku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Brain damage related to a lowering of blood glucose below a critical level (around 30 mg/dl), which may lead to confusion, lethargy and delirium followed by seizures and coma. Prolonged hypoglycemia may lead to irreversible brain damage.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006929"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hypoglykemická encefalopatie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypoglycemic encephalopathy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006930">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost vývojové dysplázie kortexu (kůry) frontálního a parientálního laloku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Frontoparietální kortikální dysplazie</rdfs:label>
