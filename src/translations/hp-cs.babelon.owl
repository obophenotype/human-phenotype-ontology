        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007181">
        <obo:IAO_0000115 xml:lang="cs">Atrofie mezikostních svalů (včetně dlaňových ležících na přední straně záprstních kůstek, dorzálních svalů ruky, které leží mezi záprstními kůstkami, plantárních, které leží pod záprstními kostmi, a dorzálních, které se nacházejí mezi záprstními kostmi).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Atrofie interoseálních svalů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007181"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Atrofie mezikostních svalů (včetně dlaňových ležících na přední straně záprstních kůstek, dorzálních svalů ruky, které leží mezi záprstními kůstkami, plantárních, které leží pod záprstními kostmi, a dorzálních, které se nacházejí mezi záprstními kostmi).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrophy of the interosseus muscles (including the palmar interossei that lie on the anterior aspect of the metacarpals, the dorsal interosseus muscles of the hand, which lie between the intercarpals, the plantar interosseus muscles, which lie underneath the metatarsal bones, and the dorsal interossei, which are located between the metatarsal bones.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
