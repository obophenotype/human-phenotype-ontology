    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100770">
        <obo:IAO_0000115 xml:lang="cs">Nadměrně aktivní peristaltika (vlna kontrakce tubulárních orgánů gastrointestinálního traktu) vyznačující se nadměrnou rychlostí průchodu potravy žaludkem a střevem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hyperperistaltika</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100770"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nadměrně aktivní peristaltika (vlna kontrakce tubulárních orgánů gastrointestinálního traktu) vyznačující se nadměrnou rychlostí průchodu potravy žaludkem a střevem.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Excessively active peristalsis (wave of contraction of the tubular organs of the gastrointestinal tract) marked by excessive rapidity of the passage of food through the stomach and intestine.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
