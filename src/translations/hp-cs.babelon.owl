        <owl:annotatedTarget xml:lang="cs">Záněr intimy nebo celé stěny arteriae corticales radiatae (taktéž známých jako arteriae interlobulares) ledviny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inflammation of a the intima or the entire wall of cortical radial arteries (also known as the interlobular arteries) of the kidney.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033913"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Arteritida intimy/medie arteria corticalis radiata</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cortical radial artery medial/intimal arteriitis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033914">
        <obo:IAO_0000115 xml:lang="cs">Amorfní extracelulární látka ve vnitřní nebo střední vrstvě arteriae arcuatae ledvin. Barví se pozitivně konžskou červení s typicky jablkově zeleným dvojlomem na polarizační mikroskopii a 8-12 nm širokými fibrily v elektronové mikroskopii.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Amyloidóza intimy/medie arteria arcuata</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033914"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Amorfní extracelulární látka ve vnitřní nebo střední vrstvě arteriae arcuatae ledvin. Barví se pozitivně konžskou červení s typicky jablkově zeleným dvojlomem na polarizační mikroskopii a 8-12 nm širokými fibrily v elektronové mikroskopii.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Amorphous extracellular substance in the inner or middle layer of the arcuate arteries of the kidney. Congo-red positive with typically an apple green birerfingence on polarization microscopy, and 8-12 nm fibrils on electron microscopy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033914"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Amyloidóza intimy/medie arteria arcuata</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Arcuate artery intima/media amyloidosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033915">
        <obo:IAO_0000115 xml:lang="cs">Hromadění edematózní extracelulární matrix v intimě připomínající hlen. Tento znak se při barvení hematoxylinem a eozinem jeví jako bleděmodrý</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Intimální mukoidní edém arteria arcuata</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033915"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Hromadění edematózní extracelulární matrix v intimě připomínající hlen. Tento znak se při barvení hematoxylinem a eozinem jeví jako bleděmodrý</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Accumulation of edematous extracellular matrix in intima resembling mucus. This feature appears pale blue on hematoxylin and eosin staining.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
