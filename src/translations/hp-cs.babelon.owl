        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální bilateránlí klonické záchvaty</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal bilateral clonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032820">
        <obo:IAO_0000115 xml:lang="cs">Neonatální fokální klonický záchvat je typ novorozeneckého elektroklinického klonického záchvatu, kde převládajícím motorickým projevem jsou pravidelně se opakující záškuby zahrnující stejné svalové skupiny, ke kterým dochází na více místech.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální multifokální klonický záchvat (Neonatální multifokální klonické křeče)</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032820"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální fokální klonický záchvat je typ novorozeneckého elektroklinického klonického záchvatu, kde převládajícím motorickým projevem jsou pravidelně se opakující záškuby zahrnující stejné svalové skupiny, ke kterým dochází na více místech.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal focal clonic seizure is a type of neonatal electro-clinical clonic seizure where the predominant motor feature is a regularly repeating jerking involving the same muscle groups, which occurs at multiple sites.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032820"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální multifokální klonický záchvat (Neonatální multifokální klonické křeče)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal multifocal clonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032821">
        <obo:IAO_0000115 xml:lang="cs">Neonatální elektroklinický tonický záchvat je typ novorozeneckého elektroklinického motorického záchvatu, kde převládajícím motorickým projevem je trvalé zvýšení svalového tonu, obvykle fokální, které může být jednostranné nebo oboustranné a může trvat několik sekund až minut.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální elektroklinický tonický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032821"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický tonický záchvat je typ novorozeneckého elektroklinického motorického záchvatu, kde převládajícím motorickým projevem je trvalé zvýšení svalového tonu, obvykle fokální, které může být jednostranné nebo oboustranné a může trvat několik sekund až minut.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical tonic seizure is a type of neonatal electro-clinical motor seizure where the predominant motor feature is a sustained increase in muscle tone, usually focal, that can be unilateral or bilateral, and lasting a few seconds to minutes.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032821"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický tonický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical tonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032822">
        <obo:IAO_0000115 xml:lang="cs">Neonatální elektroklinický nemotorický autonomní záchvat je typem novorozeneckého elektroklinického záchvatu s převládajícími rysy autonomních změn, které zahrnují kardiovaskulární, pupilární, gastrointestinální, sudomotorické, vazomotorické a termoregulační funkce. Může se projevit jako apnoe.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální elektroklinický autonomní záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032822"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický nemotorický autonomní záchvat je typem novorozeneckého elektroklinického záchvatu s převládajícími rysy autonomních změn, které zahrnují kardiovaskulární, pupilární, gastrointestinální, sudomotorické, vazomotorické a termoregulační funkce. Může se projevit jako apnoe.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical non-motor autonomic seizure is a type of neonatal electro-clinical seizure with predominant features of autonomic alterations, involving cardiovascular, pupillary, gastrointestinal, sudomotor, vasomotor, and thermoregulatory functions. May present as apnea.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032822"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický autonomní záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical autonomic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032823">
        <obo:IAO_0000115 xml:lang="cs">Novorozenecký elektroklinický nemotorický záchvat se zárazem v chování je typ novorozeneckého elektroklinického záchvatu charakterizovaný zástavou aktivit, ztuhnutím, imobilizací, s nebo bez apnoe a/nebo jinými autonomními projevy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální elektroklinický záchvat se zárazem v chování</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032823"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Novorozenecký elektroklinický nemotorický záchvat se zárazem v chování je typ novorozeneckého elektroklinického záchvatu charakterizovaný zástavou aktivit, ztuhnutím, imobilizací, s nebo bez apnoe a/nebo jinými autonomními projevy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical non-motor seizure with behavior arrest is a type of neonatal electro-clinical seizure characterized by an arrest of activities, freezing, immobilization, with or without apnea and/or other autonomic manifestations.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032823"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický záchvat se zárazem v chování</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical seizure with behavior arrest</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032824">
        <obo:IAO_0000115 xml:lang="cs">Novorozenecký elektroklinický nemotorický záchvat se zárazem v chování je typ novorozeneckého elektroklinického záchvatu charakterizovaný zástavou aktivit, ztuhnutím, imobilizací, s nebo bez apnoe a/nebo jinými autonomními projevy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální fokální tonický záchvat (Neonatální fokální tonické křeče)</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032824"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Novorozenecký elektroklinický nemotorický záchvat se zárazem v chování je typ novorozeneckého elektroklinického záchvatu charakterizovaný zástavou aktivit, ztuhnutím, imobilizací, s nebo bez apnoe a/nebo jinými autonomními projevy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal focal tonic seizure is a type of neonatal electro-clinical tonic seizure with a focal sustained increase in muscle tone, lasting a few seconds to minutes.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032824"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální fokální tonický záchvat (Neonatální fokální tonické křeče)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal focal tonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032825">
        <obo:IAO_0000115 xml:lang="cs">Neonatální elektroklinický sekvenční motorický záchvat je typ novorozeneckého elektroklinického záchvatu, kde převládající projev nelze detekovat, protože záchvaty se projevují různými klinickými a elektrografickými příznaky, často mění lateralizace v průběhu záchvatu nebo mezi záchvaty.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální elektroklinický sekvenční záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032825"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický sekvenční motorický záchvat je typ novorozeneckého elektroklinického záchvatu, kde převládající projev nelze detekovat, protože záchvaty se projevují různými klinickými a elektrografickými příznaky, často mění lateralizace v průběhu záchvatu nebo mezi záchvaty.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical sequential motor seizure is a type of neonatal electro-clinical seizure where the predominant feature cannot be detected because of seizures presenting with a variety of clinical and electrographic signs, often changing lateralization within or between seizures.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032825"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický sekvenční záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical sequential seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032826">
        <obo:IAO_0000115 xml:lang="cs">Fokální neonatální elektroklinický sekvenční motorický záchvat je typ novorozeneckého elektroklinického záchvatu, kde převládající projev nelze detekovat, protože záchvaty se projevují různými klinickými a elektrografickými fokálními příznaky, často mění lateralizace v průběhu záchvatu nebo mezi záchvaty.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální neonatální sekvenční záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032826"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální neonatální elektroklinický sekvenční motorický záchvat je typ novorozeneckého elektroklinického záchvatu, kde převládající projev nelze detekovat, protože záchvaty se projevují různými klinickými a elektrografickými fokálními příznaky, často mění lateralizace v průběhu záchvatu nebo mezi záchvaty.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal neonatal electro-clinical sequential motor seizure is a type of neonatal electro-clinical seizure where the predominant feature cannot be detected because of seizures presenting with a variety of clinical and electrographic focal signs, often changing lateralization within or between seizures.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032826"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální neonatální sekvenční záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal neonatal sequential seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032827">
        <obo:IAO_0000115 xml:lang="cs">Multifokální neonatální elektroklinický sekvenční motorický záchvat je typem novorozeneckého elektroklinického záchvatu, kde převládající projev nelze detekovat neboť záchvaty se projevují různými klinickími a elektrografickými multifokálními příznaky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Multifokální neonatální sekvenční záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032827"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Multifokální neonatální elektroklinický sekvenční motorický záchvat je typem novorozeneckého elektroklinického záchvatu, kde převládající projev nelze detekovat neboť záchvaty se projevují různými klinickími a elektrografickými multifokálními příznaky.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Multifocal neonatal electro-clinical sequential motor seizure is a type of neonatal electro-clinical seizure where the predominant feature cannot be detected because of seizures presenting with a variety of clinical and electrographic multifocal signs.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032827"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Multifokální neonatální sekvenční záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Multifocal neonatal sequential seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032828">
        <obo:IAO_0000115 xml:lang="cs">Neonatální bilaterální symetrický tonický záchvat je typ novorozeneckého elektroklinického tonického záchvatu, kdy trvalé zvýšení svalového tonu, trvající několik sekund až minut, se vyskytuje na obou stranách těla symetricky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální bilateránlí symetrický tonický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032828"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální bilaterální symetrický tonický záchvat je typ novorozeneckého elektroklinického tonického záchvatu, kdy trvalé zvýšení svalového tonu, trvající několik sekund až minut, se vyskytuje na obou stranách těla symetricky.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal bilateral symmetric tonic seizure is a type of neonatal electro-clinical tonic seizure where the sustained increase in muscle tone, lasting a few seconds to minutes, occurs at both sides of the body symmetrically.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032828"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální bilateránlí symetrický tonický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal bilateral symmetric tonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032829">
        <obo:IAO_0000115 xml:lang="cs">Neonatální elektroklinický motorický záchvat s automatismy je typ novorozeneckého elektroklinického záchvatu, kde EEG nález koreluje s koordinovanou motorickou aktivitou, typicky orální, obvykle s poruchou vědomí a dalšími projevy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální elektroklinický motorický záchvat s automatizmy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032829"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický motorický záchvat s automatismy je typ novorozeneckého elektroklinického záchvatu, kde EEG nález koreluje s koordinovanou motorickou aktivitou, typicky orální, obvykle s poruchou vědomí a dalšími projevy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical motor seizure with automatism is a type of neonatal electro-clinical seizure where the electrographic event is correlated with a coordinated motor activity, typically oral, usually with impaired awareness, and in association with other features.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032829"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický motorický záchvat s automatizmy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical motor seizure with automatism</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032830">
        <obo:IAO_0000115 xml:lang="cs">Neonatální elektroklinický motorický záchvat s automatismy je typ novorozeneckého elektroklinického záchvatu, kde EEG nález koreluje s koordinovanou motorickou aktivitou, typicky orální, vyskytující se na obou stranách těla asymetricky. Obvykle bývá doprovázen poruchou vědomí.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální záchvat s oboustrannými asymetrickými automatismy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032830"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický motorický záchvat s automatismy je typ novorozeneckého elektroklinického záchvatu, kde EEG nález koreluje s koordinovanou motorickou aktivitou, typicky orální, vyskytující se na obou stranách těla asymetricky. Obvykle bývá doprovázen poruchou vědomí.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal seizure with bilateral asymmetric automatism is a type of neonatal electro-clinical seizure where the electrographic event is correlated with coordinated motor activity, typically oral, usually with impaired awareness, occurring at both sides of the body asymmetrically.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032830"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální záchvat s oboustrannými asymetrickými automatismy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal seizure with bilateral asymmetric automatism</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032831">
        <obo:IAO_0000115 xml:lang="cs">Novorozenecký bilaterální asymetrický tonický záchvat je typ novorozeneckého elektroklinického tonického záchvatu, kdy trvalé zvýšení svalového tonu, trvající několik sekund až minut, se vyskytuje na obou stranách těla, ale asymetricky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální bilateránlí asymetrický tonický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032831"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Novorozenecký bilaterální asymetrický tonický záchvat je typ novorozeneckého elektroklinického tonického záchvatu, kdy trvalé zvýšení svalového tonu, trvající několik sekund až minut, se vyskytuje na obou stranách těla, ale asymetricky.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal bilateral asymmetric tonic seizure is a type of neonatal electro-clinical tonic seizure where the sustained increase in muscle tone, lasting a few seconds to minutes, occurs at both sides of the body but asymmetrically.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032831"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální bilateránlí asymetrický tonický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal bilateral asymmetric tonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032832">
        <obo:IAO_0000115 xml:lang="cs">Neonatální bilaterální asymetrický myoklonický záchvat je typ neonatálního elektroklinického motorického záchvatu, jehož převládajícím motorickým projevem je náhlá, krátká (&lt;100 msec) mimovolní jednotlivá nebo vícenásobná kontrakce svalů nebo svalových skupin s různou topografií (axiální, proximální končetiny, distální), která se vyskytuje na obou stranách těla asymetricky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální bilateránlí asymetrický myoklonický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032832"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální bilaterální asymetrický myoklonický záchvat je typ neonatálního elektroklinického motorického záchvatu, jehož převládajícím motorickým projevem je náhlá, krátká (&lt;100 msec) mimovolní jednotlivá nebo vícenásobná kontrakce svalů nebo svalových skupin s různou topografií (axiální, proximální končetiny, distální), která se vyskytuje na obou stranách těla asymetricky.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal bilateral asymmetric myoclonic seizure is a type of neonatal electro-clinical motor seizure where the predominant motor feature is sudden, brief (&lt;100 msec) involuntary single or multiple contraction of muscles or muscle groups of variable topography (axial, proximal limb, distal) that occurs at both sides of the body asymmetrically.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032832"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální bilateránlí asymetrický myoklonický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal bilateral asymmetric myoclonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032833">
        <obo:IAO_0000115 xml:lang="cs">Náhlá flexe, extenze nebo smíšená extenze a flexe převážně proximálních a trunkálních svalů, která je obvykle delší než myoklonický pohyb, ale ne tak dlouhá jako tonický záchvat. Mohou se objevit diskrétnější formy: grimasování, kývání hlavou nebo jemné pohyby očí. Projevy mohou být nakupeny.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální epileptické spasmy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032833"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Náhlá flexe, extenze nebo smíšená extenze a flexe převážně proximálních a trunkálních svalů, která je obvykle delší než myoklonický pohyb, ale ne tak dlouhá jako tonický záchvat. Mohou se objevit diskrétnější formy: grimasování, kývání hlavou nebo jemné pohyby očí. Projevy mohou být nakupeny.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A sudden flexion, extension, or mixed extension-flexion of predominantly proximal and truncal muscles that is usually more sustained than a myoclonic movement but not as sustained as a tonic seizure. Limited forms may occur: grimacing, head nodding, or subtle eye movements. May occur in clusters.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032833"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální epileptické spasmy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal epileptic spasm</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032834">
        <obo:IAO_0000115 xml:lang="cs">Neonatální záchvat s oboustrannými asymetrickými automatismy je typ novorozeneckého elektroklinického záchvatu, kdy elektrografická aktivita koreluje s koordinovanou motorickou aktivitou, obvykle orální, vyskytující se na jedné straně těla. Záchvat je obvykle provázen poruchou vědomí.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Novorozenecký záchvat s jednostrannými automatismy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032834"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální záchvat s oboustrannými asymetrickými automatismy je typ novorozeneckého elektroklinického záchvatu, kdy elektrografická aktivita koreluje s koordinovanou motorickou aktivitou, obvykle orální, vyskytující se na jedné straně těla. Záchvat je obvykle provázen poruchou vědomí.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal seizure with bilateral asymmetric automatisms is a type of neonatal electro-clinical seizure where the electrographic event is correlated with a coordinated motor activity, typically oral, usually with impaired awareness, occurring at one side of the body.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032834"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Novorozenecký záchvat s jednostrannými automatismy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal seizure with unilateral automatism</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032835">
        <obo:IAO_0000115 xml:lang="cs">Neonatální záchvat s oboustrannými asymetrickými automatismy je typ novorozeneckého elektroklinického záchvatu, kdy elektrografická aktivita koreluje s koordinovanou motorickou aktivitou, typicky orální, vyskytující se na obou stranách těla symetricky. Záchvat je obvykle provázen poruchou vědomí.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální záchvat s oboustrannými symetrickými automatismy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032835"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální záchvat s oboustrannými asymetrickými automatismy je typ novorozeneckého elektroklinického záchvatu, kdy elektrografická aktivita koreluje s koordinovanou motorickou aktivitou, typicky orální, vyskytující se na obou stranách těla symetricky. Záchvat je obvykle provázen poruchou vědomí.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal seizure with bilateral asymmetric automatism is a type of neonatal electro-clinical seizure where the electrographic event is correlated with a coordinated motor activity, typically oral, usually with impaired awareness, occurring at both sides of the body symmetrically.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032835"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální záchvat s oboustrannými symetrickými automatismy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal seizure with bilateral symmetric automatism</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032836">
        <obo:IAO_0000115 xml:lang="cs">Neonatálbí bilaterální symetrický myoklonický záchvat je typ novorozeneckého elektroklinického motorického záchvatu, jehož převládajícím motorickým projevem je náhlá, krátká (&lt;100 msec) mimovolní jednotlivá nebo vícenásobná kontrakce svalů nebo svalových skupin s různou topografií (axiální, proximální končetiny, distální), která se vyskytuje na obou stranách těla symetricky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální bilateránlí symetrický myoklonický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032836"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatálbí bilaterální symetrický myoklonický záchvat je typ novorozeneckého elektroklinického motorického záchvatu, jehož převládajícím motorickým projevem je náhlá, krátká (&lt;100 msec) mimovolní jednotlivá nebo vícenásobná kontrakce svalů nebo svalových skupin s různou topografií (axiální, proximální končetiny, distální), která se vyskytuje na obou stranách těla symetricky.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal bilateral symmetric myoclonic seizure is a type of neonatal electro-clinical motor seizure where the predominant motor feature is sudden, brief (&lt;100 msec) involuntary single or multiple contraction of muscles or muscle groups of variable topography (axial, proximal limb, distal) that occurs at both sides of the body symmetrically.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032836"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální bilateránlí symetrický myoklonický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal bilateral symmetric myoclonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032837">
        <obo:IAO_0000115 xml:lang="cs">Asymetrický neonatální elektroklinický sekvenční motorický záchvat je typ novorozeneckého elektroklinického záchvatu, kde převládající projev nelze detekovat, protože záchvaty se projevují různými klinickými a elektrografickými příznaky, často mění lateralizace v průběhu záchvatu nebo mezi záchvaty.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Bilaterální neonatální asymetrický skvenční záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032837"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Asymetrický neonatální elektroklinický sekvenční motorický záchvat je typ novorozeneckého elektroklinického záchvatu, kde převládající projev nelze detekovat, protože záchvaty se projevují různými klinickými a elektrografickými příznaky, často mění lateralizace v průběhu záchvatu nebo mezi záchvaty.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Asymmetric neonatal electro-clinical sequential motor seizure is a type of neonatal electro-clinical seizure where the predominant feature cannot be detected because of seizures presenting asymmetrically with a variety of clinical and electrographic signs, often changing lateralization within or between seizures.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032837"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Bilaterální neonatální asymetrický skvenční záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bilateral asymmetric neonatal sequential seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032838">
        <obo:IAO_0000115 xml:lang="cs">Neonatální jednostranný epileptický spasmus je náhlá flexe, extenze nebo smíšená extenze-flexe převážně proximálních a trunkálních svalů, která se vyskytuje na jedné straně těla.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální jednostranné epileptické spasmy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032838"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální jednostranný epileptický spasmus je náhlá flexe, extenze nebo smíšená extenze-flexe převážně proximálních a trunkálních svalů, která se vyskytuje na jedné straně těla.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal unilateral epileptic spasm is a sudden flexion, extension, or mixed extension-flexion of predominantly proximal and truncal muscles that occurs at one side of the body.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032838"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální jednostranné epileptické spasmy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal unilateral epileptic spasm</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032839">
        <obo:IAO_0000115 xml:lang="cs">Symetrický novorozenecký elektroklinický sekvenční motorický záchvat je typ novorozeneckého elektroklinického záchvatu, u kterého nelze zjistit převažující projev, protože záchvaty se projevují sice symetricky, ale s různými klinickými a elektrografickými příznaky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Bilaterální neonatální symetrický skvenční záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032839"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Symetrický novorozenecký elektroklinický sekvenční motorický záchvat je typ novorozeneckého elektroklinického záchvatu, u kterého nelze zjistit převažující projev, protože záchvaty se projevují sice symetricky, ale s různými klinickými a elektrografickými příznaky.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Symmetric neonatal electro-clinical sequential motor seizure is a type of neonatal electro-clinical seizure where the predominant feature cannot be detected because of seizures presenting symmetrically but with a variety of clinical and electrographic signs.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032839"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Bilaterální neonatální symetrický skvenční záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bilateral symmetric neonatal sequential seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032840">
        <obo:IAO_0000115 xml:lang="cs">Neonatální bilaterální symetrický epileptický spasmus je náhlá flexe, extenze nebo smíšená extenze-flexe převážně proximálních a trunkálních svalů, která se vyskytuje symetricky na obou stranách těla.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální oboustranné epileptické spasmy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032840"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální bilaterální symetrický epileptický spasmus je náhlá flexe, extenze nebo smíšená extenze-flexe převážně proximálních a trunkálních svalů, která se vyskytuje symetricky na obou stranách těla.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal bilateral symmetric epileptic spasm is a sudden flexion, extension, or mixed extension-flexion of predominantly proximal and truncal muscles that occurs symmetrically at both sides of the body.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
