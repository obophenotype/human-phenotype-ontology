        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of status epilepticus without prominent motor symptoms and in the presence of coma.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032659"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nekonvulzivní status epilepticus s kómatem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Non-convulsive status epilepticus with coma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032660">
        <obo:IAO_0000115 xml:lang="cs">Typ epileptického statu charakterizovaný prolongovaným oboustranným tonicko-klonickým záchvatem nebo opakovanými oboustrannými tonicko-klonickými záchvaty bez zotavení mezi nimi</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Konvulzivní status epilepticus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032660"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ epileptického statu charakterizovaný prolongovaným oboustranným tonicko-klonickým záchvatem nebo opakovanými oboustrannými tonicko-klonickými záchvaty bez zotavení mezi nimi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of status epilepticus characterized by a prolonged bilateral tonic-clonic seizure, or repeated bilateral tonic-clonic seizures without recovery between.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032660"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Konvulzivní status epilepticus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Convulsive status epilepticus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032661">
        <obo:IAO_0000115 xml:lang="cs">Typ oboustranného konvulzivního záchvatu s generalizovaným začátkem, který trvá dostatečně dlouho (nebo se opakuje bez zotavení), aby mohl být hodnocen jako status epilepticus.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Generalizovaný konvulzivní status epilepticus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032661"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ oboustranného konvulzivního záchvatu s generalizovaným začátkem, který trvá dostatečně dlouho (nebo se opakuje bez zotavení), aby mohl být hodnocen jako status epilepticus.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of bilateral convulsive seizure of generalized onset that is sufficiently prolonged (or repeated without recovery) to reach the threshold for status epilepticus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032661"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Generalizovaný konvulzivní status epilepticus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Generalized convulsive status epilepticus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032662">
        <obo:IAO_0000115 xml:lang="cs">Typ oboustranného konvulzivního záchvatu s fokálním začátkem (který může být bez poruchy vědomí nebo s poruchou vědomí, motorický nebo nemotorický), který trvá dostatečně dlouho (nebo se opakuje bez zotavení), aby mohl být hodnocen jako status epilepticus.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální záchvat přecházející v oboustranný konvulzivní status epilepticus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032662"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ oboustranného konvulzivního záchvatu s fokálním začátkem (který může být bez poruchy vědomí nebo s poruchou vědomí, motorický nebo nemotorický), který trvá dostatečně dlouho (nebo se opakuje bez zotavení), aby mohl být hodnocen jako status epilepticus.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of bilateral convulsive seizure of focal onset (which could be with awareness or impaired awareness, either motor or non- motor) that is sufficiently prolonged (or repeated without recovery) to reach the threshold for status epilepticus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032662"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální záchvat přecházející v oboustranný konvulzivní status epilepticus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal-onset seizure evolving into bilateral convulsive status epilepticus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032663">
        <obo:IAO_0000115 xml:lang="cs">Status epilepticus s fokálními motorickými příznaky v rámci sítí omezených na jednu hemisféru. Zahrnuje svalstvo v jakékoli formě. Motorická událost může spočívat ve zvýšení (pozitivní) nebo snížení (negativní) svalové kontrakce, která vyvolá pohyb.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální motorický status epilepticus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032663"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Status epilepticus s fokálními motorickými příznaky v rámci sítí omezených na jednu hemisféru. Zahrnuje svalstvo v jakékoli formě. Motorická událost může spočívat ve zvýšení (pozitivní) nebo snížení (negativní) svalové kontrakce, která vyvolá pohyb.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Status epilepticus with focal motor signs originating within networks limited to one hemisphere. Involves musculature in any form. The motor event could consist of an increase (positive) or decrease (negative) in muscle contraction to produce a movement.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032663"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální motorický status epilepticus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal motor status epilepticus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032664">
        <obo:IAO_0000115 xml:lang="cs">Typ fokálního motorického epileptického statu charakterizovaný nepřetržitou rotací krku nebo těla a konjugovanou úchylkou pohledu ve směru kontralaterálním k odpovědnému epileptickému ložisku. Patří sem některé formy tonického status epilepticus</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Adverzivní status epilepticus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032664"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fokálního motorického epileptického statu charakterizovaný nepřetržitou rotací krku nebo těla a konjugovanou úchylkou pohledu ve směru kontralaterálním k odpovědnému epileptickému ložisku. Patří sem některé formy tonického status epilepticus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of focal motor status epilepticus characterized by continuous neck or body rotation and conjugate gaze deviation in a direction contralateral to the responsible epileptic focus. This includes some forms of tonic status epilepticus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032664"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Adverzivní status epilepticus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Adversive status epilepticus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032665">
        <obo:IAO_0000115 xml:lang="cs">Typ fokálního motorického epileptického statu charakterizovaný opakovanými motorickými, obvykle klonickými příhodami opakovaně postihujícími stejné segmenty těla s šířením klonických pohybů přilehlými částmi těla jednostranně a opakujícími se po dostatečně dlouhou dobu, aby bylo možné stanovit diagnózu status epilepticus.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Opakovaný fokální motorický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032665"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fokálního motorického epileptického statu charakterizovaný opakovanými motorickými, obvykle klonickými příhodami opakovaně postihujícími stejné segmenty těla s šířením klonických pohybů přilehlými částmi těla jednostranně a opakujícími se po dostatečně dlouhou dobu, aby bylo možné stanovit diagnózu status epilepticus.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of focal motor status epilepticus characterized by repeated motor, typically clonic events repeatedly affecting the same segments of the body with spread of clonic movements through contiguous body parts unilaterally, and repeating over a sufficiently prolonged period to reach a diagnosis of status epilepticus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032665"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Opakovaný fokální motorický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Repeated focal motor seizures</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032666">
        <obo:IAO_0000115 xml:lang="cs">Status epilepticus charakterizovaný nepřetržitými hyperkinetickými pohyby proximálních končetin nebo axiálních svalů, které vytvářejí nepravidelné sekvenční balistické pohyby, jako je šlapání, mlácení nebo kývání.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hyperkinetický status epilepticus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032666"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Status epilepticus charakterizovaný nepřetržitými hyperkinetickými pohyby proximálních končetin nebo axiálních svalů, které vytvářejí nepravidelné sekvenční balistické pohyby, jako je šlapání, mlácení nebo kývání.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Status epilepticus characterized by continuous hyperkinetic proximal limb or axial muscles producing irregular sequential ballistic movements such as pedaling pelvic thrusting, thrashing, or rocking movements.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032666"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hyperkinetický status epilepticus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hyperkinetic status epilepticus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032667">
        <obo:IAO_0000115 xml:lang="cs">Typ motorického epileptického statu s opakujícími se oboustrannými náhlými krátkými (méně než 100 ms) mimovolními jednotlivými nebo vícenásobnými kontrakcemi svalů nebo svalových skupin s proměnlivou topografií.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Myoklonický status epilepticus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032667"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ motorického epileptického statu s opakujícími se oboustrannými náhlými krátkými (méně než 100 ms) mimovolními jednotlivými nebo vícenásobnými kontrakcemi svalů nebo svalových skupin s proměnlivou topografií.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of motor status epilepticus with repeating bilateral sudden brief (less than 100 ms) involuntary single or multiple contraction of muscles or muscle groups of variable topography.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032667"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Myoklonický status epilepticus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Myoclonic status epilepticus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032668">
        <obo:IAO_0000115 xml:lang="cs">Typ myoklonického epileptického statu bez kómatu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Myoklonický epileptický status bez kómatu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032668"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ myoklonického epileptického statu bez kómatu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of myoclonic status epilepticus in the absence of coma.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032668"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Myoklonický epileptický status bez kómatu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Myoclonic status epilepticus without coma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032669">
        <obo:IAO_0000115 xml:lang="cs">Typ myoklonického epileptického statu s kómatem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Myoklonický epileptický status s kómatem</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032669"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ myoklonického epileptického statu s kómatem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of myoclonic status epilepticus in the presence of coma.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032669"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Myoklonický epileptický status s kómatem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Myoclonic status epilepticus with coma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032670">
        <obo:IAO_0000115 xml:lang="cs">Tonický epileptický status je typ status epilepticus charakterizovaný fokálním nebo bilaterálním ztuhnutím nebo elevací končetin, které může být elektrograficky generalizované nebo fokální.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Tonický status epilepticus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032670"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Tonický epileptický status je typ status epilepticus charakterizovaný fokálním nebo bilaterálním ztuhnutím nebo elevací končetin, které může být elektrograficky generalizované nebo fokální.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tonic status epilepticus is a type of status epilepticus characterized by focal or bilateral limb stiffening or elevation, which may be electrographically generalized or focal.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032670"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Tonický status epilepticus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tonic status epilepticus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032671">
        <obo:IAO_0000115 xml:lang="cs">Typ epileptického statu bez výrazných motorických příznaků a bez kómatu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nekonvulzivní status epilepticus bez kómatu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032671"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ epileptického statu bez výrazných motorických příznaků a bez kómatu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of status epilepticus without prominent motor symptoms in the absence of coma.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032671"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nekonvulzivní status epilepticus bez kómatu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Non-convulsive status epilepticus without coma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032672">
        <obo:IAO_0000115 xml:lang="cs">Autonomní status epilepticus je typ nekonvulzivního epileptického statu bez kómatu s výraznými autonomními rysy bez ohledu na to, zda je elektrograficky generalizovaný nebo fokální.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Autonomní status epilepticus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032672"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Autonomní status epilepticus je typ nekonvulzivního epileptického statu bez kómatu s výraznými autonomními rysy bez ohledu na to, zda je elektrograficky generalizovaný nebo fokální.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Autonomic status epilepticus is a type of non-convulsive status epilepticus without coma with prominent autonomic features regardless of whether it is electrographically generalized or focal.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032672"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Autonomní status epilepticus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Autonomic status epilepticus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032673">
        <obo:IAO_0000115 xml:lang="cs">Fokální nekonvulzivní status epilepticus bez kómatu je typem status epilepticus bez výrazných motorických příznaků, který je elektrograficky fokální. Jde o prodloužený fokální nemotorický záchvat</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální nekonvulzivní status epilepticus bez kómatu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032673"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální nekonvulzivní status epilepticus bez kómatu je typem status epilepticus bez výrazných motorických příznaků, který je elektrograficky fokální. Jde o prodloužený fokální nemotorický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal non-convulsive status epilepticus without coma is a type of status epilepticus without prominent motor signs, which is electrographically focal. It is a prolonged focal non-motor seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032673"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální nekonvulzivní status epilepticus bez kómatu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal non-convulsive status epilepticus without coma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032674">
        <obo:IAO_0000115 xml:lang="cs">Rána kůže je definována jako narušení normální anatomické struktury a funkce kůže, ke kterému došlo v důsledku poranění kůže. Hojení ran je dynamický, interaktivní proces zahrnující rozpustné mediátory, krevní buňky, extracelulární matrix a parenchymální buňky. Hojení ran má tři fáze: zánět, tvorbu tkáně a přestavbu tkáně, které se v čase překrývají.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kožní poranění</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032674"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Rána kůže je definována jako narušení normální anatomické struktury a funkce kůže, ke kterému došlo v důsledku poranění kůže. Hojení ran je dynamický, interaktivní proces zahrnující rozpustné mediátory, krevní buňky, extracelulární matrix a parenchymální buňky. Hojení ran má tři fáze: zánět, tvorbu tkáně a přestavbu tkáně, které se v čase překrývají.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cutaneous wound is a defined as a disruption of normal anatomic structure and function of the skin that occurs owing to an injury of the skin. Wound healing is a dynamic, interactive process involving soluble mediators, blood cells, extracellularmatrix, and parenchymal cells. Wound healing has three phases: inflammation, tissue formation, and tissue remodeling, that overlap in time.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032674"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kožní poranění</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cutaneous wound</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032675">
        <obo:IAO_0000115 xml:lang="cs">Poranění kůže, které prochází řádným a včasným reparačním procesem, jehož výsledkem je trvalé obnovení anatomické a funkční integrity kůže.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Akutní poranění kůže</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032675"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Poranění kůže, které prochází řádným a včasným reparačním procesem, jehož výsledkem je trvalé obnovení anatomické a funkční integrity kůže.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cutaneous wound that is proceeding through an orderly and timely reparative process that results in sustained restoration of the anatomic and functional integrity of the skin.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032675"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Akutní poranění kůže</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Acute cutaneous wound</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032676">
        <obo:IAO_0000115 xml:lang="cs">Kožní poranění, které neprošlo řádným a včasným procesem k vytvoření atomické a funkční integrity, nebo prošlo procesem opravy, aniž by byl vytvořen trvalý anatomický a funkční výsledek.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Chronické kožní poranění</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032676"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kožní poranění, které neprošlo řádným a včasným procesem k vytvoření atomické a funkční integrity, nebo prošlo procesem opravy, aniž by byl vytvořen trvalý anatomický a funkční výsledek.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cutaneous wound that has failed to proceed through the orderly and timely process to produce an atomic and functional integrity, or proceeded through the repair process without establishing a sustained anatomic and functional result.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032676"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Chronické kožní poranění</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic cutaneous wound</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032677">
        <obo:IAO_0000115 xml:lang="cs">Generalizovaný motorický záchvat je typ generalizovaného záchvatu s převážně motorickými (svalovými) příznaky. Motorický příznak může spočívat v nárůstu (pozitivní) nebo poklesu (negativní) svalové kontrakce, která vyvolá pohyb.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Generalizované motorické záchvaty</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032677"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Generalizovaný motorický záchvat je typ generalizovaného záchvatu s převážně motorickými (svalovými) příznaky. Motorický příznak může spočívat v nárůstu (pozitivní) nebo poklesu (negativní) svalové kontrakce, která vyvolá pohyb.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A generalized motor seizure is a type of generalized-onset seizure with predominantly motor (involving musculature) signs. The motor event could consist of an increase (positive) or decrease (negative) in muscle contraction to produce a movement.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032677"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Generalizované motorické záchvaty</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Generalized-onset motor seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032678">
        <obo:IAO_0000115 xml:lang="cs">Myoklonie očních víček je typ generalizovaného myoklonického záchvatu, který může, ale nemusí být spojen se ztrátou vědomí.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Záchvat s myokloniemi víček</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032678"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Myoklonie očních víček je typ generalizovaného myoklonického záchvatu, který může, ale nemusí být spojen se ztrátou vědomí.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An eyelid myoclonia seizure is a type of generalized myoclonic seizure which may or may not be associated with loss of awareness.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032678"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Záchvat s myokloniemi víček</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Eyelid myoclonia seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032679">
        <obo:IAO_0000115 xml:lang="cs">Typ fokálního záchvatu charakterizovaný nemotorickými příznaky nebo symptomy (nebo zárazy v chování) jako počátečním semiologickým projevem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální non-motorický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032679"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fokálního záchvatu charakterizovaný nemotorickými příznaky nebo symptomy (nebo zárazy v chování) jako počátečním semiologickým projevem.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of focal-onset seizure characterized by non-motor signs or symptoms (or behavior arrest) as its initial semiological manifestation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032679"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální non-motorický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal non-motor seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032680">
        <obo:IAO_0000115 xml:lang="cs">Fokální kognitivní záchvat zahrnuje změnu kognitivní funkce (může se jednat o deficit nebo pozitivní jev, např. vynucené myšlení), ke které dochází při vzniku záchvatu. Aby mohl být fokální kognitivní záchvat klasifikován jako fokální kognitivní záchvat, měla by být změna kognitivní funkce specifická a neproporcionální vůči ostatním relativně neporušeným aspektům poznávání, protože při fokálním záchvatu poruchy vědomí je narušeno veškeré poznávání.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kognitivní záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032680"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kognitivní záchvat zahrnuje změnu kognitivní funkce (může se jednat o deficit nebo pozitivní jev, např. vynucené myšlení), ke které dochází při vzniku záchvatu. Aby mohl být fokální kognitivní záchvat klasifikován jako fokální kognitivní záchvat, měla by být změna kognitivní funkce specifická a neproporcionální vůči ostatním relativně neporušeným aspektům poznávání, protože při fokálním záchvatu poruchy vědomí je narušeno veškeré poznávání.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal cognitive seizure involves an alteration in a cognitive function (which can be a deficit or a positive phenomenon such as forced thought), which occurs at seizure onset. To be classified as a focal cognitive seizure, the change in cognitive function should be specific and out of proportion to other relatively unimpaired aspects of cognition, because all cognition is impaired in a focal impaired awareness seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032680"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kognitivní záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cognitive seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032681">
        <obo:IAO_0000115 xml:lang="cs">Fokální kognitivní záchvat, při kterém je vědomí zachováno po celou dobu záchvatu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kognitivní záchvat bez poruchy vědomí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032681"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kognitivní záchvat, při kterém je vědomí zachováno po celou dobu záchvatu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal aware cognitive seizure during which awareness is retained throughout the seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032681"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kognitivní záchvat bez poruchy vědomí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal aware cognitive seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032682">
        <obo:IAO_0000115 xml:lang="cs">Fokální non-motorický záchvat, při kterém je vědomí zachováno po celou dobu záchvatu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální non-motorický záchvat bez poruchy vědomí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032682"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální non-motorický záchvat, při kterém je vědomí zachováno po celou dobu záchvatu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal non-motor seizure in which awareness is retained throughout the seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
