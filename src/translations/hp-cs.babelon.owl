        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pattern of blood flow in the heart that deviates from the normal circuit of the circulatory system from both right side of the heart to the left and vice versa.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
