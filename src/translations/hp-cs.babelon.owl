        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001137">
        <obo:IAO_0000115 xml:lang="cs">Esotropie, u které může být kterékoliv oko použito k fixaci</obo:IAO_0000115>
