        <babelon:source_value>Triangular face</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000326">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita maxilly (horní čelisti)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormalita horní čelisti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000326"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
