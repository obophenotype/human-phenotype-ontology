    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006844">
        <obo:IAO_0000115 xml:lang="cs">Nepřítomnost patelárního reflexu, který lze obvykle vyvolat klepnutím na podkolenní vaz (ligamentum patellae) s reflexním kladivem těsně pod čéškou</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nevýbavné patelární reflexy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006844"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nepřítomnost patelárního reflexu, který lze obvykle vyvolat klepnutím na podkolenní vaz (ligamentum patellae) s reflexním kladivem těsně pod čéškou</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
