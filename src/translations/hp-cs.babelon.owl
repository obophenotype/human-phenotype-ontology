        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anomalous origin of the left common carotid artery from the main pulmonary artery</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031635">
