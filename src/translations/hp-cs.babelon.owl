    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031330">
        <obo:IAO_0000115 xml:lang="cs">Zvýšení počtu imunitních buněk v tkáni myokardu soustředěných v prostorech obklopujících krevní cévy</obo:IAO_0000115>
