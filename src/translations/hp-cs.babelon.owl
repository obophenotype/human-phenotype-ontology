    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007677">
        <obo:IAO_0000115 xml:lang="cs">Vitelliformní makulopatie je ostře ohraničená léze způsobená nahromaděním materiálu, často lipofuscinu, v subretinálním prostoru pod makulou.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vitelliformní makulární léze</rdfs:label>
