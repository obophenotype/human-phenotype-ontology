        <babelon:source_value>Nodular septal thickening on pulmonary HRCT</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025174">
        <obo:IAO_0000115 xml:lang="cs">Zesílení interlobulárních plicních sept s nepravidelným vzhledem vzhledem patrným na HRCT snímku. Tento nález je často asociovaný s porušením plicní architektury.</obo:IAO_0000115>
