    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009427">
        <obo:IAO_0000115 xml:lang="cs">Distální falanga 3. prstu na ruce (prostředník) trojúhelníkového tvaru. Trojúhelníková nebo takzvaná deltová falanga vzniká důsledkem epifýzy ve tvaru písmena C postižené falangy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Trojúhelníková distální falanga 3. prstu na ruce</rdfs:label>
