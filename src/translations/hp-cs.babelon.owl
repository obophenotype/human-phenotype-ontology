    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011876">
        <obo:IAO_0000115 xml:lang="cs">Anomální velikost krevních destiček. Obvykle je normální průměru krevní deštičky v rozmezí 1,5-3 µm. Velké krevní destičky mají 4 až 7 mikrometrů. Obří krevní destičky jsou větší než 7 mikrometrů a obvykle 10 až 20 mikrometrů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální objem destiček</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011876"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomální velikost krevních destiček. Obvykle je normální průměru krevní deštičky v rozmezí 1,5-3 µm. Velké krevní destičky mají 4 až 7 mikrometrů. Obří krevní destičky jsou větší než 7 mikrometrů a obvykle 10 až 20 mikrometrů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anomalous size of platelets. Most normal sized platelets are 1.5 to 3 micrometers in diameter. Large platelets are 4 to 7 micrometers. Giant platelets are larger than 7 micrometers and usually 10 to 20 micrometers.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011876"/>
