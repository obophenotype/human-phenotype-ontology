        <owl:annotatedTarget xml:lang="cs">Vrozená anomálie typická přítomností nadpočetných prstů nebo palců</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A congenital anomaly characterized by the presence of supernumerary fingers or toes.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
