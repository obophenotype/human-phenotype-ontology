    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025274">
        <obo:IAO_0000115 xml:lang="cs">Cystický ovariální teratom složený z kožních a epidermálních složek a obsahujících tkáňové složky včetně vlasů, zubů, kostí, štítné žlázy a dalších.</obo:IAO_0000115>
