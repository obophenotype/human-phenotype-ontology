    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025342">
        <obo:IAO_0000115 xml:lang="cs">Blokáda průtoku krve v arteria centralis retinae. Typickým projevem je hluboká monokulární ztráta zraku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Okluze arteria centralis retinae</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025342"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Blokáda průtoku krve v arteria centralis retinae. Typickým projevem je hluboká monokulární ztráta zraku.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Blockage of the main artery in the retina. In the acute phase, the fundus may show cherry red spot and stasis of retinal flow. The typical presentation is one of profound monocular visual loss.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
