        <obo:IAO_0000115 xml:lang="cs">Snížený počet megakaryocytů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Megakaryocytopenie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005548"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížený počet megakaryocytů</owl:annotatedTarget>
