        <owl:annotatedTarget xml:lang="cs">Typ fokálního klonického záchvatu charakterizovaného trvalými rytmickými záškuby, které na začátku záchvatu rychle postihují jednu stranu těla.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
