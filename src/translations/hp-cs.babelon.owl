        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033086">
        <obo:IAO_0000115 xml:lang="cs">Počet antrálních folikulů je vyšší, než by odpovídalo danému věku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšený počet antrálních folikulů</rdfs:label>
