        <babelon:source_value>Recurrent thromboembolism</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004835">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost erytrocytů, které mají kulovitý tvar a zmenšenou velikost.</obo:IAO_0000115>
