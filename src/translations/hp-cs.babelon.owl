    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011584">
        <obo:IAO_0000115 xml:lang="cs">Typ ectopia cordis se srdcem částečně v cervikální krajině s defektem kraniální části sterna.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Thorakocervikální ectopia cordis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011584"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ ectopia cordis se srdcem částečně v cervikální krajině s defektem kraniální části sterna.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of ectopia cordis with the heart partially in the cervical region with a defect of the superior portion of the sternum.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011584"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Thorakocervikální ectopia cordis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Thoracocervical ectopia cordis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011585">
        <obo:IAO_0000115 xml:lang="cs">Vrozená malformace hrudní stěny s částečný nebo úplným umístněním srdce mimo hrudní dutinu. Tento nález je asociovaný s rozštěpem nebo chyběním sterna.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Thorakální ectopia cordis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011585"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vrozená malformace hrudní stěny s částečný nebo úplným umístněním srdce mimo hrudní dutinu. Tento nález je asociovaný s rozštěpem nebo chyběním sterna.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Congenital malformation of the thoracic wall with partial or total displacement of the heart outside the thoracic cavity. This feature is associated with sternal cleft or absence of the sternum.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011585"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Thorakální ectopia cordis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Thoracic ectopia cordis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011586">
        <obo:IAO_0000115 xml:lang="cs">Vrozená vada břišní stěny s částečnou nebo úplnou eventerací srdce mimo hrudní dutinu a částečným posunem do dutiny břišní.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Thorakoabdominální ectopia cordis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011586"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vrozená vada břišní stěny s částečnou nebo úplnou eventerací srdce mimo hrudní dutinu a částečným posunem do dutiny břišní.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Congenital malformation of the ventral wall with partial or total evisceration of the heart outside the thoracic cavity and displacement partially into the abdominal cavity.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011586"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Thorakoabdominální ectopia cordis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Thoracoabdominal ectopia cordis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011587">
        <obo:IAO_0000115 xml:lang="cs">Deviace normy odstupu či průběhu pravého truncus brachiocephalicus, levé arteria carotis communis, levé arteria subclavia nebo proximálních arteriae vertebrales.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální větvení aortálního oblouku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011587"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Deviace normy odstupu či průběhu pravého truncus brachiocephalicus, levé arteria carotis communis, levé arteria subclavia nebo proximálních arteriae vertebrales.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deviance from the norm of the origin or course of the right brachiocephalic artery, the left common carotid artery, the left subclavian artery or the proximal vertebral arteries.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011587"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální větvení aortálního oblouku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal branching pattern of the aortic arch</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011588">
        <obo:IAO_0000115 xml:lang="cs">Aortální oblouk zasahuje do měkkých tkání krku a poté se stáčí dolů a stává se sestupnou aortou.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Krční aortální oblouk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011588"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Aortální oblouk zasahuje do měkkých tkání krku a poté se stáčí dolů a stává se sestupnou aortou.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The aortic arch extends into the soft tissues of the neck before turning down into to become the descending aorta.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011588"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Krční aortální oblouk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cervical aortic arch</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011589">
        <obo:IAO_0000115 xml:lang="cs">Levá arteria carotis communis má společný začátek s truncus brachiocephalicus.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Společný začátek pravého truncus brachiocephalicus a levé arteria carotis communis.</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011589"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Levá arteria carotis communis má společný začátek s truncus brachiocephalicus.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The left common carotid artery has a common origin with the innominate artery.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011589"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Společný začátek pravého truncus brachiocephalicus a levé arteria carotis communis.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Common origin of the right brachiocephalic artery and left common carotid artery</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011590">
        <obo:IAO_0000115 xml:lang="cs">Konenitální abnormalita oblouku aorty, při které dva embryonální oblouky aorty tvoří cévní prstenec, který obklopuje průdušnici nebo jícen a poté se spojí a vytvoří sestupnou aortu. Dvojitý aortální oblouk může způsobit příznaky v důsledku komprese jícnu (dysfagie, cyanóza při jídle) nebo průdušnice (stridor)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zdvojený oblouk aorty</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011590"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Konenitální abnormalita oblouku aorty, při které dva embryonální oblouky aorty tvoří cévní prstenec, který obklopuje průdušnici nebo jícen a poté se spojí a vytvoří sestupnou aortu. Dvojitý aortální oblouk může způsobit příznaky v důsledku komprese jícnu (dysfagie, cyanóza při jídle) nebo průdušnice (stridor)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A conenital abnormality of the aortic arch in which the two embryonic aortc arches form a vascular ring that surrounds the trachea or esophagus and then join to form the descending aorta. Double aortic arch can cause symptoms because of compression of the esophagus (dysphagia, cyanosis while eating) or trachea (stridor).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011590"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zdvojený oblouk aorty</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Double aortic arch</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011591">
        <rdfs:label xml:lang="cs">Levostranný aortální oblouk z cervikálním původem pravé podklíčkové tepny</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011591"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Levostranný aortální oblouk z cervikálním původem pravé podklíčkové tepny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Left aortic arch with cervical origin of the right subclavian artery</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011592">
        <obo:IAO_0000115 xml:lang="cs">Arteria subclavia odstupuje z ductus arteriosus. Dokud je ductus arteriosus průchozí, krevní zásobení arteria subclavia pochází z něj, původně z arteria pulmonalis. Po tom co se uzavře, je arteria subclavia zásobena retrográdně přes circulus arteriosus Wilisi přes arteria vertebralis.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Levostranný aortální oblouk z izolovanou podklíčkovou tepnou</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011592"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Arteria subclavia odstupuje z ductus arteriosus. Dokud je ductus arteriosus průchozí, krevní zásobení arteria subclavia pochází z něj, původně z arteria pulmonalis. Po tom co se uzavře, je arteria subclavia zásobena retrográdně přes circulus arteriosus Wilisi přes arteria vertebralis.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The subclavian artery arises from ductus arteriosus. While the ductus arteriosus is patent its blood supply comes from the ductus, hence from the pulmonary artery. After it closes, the blood supply is retrogradely from the vertebral artery via the circle of Willis.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011592"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Levostranný aortální oblouk z izolovanou podklíčkovou tepnou</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Left aortic arch with isolated subclavian artery</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011593">
        <obo:IAO_0000115 xml:lang="cs">Je přítomný ductus arteriosus či ligamentum arteriosum, který dokončuje okruh spojující divertikl s arteria pulmonalis.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Levostranný aortální oblouk s retroezofageálním Kommerellovým divertiklem</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011593"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Je přítomný ductus arteriosus či ligamentum arteriosum, který dokončuje okruh spojující divertikl s arteria pulmonalis.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A patent ductus arteriosus or ductal ligament completes the ring.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011593"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Levostranný aortální oblouk s retroezofageálním Kommerellovým divertiklem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Left aortic arch with retroesophageal diverticulum of Kommerell</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011594">
        <obo:IAO_0000115 xml:lang="cs">Oblouk aorty se kříží s pravostranným hlavním bronchem. Levá arteria carotis je první odstupující arterie, pravá arteria carotis druhá a pravá arteria subclavia třetí.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pravostranný aortální oblouk s retroezofageálním Kommerellovým divertiklem</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011594"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Oblouk aorty se kříží s pravostranným hlavním bronchem. Levá arteria carotis je první odstupující arterie, pravá arteria carotis druhá a pravá arteria subclavia třetí.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aortic arch crosses the right mainstem bronchus. The left carotid artery is the first branch, right carotid artery the second branch and right subclavian artery as the third branch.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011594"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Pravostranný aortální oblouk s retroezofageálním Kommerellovým divertiklem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Right aortic arch with retroesophageal diverticulum of Kommerell</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011595">
        <obo:IAO_0000115 xml:lang="cs">Oblouk aorty se kříží s levým hlavním bronchem. První odstupující céva je pravá arteria carotis, druhou cévou je levá arteria carotis, třetí je levá arteria subclavia a čtvrtá je pravá arteria subclavia. Poslední jmenovaná vzestuouje z posteromediální částo oblouku aorty a pokračuje dorzálně od jícnu na pravou stranu těla.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Levostranný aortální oblouk s retroezofageální pravou arteria subclavia</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011595"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Oblouk aorty se kříží s levým hlavním bronchem. První odstupující céva je pravá arteria carotis, druhou cévou je levá arteria carotis, třetí je levá arteria subclavia a čtvrtá je pravá arteria subclavia. Poslední jmenovaná vzestuouje z posteromediální částo oblouku aorty a pokračuje dorzálně od jícnu na pravou stranu těla.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aortic arch crosses the left mainstem bronchus. The first branch is the right carotid artery, the second branch is the left carotid artery, the third branch is the subclavian artery, the fourth branch is the right subclavian artery arising from the posteromedial aspect of the distal aortic arch and continuing posterior to the esophagus to the right hand side of the body.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011595"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Levostranný aortální oblouk s retroezofageální pravou arteria subclavia</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Left aortic arch with retroesophageal right subclavian artery</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011596">
        <obo:IAO_0000115 xml:lang="cs">Cérvní okruh může být dokončem ligamentum arteriosum.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Levostranný aortální oblouk s pravostrannou sestupnou aortou a pravostranným ductus arteriosus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011596"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Cérvní okruh může být dokončem ligamentum arteriosum.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The ring may be completed by the ductal ligament.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
