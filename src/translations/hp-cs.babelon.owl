        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost mnohočetných jamek (malých, bodově velkých důlků na povrchu kůže) na kůži chodidla.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of multiple pits (small, pinpoint-large indentations on the surface of the skin) located on the skin of sole of foot.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
