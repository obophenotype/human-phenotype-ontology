        <owl:annotatedTarget xml:lang="cs">Forma extranodálního, high-grade non-hodgkinského B-buněčného novotvaru, obvykle velkobuněčného nebo imunoblastického typu, který pochází z mozku, leptomeningů, míchy nebo očí a obvykle zůstává omezený na CNS</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of extranodal, high-grade non-Hodgkin B-cell neoplasm, usually large cell or immunoblastic type that originates in the brain, leptomeninges, spinal cord, or eyes and typically remains confined to the CNS.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
