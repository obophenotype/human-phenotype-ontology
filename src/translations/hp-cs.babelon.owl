    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020180">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně vysoká koncentrace haptoglobinu v krevním oběhu. Haptoglobin je reaktant akutní fáze, jehož hladina může být zvýšena v přítomnosti infekce a zánětu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená hladina haptoglobinu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
