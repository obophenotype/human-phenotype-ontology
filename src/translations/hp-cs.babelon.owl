        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0410265">
        <obo:IAO_0000115 xml:lang="cs">Hemangiom, benigní nádor z vaskulárních endoteliálních buňkek, který se nachází v horní části hrtanu (larynx) včetně epiglottis; oblastí nad hlasivkami</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Suprapratický hemangiom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410265"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Hemangiom, benigní nádor z vaskulárních endoteliálních buňkek, který se nachází v horní části hrtanu (larynx) včetně epiglottis; oblastí nad hlasivkami</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A hemangioma, a benign tumor of the vascular endothelial cells, located in the upper part of the larynx (voice box) including the epiglottis; the area above the vocal cords.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
