        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A broad (120 ms or longer in duration) and bifid P-wave in EKG lead II.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031599"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">P mitrale</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>P mitrale</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031600">
        <obo:IAO_0000115 xml:lang="cs">P vlna pod základní linií místo nad ní. Inverze vlny P v dolních svodech může naznačovat nesinusový původ vln P.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Inverze vlny P</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031600"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">P vlna pod základní linií místo nad ní. Inverze vlny P v dolních svodech může naznačovat nesinusový původ vln P.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>P wave below instead of above the baseline. P-wave inversion in the inferior leads may indicate a non-sinus origin of the P waves.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031600"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Inverze vlny P</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>P wave inversion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031601">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost vysokých, hrotnatých vln P ve svodu II v EKG</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">P pulmonale</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031601"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost vysokých, hrotnatých vln P ve svodu II v EKG</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of tall, peaked P waves in EKG lead II.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031601"/>
