        <babelon:source_value>Elongated chordae tendinae of the mitral valve</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025523">
        <obo:IAO_0000115 xml:lang="cs">Strukturální anomálie chordae tendinae mitrální chlopně, jejíž hlavní funkcí je přenášet kontrakci a relaxaci papilárních svalů během srdečního cyklu, a tím zajišťovat uzavírání cípů mitrální chlopně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie chordae tendinae mitrální chlopně</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025523"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Strukturální anomálie chordae tendinae mitrální chlopně, jejíž hlavní funkcí je přenášet kontrakci a relaxaci papilárních svalů během srdečního cyklu, a tím zajišťovat uzavírání cípů mitrální chlopně.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A structural anomaly of the chordae tendinae of the mitral valve, whose main function is to transmit the contraction and relaxation of the papillary muscles during the cardiac cycle, thus ensuring the closing of the leaflets of the mitral valve.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025523"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální morfologie chordae tendinae mitrální chlopně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal morphology of the chordae tendinae of the mitral valve</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025524">
        <obo:IAO_0000115 xml:lang="cs">Ztráta vnější vrstvy epidermis ve formě velkých šupin lokalizovaných na dlani a plosce nohy.</obo:IAO_0000115>
