        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032686">
        <obo:IAO_0000115 xml:lang="cs">Fokální kognitivní záchvat s poruchou paměti charakterizovaný zachovaným vědomím po celou dobu záchvatu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kognitivní záchvat s poruchou paměti bez poruchy vědomí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032686"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kognitivní záchvat s poruchou paměti charakterizovaný zachovaným vědomím po celou dobu záchvatu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal cognitive seizure with memory impairment characterized by retained awareness throughout the seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032686"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kognitivní záchvat s poruchou paměti bez poruchy vědomí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal aware cognitive seizure with memory impairment</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032687">
        <obo:IAO_0000115 xml:lang="cs">Fokální kognitivní záchvat charakterizovaný přechodnou poruchou paměti jako počátečním semiologickým projevem, zatímco ostatní kognitivní funkce a vědomí jsou při vzniku záchvatu zachovány. Porucha paměti může spočívat v neschopnosti vybavit si události, které se staly před záchvatem (retrográdní amnézie), nebo v neschopnosti zakódovat nové vzpomínky na události, které se staly během záchvatu (anterográdní amnézie).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kognitivní záchvat s poruchou paměti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032687"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kognitivní záchvat charakterizovaný přechodnou poruchou paměti jako počátečním semiologickým projevem, zatímco ostatní kognitivní funkce a vědomí jsou při vzniku záchvatu zachovány. Porucha paměti může spočívat v neschopnosti vybavit si události, které se staly před záchvatem (retrográdní amnézie), nebo v neschopnosti zakódovat nové vzpomínky na události, které se staly během záchvatu (anterográdní amnézie).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal cognitive seizure characterized by transient memory impairment as the initial semiological manifestation whilst other cognitive functions and awareness are preserved at seizure onset. The memory impairment may be an inability to recall events occurring prior to the seizure (retrograde amnesia), or failure to encode new memories for events occurring during the seizure (anterograde amnesia).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032687"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kognitivní záchvat s poruchou paměti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cognitive seizure with memory impairment</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032688">
