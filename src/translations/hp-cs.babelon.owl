    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030716">
        <obo:IAO_0000115 xml:lang="cs">Částečné nebo úplné chyběné lebečních kostí. Tento stav je často, i když ne vždy, asociovaný s anencefalií.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Akranie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030716"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Částečné nebo úplné chyběné lebečních kostí. Tento stav je často, i když ne vždy, asociovaný s anencefalií.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Partial or complete absence of the flat bones of the cranial vault. The condition is frequently, though not always, associated with anencephaly.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
