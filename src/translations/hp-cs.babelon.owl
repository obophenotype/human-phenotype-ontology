    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006367">
        <obo:IAO_0000115 xml:lang="cs">Pomačkaný rentgenový vzhled dlouhých kostí vznikající jak byla dlouhá kost rozdrcena a vznikly nepravidelnosti. Tato vlastnost je důsledkem mnohačetných zlomenin a opakovaných procesů neúčinného hojení, jak lze pozorovat například u těžkých forem osteogenesis imperfecta</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zmačkané dlouhé kosti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006367"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Pomačkaný rentgenový vzhled dlouhých kostí vznikající jak byla dlouhá kost rozdrcena a vznikly nepravidelnosti. Tato vlastnost je důsledkem mnohačetných zlomenin a opakovaných procesů neúčinného hojení, jak lze pozorovat například u těžkých forem osteogenesis imperfecta</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An crumpled radiographic appearance of the long bones, as if the long bone had been crushed together producing irregularities. This feature is the result of multiple fractures and repeated rounds of ineffective healing, as can be seen for instance in severe forms of osteogenesis imperfecta.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006367"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zmačkané dlouhé kosti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Crumpled long bones</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
