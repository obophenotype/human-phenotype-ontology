    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100029">
        <obo:IAO_0000115 xml:lang="cs">Aberantní štítná žláza nebo ektopická štítná žláza nacházející se na spodině jazyka, těsně za foramen cecum, jako důsledek poruchy sestoupení štítné žlázy</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Lingvální štítná žláza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
