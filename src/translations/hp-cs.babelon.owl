        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The abrupt and transient increase in the annual growth rate normally observed in adolescent individuals does not occur.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
