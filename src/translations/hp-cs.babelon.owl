        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012484">
        <obo:IAO_0000115 xml:lang="cs">Vadná struktura, velikost nebo obsah denzních granul, destičkových organel, které obsahují proagregační faktory, jako je adenosindifosfát (ADP), adenosintrifosfát (ATP), ionizovaný vápník, histamin a serotonin.</obo:IAO_0000115>
