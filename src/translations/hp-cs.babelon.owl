        <owl:annotatedTarget xml:lang="cs">Vzhled moči, která má viditelný vzorek v suspenzi, tj. je zakalená.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The appearance of the urine having visible material in suspension, i.e., appearing cloudy.</babelon:source_value>
