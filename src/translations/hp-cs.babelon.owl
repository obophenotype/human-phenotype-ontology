        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Secondary Caesarian section</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030365">
        <obo:IAO_0000115 xml:lang="cs">Vaginální porod po císařském řezu (VBAC) odkazuje na situaci, kdy matka po přechozím porodu císačkým řezem nyní porodila vaginálně</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vaginální porod po císařském řezu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030365"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vaginální porod po císařském řezu (VBAC) odkazuje na situaci, kdy matka po přechozím porodu císačkým řezem nyní porodila vaginálně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Vaginal birth after Caesarean (VBAC) refers to the situation where the mother has had a previous Cesarean delivery but has now delivered vaginally.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030365"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Vaginální porod po císařském řezu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Vaginal birth after Caesarean</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030366">
        <obo:IAO_0000115 xml:lang="cs">Odon device je nástroj pro asistované vaginální porody, který se přikládá na hlavičku dítěte a používá se k trakci, která napomáhá porodu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Porod pomocí Odon device</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030366"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Odon device je nástroj pro asistované vaginální porody, který se přikládá na hlavičku dítěte a používá se k trakci, která napomáhá porodu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The Odon device is an instrument for assisted vaginal deliveries that is applied on the head of the baby and used to apply traction to assist the birth process.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030366"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Porod pomocí Odon device</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Delivery by Odon device</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030367">
        <obo:IAO_0000115 xml:lang="cs">Hyperfalangie je morfologicky zvýšený počet falang prstu, které jsou umístněné lineárně s prstem. To znamená, že je přítomna nadpočetná falanga umístněná lineárně s ostatníma falangama.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hyperfalangie ruky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030367"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Hyperfalangie je morfologicky zvýšený počet falang prstu, které jsou umístněné lineárně s prstem. To znamená, že je přítomna nadpočetná falanga umístněná lineárně s ostatníma falangama.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hyperphalangy is a digit morphology in which increased numbers of phalanges are arranged linearly within a digit. That is, there is an accessory phalanx that is arranged linearly with the other phalanges.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030367"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hyperfalangie ruky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Finger hyperphalangy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030368">
        <obo:IAO_0000115 xml:lang="cs">Nadpočetná falanga druhého prstu (ukazováku), která je umístněná lineárně s ostatníma falangama. Hyperfalangie ukazováku je důsledkem nadpočetního osifikačního centra v metakarpofalangeálním kloubu a spůsobuje radiální deviaci ukazováku. Tento termín odkazuje jenom na tento typ hyperfalangie.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hyperfalangie 2. prstu na ruce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030368"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nadpočetná falanga druhého prstu (ukazováku), která je umístněná lineárně s ostatníma falangama. Hyperfalangie ukazováku je důsledkem nadpočetního osifikačního centra v metakarpofalangeálním kloubu a spůsobuje radiální deviaci ukazováku. Tento termín odkazuje jenom na tento typ hyperfalangie.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An accessory phalanx of the index (second) finger that is arranged linearly with the other phalanges. Hyperphalangy of the index finger results from an accessory ossification center at the metacarpophalangeal joint, resulting in radial deviation of the index finger. Note that this term refers only to this type of hyperphalangy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030368"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hyperfalangie 2. prstu na ruce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hyperphalangy of the 2nd finger</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030369">
        <obo:IAO_0000115 xml:lang="cs">Vaginální porod následující po indukci, postup používaný ke stimulaci děložních kontrakcí během těhotenství před zahájením spontánního porodu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Indukovaný vaginální porod</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030369"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vaginální porod následující po indukci, postup používaný ke stimulaci děložních kontrakcí během těhotenství před zahájením spontánního porodu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Vaginal delivery following induction of labor, a procedure used to stimulate uterine contractions during pregnancy before labor begins on its own.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030369"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Indukovaný vaginální porod</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Induced vaginal delivery</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030370">
        <obo:IAO_0000115 xml:lang="cs">Odchylka normálního podílu naivních B buněk (CD19+/CD27-/IgD+/IgM+) vzhledem k celkovému počtu B buněk. Naivní B buňky představují jeden z podtypů B buněk v periferní krvi a jsou to B buňky, které nebyly vystaveny působení antigenu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální podíl naivních B buněk</rdfs:label>
    </rdf:Description>
