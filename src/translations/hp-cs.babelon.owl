        <babelon:source_value>Renal tubular epithelial cell mitosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032605">
        <obo:IAO_0000115 xml:lang="cs">Alespoň jedna tubulární epiteliální buňka s průměrnou velikostí cytoplazmatické oblasti a jadernou oblastí 3x větší než průměrná velikost jádra</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vysoký N/C poměr renálních tubulárních epiteliálních buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032605"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Alespoň jedna tubulární epiteliální buňka s průměrnou velikostí cytoplazmatické oblasti a jadernou oblastí 3x větší než průměrná velikost jádra</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>At least one tubular epithelial cell with average sized cytoplasmic area and a nuclear area 3 times greater than average sized nuclei.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
