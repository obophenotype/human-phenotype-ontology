        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033544"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Depozice mezangiálních fibril</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mesangial fibril deposition</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033545">
        <obo:IAO_0000115 xml:lang="cs">Extracelulární mezangiální agregáty složené z náhodně uspořádaných, přímých, nerozvětvených fibril, které jsou silnější než amyloidní fibrily (průměrný průměr asi 20 nm) a jsou často smíchány s rozmazaným, elektronově hustým materiálem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mesangiální fibrilární depozita</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033545"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Extracelulární mezangiální agregáty složené z náhodně uspořádaných, přímých, nerozvětvených fibril, které jsou silnější než amyloidní fibrily (průměrný průměr asi 20 nm) a jsou často smíchány s rozmazaným, elektronově hustým materiálem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Extracellular mesangial aggregates composed of randomly arranged, straight, non-branching fibrils that are thicker than amyloid fibrils (average diameter about 20 nm) and are often admixed with smudgy, electron-dense material.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033545"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mesangiální fibrilární depozita</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mesangial fibrillary deposits</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033546">
        <obo:IAO_0000115 xml:lang="cs">Nerozvětvené nekolagenní mikrofibrily v mezangiální matrix, složené z proteinů, které nejsou přítomny v glomerulární bazální membráně (GBM), zejména fibrilinu-1, který se váže na mezangiální buňky a strukturální proteiny GBM.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Depozice mezangiálních mikrofibril</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033546"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nerozvětvené nekolagenní mikrofibrily v mezangiální matrix, složené z proteinů, které nejsou přítomny v glomerulární bazální membráně (GBM), zejména fibrilinu-1, který se váže na mezangiální buňky a strukturální proteiny GBM.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Unbranched noncollagenous microfibrils within the mesangial matrix, composed of proteins not present within the glomerular basement membrane (GBM), most notably fibrillin-1, that attach to mesangial cells and GBM structural proteins.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033546"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Depozice mezangiálních mikrofibril</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mesangial microfibril deposition</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033547">
        <obo:IAO_0000115 xml:lang="cs">Extracelulární mezangiální agregáty složené z nevětvících fibril, fokálně paralelní a přes 30 nM v průměru. Termín imunotaktoid označuje vysoce organizovaná imunitní depozita, které se při ultrastrukturálním vyšetření projevují jako tyčinkovité mikrotubulární struktury.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mezangiální imunotaktoidní depozita</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033547"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Extracelulární mezangiální agregáty složené z nevětvících fibril, fokálně paralelní a přes 30 nM v průměru. Termín imunotaktoid označuje vysoce organizovaná imunitní depozita, které se při ultrastrukturálním vyšetření projevují jako tyčinkovité mikrotubulární struktury.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Extracellular mesangial aggregates composed of non-branching fibrils, focally parallel over 30 nM in diameter. The term immunotactoid refers to highly organized immune depositions appearing as rod-like microtubular structures in ultrastructural examination.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033547"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mezangiální imunotaktoidní depozita</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mesangial immunotactoid deposits</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033548">
        <obo:IAO_0000115 xml:lang="cs">Extracelulární mezangiální agregáty složené z jemných, náhodně orientovaných, nerozvětvených fibril o průměru 8-12 nm připomínající chomáče vaty</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mezangiální amyloidní depozice</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033548"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Extracelulární mezangiální agregáty složené z jemných, náhodně orientovaných, nerozvětvených fibril o průměru 8-12 nm připomínající chomáče vaty</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Extracellular mesangial aggregates composed of fine, randomly oriented, non-branching fibrils 8-12 nm in diameter, often forming a cottony mass.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
