        <obo:IAO_0000115 xml:lang="cs">Depozita kalciových solí v parenchymu kůry ledviny (vnější část ledviny mezi vazivovým pouzdrem a dření ledviny)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kortikální nefrokalcinóza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
