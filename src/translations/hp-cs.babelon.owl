        <babelon:source_value>A seizure characterized by taste phenomena including acidic, bitter, salty, sweet, or metallic tastes.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
