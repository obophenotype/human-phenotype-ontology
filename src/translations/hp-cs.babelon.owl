        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kontraktura metakarpofalangeálního kloubu 4. prstu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Contracture of the metacarpophalangeal joint of the 4th finger</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009278">
        <obo:IAO_0000115 xml:lang="cs">Vychýlení 4. prstu na ruce ulnárním směrem (t.j. k malíku)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Ulnární deviace 4. prstu na ruce</rdfs:label>
