        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Broad forehead</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000338">
        <obo:IAO_0000115 xml:lang="cs">Snížená hybnost svalů tváře, může být asociovaná s sníženým výskytem vrásek</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hypomimie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000338"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížená hybnost svalů tváře, může být asociovaná s sníženým výskytem vrásek</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduced degree of motion of the muscles beneath the skin of the face, often associated with reduced facial crease formation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
