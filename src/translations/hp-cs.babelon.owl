        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025327">
        <obo:IAO_0000115 xml:lang="cs">Zmenšený rozměr pevné části ledviny (parenchymu, kůry a dřeně ledviny) měřený od sběrného systému (ledvinových kalichů a pánvičky) k okraji ledviny. Toto měření lze provést změřením tloušťky parenchymu na snímcích z počítačové tomografie.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená tloušťka renálního parenchymu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025327"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zmenšený rozměr pevné části ledviny (parenchymu, kůry a dřeně ledviny) měřený od sběrného systému (ledvinových kalichů a pánvičky) k okraji ledviny. Toto měření lze provést změřením tloušťky parenchymu na snímcích z počítačové tomografie.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced dimension of the solid part of the kidney (parenchyma, the renal cortex and medulla) as measured from the collecting system (renal calyces and pelvis) to the border of the kidney. This measurement can be performed by measuring the thickness of the parenchyma in computed tomography scans.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025327"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Snížená tloušťka renálního parenchymu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased renal parenchymal thickness</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025328">
        <obo:IAO_0000115 xml:lang="cs">Významná mateřské hemoragie/krvácení ve druhé polovině těhotenství a před narozením dítěte</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Prenatální krvácení</rdfs:label>
