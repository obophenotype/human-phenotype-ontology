        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of visual evoked potentials</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000650">
        <rdfs:label xml:lang="cs">Abnormální amplituda při použití strukturovaného podnětu (anglicky pattern reversal)</rdfs:label>
