    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031770">
        <obo:IAO_0000115 xml:lang="cs">Typ epikantu, u kterého kožní řasa vychází z obou víček a rovnoměrně překrývá vnitřní koutek.</obo:IAO_0000115>
