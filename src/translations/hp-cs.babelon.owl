    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012531">
        <obo:IAO_0000115 xml:lang="cs">Nepříjemný smyslový a emocionální zážitek spojený se skutečným nebo potenciálním poškozením tkáně nebo popisovaný v souvislosti s tímto poškozením</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Bolest</rdfs:label>
    </rdf:Description>
