    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000641">
        <obo:IAO_0000115 xml:lang="cs">Dysmetrické, neboli nepřesné sakády, vznikají, když první sakáda je moc velká (hypermetrická) nebo naopak moc malá (hypometrická) a mozek následně generuje jednu nebo několik korekčních sakád aby zafixoval cíl</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dysmetrické sakády</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000641"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Dysmetrické, neboli nepřesné sakády, vznikají, když první sakáda je moc velká (hypermetrická) nebo naopak moc malá (hypometrická) a mozek následně generuje jednu nebo několik korekčních sakád aby zafixoval cíl</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The controller signal for saccadic eye movements has two components: the pulse that moves the eye rapidly from one point to the next, and the step that holds the eye in the new position. When both the pulse and the step are not the correct size, a dysmetric refixation eye movement results.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000641"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Dysmetrické sakády</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dysmetric saccades</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000642">
        <obo:IAO_0000115 xml:lang="cs">Potíže rozpoznat červenou a zelenou barvu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Červená-zelená porucha barvocitu</rdfs:label>
    </rdf:Description>
