        <owl:annotatedTarget xml:lang="cs">Nepříjemný smyslový a emocionální zážitek spojený se skutečným nebo potenciálním poškozením tkáně nebo popisovaný v souvislosti s tímto poškozením</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An unpleasant sensory and emotional experience associated with actual or potential tissue damage, or described in terms of such damage.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
