    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000790">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost krve v moči. Hematurii se dělí na makroskopickou (viditelnou pouhým okem) nebo mikroskopickou (přítomnost krvi zjištěna pomocí testovacích proužků nebo mikroskopickým vyšetřením močového sedimentu)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hematurie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000790"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost krve v moči. Hematurii se dělí na makroskopickou (viditelnou pouhým okem) nebo mikroskopickou (přítomnost krvi zjištěna pomocí testovacích proužků nebo mikroskopickým vyšetřením močového sedimentu)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of blood in the urine. Hematuria may be gross hematuria (visible to the naked eye) or microscopic hematuria (detected by dipstick or microscopic examination of the urine).</babelon:source_value>
