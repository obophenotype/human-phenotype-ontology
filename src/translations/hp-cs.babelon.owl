        <obo:IAO_0000115 xml:lang="cs">Opakovaná tvorba abscesů v orgánech. Absces je ohraničená oblast hnisu nebo nekrotických zbytků v parenchymu nebo orgánu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Opakovaná tvorba hlubokých orgánových abscesů</rdfs:label>
    </rdf:Description>
