        <owl:annotatedTarget xml:lang="cs">Diseminovaná dermatofytóza</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Disseminated dermatophytosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032519">
        <obo:IAO_0000115 xml:lang="cs">Echinocyty (echinos - řecky ježek) jsou buňky které mají ostnaté výběžky po celém povrchu buňky. Echinocyty se běžně vyskytují jak u konečného stadia onemocnění ledvin, tak u onemocnění jater. Malé množství echunocytů se běžně vyskytuje i u zdravých jedinců.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšený počet echinocytů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032519"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Echinocyty (echinos - řecky ježek) jsou buňky které mají ostnaté výběžky po celém povrchu buňky. Echinocyty se běžně vyskytují jak u konečného stadia onemocnění ledvin, tak u onemocnění jater. Malé množství echunocytů se běžně vyskytuje i u zdravých jedinců.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Burr cells, also known as echinocytes, have a speculated border over the entire cell surface. Burr cells are commonly found in both end-stage renal disease and liver disease. Small numbers of Burr cells are commonly found in healthy individuals.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032519"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšený počet echinocytů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased Burr cell count</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032520">
        <obo:IAO_0000115 xml:lang="cs">Snížená síla žvýkacího svalu, jehož primární funkcí je elevace dolní čelisti a tím zvedání dolní čelisti směrem k maxile a uzavření čelisti.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Svalová slabost musculus maseter</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032520"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížená síla žvýkacího svalu, jehož primární funkcí je elevace dolní čelisti a tím zvedání dolní čelisti směrem k maxile a uzavření čelisti.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced strength of the masseter muscle, whose primary function is to elevate the mandible and thereby raise the mandible towards the maxilla, closing the jaw.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
