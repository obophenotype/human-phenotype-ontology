    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033080">
        <obo:IAO_0000115 xml:lang="cs">Tyreotropin uvolňující hormon (TRH) je hypotalamický tripeptid, který je syntetizován, ukládán a uvolňován z hypotalamu. Stimuluje syntézu a uvolňování hormonu stimulujícího štítnou žlázu (TSH) z přední hypofýzy. Po podání exogenního TRH se očekává přechodné zvýšení TSH v séru. Tento termín označuje abnormální odpověď při TRH stimulačním testu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální reakce TSH na test stimulace hormonu uvolňující tyreotropin</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033080"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Tyreotropin uvolňující hormon (TRH) je hypotalamický tripeptid, který je syntetizován, ukládán a uvolňován z hypotalamu. Stimuluje syntézu a uvolňování hormonu stimulujícího štítnou žlázu (TSH) z přední hypofýzy. Po podání exogenního TRH se očekává přechodné zvýšení TSH v séru. Tento termín označuje abnormální odpověď při TRH stimulačním testu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Thyrotrophin-releasing hormone (TRH) is a hypothalamic tripeptide synthesized by, stored within, and released from the hypothalamus. It stimulates the synthesis and release of thyroid-stimulating hormone (TSH) from the anterior pituitary gland. Following administration of exogenous TRH, a transient increase in serum TSH is expected. This term refers to an abnormal response in the TRH stimulation test.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033080"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální reakce TSH na test stimulace hormonu uvolňující tyreotropin</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal TSH response to thyrotrophin-releasing hormone stimulation test</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033081">
        <obo:IAO_0000115 xml:lang="cs">Neschopnost zvýšit hladinu TSH v séru v reakci na stimulační test TRH</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Chybějící odpověď TSH na test stimulace hormonu uvolňujícího tyreotropin</rdfs:label>
    </rdf:Description>
