        <obo:IAO_0000115 xml:lang="cs">Heterotopie, která tvoří souvislou zvlněnou linii podél stěny komory.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Periventrikulární lemovitá heterotopie</rdfs:label>
