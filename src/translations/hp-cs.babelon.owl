    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009606">
        <obo:IAO_0000115 xml:lang="cs">Úplná duplikace distálního falangu palce. Na RTG jsou viditelné dvě samostatné kosti vedle sebe</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Úplná duplikace distálního falangu palce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009606"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Úplná duplikace distálního falangu palce. Na RTG jsou viditelné dvě samostatné kosti vedle sebe</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complete duplication of the distal phalanx of the thumb. On x-ray two separate bones appear side to side.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009606"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Úplná duplikace distálního falangu palce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complete duplication of distal phalanx of the thumb</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009608">
        <obo:IAO_0000115 xml:lang="cs">Kompletní duplikace proximálního falangu palce. Na Rtg snímku jsou patrné dvě samostatné kosti vedle sebe. Na rozdíl od proximálních falangů prstů 2 až 5, proximální falang palce je embryologicky ekvivalentní středním falangům ostatních prstů a první metakarpální kost je embryonálně falangeálního původu a je ekvivalentem proximálních falangů ostatních prstů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Úplná duplikace proximálního falangu palce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009608"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kompletní duplikace proximálního falangu palce. Na Rtg snímku jsou patrné dvě samostatné kosti vedle sebe. Na rozdíl od proximálních falangů prstů 2 až 5, proximální falang palce je embryologicky ekvivalentní středním falangům ostatních prstů a první metakarpální kost je embryonálně falangeálního původu a je ekvivalentem proximálních falangů ostatních prstů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complete duplication of the proximal phalanx of the thumb. On x-ray two separate bones appear side to side. In contrast to the proximal phalanges of the digits 2-5, the proximal phalanx of the thumb is embryologically equivalent to the middle phalanges of the other digits, whereas the first metacarpal is embryologically of phalangeal origin and as such equivalent to the proximal phalanges of the other digits.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009608"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Úplná duplikace proximálního falangu palce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complete duplication of proximal phalanx of the thumb</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009609">
        <obo:IAO_0000115 xml:lang="cs">Částečná nebo úplná duplikace první metakarpální kosti</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Duplikace 1. metakarpální kosti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009609"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Částečná nebo úplná duplikace první metakarpální kosti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Partail or complete duplication of the first metacarpal bone.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009609"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Duplikace 1. metakarpální kosti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Duplication of the 1st metacarpal</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009611">
        <obo:IAO_0000115 xml:lang="cs">Částečná duplikace distáního falangu palce na ruce. Vzhledem k variabilite postižení mohou být na rentgenvém snímku různé nálezy od rozšpěpeného falangu (duplikovaná kost je téměř kompletně srostlá s falangem) až obraz dvou částečně srostlých kostí</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Bifidní distální falang palce na ruce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009611"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Částečná duplikace distáního falangu palce na ruce. Vzhledem k variabilite postižení mohou být na rentgenvém snímku různé nálezy od rozšpěpeného falangu (duplikovaná kost je téměř kompletně srostlá s falangem) až obraz dvou částečně srostlých kostí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Partial duplication of the distal phalanx of the thumb. Depending on the severity, the appearance on x-ray can vary from a notched phalanx (the duplicated bone is almost completely fused with the phalanx) to a partially fused appearance of the two bones.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009611"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Bifidní distální falang palce na ruce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bifid distal phalanx of the thumb</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009612">
        <obo:IAO_0000115 xml:lang="cs">Úplná nebo částečná duplikace distáního falangu palce na ruce. Vzhledem k variabilite postižení mohou být na rentgenvém snímku různé nálezy od rozšpěpeného falangu (duplikovaná kost je téměř kompletně srostlá s falangem), obraz dvou částečně srostlých kostí nebo obraz dvou oddělených kosti vedle sebe</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Duplikace distálního falangu palce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009612"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Úplná nebo částečná duplikace distáního falangu palce na ruce. Vzhledem k variabilite postižení mohou být na rentgenvém snímku různé nálezy od rozšpěpeného falangu (duplikovaná kost je téměř kompletně srostlá s falangem), obraz dvou částečně srostlých kostí nebo obraz dvou oddělených kosti vedle sebe</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complete or partial duplication of the distal phalanx of the thumb. Depending on the severity, the appearance on x-ray can vary from a notched phalanx (the duplicated bone is almost completely fused with the phalanx), a partially fused appearance of the two bones, or two separate bones appearing side to side.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009612"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Duplikace distálního falangu palce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Duplication of the distal phalanx of the thumb</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009613">
        <obo:IAO_0000115 xml:lang="cs">Úplná nebo částečná duplikace proximálního falangu palce na ruce. Vzhledem k variabilite postižení mohou být na rentgenvém snímku různé nálezy od rozšpěpeného falangu (duplikovaná kost je téměř kompletně srostlá s falangem) až obraz dvou částečně srostlých kostí. Na rozdíl od proximálních falangů druhého až páteho prstu, proximální falang palce je embryologicky ekvivalentem středních falangů ostatních prstů, přičemž první metakarpální kost je embryologicky falangeálního původu a jako taková je ekvivalentem proximálních falangů ostatních prstů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Duplikace proximálního falangu palce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009613"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Úplná nebo částečná duplikace proximálního falangu palce na ruce. Vzhledem k variabilite postižení mohou být na rentgenvém snímku různé nálezy od rozšpěpeného falangu (duplikovaná kost je téměř kompletně srostlá s falangem) až obraz dvou částečně srostlých kostí. Na rozdíl od proximálních falangů druhého až páteho prstu, proximální falang palce je embryologicky ekvivalentem středních falangů ostatních prstů, přičemž první metakarpální kost je embryologicky falangeálního původu a jako taková je ekvivalentem proximálních falangů ostatních prstů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complete or partial duplication of the proximal phalanx of the thumb. Depending on the severity, the appearance on x-ray can vary from a notched phalanx (the duplicated bone is almost completely fused with the phalanx), a partially fused appearance of the two bones, or two separate bones appearing side to side. In contrast to the proximal phalanges of the digits 2-5, the proximal phalanx of the thumb is embryologically equivalent to the middle phalanges of the other digits, whereas the first metacarpal is embryologically of phalangeal origin and as such equivalent to the proximal phalanges of the other digits.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009613"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Duplikace proximálního falangu palce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Duplication of the proximal phalanx of the thumb</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009614">
        <obo:IAO_0000115 xml:lang="cs">Tento termín se používá v případě kdy proximální falang palce ruky je částečně duplikovaný. Vzhledem k variabilite postižení mohou být na rentgenvém snímku různé nálezy od rozšpěpeného falangu (duplikovaná kost je téměř kompletně srostlá s falangem) až obraz dvou částečně srostlých kostí. Na rozdíl od proximálních falangů druhého až páteho prstu, proximální falang palce je embryologicky ekvivalentem středních falangů ostatních prstů, přičemž první metakarpální kost je embryologicky falangeálního původu a jako taková je ekvivalentem proximálních falangů ostatních prstů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Bifidní proximální falang palce ruky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009614"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Tento termín se používá v případě kdy proximální falang palce ruky je částečně duplikovaný. Vzhledem k variabilite postižení mohou být na rentgenvém snímku různé nálezy od rozšpěpeného falangu (duplikovaná kost je téměř kompletně srostlá s falangem) až obraz dvou částečně srostlých kostí. Na rozdíl od proximálních falangů druhého až páteho prstu, proximální falang palce je embryologicky ekvivalentem středních falangů ostatních prstů, přičemž první metakarpální kost je embryologicky falangeálního původu a jako taková je ekvivalentem proximálních falangů ostatních prstů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>This term applies if the proximal phalanx of the thumb is partially duplicated. Depending on the severity, the appearance on x-ray can vary from a notched phalanx (the duplicated bone is almost completely fused with the phalanx) to a partially fused appearance of the two bones. In contrast to the proximal phalanges of the digits 2-5, the proximal phalanx of the thumb is embryologically equivalent to the middle phalanges of the other digits, whereas the first metacarpal is embryologically of phalangeal origin and as such equivalent to the proximal phalanges of the other digits.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009614"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Bifidní proximální falang palce ruky</owl:annotatedTarget>
