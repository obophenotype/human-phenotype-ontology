    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030062">
        <obo:IAO_0000115 xml:lang="cs">Nezhoubný novotvar v oblasti hypofýzy, který pochází z Rathkeho výchlipky. Kraniofaryngeomy jsou benigní pomalu rostoucí nádory, které se nacházejí v oblasti selární a paraselární centrálního nervového systému.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kraniofaryngeom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030062"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nezhoubný novotvar v oblasti hypofýzy, který pochází z Rathkeho výchlipky. Kraniofaryngeomy jsou benigní pomalu rostoucí nádory, které se nacházejí v oblasti selární a paraselární centrálního nervového systému.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A benign pituitary-region neoplasm that originates from Rathke&apos;s pouch. Craniopharyngiomas are benign slow growing tumors that are located within the sellar and para sellar region of the central nervous system.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
