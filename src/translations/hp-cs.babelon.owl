        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Novotvar zadní hypofýzy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neoplasm of the posterior pituitary</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011753">
        <obo:IAO_0000115 xml:lang="cs">Abnormální vývoj neurohypofýzy během embryonálního růstu a vývoje.</obo:IAO_0000115>
