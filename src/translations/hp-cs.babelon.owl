    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012571">
        <obo:IAO_0000115 xml:lang="cs">Částečná duplikace močovodu, při níž zdvojené močovody splynou v jeden močovod před jejich vyústěním do močového měchýře</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Ureter fissus</rdfs:label>
    </rdf:Description>
