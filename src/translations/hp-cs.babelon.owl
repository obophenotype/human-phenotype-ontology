    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010948">
        <obo:IAO_0000115 xml:lang="cs">Strukturální abnormalita oběhového systému plodu. Termíny v této subhierarchii jsou omezeny na nálezy, které lze pozorovat pouze v prenatálním období. K popisu fetálních fenotypů lze použít i další termíny HPO.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální kardiovaskulární morfologie plodu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
