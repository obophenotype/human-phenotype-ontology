        <owl:annotatedTarget xml:lang="cs">Anomální reakce na test, který je navržen tak, aby prozkoumal funkci endokrinního systému</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomalous response to a test that is designed to probe the function of the endocrine system.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
