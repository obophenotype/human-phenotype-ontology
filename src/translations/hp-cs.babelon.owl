        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010616">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost plicního fibromu, nezhoubného novotvaru, který se může projevit jako útvar způsobující obstrukci dýchacích cest, kašel a hemoptýzu, nebo se může projevit bez příznaků jako solitární plicní uzlík.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fibrom plic</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010616"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost plicního fibromu, nezhoubného novotvaru, který se může projevit jako útvar způsobující obstrukci dýchacích cest, kašel a hemoptýzu, nebo se může projevit bez příznaků jako solitární plicní uzlík.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of a lung fibroma, a benign neoplasm that can present as a mass causing airway obstruction, cough, and hemoptysis, or present without symptoms as a solitary pulmonary nodule.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
