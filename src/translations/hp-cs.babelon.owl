        <owl:annotatedTarget xml:lang="cs">Žlutobílé zánětlivé agregáty ve sklivci, které se nacházejí ve střední části sklivce a na dolní periferii.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Yellow-white inflammatory aggregates in the vitreous that are found in the midvitreous and inferior periphery.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
