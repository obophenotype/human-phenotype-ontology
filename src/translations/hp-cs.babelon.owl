        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032630">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost valců obsahujících lehké řetězce imunoglobulinu v luminech renálních tubulů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Intratubulární válce z lehkých řetezců</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032630"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost valců obsahujících lehké řetězce imunoglobulinu v luminech renálních tubulů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of casts containing immunoglobulin light chains within the lumina of the renal tubules.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
