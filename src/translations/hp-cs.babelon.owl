        <owl:annotatedTarget xml:lang="cs">Fokální emoční záchvat se strachem/panikou bez poruchy vědomí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal aware emotional seizure with fear/anxiety/panic</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032739">
        <obo:IAO_0000115 xml:lang="cs">Fokální emoční záchvat s úzkostí je charakterizován přítomností úzkosti, strachu nebo paniky jako vyjádřených nebo pozorovaných emocí na počátku záchvatu. Vzhledem k nepříjemné povaze těchto záchvatů mohou mít pacienti také předvídavou úzkost z toho, že záchvaty budou mít.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální emoční záchvat se strachem/panikou</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032739"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální emoční záchvat s úzkostí je charakterizován přítomností úzkosti, strachu nebo paniky jako vyjádřených nebo pozorovaných emocí na počátku záchvatu. Vzhledem k nepříjemné povaze těchto záchvatů mohou mít pacienti také předvídavou úzkost z toho, že záchvaty budou mít.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal emotional seizure with anxiety is characterized by the presence of anxiety, fear or panic as an expressed or observed emotion, at the outset of the seizure. Because of the unpleasant nature of these seizures, patients may also have anticipatory anxiety about having seizures.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
