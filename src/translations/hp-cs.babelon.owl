        <babelon:source_value>Affective auras with subjective qualities similar to those experienced in life but are recognized by the subject as occurring outside of actual context.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
