    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012905">
        <obo:IAO_0000115 xml:lang="cs">Euryblepharon je abnormálně velká víčková štěrbin, která je prodoužena horizontálně. Vertikálně je víčko zkráceno. Bývá přítomna malpozice laterálních kantů a laterální ectropion.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Euryblefaron</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012905"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Euryblepharon je abnormálně velká víčková štěrbin, která je prodoužena horizontálně. Vertikálně je víčko zkráceno. Bývá přítomna malpozice laterálních kantů a laterální ectropion.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Euryblepharon is a congenital eyelid anomaly characterized by horizontal enlargement of the palpebral fissure. The eyelid is shortened vertically compared with the horizontal dimension, with associated lateral canthal malpositioning and lateral ectropion abnormally wide lid opening.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
