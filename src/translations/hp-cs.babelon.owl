        <babelon:source_value>Neonatal bilateral symmetric epileptic spasm</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032841">
        <obo:IAO_0000115 xml:lang="cs">Novorozenecký bilaterální asymetrický epileptický spasmus je náhlá flexe, extenze nebo smíšená extenze-flexe převážně proximálních a trunálních svalů, která se vyskytuje asymetricky na obou stranách těla.</obo:IAO_0000115>
