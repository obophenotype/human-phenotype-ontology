    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006732">
        <obo:IAO_0000115 xml:lang="cs">Typ papilárního renálního karcinomu, u něhož jsou papily pokryty velkými eozinofilními buňkami s pleomorfními jádry, výraznými jádry a jadernou pseudostratifikací.</obo:IAO_0000115>
