        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost výrazně zvýšené koncentrace albuminu v moči, definované jako poměr albuminu a kreatininu vyšší než 300 mg/gm (více než 34 mg/mmol).</owl:annotatedTarget>
