    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009274">
        <obo:IAO_0000115 xml:lang="cs">Chronická ztráta pohyblivosti čtvrtého prstu v důsledku strukturálních změn v nekostních/měkkých tkáních. Termín kamptodaktylie 4. prstu se používá pokud jsou postiženy distální nebo proximální interfalangeální klouby</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kloubní kontraktura 4. prstu na ruce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009274"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Chronická ztráta pohyblivosti čtvrtého prstu v důsledku strukturálních změn v nekostních/měkkých tkáních. Termín kamptodaktylie 4. prstu se používá pokud jsou postiženy distální nebo proximální interfalangeální klouby</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic loss of joint motion in the 4th finger due to structural changes in non-bony tissue. The term camptodactyly of the 4th finger is used if the distal and/or proximal interphalangeal joints are affected.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009274"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kloubní kontraktura 4. prstu na ruce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Joint contracture of the 4th finger</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009275">
        <obo:IAO_0000115 xml:lang="cs">Chronická ztráta pohyblivosti distálního interfalangeálního kloubu 4. prstu na ruce v důsledku strukturálních změn v měkkých/nekostních tkáních</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kontraktura distálního interfalangeálního kloubu 4. prstu na ruce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009275"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Chronická ztráta pohyblivosti distálního interfalangeálního kloubu 4. prstu na ruce v důsledku strukturálních změn v měkkých/nekostních tkáních</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic loss of joint motion of the distal interphalangeal joint of the 4th finger due to structural changes in non-bony tissue.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009275"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kontraktura distálního interfalangeálního kloubu 4. prstu na ruce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Contracture of the distal interphalangeal joint of the 4th finger</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009276">
        <obo:IAO_0000115 xml:lang="cs">Chronická ztráta pohyblivosti proximálního interfalangeálního kloubu 4. prstu na ruce v důsledku strukturálních změn v měkkých/nekostních tkáních. To znamená, že PIP kloub čtvrtého prstu je ohnutý (ve flexi) a nelze jej narovnat aktivně nebo pasivně. Jedná se tedy o chronickou ztrátu kloubní pohyblivosti v důsledku strukturálních změn svalu, šlach, vazů nebo kůže, které brání normálnímu pohybu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kontraktura proximálního interfalangeálního kloubu 4. prstu na ruce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009276"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Chronická ztráta pohyblivosti proximálního interfalangeálního kloubu 4. prstu na ruce v důsledku strukturálních změn v měkkých/nekostních tkáních. To znamená, že PIP kloub čtvrtého prstu je ohnutý (ve flexi) a nelze jej narovnat aktivně nebo pasivně. Jedná se tedy o chronickou ztrátu kloubní pohyblivosti v důsledku strukturálních změn svalu, šlach, vazů nebo kůže, které brání normálnímu pohybu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic loss of joint motion of the proximal interphalangeal joint of the 4th finger due to structural changes in non-bony tissue. That is, the PIP joint of a fourth finger is bent (flexed) and cannot be straightened actively or passively. It is thus a chronic loss of joint motion due to structural changes in muscle, tendons, ligaments, or skin that prevents normal movement.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009276"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kontraktura proximálního interfalangeálního kloubu 4. prstu na ruce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Contracture of the proximal interphalangeal joint of the 4th finger</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009277">
        <obo:IAO_0000115 xml:lang="cs">Chronická ztráta pohyblivosti metakarpofalangeálního kloubu 4. prstu v důsledku strukturálních změn v měkkých/nekostních tkáních</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kontraktura metakarpofalangeálního kloubu 4. prstu</rdfs:label>
    </rdf:Description>
