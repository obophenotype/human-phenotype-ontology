        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031125"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Snížený destičkový alfa-2A-adrenergní receptor</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased platelet alpha-2A-adrenergic receptor</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031126">
        <obo:IAO_0000115 xml:lang="cs">Krevní destičky obsahují kontraktilní proteiny (aktin a myosin), které vyvolávají stažení sraženiny. Jak se krevní destičky stahují, tahají za okolní fibrinová vlákna, stlačují sérum z hmoty, zhutňují sraženinu a přitahují prasklé okraje krevní cévy těsněji k sobě. Retrakce sraženiny je přímo úměrná počtu krevních destiček a nepřímo úměrná koncentraci fibrinogenu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zhoršená retrakce sraženiny</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031126"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Krevní destičky obsahují kontraktilní proteiny (aktin a myosin), které vyvolávají stažení sraženiny. Jak se krevní destičky stahují, tahají za okolní fibrinová vlákna, stlačují sérum z hmoty, zhutňují sraženinu a přitahují prasklé okraje krevní cévy těsněji k sobě. Retrakce sraženiny je přímo úměrná počtu krevních destiček a nepřímo úměrná koncentraci fibrinogenu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Platelets contain contractile proteins (actin and myosin) that induce clot retraction. As the platelets contract, they pull on the surrounding fibrin strands, squeezing serum form the mass, compacting the clot and drawing the ruptured edges of the blood vessel more closely together. Clot retraction is directly proportional to the platelet count and inversely proportional to the fibrinogen concentration.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031126"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zhoršená retrakce sraženiny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired clot retraction</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031127">
        <obo:IAO_0000115 xml:lang="cs">Abnormální reakce na convulxin, která se projevuje sníženou nebo chybějící agregací krevních destiček po přidání convulxinu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zhoršená agregace destiček vyvolaná convulxinem</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031127"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální reakce na convulxin, která se projevuje sníženou nebo chybějící agregací krevních destiček po přidání convulxinu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal response to convulxin as manifested by reduced or lacking aggregation of platelets upon addition of convulxin.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031127"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zhoršená agregace destiček vyvolaná convulxinem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired convulxin-induced platelet aggregation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031128">
        <obo:IAO_0000115 xml:lang="cs">Abnormální reakce na peptid odvozený od kolagenu (collagen-related peptid, CRP), která se projevuje sníženou nebo chybějící agregací krevních destiček po přidání CRP</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zhoršená agregace destiček vyvolaná peptidem odvozeným od kolagenu (collagen-related peptid, CRP)</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031128"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální reakce na peptid odvozený od kolagenu (collagen-related peptid, CRP), která se projevuje sníženou nebo chybějící agregací krevních destiček po přidání CRP</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal response to collagen-related peptide (CRP) as manifested by reduced or lacking aggregation of platelets upon addition of CRP.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031128"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zhoršená agregace destiček vyvolaná peptidem odvozeným od kolagenu (collagen-related peptid, CRP)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired collagen-related peptide-induced platelet aggregation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
