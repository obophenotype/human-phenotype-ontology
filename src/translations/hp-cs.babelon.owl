        <owl:annotatedTarget xml:lang="cs">Torze varlete nastane, když se spermatický provazec varlete zkroutí a přeruší přívod krve. Nejčastějším příznakem je akutní bolest varlete.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
