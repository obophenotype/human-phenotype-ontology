        <owl:annotatedTarget xml:lang="cs">Fokální kognitivní záchvat s anomií charakterizovaný poruchou vědomí v určitém okamžiku během záchvatu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal cognitive seizure with anomia characterized by impairment of awareness at some point during the seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032791"/>
