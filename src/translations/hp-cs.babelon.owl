    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001923">
        <obo:IAO_0000115 xml:lang="cs">Zvýšení počtu retikulocytů (nezralé erytrocyty) v periferním krevním oběhu</obo:IAO_0000115>
