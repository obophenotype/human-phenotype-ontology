        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální hladina cirkulujícího inhibinu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal circulating inhibin level</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031100">
        <obo:IAO_0000115 xml:lang="cs">Snížená koncentrace inhibinu B v krvi</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená hladina inhibinu B</rdfs:label>
    </rdf:Description>
