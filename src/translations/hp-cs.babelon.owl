        <owl:annotatedTarget xml:lang="cs">Ependymoblastom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ependymoblastoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030067">
        <obo:IAO_0000115 xml:lang="cs">Primitivní neuroektodermální nádor, který se vyskytuje extrakraniálně v měkkých tkáních a kostech</obo:IAO_0000115>
