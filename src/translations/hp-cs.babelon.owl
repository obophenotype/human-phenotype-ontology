        <babelon:source_value>Lack of spontaneous play</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000722">
        <obo:IAO_0000115 xml:lang="cs">Recidivující obsesivní nebo kompulzivní (nutkavé) chování, které je natolik závažné, že může být časově náročné (tj. trvají více než 1 hodinu denně) nebo způsobují značnou úzkost nebo významné omezení (DSM-IV)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Obsedantně-kompulzivní chování</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000722"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Recidivující obsesivní nebo kompulzivní (nutkavé) chování, které je natolik závažné, že může být časově náročné (tj. trvají více než 1 hodinu denně) nebo způsobují značnou úzkost nebo významné omezení (DSM-IV)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>&quot;Behavior that consists of repetitive acts, characterized by the feeling that one &quot;&quot;has to&quot;&quot; perform them, while being aware that these acts are not in line with one&apos;s overall goal.&quot;</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000722"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Obsedantně-kompulzivní chování</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Compulsive behaviors</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000723">
        <obo:IAO_0000115 xml:lang="cs">Chování charakterizované mimořádným omezeným okruhem zájmů a aktivit</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Restriktivní chování</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000723"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Chování charakterizované mimořádným omezeným okruhem zájmů a aktivit</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Behavior characterized by an abnormal limitation to a few interests and activities.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000723"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
