        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001707">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita pravé srdeční komory</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie pravé komory</rdfs:label>
