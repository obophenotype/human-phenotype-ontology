        <owl:annotatedTarget xml:lang="cs">Klonus kolene</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Knee clonus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011450">
        <obo:IAO_0000115 xml:lang="cs">Typ infekce centrálního nervového systému, který lze považovat za známku patologické náchylnosti k infekcím</obo:IAO_0000115>
