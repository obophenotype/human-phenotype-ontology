    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100301">
        <obo:IAO_0000115 xml:lang="cs">Neobvyklé oblasti hustě zabalených membránových tubulů známých jako tubulární agregáty, které se prezentují jako membránové inkluze, odvozené z membrán sarkoplazmatického retikula a mitochondrií, obsahující různé proteiny s různými enzymatickými aktivitami.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Tubulární inkluze svalových vláken</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100301"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neobvyklé oblasti hustě zabalených membránových tubulů známých jako tubulární agregáty, které se prezentují jako membránové inkluze, odvozené z membrán sarkoplazmatického retikula a mitochondrií, obsahující různé proteiny s různými enzymatickými aktivitami.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Unusual regions of densely packed membranous tubules known as tubular aggregates which present as membranous inclusions, derived from membranes of sarcoplasmic reticulum and mitochondria, containing miscellaneous proteins with a variety of enzymatic activities.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
