        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031386">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost abnormálně vysokého počtu mikromegakaryocytů v kostní dřeni. Mikromegakaryocyty jsou jednojaderné diploidní buňky s jádrem podobné velikosti jako myeloblast nebo promyelocyt, přičemž průměr buňky je menší než 30 mikrometrů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšený počet mikromegakaryocytů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031386"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost abnormálně vysokého počtu mikromegakaryocytů v kostní dřeni. Mikromegakaryocyty jsou jednojaderné diploidní buňky s jádrem podobné velikosti jako myeloblast nebo promyelocyt, přičemž průměr buňky je menší než 30 mikrometrů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of abnormally high numbers of micromegakaryocytes in the bone marrow. Micromegakaryocytes are mononuclear diploid cells, with a nucleus similar in size to that of a myeloblast or promyelocyte with the cell being less than 30 micrometers in diameter.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031386"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšený počet mikromegakaryocytů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased micromegakaryocyte count</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031387">
