    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000934">
        <obo:IAO_0000115 xml:lang="cs">Radiografický důkaz kloubních kalcifikací tvořených depozity kalcium pyrofosfátu v měkkých tkáních kolem kloubů a úponů šlach blízko kloubů</obo:IAO_0000115>
