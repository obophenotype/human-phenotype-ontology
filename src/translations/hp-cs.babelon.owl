    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011798">
        <obo:IAO_0000115 xml:lang="cs">Nádor ledviny pocházející z oncocytu, což je epitelová buňka vyznačující se nadměrným množství mitochondrií, což vede k výrazné acidofilní, granulární cytoplazmě</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Renální onkocytom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011798"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nádor ledviny pocházející z oncocytu, což je epitelová buňka vyznačující se nadměrným množství mitochondrií, což vede k výrazné acidofilní, granulární cytoplazmě</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A renal tumor originating from an oncocyte, which is an epithelial cell characterized by an excessive amount of mitochondria, resulting in an abundant acidophilic, granular cytoplasm.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
