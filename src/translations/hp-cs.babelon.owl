    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004345">
        <obo:IAO_0000115 xml:lang="cs">Defekty lysozomálních glykosidáz nebo specifických koaktivátorů vedou k akumulaci substrátů, jako jsou glykosfingolipidy, včetně gangliosidů při GM1 gangliosidóze (Tay-Sachsova choroba) a GM2 gangliosidóze (Sandhoffova choroba)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Akumulace gangliosidů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004345"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Defekty lysozomálních glykosidáz nebo specifických koaktivátorů vedou k akumulaci substrátů, jako jsou glykosfingolipidy, včetně gangliosidů při GM1 gangliosidóze (Tay-Sachsova choroba) a GM2 gangliosidóze (Sandhoffova choroba)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Defects in the lysosomal glycosidases or specific co-activators, result in accumulation of the substrates, such as glycosphingolipids, including gangliosides in GM1 gangliosidosis (Tay-Sachs disease) and GM2 gangliosidosis (Sandhoff disease).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
