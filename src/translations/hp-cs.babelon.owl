        <babelon:source_value>Atrial septal dilatation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011996">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená aktivita koagulačního faktoru V. Faktor V je aktivován na faktor Va pomocí nepatrného množství trombinu (a inaktivován větším množstvím trombinu). Aktivovaný faktor V (fVa) je kofaktorem při tvorbě protrombinázového komplexu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená koagulační aktivita faktoru V</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011996"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená aktivita koagulačního faktoru V. Faktor V je aktivován na faktor Va pomocí nepatrného množství trombinu (a inaktivován větším množstvím trombinu). Aktivovaný faktor V (fVa) je kofaktorem při tvorbě protrombinázového komplexu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased activity of coagulation factor V, Factor V, which is activated to factor Va by means of minute amounts of thrombin (and inactivated by larger amounts of thrombin). Activated factor V (fVa) is a cofactor in the formation of the prothrombinase complex.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011996"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená koagulační aktivita faktoru V</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elevated coagulation factor V activity</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
