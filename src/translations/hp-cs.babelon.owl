        <owl:annotatedTarget xml:lang="cs">Porod plodu pomocí chirurgických řezů provedených přes břišní stěnu (laparotomie) a děložní stěnu (hysterotomie).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
