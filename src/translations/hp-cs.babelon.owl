        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000309">
        <obo:IAO_0000115 xml:lang="cs">Anomálie stření části obličeje, co je regionem a ne anatomickým termín. Superiorně je ohraničen spodní orbitální hranou, inferiorně sahá do úrovně baze nosu. Je tvořen maxillou (horní čelistí), lícnimi kostmi, tvářemi a malární oblastí. Nos a premaxilla nejsou obvykle zahrnuty do střední části obličeje</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie střední části obličeje</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000309"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomálie stření části obličeje, co je regionem a ne anatomickým termín. Superiorně je ohraničen spodní orbitální hranou, inferiorně sahá do úrovně baze nosu. Je tvořen maxillou (horní čelistí), lícnimi kostmi, tvářemi a malární oblastí. Nos a premaxilla nejsou obvykle zahrnuty do střední části obličeje</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly of the midface, which is a region and not an anatomical term. It extends, superiorly, from the inferior orbital margin to, inferiorly, the level of nasal base. It is formed by the maxilla (upper jaw) and zygoma and cheeks and malar region. Traditionally, the nose and premaxilla are not included in the midface.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000309"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální morfologie střední části obličeje</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal midface morphology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000311">
        <obo:IAO_0000115 xml:lang="cs">Obličej se při pohledu zpředu jeví více kulatý než je obvyklé</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kulatý obličej</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000311"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Obličej se při pohledu zpředu jeví více kulatý než je obvyklé</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The facial appearance is more circular than usual as viewed from the front.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
