    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030815">
        <obo:IAO_0000115 xml:lang="cs">Lipom lokalizovaný na jazyku. Může se projevovat jako necitlivý, měkký, kulovitý útvar na jazyku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Lipom jazyka</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030815"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
