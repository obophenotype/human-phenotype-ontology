        <obo:IAO_0000115 xml:lang="cs">Typ nemalobuněčného karcinomu plic, který je odvozen z vrstevnatých dlaždicových epiteliálních buněk</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Skvamocelulární karcinom plic</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030359"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ nemalobuněčného karcinomu plic, který je odvozen z vrstevnatých dlaždicových epiteliálních buněk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of non-small cell lung carcinoma that is derived from stratified squamous epithelial cells.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
