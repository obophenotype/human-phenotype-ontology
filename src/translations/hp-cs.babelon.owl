    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010219">
        <obo:IAO_0000115 xml:lang="cs">Deformita nohy z důvodu abnormality postihující kosti nohy (a následně i svalová a měkká tkáň). Oproti tomu, je-li ovlivněna pouze svalová a měkká tkáň, použije se termín polohová deformita nohy</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Strukturální deformita nohy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010219"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Deformita nohy z důvodu abnormality postihující kosti nohy (a následně i svalová a měkká tkáň). Oproti tomu, je-li ovlivněna pouze svalová a měkká tkáň, použije se termín polohová deformita nohy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A foot deformity resulting due to an abnormality affecting the bones of the foot (as well as muscle and soft tissue). In contrast if only the muscle and soft tissue are affected the term positional foot deformity applies.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
