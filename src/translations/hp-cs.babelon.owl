        <owl:annotatedTarget xml:lang="cs">Afektivní aury</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Affective epileptic aura</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012004">
        <obo:IAO_0000115 xml:lang="cs">Aury, které odrážejí iktální dysmnézii, jako jsou: pocity jako známost (deja-vu) a neznámost (jamais-vu)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mnemonické aury</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012004"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Aury, které odrážejí iktální dysmnézii, jako jsou: pocity jako známost (deja-vu) a neznámost (jamais-vu)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal cognitive seizure characterized by memory phenomena such as feelings of familiarity (deja vu) and unfamiliarity (jamais vu) as the initial semiological manifestation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012004"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mnemonické aury</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cognitive seizure with deja vu/jamais vu</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012005">
        <obo:IAO_0000115 xml:lang="cs">Subjektivní pocit, že zážitek, který se objevuje poprvé, již byl prožit.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Deja vu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012005"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Subjektivní pocit, že zážitek, který se objevuje poprvé, již byl prožit.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A subjective feeling that an experience which is occurring for the first time has been experienced before.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
