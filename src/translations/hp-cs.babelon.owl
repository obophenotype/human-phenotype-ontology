        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of abnormal punctate (speckled, dot-like) calcifications in the epiphysis of the proximal phalanx of the 4th finger.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
