    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025124">
        <obo:IAO_0000115 xml:lang="cs">Tendence zubů lámat se, doložená anamnézou opakovaných zlomenin zubů bez náležitého traumatu, které by to mohlo vyvolat.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fragilní zuby</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025124"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Tendence zubů lámat se, doložená anamnézou opakovaných zlomenin zubů bez náležitého traumatu, které by to mohlo vyvolat.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A tendency of teeth to fracture as manifested by a history of repeated fracture of the dental enamel without adequate trauma.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025124"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
