    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001180">
        <obo:IAO_0000115 xml:lang="cs">Vývojová vada mající za následek méně než normální počet prstů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Oligodaktylie ruky</rdfs:label>
    </rdf:Description>
