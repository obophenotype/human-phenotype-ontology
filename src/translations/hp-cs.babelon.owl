    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003383">
        <obo:IAO_0000115 xml:lang="cs">&quot;Opakované epizody segmentální demyelinizace a remyelinizace vedou k akumulaci nadpočetných Schwannových buněk kolem axonů, což se označuje jako &quot;&quot;cibulovitá formace&quot;&quot;. Tento nález postihuje periferní nervy.&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Cibulovité formace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003383"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">&quot;Opakované epizody segmentální demyelinizace a remyelinizace vedou k akumulaci nadpočetných Schwannových buněk kolem axonů, což se označuje jako &quot;&quot;cibulovitá formace&quot;&quot;. Tento nález postihuje periferní nervy.&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Repeated episodes of segmental demyelination and remyelination lead to the accumulation of supernumerary Schwann cells around axons, which is referred to as onion bulb formation. This finding affects peripheral nerves.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
