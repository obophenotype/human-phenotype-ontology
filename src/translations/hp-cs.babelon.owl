    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100582">
        <obo:IAO_0000115 xml:lang="cs">Polypoidní masy vznikající ze sliznice nosní a paranazálních dutin. Dá se nimi pohybovat, jsou nebolestivé a často doprovázejí alergickou rýmu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nosní polypóza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100582"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Polypoidní masy vznikající ze sliznice nosní a paranazálních dutin. Dá se nimi pohybovat, jsou nebolestivé a často doprovázejí alergickou rýmu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Polypoidal masses arising mainly from the mucous membranes of the nose and paranasal sinuses. They are freely movable and nontender overgrowths of the mucosa that frequently accompany allergic rhinitis.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
