        <owl:annotatedTarget xml:lang="cs">Meduloblastom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Medulloblastoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002886">
        <obo:IAO_0000115 xml:lang="cs">Nádor, který se vyvíjí v retrostyloidním kompartmentu parafaryngeálního prostoru, pocházející z ostrůvku paragangliové tkáně odvozené z neurální lišty, který se nachází na nervu vagus</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vagální paragangliom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002886"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nádor, který se vyvíjí v retrostyloidním kompartmentu parafaryngeálního prostoru, pocházející z ostrůvku paragangliové tkáně odvozené z neurální lišty, který se nachází na nervu vagus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A tumor that develops in the retrostyloid compartment of the parapharyngeal space, arising from an island of paraganglion tissue derived from the neural crest that is located on the vagus nerve.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
