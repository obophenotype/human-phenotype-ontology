    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005526">
        <obo:IAO_0000115 xml:lang="cs">Zhoubný lymfocytární novotvar B- nebo T-buněk postihující primárně kostní dřeň a periferní krev. Tato kategorie zahrnuje prekurzorové nebo akutní lymfoblastické leukémie a chronické leukémie</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Lymfoidní leukémie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005526"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zhoubný lymfocytární novotvar B- nebo T-buněk postihující primárně kostní dřeň a periferní krev. Tato kategorie zahrnuje prekurzorové nebo akutní lymfoblastické leukémie a chronické leukémie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A malignant lymphocytic neoplasm of B-cell or T-cell lineage involving primarily the bone marrow and the peripheral blood. This category includes precursor or acute lymphoblastic leukemias and chronic leukemias.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
