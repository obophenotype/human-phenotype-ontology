    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032066">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli odchylka od normální koncentrace bikarbonátu, (HCO3-), v krevním oběhu</obo:IAO_0000115>
