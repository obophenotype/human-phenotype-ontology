    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033075">
        <obo:IAO_0000115 xml:lang="cs">Normální nebo zvýšená hladina hormonu stimulujícího štítnou žlázu (TSH) v séru při zvýšené hladině cirkulujícího FT4 a/nebo FT3.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nepřiměřeně normální hladina hormonu stimulujícího štítnou žlázu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033075"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Normální nebo zvýšená hladina hormonu stimulujícího štítnou žlázu (TSH) v séru při zvýšené hladině cirkulujícího FT4 a/nebo FT3.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A normal or elevated serum thyroid-stimulating hormone (TSH) level in the face of an elevation in circulating FT4 and/or FT3.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033075"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nepřiměřeně normální hladina hormonu stimulujícího štítnou žlázu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inappropriately normal thyroid-stimulating hormone level</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033076">
        <obo:IAO_0000115 xml:lang="cs">Odchylka od normální koncentrace volného tyroxinu (T4) v krevním oběhu. Cirkulující T4 je téměř zcela vázán na specifické transportní proteiny, jako je tyroxin-vázající globulin (TBG), ale právě nevázaná (volná) frakce je schopna pronikat do tkání a působit na ně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální koncentrace cirkulujícího volného T4</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033076"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Odchylka od normální koncentrace volného tyroxinu (T4) v krevním oběhu. Cirkulující T4 je téměř zcela vázán na specifické transportní proteiny, jako je tyroxin-vázající globulin (TBG), ale právě nevázaná (volná) frakce je schopna pronikat do tkání a působit na ně.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deviation from the normal concentration of free thyroxine (T4) in the blood circulation. Circulating T4 is almost entirely bound to specific transport proteins such as thyroxine-binding globulin (TBG) but it is the unbound (free) fraction that is able to enter tissues and exert effects.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033076"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální koncentrace cirkulujícího volného T4</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal circulating free T4 concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
