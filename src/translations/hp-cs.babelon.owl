    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011536">
        <obo:IAO_0000115 xml:lang="cs">Izomerie pravé síně je charakterizována oboustrannými trojúhelníkovitými, morfologicky pravostrannými síňovými přídavky, které se podél širokého čela s vnitřním koncovým hřebenem připojují k síňové komoře.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Izomerie pravé srdeční síně</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011536"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Izomerie pravé síně je charakterizována oboustrannými trojúhelníkovitými, morfologicky pravostrannými síňovými přídavky, které se podél širokého čela s vnitřním koncovým hřebenem připojují k síňové komoře.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Right atrial isomerism is characterized by bilateral triangular, morphologically right atrial, appendages, both joining the atrial chamber along a broad front with internal terminal crest.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011536"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Izomerie pravé srdeční síně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Right atrial isomerism</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011537">
        <obo:IAO_0000115 xml:lang="cs">U izomerie levé síně je oboustranný malý prstovitý morfologický úpon levé síně spojující síňovou komoru podél úzké předsíně bez vnitřního koncového hřebene.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Izomerie levé srdeční síně</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011537"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">U izomerie levé síně je oboustranný malý prstovitý morfologický úpon levé síně spojující síňovou komoru podél úzké předsíně bez vnitřního koncového hřebene.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>In left atrial isomerism there is a bilateral small finger-shaped morphologically left atrial appendage joining the atrial chamber along a narrow front without an internal terminal crest.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011537"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Izomerie levé srdeční síně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Left atrial isomerism</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011538">
        <obo:IAO_0000115 xml:lang="cs">Zrcadlové uspořádání síní s morfologickou pravou síní na levé straně a morfologickou levou síní na pravé straně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Síňový situs inversus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011538"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zrcadlové uspořádání síní s morfologickou pravou síní na levé straně a morfologickou levou síní na pravé straně.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mirror image atrial arrangement, with morphologic right atrium on the left hand side and morphologic left atrium on the right hand side.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011538"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Síňový situs inversus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrial situs inversus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011539">
        <obo:IAO_0000115 xml:lang="cs">Společná síň bez definováných morfologických znaků</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Síňový situs ambiguus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011539"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Společná síň bez definováných morfologických znaků</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Common atrium without defining morphologic features.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011539"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Síňový situs ambiguus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrial situs ambiguous</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011540">
        <obo:IAO_0000115 xml:lang="cs">Podstatou vady je kombinace nesouladu atrioventrikulárních a ventrikulo-arteriálních spojení. Morfologicky pravá síň je tedy přes mitrální chlopeň spojena s morfologicky levou komorou, levá komora je pak spojena s truncus pulmonalis. Morfologicky levá síň je spojena s morfologicky pravou komorou přes trikuspidální chlopeň, přičemž morfologicky pravá komora je spojena s aortou.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Korigovaná transpozice velkých tepen</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011540"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Podstatou vady je kombinace nesouladu atrioventrikulárních a ventrikulo-arteriálních spojení. Morfologicky pravá síň je tedy přes mitrální chlopeň spojena s morfologicky levou komorou, levá komora je pak spojena s truncus pulmonalis. Morfologicky levá síň je spojena s morfologicky pravou komorou přes trikuspidální chlopeň, přičemž morfologicky pravá komora je spojena s aortou.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Congenitally corrected transposition of the great arteries (ccTGA) is a discordance of atrioventricular (AV) and ventriculoarterial connections. The anatomy of ccTGA involves systemic venous drainage to the morphologic right atrium (mRA), which is connected via the mitral valve to the morphologic left ventricle (mLV) whose outflow is the pulmonary arterial system. The pulmonary venous drainage arrives at the morphologic left atrium (mLA), which crosses the tricuspid valve into the morphologic right ventricle (mRV) with outflow into the systemic arterial system. In isolation, ccTGA has an in-series circulation without mixing; therefore, the presence or absence of associated defects dictates the patient&apos;s clinical presentation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011540"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Korigovaná transpozice velkých tepen</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Levotransposition of the great arteries</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011541">
        <obo:IAO_0000115 xml:lang="cs">Křížení vtokových proudů obou komor v důsledku zjevného stočení srdce kolem jeho dlouhé osy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zkřížené atrioventrikulární chlopně</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011541"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Křížení vtokových proudů obou komor v důsledku zjevného stočení srdce kolem jeho dlouhé osy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Crossing of the inflow streams of the two ventricles, due to an apparent twisting of the heart about its long axis.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011541"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zkřížené atrioventrikulární chlopně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Criss-cross atrioventricular valves</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011542">
        <obo:IAO_0000115 xml:lang="cs">Zkřížené atrioventrikulární chlopně se vzácnou srdeční vadou, která se vyznačuje tím, že obě komory leží nad sebou místo vedle sebe.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zkřížené atrioventrikulární chlopně s horní a dolní komorou</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011542"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zkřížené atrioventrikulární chlopně se vzácnou srdeční vadou, která se vyznačuje tím, že obě komory leží nad sebou místo vedle sebe.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Criss-cross atrioventricular valves with a rare cardiac malformation characterized by the two ventricles lying one above the other instead of side by side.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011542"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zkřížené atrioventrikulární chlopně s horní a dolní komorou</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Criss-cross atrioventricular valves with superior-inferior ventricles</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011543">
        <rdfs:label xml:lang="cs">Horní a dolní komory bez zkřížených atrioventrikulárních chlopní</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011543"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Horní a dolní komory bez zkřížených atrioventrikulárních chlopní</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Superior-inferior ventricles without criss-cross atrioventricular valves</babelon:source_value>
