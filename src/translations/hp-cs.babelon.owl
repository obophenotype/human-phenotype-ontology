        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032871">
        <obo:IAO_0000115 xml:lang="cs">Fokální kognitivní záchvat s halucinacemi charakterizovaný zachovaným vědomím po celou dobu záchvatu.</obo:IAO_0000115>
