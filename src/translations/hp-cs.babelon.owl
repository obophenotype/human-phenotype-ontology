    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000256">
        <obo:IAO_0000115 xml:lang="cs">Okcipitofrontální obvod hlavy větší než 97. percentil v provnaní s normou. Alternativně, očividně zvětšená velikost lebky</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Makrocefalie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000256"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Okcipitofrontální obvod hlavy větší než 97. percentil v provnaní s normou. Alternativně, očividně zvětšená velikost lebky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
