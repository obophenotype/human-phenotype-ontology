    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032027">
        <obo:IAO_0000115 xml:lang="cs">Žluté, bílé nebo šedavé léze na sítnici, které jsou dobře ohraničené/výrazné, jednotlivé a většinou stejné velikosti.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Sítnicové tečky</rdfs:label>
    </rdf:Description>
