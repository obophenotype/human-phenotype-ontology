        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complete heart block with narrow QRS complexes</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005180">
        <obo:IAO_0000115 xml:lang="cs">Nedostatečné uzavření trikuspidální chlopně při stahu pravé komory, které způsobuje regurgitaci (zpětný tok) krve do pravé síně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Trikuspidální regurgitace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005180"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nedostatečné uzavření trikuspidální chlopně při stahu pravé komory, které způsobuje regurgitaci (zpětný tok) krve do pravé síně.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Failure of the tricuspid valve to close sufficiently upon contraction of the right ventricle, causing blood to regurgitate (flow backward) into the right atrium.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
