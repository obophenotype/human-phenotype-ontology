        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001155">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita zasahující jednu nebo obě ruce</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormalita ruky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001155"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita zasahující jednu nebo obě ruce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality affecting one or both hands.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001155"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita ruky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of the hand</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001156">
        <obo:IAO_0000115 xml:lang="cs">Prsty které se zdají disproporčně krátké vzhledem k ruce/noze. Existuje vícero typů brachydaktylií typy A až E</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Brachydaktylie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001156"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Prsty které se zdají disproporčně krátké vzhledem k ruce/noze. Existuje vícero typů brachydaktylií typy A až E</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Digits that appear disproportionately short compared to the hand/foot. The word brachydactyly is used here to describe a series distinct patterns of shortened digits (brachydactyly types A-E). This is the sense used here.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001156"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Brachydaktylie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Brachydactyly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001159">
        <obo:IAO_0000115 xml:lang="cs">Částečný či úplný srůst prstů ruky nebo nohy, v různém rozsahu od pouhé kožní řasy (jednoduchá syndaktylie) mezi prsty po srůsty na úrovni kostí (komplexní syndaktylie). Dle délky syndaktylie rozlišujeme kompletní a nekompletní syndaktylii, nekompletní lze dále rozdělit na proximální či distální. Pojem symfalangismus označuje srůst článků prstů v proximo - distálním směru, tj. za sebou směrem akrálně</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Syndaktylie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001159"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Částečný či úplný srůst prstů ruky nebo nohy, v různém rozsahu od pouhé kožní řasy (jednoduchá syndaktylie) mezi prsty po srůsty na úrovni kostí (komplexní syndaktylie). Dle délky syndaktylie rozlišujeme kompletní a nekompletní syndaktylii, nekompletní lze dále rozdělit na proximální či distální. Pojem symfalangismus označuje srůst článků prstů v proximo - distálním směru, tj. za sebou směrem akrálně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>&quot;Webbing or fusion of the fingers or toes, involving soft parts only or including bone structure. Bony fusions are referred to as &quot;&quot;bony&quot;&quot; syndactyly if the fusion occurs in a radio-ulnar axis. Fusions of bones of the fingers or toes in a proximo-distal axis are referred to as &quot;&quot;symphalangism&quot;&quot;.&quot;</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001159"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Syndaktylie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Syndactyly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001161">
        <obo:IAO_0000115 xml:lang="cs">Druh polydaktylie charakterizované přítomností nadbytečného prstu nebo prstů ruky</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Polydaktylie ruky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001161"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Druh polydaktylie charakterizované přítomností nadbytečného prstu nebo prstů ruky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A kind of polydactyly characterized by the presence of a supernumerary finger or fingers.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001161"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Polydaktylie ruky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hand polydactyly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001162">
        <obo:IAO_0000115 xml:lang="cs">Nadpočetné prsty ruky lokalizované na ulnární (malíkové) hraně ruky</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Postaxiální polydaktylie ruky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001162"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nadpočetné prsty ruky lokalizované na ulnární (malíkové) hraně ruky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Supernumerary digits located at the ulnar side of the hand (that is, on the side with the fifth finger).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001162"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Postaxiální polydaktylie ruky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Postaxial hand polydactyly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001166">
        <obo:IAO_0000115 xml:lang="cs">&quot;Abnormálně dlouhé a štíhlé prsty (&quot;&quot;pavoučí prsty&quot;&quot;)&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Arachnodaktylie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001166"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">&quot;Abnormálně dlouhé a štíhlé prsty (&quot;&quot;pavoučí prsty&quot;&quot;)&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
