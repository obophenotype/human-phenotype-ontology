    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010208">
        <obo:IAO_0000115 xml:lang="cs">Nepravidelné (nerovnoměrné) zvýšení kostní denzity jedné nebo více proximálních falang prstů na noze. Tento stav může mít mnoho forem v závislosti na závažnosti a rozmístnění patrném na rentgenovém snímku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nepravidelná skleróza proximální falangy prstu na noze</rdfs:label>
    </rdf:Description>
