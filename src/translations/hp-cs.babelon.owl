    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010867">
        <obo:IAO_0000115 xml:lang="cs">Typ ataxie charakterizovaný poruchou schopnosti plynule vykonávat prvky volního pohybu v odpovídajícím pořadí a rychlosti. Při dyssynergii se volní pohyb jeví jako roztříštěný na jednotlivé složky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dyssynergie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010867"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ ataxie charakterizovaný poruchou schopnosti plynule vykonávat prvky volního pohybu v odpovídajícím pořadí a rychlosti. Při dyssynergii se volní pohyb jeví jako roztříštěný na jednotlivé složky.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of ataxia characterized by the impairment of the ability to smoothly perform the elements of a voluntary movement in the appropriate order and speed. With dyssynergia, a voluntary movement appears broken down into its component parts.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010867"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Dyssynergie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dyssynergia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010868">
        <obo:IAO_0000115 xml:lang="cs">Typ dyssynergie postihující oční pohyby a charakterizovaný neschopností plynule sledovat zrakový cíl v celém zorném poli.</obo:IAO_0000115>
