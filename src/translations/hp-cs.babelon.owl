    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032083">
        <obo:IAO_0000115 xml:lang="cs">Ztráta a/nebo fragmentace elastických vláken tunica media aorty, která vytváří stále více rozšířené translamelární prostory s chyběním elastických vláken a zvětšujícími se mezerami v lamelách elastických vláken, jak bylo zjištěno při barvení na elastická vlákna.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fragmentace elastických vláken aorty</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032083"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Ztráta a/nebo fragmentace elastických vláken tunica media aorty, která vytváří stále více rozšířené translamelární prostory s chyběním elastických vláken a zvětšujícími se mezerami v lamelách elastických vláken, jak bylo zjištěno při barvení na elastická vlákna.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Loss and/or fragmentation of elastic fibers of the media of the aorta creating increasingly extended translamellar spaces, with absence of elastic fibers, and increased gaps in elastic fiber lamellae as identified on a stain for elastic fibers.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
