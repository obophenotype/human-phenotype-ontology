        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000643">
        <obo:IAO_0000115 xml:lang="cs">Fokální dystonie, která postihuje svaly očního víčka a obočí, spojené s mimovolní opakující se křečí obou víček</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Blefarospasmus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000643"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální dystonie, která postihuje svaly očního víčka a obočí, spojené s mimovolní opakující se křečí obou víček</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal dystonia that affects the muscles of the eyelids and brow, associated with involuntary recurrent spasm of both eyelids.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
