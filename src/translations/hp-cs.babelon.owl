    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030683">
        <obo:IAO_0000115 xml:lang="cs">Zánět pochvy, který může být důsledkem řady onemocnění, jež způsobují vaginální a někdy i vulvární příznaky, jako je svědění, pálení, podráždění, zápach a vaginální výtok.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vaginitida</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030683"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zánět pochvy, který může být důsledkem řady onemocnění, jež způsobují vaginální a někdy i vulvární příznaky, jako je svědění, pálení, podráždění, zápach a vaginální výtok.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Repeated symptomatic episodes of inflammation of the vagina that can result from a spectrum of conditions that cause vaginal and sometimes vulvar symptoms, such as itching, burning, irritation, odor, and vaginal discharge.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
