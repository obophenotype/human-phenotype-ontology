        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032098"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížení koncentrace manganu v krvi pod normální hodnotu</owl:annotatedTarget>
