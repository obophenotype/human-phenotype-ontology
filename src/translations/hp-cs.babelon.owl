    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100305">
        <obo:IAO_0000115 xml:lang="cs">Prstencová vlákna jsou tvořena svazkem periferních myofibril, které jsou orientovány do kruhu tak, že obklopují vnitřní část sarkoplazmy, která má normální strukturu a orientaci.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Prstenčitá vlákna</rdfs:label>
