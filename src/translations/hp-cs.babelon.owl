    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025312">
        <obo:IAO_0000115 xml:lang="cs">Forma strabismu s oběma očima otočenými dovnitř do relativně mírného stupně, obvykle definovaná jako méně než 10 prizmatických dioptrií.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Esoforie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025312"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Forma strabismu s oběma očima otočenými dovnitř do relativně mírného stupně, obvykle definovaná jako méně než 10 prizmatických dioptrií.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of strabismus with both eyes turned inward to a relatively mild degree, usually defined as less than 10 prism diopters.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
