    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032041">
        <obo:IAO_0000115 xml:lang="cs">Malý výrůstek na hlasivkách, který se může jevit jako stopkatý nebo přisedlý a má různou velikost, tvar a barvu.</obo:IAO_0000115>
