        <owl:annotatedTarget xml:lang="cs">Ztluštělé glomerulární bazální membrány bez elektrondenzních depozit</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Thickened glomerular basement membranes with no electron dense deposits</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033286">
