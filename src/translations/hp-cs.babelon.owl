        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031025">
        <obo:IAO_0000115 xml:lang="cs">Zhoubný novotvar žaludku, který roste submikózně ve stěně žaludku. Radiologicky může být patrná nekróza a krvácení. Histologicky mohou být patrné vřetenovité buňky s abnormální mitotickou aktivitou.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Leiomyosarkom žaludku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031025"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zhoubný novotvar žaludku, který roste submikózně ve stěně žaludku. Radiologicky může být patrná nekróza a krvácení. Histologicky mohou být patrné vřetenovité buňky s abnormální mitotickou aktivitou.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A malignant neoplasm of the stomach that grows submucosally in the gastric wall. Necrosis and hemorrhage may be visible radiologically. Histologically, spindle cells with abnormal mitotic activity may be visible.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031025"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Leiomyosarkom žaludku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Gastric leiomyosarcoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031026">
        <obo:IAO_0000115 xml:lang="cs">Sedací kost je kulatá a hypoplastická s velmi plochou acetabulární střechou a velmi neobvyklým mediálním výběžkem kosti, který údajně připomíná hlavu hlemýždě. Obrázek 4 v PMID:3799723 ilustruje tento stav.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kyčelní kosti ve tvaru hlemýždě</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031026"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Sedací kost je kulatá a hypoplastická s velmi plochou acetabulární střechou a velmi neobvyklým mediálním výběžkem kosti, který údajně připomíná hlavu hlemýždě. Obrázek 4 v PMID:3799723 ilustruje tento stav.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The ilia is round and hypoplastic with a very flat acetabular roof and a very unusual medial projection of bone that is said to resemble the head of a snail. Figure 4 of PMID:3799723 illustrates this feature.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031026"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kyčelní kosti ve tvaru hlemýždě</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Snail-like ilia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031027">
        <obo:IAO_0000115 xml:lang="cs">Malá prohlubeň ve tvaru písmena V na vnitřní straně hlavice stehenní kosti. Tento nález je dobře znázorněn na obrázku 5 v PMID:11694546</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vnitřní zářez na femorální hlavici</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031027"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Malá prohlubeň ve tvaru písmena V na vnitřní straně hlavice stehenní kosti. Tento nález je dobře znázorněn na obrázku 5 v PMID:11694546</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A small V-shaped indentation on the internal aspect of the femoral head. This feature is well illustrated in Figure 5 of PMID:11694546.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031027"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Vnitřní zářez na femorální hlavici</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Internal notch of the femoral head</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031028">
        <obo:IAO_0000115 xml:lang="cs">Vzorek séra s hrubě bílým (mléku podobným, tj. laktózním) vzhledem. Tento znak svědčí o extrémně zvýšené hladině triglyceridů v séru.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Laktescentní sérum</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031028"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vzorek séra s hrubě bílým (mléku podobným, tj. laktózním) vzhledem. Tento znak svědčí o extrémně zvýšené hladině triglyceridů v séru.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Serum sample with a grossly white (milk-like, i.e., lactescent) appearance. This feature is indicative of an extremely elevated serum triglyceride level.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031028"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Laktescentní sérum</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lactescent serum</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031029">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená koncentrace karcinoembryonálního antigenu (CEA) v krvi. CEA je členem rodiny imunoglobulinových supergenů. Rodina lidských genů CEA je seskupena na chromozomu 19q a zahrnuje 29 genů. CEA je vysoce exprimován v embryonální tkáni a u některých rakovin a je široce používaným nádorovým markerem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená hladina karcinoembryonálního antigenu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031029"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená koncentrace karcinoembryonálního antigenu (CEA) v krvi. CEA je členem rodiny imunoglobulinových supergenů. Rodina lidských genů CEA je seskupena na chromozomu 19q a zahrnuje 29 genů. CEA je vysoce exprimován v embryonální tkáni a u některých rakovin a je široce používaným nádorovým markerem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The concentration of CEA (carcinoembryonic antigen) in the blood circulation is above the upper limit of normal.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031029"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená hladina karcinoembryonálního antigenu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elevated circulating CEA concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031030">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená krevní koncentrace karcinomového antigenu 125 (CA-125). CA-125, také známý jako mucin 16, může vykazovat zvýšené hladiny v krvi u určitých typů rakoviny</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšení hladiny CA 125</rdfs:label>
    </rdf:Description>
