    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100767">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita placenty, orgánu, který spojuje vyvíjející se plod s děložní stěnou za účelem příjmu živin, odstraňování odpadních matabolitů a výměnu plynů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie placenty</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100767"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita placenty, orgánu, který spojuje vyvíjející se plod s děložní stěnou za účelem příjmu živin, odstraňování odpadních matabolitů a výměnu plynů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the placenta, the organ that connects the developing fetus to the uterine wall to enable nutrient uptake, waste elimination, and gas exchange.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
