    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012253">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli strukturální anomálie pseudostratifikovaného řasinkového epitelu, který vystýlá většinu částí dýchacích cest, včetně části nosní dutiny a hrtanu, průdušnice a průdušek.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie respiračního epitelu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012253"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoli strukturální anomálie pseudostratifikovaného řasinkového epitelu, který vystýlá většinu částí dýchacích cest, včetně části nosní dutiny a hrtanu, průdušnice a průdušek.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any structural anomaly of the pseudostratified ciliated epithelium that lines much of the conducting portion of the airway, including part of the nasal cavity and larynx, the trachea, and bronchi.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
