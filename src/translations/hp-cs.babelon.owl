        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Předčasný srůst radiálních epifyzárních plotének</owl:annotatedTarget>
