        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030951">
        <obo:IAO_0000115 xml:lang="cs">Nadměrná tvorba fibrózních pásů nebo zjizvené tkáně mezi svalovými vlákny</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fibróza kosterních svalů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030951"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nadměrná tvorba fibrózních pásů nebo zjizvené tkáně mezi svalovými vlákny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Excessive formation of fibrous bands of scar tissue in between muscle fibers.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
