        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030715">
        <obo:IAO_0000115 xml:lang="cs">Vývojová anomálie charakterizovaná fokální obliterací proximálního segmentu bronchu. Průdušky jsou distálně od místa stenózy zcela normální.</obo:IAO_0000115>
