    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031759">
        <obo:IAO_0000115 xml:lang="cs">Forma konvergentního strabismu (esotropie), při které je odchylka přítomna za všech podmínek (tj. na všechny vzdálenosti a za všech okolností).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Základní konstantní esotropie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031759"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Forma konvergentního strabismu (esotropie), při které je odchylka přítomna za všech podmínek (tj. na všechny vzdálenosti a za všech okolností).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of convergent strabismus (esotropia) in which the deviation is present under all conditions (ie at all distances and at all times).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031759"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Základní konstantní esotropie</owl:annotatedTarget>
