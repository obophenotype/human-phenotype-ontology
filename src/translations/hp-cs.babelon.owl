        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025165"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Shlukování elastických vláken v dermis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Clumping of elastic fibers in the dermis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025166">
        <obo:IAO_0000115 xml:lang="cs">Zvětšení průměru elastických vláken v dermis</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zesílená elastická vlákna v dermis</rdfs:label>
