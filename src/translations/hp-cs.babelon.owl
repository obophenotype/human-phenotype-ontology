        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000336">
        <obo:IAO_0000115 xml:lang="cs">Větší než průměrná protruze supraorbitálních částí frontální kosti směry ventrálně a/nebo laterálně</obo:IAO_0000115>
