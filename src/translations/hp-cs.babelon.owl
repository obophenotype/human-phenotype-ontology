        <owl:annotatedTarget xml:lang="cs">Směr vlny U opačný k vlně T (tj. pod základní linií) ve svodech se vzpřímenými vlnami T</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Direction of the U wave opposite to the T wave (i.e., below baseline) in leads with upright T waves.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025071"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Inverze vlny U</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>U wave inversion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025072">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená amplituda U vlny, definovaná jako amplituda větší než 1-2 mm nebo 25 % výšky T vlny</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Prominující U vlna</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025072"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená amplituda U vlny, definovaná jako amplituda větší než 1-2 mm nebo 25 % výšky T vlny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased amplitude of the U wave, defined as an amplitude greater than 1-2mm or 25 percent of the height of the T wave.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025072"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Prominující U vlna</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Prominent U wave</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025073">
        <obo:IAO_0000115 xml:lang="cs">Inverze vlny U, která je vyvolána zátěžovým testováním</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Námahou vyvolaná inverze vlny U</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025073"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Inverze vlny U, která je vyvolána zátěžovým testováním</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>U wave inversion that is induced by exercise stress testing.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025073"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Námahou vyvolaná inverze vlny U</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Exercise-induced U wave inversion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025074">
        <obo:IAO_0000115 xml:lang="cs">Anomálie komplexu tvořeného vlnami Q, R a S, které se na elektrokardiogramu vyskytují v rychlém sledu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální QRS komplex</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025074"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomálie komplexu tvořeného vlnami Q, R a S, které se na elektrokardiogramu vyskytují v rychlém sledu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly of the complex formed by the Q, R, and S waves, which occur in rapid succession on the electrocardiogram.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025074"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální QRS komplex</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal QRS complex</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025075">
        <obo:IAO_0000115 xml:lang="cs">Zvýšení amplitudy (výšky) komplexu QRS. Používá se několik kritérií, ale nejčastěji se používá Sokolovovo-Lyonovo kritérium (hloubka S vlny ve V1 + nejvyšší výška R vlny ve V5-V6 větší než 35 mm).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená voltáž QRS komplexu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025075"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšení amplitudy (výšky) komplexu QRS. Používá se několik kritérií, ale nejčastěji se používá Sokolovovo-Lyonovo kritérium (hloubka S vlny ve V1 + nejvyšší výška R vlny ve V5-V6 větší než 35 mm).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elevation of the voltage (height) of the QRS complex. There are several criteria in use, but the most common is the Sokolov-Lyon criterion (S wave depth in V1 + tallest R wave height in V5-V6 greater than 35 mm).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025075"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená voltáž QRS komplexu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased QRS voltage</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025076">
        <obo:IAO_0000115 xml:lang="cs">Abnormální amplituda QRS komplexu v elektrokardiogramu (EKG).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální voltáž QRS komplexu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025076"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální amplituda QRS komplexu v elektrokardiogramu (EKG).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal amplitude of the QRS complex of the electrocardiogram (EKG).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025076"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální voltáž QRS komplexu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal QRS voltage</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025077">
        <obo:IAO_0000115 xml:lang="cs">Snížená amplituda (výška) QRS komplexu v elektrokardiogramu (EKG), kdy amplitudy všech QRS komplexů v končetinových svodech jsou nižší než 5 mm, nebo amplitudy všech QRS komplexů v prekordiálních svodech jsou nižší než 10 mm.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená voltáž QRS komplexu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025077"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížená amplituda (výška) QRS komplexu v elektrokardiogramu (EKG), kdy amplitudy všech QRS komplexů v končetinových svodech jsou nižší než 5 mm, nebo amplitudy všech QRS komplexů v prekordiálních svodech jsou nižší než 10 mm.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced amplitude (height) of the QRS complex of the electrocardiogram (EKG), defined as amplitudes of all the QRS complexes in the limb leads are less than 5 mm or amplitudes of all the QRS complexes in the precordial leads less than 10 mm.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025077"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Snížená voltáž QRS komplexu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased QRS voltage</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025078">
        <obo:IAO_0000115 xml:lang="cs">Alternující výška QRS komplexů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Elektrický alternans</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025078"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Alternující výška QRS komplexů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The QRS complexes of the electrocardiogram alternate in height.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025078"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Elektrický alternans</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Electrical alternans</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025079">
        <obo:IAO_0000115 xml:lang="cs">Ohraničené ložisko hnisu nebo nekrotické tkáně v parenchymu slinivky břišní</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Absces pankreatu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025079"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Ohraničené ložisko hnisu nebo nekrotické tkáně v parenchymu slinivky břišní</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A circumscribed area of pus or necrotic debris in the parenchyma of the pancreas.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025079"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
