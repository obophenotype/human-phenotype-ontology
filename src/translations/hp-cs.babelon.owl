        <owl:annotatedTarget xml:lang="cs">Smutné ladění</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Unhappy demeanor</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031589">
        <obo:IAO_0000115 xml:lang="cs">Časté myšlení nebo připrava k sebevraždě</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Sebevražedné myšlenky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031589"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Časté myšlení nebo připrava k sebevraždě</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Frequent thoughts about or preoccupation with killing oneself.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031589"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Sebevražedné myšlenky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Suicidal ideation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031590">
        <obo:IAO_0000115 xml:lang="cs">Namáhání očí, tj. pocit únavy nebo nepohodlí v očích související s „nadměrným používáním“ očí při činnostech, jako je čtení nebo práce na počítači, a často je doprovázený slzením nebo bolestí hlavy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Astenopie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031590"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Namáhání očí, tj. pocit únavy nebo nepohodlí v očích související s „nadměrným používáním“ očí při činnostech, jako je čtení nebo práce na počítači, a často je doprovázený slzením nebo bolestí hlavy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Eye strain, i.e., a feeling of fatigue or discomfort of the eyes related to &apos;overuse&apos; of the eyes in activities such as reading or working at the computer and often accompanied by lacrimation or headache.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031590"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Astenopie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Asthenopia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031591">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně velká Eustachova chlopeň (postnatálně). Eustachova chlopeň je také známá jako chlopeň dolní duté žíly a je embryologickým zbytkem původní chlopně této žíly.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvětšená Eustachova chlopeň</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031591"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně velká Eustachova chlopeň (postnatálně). Eustachova chlopeň je také známá jako chlopeň dolní duté žíly a je embryologickým zbytkem původní chlopně této žíly.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormally large Eustachian valve (postnatally). The Eustachian valve is also known as the valve of the inferior vena cava, and is an embryologic remnant of the valve of the inferior vena cava.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031591"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvětšená Eustachova chlopeň</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Enlarged Eustachian valve</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031592">
        <obo:IAO_0000115 xml:lang="cs">Situs inversus hrudních a břišních vnitřností se srdcem normálně umístěným vlevo; obvykle spojené s vrozenými srdečními abnormalitami, jako je transpozice velkých cév a/nebo defekty sleziny včetně asplenie nebo polysplénie</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Situs inversus s levokardií</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031592"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Situs inversus hrudních a břišních vnitřností se srdcem normálně umístěným vlevo; obvykle spojené s vrozenými srdečními abnormalitami, jako je transpozice velkých cév a/nebo defekty sleziny včetně asplenie nebo polysplénie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Situs inversus of thoracic and abdominal viscera with the heart remaining normally situated on the left; usually associated with congenital cardiac abnormalities such as transposition of the great vessels and/or spleen defects including asplenia or polysplenia.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031592"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Situs inversus s levokardií</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Situs inversus with levocardia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031593">
        <obo:IAO_0000115 xml:lang="cs">Anomálie PR intervalu, což je část EKG od konce vlny P do začátku komplexu QRS. Normální interval PR u dospělých se pohybuje v rozmezí 0,12-0,2 sekundy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální úsek PR</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031593"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomálie PR intervalu, což je část EKG od konce vlny P do začátku komplexu QRS. Normální interval PR u dospělých se pohybuje v rozmezí 0,12-0,2 sekundy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly of the PR interval, which is the portion of the ECG from the onset of the P wave to the beginning of the QRS complex. A normal PR interval in adults is 0.12-0.2 seconds.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031593"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální úsek PR</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal PR interval</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031594">
        <obo:IAO_0000115 xml:lang="cs">Snížení voltáže úseku PR pod základní linii</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížení úseku PR</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031594"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížení voltáže úseku PR pod základní linii</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduction in voltage of the PR segment below baseline.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031594"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Snížení úseku PR</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>PR segment depression</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031595">
        <obo:IAO_0000115 xml:lang="cs">Jakákoliv anomálie vlny P, která je důsledkem depolarizace síní. Vlna P vzniká, když sinoatriální uzel vytvoří akční potenciál, který depolarizuje síně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální P vlna</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031595"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoliv anomálie vlny P, která je důsledkem depolarizace síní. Vlna P vzniká, když sinoatriální uzel vytvoří akční potenciál, který depolarizuje síně.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any anomaly of the P wave of the EKG, which results from atrial depolarization. The P wave occurs when the sinoatrial node creates an action potential that depolarizes the atria.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031595"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální P vlna</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal P wave</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031596">
        <obo:IAO_0000115 xml:lang="cs">Anomálie úseku PR, který začíná na konci vlny P a končí na začátku komplexu QRS. Úsek PR je normálně plochý a izoelektrický.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální úsek PR</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031596"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomálie úseku PR, který začíná na konci vlny P a končí na začátku komplexu QRS. Úsek PR je normálně plochý a izoelektrický.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly of the PR segment, which begins at the endpoint of the P wave and ends at the onset of the QRS complex. The PR segment is normally flat and isoelectric.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031596"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální úsek PR</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal PR segment</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031597">
        <obo:IAO_0000115 xml:lang="cs">Zvýšení napětí v segmentu PR pod základní hladinou</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Elevace PR segmentu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031597"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšení napětí v segmentu PR pod základní hladinou</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An increase in voltage of the PR segment above baseline.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031597"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Elevace PR segmentu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>PR segment elevation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031598">
        <obo:IAO_0000115 xml:lang="cs">Zářez ve tvaru V uprostřed vlny P</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vlna P se zářezem</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031598"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zářez ve tvaru V uprostřed vlny P</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>V-shaped cut (notch) in the middle of the P wave.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
