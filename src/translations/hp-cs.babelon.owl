        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ectopic fovea</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025008">
        <obo:IAO_0000115 xml:lang="cs">Pohyb průdušnice dolů během nádechu v důsledku trakce tracheobronchiálního stromu směrem dolů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Tracheální tah během inspirace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025008"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Pohyb průdušnice dolů během nádechu v důsledku trakce tracheobronchiálního stromu směrem dolů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Downward movement of the trachea during inspiration due to downward traction on the tracheobronchial tree.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
