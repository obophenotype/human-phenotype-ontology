        <babelon:source_value>Polycyclic</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031451">
        <obo:IAO_0000115 xml:lang="cs">Abnormální nárůst množství podkožního tuku na nohou</obo:IAO_0000115>
