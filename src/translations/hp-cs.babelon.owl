    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032157">
        <obo:IAO_0000115 xml:lang="cs">Opakované epizody genitálního herpesu, které jsou obvykle charakterizovány stadii erytému, papul, krátkodobých vezikul, bolestivých vředů a krust na kůži genitálií a v jejich okolí a které obvykle odezní během 2 až 3 týdnů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Recidivující genitální herpes</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032157"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Opakované epizody genitálního herpesu, které jsou obvykle charakterizovány stadii erytému, papul, krátkodobých vezikul, bolestivých vředů a krust na kůži genitálií a v jejich okolí a které obvykle odezní během 2 až 3 týdnů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Recurrent episodes of genital herpes, typically characterized by stages of erythema, papules, short-lived vesicles, painful ulcers, and crusts on the skin of the genitals and surrounding area, and that typically resolve over a period of 2 to 3 weeks.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
