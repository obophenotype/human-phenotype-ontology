    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000341">
        <obo:IAO_0000115 xml:lang="cs">Šířka čela, resp. vzdálenost mezi dvěma frontotemporale bodmi menší než - 2 SD (objektivně). Alternativně, očividně úzké čelo (subjektivně)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Úzké čelo</rdfs:label>
    </rdf:Description>
