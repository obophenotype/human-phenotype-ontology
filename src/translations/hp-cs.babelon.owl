        <babelon:source_value>Coffee ground vomitus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032145">
        <obo:IAO_0000115 xml:lang="cs">Atrofie n. suralis, smyslového nervu v oblasti lýtka nohy</obo:IAO_0000115>
