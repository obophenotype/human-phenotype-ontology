        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal tricuspid valve annulus morphology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031442">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli strukturální anomálie chordae tendinae trikuspidální chlopně. Chordae tendineae spojují papilární svaly s trikuspidální chlopní.</obo:IAO_0000115>
