        <obo:IAO_0000115 xml:lang="cs">Odchylka od normálu poměru pasu k bokům, definovaná jako měření pasu děleno měřením boků</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální poměr pasu a boků</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031818"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Odchylka od normálu poměru pasu k bokům, definovaná jako měření pasu děleno měřením boků</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deviation from normal of the waist to hip ratio, defined as the waist measurement divided by hip measurement.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
