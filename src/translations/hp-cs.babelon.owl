        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální emoční záchvat se strachem/panikou</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal emotional seizure with fear/anxiety/panic</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032740">
        <obo:IAO_0000115 xml:lang="cs">Fokální autonomní záchvat bez poruchy vědomí má počáteční projev týkající se funkce autonomního nervového systému. Tento projev může být objektivní (například rozšíření zornic) nebo subjektivní (například nevolnost). Vědomí je zachováno po celou dobu záchvatu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální autonomní záchvat bez poruchy vědomí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032740"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální autonomní záchvat bez poruchy vědomí má počáteční projev týkající se funkce autonomního nervového systému. Tento projev může být objektivní (například rozšíření zornic) nebo subjektivní (například nevolnost). Vědomí je zachováno po celou dobu záchvatu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal aware autonomic seizure has an initial manifestation pertaining to autonomic nervous system function, which may be objective (for example, pupillary dilation) or subjective (for example, nausea). As a type of focal aware seizure, awareness is retained throughout.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032740"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální autonomní záchvat bez poruchy vědomí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal aware autonomic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
