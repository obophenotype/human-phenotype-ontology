        <babelon:source_value>Acetabular spurs</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010455">
        <obo:IAO_0000115 xml:lang="cs">Zvýraznění normálního klenutého tvaru střechy acetabula tak, že nabývá strmého vzhledu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Strmá střecha acetabula</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010455"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýraznění normálního klenutého tvaru střechy acetabula tak, že nabývá strmého vzhledu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An exaggeration of the normal arched form of the acetabular roof such that it takes on a steep appearance.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
