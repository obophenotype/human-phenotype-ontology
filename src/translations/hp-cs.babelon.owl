        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033883">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli strukturální anomálie arteriae corticales radiatae, které odbočují v pravém úhlu od arteria arcuata a nesou krev směrem ke kůře ledviny</obo:IAO_0000115>
