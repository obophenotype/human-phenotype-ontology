        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Trojúhelníkovitá střední falanga 5. prstu na ruce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Triangular shaped middle phalanx of the 5th finger</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009183">
        <obo:IAO_0000115 xml:lang="cs">Chronická ztráta pohyblivosti pátého prstu v důsledku strukturálních změn v nekostních/měkkých tkáních. Termín kamptodaktylie 5. prstu se používá pokud jsou postiženy distální nebo proximální interfalangeální klouby</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kloubní kontraktura 5. prstu na ruce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009183"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Chronická ztráta pohyblivosti pátého prstu v důsledku strukturálních změn v nekostních/měkkých tkáních. Termín kamptodaktylie 5. prstu se používá pokud jsou postiženy distální nebo proximální interfalangeální klouby</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic loss of joint motion in the 5th finger due to structural changes in non-bony tissue. The term camptodactyly of the 5th finger is used if the distal and/or proximal interphalangeal joints are affected.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009183"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kloubní kontraktura 5. prstu na ruce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Joint contracture of the 5th finger</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009184">
        <obo:IAO_0000115 xml:lang="cs">Chronická ztráta pohyblivosti distálního interfalangeálního kloubu 5. prstu na ruce v důsledku strukturálních změn v měkkých/nekostních tkáních</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kontraktura distálního interfalangeálního kloubu 5. prstu na ruce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
