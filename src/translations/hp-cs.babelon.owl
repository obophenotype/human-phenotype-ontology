    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020208">
        <obo:IAO_0000115 xml:lang="cs">Záchvat vyvolaný očekáváním jídla, jedením nebo postprandiálním stavem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Jídlem vyvolaný záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020208"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Záchvat vyvolaný očekáváním jídla, jedením nebo postprandiálním stavem.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A seizure precipitated by aspects of anticipating food, eating itself, or the post-prandial period.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020208"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Jídlem vyvolaný záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Eating-induced seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020209">
        <obo:IAO_0000115 xml:lang="cs">Záchvat, který se dostaví, když se na hlavu v rychlém sledu vylijí nádoby velmi horké vody (40 až 50 stupňů Celsia). Koupání tímto způsobem je nejčastějším spouštěčem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Záchvat vyvolaný horkou vodou</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020209"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Záchvat, který se dostaví, když se na hlavu v rychlém sledu vylijí nádoby velmi horké vody (40 až 50 stupňů Celsia). Koupání tímto způsobem je nejčastějším spouštěčem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A seizure precipitated by pouring cupfuls of very hot water (40 to 50 degrees Celsius) in rapid succession over the head. Bathing in this manner is the most common trigger.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020209"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Záchvat vyvolaný horkou vodou</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hot water-induced seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020210">
        <obo:IAO_0000115 xml:lang="cs">Záchvat vyvolaný složitými, kognitivně řízenými úkoly, které často zahrnují vizuomotorickou koordinaci a rozhodování.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Cíleným pohybem vyvolaný záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020210"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Záchvat vyvolaný složitými, kognitivně řízenými úkoly, které často zahrnují vizuomotorickou koordinaci a rozhodování.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A seizure precipitated by complex, cognition-guided tasks often involving visuomotor coordination and decision-making.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020210"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Cíleným pohybem vyvolaný záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Praxis-induced seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020211">
        <obo:IAO_0000115 xml:lang="cs">Záchvat vyvolaný pohybem nebo změnou polohy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Propriocepcí vyvolaný záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020211"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Záchvat vyvolaný pohybem nebo změnou polohy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A seizure precipitated by movement or a change in posture.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020211"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Propriocepcí vyvolaný záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Proprioceptive-induced seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020212">
        <obo:IAO_0000115 xml:lang="cs">Záchvat vyvolaníý čtením</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Čtením vyvolaný záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020212"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Záchvat vyvolaníý čtením</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A seizure precipitated by reading.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020212"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Čtením vyvolaný záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reading-induced seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020213">
        <obo:IAO_0000115 xml:lang="cs">Somatosenzorický reflexní záchvat je záchvat vyvolaný somatickou stimulací určité části těla při absenci leknutí nebo překvapení.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Somatosenzorickými vjemy indukovaný záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020213"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Somatosenzorický reflexní záchvat je záchvat vyvolaný somatickou stimulací určité části těla při absenci leknutí nebo překvapení.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A somatosensory reflex seizure is a seizure precipitated by somatic stimulation of a specific part of the body in the absence of startle or surprise.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020213"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Somatosenzorickými vjemy indukovaný záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Somatosensory-induced seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020214">
        <obo:IAO_0000115 xml:lang="cs">Záchvaty vyvolané úlekem jsou vyvolány četnými a nespecifickými podněty (sluchovými, somatosenzorickými a zřídka zrakovými) a vyznačují se náhlou neočekávaností. Nejúčinnějším akustickým podnětem je spíše náhlý hluk než čistý zvuk.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Záchvat vyvolaný leknutím</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020214"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Záchvaty vyvolané úlekem jsou vyvolány četnými a nespecifickými podněty (sluchovými, somatosenzorickými a zřídka zrakovými) a vyznačují se náhlou neočekávaností. Nejúčinnějším akustickým podnětem je spíše náhlý hluk než čistý zvuk.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Startle-induced seizures are triggered by multiple and non-specific stimuli (auditory, somatosensory, and rarely visual) and are characterized by their sudden unexpected nature. Sudden noise rather than pure sound is the most effective acoustic stimulus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020214"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Záchvat vyvolaný leknutím</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Startle-induced seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020215">
        <obo:IAO_0000115 xml:lang="cs">Záchvat vyvolaný přemýšlením a/nebo rozhodováním</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Myšlením vyvolaný záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020215"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Záchvat vyvolaný přemýšlením a/nebo rozhodováním</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Seizures induced by thinking and decision-making.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020215"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Myšlením vyvolaný záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Thinking-induced seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020216">
        <obo:IAO_0000115 xml:lang="cs">Záchvaty vyvolané vizuálními podněty. Patří sem klinické záchvaty vyvolané stroboskopickým osvětlením, televizními a jinými obrazovkami, blikajícím osvětlením a samovyvoláním stroboskopického efektu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Záchvat vyvolaný vizuálními vjemy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020216"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Záchvaty vyvolané vizuálními podněty. Patří sem klinické záchvaty vyvolané stroboskopickým osvětlením, televizními a jinými obrazovkami, blikajícím osvětlením a samovyvoláním stroboskopického efektu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Seizures evoked by visual stimuli. This includes clinical seizures induced by strobe lighting, television and other screens, flickering environmental lighting and self-induction by causing a strobe effect.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020216"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Záchvat vyvolaný vizuálními vjemy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Visually-induced seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020217">
        <obo:IAO_0000115 xml:lang="cs">Fokální motorický záchvat, při kterém je vědomí zachováno po celou dobu záchvatu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální motorický záchvat bez poruchy vědomí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020217"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální motorický záchvat, při kterém je vědomí zachováno po celou dobu záchvatu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of focal motor seizure in which awareness is retained throughout the seizure.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020217"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální motorický záchvat bez poruchy vědomí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal aware motor seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020218">
        <obo:IAO_0000115 xml:lang="cs">Typ fokálního atonického záchvatu, během kterého je po celou dobu plně zachováno vědomí</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální atonický záchvat bez poruchy vědomí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020218"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fokálního atonického záchvatu, během kterého je po celou dobu plně zachováno vědomí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of focal atonic seizure during which awareness is fully retained throughout.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020218"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální atonický záchvat bez poruchy vědomí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal aware atonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020219">
        <obo:IAO_0000115 xml:lang="cs">Motorický záchvat je typ záchvatu, který je na počátku charakterizován postižením kosterního svalstva. Motorický projev může spočívat v zesílení (pozitivní) nebo zeslabení (negativní) svalové kontrakce, která vyvolá pohyb.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Motorický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020219"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Motorický záchvat je typ záchvatu, který je na počátku charakterizován postižením kosterního svalstva. Motorický projev může spočívat v zesílení (pozitivní) nebo zeslabení (negativní) svalové kontrakce, která vyvolá pohyb.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A motor seizure is a type of seizure that is characterized at onset by involvement of the skeletal musculature. The motor event could consist of an increase (positive) or decrease (negative) in muscle contraction to produce a movement.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020219"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Motorický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Motor seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020220">
        <obo:IAO_0000115 xml:lang="cs">Fokální záchvat charakterizovaný na počátku náhlou ztrátou nebo snížením svalového tonu bez zjevné předchozí myoklonické nebo tonické aktivity, trvající obvykle déle než 500 ms, ale méně než 2 sekundy. Může se týkat svalstva hlavy, trupu, čelistí nebo končetin.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální atonický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020220"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Fokální záchvat charakterizovaný na počátku náhlou ztrátou nebo snížením svalového tonu bez zjevné předchozí myoklonické nebo tonické aktivity, trvající obvykle déle než 500 ms, ale méně než 2 sekundy. Může se týkat svalstva hlavy, trupu, čelistí nebo končetin.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A focal seizure characterized at onset by sudden loss or diminution of muscle tone without apparent preceding myoclonic or tonic activity, typically lasting more than 500 ms but less than 2 seconds. It may involve the head, trunk, jaw or limb musculature.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020220"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální atonický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal atonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020221">
        <obo:IAO_0000115 xml:lang="cs">Klonický záchvat je typ motorického záchvatu charakterizovaného trvalými rytmickými záškuby, které se pravidelně opakují.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Klonický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020221"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Klonický záchvat je typ motorického záchvatu charakterizovaného trvalými rytmickými záškuby, které se pravidelně opakují.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A clonic seizure is a type of motor seizure characterized by sustained rhythmic jerking, that is regularly repetitive.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020221"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Klonický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Clonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020222">
