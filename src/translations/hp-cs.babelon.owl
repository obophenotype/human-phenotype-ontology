        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031357"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Histologicky výrazně odlišitelný, kožní, benigní vaskulární nádor, který se vyznačuje solitárními nebo mnohočetnými modročervenými papulami a histologicky připomíná ledvinné glomeruly</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A histologically distinctive, cutaneous, benign vascular tumor that is characterized by a solitary or multiple blue-red papules and histologically resembles renal glomeruli.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
