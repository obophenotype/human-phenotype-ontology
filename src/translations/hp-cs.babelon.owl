        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced response to gonadotropin-releasing hormone stimulation test</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020160">
        <obo:IAO_0000115 xml:lang="cs">Buněčná akumulace GM1 gangliosidu</obo:IAO_0000115>
