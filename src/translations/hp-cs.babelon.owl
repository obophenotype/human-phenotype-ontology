    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032388">
        <obo:IAO_0000115 xml:lang="cs">Uzlíky heterotopie podél stěn komor. Může se vyskytovat jeden uzlík nebo velký počet uzlíků, mohou se vyskytovat na obou stranách mozku nebo na obou stranách v kterémkoli místě podél okrajů vyšších komor, mohou být malé nebo velké, jednotlivé nebo mnohočetné.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Periventrikulární nodulární heterotopie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032388"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Uzlíky heterotopie podél stěn komor. Může se vyskytovat jeden uzlík nebo velký počet uzlíků, mohou se vyskytovat na obou stranách mozku nebo na obou stranách v kterémkoli místě podél okrajů vyšších komor, mohou být malé nebo velké, jednotlivé nebo mnohočetné.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nodules of heterotopia along the ventricular walls. There can be a single nodule or a large number of nodules, they can exist on either or both sides of the brain at any point along the higher ventricle margins, they can be small or large, single or multiple.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032388"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Periventrikulární nodulární heterotopie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Periventricular nodular heterotopia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032389">
        <obo:IAO_0000115 xml:lang="cs">Velká masa heterotopií v laminárním uspořádání podél stěn komor. Obvykle bilaterální</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Periventrikulární lamninární heterotopie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032389"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Velká masa heterotopií v laminárním uspořádání podél stěn komor. Obvykle bilaterální</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A large mass of heterotopia in a laminar configuration along the ventricular walls. Usually bilateral.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
