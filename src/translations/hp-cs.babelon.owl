    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031361">
        <obo:IAO_0000115 xml:lang="cs">Intralyzozomální, osmiofilní, lamelované a někdy koncentrické cytoplazmatické inkluze složené ze širokých příčně naskládaných myelinoidních membrán a na snímcích z elektronového mikroskopu připomínají zebru</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zebroviá tělíska</rdfs:label>
    </rdf:Description>
