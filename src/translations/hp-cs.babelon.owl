    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031948">
        <obo:IAO_0000115 xml:lang="cs">Centrálně umístěné hyperintenzity corpus callosum se při zobrazování magnetickou rezonancí podobají sněhovým koulím (se sekvencemi T2 nebo FLAIR). Centrální umístění v callosum je činí patognomickými pro Susacův syndrom.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Ložiska v corpus callosum připomínající sněhové koule</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031948"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Centrálně umístěné hyperintenzity corpus callosum se při zobrazování magnetickou rezonancí podobají sněhovým koulím (se sekvencemi T2 nebo FLAIR). Centrální umístění v callosum je činí patognomickými pro Susacův syndrom.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Centrally located corpus callosum hyperintensities said to resemble snowballs upon magnetic resonance imaging (with T2 or Sagittal fluid attenuated inversion recovery [FLAIR] sequences). The central location in the callosum makes them pathognomonic for Susac syndrome.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
