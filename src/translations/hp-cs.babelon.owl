    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000011">
        <obo:IAO_0000115 xml:lang="cs">Neschopnost úplně vyprázdnit močový měchýř během procesu močení kvůli neurologické příčině</obo:IAO_0000115>
