    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009715">
        <obo:IAO_0000115 xml:lang="cs">Cystadenom, epiteliální nádor, který vzniká v části nadvarlete.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Papilární cystadenom nadvarlete.</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009715"/>
