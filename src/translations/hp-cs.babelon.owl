        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fetal intraventricular hemorrhage with periventricular hemorrhage</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034220">
        <obo:IAO_0000115 xml:lang="cs">Rozšíření temporálních laloků mozku podél všech os, včetně rostrokaudálního, superoinferiorního a mediolaterálního směru, což má za následek globulární vzhled mozku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Megalencefalie temporálního laloku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034220"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Rozšíření temporálních laloků mozku podél všech os, včetně rostrokaudálního, superoinferiorního a mediolaterálního směru, což má za následek globulární vzhled mozku.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Expansion of the temporal lobes of the brain along all axes, including rostrocaudal, superoinferior, and mediolateral, resulting in a globular appearance of the brain.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034220"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Megalencefalie temporálního laloku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Temporal lobe megalencephaly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034221">
        <obo:IAO_0000115 xml:lang="cs">Abnormální strutura zóny (laloku) mozkové kůry, která se nachází níže než laterální štěrbina na ostatních mozkových hemisférách.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie temporálního laloku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034221"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální strutura zóny (laloku) mozkové kůry, která se nachází níže než laterální štěrbina na ostatních mozkových hemisférách.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal structural of the zone (lobe) of the cerebral cortex that is located inferior to the lateral fissure on other cerebral hemispheres.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034221"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální morfologie temporálního laloku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal temporal lobe morphology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034222">
        <obo:IAO_0000115 xml:lang="cs">Vývojová vada temporálního laloku mozkové kůry, která se vyznačuje výraznými sulkacemi a radiálně směřovanými gyracemi.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dyplázie temporálního laloku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034222"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vývojová vada temporálního laloku mozkové kůry, která se vyznačuje výraznými sulkacemi a radiálně směřovanými gyracemi.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A developmental defect of the temporal lobe of the cerebral cortex that is characterized by prominent sulcations and radially directed gyrations.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034222"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Dyplázie temporálního laloku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Temporal lobe dysplasia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034223">
        <obo:IAO_0000115 xml:lang="cs">Pulsatilita krevního toku lidskou pupeční tepnou (UA) měřená dopplerovským ultrazvukem je široce používaným biomarkerem pro detekci zvýšené vaskulární rezistence placenty. Zvýšená pulsatilita UA, která se v nejextrémnějších případech projevuje jako chybějící nebo dokonce obrácená enddiastolická rychlost, je spojena s intrauterinní růstovou restrikcí (IUGR) a mrtvě narozenými dětmi.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená pulzatilita pupečníkové tepny</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034223"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Pulsatilita krevního toku lidskou pupeční tepnou (UA) měřená dopplerovským ultrazvukem je široce používaným biomarkerem pro detekci zvýšené vaskulární rezistence placenty. Zvýšená pulsatilita UA, která se v nejextrémnějších případech projevuje jako chybějící nebo dokonce obrácená enddiastolická rychlost, je spojena s intrauterinní růstovou restrikcí (IUGR) a mrtvě narozenými dětmi.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Human umbilical artery (UA) blood flow pulsatility measured by Doppler ultrasound is a widely used biomarker for the detection of elevated placental vascular resistance. Elevated UA pulsatility, which in the most extreme cases manifests as absent or even reversed end-diastolic velocity, is associated with intrauterine growth restriction (IUGR) and still-birth.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034223"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená pulzatilita pupečníkové tepny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elevated umbilical artery pulsatility</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034224">
        <obo:IAO_0000115 xml:lang="cs">Anomálie, která je vizualizována dopplerovskou velocimetrií umbilikální tepny. Průtok v pupeční tepně by měl být za normálních okolností v dopředném směru. Tato anomálie je charakterizována absencí průtoku v pupeční tepně na konci diastoly</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Chybějící enddiastolický průtok pupečníkovou tepnou</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034224"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomálie, která je vizualizována dopplerovskou velocimetrií umbilikální tepny. Průtok v pupeční tepně by měl být za normálních okolností v dopředném směru. Tato anomálie je charakterizována absencí průtoku v pupeční tepně na konci diastoly</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly that is visualized by umbilical artery Doppler velocimetry. Flow in the umbilical artery should be in the forward direction in normal circumstances. This anomaly is characterized by an absence of flow in the umbilical artery at the end of diastole.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034224"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Chybějící enddiastolický průtok pupečníkovou tepnou</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absent end-diastolic umbilical artery flow</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034225">
        <obo:IAO_0000115 xml:lang="cs">Anomálie, která je vizualizována dopplerovskou velocimetrií umbilikální tepny. Průtok v pupeční tepně by měl být za normálních okolností v dopředném směru. Tato anomálie je charakterizována obrácením toku v umbilikální tepně na konci diastoly (tj. zpětný tok)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Reverzní enddiastolický průtok pupečníkovou tepnou</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034225"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomálie, která je vizualizována dopplerovskou velocimetrií umbilikální tepny. Průtok v pupeční tepně by měl být za normálních okolností v dopředném směru. Tato anomálie je charakterizována obrácením toku v umbilikální tepně na konci diastoly (tj. zpětný tok)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly that is visualized by umbilical artery Doppler velocimetry. Flow in the umbilical artery should be in the forward direction in normal circumstances. This anomaly is characterized by an reversal of flow in the umbilical artery at the end of diastole (i.e., backwards flow).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034225"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Reverzní enddiastolický průtok pupečníkovou tepnou</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reversed end-diastolic umbilical artery flow</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034226">
        <obo:IAO_0000115 xml:lang="cs">Charakteristický vzhled hrudníku a břicha v sagitálním pohledu na prenatálním ultrazvuku, pokud je hrudník malý a břicho přečnívající</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Znak tvaru zátky od šampaňského</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034226"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Charakteristický vzhled hrudníku a břicha v sagitálním pohledu na prenatálním ultrazvuku, pokud je hrudník malý a břicho přečnívající</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Characteristic appearance of the chest and abdomen in the sagittal view on prenatal ultrasound when the chest is small and the abdomen protruding.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
