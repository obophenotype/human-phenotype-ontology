    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031825">
        <obo:IAO_0000115 xml:lang="cs">Záraz (freezing) chůze je definována jako krátkodobá, epizodická absence nebo výrazné snížení pohybu nohou vpřed navzdory úmyslu chodit.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Záraz chůze</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031825"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Záraz (freezing) chůze je definována jako krátkodobá, epizodická absence nebo výrazné snížení pohybu nohou vpřed navzdory úmyslu chodit.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Freezing of gait is defined as a brief, episodic absence or marked reduction of forward progression of the feet despite the intention to walk.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031825"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Záraz chůze</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Freezing of gait</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031826">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli anomálie reflexu, tj. automatické reakce zprostředkované nervovým systémem (reflex nevyžaduje zásah vědomé myšlenky, aby se objevil)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální reflex</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031826"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoli anomálie reflexu, tj. automatické reakce zprostředkované nervovým systémem (reflex nevyžaduje zásah vědomé myšlenky, aby se objevil)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any anomaly of a reflex, i.e., of an automatic response mediated by the nervous system (a reflex does not need the intervention of conscious thought to occur).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031826"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální reflex</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal reflex</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031827">
        <obo:IAO_0000115 xml:lang="cs">Absence kontrakce břišních svalů v kvadrantu břicha, která je stimulována škrábáním kůže tečně k pupku nebo směrem k pupku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nevýbavný břišní reflex</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031827"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Absence kontrakce břišních svalů v kvadrantu břicha, která je stimulována škrábáním kůže tečně k pupku nebo směrem k pupku.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lack of contraction of abdominal muscles in the quadrant of the abdomen that is stimulated by scraping the skin tangential to or toward the umbilicus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031827"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nevýbavný břišní reflex</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absent abdominal reflex</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031828">
        <obo:IAO_0000115 xml:lang="cs">Anomálie reflexu, který je vyvolán jako motorická odpověď na škrábání kůže. Obecně se hodnotí jako přítomný nebo nepřítomný. Od šlachových reflexů se liší tím, že senzorický signál musí vystoupit do míchy, aby se dostal do mozku, a poté sestoupit do míchy, aby se dostal k motorickým neuronům.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální povrchový reflex</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031828"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomálie reflexu, který je vyvolán jako motorická odpověď na škrábání kůže. Obecně se hodnotí jako přítomný nebo nepřítomný. Od šlachových reflexů se liší tím, že senzorický signál musí vystoupit do míchy, aby se dostal do mozku, a poté sestoupit do míchy, aby se dostal k motorickým neuronům.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly of a reflex that is elicited as a motor response to scraping of the skin. They are generally graded as present or absent. They differ from tendon reflexes in that the sensory signal must ascend the spinal cord to reach the brain and then descend the spinal cord to reach the motor neurons.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031828"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální povrchový reflex</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal superficial reflex</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031829">
        <obo:IAO_0000115 xml:lang="cs">Chybějící reakce na škrábání na mediálního straně stehna, které u mužů normálně vyvolává prudkou, krátkou elevaci ipsilaterálního varlete, což je jev, který se označuje jako kremasterový reflex.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nepřítomnost kremasterického reflexu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031829"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Chybějící reakce na škrábání na mediálního straně stehna, které u mužů normálně vyvolává prudkou, krátkou elevaci ipsilaterálního varlete, což je jev, který se označuje jako kremasterový reflex.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lack of response to scratching of the skin of the medial thigh, which in males normally elicits a brisk, short elevation of the ipsilateral testis, a phenomenon that is referred to as the cremaster reflex.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031829"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nepřítomnost kremasterického reflexu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absent cremaster reflex</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031830">
        <obo:IAO_0000115 xml:lang="cs">Pinguecula je prominující hyperplastické ztluštění spojivky. Má obvykle trojúhelníkovitý tvar, žlutobělavou barvu a nachází se interpalpebrálně u limbu rohovky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pinguecula</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031830"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Pinguecula je prominující hyperplastické ztluštění spojivky. Má obvykle trojúhelníkovitý tvar, žlutobělavou barvu a nachází se interpalpebrálně u limbu rohovky.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A pinguecula is a yellowish to brown protruding lesion in the conjunctiva that is easily seen on the nasal and temporal sides of the cornea.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
