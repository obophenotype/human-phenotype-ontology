    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004749">
        <obo:IAO_0000115 xml:lang="cs">Typ síňové arytmie charakterizovaný frekvencí síní mezi 240 a 400 údery za minutu a určitým stupněm blokády vedení atrioventrikulárním uzlem. Komorová frekvence je obvykle poloviční oproti síňové frekvenci. Na EKG; flutter síní je pozorován jako pilovitá aktivita síní. Patofyziologicky je flutter síní formou síňového reentry, při kterém dochází k předčasnému elektrickému impulsu vytvářejícímu samopropagující se okruh.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Flutter síní</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004749"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ síňové arytmie charakterizovaný frekvencí síní mezi 240 a 400 údery za minutu a určitým stupněm blokády vedení atrioventrikulárním uzlem. Komorová frekvence je obvykle poloviční oproti síňové frekvenci. Na EKG; flutter síní je pozorován jako pilovitá aktivita síní. Patofyziologicky je flutter síní formou síňového reentry, při kterém dochází k předčasnému elektrickému impulsu vytvářejícímu samopropagující se okruh.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of atrial arrhythmia characterized by atrial rates of between 240 and 400 beats per minute and some degree of atrioventricular node conduction block. Typically, the ventricular rate is half the atrial rate. In the EKG; atrial flutter waves are observed as sawtooth-like atrial activity. Pathophysiologically, atrial flutter is a form of atrial reentry in which there is a premature electrical impulse creates a self-propagating circuit.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004749"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Flutter síní</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrial flutter</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004751">
        <obo:IAO_0000115 xml:lang="cs">Epizody komorové tachykardie s náhlým začátkem a koncem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Paroxyzmální komorová tachykardie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004751"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Epizody komorové tachykardie s náhlým začátkem a koncem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Episodes of ventricular tachycardia that have a sudden onset and ending.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
