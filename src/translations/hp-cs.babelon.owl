        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Únavová slabost žvýkacích svalů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fatigable weakness of chewing muscles</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030194">
        <obo:IAO_0000115 xml:lang="cs">Typ slabosti svalů zapojených do řeči, která se objevuje po zapojení svalové skupiny a zmírňuje se, pokud si svalová skupina odpočine. To znamená, že dochází ke snížení síly při opakovaných svalových úkonech.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Únavová slabost řečových svalů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
