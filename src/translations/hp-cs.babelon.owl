    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006585">
        <obo:IAO_0000115 xml:lang="cs">Dvě části klíční kosti (odpovídající dvěma primárním osifikačním centrům klíční kosti) jsou spojeny vazivovým můstkem, který navazuje na periost, a vzniká synoviální membrána, což vede k radiografickému zobrazení klíční kosti bipartitního vzhledu. Vrozená pseudoartróza klíční kosti se obecně projevuje jako nebolestivá hmota nebo otok nad klíční kostí</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vrozená preudoartróza klíční kosti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006585"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Dvě části klíční kosti (odpovídající dvěma primárním osifikačním centrům klíční kosti) jsou spojeny vazivovým můstkem, který navazuje na periost, a vzniká synoviální membrána, což vede k radiografickému zobrazení klíční kosti bipartitního vzhledu. Vrozená pseudoartróza klíční kosti se obecně projevuje jako nebolestivá hmota nebo otok nad klíční kostí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The two portions of the clavicle (corresponding to the two primary ossification centers of the clavicle) are connected by a fibrous bridge that is contiguous with the periosteum, and a synovial membrane develops, resulting in a clavicle with a bipartite appearance radiographically. Congenital pseudarthrosis of the clavicle generally presents as a painless mass or swelling over the clavicle.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006585"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Vrozená preudoartróza klíční kosti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Congenital pseudoarthrosis of the clavicle</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006587">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně rovný tvar klíční kosti, tubulární kosti, která je normálně dvakrát zakřivená</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Rovné klavikuly</rdfs:label>
