        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005177">
        <obo:IAO_0000115 xml:lang="cs">Arterioskleróza objevující se v mladším věku, než je obvyklé.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Předčasná arterioskleróza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005177"/>
