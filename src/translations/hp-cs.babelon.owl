        <owl:annotatedTarget xml:lang="cs">Hypertrichóza je zvýšený růst vlasů (či ochlupení), abnormální v množství nebo umístění</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypertrichosis is increased hair growth that is abnormal in quantity or location.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
