        <owl:annotatedTarget xml:lang="cs">Nepříjemný pocit charakterizovaný fyzickým diskomfortem (jako je píchání, pulzování nebo bolest) lokalizovaný do šlachy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to a tendon.</babelon:source_value>
