    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012209">
        <obo:IAO_0000115 xml:lang="cs">Juvenilní myelomonocytární leukémie (JMML) je letální myeloproliferativní onemocnění mladého dětského věku klinicky charakterizované nadprodukcí myelomonocytárních buněk a in vitro fenotypem hypersenzitivity hematopoetických progenitorů na kolonie stimulující faktor granulocytů a makrofágů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Juvenilní myeolomonocytární leukémie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012209"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Juvenilní myelomonocytární leukémie (JMML) je letální myeloproliferativní onemocnění mladého dětského věku klinicky charakterizované nadprodukcí myelomonocytárních buněk a in vitro fenotypem hypersenzitivity hematopoetických progenitorů na kolonie stimulující faktor granulocytů a makrofágů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Juvenile myelomonocytic leukemia (JMML) is a lethal myeloproliferative disease of young childhood characterized clinically by overproduction of myelomonocytic cells and by the in vitro phenotype of hematopoietic progenitor hypersensitivity to granulocyte-macrophage colony-stimulating factor.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012209"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Juvenilní myeolomonocytární leukémie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Juvenile myelomonocytic leukemia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
