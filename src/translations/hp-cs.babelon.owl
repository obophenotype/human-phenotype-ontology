        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Conjunctival papillae</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030947">
        <obo:IAO_0000115 xml:lang="cs">Malé, kupolovité uzlíky bez výrazné centrální cévy umístěné na spojivce. Lymfatické folikuly se nacházejí v subendoteliální oblasti spojivky. Skládají se ze zárodečného centra, které obsahuje nezralé, proliferující lymfocyty, a z kůry, která obsahuje zralé lymfocyty a plazmatické buňky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Konjunktivální folikuly</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030947"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Malé, kupolovité uzlíky bez výrazné centrální cévy umístěné na spojivce. Lymfatické folikuly se nacházejí v subendoteliální oblasti spojivky. Skládají se ze zárodečného centra, které obsahuje nezralé, proliferující lymfocyty, a z kůry, která obsahuje zralé lymfocyty a plazmatické buňky.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Small, dome-shaped nodules without a prominent central vessel located on the conjunctiva. The lymphoid follicles are located in the subendothelial region of the conjunctiva. They consist of a germinal center that contains immature, proliferating lymphocytes, as well as a corona that contains mature lymphocytes and plasma cells.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030947"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Konjunktivální folikuly</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Conjunctival follicles</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030948">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená aktivita enzymu gama-glutamyltransferázy (GGT). GGT je přítomna hlavně v ledvinách, játrech a buňkách pankreatu, ale malá množství jsou přítomna i v jiných tkáních</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená aktivita gama-glutaryltransferázy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030948"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená aktivita enzymu gama-glutamyltransferázy (GGT). GGT je přítomna hlavně v ledvinách, játrech a buňkách pankreatu, ale malá množství jsou přítomna i v jiných tkáních</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased level of the enzyme gamma-glutamyltransferase (GGT). GGT is mainly present in kidney, liver, and pancreatic cells, but small amounts are present in other tissues.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030948"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená aktivita gama-glutaryltransferázy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elevated gamma-glutamyltransferase level</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030949">
