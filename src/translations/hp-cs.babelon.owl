    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011864">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně zvýšená koncentrace difosfátu(4-) v krvi. Difosfát(4-) je ester se dvěma fosfátovými skupinami, také známý jako pyrofosfát</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšený plazmatický pyrofosfát</rdfs:label>
    </rdf:Description>
