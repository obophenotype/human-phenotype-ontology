    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032216">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně zvýšený počet intraepiteliálních lymfocytů. Tento nález může být hodnocen jako velký počet povrchových intraepiteliálních lymfocytů, jak je vidět (například) při barvení hematoxylinem a eosinem vzorku biopsie tlustého střeva odebraného při kolonoskopii.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Lymfocytární infiltrace sliznice tlustého střeva a konečníku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032216"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně zvýšený počet intraepiteliálních lymfocytů. Tento nález může být hodnocen jako velký počet povrchových intraepiteliálních lymfocytů, jak je vidět (například) při barvení hematoxylinem a eosinem vzorku biopsie tlustého střeva odebraného při kolonoskopii.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormally increased intraepithelial lymphocyte count. This finding may be appreciated as large numbers of surface intraepithelial lymphocytes as seen (for instance) with hematoxylin and eosin staining of a colonic biopsy sample taken during colonoscopy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032216"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Lymfocytární infiltrace sliznice tlustého střeva a konečníku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lymphocytic infiltration of the colorectal mucosa</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
