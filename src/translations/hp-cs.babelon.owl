        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030672">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost malých bílých sklivcových zákalů tvořených fosforečnanem vápenatým a komplexními vrstevnatými lipidovými usazeninami.</obo:IAO_0000115>
