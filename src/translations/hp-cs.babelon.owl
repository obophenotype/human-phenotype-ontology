    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033135">
        <obo:IAO_0000115 xml:lang="cs">Infarkt jater je definován jako oblast koagulační nekrózy způsobené odumřením jaterních buněk v důsledku lokální ischemie. Infarkty jater se na konvenční a dopplerovské sonografii jeví jako hypoechogenní nevaskulární oblasti.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Infarkt jater</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033135"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Infarkt jater je definován jako oblast koagulační nekrózy způsobené odumřením jaterních buněk v důsledku lokální ischemie. Infarkty jater se na konvenční a dopplerovské sonografii jeví jako hypoechogenní nevaskulární oblasti.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hepatic infarction is defined as areas of coagulative necrosis from hepatocyte cell death caused by local ischemia. Liver infarctions appear as hypoechoic nonvascular regions on conventional and Doppler sonography.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
