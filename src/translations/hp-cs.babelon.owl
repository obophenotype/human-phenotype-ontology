        <babelon:source_value>Deep venous thrombosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002626">
        <obo:IAO_0000115 xml:lang="cs">Podlouhlé a zkroucené mezenterické žíly, které zahrnují dolní mezenterickou žílu a horní mezenterickou žílu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Žilní varikozity celiakálních a mezenterických cév</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002626"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Podlouhlé a zkroucené mezenterické žíly, které zahrnují dolní mezenterickou žílu a horní mezenterickou žílu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elongated and tortuous mesenteric veins, which comprise the inferior mesenteric vein and the superior mesenteric vein.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
