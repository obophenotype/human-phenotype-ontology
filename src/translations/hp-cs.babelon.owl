    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004474">
        <obo:IAO_0000115 xml:lang="cs">Přední fontanela obvykle zanikne kolem osmnástého měsíce života. Přetrvávající přední fontanela znamená persistenci otevřené fontanely po tomto věku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Přetrvávající otevřená přední fontanela</rdfs:label>
