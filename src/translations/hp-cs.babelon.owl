        <obo:IAO_0000115 xml:lang="cs">Atrofie pánevního pletence (taktéž znémého jako cingulum pelvicum), t.j. gluteálních svalů, laterálních rotátorů, adduktorů, musculus psoas major a musculus iliacus</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Amyotrofie pánevního pletence</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0008946"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Atrofie pánevního pletence (taktéž znémého jako cingulum pelvicum), t.j. gluteálních svalů, laterálních rotátorů, adduktorů, musculus psoas major a musculus iliacus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrophy of the muscles of the pelvic girdle (also known as hip girdle), i.e., the gluteal muscles, the lateral rotators, the adductors, the psoas major and the iliacus muscle.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
