        <babelon:source_value>Spastic diplegia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001265">
        <obo:IAO_0000115 xml:lang="cs">Snížená výbavnost reflexů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hyporeflexie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001265"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížená výbavnost reflexů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduction of neurologic reflexes such as the knee-jerk reaction.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
