    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031475">
        <obo:IAO_0000115 xml:lang="cs">Kognitivní nebo behaviorální změna, která trvá nejméně 30 minut, s průkazem záchvatu na elektroencefalogramu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nekonvulzivní status epilepticus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031475"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kognitivní nebo behaviorální změna, která trvá nejméně 30 minut, s průkazem záchvatu na elektroencefalogramu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>There is inconclusive evidence to precisely define the duration of the seizure; however, based on current evidence an operational threshold of 10 minutes is appropriate as beyond this a seizure is likely to be more prolonged. The individual may or may not be aware or in coma.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031475"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nekonvulzivní status epilepticus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Status epilepticus without prominent motor symptoms</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
