    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032808">
        <obo:IAO_0000115 xml:lang="cs">Novorozenecký záchvat je typ záchvatu, který se vyskytuje v novorozeneckém období a je charakterizován elektrografický záznamem s náhlými, opakujícími se, vyvíjejícími se stereotypními vlnami se začátkem a koncem. Tato událost může ale nemusí být spojena s klinickým projevem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Novorozenecký záchvat s elektrografickým korelátem</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032808"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Novorozenecký záchvat je typ záchvatu, který se vyskytuje v novorozeneckém období a je charakterizován elektrografický záznamem s náhlými, opakujícími se, vyvíjejícími se stereotypními vlnami se začátkem a koncem. Tato událost může ale nemusí být spojena s klinickým projevem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal seizure is a seizure type that occurs in neonatal period and is characterized by an electrographic event with sudden, repetitive, evolving stereotyped waveforms with a beginning and an end. This event can be associated or not with a clinical manifestation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032808"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Novorozenecký záchvat s elektrografickým korelátem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal seizure with electrographic correlate</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032809">
        <obo:IAO_0000115 xml:lang="cs">Novorozenecký elektroklinický záchvat je elektrografická událost vyskytující se v novorozeneckém období a spojená s klinickým projevem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální eklektroklinický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032809"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Novorozenecký elektroklinický záchvat je elektrografická událost vyskytující se v novorozeneckém období a spojená s klinickým projevem.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical seizure is an electrographic event occurring in neonatal period and coupled with a clinical manifestation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032809"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální eklektroklinický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032810">
        <obo:IAO_0000115 xml:lang="cs">Záchvat charakterizovaný pocitem, jako je závrať nebo bolest hlavy, jako prvním klinickým projevem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální senzorický záchvat s pocitem cefaley</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032810"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Záchvat charakterizovaný pocitem, jako je závrať nebo bolest hlavy, jako prvním klinickým projevem.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A seizure characterized by a sensation in the head such as light-headedness or headache as its first clinical manifestation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032810"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální senzorický záchvat s pocitem cefaley</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal sensory seizure with cephalic sensation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032811">
        <obo:IAO_0000115 xml:lang="cs">Novorozenecký záchvat je typ záchvatu, který se vyskytuje v novorozeneckém období a je charakterizován elektrografický záznamem s náhlými, opakujícími se, vyvíjejícími se stereotypními vlnami se začátkem a koncem, který není asociovaný s klinickým projevem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální eklektrografický záchvat bez klinického korelátu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032811"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Novorozenecký záchvat je typ záchvatu, který se vyskytuje v novorozeneckém období a je charakterizován elektrografický záznamem s náhlými, opakujícími se, vyvíjejícími se stereotypními vlnami se začátkem a koncem, který není asociovaný s klinickým projevem.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electrographic only seizure is an electrographic event with sudden, repetitive, evolving stereotyped waveforms with a beginning and an end, which is not associated with a clinical manifestation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032811"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální eklektrografický záchvat bez klinického korelátu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electrographic only seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032812">
        <rdfs:label xml:lang="cs">Neonatální elektroklinický nemotorický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032812"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický nemotorický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical non-motor seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032813">
        <obo:IAO_0000115 xml:lang="cs">Neonatální elektroklinický motorický záchvat je typem novorozeneckého elektroklinického záchvatu s převládajícími motorickými projevy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální elektroklinický motorický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032813"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický motorický záchvat je typem novorozeneckého elektroklinického záchvatu s převládajícími motorickými projevy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical motor seizure is a type of neonatal electro-clinical seizure with predominant motor features.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032813"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický motorický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical motor seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032814">
        <obo:IAO_0000115 xml:lang="cs">Neonatální elektroklinický klonický záchvat je typem novorozeneckého elektroklinického motorického záchvatu, kde převládajícím motorickým projevem jsou pravidelně se opakující záškuby zahrnující stejné svalové skupiny; může být symetrický nebo asymetrický.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální elektroklinický klonický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032814"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický klonický záchvat je typem novorozeneckého elektroklinického motorického záchvatu, kde převládajícím motorickým projevem jsou pravidelně se opakující záškuby zahrnující stejné svalové skupiny; může být symetrický nebo asymetrický.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical clonic seizure is a type of neonatal electro-clinical motor seizure where the predominant motor feature is a regularly repeating jerking involving the same muscle groups; it can be symmetric or asymmetric.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032814"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický klonický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical clonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032815">
        <obo:IAO_0000115 xml:lang="cs">Neonatální elektroklinický myoklonický záchvat je typem novorozeneckého elektroklinického motorického záchvatu, kde převládajícím motorickým projevem je náhlá, krátká (&lt;&lt;100 ms) nedobrovolná jednorázová nebo vícenásobná kontrakce svalů nebo svalových skupin různé topografie (axiální, proximální končetina, distální)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální elektroklinický myoklonický záchvat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032815"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický myoklonický záchvat je typem novorozeneckého elektroklinického motorického záchvatu, kde převládajícím motorickým projevem je náhlá, krátká (&lt;&lt;100 ms) nedobrovolná jednorázová nebo vícenásobná kontrakce svalů nebo svalových skupin různé topografie (axiální, proximální končetina, distální)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical myoclonic seizure is a type of neonatal electro-clinical motor seizure where the predominant motor feature is sudden, brief (&lt;100 msec) involuntary single or multiple contraction of muscles or muscle groups of variable topography (axial, proximal limb, distal).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032815"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální elektroklinický myoklonický záchvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal electro-clinical myoclonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032816">
        <obo:IAO_0000115 xml:lang="cs">Neonatální multifokální myoklonický záchvat je typ novorozeneckého elektroklinického motorického záchvatu, kde převládajícím motorickým projevem je náhlá, krátká (&lt;&lt;100 ms) nedobrovolná jednorázová nebo vícenásobná kontrakce svalů nebo svalových skupin různé topografie (axiální, proximální končetina, distální) který se vyskytuje na více místech.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální multifokální myoklonický záchvat (Neonatální multifokální myoklonické křeče)</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032816"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální multifokální myoklonický záchvat je typ novorozeneckého elektroklinického motorického záchvatu, kde převládajícím motorickým projevem je náhlá, krátká (&lt;&lt;100 ms) nedobrovolná jednorázová nebo vícenásobná kontrakce svalů nebo svalových skupin různé topografie (axiální, proximální končetina, distální) který se vyskytuje na více místech.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal multifocal myoclonic seizure is a type of neonatal electro-clinical motor seizure where the predominant motor feature is sudden, brief (&lt;100 msec) involuntary single or multiple contraction of muscles or muscle groups of variable topography (axial, proximal limb, distal) that occurs at multiple sites.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032816"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální multifokální myoklonický záchvat (Neonatální multifokální myoklonické křeče)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal multifocal myoclonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032817">
        <obo:IAO_0000115 xml:lang="cs">Neonatální fokální myoklonický záchvat je typ novorozeneckého elektroklinického motorického záchvatu, kde převládajícím motorickým projevem je náhlá, krátká (&lt;100 ms) nedobrovolná jednorázová nebo vícenásobná kontrakce svalů nebo svalových skupin různé topografie (axiální, proximální končetina, distální) který se vyskytuje fokálně</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální fokální myoklonický záchvat (Neonatální fokální myoklonické křeče)</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032817"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální fokální myoklonický záchvat je typ novorozeneckého elektroklinického motorického záchvatu, kde převládajícím motorickým projevem je náhlá, krátká (&lt;100 ms) nedobrovolná jednorázová nebo vícenásobná kontrakce svalů nebo svalových skupin různé topografie (axiální, proximální končetina, distální) který se vyskytuje fokálně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal focal myoclonic seizure is a type of neonatal electro-clinical motor seizure where the predominant motor feature is sudden, brief (&lt;100 msec) involuntary single or multiple contraction of muscles or muscle groups of variable topography (axial, proximal limb, distal) which occurs focally.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032817"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální fokální myoklonický záchvat (Neonatální fokální myoklonické křeče)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal focal myoclonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032818">
        <obo:IAO_0000115 xml:lang="cs">Neonatální fokální klonický záchvat je typ novorozeneckého elektroklinického klonického záchvatu, kde převládajícím motorickým projevem jsou jednostranné pravidelně se opakující záškuby zahrnující stejné svalové skupiny.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální fokální klonický záchvat (Neonatální fokální klonické křeče)</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032818"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální fokální klonický záchvat je typ novorozeneckého elektroklinického klonického záchvatu, kde převládajícím motorickým projevem jsou jednostranné pravidelně se opakující záškuby zahrnující stejné svalové skupiny.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal focal clonic seizure is a type of neonatal electro-clinical clonic seizure where the predominant motor feature is unilateral regularly repeating jerking involving the same muscle groups.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032818"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální fokální klonický záchvat (Neonatální fokální klonické křeče)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal focal clonic seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032819">
        <obo:IAO_0000115 xml:lang="cs">Neonatální bilaterální klonický záchvat je typem novorozeneckého elektroklinického klonického záchvatu, kde jsou klonické záškuby bilaterální.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neonatální bilateránlí klonické záchvaty</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032819"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neonatální bilaterální klonický záchvat je typem novorozeneckého elektroklinického klonického záchvatu, kde jsou klonické záškuby bilaterální.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neonatal bilateral clonic seizure is a type of neonatal electro-clinical clonic seizure where the clonic jerking is bilateral.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
