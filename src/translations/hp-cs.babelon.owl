        <owl:annotatedTarget xml:lang="cs">Abnormálně nízká hladina kyslíku v krvi bez přítomnosti dušnosti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormally low blood oxygen level without the presence of dyspnea.</babelon:source_value>
