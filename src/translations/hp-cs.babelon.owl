    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000093">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená hladina bílkoviny v moči</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Proteinurie</rdfs:label>
