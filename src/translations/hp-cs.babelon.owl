        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Interalar distance more than 2 SD below the mean for age, or alternatively, an apparently decreased width of the nasal base and alae.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
