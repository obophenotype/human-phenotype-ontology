    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033186">
        <obo:IAO_0000115 xml:lang="cs">Tento termín se běžně používá k popisu domnělé abnormální polohy větví plicních žil přilehlých k plicním tepnám v rámci stejného adventiciálního pouzdra. Byly však předloženy důkazy, že příslušné cévy nejsou plicní žíly, ale představují rozšířené bronchiální žíly.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vychýlení pulmonálních žil</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033186"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Tento termín se běžně používá k popisu domnělé abnormální polohy větví plicních žil přilehlých k plicním tepnám v rámci stejného adventiciálního pouzdra. Byly však předloženy důkazy, že příslušné cévy nejsou plicní žíly, ale představují rozšířené bronchiální žíly.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The term is commonly used to describe a putative abnormal location of pulmonary vein branches adjacent to pulmonary arteries within the same adventitial sheath. However, evidence has been provided that the vessels in question are not pulmonary veins, however represent dilated bronchial veins.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033186"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Vychýlení pulmonálních žil</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Misalignment of the pulmonary veins</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
