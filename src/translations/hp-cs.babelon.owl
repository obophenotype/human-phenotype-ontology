    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009257">
        <obo:IAO_0000115 xml:lang="cs">Druhotné osifikační centrum v distálním falangu čtvrtého prstu na ruce, které je odlišné od běžné epifýzy a které nepřispívá k longitudinálnímu růstu dlouhé kosti</obo:IAO_0000115>
