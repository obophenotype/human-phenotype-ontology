        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal cellular phenotype</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025355">
        <obo:IAO_0000115 xml:lang="cs">Získaná fokální dilatace větví arterie centralis retinae, obvykle v arteriolách druhého řádu, velikostně od 100 do 200 mikrometrů v průměru. Makroaneurysmata jsou obvykle lokalizované v temporální části sítnice a mohou být hemoragické nebo exudativní.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Makroaneurysata retinální arterie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025355"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Získaná fokální dilatace větví arterie centralis retinae, obvykle v arteriolách druhého řádu, velikostně od 100 do 200 mikrometrů v průměru. Makroaneurysmata jsou obvykle lokalizované v temporální části sítnice a mohou být hemoragické nebo exudativní.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Acquired focal dilatations of branches of the retinal artery, usually second-order retinal arterioles, that range in size from 100 to 200 micrometers in diameter. Macroaneurysms are generally located at the temporal retina and may be hemorrhagic or exudative.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025355"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Makroaneurysata retinální arterie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinal arteriolar macroaneurysms</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025357">
        <obo:IAO_0000115 xml:lang="cs">Typ myoklonu při kterém se myoklonie eraticky, náhodně a asynchronně přemístňuje z jedné oblasti těla na jinou. Eratický myoklonus může postihnout obličej, končetiny, bývá krátký, jednorázový či repetitivní, velmi častý a téměř setrvalý.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Eratický myoklonus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025357"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ myoklonu při kterém se myoklonie eraticky, náhodně a asynchronně přemístňuje z jedné oblasti těla na jinou. Eratický myoklonus může postihnout obličej, končetiny, bývá krátký, jednorázový či repetitivní, velmi častý a téměř setrvalý.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of myoclonus in which the myoclonias shift from body region to another in a random and asynchronous fashion. Erratic myoclonus can affect the face or limbs, are brief, single or repetitive, very frequent and nearly continuous.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025357"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Eratický myoklonus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Erratic myoclonus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025358">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost pigmentového epitelu duhovky na přední ploše duhovky.</obo:IAO_0000115>
