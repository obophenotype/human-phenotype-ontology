        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031130">
        <obo:IAO_0000115 xml:lang="cs">Abnormální reakce na kalciový ionofor (jako například A23187), která se projevuje sníženou nebo chybějící agregací krevních destiček po přidání ionoforu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zhoršená agregace destiček vyvolaná kalciovým ionoforem</rdfs:label>
