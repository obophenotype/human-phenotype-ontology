        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000331"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zkrácená vertikální vzdálenost mezi hranicí červeně dolního rtu a dolním pólem brady</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased vertical distance from the vermilion border of the lower lip to the inferior-most point of the chin.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
