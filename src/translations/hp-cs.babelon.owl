    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001772">
        <obo:IAO_0000115 xml:lang="cs">Deformace nohy a kotníku, při níž je noha ohnutá dolů a ven.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Talipes equinovalgus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001772"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Deformace nohy a kotníku, při níž je noha ohnutá dolů a ven.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deformity of foot and ankle in which the foot is bent down and outwards.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
