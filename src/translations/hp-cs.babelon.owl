        <babelon:source_value>Pulmonary necrosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033244">
        <obo:IAO_0000115 xml:lang="cs">Akumulace nezralých intersticiálních buněk obsahujících hojný cytoplazmatický glykogen prokazatelný Schiffovými (PAS) pozitivními buňkami při barvení.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hromadění glykogenu v plicních intersticiálních buňkách</rdfs:label>
    </rdf:Description>
