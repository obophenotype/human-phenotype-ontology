    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012002">
        <obo:IAO_0000115 xml:lang="cs">Afektivní, mnemotechnické nebo složené percepční aury se subjektivními kvalitami podobnými těm, které zažíváme v životě, ale subjekt je rozpozná, že se vyskytují mimo skutečný kontext</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zážitkové aury</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Afektivní, mnemotechnické nebo složené percepční aury se subjektivními kvalitami podobnými těm, které zažíváme v životě, ale subjekt je rozpozná, že se vyskytují mimo skutečný kontext</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Affective, mnemonic or composite perceptual auras with subjective qualities similar to those experienced in life but are recognized by the subject as occurring outside of actual context.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
