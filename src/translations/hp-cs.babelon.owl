    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011408">
        <obo:IAO_0000115 xml:lang="cs">Intrauterinní růstová retartdace větší než 3 standardní odchylky (SD) pod průměrem, ale ne nižší než 4 SD korigovaná na pohlaví a gestační věk</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Středně závažná intrauterinní růstová retardace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011408"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Intrauterinní růstová retartdace větší než 3 standardní odchylky (SD) pod průměrem, ale ne nižší než 4 SD korigovaná na pohlaví a gestační věk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Intrauterine growth retardation that is at least 3 standard deviations (SD) below average, but not as low as 4 SD, corrected for sex and gestational age.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
