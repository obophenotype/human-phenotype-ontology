        <owl:annotatedTarget xml:lang="cs">Snížená aktivita svalové akonitázy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced muscle aconitase activity</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034512">
        <obo:IAO_0000115 xml:lang="cs">Rakovina močovodu, která nejčastěji vzniká v distální třetině močovodu a je často diagnostikována v šesté a sedmé dekádě života. Nejčastějším projevem je velká hematurie nebo bolest v boku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Přechodný karcinom močovodu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034512"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Rakovina močovodu, která nejčastěji vzniká v distální třetině močovodu a je často diagnostikována v šesté a sedmé dekádě života. Nejčastějším projevem je velká hematurie nebo bolest v boku.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cancer of the ureter that most often arises in the distal third of the ureter and is often diagnosed during the sixth and seventh decades of life. The most common presentation is gross hematuria or flank pain.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034512"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Přechodný karcinom močovodu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Transitional-cell carcinoma of the ureter</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034513">
