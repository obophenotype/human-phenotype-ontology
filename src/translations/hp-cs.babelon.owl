    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010864">
        <obo:IAO_0000115 xml:lang="cs">Težká intelektová nedostatečnost je definována jako inteligenční quocient (IQ) v rozmezí 20 - 34</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Intelektová nedostatečnost, těžká</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010864"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Težká intelektová nedostatečnost je definována jako inteligenční quocient (IQ) v rozmezí 20 - 34</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Severe intellectual disability (ID) is defined as a type of ID characterized by severely sub-average adaptive functioning and intellectual functioning, with an intelligence quotient (IQ) the range of 20-34.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
