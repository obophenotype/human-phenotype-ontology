        <owl:annotatedTarget xml:lang="cs">Prodloužený čas koagulace v testu s jedem Russelovy zmije</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased time to coagulation in the Russell&apos;s viper venom assay</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
