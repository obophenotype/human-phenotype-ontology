    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011092">
        <obo:IAO_0000115 xml:lang="cs">Moláry ve tvaru moruše vznikaji obvykle v důsledku syfilitického postižení. Postiženy jsou obvykle první moláry. Korunka zubu je hrubě deformována a připomíná povrch plodu moruše.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Molár ve tvaru moruše</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011092"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Moláry ve tvaru moruše vznikaji obvykle v důsledku syfilitického postižení. Postiženy jsou obvykle první moláry. Korunka zubu je hrubě deformována a připomíná povrch plodu moruše.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mulberry molars are irregular teeth generally affecting the first molars and are characterized by a grossly deformed crown imitating, as the name implies, the surface of a mulberry.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011092"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Molár ve tvaru moruše</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mulberry molar</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011093">
        <obo:IAO_0000115 xml:lang="cs">Zvětšená velikost a molároidní tvar premolárních zubů.</obo:IAO_0000115>
