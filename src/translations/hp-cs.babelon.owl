        <owl:annotatedTarget xml:lang="cs">Cysta duhovky se skládá z jediné buněčné vrstvy epitelu a je naplněna tekutinou.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An iris cyst is composed of a single cell layer of epithelium and is filled with fluid.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
