        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená hladina kyseliny N-acetylasparagové (NAA) v moči. Tuto vlastnost lze měřit pomocí plynové chromatografie s hmotnostní spektrometrií.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elevated N-acetylaspartic acid (NAA) in urine. This feature can be measured using gas chromatography-mass spectrometry</babelon:source_value>
