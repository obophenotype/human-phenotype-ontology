        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Skvamocelulární karcinom plic</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Squamous cell lung carcinoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030360">
        <obo:IAO_0000115 xml:lang="cs">Typ nemalobuněčného karcinomu plic, který je odvozen z nediferencovaných maligních novotvarů pocházejících z transformovaných epiteliálních buněk v plicích a který se odlišuje od malobuněčného karcinomu plic větší velikostí anaplastických buněk, vyššího poměru cytoplazmy k jádru a absenci vzhledu soli a pepře chromatinu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Velkobuněčný karcinom plic</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030360"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ nemalobuněčného karcinomu plic, který je odvozen z nediferencovaných maligních novotvarů pocházejících z transformovaných epiteliálních buněk v plicích a který se odlišuje od malobuněčného karcinomu plic větší velikostí anaplastických buněk, vyššího poměru cytoplazmy k jádru a absenci vzhledu soli a pepře chromatinu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of non-small cell lung carcinoma that is derived from undifferentiated malignant neoplasms originating from transformed epithelial cells in the lung, and which is differentiate from small-cell lung carcinoma by the larger size of the anaplastic cells, a higher cytoplasmic-to-nuclear size ratio, and a lack of salt-and-pepper appearance of the chromatin.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030360"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Velkobuněčný karcinom plic</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Large cell lung carcinoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030361">
        <obo:IAO_0000115 xml:lang="cs">Odchylka od normální koncentrace v krevním oběhu ikosanoidů (také známých jako eikosanoidy). Jsou to signální molekuly odvozené z oxidace 20-uhlíkových mastných kyselin. Většina se vyrábí z kyseliny arachidonové, 20-uhlíkové polynenasycené mastné kyseliny (5,8,11,14-eikosatetraenová kyselina)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální koncentrace eikosanoidů v oběhu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030361"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Odchylka od normální koncentrace v krevním oběhu ikosanoidů (také známých jako eikosanoidy). Jsou to signální molekuly odvozené z oxidace 20-uhlíkových mastných kyselin. Většina se vyrábí z kyseliny arachidonové, 20-uhlíkové polynenasycené mastné kyseliny (5,8,11,14-eikosatetraenová kyselina)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any deviation from the normal concentration of icosanoid in the blood circulation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030361"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální koncentrace eikosanoidů v oběhu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal circulating icosanoid concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
