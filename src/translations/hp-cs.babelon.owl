    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031045">
        <obo:IAO_0000115 xml:lang="cs">Bully (definované jako tekutinou naplněné puchýře větší než 5 mm s tenkými stěnami) na kůži s akrální distribucí (na periferii - ruce, nohy).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Akrální puchýře</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031045"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Bully (definované jako tekutinou naplněné puchýře větší než 5 mm s tenkými stěnami) na kůži s akrální distribucí (na periferii - ruce, nohy).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bullae (defined as fluid-filled blisters more than 5 mm in diameter with thin walls) of the skin with an acral distribution (affecting peripheral regions such as hands and feet).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
