    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000197">
        <obo:IAO_0000115 xml:lang="cs">Jakákoliv abnormalita příušní žlázy. Příušní žláza (glandula parotis) je slinná žláza lokalizovaná v subkutánní tkáni tváří nad ramus mandibulae před a pod zevním uchem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie glandula parotis (příušní žlázy)</rdfs:label>
    </rdf:Description>
