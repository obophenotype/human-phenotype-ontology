        <obo:IAO_0000115 xml:lang="cs">&quot;Srůst nebo fůze prstů na noze, zahrňující měkké části a také srůst jednotlivých kostí prstů. Kostený srůst odkazuje na &quot;&quot;kostěnou&quot;&quot; syndaktylii pokud srůst nastane v tibio-fibulární ose. V případě srůstu kostí prstů v proximo - distální ose se používá termín &quot;&quot;symfalangismus&quot;&quot;&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kostní syndaktylie prstů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010492"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">&quot;Srůst nebo fůze prstů na noze, zahrňující měkké části a také srůst jednotlivých kostí prstů. Kostený srůst odkazuje na &quot;&quot;kostěnou&quot;&quot; syndaktylii pokud srůst nastane v tibio-fibulární ose. V případě srůstu kostí prstů v proximo - distální ose se používá termín &quot;&quot;symfalangismus&quot;&quot;&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Webbing or fusion of the fingers, involving soft parts and including fusion of individual finger bones.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010492"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kostní syndaktylie prstů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Osseous finger syndactyly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
