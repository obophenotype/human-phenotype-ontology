        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030125">
        <obo:IAO_0000115 xml:lang="cs">Vrozená vada, kdy je processus transversus (příčný výběžek obratle) posledního lumbálního obratle (L5) srůstlý s křížovou kostí na jedné nebo obou stranách, nebo ke kosti kyčelní, nebo k oboum.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Sakralizace pátého lumbálního obratle</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030125"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vrozená vada, kdy je processus transversus (příčný výběžek obratle) posledního lumbálního obratle (L5) srůstlý s křížovou kostí na jedné nebo obou stranách, nebo ke kosti kyčelní, nebo k oboum.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A congenital anomaly, in which the transverse process of the last lumbar vertebra (L5) fuses to the sacrum on one side or both, or to ilium, or both.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
