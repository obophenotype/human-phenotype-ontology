        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033173">
        <obo:IAO_0000115 xml:lang="cs">Návrat broncholavážní tekutiny s mléčným vzhledem v důsledku akumulace směsi plicního surfaktantu, což je lipoproteinový komplex, v alveolárním prostoru.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mléčný vzhled bronchoalveolární tekutiny</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033173"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Návrat broncholavážní tekutiny s mléčným vzhledem v důsledku akumulace směsi plicního surfaktantu, což je lipoproteinový komplex, v alveolárním prostoru.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Return of lavage fluid with a milky appearance due to the accumulation of a mixture of pulmonary surfactant, which is a lipoprotein complex, in the alveolar space.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033173"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mléčný vzhled bronchoalveolární tekutiny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Milky appearance of bronchoalveolar lavage fluid</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033174">
        <obo:IAO_0000115 xml:lang="cs">Návrat broncholavážní tekutiny má u plicního alveolárního krvácení charakteristicky krvavý vzhled. To je způsobeno příměsí krve, která se obvykle zvyšuje s každým dalším výplachem. Mikroskopicky lze vidět erytrocyty. Po 24 až 48 hodinách obsahují makrofágy fagocytované erytrocyty, což naznačuje předchozí krvácení.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Krvavá tekutina z bronchoalveolární laváže</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033174"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Návrat broncholavážní tekutiny má u plicního alveolárního krvácení charakteristicky krvavý vzhled. To je způsobeno příměsí krve, která se obvykle zvyšuje s každým dalším výplachem. Mikroskopicky lze vidět erytrocyty. Po 24 až 48 hodinách obsahují makrofágy fagocytované erytrocyty, což naznačuje předchozí krvácení.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Return of lavage fluid characteristically has a bloody appearance in pulmonary alveolar hemorrhage. This is due to admixture of blood, which typically increases with each consecutive lavage portion. Microscopically erythrocytes can be seen. After 24 to 48 h macrophages contain phagocytosed erythrocytes, indicating previous bleeding.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033174"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Krvavá tekutina z bronchoalveolární laváže</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bloody bronchoalveolar lavage fluid</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033175">
        <obo:IAO_0000115 xml:lang="cs">Koncentrace kyseliny L-pyroglutamové v krvi je vyšší než normální rozmezí.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená koncentrace cirkulujícího 5-oxoprolinu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033175"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Koncentrace kyseliny L-pyroglutamové v krvi je vyšší než normální rozmezí.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Concentration of L-pyroglutamic acid in the blood is above the upper limit of normal.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
