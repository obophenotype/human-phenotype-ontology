    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033540">
        <obo:IAO_0000115 xml:lang="cs">Obstrukce průtoku vzduchu s významnou odpovědí na bronchodilatancia definovanou jako zvýšení FEV1 a/nebo FVC o 12 % nebo více a nejméně o 200 ml.</obo:IAO_0000115>
