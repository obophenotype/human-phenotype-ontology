        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Vegetativní stav</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Vegetative state</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031359">
        <obo:IAO_0000115 xml:lang="cs">Solidný, vyvýšená, plochá léze větši než 1 cm v průměru charakterizovaná ztlustěním (sklerózou) dané oblasti kůže kvůli změnám v kolagenu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kožní sklerotické plaky</rdfs:label>
    </rdf:Description>
