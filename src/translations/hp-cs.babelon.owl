        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032028">
        <obo:IAO_0000115 xml:lang="cs">Žluté, bílé nebo šedavé léze v makule, které jsou dobře ohraničené/výrazné, jednotlivé a většinou stejné velikosti.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Makulární tečky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032028"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Žluté, bílé nebo šedavé léze v makule, které jsou dobře ohraničené/výrazné, jednotlivé a většinou stejné velikosti.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Yellow, white or grayish lesions in the macula that are well-defined/distinct, individual and mostly uniform in size.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
