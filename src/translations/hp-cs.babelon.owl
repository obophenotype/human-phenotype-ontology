        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Finger flexor weakness</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031178">
        <obo:IAO_0000115 xml:lang="cs">Hlava je permanentně ohnuta dorzálně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fixovaná retroflexe hlavy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031178"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Hlava je permanentně ohnuta dorzálně.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Head is bent in the posterior direction in a permanent fashion.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
