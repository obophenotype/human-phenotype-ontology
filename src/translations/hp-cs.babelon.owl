    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030445">
        <obo:IAO_0000115 xml:lang="cs">Zhoubný neuroendokrinní nádor plic. Podle histopatologických kritérií (WHO 2004) jsou karcinoidy rozděleny do čtyř skupin, tj. typické a atypické karcinoidy, velkobuněčný neuroendokrinní karcinom a malobuněčný karcinom plic.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Plicní karcinoid</rdfs:label>
    </rdf:Description>
