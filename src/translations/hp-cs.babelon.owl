    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000824">
        <obo:IAO_0000115 xml:lang="cs">Nedostatečné odpovědi na provokační testy s růstovým hormonem (GH). Deficit GH je definován jako vrcholová koncentrace GH v séru nižší než 10 ng/ml při provokaci kombinací alespoň dvou samostatných stimulačních testů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená odpověď na stimulační test růstovým hormonem</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000824"/>
