        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hemiparesis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001270">
        <obo:IAO_0000115 xml:lang="cs">Typ vývojové poruchy charakterizované prodlevou při získávání motorických dovedností</obo:IAO_0000115>
