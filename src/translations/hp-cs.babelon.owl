        <owl:annotatedTarget xml:lang="cs">Abnormální morfologie nucleus ruber</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal red nucleus morphology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
