        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012043">
        <obo:IAO_0000115 xml:lang="cs">Rytmické, mimovolní sinusové oscilace jednoho nebo obou očí. Vlnový průběh pendulárního nystagmu se může vyskytovat v jakémkoli směru.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pendulární nystagmus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012043"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Rytmické, mimovolní sinusové oscilace jednoho nebo obou očí. Vlnový průběh pendulárního nystagmu se může vyskytovat v jakémkoli směru.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Rhythmic, involuntary sinusoidal oscillations of one or both eyes. The waveform of pendular nystagmus may occur in any direction.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
