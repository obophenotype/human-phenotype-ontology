    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000481">
        <obo:IAO_0000115 xml:lang="cs">Jakákoliv abnormalita rohovky, rohovka je průhledná, konvexní, ventrálně lokalizovaná část bulbu, která kryje duhovku, čočku a přední komoru</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie rohovky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000481"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoliv abnormalita rohovky, rohovka je průhledná, konvexní, ventrálně lokalizovaná část bulbu, která kryje duhovku, čočku a přední komoru</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any abnormality of the cornea, which is the transparent tissue at the front of the eye that covers the iris, pupil, and anterior chamber.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
