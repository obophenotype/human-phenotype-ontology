    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032086">
        <obo:IAO_0000115 xml:lang="cs">Oblast aorty, ve které nejsou ve více lamelách při barvení hematoxylinem a eozinem jasně identifikovatelná jádra hladkých svalových buněk.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Ztráta jader hladkých svalových buněk aorty</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032086"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Oblast aorty, ve které nejsou ve více lamelách při barvení hematoxylinem a eozinem jasně identifikovatelná jádra hladkých svalových buněk.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A region of the aortic media in which smooth muscle cell nuclei, involving multiple lamellae, are not clearly identifiable on an hematoxylin and eosin stain.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
