    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001212">
        <obo:IAO_0000115 xml:lang="cs">&quot;Všeobecně známé jako &quot;&quot;fetal finger pads&quot;&quot;, výraz značí perzistenci fetálních ventrálně prominujících polštářků na konečcích prstů. Užívání tohoto výrazu je však ne zcela správné, protože implikuje znalost anamnézy pacient, která často neexistuje (perzistují polštářky od fetálního období?)&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Prominentní polštářky konečků prstů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001212"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">&quot;Všeobecně známé jako &quot;&quot;fetal finger pads&quot;&quot;, výraz značí perzistenci fetálních ventrálně prominujících polštářků na konečcích prstů. Užívání tohoto výrazu je však ne zcela správné, protože implikuje znalost anamnézy pacient, která často neexistuje (perzistují polštářky od fetálního období?)&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>&quot;A soft tissue prominence of the ventral aspects of the fingertips. The term &quot;&quot;persistent fetal fingertip pads&quot;&quot; is often used as a synonym, but should better not be used because it implies knowledge of history of the patient which often does not exist.&quot;</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001212"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Prominentní polštářky konečků prstů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Prominent fingertip pads</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001215">
        <obo:IAO_0000115 xml:lang="cs">Distální interfalangeální kloub a/nebo proximální interfalangeální kloub druhého až pátého prstu nemohou být extendovány na 180 stupňů ani aktivní ani pasivní extenzí</obo:IAO_0000115>
