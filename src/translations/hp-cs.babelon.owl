    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030740">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost akcesorního svazku svaloviny v pravé komoře, který obstruuje výtokovou část komory.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální svalový svazek v pravé komoře</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030740"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost akcesorního svazku svaloviny v pravé komoře, který obstruuje výtokovou část komory.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An accessory (not normally present) muscle bundle in the right ventricle which obstructs the right ventricular outflow tract.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
