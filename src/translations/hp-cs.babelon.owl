    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011091">
        <obo:IAO_0000115 xml:lang="cs">Vývoj dvou zubů ze společného zárodku, vedoucí k většímu, fuzovanému zubu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Germinace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011091"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vývoj dvou zubů ze společného zárodku, vedoucí k většímu, fuzovanému zubu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The development of two teeth from a single tooth bud, leading to a larger fused tooth.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
