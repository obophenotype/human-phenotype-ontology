    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034380">
        <obo:IAO_0000115 xml:lang="cs">Juvenilní typ nádoru z granulózních buněk varlat novorozenců a kojenců je vzácná léze často spojená s abnormálním pohlavním chromozomem a nejednoznačným genitálem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Juvenilní typ nádoru z granulózních buněk varlat</rdfs:label>
