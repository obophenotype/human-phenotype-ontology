    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030794">
        <obo:IAO_0000115 xml:lang="cs">Anomální cirkulující koncentrace spojovacího peptidu (C), který spojuje řetězce A a B v proinzulinu, a tím poskytuje prostředek pro podporu jejich účinného skládání a sestavování v endoplazmatickém retikulu během biosyntézy inzulinu. Po rozštěpení proinzulinu je C-peptid uložen spolu s inzulinem v rozpustné fázi sekrečních granulí a následně se uvolňuje v ekvimolárním množství s inzulinem, což poskytuje užitečný nezávislý ukazatel sekrece inzulinu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální koncetrance cirkulujícího C-peptidu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030794"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomální cirkulující koncentrace spojovacího peptidu (C), který spojuje řetězce A a B v proinzulinu, a tím poskytuje prostředek pro podporu jejich účinného skládání a sestavování v endoplazmatickém retikulu během biosyntézy inzulinu. Po rozštěpení proinzulinu je C-peptid uložen spolu s inzulinem v rozpustné fázi sekrečních granulí a následně se uvolňuje v ekvimolárním množství s inzulinem, což poskytuje užitečný nezávislý ukazatel sekrece inzulinu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any deviation from the normal concentration of C-peptide in the blood circulation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030794"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální koncetrance cirkulujícího C-peptidu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal circulating C-peptide concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030795">
        <obo:IAO_0000115 xml:lang="cs">Snížená koncentrace C-peptidu v cirkulaci. Vzhledem k tomu, že C-peptid je vylučován v ekvimolárním množství s inzulinem, koreluje tato vlastnost se sníženou sekrecí inzulinu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená hladina C-peptidu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030795"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížená koncentrace C-peptidu v cirkulaci. Vzhledem k tomu, že C-peptid je vylučován v ekvimolárním množství s inzulinem, koreluje tato vlastnost se sníženou sekrecí inzulinu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The concentration of C-peptide in the blood circulation is below the lower limit of normal.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030795"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Snížená hladina C-peptidu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased circulating C-peptide concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030796">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená koncentrace C-peptidu v cirkulaci. Vzhledem k tomu, že C-peptid je vylučován v ekvimolárním množství s inzulinem, koreluje tato vlastnost se zvýšenou sekrecí inzulinu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená hladina C-peptidu</rdfs:label>
