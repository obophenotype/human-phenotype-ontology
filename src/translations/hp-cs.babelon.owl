        <owl:annotatedTarget xml:lang="cs">Chybějí dystrofin ve svalové tkáni. Imunohistochemie prokazuje chybějící protein dyystrofin ve svalové biopsii.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
