        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003184">
        <obo:IAO_0000115 xml:lang="cs">Snížená schopnost pohybu femuru směrem ven do strany</obo:IAO_0000115>
