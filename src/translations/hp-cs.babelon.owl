        <owl:annotatedTarget xml:lang="cs">Anomální množství proteinu přítomného ve svalových vláknech nebo na jejich povrchu. Tato vlastnost může být zachycena při imunohistochemickém vyšetření tkáně ze svalové biopsie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
