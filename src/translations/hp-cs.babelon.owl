    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003183">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně zvětšená šířka pubické symfýzy, což je chrupavčité spojení spojující ramus superior pravé a levé pubické/stydké kosti v střední čáře</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Široká pubická symfýza</rdfs:label>
    </rdf:Description>
