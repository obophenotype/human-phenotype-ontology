    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034247">
        <obo:IAO_0000115 xml:lang="cs">Obstrukce v močovodu vedoucí k obstrukci vývodu močového měchýře. Zvláštní kritéria se používají pro obstrukci dolních močových cest (LUTO) u plodu. Prenatálně bylo LUTO klasicky podezřívané na základě tří ultrasonografických nálezů: megacystis, dilatovaná zadní uretra (známá jako znak klíčové dírky) a hydronefróza</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Obstrukce dolních močových cest plodu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034247"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Obstrukce v močovodu vedoucí k obstrukci vývodu močového měchýře. Zvláštní kritéria se používají pro obstrukci dolních močových cest (LUTO) u plodu. Prenatálně bylo LUTO klasicky podezřívané na základě tří ultrasonografických nálezů: megacystis, dilatovaná zadní uretra (známá jako znak klíčové dírky) a hydronefróza</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An obstruction in the ureter leading to bladder outlet obstruction. Special criteria are used for lower urinary tract obstruction (LUTO) in the fetus. Prenatal LUTO has classically been suspected on the basis of three ultrasonographic findings: megacystis, dilated posterior urethra (known as the keyhole sign) and hydronephrosis.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034247"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Obstrukce dolních močových cest plodu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fetal lower urinary tract obstruction</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034248">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená echogenita (výšší jas na sonografickém snímku ve stupních šedi) čočky plodu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená echogenita fetální čočky</rdfs:label>
    </rdf:Description>
