        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033848">
        <obo:IAO_0000115 xml:lang="cs">Typ afázie, který se vyznačuje poruchou porozumění řeči.</obo:IAO_0000115>
