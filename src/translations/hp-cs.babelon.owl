        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011867">
        <obo:IAO_0000115 xml:lang="cs">Anomálie křídel kosti kyčelní. Jedná se o velkou rozšířenou část kosti kyčelní (os illium), která laterálně ohraničuje velkou pánev.</obo:IAO_0000115>
