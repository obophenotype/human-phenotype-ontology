        <babelon:source_value>Corneal astigmatism</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025613">
        <obo:IAO_0000115 xml:lang="cs">Typ záchvatu s fokálním nástupem charakterizovaný změnami nálady nebo emocí nebo výskytem změněných emocí bez subjektivních emocí při začátku záchvatu. Tyto emoční záchvaty se mohou objevit s objektivními klinickými příznaky záchvatu, které jsou pozorovateli zřejmé, nebo bez nich.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální emoční křeče</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025613"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ záchvatu s fokálním nástupem charakterizovaný změnami nálady nebo emocí nebo výskytem změněných emocí bez subjektivních emocí při začátku záchvatu. Tyto emoční záchvaty se mohou objevit s objektivními klinickými příznaky záchvatu, které jsou pozorovateli zřejmé, nebo bez nich.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Seizures presenting with an emotion or the appearance of having an emotion as an early prominent feature, such as fear, spontaneous joy or euphoria, laughing (gelastic), or crying, (dacrystic). These emotional seizures may occur with or without objective clinical signs of a seizure evident to the observer.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025613"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální emoční křeče</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal emotional seizure</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025615">
        <rdfs:label xml:lang="cs">Absces</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025615"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Absces</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abscess</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025616">
        <obo:IAO_0000115 xml:lang="cs">Absces, který není způsoben infekcí pyogenními bakteriemi. Z praktického hlediska se na sterilní absces usuzuje, pokud vyšetření abscesu neprokáže přítomnost patogenních organismů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Sterilní absces</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025616"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Absces, který není způsoben infekcí pyogenními bakteriemi. Z praktického hlediska se na sterilní absces usuzuje, pokud vyšetření abscesu neprokáže přítomnost patogenních organismů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abscess not caused by infection with pyogenic bacteria. Operationally, a sterile abscess is inferred if investigations of an abscess fail to reveal evidence of pathogenic organisms.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025616"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Sterilní absces</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sterile abscess</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025617">
        <obo:IAO_0000115 xml:lang="cs">Abnormální počet plazmatických buněk v krevním oběhu. Plazmatické buňky jsou efektorové buňky určené k produkci vysokého množství protilátek.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální počet plazmatických buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025617"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální počet plazmatických buněk v krevním oběhu. Plazmatické buňky jsou efektorové buňky určené k produkci vysokého množství protilátek.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal number of plasma cells in the blood circulation. Plasma cells are terminally differentiated B cells dedicated to the production of a high amount of antibodies.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025617"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální počet plazmatických buněk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal total plasma cell count</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025618">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně snížený počet plazmatických buněk v krevním oběhu. Plazmatické buňky jsou efektorové buňky určené k produkci vysokého množství protilátek.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížený počet plazmatických buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025618"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně snížený počet plazmatických buněk v krevním oběhu. Plazmatické buňky jsou efektorové buňky určené k produkci vysokého množství protilátek.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormally low number of plasma cells in the blood circulation. Plasma cells are the the effector cells dedicated to the production of a high amount of antibodies.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025618"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Snížený počet plazmatických buněk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced plasma cell count</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025619">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně zvýšený počet plazmatických buněk v krevním oběhu. Plazmatické buňky jsou efektorové buňky určené k produkci vysokého množství protilátek.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšený počet plazmatických buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025619"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně zvýšený počet plazmatických buněk v krevním oběhu. Plazmatické buňky jsou efektorové buňky určené k produkci vysokého množství protilátek.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormally high number of plasma cells in the blood circulation. Plasma cells are the the effector cells dedicated to the production of a high amount of antibodies.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025619"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšený počet plazmatických buněk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elevated plasma cell count</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025620">
        <obo:IAO_0000115 xml:lang="cs">Abnormální poměr centrálních paměťových CD4+ T buněk. Tyto paměťové buňky jsou lokalizované v sekundárních lymfatických orgánech. Můžou mít CD3/CD4/CD62L+/CD45RA- fenotyp.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální podíl CD4-pozitivních centrálních paměťových T buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025620"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální poměr centrálních paměťových CD4+ T buněk. Tyto paměťové buňky jsou lokalizované v sekundárních lymfatických orgánech. Můžou mít CD3/CD4/CD62L+/CD45RA- fenotyp.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal proportion of central memory CD4+ T cells. These are memory cells that are located in the secondary lymphoid organs. These cells may have a CD3/CD4/CD62L+/CD45RA- phenotype</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025620"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální podíl CD4-pozitivních centrálních paměťových T buněk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>obsolete Abnormal CD4+ central memory T cell proportion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025623">
        <obo:IAO_0000115 xml:lang="cs">Abnormální poměr paměťových efektorových CD4 pozitivních T buněk vzhledem k celkovému počtu T buňek v krvi. Tyto buňky s krátkou životností migrují do místa infekce a pokouší se eliminovat patogeny. Mají fenotyp CD3-pozitivní, CD4-pozitivní, CD62L-negativní, CCR7-negativní, CD127-pozitivní, CD45RA-negativní, CD45RO-pozitivní, a CD25-negativní.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální podíl CD4-pozitivních efektorových paměťových T buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025623"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální poměr paměťových efektorových CD4 pozitivních T buněk vzhledem k celkovému počtu T buňek v krvi. Tyto buňky s krátkou životností migrují do místa infekce a pokouší se eliminovat patogeny. Mají fenotyp CD3-pozitivní, CD4-pozitivní, CD62L-negativní, CCR7-negativní, CD127-pozitivní, CD45RA-negativní, CD45RO-pozitivní, a CD25-negativní.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal proportion of effector memory CD4+ T cells compared to the total number of T cells in the blood. These are memory cells that are short-lived cells that migrate to the site of an infection and attempt to eliminate the pathogen. These cells have the phenotype CD3-positive, CD4-positive, CD62L-negative, CCR7-negative, CD127-positive, CD45RA-negative, CD45RO-positive, and CD25-negative</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025623"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální podíl CD4-pozitivních efektorových paměťových T buněk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>obsolete Abnormal CD4+ effector memory T cell proportion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025624">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně snížený podíl efektorových paměťových CD4+ T-lymfocytů v porovnání s celkovým počtem T-lymfocytů v krvi. Jedná se o paměťové buňky krátkodobě žijící, které migrují do místa infekce a snaží se patogen eliminovat. Tyto buňky mají fenotyp CD3 pozitivní, CD4 pozitivní, CD62L negativní, CCR7 negativní, CD127 pozitivní, CD45RA negativní, CD45RO pozitivní a CD25 negativní.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížený podíl CD4+ efektorových T-lymfocytů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025624"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně snížený podíl efektorových paměťových CD4+ T-lymfocytů v porovnání s celkovým počtem T-lymfocytů v krvi. Jedná se o paměťové buňky krátkodobě žijící, které migrují do místa infekce a snaží se patogen eliminovat. Tyto buňky mají fenotyp CD3 pozitivní, CD4 pozitivní, CD62L negativní, CCR7 negativní, CD127 pozitivní, CD45RA negativní, CD45RO pozitivní a CD25 negativní.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormally decreased proportion of effector memory CD4+ T cells compared to the total number of T cells in the blood. These are memory cells that are short-lived cells that migrate to the site of an infection and attempt to eliminate the pathogen. These cells have the phenotype CD3-positive, CD4-positive, CD62L-negative, CCR7-negative, CD127-positive, CD45RA-negative, CD45RO-positive, and CD25-negative.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025624"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Snížený podíl CD4+ efektorových T-lymfocytů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased effector memory CD4+ T cell proportion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025625">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně zvýšený podíl efektorových paměťových CD4+ T-lyfmocytů. Jedná se o paměťové buňky s krátkou životností, které migrují do místa infekce a snaží se eliminovat patogen. Tyto buňky mohou mít fenotyp CD3/CD4/CD62L-/CD45RA.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšený podíl CD4+ efektorových T-lymfocytů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025625"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně zvýšený podíl efektorových paměťových CD4+ T-lyfmocytů. Jedná se o paměťové buňky s krátkou životností, které migrují do místa infekce a snaží se eliminovat patogen. Tyto buňky mohou mít fenotyp CD3/CD4/CD62L-/CD45RA.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormally increased proportion of effector memory CD4+ T cells compared to the total number of T cells in the blood. These are memory cells that are short-lived cells that migrate to the site of an infection and attempt to eliminate the pathogen. These cells may have a CD3/CD4/CD62L-/CD45RA phenotype.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025625"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšený podíl CD4+ efektorových T-lymfocytů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased effector memory CD4+ T cell proportion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025626">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně vysoká koncentrace kyseliny olejové (oleátu) v krevním oběhu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená hladina cirkulujících oleátů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025626"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně vysoká koncentrace kyseliny olejové (oleátu) v krevním oběhu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormally high concentration of oleic acid (oleate) in the blood circulation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025626"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená hladina cirkulujících oleátů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased circulating oleate level</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025627">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně vysoká koncentrace oktadekanoátu v krevním oběhu. Oktadekanoát je aniont mastné kyseliny 18:0, který je konjugovanou bází kyseliny oktadekanové (kyselina stearová).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená hladina cirkulujícího oktadekanoátu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025627"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně vysoká koncentrace oktadekanoátu v krevním oběhu. Oktadekanoát je aniont mastné kyseliny 18:0, který je konjugovanou bází kyseliny oktadekanové (kyselina stearová).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormally high concentration of octadecanoate in the blood circulation. Octadecanoate is a fatty acid anion 18:0 that is the conjugate base of octadecanoic acid (stearic acid).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
