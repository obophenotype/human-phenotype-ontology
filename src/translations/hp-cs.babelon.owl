    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011810">
        <obo:IAO_0000115 xml:lang="cs">Snížená schopnost rozlišovat hmatové vjemy v bodech, které jsou velmi blízko u sebe. To lze otestovat pomocí speciálních posuvných měřítek, jejichž hroty lze nastavit od 2 mm do několika centimetrů od sebe.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zhoršená schopnost rozlišit dva body</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011810"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížená schopnost rozlišovat hmatové vjemy v bodech, které jsou velmi blízko u sebe. To lze otestovat pomocí speciálních posuvných měřítek, jejichž hroty lze nastavit od 2 mm do několika centimetrů od sebe.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduced ability to distinguish tactile sensations at points that are very close to one another. This can be tested by using special calipers whose points can be set from 2mm to several centimeters apart.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011810"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zhoršená schopnost rozlišit dva body</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired two-point discrimination</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011811">
        <obo:IAO_0000115 xml:lang="cs">Snížená schopnost přesně identifikovat místo dotyku. Tento test se obvykle provádí tak, že pacient, který má zavřené nebo zakryté oči, se dotkne stejného místa špičkou prstu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zhoršená lokalizace dotyku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011811"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížená schopnost přesně identifikovat místo dotyku. Tento test se obvykle provádí tak, že pacient, který má zavřené nebo zakryté oči, se dotkne stejného místa špičkou prstu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduced ability to identify precisely the site of a touch. This test is usually carried out by asking a patient, whose eyes are closed or covered, to touch the same site with a fingertip.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011811"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zhoršená lokalizace dotyku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired touch localization</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011812">
        <obo:IAO_0000115 xml:lang="cs">Zhoršená schopnost rozpoznávat písmena nebo čísla nakreslená konečkem prstu vyšetřujícího na kůži pacienta (po celou dobu vyšetření jsou oči pacienta zavřené nebo zakryté)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Agrafestézie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011812"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zhoršená schopnost rozpoznávat písmena nebo čísla nakreslená konečkem prstu vyšetřujícího na kůži pacienta (po celou dobu vyšetření jsou oči pacienta zavřené nebo zakryté)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired ability to recognize letters or numbers drawn by an examiner&apos;s fingertip on the patient&apos;s skin (the patients eyes are closed or covered throughout this examination).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011812"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Agrafestézie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Agraphesthesia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011813">
        <obo:IAO_0000115 xml:lang="cs">Lipofuscin (pigment stáří) je hnědožlutý, elektronově hustý, autofluorescenční materiál, který se v průběhu času postupně akumuluje v lysozomech postmitotických buněk, jako jsou neurony a srdeční myocyty. Tento termín se používá v případě, kdy dojde ke zvýšení akumulace lipofuscinu (také známého jako autofluorescenční lipoprotein) více, než se očekává pro věk pacienta.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšený cerebrální lipofuscin</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011813"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Lipofuscin (pigment stáří) je hnědožlutý, elektronově hustý, autofluorescenční materiál, který se v průběhu času postupně akumuluje v lysozomech postmitotických buněk, jako jsou neurony a srdeční myocyty. Tento termín se používá v případě, kdy dojde ke zvýšení akumulace lipofuscinu (také známého jako autofluorescenční lipoprotein) více, než se očekává pro věk pacienta.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lipofuscin (age pigment) is a brown-yellow, electron-dense, autofluorescent material that accumulates progressively over time in lysosomes of postmitotic cells, such as neurons and cardiac myocytes. This term pertains if there is an increase in the accumulation of lipofuscin (also known as autofluorescent lipoprotein) more than expected for the age of the patient.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011813"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšený cerebrální lipofuscin</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased cerebral lipofuscin</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011814">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená hladina hypoxantinu v moči.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšený hypoxantin v moči</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011814"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená hladina hypoxantinu v moči.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The concentration of hypoxanthine in the urine, normalized for urine concentration, is above the upper limit of normal.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011814"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšený hypoxantin v moči</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased urinary hypoxanthine level</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011815">
        <obo:IAO_0000115 xml:lang="cs">Vrozená vada lebky, při níž dochází k vyklenutí části lebečního obsahu vrozeným defektem lebky, obvykle překrytým kůží nebo sliznicí. Termín encefalokéla se vztahuje na podtřídu těchto lézí, u nichž mozková tkáň vystupuje skrz defekt.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Cefalokéla</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011815"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vrozená vada lebky, při níž dochází k vyklenutí části lebečního obsahu vrozeným defektem lebky, obvykle překrytým kůží nebo sliznicí. Termín encefalokéla se vztahuje na podtřídu těchto lézí, u nichž mozková tkáň vystupuje skrz defekt.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A congenital defect in the skull, whereby there is a protrusion of part of the cranial contents through a congenital defect in the cranium, usually covered with skin or mucous membrane. The term encephalocele refers to a subclass of these lesions in which brain tissue protrudes through the defect.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011815"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Cefalokéla</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cephalocele</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011816">
        <obo:IAO_0000115 xml:lang="cs">Encefalokéla nacházející se mezi atropologickými landmarky bregmou a lambdou.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Parietální encefalokéla</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011816"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Encefalokéla nacházející se mezi atropologickými landmarky bregmou a lambdou.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An encephalocele located between bregma and lambda.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011816"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Parietální encefalokéla</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Parietal encephalocele</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011817">
        <obo:IAO_0000115 xml:lang="cs">Bazální encefalokéla je encefalokéla, která se vyskytuje podél lamina cribriformis nebo přes os sphenoidale. Výhřez se může objevit v nosní dutině, nosohltanu, epifaryngu, sinus sphenoidalis, zadní části očnice nebo ve fossa pterygopalatina. Důležitým rozdílem od ostatních typů je, že není viditelný žádný vnější vyboulení, s výjimkou těch vzácných případů herniací tak velkých, že vyčnívají přes ústa nebo nosy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Bazální encefalokéla</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011817"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Bazální encefalokéla je encefalokéla, která se vyskytuje podél lamina cribriformis nebo přes os sphenoidale. Výhřez se může objevit v nosní dutině, nosohltanu, epifaryngu, sinus sphenoidalis, zadní části očnice nebo ve fossa pterygopalatina. Důležitým rozdílem od ostatních typů je, že není viditelný žádný vnější vyboulení, s výjimkou těch vzácných případů herniací tak velkých, že vyčnívají přes ústa nebo nosy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Basal encephalocele is an encephalocele that occurs along the cribriform plate or through the sphenoid bone. The mass may appear in the nasal cavity, nasopharynx, epipharynx, sphenoid sinus, posterior orbit, or pterygopalatine fossa. The important distinction from other types is that no external tumor is visible except in those rare instances of herniations so large that they protrude through the mouth or nares.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011817"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Bazální encefalokéla</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Basal encephalocele</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011818">
