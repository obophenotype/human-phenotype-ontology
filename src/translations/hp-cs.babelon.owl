    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011444">
        <obo:IAO_0000115 xml:lang="cs">Typ rigidity, při kterém jsou paže ve flexi a addukci a nohy jsou natažené. To značí léze v bílé hmotě mozku, v Capsula interna nebo v thalamu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dekortikační rigidita</rdfs:label>
    </rdf:Description>
