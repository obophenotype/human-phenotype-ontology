        <babelon:source_value>Factor XIII subunit A deficiency</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0040234">
        <obo:IAO_0000115 xml:lang="cs">Deficity podjednotky B faktoru XIII, který vede ke snížené aktivitě faktoru XIII. Aktivovaný faktor XIII katalyzuje vznik křížových vazeb mezi molekulami fibrinu a stabilizuje tak krevní sraženinu</obo:IAO_0000115>
