    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010803">
        <obo:IAO_0000115 xml:lang="cs">Vnitřní část červeně horního rtu, která se normálně nachází zevnitř dutiny ústní naproti zubům, je viditelná z frontálního pohledu - při evertovaném horním rtu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Evertovaná červeň horního rtu</rdfs:label>
    </rdf:Description>
