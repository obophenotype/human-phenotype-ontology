        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Apnoe</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Apnea</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002105">
        <obo:IAO_0000115 xml:lang="cs">Vykašlávání krve či sputa s příměsí krve z hrtanu, průdušnice, průdušek či plic</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hemoptýza</rdfs:label>
    </rdf:Description>
