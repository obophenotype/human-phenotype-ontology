        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007634"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Akutní stav charakterizovaný náhlou ztrátou zraku (obvykle zjištěnou ráno), edémem optického disku na počátku, defekty zorného pole souvisejícími s optickým diskem. Nearteritická přední ischemická optická neuropatie může být spojena s plamenkovitými krváceními na oteklém disku nebo blízké neuroretinální vrstvě a někdy s blízkými vatovitými exsudáty.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An acute condition characterized by sudden visual loss (usually discovered in the morning), optic disc edema at onset, optic disc-related visual field defects. Nonarteritic anterior ischemic optic neuropathy can be associated with flame hemorrhages on the swollen disk or nearby neuroretinal layer, and sometimes with nearby cotton-wool exudates.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007634"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nearteritická forma přední ischemické neuropatie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nonarteritic anterior ischemic optic neuropathy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007641">
        <obo:IAO_0000115 xml:lang="cs">Forma barvosleposti, při které lze rozlišit pouze dvě ze tří základních barev z důvodu absence jednoho z pigmentů čípku sítnice.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dyschromatopsie</rdfs:label>
    </rdf:Description>
