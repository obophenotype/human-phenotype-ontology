    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033880">
        <obo:IAO_0000115 xml:lang="cs">Hromadění edematózní extracelulární matrix ve vnitřní vrstvě (intimě) venae arcuatae ledviny. Materiál se podobá hlenu a při barvení hematoxylinem a eozinem se jeví jako bleděmodrý.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Intimální mukoidní edém vena arcuata</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
