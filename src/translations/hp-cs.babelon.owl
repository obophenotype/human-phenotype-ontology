        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031248">
        <obo:IAO_0000115 xml:lang="cs">Pruritus je svědění nebo pocit, který člověka nutí ke škrábání. Tento termín označuje abnormálně zvýšený pocit svědění na dlani (dlaních).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Palmární pruritus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
