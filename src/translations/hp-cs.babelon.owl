    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031213">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená hladina 17-hydroxyprogesteronu v krvi. 17-hydroxyprogesteron je intermediární steroid v biosyntetické dráze nadledvin vedoucí od cholesterolu ke kortizolu a je substrátem pro steroid 21-hydroxylázu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšený cirkulující 17-hydroxyprogesteron</rdfs:label>
    </rdf:Description>
