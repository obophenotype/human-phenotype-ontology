    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033116">
        <obo:IAO_0000115 xml:lang="cs">Ložiska buněk žaludečního typu vylučujících hlen rozptýlená mezi duodenálními enterocyty. Tato ložiska žaludečních epiteliálních buněk obsahují PAS (Periodic Acid Schiff) pozitivní neutrální mucin a postrádají kartáčový lem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Duodenální gastrická metaplázie</rdfs:label>
    </rdf:Description>
