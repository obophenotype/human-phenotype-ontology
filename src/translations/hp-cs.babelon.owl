    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003347">
        <obo:IAO_0000115 xml:lang="cs">Normální lymfocyty periferní krve jsou po stimulaci fytohemaglutininem (PHA) cytotoxické pro homologní a heterologní buňky, ale ne pro autologní buňky v monovrstvé kultuře. Předpokládá se, že cytotoxický účinek svědčí o imunologické způsobilosti lymfocytů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zhoršená transformace lymfocytů fytohemaglutininem</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003347"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Normální lymfocyty periferní krve jsou po stimulaci fytohemaglutininem (PHA) cytotoxické pro homologní a heterologní buňky, ale ne pro autologní buňky v monovrstvé kultuře. Předpokládá se, že cytotoxický účinek svědčí o imunologické způsobilosti lymfocytů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Normal peripheral blood lymphocytes, when stimulated by phytohemagglutinin (PHA) are cytotoxic for homologous and heterologous cells but not for autologous cells in monolayer culture. The cytotoxic effect is thought to be indicative of the immunological competence of the lymphocytes</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003347"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zhoršená transformace lymfocytů fytohemaglutininem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>obsolete Impaired lymphocyte transformation with phytohemagglutinin</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
