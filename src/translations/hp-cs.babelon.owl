        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012250">
        <obo:IAO_0000115 xml:lang="cs">Elektrokardiografická anomálie, při níž se segment ST nachází níže než izoelektrická linie.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Deprese ST segmentu</rdfs:label>
    </rdf:Description>
