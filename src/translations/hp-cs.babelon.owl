        <obo:IAO_0000115 xml:lang="cs">Abnormálné laxní dolní oční víčko asociované s relaxací tkání.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Laxicita dolního očního víčka</rdfs:label>
    </rdf:Description>
