        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032035"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálné laxní dolní oční víčko asociované s relaxací tkání.</owl:annotatedTarget>
