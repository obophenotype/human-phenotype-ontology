    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011373">
        <obo:IAO_0000115 xml:lang="cs">&quot;Vrozená vada hlemýždě typu &quot;&quot;incomplete partition&quot;&quot;. Scala vestibuli a scala tympani jsou rozděleny přepážkou (partition), kromě místa ve vrcholu hlemýždě, kde jedna přechází ve druhou pře helicotrema&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Malformace kochley typu „incomplete partition“</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011373"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">&quot;Vrozená vada hlemýždě typu &quot;&quot;incomplete partition&quot;&quot;. Scala vestibuli a scala tympani jsou rozděleny přepážkou (partition), kromě místa ve vrcholu hlemýždě, kde jedna přechází ve druhou pře helicotrema&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Incomplete formation of the cochlear partition. The scala vestibuli and scala tympani separated by the cochlear partition, except in the apical turn where the two scalae are in continuity via the helicotrema.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011373"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Malformace kochley typu „incomplete partition“</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Incomplete partition of the cochlea</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011374">
        <obo:IAO_0000115 xml:lang="cs">Vada hlemýždě typu incomplete partition 1 je rovněž známá jako cystická kochleovestibulární malformace, u které kochlea nemá kostěný modiolus a výsledkem je prázdná, cystická kochlea. Toto je doprovázena dilatovaným cystickým vestibulem. Vada vzniká při poruše fetálního vývoje v 5. týdnu gestace.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Malformace „incomplete partition“ typu 1</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011374"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vada hlemýždě typu incomplete partition 1 je rovněž známá jako cystická kochleovestibulární malformace, u které kochlea nemá kostěný modiolus a výsledkem je prázdná, cystická kochlea. Toto je doprovázena dilatovaným cystickým vestibulem. Vada vzniká při poruše fetálního vývoje v 5. týdnu gestace.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Incomplete partition I is also known as cystic cochleovestibular malformation, where the cochlea has no bony modiolus, resulting in an empty cystic cochlea. This is accompanied by a dilated cystic vestibule with developmental arrest at the fifth week of gestation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011374"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Malformace „incomplete partition“ typu 1</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Incomplete partition of the cochlea type I</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
