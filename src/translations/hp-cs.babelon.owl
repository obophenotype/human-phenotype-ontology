    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001133">
        <obo:IAO_0000115 xml:lang="cs">Absolutní nebo relativní pokles citlivosti sítnice rozšiřující se od okraje (periferie) vizuálního pole v koncentrickém směru. Vizuální pole je oblast, která je vnímána současně fixací okem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zúžení periferního zorného pole</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001133"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Absolutní nebo relativní pokles citlivosti sítnice rozšiřující se od okraje (periferie) vizuálního pole v koncentrickém směru. Vizuální pole je oblast, která je vnímána současně fixací okem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An absolute or relative decrease in retinal sensitivity extending from edge (periphery) of the visual field in a concentric pattern. The visual field is the area that is perceived simultaneously by a fixating eye.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
