    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100268">
        <obo:IAO_0000115 xml:lang="cs">Deprese či snížená část červeně horního rtu, obvykle paramediánně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Důlek v horním rtu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100268"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Deprese či snížená část červeně horního rtu, obvykle paramediánně.</owl:annotatedTarget>
