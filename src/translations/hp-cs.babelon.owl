        <owl:annotatedTarget xml:lang="cs">Typ megaloblastické anémie, která se zlepšuje po podání pyrimidinových přípravků jako například uridylové nebo cytidylové kyseliny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of megaloblastic anemia that improves upon administration of pyrimidine supplements such as uridylic acid and cytidylic acid.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
