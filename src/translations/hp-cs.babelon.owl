        <owl:annotatedTarget xml:lang="cs">Abnormalita saturace sérového transferinu, která se spočte vydělením sérové hladiny železa celkovou vazebnou kapacitou pro železo</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
