    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032962">
        <obo:IAO_0000115 xml:lang="cs">Dilatované renální tubuly (více než dvojnásobek průměru normálního proximálního tubulu) obsahující eozinofilní amorfní materiál. Tato vlastnost je obecně doprovázena vroubkováním profilu močového válce. Epitel vystýlající mikrocystu je obecně zploštělý a nevykazuje kartáčový okraj.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Tubulární mikrocystické změny</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032962"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Dilatované renální tubuly (více než dvojnásobek průměru normálního proximálního tubulu) obsahující eozinofilní amorfní materiál. Tato vlastnost je obecně doprovázena vroubkováním profilu močového válce. Epitel vystýlající mikrocystu je obecně zploštělý a nevykazuje kartáčový okraj.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dilated renal tubules (over twice the diameter of a normal proximal tubule) containing eosinophilic amorphous material. This feature is generally accompanied by scalloping of the cast profile. The epithelium lining the microcyst is generally flattened and does not reveal brush border.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032962"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Tubulární mikrocystické změny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tubular microcystic change</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
