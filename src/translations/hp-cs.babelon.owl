        <owl:annotatedTarget xml:lang="cs">Abnormalita rovnováhy nebo udržování rovnováhy kyselin a zásad v tělesných tekutinách, což má za následek abnormální pH</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
