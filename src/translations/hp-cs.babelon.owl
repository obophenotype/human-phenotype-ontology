    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034280">
        <obo:IAO_0000115 xml:lang="cs">Kodocyty maji centrálně lokalizovaný disk hemoglobinu obstoupený bledou oblastí se zevním okrajem z hemoglobinu přilehlého k buněčné membráně, co dává buňce vzhled střeleckého terče.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Terčovité erytrocyty</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
