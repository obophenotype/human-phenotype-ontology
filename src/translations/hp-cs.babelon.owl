    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100003">
        <obo:IAO_0000115 xml:lang="cs">Maligní mezoteliom pocházející z buněk pobřišnice (tenká vrstva mezotelu, která tvoří výstelku břišní dutiny). Peritoneální mezoteliom je druhá nejčastější forma mezoteliomu, první je pleurální mezoteliom</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Peritoneální mezoteliom</rdfs:label>
    </rdf:Description>
