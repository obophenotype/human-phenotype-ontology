        <owl:annotatedTarget xml:lang="cs">Přítomnost bílých depozit v spojivce připomínajících sůl. Může být asociováno s kalcinózou.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of whitish deposits in the conjunctiva resembling salt. May be related to calcinosis.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007799"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Konjunktivální bělavé sůl připomínající depozita</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Conjunctival whitish salt-like deposits</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007800">
        <obo:IAO_0000115 xml:lang="cs">Abnormální velikost oka s axiální délkou &gt;gt; 2,5 standardní odchylky od průměru populace.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvětšená axiální délka očního bulbu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007800"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální velikost oka s axiální délkou &gt;gt; 2,5 standardní odchylky od průměru populace.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal largeness of the eye with an axial length &gt; 2.5 standard deviations from population mean.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007800"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvětšená axiální délka očního bulbu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased axial length of the globe</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007802">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost centrálních, jemných, bělavých granulárních lézí ve stromatu rohovky. Tento typ rohovkové dystrofie je obvykle asymptomatický se začátkem v dětství a pomalou progresí. Později v průběhu může být postižen epitel rohovky a Bowmanova vrstva. Histologicky rohovka vykazuje rovnoměrné ukládání hyalinního materiálu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Granulární dystrofie rohovky</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007802"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost centrálních, jemných, bělavých granulárních lézí ve stromatu rohovky. Tento typ rohovkové dystrofie je obvykle asymptomatický se začátkem v dětství a pomalou progresí. Později v průběhu může být postižen epitel rohovky a Bowmanova vrstva. Histologicky rohovka vykazuje rovnoměrné ukládání hyalinního materiálu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of central, fine, whitish granular lesions in the stroma of the cornea. This type of corneal dystrophy is usually asymptomatic and begins in childhood and shows a slow progression. Later in the course, the corneal epithelium and Bowman&apos;s layer may be affected. Histologically, the cornea shows a uniform deposition of hyaline material.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007802"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Granulární dystrofie rohovky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Granular corneal dystrophy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007803">
        <obo:IAO_0000115 xml:lang="cs">Úplná barvoslepost, úplná neschopnost rozlišovat barvy. Postižené osoby nemohou vnímat barvy, ale pouze odstíny šedé</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Monochromazie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007803"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Úplná barvoslepost, úplná neschopnost rozlišovat barvy. Postižené osoby nemohou vnímat barvy, ale pouze odstíny šedé</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complete color blindness, a complete inability to distinguish colors. Affected persons cannot perceive colors, but only shades of gray.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007803"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Monochromazie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Monochromacy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007807">
        <rdfs:label xml:lang="cs">Komprese optického nervu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007807"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Komprese optického nervu</owl:annotatedTarget>
