    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003760">
        <obo:IAO_0000115 xml:lang="cs">Mechanický poklep (tj. úder do svalu reflexním kladivem) vede k šíření vln svalových kontrakcí, které začínají proximálně a šíří se laterálně přes sval</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Rychlé svalové kontrakce vyvolané poklepem</rdfs:label>
    </rdf:Description>
