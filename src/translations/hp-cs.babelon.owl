        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011682">
        <obo:IAO_0000115 xml:lang="cs">Defekt komorového septa, který souvisí s membranózním septem a je ohraničen atrioventrikulární chlopní, s výjimkou defektu komorového septa typu 3.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Perimembranózní defekt komorového septa</rdfs:label>
