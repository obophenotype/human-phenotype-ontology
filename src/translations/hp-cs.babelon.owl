        <obo:IAO_0000115 xml:lang="cs">Forma heterotopie, kdy se chybně lokalizovaná šedá hmota nachází hluboko v bílé hmotě.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Subkortikální heterotopie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032391"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Forma heterotopie, kdy se chybně lokalizovaná šedá hmota nachází hluboko v bílé hmotě.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of heterotopia were the mislocalized gray matter is located deep within the white matter.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
