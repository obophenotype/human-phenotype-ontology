    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033569">
        <obo:IAO_0000115 xml:lang="cs">Druh abnormální komorové osy na EKG, kdy osa QRS spadá mezi -90 stupňů a 180 stupňů. V tomto případě směřuje komorový vektor nahoru a doprava.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Extrémní deviace osy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033569"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Druh abnormální komorové osy na EKG, kdy osa QRS spadá mezi -90 stupňů a 180 stupňů. V tomto případě směřuje komorový vektor nahoru a doprava.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A kind of abnormal ventricular axis in the EKG whereby the QRS axis fall sbetween -90 degrees and 180 degrees. In this case, the ventricular vector is directed upward and to the right.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033569"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Extrémní deviace osy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Extreme axis deviation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033570">
        <obo:IAO_0000115 xml:lang="cs">Druh abnormální ventrikulární osy v EKG, kde komplex QRS je izoelektrický nebo ekvifázický ve všech svodech bez dominantního vychýlení QRS.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Intermediální osa komor</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033570"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Druh abnormální ventrikulární osy v EKG, kde komplex QRS je izoelektrický nebo ekvifázický ve všech svodech bez dominantního vychýlení QRS.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A kind of abnormal ventricular axis in the EKG whereby the QRS complex is isoelectric or equiphasic in all leads with no dominant QRS deflection.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
