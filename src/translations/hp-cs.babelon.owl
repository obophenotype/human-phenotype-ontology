    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000708">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita psychického fungování, včetně různých afektivních, behaviorálních, kognitivních a percepčních abnormalit</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Behaviorální abnormalita</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000708"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita psychického fungování, včetně různých afektivních, behaviorálních, kognitivních a percepčních abnormalit</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atypical behavior is an abnormality in a person&apos;s actions that can be controlled or modulated by the will of the individual. While abnormal behaviors can be difficult to control, they are distinct from other abnormal actions that cannot be affected by the individual&apos;s will.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
