        <babelon:source_value>Focal emotional seizure with anger</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032737">
        <obo:IAO_0000115 xml:lang="cs">Fokální emoční záchvat s paranoiou je charakterizován přítomností paranoie jako vyjádřené nebo pozorované emoce na počátku záchvatu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální emoční záchvat s paranoiou</rdfs:label>
    </rdf:Description>
