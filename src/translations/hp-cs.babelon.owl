        <owl:annotatedTarget xml:lang="cs">Přítomnost megakaryocytů v kostní dřeni, jejichž jádra jsou méně laločnatá, než se vzhledem k velikosti jádra očekává</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of megakaryocytes in the bone marrow whose nuclei are less lobulated than expected for the size of the nucleus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
