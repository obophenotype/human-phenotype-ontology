        <babelon:source_value>Aortic laminar medial collapse</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032088">
        <obo:IAO_0000115 xml:lang="cs">Nerovnoběžné uspořádání hladkých svalových buněk aorty vytvářející fokální/multifokální rozpad nebo někdy nodulární agregáty hladkých svalových buněk.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dezorganizace hladkých svalových buněk aorty</rdfs:label>
    </rdf:Description>
