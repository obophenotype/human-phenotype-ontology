        <owl:annotatedTarget xml:lang="cs">Habitus, kdy tělo je vysoké, štíhlé a s podváhou, s dlouhými dolními i horními končetinami (rozpětí paží je větší než výška o víc než 5 cm)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A body habitus that is tall, slim and underweight, with long legs and long arms (i.e., arm span exceeds height by 5 cm or more).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
