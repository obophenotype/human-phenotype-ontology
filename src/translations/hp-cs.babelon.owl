    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000728">
        <rdfs:label xml:lang="cs">Zhoršená schopnost vytvářet vztahy s vrstevníky</rdfs:label>
    </rdf:Description>
