        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Pachygyrie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pachygyria</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001304">
        <obo:IAO_0000115 xml:lang="cs">Setrvalé nedobrovolné svalové kontrakce vedoucí ke kroutivým opakovaným pohybům těla</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Torzní dystonie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001304"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Setrvalé nedobrovolné svalové kontrakce vedoucí ke kroutivým opakovaným pohybům těla</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sustained involuntary muscle contractions that produce twisting and repetitive movements of the body.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001304"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Torzní dystonie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Torsion dystonia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001305">
        <obo:IAO_0000115 xml:lang="cs">Kongenitální malformace mozku typicky charakterizovaná nekompletní formací vermis mozečku, dilatací čtvrté komory a zvětšením zadní jámy lební. Zjednodušeně řečeno, Dandy Walkerova malformace je cysta v mozečku, obvykle symetrická, která komunikuje se čtvrtou komorou. Může interferovat s drenáží mozkomíšního moku a vést k hydrocefalu. Dandy Walkerovy cysty se tvoří v časné fázi embryonálního vývoje při formaci mozku. Přes cysty probíhá typicky několik krevních cév do mozku, které znemožňují chirurgické odstranění</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dandyho-Walkerova malformace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001305"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kongenitální malformace mozku typicky charakterizovaná nekompletní formací vermis mozečku, dilatací čtvrté komory a zvětšením zadní jámy lební. Zjednodušeně řečeno, Dandy Walkerova malformace je cysta v mozečku, obvykle symetrická, která komunikuje se čtvrtou komorou. Může interferovat s drenáží mozkomíšního moku a vést k hydrocefalu. Dandy Walkerovy cysty se tvoří v časné fázi embryonálního vývoje při formaci mozku. Přes cysty probíhá typicky několik krevních cév do mozku, které znemožňují chirurgické odstranění</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A congenital brain malformation typically characterized by incomplete formation of the cerebellar vermis, dilation of the fourth ventricle, and enlargement of the posterior fossa. In layman&apos;s terms, Dandy Walker malformation is a cyst in the cerebellum (typically symmetrical) that is involved with the fourth ventricle. This may interfere with the ability to drain cerebrospinal fluid from the brain, resulting in hydrocephalus. Dandy Walker cysts are formed during early embryonic development, while the brain forms. The cyst in the cerebellum typically has several blood vessels running through it connecting to the brain, thereby prohibiting surgical removal.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001305"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Dandyho-Walkerova malformace</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dandy-Walker malformation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001308">
