    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009695">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost abnormálních kalcifikací ve formě skvrn či teček v epifýzách palce ruky</obo:IAO_0000115>
