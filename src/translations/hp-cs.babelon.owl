    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010448">
        <obo:IAO_0000115 xml:lang="cs">Vývojová vada, která má za následek úplnou obliteraci lumen tlustého střeva. To znamená, že dochází k abnormálnímu uzavření nebo atrézii tubulární struktury tlustého střeva.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Atrézie tlustého střeva</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010448"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vývojová vada, která má za následek úplnou obliteraci lumen tlustého střeva. To znamená, že dochází k abnormálnímu uzavření nebo atrézii tubulární struktury tlustého střeva.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A developmental defect resulting in complete obliteration of the lumen of the colon. That is, there is an abnormal closure, or atresia of the tubular structure of the colon.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
