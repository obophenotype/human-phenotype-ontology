        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Accumulation of amorphous, eosinophilic, glassy, periodic acid-Schiff (PAS)-positive, silver-negative material in the glomerulus at the tip/tubular pole.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
