        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032607">
        <obo:IAO_0000115 xml:lang="cs">Tubulární průřez zcela vystlaný tubulárním epitelem s konvexní apikální buněčnou membránou (tj. buňky mají tvar obráceného U a chybí jim zřetelný menší výběžek, který se vyskytuje u blebbingu), což vede ke zdánlivému úplnému uzavření lumen.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Otok renálních tubulárních epiteliálních buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032607"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Tubulární průřez zcela vystlaný tubulárním epitelem s konvexní apikální buněčnou membránou (tj. buňky mají tvar obráceného U a chybí jim zřetelný menší výběžek, který se vyskytuje u blebbingu), což vede ke zdánlivému úplnému uzavření lumen.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tubular cross section lined entirely by tubular epithelium with convex apical cell membrane (i.e., cells are shaped like an upside down U, and lack a distinct smaller protrusion seen in blebbing as defined above) resulting in apparent complete closure of the lumen.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032607"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Otok renálních tubulárních epiteliálních buněk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Renal tubular epithelial cell swelling</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032608">
        <obo:IAO_0000115 xml:lang="cs">Typ renální tubulární atrofie vyznačující se vzhledem podobným štítné žláze s malými kulatými tubuly s výrazně zploštělým, zjednodušeným epitelem a jednotnými intratubulárními válci.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Tubulární atrofie tyreoidizačního typu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032608"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ renální tubulární atrofie vyznačující se vzhledem podobným štítné žláze s malými kulatými tubuly s výrazně zploštělým, zjednodušeným epitelem a jednotnými intratubulárními válci.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of renal tubular atrophy characterized by a thyroid-like appearance, with small round tubules with markedly flattened, simplified epithelium and uniform intratubular casts.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032608"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Tubulární atrofie tyreoidizačního typu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Thyroidization-type tubular atrophy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032609">
        <obo:IAO_0000115 xml:lang="cs">Typ renální tubulární atrofie charakterizovaný endokrinním vzhledem tubulů, které jsou malé a mají úzký lumen, čiré buňky a relativně tenké bazální membrány</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Tubulární atrofie endokrinního typu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032609"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ renální tubulární atrofie charakterizovaný endokrinním vzhledem tubulů, které jsou malé a mají úzký lumen, čiré buňky a relativně tenké bazální membrány</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of renal tubular atrophy characterized by endocrine-like appearance of tubules, which are small and have narrow lumina, clear cells, and relatively thin basement membranes.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032609"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Tubulární atrofie endokrinního typu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Endocrine-type tubular atrophy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032610">
        <obo:IAO_0000115 xml:lang="cs">Infiltrace ledvin tubulointersticiálními mykobakteriemi identifikovanými v barveních acidofast nebo Fite. Může být spojena s granulomatózním zánětem.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Tubulointersticiální mykobakteriální infiltrace</rdfs:label>
    </rdf:Description>
