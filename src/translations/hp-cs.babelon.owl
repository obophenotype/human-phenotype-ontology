        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030936">
        <obo:IAO_0000115 xml:lang="cs">Abnormální rozvrstvení střevní muscularis propria do tří vrstev: (1) vnitřní cirkulární; (2) další šikmá; a (3) vnější podélná vrstva.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální vrstvení muscularis propria</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030936"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální rozvrstvení střevní muscularis propria do tří vrstev: (1) vnitřní cirkulární; (2) další šikmá; a (3) vnější podélná vrstva.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal layering of the intestinal muscularis propria into three layers; (1) inner circular; (2) additional oblique; and (3) outer longitudinal layer.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
