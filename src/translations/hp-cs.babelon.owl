    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003121">
        <obo:IAO_0000115 xml:lang="cs">Kontraktura (chronická ztráta pohyblivosti kloubu v důsledku strukturálních změn ve svalech, šlachách, vazech, nebo kůži), které brání normálnímu jednoho nebo více kloubů končetin</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kontraktury kloubů končetin</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003121"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kontraktura (chronická ztráta pohyblivosti kloubu v důsledku strukturálních změn ve svalech, šlachách, vazech, nebo kůži), které brání normálnímu jednoho nebo více kloubů končetin</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A contracture (chronic loss of joint motion due to structural changes in muscle, tendons, ligaments, or skin) that prevent normal movement of one or more joints of the limbs.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
