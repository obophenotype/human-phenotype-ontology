    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012073">
        <obo:IAO_0000115 xml:lang="cs">Abnormální distribuce N-acylglycinů v moči. Existuje mnoho různých N-acylglycinů a tento termín označuje patologické změny v jejich hladině nebo distribuci.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální profil acylglycinu v moči</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012073"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální distribuce N-acylglycinů v moči. Existuje mnoho různých N-acylglycinů a tento termín označuje patologické změny v jejich hladině nebo distribuci.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal distribution of N-acylglycines in the urine. There are numerous different N-acylglycines, and this term refers to pathological alterations in their level or distribution.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
