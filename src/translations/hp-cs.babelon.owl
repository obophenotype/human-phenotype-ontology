        <babelon:source_value>Nonparallel arrangement/disarray of elastic fibers of the media of the aorta as identified on a stain for elastic fibers.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
