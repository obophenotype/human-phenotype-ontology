        <owl:annotatedTarget xml:lang="cs">Distální interfalangeální kloub a/nebo proximální interfalangeální kloub druhého až pátého prstu nemohou být extendovány na 180 stupňů ani aktivní ani pasivní extenzí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The distal interphalangeal joint and/or the proximal interphalangeal joint of the second to fifth fingers cannot be extended to 180 degrees by either active or passive extension.</babelon:source_value>
