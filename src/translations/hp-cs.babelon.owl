    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002963">
        <obo:IAO_0000115 xml:lang="cs">Opoždění kožní imunitní reakce na specifické antigeny, která je zprostředkovaná buňkami, nikoliv protilátkami. Test pozdní hypersenzitivity je funkčním testem měřícím přítomnost aktivovaných T-lymfocytů které rozpoznávají specifický antigen, který je prováděn aplikací malého množství antigenu do kůže. Místo aplikace se vyšetřuje po 48-72 hodinách.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální výsledek kožního testu pozdní hypersenzitivity</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002963"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Opoždění kožní imunitní reakce na specifické antigeny, která je zprostředkovaná buňkami, nikoliv protilátkami. Test pozdní hypersenzitivity je funkčním testem měřícím přítomnost aktivovaných T-lymfocytů které rozpoznávají specifický antigen, který je prováděn aplikací malého množství antigenu do kůže. Místo aplikace se vyšetřuje po 48-72 hodinách.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Delay in cutaneous immune reaction to specific antigens mediated not by antibodies but by cells. The delayed hypersensitivity test is an immune function test measuring the presence of activated T cells that recognize a specific antigen and is performed by injecting a small amount of the antigen into the skin. The area of the injection is examined 48-72 hours thereafter.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002963"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální výsledek kožního testu pozdní hypersenzitivity</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal delayed hypersensitivity skin test</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002965">
