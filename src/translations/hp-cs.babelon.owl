    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034312">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně snížená saturace oxyhemoglobinu během spánku (noční). V literatuře se používají různé prahové hodnoty, včetně více než 10 % celkové doby spánku pod hodnotou SpO2 90 %.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Noční hypoxémie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034312"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně snížená saturace oxyhemoglobinu během spánku (noční). V literatuře se používají různé prahové hodnoty, včetně více než 10 % celkové doby spánku pod hodnotou SpO2 90 %.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormally reduced oxyhemoglobin saturation during sleep (nocturnal). Different thresholds are used in the literature, including more than 10 percent of total sleep time below a SpO2 of 90 percent.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034312"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Noční hypoxémie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nocturnal hypoxemia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034313">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně zvýšená ejekční frakce levé komory, obvykle definovaná jako ejekční frakce levé komory vyšší než 70 %.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hyperdynamická ejekční frakce levé komory</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034313"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně zvýšená ejekční frakce levé komory, obvykle definovaná jako ejekční frakce levé komory vyšší než 70 %.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormally increased ejection fraction of the left ventricle, usually defined as a left ventricular ejection fraction greater than 70 percent.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034313"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hyperdynamická ejekční frakce levé komory</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hyperdynamic left ventricular ejection fraction</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034314">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli abnormalita ejekční frakce levé komory (LVEF), což je podíl systolického objemu a end-diastolického objemu. Systolický objem (nebo též tepový objem) je objem krve vypuzený jednou srdeční komorou do krevního oběhu při jednom srdečním stahu. Vypočítá se jako rozdíl end-diastolického a end-systolického objemu. LVEF se udává v procentech.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální ejekční frakce levé komory</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034314"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoli abnormalita ejekční frakce levé komory (LVEF), což je podíl systolického objemu a end-diastolického objemu. Systolický objem (nebo též tepový objem) je objem krve vypuzený jednou srdeční komorou do krevního oběhu při jednom srdečním stahu. Vypočítá se jako rozdíl end-diastolického a end-systolického objemu. LVEF se udává v procentech.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any abnormality of the left ventricular ejection fraction (LVEF), which is the fraction of chamber volume ejected in systole (stroke volume) in relation to the volume of the blood in the ventricle at the end of diastole (end-diastolic volume). Stroke volume (SV) is calculated as the difference between end-diastolic volume (EDV) and end-systolic volume (ESV). LVEF is calculated as [SV/EDV] in percent.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034314"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální ejekční frakce levé komory</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal left ventricular ejection fraction</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034315">
        <obo:IAO_0000115 xml:lang="cs">Přetrvávající kašel definovaný jako kašel trvající déle než osm týdnů u dospělých nebo déle než čtyři týdny u dětí.</obo:IAO_0000115>
