        <owl:annotatedTarget xml:lang="cs">Oblasti bíle diskolorace viditelné na povrchu zubů ve formě teček nebo pruhů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Areas of white discoloration visible on the surface of the teeth (enamel) in the form of streaks or specks.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
