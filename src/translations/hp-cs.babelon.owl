    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002725">
        <obo:IAO_0000115 xml:lang="cs">Chronické, recidivující, zánětlivé a často horečnaté mnohočetné onemocnění pojivové tkáně, charakterizované především postižením kůže, kloubů, ledvin a serózních membrán.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Systémový lupus erythematodes</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
