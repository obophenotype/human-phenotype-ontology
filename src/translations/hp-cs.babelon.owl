    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001786">
        <obo:IAO_0000115 xml:lang="cs">Chodidlo, jehož naměřená šířka je nižší než 5. percentil pro daný věk, nebo chodidlo, které se zdá být vzhledem ke své délce nepřiměřeně úzké</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Úzké chodidlo</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001786"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Chodidlo, jehož naměřená šířka je nižší než 5. percentil pro daný věk, nebo chodidlo, které se zdá být vzhledem ke své délce nepřiměřeně úzké</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A foot for which the measured width is below the 5th centile for age; or, a foot that appears disproportionately narrow for its length.</babelon:source_value>
