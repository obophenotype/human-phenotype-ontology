        <obo:IAO_0000115 xml:lang="cs">Abnormalita sedmého hlavového nervu někdy také označovaného jako lícní nerv</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormalita sedmého hlavového nervu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010827"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita sedmého hlavového nervu někdy také označovaného jako lícní nerv</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of the seventh cranial nerve sometimes also referred to as the facial nerve.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010827"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita sedmého hlavového nervu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal seventh cranial physiology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010828">
        <obo:IAO_0000115 xml:lang="cs">Intermitentní klonická nebo tonická kontrakce svalů inervovaných lícním nervem. Mezi kontrakcemi jsou svaly uvolněné</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hemifaciální spasmus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010828"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Intermitentní klonická nebo tonická kontrakce svalů inervovaných lícním nervem. Mezi kontrakcemi jsou svaly uvolněné</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Intermittent clonic or tonic contraction of muscles supplied by facial nerve. Muscles are relaxed in between contractions.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010828"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hemifaciální spasmus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hemifacial spasm</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010829">
        <obo:IAO_0000115 xml:lang="cs">Snížená schopnost vnímat teplotní rozdíly</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Porucha vnímání teploty</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010829"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížená schopnost vnímat teplotní rozdíly</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduced ability to discriminate between different temperatures.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010829"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Porucha vnímání teploty</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired temperature sensation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010830">
        <obo:IAO_0000115 xml:lang="cs">Snížené taktilní čití (hmatový vjem). To se obvykle testuje chlupem bavlny nebo jemným kartáčem z velbloudí srsti tak, že pacient požádá, aby řekl „teď“ pokaždé, když ucítí podnět.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Porucha taktilního čití</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010830"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížené taktilní čití (hmatový vjem). To se obvykle testuje chlupem bavlny nebo jemným kartáčem z velbloudí srsti tak, že pacient požádá, aby řekl „teď“ pokaždé, když ucítí podnět.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduced sense of touch (tactile sensation). This is usually tested with a wisp of cotton or a fine camel&apos;s hair brush, by asking patients to say &apos;now&apos; each time they feel the stimulus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010830"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Porucha taktilního čití</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired tactile sensation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010831">
        <obo:IAO_0000115 xml:lang="cs">Ztráta nebo porucha vnímání relativní polohy částí těla a polohy kloubů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Porucha propriocepce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010831"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Ztráta nebo porucha vnímání relativní polohy částí těla a polohy kloubů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A loss or impairment of the sensation of the relative position of parts of the body and joint position.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010831"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Porucha propriocepce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired proprioception</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010832">
        <obo:IAO_0000115 xml:lang="cs">Bolest je nepříjemný pocit, který může být v rozmezí od mírného lokalizovaného diskomfortu až po agónií, kdy fyzická část bolesti pramení z nervové stimulace a je často doprovázena emocionální složkou. Tento pojem zahrňuje skupinu poruch vnímání bolesti u kterých se předpokládá abnormalita ve specifických nervových vláknech, které přenášejí bolestivé vjemy do mozku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Porucha vnímání bolesti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010832"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Bolest je nepříjemný pocit, který může být v rozmezí od mírného lokalizovaného diskomfortu až po agónií, kdy fyzická část bolesti pramení z nervové stimulace a je často doprovázena emocionální složkou. Tento pojem zahrňuje skupinu poruch vnímání bolesti u kterých se předpokládá abnormalita ve specifických nervových vláknech, které přenášejí bolestivé vjemy do mozku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pain is an unpleasant sensation that can range from mild, localized discomfort to agony, whereby the physical part of pain results from nerve stimulation and is often accompanied by an emotional component. This term groups abnormalities in pain sensation presumed to result from abnormalities related to the specific nerve fibers that carry the pain impulses to the brain.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010832"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Porucha vnímání bolesti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of pain sensation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010833">
        <obo:IAO_0000115 xml:lang="cs">Spontánní bolest je druh neurpatické bolesti která se objevuje bez identifikovatelného spouštěče</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Spontánní pocit bolesti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010833"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Spontánní bolest je druh neurpatické bolesti která se objevuje bez identifikovatelného spouštěče</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Spontaneous pain is a kind of neuropathic pain which occurs without an identifiable trigger.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010833"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Spontánní pocit bolesti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Spontaneous pain sensation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010834">
        <obo:IAO_0000115 xml:lang="cs">Trofické změny jsou označením pro abnormality v oblasti bolesti, které zahrnují především chřadnutí kůže, tkání nebo svalů, řídnutí kostí a změny ve způsobu růstu vlasů nebo nehtů, včetně zahušťování nebo řídnutí vlasů nebo lámavosti nehtů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Trofické změny související s bolestí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010834"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Trofické změny jsou označením pro abnormality v oblasti bolesti, které zahrnují především chřadnutí kůže, tkání nebo svalů, řídnutí kostí a změny ve způsobu růstu vlasů nebo nehtů, včetně zahušťování nebo řídnutí vlasů nebo lámavosti nehtů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Trophic changes is a term used to describe abnormalities in the area of pain that include primarily wasting away of the skin, tissues, or muscle, thinning of the bones, and changes in how the hair or nails grow, including thickening or thinning of hair or brittle nails.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010834"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Trofické změny související s bolestí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Trophic changes related to pain</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010835">
        <obo:IAO_0000115 xml:lang="cs">Vzorec smyslové ztráty se selektivní ztrátou pocitu dotyku a propriocepce bez ztrátypocitu bolesti a teploty nebo naopak</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Disociovaná ztráta smyslů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010835"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vzorec smyslové ztráty se selektivní ztrátou pocitu dotyku a propriocepce bez ztrátypocitu bolesti a teploty nebo naopak</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A pattern of sensory loss with selective loss of touch sensation and proprioception without loss of pain and temperature, or vice-versa.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010835"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Disociovaná ztráta smyslů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dissociated sensory loss</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010836">
