        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Glomerulární proteinurie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Glomerular proteinuria</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000059">
        <obo:IAO_0000115 xml:lang="cs">Strukturální vada spojená s abnormálním vývojem plic</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální vývoj plic</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
