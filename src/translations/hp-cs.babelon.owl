        <rdfs:label xml:lang="cs">Slonovinové epifýzy proximálních falangů na ruce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010274"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Epifýzy proximálních falangů ruky jsou tvrdé a hutné jako slonovina. Taková epifýza má uniformně denzní vzhled na rentgenovém snímku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Epiphyses of the proximal phalanges of the hand are hard and dense like ivory. Such an epiphysis has a uniformly dense appearance on radiographs.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
