        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032188">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená buněčná senzitivita na k mitomycinu C (MMC), alkylačnímu činidlu způsobujícímu zesíťování DNA. V případě této zvýšené senzitiviy MMC zvyšuje buněčnou smrt, chromozomové zlomy a akumulaci v G2 fázi buněčného cyklu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Buněčná přecitlivělost na mitomycin C</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032188"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená buněčná senzitivita na k mitomycinu C (MMC), alkylačnímu činidlu způsobujícímu zesíťování DNA. V případě této zvýšené senzitiviy MMC zvyšuje buněčnou smrt, chromozomové zlomy a akumulaci v G2 fázi buněčného cyklu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An increased cellular sensitivity to the DNA cross-linking agent, mitomycin C (MMC). In the presence of increased sensitivity, MMC causes increased cell death, chromosome breakage, and accumulation in the G2 phase of the cell cycle.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032188"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Buněčná přecitlivělost na mitomycin C</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cellular hypersensitivity to mitomycin C</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032189">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená buněčná senzitivita na diepoxybutan (DEB), činidlo způsobující zesíťování DNA. V případě této zvýšené senzitivity DEB zvyšuje buněčnou smrt, chromozomové zlomy a akumulaci v G2 fázi buněčného cyklu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Buněčná přecitlivělost na diepoxybutane</rdfs:label>
    </rdf:Description>
