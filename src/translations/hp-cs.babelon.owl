    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0410252">
        <obo:IAO_0000115 xml:lang="cs">Neutropenie s absolutním počtem neutrofilů (absolute neutrophil count - ANC) nižším než 1 500 000 000/l trvající déle než 3 měsíce</obo:IAO_0000115>
