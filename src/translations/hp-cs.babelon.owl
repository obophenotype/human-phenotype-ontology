        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Diminished movement</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002375">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně snížená motorická aktivita. Na rozdíl od paralýzy není hypokineze charakterizována nedostatkem motorické síly, ale spíše chudobou pohybu. Typické obvyklé pohyby (např. skládání rukou, křížení nohou) mají sníženou frekvenci.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hypokineze</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002375"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně snížená motorická aktivita. Na rozdíl od paralýzy není hypokineze charakterizována nedostatkem motorické síly, ale spíše chudobou pohybu. Typické obvyklé pohyby (např. skládání rukou, křížení nohou) mají sníženou frekvenci.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormally diminished motor activity. In contrast to paralysis, hypokinesia is not characterized by a lack of motor strength, but rather by a poverty of movement. The typical habitual movements (e.g., folding the arms, crossing the legs) are reduced in frequency.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002375"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hypokineze</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypokinesia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002376">
        <obo:IAO_0000115 xml:lang="cs">Ztráta vývojových dovedností, která se projevuje ztrátou vývojových milníků</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Regres ve vývoji</rdfs:label>
