        <babelon:source_value>Hyporeflexia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001266">
        <obo:IAO_0000115 xml:lang="cs">Neúmyslné pohyby charakterizované atetózou (hyperkinéza s pomalými hadovitými kroutivými pohyby) a choreou (náhodné trhavé pohyby těla, nejvíc na akrech a v obličeji)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Choreoatóza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001266"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neúmyslné pohyby charakterizované atetózou (hyperkinéza s pomalými hadovitými kroutivými pohyby) a choreou (náhodné trhavé pohyby těla, nejvíc na akrech a v obličeji)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Involuntary movements characterized by both athetosis (inability to sustain muscles in a fixed position) and chorea (widespread jerky arrhythmic movements).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
