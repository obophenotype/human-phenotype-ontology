    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032009">
        <obo:IAO_0000115 xml:lang="cs">Trvalá exotropie vyskytující se před 6. měsícem věku; často spojená s velkým úhlem deviace a abnormalitami oka a CNS.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Infantilní konstantní exotropie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
