        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025122">
        <obo:IAO_0000115 xml:lang="cs">Typ epidermální akantózy charakterizovaný pilovitým vzlhedem rete ridges epidermis</obo:IAO_0000115>
