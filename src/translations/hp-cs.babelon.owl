        <owl:annotatedTarget xml:lang="cs">Zúžení průměru koronárních arterií, které je důsledkem akumulace ateromových plátů ve stěně koronárních arterií, což zvyšuje riziko ischémie myokardu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
