        <owl:annotatedTarget xml:lang="cs">Neúmyslné a bezbolestné zpoždění relaxace příčně pruhovaného svalu po kontrakci nebo elektrické stimulaci, která je vyvolaná po vystavení chladu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
