        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the function of the electrical signals with which peripheral nerve cells communicate with each other or with muscles.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
