        <obo:IAO_0000115 xml:lang="cs">Elektrokardiografická anomálie, při níž se segment ST nachází výše než izoelektrická linie.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Elevace ST segmentu</rdfs:label>
