        <obo:IAO_0000115 xml:lang="cs">Chronická ztráta pohyblivosti druhého prstu v důsledku strukturálních změn v nekostních/měkkých tkáních. Termín kamptodaktylie 2. prstu se používá pokud jsou postiženy distální nebo proximální interfalangeální klouby</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Flekční kontraktura 2. prstu na ruce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009537"/>
