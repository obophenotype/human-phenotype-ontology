        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011689"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Supraventrikulární tachykardie s dráhou zprostředkovanou akcesorním spojením, která se nazývá skrytá, protože není vidět na EKG během sinusového rytmu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Supraventricular tachycardia with an accessory connection mediated pathway that is called concealed because it is not seen on the ECG during sinus rhythm.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
