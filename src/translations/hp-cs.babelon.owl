        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031085">
        <obo:IAO_0000115 xml:lang="cs">Snížená koncentrace prealbuminu v krvi. Prealbumin, známý také jako transtyretin, má v plazmě poločas rozpadu přibližně 2 dny, což je mnohem kratší doba než u albuminu. Prealbumin je proto citlivější na změny v energetickém stavu bílkovin než albumin a jeho koncentrace přesně odráží spíše nedávný příjem potravy než celkový stav výživy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená hladina prealbuminu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031085"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížená koncentrace prealbuminu v krvi. Prealbumin, známý také jako transtyretin, má v plazmě poločas rozpadu přibližně 2 dny, což je mnohem kratší doba než u albuminu. Prealbumin je proto citlivější na změny v energetickém stavu bílkovin než albumin a jeho koncentrace přesně odráží spíše nedávný příjem potravy než celkový stav výživy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The concentration of prealbumin in the blood circulation is below the lower limit of normal.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031085"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Snížená hladina prealbuminu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased circulating prealbumin concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031086">
        <obo:IAO_0000115 xml:lang="cs">Nesestouplé nebo mimoděložní vaječníky jsou charakterizovány připojením vrcholu vaječníku k oblasti nad úrovní společných kyčelních cév.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Ektopický vaječník</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031086"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nesestouplé nebo mimoděložní vaječníky jsou charakterizovány připojením vrcholu vaječníku k oblasti nad úrovní společných kyčelních cév.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Undescended or ectopic ovaries are characterized by the attachment of the upper pole of the ovary to an area above the level of the common iliac vessels.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
