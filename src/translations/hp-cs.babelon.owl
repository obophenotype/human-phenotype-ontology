    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033783">
        <obo:IAO_0000115 xml:lang="cs">Molárová incizální malformace (Molar incisor malfomation, MIM) se zkládá z normální korunky zubu se značnou cervikální konstrikcí a tenkými a krátkými kořeny. MIM se vyskytuje u u trvalého i u dočasného chrupu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Molárová incizální malformace</rdfs:label>
    </rdf:Description>
