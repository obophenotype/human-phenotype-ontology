    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005157"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Hypertofická kardiomyopatie vyznačující se symetrickou a koncentrickou hypertrofií</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypertrophic cardiomyopathy with an symmetrical and concentric pattern of hypertrophy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005157"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Koncentrická hypertrofická kardiomyopatie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Concentric hypertrophic cardiomyopathy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005160">
        <obo:IAO_0000115 xml:lang="cs">Celkový anomální plicní žilní návrat označuje vrozenou vadu, při níž se všechny čtyři plicní žíly normálně nepřipojují k levé síni, ale odtékají abnormálně do pravé síně</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Celkový anomální plicní žilní návrat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005160"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Celkový anomální plicní žilní návrat označuje vrozenou vadu, při níž se všechny čtyři plicní žíly normálně nepřipojují k levé síni, ale odtékají abnormálně do pravé síně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Total anomalous pulmonary venous return refers to a congenital malformation in which all four pulmonary veins do not connect normally to the left atrium, but instead drain abnormally to the right atrium.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005160"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Celkový anomální plicní žilní návrat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Total anomalous pulmonary venous return</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005162">
        <obo:IAO_0000115 xml:lang="cs">Neschopnost levé komory plnit svou normální fyziologickou funkci. Selhání je způsobeno buď neschopností kontrakce levé komory, nebo nemožností její úplné relaxace a naplnění krví během diastoly.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dysfunkce levé komory</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005162"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neschopnost levé komory plnit svou normální fyziologickou funkci. Selhání je způsobeno buď neschopností kontrakce levé komory, nebo nemožností její úplné relaxace a naplnění krví během diastoly.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inability of the left ventricle to perform its normal physiologic function. Failure is either due to an inability to contract the left ventricle or the inability to relax completely and fill with blood during diastole.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005162"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Dysfunkce levé komory</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal left ventricular function</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005164">
        <obo:IAO_0000115 xml:lang="cs">Vrozená vada pulmonální chlopně charakterizovaná deformací cípů chlopně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dysplastická pulmonální chlopeň</rdfs:label>
    </rdf:Description>
