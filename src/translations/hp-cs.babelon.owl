        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011689">
        <obo:IAO_0000115 xml:lang="cs">Supraventrikulární tachykardie s dráhou zprostředkovanou akcesorním spojením, která se nazývá skrytá, protože není vidět na EKG během sinusového rytmu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Supraventrikulární tachykardie se skrytým akcesorním spojením</rdfs:label>
    </rdf:Description>
