        <owl:annotatedTarget xml:lang="cs">Distální a proximální příčná palmární rýha (linia occlusitionis digitorum trium ulnarium a linia manus clausae) jsou sloučeny do jediné příčné palmární rýhy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The distal and proximal transverse palmar creases are merged into a single transverse palmar crease.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000954"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Čtyřprstá rýha</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Single transverse palmar crease</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000956">
        <obo:IAO_0000115 xml:lang="cs">Dermatóza charakterizovaná ztluštěním kůže a hyperpigmentovanými plaky, obvykle na intertriginózních površích a na krku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Acanthosis nigricans</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000956"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Dermatóza charakterizovaná ztluštěním kůže a hyperpigmentovanými plaky, obvykle na intertriginózních površích a na krku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A dermatosis characterized by thickened, hyperpigmented plaques, typically on the intertriginous surfaces and neck.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000956"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Acanthosis nigricans</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Acanthosis nigricans</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000957">
        <obo:IAO_0000115 xml:lang="cs">Cafe-au-lait skvrny jsou hyperpigmentované okrsky kůže, které se mohou lišit v barvě od světle hnědé až po tmavě hnědé, s hladkými okraji, mají velikost 1,5 cm nebo více u dospělých a 0,5 cm nebo více u dětí</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Skvrny cafe-au-lait</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000957"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Cafe-au-lait skvrny jsou hyperpigmentované okrsky kůže, které se mohou lišit v barvě od světle hnědé až po tmavě hnědé, s hladkými okraji, mají velikost 1,5 cm nebo více u dospělých a 0,5 cm nebo více u dětí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cafe-au-lait spots are hyperpigmented lesions that can vary in color from light brown to dark brown with smooth borders and having a size of 1.5 cm or more in adults and 0.5 cm or more in children.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000957"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Skvrny cafe-au-lait</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cafe-au-lait spot</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000958">
        <obo:IAO_0000115 xml:lang="cs">Kůže charakterizovaná nedostatkem přirozené nebo normální vlhkosti</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Suchá kůže</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000958"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kůže charakterizovaná nedostatkem přirozené nebo normální vlhkosti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Skin characterized by the lack of natural or normal moisture.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000958"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Suchá kůže</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dry skin</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000960">
        <obo:IAO_0000115 xml:lang="cs">Kožní důlek vzniklý přilnutím kůže k podkladovým strukturám (kostem) v intergluteální rýze</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Sacral dimple</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000960"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kožní důlek vzniklý přilnutím kůže k podkladovým strukturám (kostem) v intergluteální rýze</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cutaneous indentation resulting from tethering of the skin to underlying structures (bone) of the intergluteal cleft.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000960"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Sacral dimple</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sacral dimple</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000961">
        <obo:IAO_0000115 xml:lang="cs">Namodralé zabarvení kůže a sliznici v důsledku špatné cirkulace nebo nedostatečného okysličení arteriální nebo kapilární krve</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Cyanóza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000961"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Namodralé zabarvení kůže a sliznici v důsledku špatné cirkulace nebo nedostatečného okysličení arteriální nebo kapilární krve</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bluish discoloration of the skin and mucosa due to poor circulation or inadequate oxygenation of arterial or capillary blood.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000961"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Cyanóza</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cyanosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000962">
        <obo:IAO_0000115 xml:lang="cs">Hyperkeratóza je ztluštění vnější vrstvy kůže, stratum corneum, které se skládá z velké, mrtvých keratinocytů vyplněných keratinem, které sem migrovaly ze stratum granulosum kůže</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hyperkeratóza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000962"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Hyperkeratóza je ztluštění vnější vrstvy kůže, stratum corneum, které se skládá z velké, mrtvých keratinocytů vyplněných keratinem, které sem migrovaly ze stratum granulosum kůže</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hyperkeratosis is a histopathological term defining a thickened stratum corneum and may be present in many different skin conditions, with many possible overlaps. Hyperkeratosis refers to the increased thickness of the stratum corneum, the outer layer of the skin. Hyperkeratosis is subclassified as orthokeratotic or parakeratotic. Orthokeratotic hyperkeratosis refers to the thickening of the keratin layer with preserved keratinocyte maturation, while parakeratotic hyperkeratosis shows retained nuclei as a sign of delayed maturation of keratinocytes.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000962"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hyperkeratóza</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hyperkeratosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000963">
        <obo:IAO_0000115 xml:lang="cs">Snížení tloušťky kůže, obecně spojené se ztrátou ohebnosti a pružnosti kůže</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Tenká kůže</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000963"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížení tloušťky kůže, obecně spojené se ztrátou ohebnosti a pružnosti kůže</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduction in thickness of the skin, generally associated with a loss of suppleness and elasticity of the skin.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000963"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Tenká kůže</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Thin skin</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000964">
        <obo:IAO_0000115 xml:lang="cs">Ekzém je formou dermatitidy. Termín ekzém je široce aplikován na celou řadu perzistentních kožních nemocí a může být způsoben řadou mechanismů. Projevy ekzému mohou zahrnovat suchost a opakující se kožní vyrážky se zarudnutím, edém kůže, svědění a suchost kůže, krusty, olupování, puchýřkování, praskání, mokvání nebo krvácení</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Ekzém</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000964"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Ekzém je formou dermatitidy. Termín ekzém je široce aplikován na celou řadu perzistentních kožních nemocí a může být způsoben řadou mechanismů. Projevy ekzému mohou zahrnovat suchost a opakující se kožní vyrážky se zarudnutím, edém kůže, svědění a suchost kůže, krusty, olupování, puchýřkování, praskání, mokvání nebo krvácení</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Eczema is a form of dermatitis that is characterized by scaly, pruritic, erythematous lesions located on flexural surfaces.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000964"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Ekzém</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Eczematoid dermatitis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000965">
        <obo:IAO_0000115 xml:lang="cs">Retikulární diskolorace kůže s cyanotickými (vypadajícími červeně-modře) oblastemi obklopujícímí bledé centrální oblasti, způsobená dilatací kapilár a stagnací krvi v cévách. Cutis marmorata, taktéž zvaná livedo reticularis, obvykle postihuje dolní končetiny, a má tendenci se horšit ve studené vodě</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Cutis marmorata</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000965"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Retikulární diskolorace kůže s cyanotickými (vypadajícími červeně-modře) oblastemi obklopujícímí bledé centrální oblasti, způsobená dilatací kapilár a stagnací krvi v cévách. Cutis marmorata, taktéž zvaná livedo reticularis, obvykle postihuje dolní končetiny, a má tendenci se horšit ve studené vodě</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reticular discoloration of the skin with cyanotic (reddish-blue appearing) areas surrounding pale central areas due to dilation of capillary blood vessels and stagnation of blood within the vessels. Cutis marmorata generally occurs on the legs, arms and trunk and is often more severe in cold weather.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000965"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Cutis marmorata</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cutis marmorata</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000966">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně zmenšená schopnost potit se</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hypohidróza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000966"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormálně zmenšená schopnost potit se</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormally diminished capacity to sweat.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000966"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hypohidróza</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypohidrosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000967">
        <obo:IAO_0000115 xml:lang="cs">Petechie jsou drobné červené či fialové tečky, podobají se vyrážce, která se objevují těsně pod kůží nebo sliznicí, když se kapiláry roztrhnou a dojde k drobnému povrchovému krvácení. Tento termín se vztahuje k abnormálně zvýšené citlivosti na rozvoj petechií</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Petechie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000967"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Petechie jsou drobné červené či fialové tečky, podobají se vyrážce, která se objevují těsně pod kůží nebo sliznicí, když se kapiláry roztrhnou a dojde k drobnému povrchovému krvácení. Tento termín se vztahuje k abnormálně zvýšené citlivosti na rozvoj petechií</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Petechiae are pinpoint-sized reddish/purple spots, resembling a rash, that appear just under the skin or a mucous membrane when capillaries have ruptured and some superficial bleeding into the skin has happened. This term refers to an abnormally increased susceptibility to developing petechiae.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000967"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Petechie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Petechiae</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000968">
        <obo:IAO_0000115 xml:lang="cs">Ektodermální dysplazie je skupina nemocí s abnormálním vývojem kůže, vlasů, nehtů, zubů nebo potních žláz</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Ektodermální dysplazie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000968"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Ektodermální dysplazie je skupina nemocí s abnormálním vývojem kůže, vlasů, nehtů, zubů nebo potních žláz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ectodermal dysplasia is a group of conditions in which there is abnormal development of the skin, hair, nails, teeth, or sweat glands.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
