        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030751"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Intraventrikulární krvácení, které se vyskytuje u předčasně narozeného dítěte a které vykazuje rozšíření parenchymu</owl:annotatedTarget>
