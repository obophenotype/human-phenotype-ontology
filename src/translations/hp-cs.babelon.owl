        <owl:annotatedTarget xml:lang="cs">Skleróza epifýzy proximálního falangu 3. prstu na ruce, vedoucí k zvýšené radioopacitě (bílý nebo slonovinový vzhled) na rentgenovém snímku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
