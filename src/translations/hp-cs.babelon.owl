    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020223">
        <obo:IAO_0000115 xml:lang="cs">Dermální sinus je vrozená hřbetní střední linií, kde se abnormální epitelizované spojení z kůže táhne směrem dovnitř k páteři, nejčastěji se vyskytuje v lumbosakrální oblasti.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dermální sinus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020223"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Dermální sinus je vrozená hřbetní střední linií, kde se abnormální epitelizované spojení z kůže táhne směrem dovnitř k páteři, nejčastěji se vyskytuje v lumbosakrální oblasti.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A dermal sinus tract is an abnormality present at birth over the dorsal midline where an abnormal epithelialized connection from the skin tracks inwards towards the spine, most commonly seen in the lumbosacral region.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020223"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Dermální sinus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dermal sinus tract</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025004">
        <obo:IAO_0000115 xml:lang="cs">Osteoartritída metakarpofalangeálního kloubu palce na noze</obo:IAO_0000115>
