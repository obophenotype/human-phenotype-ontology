        <owl:annotatedTarget xml:lang="cs">Typ bolesti hlavy charakterizovaný opakovanými záchvaty jednostranné bolesti trvajícími 15 až 180 minut a spojenými s místními autonomními příznaky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of headache characterized by repeated attacks of unilateral pain lasting 15 to 180 minutes and associated with local autonomic signs.</babelon:source_value>
