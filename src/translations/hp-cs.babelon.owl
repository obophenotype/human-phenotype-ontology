        <owl:annotatedTarget xml:lang="cs">Sekundární hyperparatyreóza značí produkci vyšších než normálních hladin parathormonu v přítomnosti hypokalcémie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
