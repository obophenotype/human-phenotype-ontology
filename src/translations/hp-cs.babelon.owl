        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vadná struktura, velikost nebo obsah denzních granul, destičkových organel, které obsahují proagregační faktory, jako je adenosindifosfát (ADP), adenosintrifosfát (ATP), ionizovaný vápník, histamin a serotonin.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Defective structure, size or content of dense granules, platelet organelles that contain granules proaggregatory factors such as adenosine diphosphate (ADP), adenosine triphosphate (ATP), ionized calcium, histamine and serotonin.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
