    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010717">
        <obo:IAO_0000115 xml:lang="cs">&quot;Srůst nebo fůze prstů na noze, zahrňující měkké části a srůst jednotlivých kostí prstů. Kostený srůst odkazuje na &quot;&quot;kostěnou&quot;&quot; syndaktylii pokud srůst nastane v tibio-fibulární ose. V případě srůstu kostí prstů v proximo - distální ose se používá termín &quot;&quot;symfalangismus&quot;&quot;&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kostní syndaktylie prstů nohy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010717"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">&quot;Srůst nebo fůze prstů na noze, zahrňující měkké části a srůst jednotlivých kostí prstů. Kostený srůst odkazuje na &quot;&quot;kostěnou&quot;&quot; syndaktylii pokud srůst nastane v tibio-fibulární ose. V případě srůstu kostí prstů v proximo - distální ose se používá termín &quot;&quot;symfalangismus&quot;&quot;&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>&quot;Webbing or fusion of the toes, involving soft parts and including fusion of individual bones of the toes. Bony fusions are referred to as &quot;&quot;bony&quot;&quot; Syndactyly if the fusion occurs in a tibial-fibular axis. Fusions of bones of the toes in a proximo-distal axis are referred to as &quot;&quot;Symphalangism&quot;&quot;.&quot;</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010717"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kostní syndaktylie prstů nohy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Osseous syndactyly of toes</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
