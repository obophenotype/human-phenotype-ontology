        <rdfs:label xml:lang="cs">Aneuryzma koronární tepny</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030882"/>
