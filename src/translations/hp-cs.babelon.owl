    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0040227">
        <obo:IAO_0000115 xml:lang="cs">Snížení těchto hladin má za výsledek zvýšení inhibice fibrinolýzy a snížení inhibice koagulace.</obo:IAO_0000115>
