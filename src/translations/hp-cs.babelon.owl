    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034439">
        <obo:IAO_0000115 xml:lang="cs">Týká se abnormality, která se nachází v klenuté střední části chodidla před hlezenním kloubem (tj. v nártu).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Umístění na nártu</rdfs:label>
    </rdf:Description>
