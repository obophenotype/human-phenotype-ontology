    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033073">
        <obo:IAO_0000115 xml:lang="cs">Intradermální depozita urátových krystalů se jeví jako malé, povrchové, pustulovité, bělavé léze. Léze mohou být ohniskem zánětlivých epizod se zvyšující se bolestí, otokem a erytémem intradermálního tofu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Urátový tofus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
