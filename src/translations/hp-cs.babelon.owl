    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000232">
        <obo:IAO_0000115 xml:lang="cs">Abnormální konfigurace spodního rtu ve smyslu evertace rtu ven, retní červeň normálně nacházející se v ústní dutině je viditelná z forntálního pohledu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Evertovaný horní ret</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000232"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální konfigurace spodního rtu ve smyslu evertace rtu ven, retní červeň normálně nacházející se v ústní dutině je viditelná z forntálního pohledu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal configuration of the lower lip such that it is turned outward i.e., everted, with the Inner aspect of the lower lip vermilion (normally opposing the teeth) being visible in a frontal view.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
