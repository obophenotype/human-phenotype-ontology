        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100297">
        <obo:IAO_0000115 xml:lang="cs">Zvětšený objem endomysia, což je vazivové pouzdro, které obklopuje každé svalové vlákno. Svazky svalových vláken tvoří dohromady fascikuly, které jsou obklopeny další vrstvou pojivové tkáně nazývanou perimysium</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšené množství endomysiální pojivové tkáně</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100297"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvětšený objem endomysia, což je vazivové pouzdro, které obklopuje každé svalové vlákno. Svazky svalových vláken tvoří dohromady fascikuly, které jsou obklopeny další vrstvou pojivové tkáně nazývanou perimysium</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An increased volume of the endomysium, which is a connective tissue sheath that surrounds each muscle fiber. Together, bundles of muscle fibers form a fasciculus, surrounded by another layer of connective tissue called the perimysium.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100297"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšené množství endomysiální pojivové tkáně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased endomysial connective tissue</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
