        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nerovnoměrné a nepravidelné pigmentace kůže</owl:annotatedTarget>
