        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>obsolete Peritoneal effusion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030996">
        <obo:IAO_0000115 xml:lang="cs">Dilatace a prodloužení dvanáctníku s hypertrofií všech vrstev dvanáctníku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Megaduodenum</rdfs:label>
