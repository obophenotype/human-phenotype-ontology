    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005110">
        <obo:IAO_0000115 xml:lang="cs">Síňová arytmie charakterizovaná neorganizovanou aktivitou síní bez diskrétních vln P na povrchovém EKG, ale s vlnící se základní linií nebo ostřeji ohraničenými výchylkami síní s různou amplitudou a frekvencí od 350 do 600 za minutu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fibrilace síní</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005110"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Síňová arytmie charakterizovaná neorganizovanou aktivitou síní bez diskrétních vln P na povrchovém EKG, ale s vlnící se základní linií nebo ostřeji ohraničenými výchylkami síní s různou amplitudou a frekvencí od 350 do 600 za minutu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An atrial arrhythmia characterized by disorganized atrial activity without discrete P waves on the surface EKG, but instead by an undulating baseline or more sharply circumscribed atrial deflections of varying amplitude an frequency ranging from 350 to 600 per minute.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
