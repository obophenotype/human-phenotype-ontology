    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032044">
        <obo:IAO_0000115 xml:lang="cs">Snížení schopnosti udržet trvalou pozornost charakterizované sníženou bdělostí.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená ostražitost</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032044"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížení schopnosti udržet trvalou pozornost charakterizované sníženou bdělostí.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A decrease in the ability to maintain sustained attention is characterized by reduced alertness.</babelon:source_value>
