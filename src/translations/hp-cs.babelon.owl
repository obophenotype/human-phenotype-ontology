        <babelon:source_value>Diffuse subcortical band heterotopia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032414">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost zvýšeného množství 5-hydroxylysinu v moči. Tato sloučenina je hydroxylovaný derivát aminokyseliny lysinu, který je přítomen v některých kolagenech.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hydroxylysinurie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032414"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost zvýšeného množství 5-hydroxylysinu v moči. Tato sloučenina je hydroxylovaný derivát aminokyseliny lysinu, který je přítomen v některých kolagenech.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of an elevated amount of 5-hydroxylysine in the urine. This compound is a hydroxylated derivative of the amino acid lysine that is present in certain collagens.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
