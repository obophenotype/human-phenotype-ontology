        <rdfs:label xml:lang="cs">Fallotova tetralogie s defektem atrioventrikulárního kanálu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011677"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fallotova tetralogie s defektem atrioventrikulárního kanálu</owl:annotatedTarget>
