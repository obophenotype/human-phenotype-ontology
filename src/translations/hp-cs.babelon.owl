    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000563">
        <obo:IAO_0000115 xml:lang="cs">Kónická deformita rohovky charakterizovaná přítomností vyklenutí rohovky a deformaci jejího tvaru vedoucí k poruše zraku</obo:IAO_0000115>
