        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pancreatic endocrine tumor</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030406">
        <obo:IAO_0000115 xml:lang="cs">Typ karcinomu, který vzniká v peritoneu. Je ho potřeba odlišit od metastatického karcinomu pobřišnice. Peritoneální karcinom se může objevit kdekoliv v břišní dutině a má dopad na povrch orgánů, které peritoneum pokrývá</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Primární peritoneální karcinom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030406"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ karcinomu, který vzniká v peritoneu. Je ho potřeba odlišit od metastatického karcinomu pobřišnice. Peritoneální karcinom se může objevit kdekoliv v břišní dutině a má dopad na povrch orgánů, které peritoneum pokrývá</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of cancer that originates in the peritoneum. It is to be distinguished from metastatic cancer of the peritoneum. Peritoneal cancer can occur anywhere in the abdominal space, and affects the surface of organs contained inside the peritoneum.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030406"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Primární peritoneální karcinom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Primary peritoneal carcinoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030407">
        <obo:IAO_0000115 xml:lang="cs">Typ novotvaru pinaeálních parenchymových buněk, který je zralým, dobře diferencovaným nádorem (WHO grade 1)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pineocytom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030407"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ novotvaru pinaeálních parenchymových buněk, který je zralým, dobře diferencovaným nádorem (WHO grade 1)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of pineal parenchymal cell neoplasm that is a mature well-differentiated tumor (WHO grade I).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030407"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Pineocytom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pineocytoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030408">
        <obo:IAO_0000115 xml:lang="cs">Pineoblastom je vzácný primitivní neuroektodermální nádor (PNET) vznikající v epifýze, šišince. Pineoblastomy jsou klasifikovány jako tumor stupně IV podle WHO a zahrnují jednu čtvrtinu až polovinu tumorů epifýzového parenchymu. Pineoblastom je vysoce buněčný nádor pocházející z epifýzy a obsahující malé, špatně diferencované buňky</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pinealoblastom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030408"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Pineoblastom je vzácný primitivní neuroektodermální nádor (PNET) vznikající v epifýze, šišince. Pineoblastomy jsou klasifikovány jako tumor stupně IV podle WHO a zahrnují jednu čtvrtinu až polovinu tumorů epifýzového parenchymu. Pineoblastom je vysoce buněčný nádor pocházející z epifýzy a obsahující malé, špatně diferencované buňky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pineoblastoma is a rare primitive neuroectodermal tumor (PNET) arising in the pineal gland. Pineoblastomas are classified as a WHO grade IV tumor and comprise one-fourth to one-half of pineal parenchymal tumors. Pineoblastoma is a highly cellular tumor originating in the pineal gland and containing small, poorly differentiated cells.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030408"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Pinealoblastom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pineoblastoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030409">
        <obo:IAO_0000115 xml:lang="cs">Maligní tumor původem z přechodných buněk (urotel, nebo i močový epitel), buněk výstelky močových cest od renálních kalichů až k horní části močové trubice</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Uroteliální karcinom ledviny</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030409"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Maligní tumor původem z přechodných buněk (urotel, nebo i močový epitel), buněk výstelky močových cest od renálních kalichů až k horní části močové trubice</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A malignant tumor that arises from the transitional (urothelial) epithelial cells lining the urinary tract from the renal calyces to the ureteral orifice.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030409"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Uroteliální karcinom ledviny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Renal transitional cell carcinoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030410">
        <obo:IAO_0000115 xml:lang="cs">Karcinom, který vzniká v mazové žláze (exokrinní žláza kůže, která vylučuje maz, voskovou látku)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Karcinom mazových žláz</rdfs:label>
