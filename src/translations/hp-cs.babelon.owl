        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A carcinoma that arises in a sebaseous gland (an exocrine gland of the skin that secretes sebum, a waxy substance)</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030410"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Karcinom mazových žláz</owl:annotatedTarget>
