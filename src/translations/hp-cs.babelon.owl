        <owl:annotatedTarget xml:lang="cs">Popis stavů, kdy ne všichni jedinci s daným genotypem vykazují dané onemocnění. Penetrance je podíl osob, u nichž se onemocnění vyvine při délce života 80 let.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Description of conditions in which not all individuals with a given genotype exhibit the disease. Penetrance is the proportion that develop disease given a lifespan of 80 years.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
