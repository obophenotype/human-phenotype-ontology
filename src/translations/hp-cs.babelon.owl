        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030762">
        <obo:IAO_0000115 xml:lang="cs">Částečné nebo úplné rozpuštění mezangiální matrix, které se pozná podle sníženého zbarvení v PAS (Periodic Acid Schiff) nebo v barvení stříbrem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mesangiolýza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030762"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Částečné nebo úplné rozpuštění mezangiální matrix, které se pozná podle sníženého zbarvení v PAS (Periodic Acid Schiff) nebo v barvení stříbrem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Partial or complete dissolution of the mesangial matrix, identified by reduced staining on a periodic acid-Schiff (PAS) or silver stain.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
