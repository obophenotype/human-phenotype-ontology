    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001140">
        <obo:IAO_0000115 xml:lang="cs">Benigní nádor nacházející se na pomezí rohovky a skléry</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Limbální dermoid</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001140"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Benigní nádor nacházející se na pomezí rohovky a skléry</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A benign tumor typically found at the junction of the cornea and sclera (limbal epibullar dermoid).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001140"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Limbální dermoid</owl:annotatedTarget>
