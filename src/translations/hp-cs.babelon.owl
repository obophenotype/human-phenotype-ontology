    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009548">
        <obo:IAO_0000115 xml:lang="cs">Druhý prst na ruce s krátkou a širokou falangou, která se distálně zužuje. Projektilové falangy postrádají normální diafyzární zúžení.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Falangy 2. prstu na ruce ve tvaru projektilu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009548"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Druhý prst na ruce s krátkou a širokou falangou, která se distálně zužuje. Projektilové falangy postrádají normální diafyzární zúžení.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A second finger with short and wide phalanx that tapers distally. Bullet-shaped phalanges lack the normal diaphyseal constriction.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
