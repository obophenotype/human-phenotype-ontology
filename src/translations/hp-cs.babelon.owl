    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001788">
        <obo:IAO_0000115 xml:lang="cs">Předčasné protržení plodových obalů (PROM) je stav, který nastává v těhotenství, kdy plodový obal praskne více než hodinu před začátkem porodu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Předčasné prasknutí membrán</rdfs:label>
    </rdf:Description>
