    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034432">
        <obo:IAO_0000115 xml:lang="cs">Vztahuje se na lokalizaci kožní léze zahrnující jakoukoli oblast těla, kde se dva protilehlé povrchy kůže mohou dotýkat a třít nebo dráždit.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Intertriginózní distribuce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034432"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vztahuje se na lokalizaci kožní léze zahrnující jakoukoli oblast těla, kde se dva protilehlé povrchy kůže mohou dotýkat a třít nebo dráždit.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Applies to the localization of a skin lesion involving any area of the body where two opposing skin surfaces can touch and rub or chaff.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034432"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Intertriginózní distribuce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Intertriginous distribution</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034433">
        <obo:IAO_0000115 xml:lang="cs">Vztahuje se na lokalizaci kožních lézí, které odpovídají liniím napětí kůže, což jsou lineární štěrbiny v kůži, které udávají směr orientace kolagenových vláken. Linie kožního napětí jsou také známé jako Langerovy linie nebo linie štěpení.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Rozložení podél linií napětí kůže</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034433"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vztahuje se na lokalizaci kožních lézí, které odpovídají liniím napětí kůže, což jsou lineární štěrbiny v kůži, které udávají směr orientace kolagenových vláken. Linie kožního napětí jsou také známé jako Langerovy linie nebo linie štěpení.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Applies to the localization of a skin lesion that correspond to skin tension lines, which are linear clefts in the skin that indicate the direction of orientation of the underlying collagen fibers. Skin tension lines are also known as Langer&apos;s lines or lines of cleavage.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034433"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Rozložení podél linií napětí kůže</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Distributed along skin tension lines</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034434">
        <obo:IAO_0000115 xml:lang="cs">Jakékoli abnormální chování související s komunikací</obo:IAO_0000115>
