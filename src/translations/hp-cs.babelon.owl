    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009546">
        <obo:IAO_0000115 xml:lang="cs">Falangy 2. prstu na ruce trojúhelníkového tvaru. Trojúhelníková nebo takzvaná deltová falanga vzniká důsledkem epifýzy ve tvaru písmena C postižené falangy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Trojúhelníkové falangy 2. prstu na ruce</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009546"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Falangy 2. prstu na ruce trojúhelníkového tvaru. Trojúhelníková nebo takzvaná deltová falanga vzniká důsledkem epifýzy ve tvaru písmena C postižené falangy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Triangular shaped phalanges of the 2nd finger. A triangular or so called delta shaped phalanx is a typical result after a bracket epiphysis of the affected phalanx.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
