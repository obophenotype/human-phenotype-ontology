        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pancreatic abscess</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025080">
        <obo:IAO_0000115 xml:lang="cs">Forma hyperkeratózy charakterizovaná ztluštěním zrohovatělé vrstvy bez zachovaných jader.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Ortokeratotická hyperkeratóza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025080"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Forma hyperkeratózy charakterizovaná ztluštěním zrohovatělé vrstvy bez zachovaných jader.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of hyperkeratosis characterized by thickening of the cornified layer without retained nuclei.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025080"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Ortokeratotická hyperkeratóza</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Orthokeratotic hyperkeratosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025081">
        <obo:IAO_0000115 xml:lang="cs">Změna kůže vyvolaná rychlým třením kožní léze u urticaria pigmentosa (UP), přičemž oblast začíná svědit, je vyvýšená a obklopena erytémem. Na rozdíl od jiných forem dermatografismu označuje Darierův znak kopřivku, která je omezena na oblasti postižené UP, a jako v tomto případě nepostihuje kůži mimo UP.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Darierovo znamení</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025081"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Změna kůže vyvolaná rychlým třením kožní léze u urticaria pigmentosa (UP), přičemž oblast začíná svědit, je vyvýšená a obklopena erytémem. Na rozdíl od jiných forem dermatografismu označuje Darierův znak kopřivku, která je omezena na oblasti postižené UP, a jako v tomto případě nepostihuje kůži mimo UP.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A skin change elicited by briskly rubbing the skin lesion in urticaria pigmentosa (UP), whereby the area begins to itch and becomes raised and surrounded by erythema. Unlike other forms of dermatographism, Darier&apos;s sign refers to urtication that is limited to the UP involved areas and, as in this case, spares the skin unaffected by UP.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025081"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Darierovo znamení</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Darier&apos;s sign</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025082">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli strukturní anomálie elastických vláken kůže. Elastická vlákna jsou základní makromolekuly extracelulární matrix, které se skládají z elastinového jádra obklopeného pláštěm z mikrofibril bohatých na fibrilin.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie kožních elastických vláken</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025082"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoli strukturní anomálie elastických vláken kůže. Elastická vlákna jsou základní makromolekuly extracelulární matrix, které se skládají z elastinového jádra obklopeného pláštěm z mikrofibril bohatých na fibrilin.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any structural anomaly of the elastic fibers of the skin. Elastic fibers are the essential extracellular matrix macromolecules comprising an elastin core surrounded by a mantle of fibrillin-rich microfibrils.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025082"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální morfologie kožních elastických vláken</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal cutaneous elastic fiber morphology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025083">
        <obo:IAO_0000115 xml:lang="cs">Zvýšené množství desmosinu v kůži. Desmosin je síťující aminokyselina, která vzniká z lysylových zbytků v elastinu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšený obsah dermálního desmosinu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025083"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšené množství desmosinu v kůži. Desmosin je síťující aminokyselina, která vzniká z lysylových zbytků v elastinu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An increased amount of desmosine measure in the skin. Desmosine is a cross-linking amino acid formed from lysyl residues in elastin.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025083"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšený obsah dermálního desmosinu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elevated dermal desmosine content</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
