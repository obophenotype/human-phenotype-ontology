    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011678">
        <obo:IAO_0000115 xml:lang="cs">Typ Fallotovy tetralogie s plicní atrézií, u kterého je veškerý plicní krevní průtok přiváděn z hlavních aortopulmonálních kolaterálních tepen</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fallotova tetralogie s pulmonální atrézií a významnými aortopulmonálními kolaterálami</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011678"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ Fallotovy tetralogie s plicní atrézií, u kterého je veškerý plicní krevní průtok přiváděn z hlavních aortopulmonálních kolaterálních tepen</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of tetralogy of Fallot with pulmonary atresia in which all pulmonary blood flow is derived from major aortopulmonary collateral arteries (MAPCA).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011678"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fallotova tetralogie s pulmonální atrézií a významnými aortopulmonálními kolaterálami</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tetralogy of Fallot with pulmonary atresia and major aortopulmonary collateral arteries</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011679">
        <obo:IAO_0000115 xml:lang="cs">Nejčastější forma Fallotovy tetralogie charakterizovaná plicní stenózou, přesahující aortou, defektem komorového septa a hypertrofií pravé komory, bez plicní atrézie, chybějící plicní chlopně, defektu atrioventrikulárního kanálu nebo chybějícího subarteriálního konusu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fallotova tetralogie s plicní stenózou</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011679"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nejčastější forma Fallotovy tetralogie charakterizovaná plicní stenózou, přesahující aortou, defektem komorového septa a hypertrofií pravé komory, bez plicní atrézie, chybějící plicní chlopně, defektu atrioventrikulárního kanálu nebo chybějícího subarteriálního konusu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The commonest form of tetralogy of Fallot characterized by pulmonary stenosis, overriding aorta, ventricular septum defect, and right ventricular hypertrophy, without pulmonary atresia, absent pulmonary valve, atrioventricular canal defect or absent subarterial conus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011679"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fallotova tetralogie s plicní stenózou</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tetralogy of Fallot with pulmonary stenosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
