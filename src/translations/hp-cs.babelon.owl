    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011819">
        <obo:IAO_0000115 xml:lang="cs">Rozštěp svalové (měkké) části patra, která je kryta sliznicí. Submukózní rozštěpy měkkého patra se vyznačují nedostatek nebo chyběním svalové tkáně v mediální části patra</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Submukózní rozštěp měkkého patra</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011819"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Rozštěp svalové (měkké) části patra, která je kryta sliznicí. Submukózní rozštěpy měkkého patra se vyznačují nedostatek nebo chyběním svalové tkáně v mediální části patra</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cleft of the muscular (soft) portion of the palate that is covered by mucous membrane. Soft-palate submucous clefts are characterized by a midline deficiency or lack of muscle tissue.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
