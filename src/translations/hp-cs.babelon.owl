        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Stahl ear</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100016">
        <obo:IAO_0000115 xml:lang="cs">Mezenterium je duplikatura peritonea, závěs, ve kterém jsou zavzaty břišní orgány. Peritoneum, stejně jako pleura a perikard jsou vystlány mezotelem. Podle toho, který dutý orgán je v něm zavěšen, ho lze dále rozdělit na mezogastrium, mezenterium, mezoappendix a mezocolon</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormalita morfologie mesenteria</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100016"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Mezenterium je duplikatura peritonea, závěs, ve kterém jsou zavzaty břišní orgány. Peritoneum, stejně jako pleura a perikard jsou vystlány mezotelem. Podle toho, který dutý orgán je v něm zavěšen, ho lze dále rozdělit na mezogastrium, mezenterium, mezoappendix a mezocolon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Folds of membranous tissue (peritoneum, mesothelium) attached to the wall of the abdomen and enclosing viscera. Examples include the mesentery for the small intestine; the transverse mesocolon, which attaches the transverse portion of the colon to the back wall of the abdomen; and the mesosigmoid, which enfolds the sigmoid portion of the colon. Cells of the same embryologic origin also surround the other organs of the body such as the lungs (pleura) or the heart (pericardium).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100016"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita morfologie mesenteria</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal mesentery morphology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100017">
        <obo:IAO_0000115 xml:lang="cs">Katarakta, která postihuje kapsulu čočky</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kapsulární katarakta</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100017"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Katarakta, která postihuje kapsulu čočky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cataract that affects the capsule of the lens.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100017"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kapsulární katarakta</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Capsular cataract</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100018">
        <obo:IAO_0000115 xml:lang="cs">Nukleární katarakta je opacita nebo zákal jádra čočky a je lokalizován v centru čočky. Charakter jádra se mění z čirého na žluté nebo hnědé</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nuklerání katarakta</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100018"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Nukleární katarakta je opacita nebo zákal jádra čočky a je lokalizován v centru čočky. Charakter jádra se mění z čirého na žluté nebo hnědé</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A nuclear cataract is an opacity or clouding that develops in the lens nucleus. That is, a nuclear cataract is one that is located in the center of the lens. The nucleus tends to darken changing from clear to yellow and sometimes brown.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100018"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nuklerání katarakta</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nuclear cataract</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100019">
        <obo:IAO_0000115 xml:lang="cs">Katarakta, která postihuje vrstvu čočky kolem jádra, tj. kortex čočky. Je charakterizována klínovitými opacitami</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kortikální katarakta</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100019"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Katarakta, která postihuje vrstvu čočky kolem jádra, tj. kortex čočky. Je charakterizována klínovitými opacitami</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cataract which affects the layer of the lens surrounding the nucleus, i.e., the lens cortex. It is identified by its unique wedge or spoke appearance.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100019"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kortikální katarakta</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cortical cataract</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100020">
        <obo:IAO_0000115 xml:lang="cs">Katarakta, která postihuje zadní část kapsuly čočky. Tento typ se často vyvíjí rychle</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zadní kapsulární katarakta</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100020"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Katarakta, která postihuje zadní část kapsuly čočky. Tento typ se často vyvíjí rychle</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cataract which is found in the back outer layer of the lens. This type often develops more rapidly.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100020"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zadní kapsulární katarakta</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Posterior capsular cataract</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100021">
        <obo:IAO_0000115 xml:lang="cs">Pojem mozková obrna označuje skupinu trvalých poruch vývoje motoriky a držení těla, které vede k omezení aktivity. Tyto poruchy jsou neprogresivní a jsou důsledkem inzultu poškozujícího vývoj mozku plodu nebo kojence. Motorické poruchy při mozkové obrně jsou často provázeny poruchami smyslů, percepce, kognice, komunikace, chování a epilepsií a sekundárními muskuloskeletálními problémy</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mozková obrna</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100021"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Pojem mozková obrna označuje skupinu trvalých poruch vývoje motoriky a držení těla, které vede k omezení aktivity. Tyto poruchy jsou neprogresivní a jsou důsledkem inzultu poškozujícího vývoj mozku plodu nebo kojence. Motorické poruchy při mozkové obrně jsou často provázeny poruchami smyslů, percepce, kognice, komunikace, chování a epilepsií a sekundárními muskuloskeletálními problémy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cerebral palsy describes a group of permanent disorders of the development of movement and posture, causing activity limitation, that are attributed to nonprogressive disturbances that occurred in the developing fetal or infant brain. The motor disorders of cerebral palsy are often accompanied by disturbances of sensation, perception, cognition, communication, and behavior, by epilepsy, and by secondary musculoskeletal problems.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100021"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mozková obrna</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cerebral palsy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100022">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita pohybu s neurologickým základem charakterizovaná změnami koordinace a rychlosti cíleného pohybu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormalita pohybu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100022"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita pohybu s neurologickým základem charakterizovaná změnami koordinace a rychlosti cíleného pohybu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of movement with a neurological basis characterized by changes in coordination and speed of voluntary movements.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100022"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita pohybu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of movement</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100023">
        <obo:IAO_0000115 xml:lang="cs">Typ stereotypního chování, při němž postižený jedinec opakovaně mává rukama</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Opakované mávání rukama</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100023"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ stereotypního chování, při němž postižený jedinec opakovaně mává rukama</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of repetitive behavior in which the affected individual repeatedly waves the hands and/or arms rhythmically.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100023"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Opakované mávání rukama</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Recurrent hand flapping</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100024">
        <obo:IAO_0000115 xml:lang="cs">Neobvykle pozitivní ladění i v situacích, které za normálních okolností pozitivní ladění neevokují a které by měly být příčinou například strachu, nebo hněvu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Viditelně pozitivní ladění</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100024"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neobvykle pozitivní ladění i v situacích, které za normálních okolností pozitivní ladění neevokují a které by měly být příčinou například strachu, nebo hněvu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An unusually happy demeanor over time, which can also be observed during inappropriate situations that should, for example, cause distress, fear, or anger.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100024"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Viditelně pozitivní ladění</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Conspicuously happy disposition</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100025">
        <obo:IAO_0000115 xml:lang="cs">Forma neadekvátně zvýšené sociability zahrnující neobvykle přátelské chování či neadekvátně vstřícné chování vůči ostatním lidem. Chování toho to typu může vyústit v nebezpečné situace, jako je například skutečnost, že dítě bezelstně následuje neznámého cizího dospělého</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neobvykle přátelská povaha</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100025"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Forma neadekvátně zvýšené sociability zahrnující neobvykle přátelské chování či neadekvátně vstřícné chování vůči ostatním lidem. Chování toho to typu může vyústit v nebezpečné situace, jako je například skutečnost, že dítě bezelstně následuje neznámého cizího dospělého</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of hypersociability that presents as mostly inappropriate friendliness towards others.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100025"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neobvykle přátelská povaha</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Overfriendliness</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100026">
        <obo:IAO_0000115 xml:lang="cs">Anomální konfigurace cév u které se arteriální krev dostává přímo do venózního řečiště bez toho, aby prošla kapilárním řečištěm</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Arteriovenózní malformace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100026"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomální konfigurace cév u které se arteriální krev dostává přímo do venózního řečiště bez toho, aby prošla kapilárním řečištěm</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomalous configuration of blood vessels that shunts arterial blood directly into veins without passing through the capillaries.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
