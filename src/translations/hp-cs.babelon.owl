    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011528">
        <obo:IAO_0000115 xml:lang="cs">Ostře ohraničená hyperpigmentace, která je vrozená, vyskytuje se asi u 3-5 % populace a nemá funkční význam.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Solitární vrozená hypertrofie retinálního pigmentového epitelu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011528"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Ostře ohraničená hyperpigmentace, která je vrozená, vyskytuje se asi u 3-5 % populace a nemá funkční význam.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sharply demarcated hyperpigmentation of the retinal pigment epithelium (RPE) that is congenital and of no functional significance.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
