        <owl:annotatedTarget xml:lang="cs">Abnormalita ve funkci chemických reakcí souvisejících s procesy zahrnující přeměny potravy na vstupu, syntézy proteinů, lipidů, nukleových kyselin a sacharidů nebo eliminace odpadních produktů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
