        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025200"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Htomadění aktinových filament ve svalových buňkách</owl:annotatedTarget>
