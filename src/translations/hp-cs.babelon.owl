        <owl:annotatedTarget xml:lang="cs">Anomálie proteinové O-vázané glykosylace, tj. procesu, ve kterém je sacharidová jednotka nebo jednotka derivátu sacharidu přidána k proteinu přes hydroxylovou skupinu serinového nebo threoninového zbytku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
