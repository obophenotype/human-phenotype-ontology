    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003106">
        <obo:IAO_0000115 xml:lang="cs">Ztráta kostní tkáně může nastat za periostem (periost je mambrána z pojivové tkáně, která lemuje všechny kosti s výjimkou kloubních ploch). Tento proces může vytvořit v periostální kortikální kosti vroubkovaný a krajkový vzhled</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Subperiostální resorpce kosti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003106"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Ztráta kostní tkáně může nastat za periostem (periost je mambrána z pojivové tkáně, která lemuje všechny kosti s výjimkou kloubních ploch). Tento proces může vytvořit v periostální kortikální kosti vroubkovaný a krajkový vzhled</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Loss of bone mass occurring beneath the periosteum (the periosteum is the connective-tissue membrane that surrounds all bones except at the articular surfaces). This process may create a serrated and lace-like appearance in periosteal cortical bone.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
