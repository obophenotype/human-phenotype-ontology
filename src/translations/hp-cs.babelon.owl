    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007179">
        <obo:IAO_0000115 xml:lang="cs">Neschopnost sledovat předměty pomocí systému plynulého sledování, což je třída poměrně pomalých očních pohybů, které minimalizují pohyb cíle na sítnici.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Chybějící sledovací pohyby</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007179"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neschopnost sledovat předměty pomocí systému plynulého sledování, což je třída poměrně pomalých očních pohybů, které minimalizují pohyb cíle na sítnici.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A complete lack of the ability to track objects with the ocular smooth pursuit system, a class of rather slow eye movements that minimizes retinal target motion.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
