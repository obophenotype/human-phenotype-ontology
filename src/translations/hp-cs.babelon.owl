    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012035">
        <obo:IAO_0000115 xml:lang="cs">Mnohočetné, lokalizované nebo rozšířené, asymptomatické nebo zánětlivé dermální cysty postihující pilosebaceózní jednotky. Léze se mohou objevit kdekoli na těle, ale steatocystoma multiplex se častěji vyskytuje v oblastech kůže s vysokou hustotou vyvinutých pilosebaceózních jednotek (např. axila, třísla, krk a proximální končetiny)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Steatocystoma multiplex</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012035"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Mnohočetné, lokalizované nebo rozšířené, asymptomatické nebo zánětlivé dermální cysty postihující pilosebaceózní jednotky. Léze se mohou objevit kdekoli na těle, ale steatocystoma multiplex se častěji vyskytuje v oblastech kůže s vysokou hustotou vyvinutých pilosebaceózních jednotek (např. axila, třísla, krk a proximální končetiny)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Multiple, localized or widespread, asymptomatic or inflammatory dermal cysts involving the pilosebaceous units. Lesions can appear anywhere on the body, but steatocystoma multiplex is more commonly involved with those areas of the skin with a high density of developed pilosebaceous units (e.g., the axilla, groin, neck, and proximal extremities).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012035"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Steatocystoma multiplex</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Steatocystoma multiplex</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012036">
        <obo:IAO_0000115 xml:lang="cs">Atrofie musculus sternocleidomastoideus, svalu, který na přední strane krku slouží na flexi a rotaci hlavy</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Amyotrofie musculus sternocleidomastoideus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012036"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Atrofie musculus sternocleidomastoideus, svalu, který na přední strane krku slouží na flexi a rotaci hlavy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Wasting of the sternocleidomastoid muscle, the muscle in the anterior part of the neck that acts to flex and rotate the head.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
