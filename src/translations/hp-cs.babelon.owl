        <obo:IAO_0000115 xml:lang="cs">Typ nodulu (umbilicated nodule), který má malou vkleslinu připomínající pupek.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nodulus s centrální vkleslinou</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025103"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ nodulu (umbilicated nodule), který má malou vkleslinu připomínající pupek.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of skin nodule that has a small depression that resembles a navel (i.e., is umbilicated).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
