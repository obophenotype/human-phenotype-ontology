        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001964">
        <obo:IAO_0000115 xml:lang="cs">Chybějící nebo nedostatečně vyvinuté metatarzální kosti</obo:IAO_0000115>
