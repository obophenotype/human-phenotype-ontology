    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034013">
        <obo:IAO_0000115 xml:lang="cs">Typ lipomu v perikalózním prostoru, který je tenký a obtáčí se kolem splenium corporis callosi</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Curvilineární perikalózní lipom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034013"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ lipomu v perikalózním prostoru, který je tenký a obtáčí se kolem splenium corporis callosi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of pericallosal lipoma that is thin and curves around the posterior end of the splenium of the corpus callosum.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034013"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Curvilineární perikalózní lipom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Curvilinear pericallosal lipoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034014">
        <obo:IAO_0000115 xml:lang="cs">Typ lipomu v perikalózním prostoru s kulovitým nebo lobulárním vzhledem a průměrem obvykle nad 2 cm. Jsou umístěny anteriorně a jsou spojeny s rozsáhlými kalózními a často i faciálními anomáliemi. Tubulonodulární lipom v perikalózním prostoru může zasahovat do choroidálního plexu nebo postranních komor</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Tubulonodulární perikalózní lipom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034014"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ lipomu v perikalózním prostoru s kulovitým nebo lobulárním vzhledem a průměrem obvykle nad 2 cm. Jsou umístěny anteriorně a jsou spojeny s rozsáhlými kalózními a často i faciálními anomáliemi. Tubulonodulární lipom v perikalózním prostoru může zasahovat do choroidálního plexu nebo postranních komor</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of pericallosal lipoma with a rounded or lobular appearance and a diameter that is usually above 2 cm. They are anteriorly situated and are associated with extensive callosal and often fronto-facial anomalies. A tubulonodular pericallosal lipoma can extend into the choroid plexus or lateral ventricles.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034014"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Tubulonodulární perikalózní lipom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tubulonodular pericallosal lipoma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034015">
        <obo:IAO_0000115 xml:lang="cs">Silnostěnný abnormální plynem vyplněný intersticiální uzlík v plicích.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kavitující plicní uzel</rdfs:label>
    </rdf:Description>
