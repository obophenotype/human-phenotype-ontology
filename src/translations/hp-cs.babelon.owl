        <babelon:source_value>Accessory spleen</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001748">
        <obo:IAO_0000115 xml:lang="cs">Polysplenie je vrozená nemoc projevující se výskytem několika nadpočetných malých slezin</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Polysplenie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001748"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Polysplenie je vrozená nemoc projevující se výskytem několika nadpočetných malých slezin</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Polysplenia is a congenital disease manifested by multiple small accessory spleens.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
