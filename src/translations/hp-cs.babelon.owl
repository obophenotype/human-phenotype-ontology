        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Transitional atrioventricular canal defect</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011579">
        <obo:IAO_0000115 xml:lang="cs">Anatomické abnormality defektu atrioventrikulárního septa (AVSD) zahrňují variabilní množství ventrikulární hypoplázje a špatné zarovnání atrioventrikulární junkce. Při kompletním AVSD společná atrioventrikulární chlopeň může být umístněna nad oběma komorama rovnoměrně, nebo nebalansovaně v prospěch jedné komory.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nebalansovaný atrioventrikulární kanál</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011579"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anatomické abnormality defektu atrioventrikulárního septa (AVSD) zahrňují variabilní množství ventrikulární hypoplázje a špatné zarovnání atrioventrikulární junkce. Při kompletním AVSD společná atrioventrikulární chlopeň může být umístněna nad oběma komorama rovnoměrně, nebo nebalansovaně v prospěch jedné komory.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anatomic features of unbalanced atrioventricular septal defect (AVSD) include varying amounts of ventricular hypoplasia, as well as malalignment of the atrioventricular junction. In complete AVSD, the common AV valve can be situated either equally over the right and left ventricles (balanced) or unequally over the ventricles (unbalanced).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011579"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nebalansovaný atrioventrikulární kanál</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Unbalanced atrioventricular canal defect</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011580">
