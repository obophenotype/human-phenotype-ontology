    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009878">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost mozečkových příznaků a symptomů, jako je poruchu rovnováhy spojenou s kvadrupedální chůzí (lokomoce na všech čtyřech končetinách s „medvědí“ chůzí s rovnýma nohama)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Cerebelární ataxie spojená s kvadrupedální chůzí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009878"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost mozečkových příznaků a symptomů, jako je poruchu rovnováhy spojenou s kvadrupedální chůzí (lokomoce na všech čtyřech končetinách s „medvědí“ chůzí s rovnýma nohama)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of cerebellar signs and symptoms such as lack of balance associated with quadrupedal gait (locomotion on all four extremities with a &apos;bear-like&apos; gait with the legs held straight).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009878"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Cerebelární ataxie spojená s kvadrupedální chůzí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cerebellar ataxia associated with quadrupedal gait</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009879">
        <obo:IAO_0000115 xml:lang="cs">Abnormální redukce množství a komplexity gyrace mozkové kůry.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vyhlazené korové gyry</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009879"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální redukce množství a komplexity gyrace mozkové kůry.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the cerebral cortex with fewer gyri but with normal cortical thickness. This pattern is usually often associated with congenital microcephaly.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
