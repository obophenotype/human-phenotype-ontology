    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002021">
        <obo:IAO_0000115 xml:lang="cs">Stenóza pyloru, známá také jako dětská hypertrofická stenóza pyloru, je neobvyklé onemocnění u kojenců charakterizované abnormálním ztluštěním svalů pyloru v žaludku, které vede k obstrukci žaludečního vývodu. Klinicky jsou kojenci po narození v pořádku. Ve věku 3 až 6 týdnů se pak u kojenců objevuje náhlé zvracení, které může vést k dehydrataci a ztrátě hmotnosti.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Stenóza pyloru</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002021"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Stenóza pyloru, známá také jako dětská hypertrofická stenóza pyloru, je neobvyklé onemocnění u kojenců charakterizované abnormálním ztluštěním svalů pyloru v žaludku, které vede k obstrukci žaludečního vývodu. Klinicky jsou kojenci po narození v pořádku. Ve věku 3 až 6 týdnů se pak u kojenců objevuje náhlé zvracení, které může vést k dehydrataci a ztrátě hmotnosti.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pyloric stenosis, also known as infantile hypertrophic pyloric stenosis, is an uncommon condition in infants characterized by abnormal thickening of the pylorus muscles in the stomach leading to gastric outlet obstruction. Clinically infants are well at birth. Then, at 3 to 6 weeks of age, the infants present with projectile vomiting, potentially leading to dehydration and weight loss.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002021"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Stenóza pyloru</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pyloric stenosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
