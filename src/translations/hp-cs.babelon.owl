    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0008200">
        <obo:IAO_0000115 xml:lang="cs">Typ hyperparathyreoidizmu způsobený primární abnormalitou příštitných žláz (např. adenom, karcinom, hyperplázie). Primárně je hyperparathyreoidizmus asociován s hyperkalcemií.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Primární hyperparathyreoidizmus</rdfs:label>
    </rdf:Description>
