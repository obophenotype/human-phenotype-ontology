        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025019"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Náhlé roztržení tepny, které vede k úniku krve z oběhu.</owl:annotatedTarget>
