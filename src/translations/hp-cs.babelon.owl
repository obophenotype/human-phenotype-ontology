        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Překus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased overbite</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011095">
        <obo:IAO_0000115 xml:lang="cs">Abnormální ventrálně kraniální vychýlení maxilárních zubů mimo rovinu danou mandibulárními zuby při skusu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Předkus</rdfs:label>
    </rdf:Description>
