    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033272">
        <obo:IAO_0000115 xml:lang="cs">Abnormální struktura glomerulárních endoteliálních buněk, což jsou vysoce specializované buňky s fenestrami a nabitou vrstvou luminálního glykokalyxu, které se podílějí na filtrační bariéře</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie glomerulárních endoteliálních buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033272"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální struktura glomerulárních endoteliálních buněk, což jsou vysoce specializované buňky s fenestrami a nabitou vrstvou luminálního glykokalyxu, které se podílějí na filtrační bariéře</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal structure of the glomerular endothelial cells, which are highly specialized cells with fenestrae and a charged luminal glycocalyx layer that contribute to the filtration barrier.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
