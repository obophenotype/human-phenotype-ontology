    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032572">
        <obo:IAO_0000115 xml:lang="cs">Odchylka od normální hladiny nukleobáze v moči. Nukleobáze jsou biologické sloučeniny obsahující dusík, které tvoří nukleosidy: adenin (A), cytosin (C), guanin (G), thymin (T) a uracil (U).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální koncentrace nukleových bází v moči</rdfs:label>
    </rdf:Description>
