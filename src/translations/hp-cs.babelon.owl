        <owl:annotatedTarget xml:lang="cs">Jakákoliv odchylka od normálního poměru acylkarnitinu (tj. esterifikovaného karnitinu) k volnému karnitinu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any deviation from the normal ratio of acylcarnitine (i.e., esterified carnitine) to free carnitine.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
