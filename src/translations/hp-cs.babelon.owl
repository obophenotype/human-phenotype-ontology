    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001492">
        <obo:IAO_0000115 xml:lang="cs">Axenfeldova anomálie je bilaterální porucha charakterizovaná prominentními, anteriorně lokalizovanými Schwalbeho liniemi (zadní embryotoxon) a periferními k nim adherujícími výběžky duhovky</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Axenfeldova anomálie</rdfs:label>
    </rdf:Description>
