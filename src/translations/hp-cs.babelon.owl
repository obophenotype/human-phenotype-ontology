    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033428">
        <obo:IAO_0000115 xml:lang="cs">Dysregulace vrozeného imunitního systému charakterizovaná systémovou patobiologií, tj. s příznaky, které mohou postihovat celé tělo.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Systémový autoinflamatorní stav</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033428"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Dysregulace vrozeného imunitního systému charakterizovaná systémovou patobiologií, tj. s příznaky, které mohou postihovat celé tělo.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dysregulation of the innate immune system characterized by systemic pathobiology, i.e., with symptoms that can affect the entire body.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
