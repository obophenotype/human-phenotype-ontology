        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Peripheral arterial stenosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004952">
        <obo:IAO_0000115 xml:lang="cs">Vzácná cévní anomálie s přímou komunikací mezi arteria pulmonalis a vena pulmonalis bez mezilehlého kapilárního řečiště.</obo:IAO_0000115>
