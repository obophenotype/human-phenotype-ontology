    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009920">
        <obo:IAO_0000115 xml:lang="cs">Kožní melanocytární hamartom, který se projevuje namodralou hyperpigmentací na obličeji podél první nebo druhé větve trojklanného nervu. Otův névus může zasahovat i skléru.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Otův névus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009920"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kožní melanocytární hamartom, který se projevuje namodralou hyperpigmentací na obličeji podél první nebo druhé větve trojklanného nervu. Otův névus může zasahovat i skléru.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A dermal melanocytic hamartoma that presents as bluish hyperpigmentation on the face along the first or second branches of the trigeminal nerve. Nevus of Ota may involve the sclera.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
