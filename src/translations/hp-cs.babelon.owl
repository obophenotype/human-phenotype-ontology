        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>High renal tubular epithelial cell N/C ratio</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032606">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost zvýšeného množství lipofuscinu, žlutého granulárního cytoplazmatického pigmentu v renálních tubulech</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Lipofuscin renálních tubulárních epiteliálních buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032606"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost zvýšeného množství lipofuscinu, žlutého granulárního cytoplazmatického pigmentu v renálních tubulech</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Presence of increased amount of lipofuscin, a yellow, granular cytoplasmic pigment in the renal tubules.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
