        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dacryocystocele</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030753">
        <obo:IAO_0000115 xml:lang="cs">Ztráta jednoho z dvojčat po 17. týdenu těhotenství</obo:IAO_0000115>
