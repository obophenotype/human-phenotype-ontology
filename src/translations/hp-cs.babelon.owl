        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Neuropatická porucha charakterizovaná epizodami intenzivní bolesti v obličeji, pocházející z trigeminálního nervu. Postižena může být jedna, dvě nebo všechny tři větve nervu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A neuropathic disorder characterized by episodes of intense pain in the face, originating from the trigeminal nerve. One, two, or all three branches of the nerve may be affected.</babelon:source_value>
