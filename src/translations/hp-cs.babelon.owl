        <obo:IAO_0000115 xml:lang="cs">Akutní forma sinusitidy</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Akutní sinusitida</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000255"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
