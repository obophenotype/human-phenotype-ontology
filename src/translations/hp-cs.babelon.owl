    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034442">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli odchylka od normální koncentrace erytropoetinu v krevním oběhu. Erytropoetin je glykoproteinový hormon produkovaný peritubulárními buňkami ledvin, který stimuluje tvorbu červených krvinek.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální koncentrace cirkulujícího erytropoetinu</rdfs:label>
    </rdf:Description>
