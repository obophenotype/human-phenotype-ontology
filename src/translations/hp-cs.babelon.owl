    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032568">
        <obo:IAO_0000115 xml:lang="cs">Distální tubulární epiteliální buňky, ve kterých se nahromadil globotriaosylceramid (Gb3). jsou charakteristickým znakem Fabryho choroby. Tělíska ve tvaru moruše jsou součástí morušovitých buněk,, které lze snadno odlišit od tukových částic podle jejich vnitřního lamelárního vzhledu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Morušovité buňky v moči</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032568"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Distální tubulární epiteliální buňky, ve kterých se nahromadil globotriaosylceramid (Gb3). jsou charakteristickým znakem Fabryho choroby. Tělíska ve tvaru moruše jsou součástí morušovitých buněk,, které lze snadno odlišit od tukových částic podle jejich vnitřního lamelárního vzhledu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Distal tubular epithelial cells in which globotriaosylceramide (Gb3) has accumulated. they are the characteristic feature of Fabry disease. Urinary mulberry bodies are a component of mulberry cells that can be distinguished easily from fat particles by their inner lamellar appearance.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
