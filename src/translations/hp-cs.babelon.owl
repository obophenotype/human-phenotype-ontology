    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012385">
        <obo:IAO_0000115 xml:lang="cs">Distální interfalangeální kloub a/nebo proximální interfalangeální kloub prstů na ruce nebo noze nemože být extendován na 180 stupňů aktivní ani pasivní extenzí</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kamptodaktylie</rdfs:label>
    </rdf:Description>
