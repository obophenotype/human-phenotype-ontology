        <owl:annotatedTarget xml:lang="cs">Druhotné osifikační centrum v středním falangu třetího prstu na ruce, které je odlišné od běžné epifýzy a které nepřispívá k longitudinálnímu růstu dlouhé kosti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
