    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0040012">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená míra chromozomových zlomů nebo aberací, ke kterým dochází buď spontánně, nebo po expozici různým činidlům poškozujícím DNA. Tato vlastnost může být testována vystavením kultivovaných lymfocytů činidlům, jako jsou chemické mutageny, ozáření a alkylační činidla.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Chromozomový zlom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040012"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená míra chromozomových zlomů nebo aberací, ke kterým dochází buď spontánně, nebo po expozici různým činidlům poškozujícím DNA. Tato vlastnost může být testována vystavením kultivovaných lymfocytů činidlům, jako jsou chemické mutageny, ozáření a alkylační činidla.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elevated rate of chromosomal breakage or interchanges occurring either spontaneously or following exposure to various DNA-damaging agents. This feature may be assayed by treatment of cultured lymphocytes with agents such as chemical mutagens, irradiation, and alkylating agents.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
