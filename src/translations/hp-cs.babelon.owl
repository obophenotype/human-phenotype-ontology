        <babelon:source_value>Lid lag on downgaze</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025606">
        <obo:IAO_0000115 xml:lang="cs">Funkční anomálie musculus rectus medialis, extraokulárního svalu, který je inervován dolní částí okohybného nervu a jehož jedinou činností je addukce očního bulbu.</obo:IAO_0000115>
