        <babelon:source_value>Lymphoid leukemia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005527">
        <obo:IAO_0000115 xml:lang="cs">Snížení množství kininogenu, který funguje jako kofaktor v kontaktní fázi vnitřní kaskády koagulace krve</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená aktivita kininogenu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005527"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížení množství kininogenu, který funguje jako kofaktor v kontaktní fázi vnitřní kaskády koagulace krve</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Amount or activity of kininogen is below the lower limit of normal. Kininogen functions as a cofactor in the contact phase of the intrinsic blood coagulation cascade.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
