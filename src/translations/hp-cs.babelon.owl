    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030854">
        <obo:IAO_0000115 xml:lang="cs">Stafylom je lokalizovaný defekt ve stěně oka s protruzí uveální tkáně v důsledku změn tloušťky a struktury skléry.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Stafylom skléry</rdfs:label>
    </rdf:Description>
