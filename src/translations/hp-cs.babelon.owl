    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020161">
        <obo:IAO_0000115 xml:lang="cs">Ucpání větve retinální tepny. To může způsobit ztrátu části zorného pole.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Okluze větve retinální tepny</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020161"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Ucpání větve retinální tepny. To může způsobit ztrátu části zorného pole.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Blockage of a branch of the retinal artery. This can cause loss of a section of visual field.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020161"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Okluze větve retinální tepny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Branch retinal artery occlusion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020163">
        <obo:IAO_0000115 xml:lang="cs">Blokáda cilioretinální tepny. Centrální retinální tepna zásobuje vnitřní sítnici a povrch zrakového nervu. U některých jedinců může cilioretinální arterie, větev ciliárního oběhu, zásobovat část sítnice včetně makuly. Při okluzi cilioretinální arterie je ztráta zraku důsledkem buněčné smrti ve vnitřních vrstvách sítnice (hlavně gangliových buňkách), a to i přes relativní zachování vnějších vrstev.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Okluze cilioretinální tepny</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020163"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Blokáda cilioretinální tepny. Centrální retinální tepna zásobuje vnitřní sítnici a povrch zrakového nervu. U některých jedinců může cilioretinální arterie, větev ciliárního oběhu, zásobovat část sítnice včetně makuly. Při okluzi cilioretinální arterie je ztráta zraku důsledkem buněčné smrti ve vnitřních vrstvách sítnice (hlavně gangliových buňkách), a to i přes relativní zachování vnějších vrstev.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ischemia in the territory of the cilioretinal artery causing opacification of the inner retina and visual loss. This is most commonly seen in central retinal vein occlusion in the young.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020163"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Okluze cilioretinální tepny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cilioretinal arteriolar hypoperfusion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020164">
        <obo:IAO_0000115 xml:lang="cs">Částečná nebo úplná obstrukce arteria ophtalmica (větve arteria carotis interna), která může vést k závažné ischemii postižené oční koule a souvisejících očních tkání. Může se projevovat podobným obrazem jako okluze centrální retinální tepny; dochází však také k hluboké choroidální ischemii.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Okluze oftalmické tepny</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020164"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Částečná nebo úplná obstrukce arteria ophtalmica (větve arteria carotis interna), která může vést k závažné ischemii postižené oční koule a souvisejících očních tkání. Může se projevovat podobným obrazem jako okluze centrální retinální tepny; dochází však také k hluboké choroidální ischemii.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Acute complete obstruction of the ophthalmic artery (branch of the internal carotid artery) that may lead to severe ischemia of the affected globe and associated ocular tissues. It can present with a similar picture to central retinal artery occlusion associated with choroidal ischemia.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020164"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Okluze oftalmické tepny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ophthalmic artery occlusion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020165">
        <obo:IAO_0000115 xml:lang="cs">Ucpání větve retinální žíly. Může se projevit náhlým vznikem nebolestivé ztráty zraku nebo defektu zorného pole, který koreluje s oblastí perfuze ucpaných cév.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Okluze větve retinální žíly</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020165"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Ucpání větve retinální žíly. Může se projevit náhlým vznikem nebolestivé ztráty zraku nebo defektu zorného pole, který koreluje s oblastí perfuze ucpaných cév.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Blockage of a branch of the retinal vein. It may present with sudden-onset of painless vision loss or visual field defect correlating to the area of perfusion of the obstructed vessels.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020165"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Okluze větve retinální žíly</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Branch retinal vein occlusion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020166">
        <obo:IAO_0000115 xml:lang="cs">Okluze centrální retinální žíly je okluze hlavní retinální žíly za lamina cribrosa optického nervu a je typicky způsobena trombózou</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Okluze vena centralis retinae</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020166"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Okluze centrální retinální žíly je okluze hlavní retinální žíly za lamina cribrosa optického nervu a je typicky způsobena trombózou</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Central retinal vein occlusion is an occlusion of the main retinal vein posterior to the lamina cribrosa of the optic nerve and is typically caused by thrombosis.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020166"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Okluze vena centralis retinae</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Central retinal vein occlusion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020167">
        <obo:IAO_0000115 xml:lang="cs">Varianta okluzí centrální retinální žíly, která zahrnuje horní nebo dolní polovinu sítnice</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hemiretinální žilní okluze</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020167"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Varianta okluzí centrální retinální žíly, která zahrnuje horní nebo dolní polovinu sítnice</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A variant of central retinal vein occlusions that involves the superior or inferior half of the retina.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020167"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hemiretinální žilní okluze</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hemiretinal vein occlusion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020169">
        <obo:IAO_0000115 xml:lang="cs">Anomální reakce na lék související s individuálními rozdíly v metabolické nebo imunitní odpovědi na léky, které se liší od potenciálně život ohrožujících nežádoucích účinků léku až po změnu terapeutické účinnosti.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální odpověď na lék</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020169"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomální reakce na lék související s individuálními rozdíly v metabolické nebo imunitní odpovědi na léky, které se liší od potenciálně život ohrožujících nežádoucích účinků léku až po změnu terapeutické účinnosti.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomalous response to a medication related to individual variation in metabolic or immune response to drugs varying from potentially from potentially life-threatening adverse drug reactions to alteration of therapeutic efficacy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
