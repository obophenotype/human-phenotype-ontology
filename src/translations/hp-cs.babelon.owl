    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030712"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Srůsty nebo zjizvená tkáň, které se tvoří uvnitř děložní dutiny.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
