        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012255">
        <obo:IAO_0000115 xml:lang="cs">Anomálie dyneinových ramének motilních řasinek dýchacího traktu. Tato vlastnost je obvykle zjištěná pomocí elektronové mikroskopie.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Defekt dyneinových ramének motilních řasinek dýchacího traktu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012255"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomálie dyneinových ramének motilních řasinek dýchacího traktu. Tato vlastnost je obvykle zjištěná pomocí elektronové mikroskopie.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly of the dynein arms of motile cilia. This feature is usually appreciated by electron microscopy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012255"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Defekt dyneinových ramének motilních řasinek dýchacího traktu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dynein arm defect of respiratory motile cilia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012256">
        <obo:IAO_0000115 xml:lang="cs">Chybění vnějších dyneinových ramének motilních řasinek dýchacího traktu, které jsou normálně umístněné na vnější straně periferních mikrotubulů motilních řasinek. Tato vlastnost je obvykle zjištěna pomocí elektronové mikroskopie.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Chybějící vnější dyneinová raménka</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012256"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Chybění vnějších dyneinových ramének motilních řasinek dýchacího traktu, které jsou normálně umístněné na vnější straně periferních mikrotubulů motilních řasinek. Tato vlastnost je obvykle zjištěna pomocí elektronové mikroskopie.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of the outer dynein arms of respiratory motile cilia, which normally are situated outside of the peripheral microtubules of motile cilia. This feature is usually appreciated by electron microscopy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012256"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Chybějící vnější dyneinová raménka</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absent outer dynein arms</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012257">
        <obo:IAO_0000115 xml:lang="cs">Chybění vnějších dyneinových ramének motilních řasinek dýchacího traktu, které jsou normálně umístněné na vnitřní straně periferních mikrotubulů motilních řasinek. Tato vlastnost je obvykle zjištěna pomocí elektronové mikroskopie.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Chybějící vnitřní dyneinová raménka</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012257"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Chybění vnějších dyneinových ramének motilních řasinek dýchacího traktu, které jsou normálně umístněné na vnitřní straně periferních mikrotubulů motilních řasinek. Tato vlastnost je obvykle zjištěna pomocí elektronové mikroskopie.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of the inner dynein arms of respiratory motile cilia, which normally are situated within the peripheral microtubules of motile cilia. This feature is usually appreciated by electron microscopy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012257"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Chybějící vnitřní dyneinová raménka</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absent inner dynein arms</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012258">
        <obo:IAO_0000115 xml:lang="cs">Abnormální uspořádání struktur axonemy, coz je cytoskletární struktura, která vytváří vnitřní jádro pohyblivého cilia (řasinky) a je tvořena mikrotubuly v kanonickém uspořádání 9 + 2 posetými dyneinovými rameny</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormání uspořádání axonemy motilních řasinek dýchacího traktu.</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012258"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální uspořádání struktur axonemy, coz je cytoskletární struktura, která vytváří vnitřní jádro pohyblivého cilia (řasinky) a je tvořena mikrotubuly v kanonickém uspořádání 9 + 2 posetými dyneinovými rameny</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal arrangement of the structures of the axoneme, which is the cytoskeletal structure that forms the inner core of the motile cilium and displays a canonical 9+2 microtubular pattern of motile cilia studded with dynein arms.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012258"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormání uspořádání axonemy motilních řasinek dýchacího traktu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal axonemal organization of respiratory motile cilia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012259">
        <obo:IAO_0000115 xml:lang="cs">Úplné chybění dyneinových ramének motilních řasinek dýchacího traktu, to znamená chybění dyneinových ramének na vnejší i vnitřní straně periferních mikrotubulů motilních řasinek. Tato vlastnost je obvykle zjištěna pomocí elektronové mikroskopie.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Chybějící/zkrácené vnitřní dyneinové raménka</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012259"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Úplné chybění dyneinových ramének motilních řasinek dýchacího traktu, to znamená chybění dyneinových ramének na vnejší i vnitřní straně periferních mikrotubulů motilních řasinek. Tato vlastnost je obvykle zjištěna pomocí elektronové mikroskopie.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complete absence of the dynein arms of respiratory motile cilia, that is, absence of the inner and the outer dynein arms, which normally are situated inside and outside of the peripheral microtubules of motile cilia. This feature is usually appreciated by electron microscopy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012259"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Chybějící/zkrácené vnitřní dyneinové raménka</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absent inner and outer dynein arms</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012260">
        <obo:IAO_0000115 xml:lang="cs">Strukturální anomálie dvou centrálních mikrotubulů motilních řasinek s mikrotululárním uspořádáním 9+2</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie centrálního páru mikrotubulů motilních řasinek dýchacího traktu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012260"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Strukturální anomálie dvou centrálních mikrotubulů motilních řasinek s mikrotululárním uspořádáním 9+2</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A structural anomaly of the two central microtubules of motile cilia with a 9+2 microtubuluar configuration.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012260"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální morfologie centrálního páru mikrotubulů motilních řasinek dýchacího traktu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal central microtubular pair morphology of respiratory motile cilia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012261">
        <obo:IAO_0000115 xml:lang="cs">Jakákoliv funkční anomálie motilních řasinek dýchacího traktu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální fyziologie motilních řasinek dýchacího traktu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012261"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoliv funkční anomálie motilních řasinek dýchacího traktu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any functional anomaly of the respiratory motile cilia.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012261"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální fyziologie motilních řasinek dýchacího traktu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal respiratory motile cilium physiology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012262">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli anomálie normální motoriky pohyblivých řasinek. Vyhodnocení frekvence ciliárních kmitů a jejich vzorů vyžaduje vysokorychlostní videomikroskopii čerstvě získaných řasinkových biopsií, které jsou udržovány v kultivačním médiu za kontrolovaných podmínek.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální pohyblivost řasinek</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012262"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoli anomálie normální motoriky pohyblivých řasinek. Vyhodnocení frekvence ciliárních kmitů a jejich vzorů vyžaduje vysokorychlostní videomikroskopii čerstvě získaných řasinkových biopsií, které jsou udržovány v kultivačním médiu za kontrolovaných podmínek.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any anomaly of the normal motility of motile cilia. Evaluation of ciliary beat frequency and ciliary beat pattern requires high-speed videomicroscopy of freshly obtained ciliary biopsies that are maintained in culture media under controlled conditions.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012262"/>
