    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010922">
        <obo:IAO_0000115 xml:lang="cs">Forma katarakty, při níž se čočka zmenšila a vzniklo zkolabované, zploštělé pouzdro s malým nebo žádným kortexem nebo epitelem na čočce.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Membranózní katarakta</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
