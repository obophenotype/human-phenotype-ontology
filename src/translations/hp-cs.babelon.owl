        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030670">
        <obo:IAO_0000115 xml:lang="cs">Hamartom (chaotická proliferace zralé tkáně) vznikající z jakékoliv tkáně orbitální krajiny.</obo:IAO_0000115>
