    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011448">
        <obo:IAO_0000115 xml:lang="cs">Klonus je samovolný šlachový reflex, který způsobuje opakavanou flexi a extenzi chodidla. Klonus kotníku je vyšetřován rychlou flexí chodidla směrem nahoru.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Klonus kotníku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011448"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Klonus je samovolný šlachový reflex, který způsobuje opakavanou flexi a extenzi chodidla. Klonus kotníku je vyšetřován rychlou flexí chodidla směrem nahoru.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Clonus is an involuntary tendon reflex that causes repeated flexion and extension of the foot. Ankle clonus is tested by rapidly flexing the foot upward.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011448"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Klonus kotníku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ankle clonus</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011449">
        <obo:IAO_0000115 xml:lang="cs">Klonus je samovolný šlachový reflex, který způsobuje opakavanou flexi a extenzi chodidla. Klonus kolene může být vyšetřován rychlým zatlačením patelly směrek k prstům nohy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Klonus kolene</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011449"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Klonus je samovolný šlachový reflex, který způsobuje opakavanou flexi a extenzi chodidla. Klonus kolene může být vyšetřován rychlým zatlačením patelly směrek k prstům nohy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Clonus is an involuntary tendon reflex that causes repeated flexion and extension of the foot. Knee clonus can be tested by rapidly pushing the patella towards the toes.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
