    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005295">
        <obo:IAO_0000115 xml:lang="cs">Pseudokoarktace je vrozená anomálie ohybu aorty bez tlakového gradientu v průběhu léze. Je charakterizována prodloužením a zalomením aorty na úrovni ligamentum arteriosum.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pseudokoarktace aorty</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005295"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Pseudokoarktace je vrozená anomálie ohybu aorty bez tlakového gradientu v průběhu léze. Je charakterizována prodloužením a zalomením aorty na úrovni ligamentum arteriosum.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pseudocoarctation is a congenital anomaly of kinking, or buckling, of the aorta without a pressure gradient across the lesion. It is characterized by elongation and kinking of the aorta at the level of the ligamentum arteriosum.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
