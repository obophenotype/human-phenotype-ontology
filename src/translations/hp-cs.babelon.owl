        <owl:annotatedTarget xml:lang="cs">Jakákoliv strukturální anomálie umístněná mezi pleuru a hrudní stěnu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any structural anomaly located between the pleura and the chest wall.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
