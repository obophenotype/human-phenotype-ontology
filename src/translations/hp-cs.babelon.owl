    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000892">
        <obo:IAO_0000115 xml:lang="cs">Rozštěp žeber je vidlicovité rozdvojení sternálních konců žeber, obvykle unilaterálně. Rozštěpená žebra jsou obvykle asymptomatické a často se jedná o náhodný nález při skiaskopii hrudníku</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Rozštěp žeber</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000892"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Rozštěp žeber je vidlicovité rozdvojení sternálních konců žeber, obvykle unilaterálně. Rozštěpená žebra jsou obvykle asymptomatické a často se jedná o náhodný nález při skiaskopii hrudníku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A bifid rib refers to cleavage of the sternal end of a rib, usually unilateral. Bifid ribs are usually asymptomatic, and are often discovered incidentally by chest x-ray.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
