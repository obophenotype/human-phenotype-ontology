    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020153">
        <obo:IAO_0000115 xml:lang="cs">Beta-1,3-glukan je hlavní složkou všech charakterizovaných buněčných stěn hub, tvoří 30-80 % hmotnosti stěny. Je biomarkerem houbových infekcí, jako je invazivní plicní aspergilóza.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pozitivní krevní test na 1,3 beta glukan</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020153"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Beta-1,3-glukan je hlavní složkou všech charakterizovaných buněčných stěn hub, tvoří 30-80 % hmotnosti stěny. Je biomarkerem houbových infekcí, jako je invazivní plicní aspergilóza.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Beta-1,3-glucan is a major constituent of all of the characterized fungal cell walls, making up between 30-80 percent of the mass of the wall. It is a biomarker of fungal infections such as invasive pulmonary aspergillosis.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020153"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Pozitivní krevní test na 1,3 beta glukan</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Positive blood 1,3 beta glucan test</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020154">
        <obo:IAO_0000115 xml:lang="cs">Typ epidermálního névu charakterizovaný úzce uspořádanými, rozšířenými folikulárními otvory s keratinovými zátkami připomínajícími klasické komedony.</obo:IAO_0000115>
