        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Wasting of the sural nerve, a sensory nerve in the calf region of the leg.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032145"/>
