    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031656">
        <obo:IAO_0000115 xml:lang="cs">Systolický přední pohyb mitrální chlopně (SAM) je paradoxní pohyb předního a někdy i zadního cípu mitrální chlopně směrem k výtokovému traktu levé komory (LVOT) během systoly</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dopředný pohyb mitrální chlopně v systole</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031656"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Systolický přední pohyb mitrální chlopně (SAM) je paradoxní pohyb předního a někdy i zadního cípu mitrální chlopně směrem k výtokovému traktu levé komory (LVOT) během systoly</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Systolic anterior motion of the mitral valve (SAM) is a paradoxical motion of the anterior, and occasionally posterior, mitral valve leaflet towards the left ventricular outflow tract (LVOT) during systole.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
