    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032045">
        <obo:IAO_0000115 xml:lang="cs">Hypoplázie karotického kanálu, což je obvykle okrouhlý otvor v temporální kosti lebky skrz který prochází vnitřní karotická artérie a nervový karotický plexus</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hypoplastický karotický kanál</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032045"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Hypoplázie karotického kanálu, což je obvykle okrouhlý otvor v temporální kosti lebky skrz který prochází vnitřní karotická artérie a nervový karotický plexus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Underdevelopment of the carotid canal, which normally is a circular aperture in the temporal bone of the skull through which the internal carotid artery and the carotid plexus of nerves traverse.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032045"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hypoplastický karotický kanál</owl:annotatedTarget>
