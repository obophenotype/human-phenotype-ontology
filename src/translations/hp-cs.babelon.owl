        <babelon:source_value>Language impairment</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002464">
        <obo:IAO_0000115 xml:lang="cs">Typ dysartrie související s bilaterálním poškozením horních cest motorických neuronů pyramidálních a extrapyramídových drah. Řeč postižených jedinců je pomalá, namáhavá a má drsnou hlasovou kvalitu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Spastická dysartrie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002464"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ dysartrie související s bilaterálním poškozením horních cest motorických neuronů pyramidálních a extrapyramídových drah. Řeč postižených jedinců je pomalá, namáhavá a má drsnou hlasovou kvalitu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of dysarthria related to bilateral damage of the upper motor neuron tracts of the pyramidal and extra- pyramidal tracts. Speech of affected individuals is slow, effortful, and has a harsh vocal quality.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
