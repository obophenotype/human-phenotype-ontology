    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032139">
        <obo:IAO_0000115 xml:lang="cs">Snížená hladina izohemaglutininu pod očekávanou koncentraci. Izohemaglutinin označuje přirozeně se vyskytující protilátky v systému krevních skupin ABO (tj. anti-A u osoby skupiny B, anti-B u osoby skupiny A a anti-A, anti-B a anti-A,B u osoby skupiny O).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená hladina izohemaglutininu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032139"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížená hladina izohemaglutininu pod očekávanou koncentraci. Izohemaglutinin označuje přirozeně se vyskytující protilátky v systému krevních skupin ABO (tj. anti-A u osoby skupiny B, anti-B u osoby skupiny A a anti-A, anti-B a anti-A,B u osoby skupiny O).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Level of isohemagglutinin reduced below expected concentration. An isohemagglutinin refers to the naturally occurring antibodies in the ABO blood group system (i.e., anti-A in a group B person, anti-B in a group A person, and anti-A, anti-B, and anti-A,B in a group O person).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
