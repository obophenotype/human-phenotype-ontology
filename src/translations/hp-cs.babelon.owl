        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002665">
        <obo:IAO_0000115 xml:lang="cs">Karcinom pocházející z lymfocytů a projevující se jako solidní tumor z lymfoidních buněk</obo:IAO_0000115>
