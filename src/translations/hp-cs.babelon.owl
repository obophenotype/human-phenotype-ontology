        <owl:annotatedTarget xml:lang="cs">Forma manifestního strabismu (heterotropie), kdy je jedno oko vychýleno směrem dolů, když jsou obě oči otevřené.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
