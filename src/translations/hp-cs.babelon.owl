    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0040248">
        <obo:IAO_0000115 xml:lang="cs">Snížená aktivita inhibitoru aktivátoru plazminogenu 1. Tento protein snižuje regulaci fibrinolýzy v cirkulaci tím, že inhibuje dva hlavní aktivátory plazminogenu: tkáňový aktivátor plazminogenu a urokinázový aktivátor plazminogenu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížená aktivita inhibitoru aktivátoru plazminogenu 1</rdfs:label>
