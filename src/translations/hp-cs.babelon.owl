        <owl:annotatedTarget xml:lang="cs">Zvýšená echogenita (výšší jas na sonografickém snímku ve stupních šedi) čočky plodu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased echogenicity (increased brightness in the gray-scale sonography image) of the lens of a fetus.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
