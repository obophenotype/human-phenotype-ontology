        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Upper limb muscle weakness</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003487">
        <obo:IAO_0000115 xml:lang="cs">Zvednutí palce (a někdy vějířování ostatních prstů) v reakci na stimulaci plosky nohy. Pokud je přítomen Babinského znak, může to znamenat poškození kortikospinálního traktu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Babinského příznak</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003487"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvednutí palce (a někdy vějířování ostatních prstů) v reakci na stimulaci plosky nohy. Pokud je přítomen Babinského znak, může to znamenat poškození kortikospinálního traktu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Upturning of the big toe (and sometimes fanning of the other toes) in response to stimulation of the sole of the foot. If the Babinski sign is present it can indicate damage to the corticospinal tract.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003487"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Babinského příznak</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Babinski sign</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003489">
        <rdfs:label xml:lang="cs">Akutní epizody neuropatických symptomů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
