    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020201">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli strukturální vada sarkomery, jež je základní jednotkou myofibril ve svalové buňce, obsahuje překrývající se tlustá a tenká vlákna mezi dvěma sousedními Z disky</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie sarkomery</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020201"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoli strukturální vada sarkomery, jež je základní jednotkou myofibril ve svalové buňce, obsahuje překrývající se tlustá a tenká vlákna mezi dvěma sousedními Z disky</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any structural anomaly of the sarcomere, which is unit of a myofibril in a muscle cell, composed of an array of overlapping thick and thin filaments between two adjacent Z disks.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020201"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální morfologie sarkomery</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal sarcomere morphology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020202">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli strukturální vada Z-disku, což je deskovitá oblast sarkomery, ve které jsou ukotveny +konce aktinových vláken</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie Z-disku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020202"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoli strukturální vada Z-disku, což je deskovitá oblast sarkomery, ve které jsou ukotveny +konce aktinových vláken</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any structural anomaly of the Z disk, which is the platelike region of a muscle sarcomere to which the plus ends of actin filaments are attached.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020202"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální morfologie Z-disku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal Z disk morphology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020203">
        <obo:IAO_0000115 xml:lang="cs">Rozšíření či natažení z-disku, který pak již není omezen na úzkou zónu, která protíná I proužek. Z-disk se může klikatě táhnout napříč I proužkem nebo celou sarkomerou. Současně dochází k ohniskovému zesílení a roztažení z-disku. Myofibrilární dezorganizace je častou, ale ne neměnnou doprovodnou změnou</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Rozšíření pásma Z (Z-disku)</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020203"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Rozšíření či natažení z-disku, který pak již není omezen na úzkou zónu, která protíná I proužek. Z-disk se může klikatě táhnout napříč I proužkem nebo celou sarkomerou. Současně dochází k ohniskovému zesílení a roztažení z-disku. Myofibrilární dezorganizace je častou, ale ne neměnnou doprovodnou změnou</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Streaming or smearing of the Z band, which is then no longer confined to a narrow zone which bisects the I band. The Z disk may extend across the I band or the entire sarcomere in a zigzag manner. Focal thickening, smudging, and blurring of the Z band takes place concurrently. Myofibrillar disorganization is a frequent but not invariable accompanying change.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020203"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Rozšíření pásma Z (Z-disku)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Z-band streaming</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
