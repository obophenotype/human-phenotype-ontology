    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030853">
        <obo:IAO_0000115 xml:lang="cs">Anomálie, při níž vnitřní hrudní a břišní orgány vykazují abnormální uspořádání napříč levopravou osou těla</obo:IAO_0000115>
