        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired toe-walking ability</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034053">
        <rdfs:label xml:lang="cs">Snížená aktivita kyselé ceramidázy</rdfs:label>
