    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025480">
        <obo:IAO_0000115 xml:lang="cs">Typ páteřního dysrafismu projevující se jako podkožní tuková hmota, tedy defektem páteře spojeným s lipomatózní tkání pokrytým kůží. Obvyklou lokalizací lipomyelomeningokély je gluteální rozštěp</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Lipomyelomeningokéla</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025480"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ páteřního dysrafismu projevující se jako podkožní tuková hmota, tedy defektem páteře spojeným s lipomatózní tkání pokrytým kůží. Obvyklou lokalizací lipomyelomeningokély je gluteální rozštěp</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of spinal dysraphism presenting as a subcutaneous fatty mass, that is, a spinal defect associated with lipomatous tissue, and covered by skin. The most usual location for lipomyelomeningocele is at the gluteal cleft.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
