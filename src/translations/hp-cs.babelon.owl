    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002843">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita T-buněk</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální morfologie T-buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002843"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormalita T-buněk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal increase or decrease of total or subset T cell count. T cells are commonly characterized as CD3+ lymphocytes, or their subpopulations, in the blood, compared to a reference range for a given sex and age-group, measured ex vivo. These may include both TCR alpha/beta and gamma/delta T cells.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002843"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální morfologie T-buněk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal T cell morphology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002846">
        <obo:IAO_0000115 xml:lang="cs">Strukturní abnormalita B buněk</obo:IAO_0000115>
