    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000618">
        <obo:IAO_0000115 xml:lang="cs">Slepota je definována jako ztráta zrakového vnímání při zrakové ostrosti menší než 3/60 nebo při velikosti zrakového pole užší než 10 stupňů kolem centrálního bodu fixace.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Slepota</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000618"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Slepota je definována jako ztráta zrakového vnímání při zrakové ostrosti menší než 3/60 nebo při velikosti zrakového pole užší než 10 stupňů kolem centrálního bodu fixace.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Blindness is the condition of lacking visual perception defined as a profound reduction in visual perception. On the 6m visual acuity scale, blindness is defined as less than 3/60. On the 20ft visual acuity scale, blindness is defined as less than 20/400. On the decimal visual acuity scale, blindness is defined as less than 0.05. Blindness is typically characterized by a visual field of no greater than 10 degrees in radius around central fixation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000618"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Slepota</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Blindness</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000619">
        <obo:IAO_0000115 xml:lang="cs">Snížená schopnost konvergence - souhybu očí směrem k nosu k zaostření na blízký předmět</obo:IAO_0000115>
