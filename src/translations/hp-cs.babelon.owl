    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030752">
        <obo:IAO_0000115 xml:lang="cs">Obstrukce nasolakrimálního kanálu projevující se jako šedomodrý cystický otok těsně pod mediálním koutkem. Předpokládá se, že je to důsledek současné horní obstrukce Rosenmullerovy chlopně a dolní obstrukce Hasnerovy chlopně.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Dakryocystokéla</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030752"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Obstrukce nasolakrimálního kanálu projevující se jako šedomodrý cystický otok těsně pod mediálním koutkem. Předpokládá se, že je to důsledek současné horní obstrukce Rosenmullerovy chlopně a dolní obstrukce Hasnerovy chlopně.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A nasolacrimal duct obstruction presenting as a grey-blue cystic swelling just below the medial canthus. Believed to be a result of concomitant upper obstruction of the Rosenmuller valve and lower obstruction of the Hasner valve.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
