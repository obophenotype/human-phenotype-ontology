    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000002">
        <obo:IAO_0000115 xml:lang="cs">Odchylka od normy pro výšku, která je očekávána pro daný věk a pohlaví</obo:IAO_0000115>
