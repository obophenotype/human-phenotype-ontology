        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033803"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ puchýřů, u kterých je štěpná rovina puchýřů umístěna pod lamina densa,</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of blistering in which the cleavage plane of blisters is located below the lamina densa.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
