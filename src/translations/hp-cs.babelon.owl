    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005930">
        <obo:IAO_0000115 xml:lang="cs">Anomálie epifýzy, což je rozšířený kloubní konec dlouhé kosti, který se vyvíjí ze sekundárního osifikačního centra a který je v období růstu buď zcela chrupavčitý, nebo je od diafýzy oddělen chrupavčitou ploténkou.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormalita morfologie epifýzy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005930"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomálie epifýzy, což je rozšířený kloubní konec dlouhé kosti, který se vyvíjí ze sekundárního osifikačního centra a který je v období růstu buď zcela chrupavčitý, nebo je od diafýzy oddělen chrupavčitou ploténkou.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly of epiphysis, which is the expanded articular end of a long bone that developes from a secondary ossification center, and which during the period of growth is either entirely cartilaginous or is separated from the shaft by a cartilaginous disk.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
