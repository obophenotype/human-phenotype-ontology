        <owl:annotatedTarget xml:lang="cs">Depozita kalciových solí v parenchymu dřeně ledviny (nejvnitřnější část ledviny)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The deposition of calcium salts in the parenchyma of the renal medulla (innermost part of the kidney).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
