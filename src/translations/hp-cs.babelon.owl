        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032689">
        <obo:IAO_0000115 xml:lang="cs">Fokální kognitivní záchvat charakterizovaný prožitkem odpojení od sebe nebo okolí, ačkoli si ho uvědomuje, jako počátečním semiologický projevem.</obo:IAO_0000115>
