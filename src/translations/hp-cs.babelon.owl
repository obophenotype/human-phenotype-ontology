        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011716">
        <obo:IAO_0000115 xml:lang="cs">Junkční ektopická tachykardie (JET) je jedinečný typ supraventrikulární arytmie definovaný úzkým QRS komplexem a atrioventrikulární (AV) disociací nebo retrográdním síňovým vedením 1:1.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Junkční ektopická tachykardie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011716"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Junkční ektopická tachykardie (JET) je jedinečný typ supraventrikulární arytmie definovaný úzkým QRS komplexem a atrioventrikulární (AV) disociací nebo retrográdním síňovým vedením 1:1.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Junctional ectopic tachycardia (JET) is a unique type of supraventricular arrhythmia defined by narrow QRS complex and atrioventricular (AV) dissociation or retrograde atrial conduction in a 1:1 pattern.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011716"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Junkční ektopická tachykardie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Junctional ectopic tachycardia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011717">
        <obo:IAO_0000115 xml:lang="cs">Atrioventrikulární reentry tachykardie (AVRT) zahrnuje abnormální elektrické vedení přídatné dráhy. Akcesorní dráha spojující impulsy mezi síní a komorou může být přítomná na kterémkoli místě atrioventrikulární rýhy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Atrioventrikulární reentrantní tachykardie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011717"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Atrioventrikulární reentry tachykardie (AVRT) zahrnuje abnormální elektrické vedení přídatné dráhy. Akcesorní dráha spojující impulsy mezi síní a komorou může být přítomná na kterémkoli místě atrioventrikulární rýhy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Accessory pathway-related atrioventricular reentrant tachycardia (AVRT) involves an abnormal electrical conduction of the accessory pathway. The accessory pathway connecting impulses between the atrium and the ventricle can be seen at any site in the AV groove.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011717"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Atrioventrikulární reentrantní tachykardie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrioventricular reentrant tachycardia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
