        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010024">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost abnormálních kalcifikací ve formě skvrn či teček v epifýzách prvního metakarpu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Skvrnitá epifýza prvního metakarpu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010024"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost abnormálních kalcifikací ve formě skvrn či teček v epifýzách prvního metakarpu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of abnormal punctate (speckled, dot-like) calcifications in the epiphyses of the first metacarpal bone.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
