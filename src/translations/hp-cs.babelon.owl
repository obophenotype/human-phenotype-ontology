    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012823">
        <obo:IAO_0000115 xml:lang="cs">Tato subontologie je navržena tak, aby poskytovala termíny pro charakterizaci a specifikaci fenotypových abnormalit definovaných v subontologii Fenotypové abnormality s ohledem na závažnost, lateralitu, věk nástupu a další aspekty.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Klinický modifikátor</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012823"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Tato subontologie je navržena tak, aby poskytovala termíny pro charakterizaci a specifikaci fenotypových abnormalit definovaných v subontologii Fenotypové abnormality s ohledem na závažnost, lateralitu, věk nástupu a další aspekty.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>This subontology is designed to provide terms to characterize and specify the phenotypic abnormalities defined in the Phenotypic abnormality subontology, with respect to severity, laterality, age of onset, and other aspects.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
