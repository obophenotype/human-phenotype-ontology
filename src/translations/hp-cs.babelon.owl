    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000069">
        <obo:IAO_0000115 xml:lang="cs">Typ abnormálního zájmu charakterizovaný trvalým a intenzivním zaměřením na části hračky/předmětu. Postižení jedinci mohou například roztáčet kola na autíčku, spíše než řídit autíčko.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Trvalé zaujetí částmi objektů</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000069"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ abnormálního zájmu charakterizovaný trvalým a intenzivním zaměřením na části hračky/předmětu. Postižení jedinci mohou například roztáčet kola na autíčku, spíše než řídit autíčko.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of abnormal interest characterized by a persistent and intense focus on parts of a toy/object. For example, affected individuals may spin the wheels on a toy car rather than drive the toy car.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
