    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033314">
        <obo:IAO_0000115 xml:lang="cs">Zvýšený počet viscerálních epiteliálních buněk (2 nebo více vrstev), často se shlukováním a vícevrstevnatými, ale bez kontinuity s parietálním epitelem</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hyperplazie viscerálních epiteliálních buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033314"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšený počet viscerálních epiteliálních buněk (2 nebo více vrstev), často se shlukováním a vícevrstevnatými, ale bez kontinuity s parietálním epitelem</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased number of visceral epithelial cells (2 or more layers), often with crowding and multilayering, but without continuity with the parietal epithelium.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033314"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hyperplazie viscerálních epiteliálních buněk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Visceral epithelial cell hyperplasia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033315">
        <obo:IAO_0000115 xml:lang="cs">Kulaté až ovodiní, PAS reakce (Periodic Acid Schiff) pozitivní, fuchsinofilní cytoplazmatické inkluze ve viscerálních epiteliálních buňkách</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hyalinní kapičky ve viscerálních epiteliálních buňkách</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033315"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kulaté až ovodiní, PAS reakce (Periodic Acid Schiff) pozitivní, fuchsinofilní cytoplazmatické inkluze ve viscerálních epiteliálních buňkách</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Round to ovoid, Periodic acid-Schiff (PAS)-positive, fuchsinophilic cytoplasmic inclusions within visceral epithelial cells.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033315"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hyalinní kapičky ve viscerálních epiteliálních buňkách</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Visceral epithelial hyaline droplets</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033316">
        <obo:IAO_0000115 xml:lang="cs">Glomerulární srpek označuje hyperplastické léze zahrnující 10 % nebo více obvodu Bowmanova pouzdra. Srpky se mohou skládat z různé směsi epiteliální/leukocytární hypercelularity, vláknité matrix a fibrinu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Glomerulární srpkovitý útvar</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033316"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Glomerulární srpek označuje hyperplastické léze zahrnující 10 % nebo více obvodu Bowmanova pouzdra. Srpky se mohou skládat z různé směsi epiteliální/leukocytární hypercelularity, vláknité matrix a fibrinu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Glomerular crescent refers hyperplastic lesions involving 10% or more of the circumference of Bowman&apos;s capsule. Crescents can be composed of a variable mixture of epithelial/leukocyte hypercellularity, fibrous matrix, and fibrin.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033316"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Glomerulární srpkovitý útvar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Glomerular crescent formation</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033317">
        <obo:IAO_0000115 xml:lang="cs">Typ glomerulárního srpku vyznačujícího se extrakapilární hypercelularitou větší než dvě buněčné vrstvy a zahrnující více než 10 % obvodu pouzdra, složený z více než 75 % buněk s fibrinem nebo bez něj a méně než 25% fibrózní matrix</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Celulární srpek</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033317"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ glomerulárního srpku vyznačujícího se extrakapilární hypercelularitou větší než dvě buněčné vrstvy a zahrnující více než 10 % obvodu pouzdra, složený z více než 75 % buněk s fibrinem nebo bez něj a méně než 25% fibrózní matrix</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of glomerular crescent characterized by extracapillary hypercellularity of greater than two cell layers and involving more than 10% of the capsular circumference, composed of greater than 75% cells with or without fibrin, and less than 25% fibrous matrix.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033317"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Celulární srpek</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cellular crescent</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033318">
        <obo:IAO_0000115 xml:lang="cs">Typ glomerulárního srpku vyznačujícího se extrakapilární hypercelularitou ve více než 2 buněčných vrstvách a zahrnující více než 10 % obvodu pouzdra, složený z 25 % až 75 % buněk s fibrinem nebo bez něj a zbytek vláknité matrix</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fibrocelulární srpek</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033318"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ glomerulárního srpku vyznačujícího se extrakapilární hypercelularitou ve více než 2 buněčných vrstvách a zahrnující více než 10 % obvodu pouzdra, složený z 25 % až 75 % buněk s fibrinem nebo bez něj a zbytek vláknité matrix</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of glomerular crescent characterized by extracapillary hypercellularity of more than 2 cell layers and involving over 10% of the capsular circumference, composed of 25% to 75% cells with or without fibrin, and the remainder fibrous matrix.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033318"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fibrocelulární srpek</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fibrocellular crescent</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033319">
        <obo:IAO_0000115 xml:lang="cs">Typ glomerulárního srpku charakterizovaný extrakapilární fibrózou složenou z více než 75 % matrix a méně než 25 % buněk s fibrinem nebo bez něj, obvykle spojený s porušením Bowmanova pouzdra a zahrnující více než 10 % obvodu pouzdra</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fibrózní srpek</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033319"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ glomerulárního srpku charakterizovaný extrakapilární fibrózou složenou z více než 75 % matrix a méně než 25 % buněk s fibrinem nebo bez něj, obvykle spojený s porušením Bowmanova pouzdra a zahrnující více než 10 % obvodu pouzdra</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of glomerular crescent characterized by extracapillary fibrosis composed of greater than 75% matrix and of less than 25% cells with or without fibrin, usually associated with disruption of Bowman&apos;s capsule and involving over 10% of the capsular circumference.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033319"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fibrózní srpek</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fibrous crescent</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033320">
        <obo:IAO_0000115 xml:lang="cs">Ztráta mezangiálních buněk segmentálně nebo globálně</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Úbytek mezangiálních buněk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033320"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Ztráta mezangiálních buněk segmentálně nebo globálně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Loss of mesangial cells segmentally or globally.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033320"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Úbytek mezangiálních buněk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mesangial cell loss</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033321">
        <obo:IAO_0000115 xml:lang="cs">Globálně sklerotické glomeruly jsou malé a bez hyalinózy a mohou se objevit kolapsem klubíčka s kolagenizací močového prostoru. Bowmanovo pouzdro zcela nebo částečně chybí a nevyskytuje se žádná periglomerulární fibróza a velikost glomerulů je zmenšena o více než 50 % ve srovnání se všemi ostatními glomeruly ve stejné biopsii. Může se zdát, že zaniklé glomeruly ustupují do intersticia.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Glomerulární zánik</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033321"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Globálně sklerotické glomeruly jsou malé a bez hyalinózy a mohou se objevit kolapsem klubíčka s kolagenizací močového prostoru. Bowmanovo pouzdro zcela nebo částečně chybí a nevyskytuje se žádná periglomerulární fibróza a velikost glomerulů je zmenšena o více než 50 % ve srovnání se všemi ostatními glomeruly ve stejné biopsii. Může se zdát, že zaniklé glomeruly ustupují do intersticia.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Globally sclerotic glomeruli are that are small and without hyalinosis and may appear with collapse of the tuft with collagenization of the urinary space. Bowman&apos;s capsule is completely or partially absent and there is no periglomerular fibrosis and glomerular size is decreased by more than 50% compared to all other glomeruli in the same biopsy. Obsolescent glomeruli may appear to be receding into the interstitium.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033321"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Glomerulární zánik</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Glomerular obsolescence</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033322">
        <obo:IAO_0000115 xml:lang="cs">Dvojité obrysy původní glomerulární bazální membrány (GBM)/dodatečné vrstvy matrix bazální membrány, s endokapilární hypercelularitou nebo bez ní a bez známek interponovaných migrujících buněk (mezangiálních, endoteliálních, monocytů) mezi vrstvami původní GBM a de novo GBM.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Duplikace stěny glomerulární kapiláry bez buněčné interpozice</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033322"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Dvojité obrysy původní glomerulární bazální membrány (GBM)/dodatečné vrstvy matrix bazální membrány, s endokapilární hypercelularitou nebo bez ní a bez známek interponovaných migrujících buněk (mezangiálních, endoteliálních, monocytů) mezi vrstvami původní GBM a de novo GBM.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Double contouring of the original glomerular basement membrane (GBM)/additional layer(s) of overlying basement membrane matrix, with or without endocapillary hypercellularity and no evidence of interposed migrated cells (mesangial, endothelial, monocytes) between the layers of original GBM and de novo GBM.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033322"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Duplikace stěny glomerulární kapiláry bez buněčné interpozice</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Glomerular capillary wall duplication without cellular interposition</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033323">
        <obo:IAO_0000115 xml:lang="cs">Dvojité obrysy původní glomerulární bazální membrány (GBM)/dodatečné vrstvy matrix bazální membrány s interponovanými migrujícími buňkami (mezangiálními, endoteliálními, monocyty) mezi vrstvami původní GBM a de novo GBM</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Duplikace stěny glomerulární kapiláry s buněčnou interpozicí</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033323"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Dvojité obrysy původní glomerulární bazální membrány (GBM)/dodatečné vrstvy matrix bazální membrány s interponovanými migrujícími buňkami (mezangiálními, endoteliálními, monocyty) mezi vrstvami původní GBM a de novo GBM</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Double contouring of the original glomerular basement membrane (GBM)/additional layer(s) of overlying basement membrane matrix with interposed migrated cells (mesangial, endothelial, monocytes) between the layers of original GBM and de novo GBM.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033323"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Duplikace stěny glomerulární kapiláry s buněčnou interpozicí</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Glomerular capillary wall duplication with cellular interposition</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
