        <owl:annotatedTarget xml:lang="cs">Přítomnost deskvamovaných tubulárních epiteliálních buněk nebo makrofágů naplněných kapičkami lipidů v moči</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
