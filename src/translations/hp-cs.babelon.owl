        <owl:annotatedTarget xml:lang="cs">Opakované případy obstrukce průtoku krve způsobené embolií, tj. krevní sraženinou, která se dostala z místa svého vzniku do krevního oběhu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Repeated episodes of obstruction of blood flow due to an embolus, i.e., blood clot that has traveled from its point of origin within the blood stream.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
