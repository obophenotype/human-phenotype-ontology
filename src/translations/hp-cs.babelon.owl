    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0008443">
        <obo:IAO_0000115 xml:lang="cs">Progresivní degenerativní onemocnění meziobratlového kloubu, ke kterému dochází při jakémkoli stavu charakterizovaném sníženou aferentní inervací, zahrnující ztrátu hlubokého čití a bolesti v páteři. U pacientů se nejčastěji objevují příznaky jako jsou bolesti dolní části zad, nerovnováha vsedě, progresivní deformace páteře (obvykle kyfóza) a slyšitelné lupání při změně polohy</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neuropatická spinální artropatie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0008443"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Progresivní degenerativní onemocnění meziobratlového kloubu, ke kterému dochází při jakémkoli stavu charakterizovaném sníženou aferentní inervací, zahrnující ztrátu hlubokého čití a bolesti v páteři. U pacientů se nejčastěji objevují příznaky jako jsou bolesti dolní části zad, nerovnováha vsedě, progresivní deformace páteře (obvykle kyfóza) a slyšitelné lupání při změně polohy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A progressive disorder of vertebral joint degeneration that occurs in the setting of any condition characterized by decreased afferent innervation, involving loss of deep pain and proprioceptive sensation in the vertebral column. Patients most commonly present with symptoms of lower back pain, sitting imbalance, progressive spinal deformity (usually kyphosis), and an audible clicking sound on changing postures.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0008443"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Neuropatická spinální artropatie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neuropathic spinal arthropathy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
