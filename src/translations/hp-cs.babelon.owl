        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Microcephaly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000253">
        <obo:IAO_0000115 xml:lang="cs">Progresivní mikrocefaliii diagnostikujeme když obvod hlavy postupně zaostává za normou pro příslušný věk a pohlaví</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Progresivní mikrocefalie</rdfs:label>
    </rdf:Description>
