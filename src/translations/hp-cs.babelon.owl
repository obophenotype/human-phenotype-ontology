    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_4000049">
        <obo:IAO_0000115 xml:lang="cs">Typ zlomeniny, při níž je stejná kost zlomena na dvou místech, takže vznikne pohyblivý úsek kosti.</obo:IAO_0000115>
