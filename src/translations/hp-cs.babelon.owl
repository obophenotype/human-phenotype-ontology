        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034281">
        <obo:IAO_0000115 xml:lang="cs">Kónické epifýzy falang na rukou nebo nohou. Kónické epifýzy (taktéž známé jako kuželovité epifýzy) jsou epifýzy zapadající do pohárkovitých metafýz. Takováto epifýza má kuželovité distální prodloužení vzniklé zvýšeným růstem centrální části epifýzy ve srovnání s periferií</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kónická epifýza falangy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034281"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Kónické epifýzy falang na rukou nebo nohou. Kónické epifýzy (taktéž známé jako kuželovité epifýzy) jsou epifýzy zapadající do pohárkovitých metafýz. Takováto epifýza má kuželovité distální prodloužení vzniklé zvýšeným růstem centrální části epifýzy ve srovnání s periferií</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cone-shaped epiphyses of the phalanges of the hands or feet. Cone-shaped epiphyses (also known as coned epiphyses) are epiphyses that invaginate into cupped metaphyses. That is, the epiphysis has a cone-shaped distal extension resulting from increased growth of the central portion of the epiphysis relative to its periphery.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034281"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Kónická epifýza falangy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Phalangeal cone-shaped epiphyses</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0034282">
        <obo:IAO_0000115 xml:lang="cs">Tvorba abnormální extraskeletální kostní tkáně v měkkých tkáních pod kůží. Podkožní osifikace může být prokázána rentgenograficky nebo palpačně</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Podkožní osifikace</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034282"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Tvorba abnormální extraskeletální kostní tkáně v měkkých tkáních pod kůží. Podkožní osifikace může být prokázána rentgenograficky nebo palpačně</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Formation of abnormal, extraskeletal bony tissue in the soft tissue beneath the skin. Subcutaneous ossifications may be observed by radiography or by palpation.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
