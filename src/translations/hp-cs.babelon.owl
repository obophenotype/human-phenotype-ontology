    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010797">
        <obo:IAO_0000115 xml:lang="cs">Hemangioblastom je nezhoubný vaskulární novotvar, který vzniká téměř výhradně v centrálním nervovém systému. Hemangioblastomy se skládají z těsně nahromaděného shluku malých krevních cév tvořících hmotu o průměru až 1-2 cm</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hemangioblastom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010797"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Hemangioblastom je nezhoubný vaskulární novotvar, který vzniká téměř výhradně v centrálním nervovém systému. Hemangioblastomy se skládají z těsně nahromaděného shluku malých krevních cév tvořících hmotu o průměru až 1-2 cm</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A hemangioblastoma is a benign vascular neoplasm that arises almost exclusively in the central nervous system. Hemangioblastomas consist of a tightly packed cluster of small blood vessels forming a mass of up to 1 or 2 cm in diameter.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
