        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025593">
        <obo:IAO_0000115 xml:lang="cs">Mechanické omezení rozsahu pohybu musculus obliquus superior.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Restrikce musculus obliquus superior</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025593"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Mechanické omezení rozsahu pohybu musculus obliquus superior.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mechanical limitation of the range of movement of the superior oblique muscle.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025593"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Restrikce musculus obliquus superior</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Superior oblique muscle restriction</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025594">
        <obo:IAO_0000115 xml:lang="cs">Porucha oční motility charakterizovaná nadměrnou aktivitou musculus obliquus superior, která vede k vertikální inkomitanci očí při bočním pohledu. Při vyšetření se běžně projevuje jako pokles addukovaného oka, který se objevuje při pohledu do pole působení musculus obliquus inferior a způsobuje větší vychýlení addukovaného oka směrem dolů než oka abdukovaného.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nadměrné působení musculus obliquus superior</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025594"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Porucha oční motility charakterizovaná nadměrnou aktivitou musculus obliquus superior, která vede k vertikální inkomitanci očí při bočním pohledu. Při vyšetření se běžně projevuje jako pokles addukovaného oka, který se objevuje při pohledu do pole působení musculus obliquus inferior a způsobuje větší vychýlení addukovaného oka směrem dolů než oka abdukovaného.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An ocular motility abnormality characterized by an overacting superior oblique muscle resulting to vertical incomitance of the eyes in lateral gaze. On examination, this is commonly seen as a downshoot of the adducting eye occurring when gaze is directed into the field of action of the inferior oblique muscle, producing a greater downward excursion of the adducted eye than of the abducted eye.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025594"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nadměrné působení musculus obliquus superior</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Superior oblique muscle overaction</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025595">
        <obo:IAO_0000115 xml:lang="cs">Snížený pohyb musculus obliquus superior, který se zlepšuje při testovacích úkonech, typicky spojený s neurogenní obrnou.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nedostatečné působení musculus obliquus superior</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025595"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížený pohyb musculus obliquus superior, který se zlepšuje při testovacích úkonech, typicky spojený s neurogenní obrnou.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced ocular movement of the superior oblique muscle which improves on testing ductions, typically associated with neurogenic palsy.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025595"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nedostatečné působení musculus obliquus superior</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Superior oblique muscle underaction</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025596">
        <obo:IAO_0000115 xml:lang="cs">Funkční anomálie dolního šikmého svalu, extraokulárního svalu, který má svůj původ na čelistní kosti těsně za dolním mediálním okrajem očnice a laterálně od nososlzného kanálu a který je inervován dolní větví okohybného nervu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální fyziologie musculus obliquus inferior</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025596"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Funkční anomálie dolního šikmého svalu, extraokulárního svalu, který má svůj původ na čelistní kosti těsně za dolním mediálním okrajem očnice a laterálně od nososlzného kanálu a který je inervován dolní větví okohybného nervu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A functional anomaly of the inferior oblique muscle, an extraocular muscle that has its origin on the maxillary bone just posterior to the inferior medial orbital rim and lateral to the nasolacrimal canal and that is innervated by the inferior branch of the oculomotor nerve.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025596"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální fyziologie musculus obliquus inferior</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal inferior oblique muscle physiology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025597">
        <obo:IAO_0000115 xml:lang="cs">Mechanické omezení rozsahu pohybu musculus obliquus inferior.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Restrikce musculus obliquus inferior</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025597"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Mechanické omezení rozsahu pohybu musculus obliquus inferior.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mechanical limitation of the range of movement of the inferior oblique muscle.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025597"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Restrikce musculus obliquus inferior</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inferior oblique muscle restriction</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025598">
        <obo:IAO_0000115 xml:lang="cs">Snížená síla musculus obliquus inferior</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Slabost musculus obliquus inferior</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025598"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížená síla musculus obliquus inferior</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased strength of the inferior oblique muscle.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025598"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Slabost musculus obliquus inferior</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inferior oblique muscle weakness</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025599">
        <obo:IAO_0000115 xml:lang="cs">Častá porucha oční motility charakterizovaná vertikální inkomitancí očí při bočním pohledu. Při nadměrném působení musculus obliquus inferior, dojde k vytažení addukovaného oka, když je pohled nasměrován do pole působnosti musculus obliquus inferior, což způsobí větší vychýlení addukovaného oka směrem nahoru než oka abdukovaného.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Nadměrné působení musculus obliquus inferior</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025599"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Častá porucha oční motility charakterizovaná vertikální inkomitancí očí při bočním pohledu. Při nadměrném působení musculus obliquus inferior, dojde k vytažení addukovaného oka, když je pohled nasměrován do pole působnosti musculus obliquus inferior, což způsobí větší vychýlení addukovaného oka směrem nahoru než oka abdukovaného.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A common ocular motility disorder characterized by vertical incomitance of the eyes in lateral gaze. In primary inferior oblique muscle overaction, an upshoot of the adducting eye occurs when gaze is directed into the field of action of the inferior oblique muscle, producing a greater upward excursion of the adducted eye than of the abducted eye.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025599"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Nadměrné působení musculus obliquus inferior</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inferior oblique muscle overaction</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025600">
        <obo:IAO_0000115 xml:lang="cs">Funkční anomálie musculus rectus inferior, který je inervován dolní částí okohybného nervu a funguje při depresi, addukci a laterální rotaci (extorci) oka.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální fyziologie musculus rectus inferior</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025600"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Funkční anomálie musculus rectus inferior, který je inervován dolní částí okohybného nervu a funguje při depresi, addukci a laterální rotaci (extorci) oka.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A functional anomaly of the inferior rectus muscle, which is innervated by the inferior division of oculomotor nerve and functions in the depression, adduction, and lateral rotation (extortion) of the eye.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
