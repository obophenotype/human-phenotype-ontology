    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033411">
        <obo:IAO_0000115 xml:lang="cs">Neschopnost iniciovat změnu činnosti nebo pohybu a rychle a snadno provádět běžné volní pohyby dolních končetin</obo:IAO_0000115>
