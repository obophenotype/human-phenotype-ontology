    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031908">
        <obo:IAO_0000115 xml:lang="cs">Abnormálně malý rukopis formálně definovaný jako porucha jemné motoriky, která se projevuje především progresivním nebo stabilním snížením amplitudy při psaní.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mikrografie</rdfs:label>
    </rdf:Description>
