    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030061">
        <obo:IAO_0000115 xml:lang="cs">Novotvar vznikající z neuroektodermu, části ektodermu raného embrya, která vede ke vzniku centrálního a periferního nervového systému, včetně některých gliových buněk</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Neuroektodermální novotvar</rdfs:label>
    </rdf:Description>
