    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002280">
        <obo:IAO_0000115 xml:lang="cs">Zvětšení cisterna magna, jednoho ze tří hlavních průchodů v subarachnoidálním prostoru mezi arachnoideou a pia mater, který se nachází mezi mozečkem a dorzálním povrchem prodloužené míchy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvětšená cisterna magna</rdfs:label>
    </rdf:Description>
