        <obo:IAO_0000115 xml:lang="cs">Čistě subjektivní projev epileptického záchvatu související se změněnou kognicí.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kognitivní epileptická aura</rdfs:label>
