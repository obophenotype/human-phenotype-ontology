    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033796">
        <obo:IAO_0000115 xml:lang="cs">Funkční abnormalita leukocytu (bílé krvinky).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální fyziologie leukocytu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033796"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
