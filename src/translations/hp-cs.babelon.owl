    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032052">
        <obo:IAO_0000115 xml:lang="cs">Podtyp fokální kortikální dysplazie typu II, který je charakterizován dysmorfními neurony, které se projevují výrazně zvětšeným buněčným tělem a jádrem, špatnou orientací, abnormálně distribuovanouNisslovou substancí a cytoplazmatickou akumulací neurofilamentových proteinů</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kortikální dysplázie typ IIa</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032052"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Podtyp fokální kortikální dysplazie typu II, který je charakterizován dysmorfními neurony, které se projevují výrazně zvětšeným buněčným tělem a jádrem, špatnou orientací, abnormálně distribuovanouNisslovou substancí a cytoplazmatickou akumulací neurofilamentových proteinů</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A subtype of focal cortical dysplasia type II that is characterized by dysmorphic neurons, which present with a significantly enlarged cell body and nucleus, malorientation, abnormally distributed intracellular Nissl substance and cytoplasmic accumulation of neurofilament proteins.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032052"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kortikální dysplázie typ IIa</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cortical dysplasia type IIa</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032053">
        <obo:IAO_0000115 xml:lang="cs">Podtyp fokální kortikální dysplazie typu II, který je charakterizován dysmorfními neurony (výrazně zvětšenými s akumulací proteinů neurofilament) a balónkovými buňkami.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kortikální dysplázie typ IIb</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032053"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Podtyp fokální kortikální dysplazie typu II, který je charakterizován dysmorfními neurony (výrazně zvětšenými s akumulací proteinů neurofilament) a balónkovými buňkami.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A subtype of focal cortical dysplasia type II that is characterized by dysmorphic neurons (significantly enlarged with accumulation of neurofilament proteins) and balloon cells.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032053"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kortikální dysplázie typ IIb</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cortical dysplasia type IIb</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032054">
        <obo:IAO_0000115 xml:lang="cs">Typ fokální kortikální dysplazie charakterizováný abnormalitami kortikální laminace spojenými s hlavní lézí, která obvykle sousedí se stejnou kortikální oblastí nebo postihuje stejný kortikální lalok.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kortikální dysplázie typ III</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032054"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ fokální kortikální dysplazie charakterizováný abnormalitami kortikální laminace spojenými s hlavní lézí, která obvykle sousedí se stejnou kortikální oblastí nebo postihuje stejný kortikální lalok.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of focal cortical dysplasia that is characterized by cortical lamination abnormalities associated with a principal lesion, usually adjacent to or affecting the same cortical area/lobe.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032054"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kortikální dysplázie typ III</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cortical dysplasia type III</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032055">
        <obo:IAO_0000115 xml:lang="cs">Podtyp fokální kortikální dysplazie typu III, který je charakterizován změnami v architektonické organizaci (kortikální dyslaminace) nebo cytoarchitektonickém složení (hypertrofické neurony mimo vrstvu 5) u pacientů s hipokampální sklerózou.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kortikální dysplázie typ IIIa</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032055"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Podtyp fokální kortikální dysplazie typu III, který je charakterizován změnami v architektonické organizaci (kortikální dyslaminace) nebo cytoarchitektonickém složení (hypertrofické neurony mimo vrstvu 5) u pacientů s hipokampální sklerózou.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A subtype of focal cortical dysplasia type III that is characterized by alterations in architectural organization (cortical dyslamination) or cytoarchitectural composition (hypertrophic neurons outside Layer 5) in patients with hippocampal sclerosis (also known as Ammon&apos;s horn sclerosis).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032055"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kortikální dysplázie typ IIIa</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cortical dysplasia type IIIa</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032056">
        <obo:IAO_0000115 xml:lang="cs">Podtyp fokální kortikální dysplazie typu III, který se vyznačuje změněným architektonickým (kortikální dyslaminace, hypoplazie bez šestivrstevné struktury) a/nebo cytoarchitektonickým složením (hypertrofické neurony) neokortexu, které se vyskytují v blízkosti gliového nebo glioneuronálního nádoru.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kortikální dysplázie typ IIIb</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032056"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Podtyp fokální kortikální dysplazie typu III, který se vyznačuje změněným architektonickým (kortikální dyslaminace, hypoplazie bez šestivrstevné struktury) a/nebo cytoarchitektonickým složením (hypertrofické neurony) neokortexu, které se vyskytují v blízkosti gliového nebo glioneuronálního nádoru.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A subtype of focal cortical dysplasia type III that is characterized by altered architectural (cortical dyslamination, hypoplasia without six-layered structure) and/or cytoarchitectural composition (hypertrophic neurons) of the neocortex, which occur adjacent to glial or glioneuronal tumor.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032056"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kortikální dysplázie typ IIIb</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cortical dysplasia type IIIb</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032057">
        <obo:IAO_0000115 xml:lang="cs">Podtyp fokální kortikální dysplazie typu III, který je charakterizován změnami v architektonickém (kortikální dyslaminace, hypoplazie) nebo cytoarchitektonickém složení neokortexu (hypertrofické neurony), které se vyskytují v sousedství vaskulárních malformací (kavernomy, arteriovenózní malformace, leptomeningeální vaskulární malformace, teleangiektázie, meningioangiomatóza).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kortikální dysplázie typ IIIc</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032057"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Podtyp fokální kortikální dysplazie typu III, který je charakterizován změnami v architektonickém (kortikální dyslaminace, hypoplazie) nebo cytoarchitektonickém složení neokortexu (hypertrofické neurony), které se vyskytují v sousedství vaskulárních malformací (kavernomy, arteriovenózní malformace, leptomeningeální vaskulární malformace, teleangiektázie, meningioangiomatóza).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A subtype of focal cortical dysplasia type III that is characterized by alterations in architectural (cortical dyslamination, hypoplasia) or cytoarchitectural composition of the neocortex (hypertrophic neurons), which occur adjacent to vascular malformations (cavernomas, arteriovenous malformations, leptomeningeal vascular malformations, telangiectasias, meningioangiomatosis).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032057"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kortikální dysplázie typ IIIc</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cortical dysplasia type IIIc</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032058">
        <obo:IAO_0000115 xml:lang="cs">Podtyp fokální kortikální dysplazie typu III, který je charakterizován změněnou architektonickou (kortikální dyslaminace, hypoplázie bez šestivrstevné struktury) nebo cytoarchitektonickou skladbou (hypertrofické neurony) neokortexu, která se vyskytuje v sousedství jiných lézí získaných v raném věku (není zahrnuta do FCD typu IIIa-c). Tyto léze zahrnují široké spektrum od traumatického poškození mozku, přes gliové jizvy po prenatálním nebo perinatálním ischemickém poškození nebo krvácení a zánětlivá nebo infekční onemocnění, tj. Rasmussenovu encefalitidu, limbickou encefalitidu, bakteriální nebo virové infekce.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Fokální kortikální dysplázie typ IIId</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032058"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Podtyp fokální kortikální dysplazie typu III, který je charakterizován změněnou architektonickou (kortikální dyslaminace, hypoplázie bez šestivrstevné struktury) nebo cytoarchitektonickou skladbou (hypertrofické neurony) neokortexu, která se vyskytuje v sousedství jiných lézí získaných v raném věku (není zahrnuta do FCD typu IIIa-c). Tyto léze zahrnují široké spektrum od traumatického poškození mozku, přes gliové jizvy po prenatálním nebo perinatálním ischemickém poškození nebo krvácení a zánětlivá nebo infekční onemocnění, tj. Rasmussenovu encefalitidu, limbickou encefalitidu, bakteriální nebo virové infekce.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A subtype of focal cortical dysplasia type III that is characterized by altered architectural (cortical dyslamination, hypoplasia without six-layered structure) or cytoarchitectural composition (hypertrophic neurons) of the neocortex, which occur adjacent to other lesions acquired during early life (not included into FCD Type IIIa-c). These lesions comprise a large spectrum including traumatic brain injury, glial scarring after prenatal or perinatal ischemic injury or bleeding, and inflammatory or infectious diseases, i.e. Rasmussen encephalitis, limbic encephalitis, bacterial or viral infections.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032058"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Fokální kortikální dysplázie typ IIId</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cortical dysplasia type IIId</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032059">
        <obo:IAO_0000115 xml:lang="cs">Malformace kortikálního vývoje charakterizovaná mírnými abnormalitami kůry: heterotopické neurony ve vrstvě 1 nebo mikroskopické neuronové shluky nebo nadbytek jednotlivých neuronů normální morfologie v hluboké bílé hmotě</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mírná malformace kortikálního vývoje</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032059"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Malformace kortikálního vývoje charakterizovaná mírnými abnormalitami kůry: heterotopické neurony ve vrstvě 1 nebo mikroskopické neuronové shluky nebo nadbytek jednotlivých neuronů normální morfologie v hluboké bílé hmotě</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A malformation of cortical development characterized by mild abnormalities of the cortex: excessive heterotopic neurons in Layer 1 or microscopic neuronal clusters or excess of single neurons of normal morphology in deep white matter.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032059"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mírná malformace kortikálního vývoje</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mild malformation of cortical development</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032060">
        <obo:IAO_0000115 xml:lang="cs">Benigní novotvar, který zahrnuje proliferaci krevních cév a hustý eozinofilní zánětlivý infiltrát, projevující se jako svědivé uzliny a papuly barvy švestek nebo masa, nejčastěji postihující ucho a periaurikulární oblast</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Epiteloidní hemangiom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032060"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Benigní novotvar, který zahrnuje proliferaci krevních cév a hustý eozinofilní zánětlivý infiltrát, projevující se jako svědivé uzliny a papuly barvy švestek nebo masa, nejčastěji postihující ucho a periaurikulární oblast</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A benign neoplasm that includes blood vessel proliferation and a dense eosinophilic inflammatory infiltrate, manifesting as flesh/plum-colored pruritic nodules and papules, most commonly affecting the ear and the periauricular area.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032060"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Epiteloidní hemangiom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Epithelioid hemangioma</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032061">
        <obo:IAO_0000115 xml:lang="cs">Výrazně zvýšený počet eozinofilů v krvi definovaný jako počet eozinofilů v krvi 1,5 × 10e9/l nebo vyšší (jedna a půl miliardy buněk na litr).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hypereozinofilie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032061"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Výrazně zvýšený počet eozinofilů v krvi definovaný jako počet eozinofilů v krvi 1,5 × 10e9/l nebo vyšší (jedna a půl miliardy buněk na litr).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Severe increase in circulating eosinophils, usually characterized as more than 1500 eosinophils per microlitre.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
