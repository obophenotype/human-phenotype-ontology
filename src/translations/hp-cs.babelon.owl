    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033532">
        <obo:IAO_0000115 xml:lang="cs">Snížený objem krve přečerpané levou a pravou komorou za jednotku času. Srdeční výdej (CO) je součinem srdeční frekvence (HR), tj. počtu srdečních tepů za minutu (bpm), a systolického objemu (SV), což je objem krve přečerpané z komory za jeden tep.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Snížený srdeční výdej</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033532"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížený objem krve přečerpané levou a pravou komorou za jednotku času. Srdeční výdej (CO) je součinem srdeční frekvence (HR), tj. počtu srdečních tepů za minutu (bpm), a systolického objemu (SV), což je objem krve přečerpané z komory za jeden tep.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A decreased volume of blood pumped by the left and right ventricle, per unit time. Cardiac output (CO) is the product of the heart rate (HR), i.e. the number of heartbeats per minute (bpm), and the stroke volume (SV), which is the volume of blood pumped from the ventricle per beat.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
