    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033666">
        <obo:IAO_0000115 xml:lang="cs">Snížení schopnosti vykonávat činnosti každodenního života ve srovnání s předchozími schopnostmi z důvodu funkčního deficitu způsobeného nemocí. Jednou z mnoha metod, které se používají k měření vnímání snížené fyzické funkčnosti pacientů, je 36položkový dotazník SF-36 (Short Form Health Survey).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zhoršené fyzické zdraví</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033666"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížení schopnosti vykonávat činnosti každodenního života ve srovnání s předchozími schopnostmi z důvodu funkčního deficitu způsobeného nemocí. Jednou z mnoha metod, které se používají k měření vnímání snížené fyzické funkčnosti pacientů, je 36položkový dotazník SF-36 (Short Form Health Survey).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduction in the ability to perform activities of daily living as compared to previous abilities because of functional deficits due to illness. The 36-item Short Form (SF-36) health survey questionnaire is one of many methods used to measure patients&apos; perceptions of diminished physical functioning.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
