    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009760">
        <obo:IAO_0000115 xml:lang="cs">Pterygium postihující loketní kloub. Jedná se o kožní řasu, která může vést k závažným flexním kontrakturám loketního kloubu. Antekubutální pterygia mohou být jednostranné, oboustranné, symetrické nebo asymetrické.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Antekubitální pterygium</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009760"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Pterygium postihující loketní kloub. Jedná se o kožní řasu, která může vést k závažným flexním kontrakturám loketního kloubu. Antekubutální pterygia mohou být jednostranné, oboustranné, symetrické nebo asymetrické.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pterygium affecting the elbow. This is a cutaneous web that can lead to severe flexion contracture of the elbow joint. Antecubital pterygium can be unilateral, bilateral, symmetric, or asysmmetric.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
