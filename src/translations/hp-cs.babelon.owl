    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500075">
        <obo:IAO_0000115 xml:lang="cs">Změna horizontálního uspořádání očí, která nesouvisí s akomodací a je způsobena pouze změnou rovnováhy zrakových vstupů z obou očí.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Disociovaná horizontální odchylka</rdfs:label>
