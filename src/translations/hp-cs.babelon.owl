    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032488">
        <obo:IAO_0000115 xml:lang="cs">Jakákoli odchylka od normálního pH výkalů. pH vyjadřuje kyselost nebo zásaditost roztoku na logaritmické stupnici, na které je 7 neutrální, přičemž nižší hodnoty jsou kyselejší a vyšší zásaditější.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální pH stolice</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032488"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Jakákoli odchylka od normálního pH výkalů. pH vyjadřuje kyselost nebo zásaditost roztoku na logaritmické stupnici, na které je 7 neutrální, přičemž nižší hodnoty jsou kyselejší a vyšší zásaditější.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any deviation from the normal pH of feces. The pH reflects the acidity or alkalinity of a solution on a logarithmic scale on which 7 is neutral, whereby lower values are more acid and higher values more alkaline.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
