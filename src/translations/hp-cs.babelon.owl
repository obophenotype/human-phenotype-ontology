    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031487">
        <obo:IAO_0000115 xml:lang="cs">Cévní malformace lokalizovaná na rtu, charakterizovaná rozšířenými kapilárami papilární vrstvy dermis a rozšířenými postkapilárními venulami horní části retikulární vrstvy dermis.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Kapilární malformace rtu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
