        <owl:annotatedTarget xml:lang="cs">Přítomnost autoprotilátek (imunoglobulinů) v séru, které reagují na 60-kd protein obsažený v cytosolu jaterních buněk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
