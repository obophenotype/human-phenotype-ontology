        <owl:annotatedTarget xml:lang="cs">Solitární vrozená hypertrofie retinálního pigmentového epitelu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Solitary congenital hypertrophy of retinal pigment epithelium</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011529">
        <obo:IAO_0000115 xml:lang="cs">Ostře ohraničená hyperpigmentace, která je vrozená.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mnohočetná oboustranná vrozená hypertrofie pigmentového epitelu sítnice</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011529"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Ostře ohraničená hyperpigmentace, která je vrozená.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Unilateral or bilateral small, well-demarcated pigmented lesions localized in the retinal pigment epithelium (RPE). Lesions are dark in the center, with a pale circumference and are mostly located in the periphery.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011529"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Mnohočetná oboustranná vrozená hypertrofie pigmentového epitelu sítnice</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Multiple congenital hypertrophy of retinal pigment epithelium</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011530">
        <obo:IAO_0000115 xml:lang="cs">Malá prasklina v sítnici.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Sítnicová díra</rdfs:label>
    </rdf:Description>
