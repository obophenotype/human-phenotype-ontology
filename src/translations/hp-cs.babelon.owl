        <owl:annotatedTarget xml:lang="cs">Abnormální hladina cirkulujícího thyreoglobulinu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal circulating thyroglobulin concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025484">
        <obo:IAO_0000115 xml:lang="cs">Abnormální zvýšení koncentrace tyreoglobulinu, bílkoviny produkované ve štítné žláze, která působí jako prekurzor hormonů štítné žlázy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zvýšená hladina cirkulujícího thyreoglobulinu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025484"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální zvýšení koncentrace tyreoglobulinu, bílkoviny produkované ve štítné žláze, která působí jako prekurzor hormonů štítné žlázy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The concentration of thyroglobulin in the blood circulation is above the upper limit of normal.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025484"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zvýšená hladina cirkulujícího thyreoglobulinu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elevated circulating thyroglobulin concentration</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025485">
        <obo:IAO_0000115 xml:lang="cs">Vaginální adenóza je definována přítomností metaplastického epitelu děložního hrdla nebo endometria ve stěně pochvy, o němž se předpokládá, že pochází z perzistujících ostrůvků Müllerova (synonymum pro paramesonefrický) epitelu v postembryonálním životě.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Vaginální adenóza</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025485"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Vaginální adenóza je definována přítomností metaplastického epitelu děložního hrdla nebo endometria ve stěně pochvy, o němž se předpokládá, že pochází z perzistujících ostrůvků Müllerova (synonymum pro paramesonefrický) epitelu v postembryonálním životě.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Vaginal adenosis is defined by the presence of metaplastic cervical or endometrial epithelium within the vaginal wall, thought to be derived from persistent Müllerian (synonymous with paramesonephric) epithelium islets in postembryonic life.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025485"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Vaginální adenóza</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Vaginal adenosis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025486">
