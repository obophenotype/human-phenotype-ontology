    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012193">
        <obo:IAO_0000115 xml:lang="cs">&quot;Typ T-lymfomu, který je charakterizován tzv. &quot;&quot;puncovními&quot;&quot; buňkami pleomorfního vzhledu, které exprimují antigen CD30. Tyto tzv. &quot;&quot;puncovní&quot;&quot; buňky mají laločnatá a vroubkovaná jádra&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Anaplastický velkobuněčný lymfom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012193"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">&quot;Typ T-lymfomu, který je charakterizován tzv. &quot;&quot;puncovními&quot;&quot; buňkami pleomorfního vzhledu, které exprimují antigen CD30. Tyto tzv. &quot;&quot;puncovní&quot;&quot; buňky mají laločnatá a vroubkovaná jádra&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of T-cell lymphoma that is characterized by so-called hallmark cells with a pleomorphic appearance that express the CD30 antigen, are lobulated, and have indented nuclei.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
