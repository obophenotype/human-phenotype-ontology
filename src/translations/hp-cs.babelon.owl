        <babelon:source_value>Left ventricular hypertrophy</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001713">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita srdečních komor</obo:IAO_0000115>
