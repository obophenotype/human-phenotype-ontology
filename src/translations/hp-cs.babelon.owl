    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031853">
        <obo:IAO_0000115 xml:lang="cs">Izomerismus v kontextu vrozené vady srdce je definována jako situace, kdy některé párové struktury na opačných stranách levopravé osy těla jsou z morfologického hlediska navzájem symetrickými zrcadlovými obrazy.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Izomerismus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031853"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Izomerismus v kontextu vrozené vady srdce je definována jako situace, kdy některé párové struktury na opačných stranách levopravé osy těla jsou z morfologického hlediska navzájem symetrickými zrcadlovými obrazy.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Isomerism in the context of the congenitally malformed heart is defined as a situation where some paired structures on opposite sides of the left-right axis of the body are, in morphologic terms, symmetrical mirror images of each other.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031853"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Izomerismus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Isomerism</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031854">
        <obo:IAO_0000115 xml:lang="cs">Druh heterotaxie kdy některé z párových struktur na opačných stranách pravolevé osy těla jsou vzájemným symetrickým zrcadlovým obrazem a mají morfologii normálních levostranných struktur</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Levý izomerismus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031854"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Druh heterotaxie kdy některé z párových struktur na opačných stranách pravolevé osy těla jsou vzájemným symetrickým zrcadlovým obrazem a mají morfologii normálních levostranných struktur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of heterotaxy where some paired structures on opposite sides of the left-right axis of the body are symmetrical mirror images of each other, and have the morphology of the normal left-sided structures.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031854"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Levý izomerismus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Left Isomerism</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031855">
        <obo:IAO_0000115 xml:lang="cs">Druh heterotaxie kdy některé z párových struktur na opačných stranách pravolevé osy těla jsou vzájemným symetrickým zrcadlovým obrazem a mají morfologii normálních pravostranných struktur</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pravý izomerismus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031855"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Druh heterotaxie kdy některé z párových struktur na opačných stranách pravolevé osy těla jsou vzájemným symetrickým zrcadlovým obrazem a mají morfologii normálních pravostranných struktur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of heterotaxy where some paired structures on opposite sides of the left-right axis of the body are symmetrical mirror images of each other, and have the morphology of the normal right-sided structures.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031855"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Pravý izomerismus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Right isomerism</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031856">
        <obo:IAO_0000115 xml:lang="cs">Abnormální chůze charakterizovaná chůzí po špičkách, ztuhlýma nohama a přeskakováním. Vzorec chůze se do jisté míry podobá kohoutí chůzi, ale postižení jedinci jsou schopni zlepšit svou dystonickou chůzi chůzí pozpátku.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">&quot;Chůze jako &quot;&quot;s koníkem na tyči&quot;&quot;&quot;</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031856"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Abnormální chůze charakterizovaná chůzí po špičkách, ztuhlýma nohama a přeskakováním. Vzorec chůze se do jisté míry podobá kohoutí chůzi, ale postižení jedinci jsou schopni zlepšit svou dystonickou chůzi chůzí pozpátku.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal gait characterized by toe walking, stiff legs, and skipping. The gait pattern has some resemblance to cock-walk gait, but affected individuals are able to improve their dystonic gait by walking backward.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
