    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001844">
        <obo:IAO_0000115 xml:lang="cs">Tento termíne se používá pro všechny abnormality palce na noze, taktéž známého jako hallux.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormalita palce na noze</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001844"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Tento termíne se používá pro všechny abnormality palce na noze, taktéž známého jako hallux.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>This term applies for all abnormalities of the big toe, also called hallux.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
