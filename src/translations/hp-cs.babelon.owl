    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011571">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita aparátu mitrální chlopně, kdy se šlašinky připojují k jedinému papilárnímu svalu nebo hypoplastickým papilárním svalům</obo:IAO_0000115>
