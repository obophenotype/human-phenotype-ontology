        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031087">
        <obo:IAO_0000115 xml:lang="cs">Náhlé a přechodné zvýšení ročního tempa růstu normálně pozorované u dospívajících jedinců se nevyskytuje</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Absence pubertálního růstového spurtu</rdfs:label>
    </rdf:Description>
