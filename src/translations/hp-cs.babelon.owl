    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033104">
        <obo:IAO_0000115 xml:lang="cs">Nevyvinutí horečky v přítomnosti infekce, která by za normálních okolností měla vyvolat febrilní reakci.</obo:IAO_0000115>
