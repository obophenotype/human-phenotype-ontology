    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031080">
        <obo:IAO_0000115 xml:lang="cs">Anomální odpověď na glukagonový stimulační test, který stejně jako inzulinový toleranční test (ITT) stimuluje uvolňování adrenokortikotropního hormonu (ACTH) a růstového hormonu (GH).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Abnormální reakce na glukagonový stimulační test</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031080"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Anomální odpověď na glukagonový stimulační test, který stejně jako inzulinový toleranční test (ITT) stimuluje uvolňování adrenokortikotropního hormonu (ACTH) a růstového hormonu (GH).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomalous response to the glucagon stimulation test, which like the insulin tolerance test (ITT) stimulates the release of both adrenocorticotropic hormone (ACTH) and growth hormone (GH).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
