        <owl:annotatedTarget xml:lang="cs">Arachnodaktylie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Arachnodactyly</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001167">
        <obo:IAO_0000115 xml:lang="cs">Anomálie prstu</obo:IAO_0000115>
