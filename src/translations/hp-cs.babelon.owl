        <owl:annotatedTarget xml:lang="cs">Chronická ztráta pohyblivosti metakarpofalangeálního kloubu 4. prstu v důsledku strukturálních změn v měkkých/nekostních tkáních</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic loss of joint motion of the metacarpophalangeal joint of the 4th finger due to structural changes in non-bony tissue.</babelon:source_value>
