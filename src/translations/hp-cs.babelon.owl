        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005518">
        <obo:IAO_0000115 xml:lang="cs">Větší než obvyklá velikost erytrocytů</obo:IAO_0000115>
