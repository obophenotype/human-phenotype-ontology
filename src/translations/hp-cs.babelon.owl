        <babelon:source_value>Abnormal respiratory epithelium morphology</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012254">
        <obo:IAO_0000115 xml:lang="cs">Zhoubný nádor kosti, který vždy vzniká ve dřeni, vyskytuje se častěji ve válcových kostech</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Ewingův sarkom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012254"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Zhoubný nádor kosti, který vždy vzniká ve dřeni, vyskytuje se častěji ve válcových kostech</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A malignant tumor of the bone which always arises in the medullary tissue, occurring more often in cylindrical bones.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
