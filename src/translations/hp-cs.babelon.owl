    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009268">
        <obo:IAO_0000115 xml:lang="cs">Druhotné osifikační centrum v proximálním falangu čtvrtého prstu na ruce, které je odlišné od běžné epifýzy a které nepřispívá k longitudinálnímu růstu dlouhé kosti</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Pseudoepifýza proximálního falangu 4. prstu na ruce</rdfs:label>
    </rdf:Description>
