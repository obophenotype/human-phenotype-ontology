        <owl:annotatedTarget xml:lang="cs">Stav zvýšené cirkulace antidiuretického hormonu navzdory hyponatremii a hypoosmolalitě s normálním nebo zvýšeným plazmatickým objemem.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A state of increased circulating antidiuretic hormone despite hyponatremia and hypo-osmolality with normal or increased plasma volume.</babelon:source_value>
