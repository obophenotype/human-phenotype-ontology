    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011094">
        <obo:IAO_0000115 xml:lang="cs">Maxilární zuby překrývají mandibulární zuby při skusu ve zvýšené míře.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Překus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011094"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Maxilární zuby překrývají mandibulární zuby při skusu ve zvýšené míře.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Maxillary teeth cover the mandibular teeth when biting to an increased degree. The feature is defined as a vertical overlap of the maxillary incisors over the mandibular incisors that exceeds 2 mm.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
