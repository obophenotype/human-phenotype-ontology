        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025608">
        <obo:IAO_0000115 xml:lang="cs">Everze nebo rotace okraje očního víčka (tj. ektropium) způsobená zkrácením nebo kontrakcí přední či střední lamely víčka jizvením.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Jizevnaté ektropium</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025608"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Everze nebo rotace okraje očního víčka (tj. ektropium) způsobená zkrácením nebo kontrakcí přední či střední lamely víčka jizvením.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An outward turning (eversion) or rotation of the eyelid margin (i.e., ectropion) caused by shortening or contraction of the anterior or middle lamellae related to scarring.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025608"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Jizevnaté ektropium</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cicatricial ectropion</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025609">
        <obo:IAO_0000115 xml:lang="cs">Typ blefaritidy, která postihuje kůži očního víčka, bazi řasů a folikuly řasů.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Přední blepharitis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025609"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ blefaritidy, která postihuje kůži očního víčka, bazi řasů a folikuly řasů.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of blepharitis that affects the eyelid skin, base of the eyelashes, and the eyelash follicles.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025609"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Přední blepharitis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anterior blepharitis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025610">
        <obo:IAO_0000115 xml:lang="cs">Typ blefaritidy, která postihuje Meibomovy žlázy a jejich ústí. Tato abnormalita může být asociována se spektrem příznaků, například seborrhea (abnormální sekrece Meibomových žláz), meibomianitis (zánět Meibomových žláz) až chalazion (akutní hnisavý zánět Meibomovy žlázy).</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Zadní blepharitis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025610"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ blefaritidy, která postihuje Meibomovy žlázy a jejich ústí. Tato abnormalita může být asociována se spektrem příznaků, například seborrhea (abnormální sekrece Meibomových žláz), meibomianitis (zánět Meibomových žláz) až chalazion (akutní hnisavý zánět Meibomovy žlázy).</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of blepharitis that affects the meibomian glands and meibomian gland orifices. This abnormality can be associated with a spectrum of appearances ranging from meibomian seborrhoea (foaming meibomian gland secretions) and meibomianitis (inflamed meibomian glands), to chalazia.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025610"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Zadní blepharitis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Posterior blepharitis</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025611">
        <obo:IAO_0000115 xml:lang="cs">Typ epikantu, u kterého více vyjádřená kožní epikantální řasa začínající u obočí přechází před a laterálně k mediálnímu kantu.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Epicanthus supercilliaris</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025611"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Typ epikantu, u kterého více vyjádřená kožní epikantální řasa začínající u obočí přechází před a laterálně k mediálnímu kantu.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of epicanthus in which more extensive epicanthal folds with their origins in the eyebrow cover, pass in front of and lateral to the medial canthus (middle corner of the eye).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025611"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Epicanthus supercilliaris</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Epicanthus superciliaris</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025612">
        <obo:IAO_0000115 xml:lang="cs">Typ refrakční vady související s abnormálním zakřivením předního nebo zadního povrchu rohovky.</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Rohovkový astigmatismus</rdfs:label>
    </rdf:Description>
