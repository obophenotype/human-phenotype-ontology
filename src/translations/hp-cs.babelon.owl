    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001009">
        <obo:IAO_0000115 xml:lang="cs">Telangektázie jsou drobné, dilatované cévy nacházející se v blízkosti povrchu kůže nebo sliznic, o průměru mezi 0,5 a 1 milimetrů. Telangektázie se nachází zejména na jazyku, rtech, patře, prstech a konečcích prstů, tváři, spojivkách, trupu, nehtových lůžkach</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Teleangiektázie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001009"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Telangektázie jsou drobné, dilatované cévy nacházející se v blízkosti povrchu kůže nebo sliznic, o průměru mezi 0,5 a 1 milimetrů. Telangektázie se nachází zejména na jazyku, rtech, patře, prstech a konečcích prstů, tváři, spojivkách, trupu, nehtových lůžkach</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Telangiectasias refer to small dilated blood vessels located near the surface of the skin or mucous membranes, measuring between 0.5 and 1 millimeter in diameter. Telangiectasia are located especially on the tongue, lips, palate, fingers, face, conjunctiva, trunk, nail beds, and fingertips.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001009"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Teleangiektázie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Telangiectasia</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001010">
        <obo:IAO_0000115 xml:lang="cs">Snížení intenzity zbarvení kůže související se sníženou produkcí a depozicí melaninu</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Hypopimentace kůže</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001010"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Snížení intenzity zbarvení kůže související se sníženou produkcí a depozicí melaninu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduction of skin color related to a decrease in melanin production and deposition.</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001010"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="cs">Hypopimentace kůže</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypopigmentation of the skin</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001012">
        <obo:IAO_0000115 xml:lang="cs">Přítomnost vícero lipomů (benigní nádor z tukové tkáně)</obo:IAO_0000115>
        <rdfs:label xml:lang="cs">Mnohočetné lipomy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001012"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="cs">Přítomnost vícero lipomů (benigní nádor z tukové tkáně)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of multiple lipomas (a type of benign tissue made of fatty tissue).</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
