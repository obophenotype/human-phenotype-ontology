    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0033595">
        <obo:IAO_0000115 xml:lang="cs">Zvýšená koncentrace globotriaosylceramidu (Gb3) v krevním oběhu. Globotriaosylceramid, nazývaný také ceramidetrihexosid, je primárním zásobním lipidem u Fabryho choroby.</obo:IAO_0000115>
