        <owl:annotatedTarget xml:lang="cs">Akcesorní duplikatura ústní sliznice táhnoucí se od alveolárních výběžků na vnitřní stranu horního či dolního rtu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
