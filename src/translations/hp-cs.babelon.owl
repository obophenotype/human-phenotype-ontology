        <owl:annotatedTarget xml:lang="cs">Plicní situs ambiguus oboustranně s morfologií levé plíce</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pulmonary situs ambiguus with bilateral morphologic left lungs</babelon:source_value>
        <babelon:translation_language>cs</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011620">
        <obo:IAO_0000115 xml:lang="cs">Abnormalita břišní dutiny, tj. vybočení (strannost) abdomenu a jeho orgánů</obo:IAO_0000115>
