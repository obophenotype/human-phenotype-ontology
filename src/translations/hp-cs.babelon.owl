        <rdfs:label xml:lang="cs">Profil izoformy transferinu typu I</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003642"/>
