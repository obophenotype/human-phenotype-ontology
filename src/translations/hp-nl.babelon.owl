    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0040196">
        <obo:IAO_0000115 xml:lang="nl">Verminderde occipito-frontale (hoofd) circumferentie (OFC). Voor microcefalie moet de OFC tussen -3 SD en -2 SD zijn vergeleken met geschikte, leeftijd gecorrigeerde, normaalwaarden (m.a.w. -3 SD &amp;lft;= OFC &amp;lft; -2 SD)</obo:IAO_0000115>
        <rdfs:label xml:lang="nl">Milde microcefalie</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040196"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="nl">Verminderde occipito-frontale (hoofd) circumferentie (OFC). Voor microcefalie moet de OFC tussen -3 SD en -2 SD zijn vergeleken met geschikte, leeftijd gecorrigeerde, normaalwaarden (m.a.w. -3 SD &amp;lft;= OFC &amp;lft; -2 SD)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased occipito-frontal (head) circumference (OFC). For the microcephaly OFC must be between -3 SD and -2 SD compared to appropriate, age matched, normal standards (i.e. -3 SD &lt;= OFC &lt; -2 SD).</babelon:source_value>
        <babelon:translation_language>nl</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040196"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="nl">Milde microcefalie</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mild microcephaly</babelon:source_value>
        <babelon:translation_language>nl</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
