    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010621">
        <obo:IAO_0000115 xml:lang="tr">Bitişik ayak rakamları arasında anteroposterior eksende yumuşak doku sürekliliği, iki ilgili rakamlardan birinin proximodistal uzunluğunun en az yarısını içerir; veya, önceki nesnel ölçütleri karşılamayan ayağın iki rakamı arasında A/P ekseninde yumuşak doku sürekliliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ayak parmaklarının kutanöz sindaktilisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010621"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bitişik ayak rakamları arasında anteroposterior eksende yumuşak doku sürekliliği, iki ilgili rakamlardan birinin proximodistal uzunluğunun en az yarısını içerir; veya, önceki nesnel ölçütleri karşılamayan ayağın iki rakamı arasında A/P ekseninde yumuşak doku sürekliliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A soft tissue continuity in the anteroposterior axis between adjacent foot digits that involves at least half of the proximodistal length of one of the two involved digits; or, a soft tissue continuity in the A/P axis between two digits of the foot that does not meet the prior objective criteria.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
