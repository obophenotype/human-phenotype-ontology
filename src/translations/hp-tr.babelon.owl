        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011762">
        <obo:IAO_0000115 xml:lang="tr">Tiroid stimüle edici hormon (TSH) üreten bir tip hipofiz adenomu</obo:IAO_0000115>
