        <obo:IAO_0000115 xml:lang="tr">Bir ses tarafından üretilen sinyalin koklear sinirden lateral lemniscus yoluyla medial geniculate nucleus ve kortekse izlenmesi için kullanılan işitsel uyarılmış potansiyellerin bir anormalliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal işitsel uyarılmış potansiyeller</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006958"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir ses tarafından üretilen sinyalin koklear sinirden lateral lemniscus yoluyla medial geniculate nucleus ve kortekse izlenmesi için kullanılan işitsel uyarılmış potansiyellerin bir anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the auditory evoked potentials, which are used to trace the signal generated by a sound, from the cochlear nerve, through the lateral lemniscus, to the medial geniculate nucleus, and to the cortex.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
