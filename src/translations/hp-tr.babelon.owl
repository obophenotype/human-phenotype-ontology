        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031851">
        <obo:IAO_0000115 xml:lang="tr">Kırmızı kan hücrelerinin toplam kan hacmine olan normal oranından aşağıya bir azalma</obo:IAO_0000115>
