        <owl:annotatedTarget xml:lang="tr">Retinal floresan anjiyografide gözlenen floresan boya kaçışı. Kaçış bölgeleri sınır bulanıklaşması ile kademeli genişleme göstermesi ile tanımlanabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Leakage of fluorescein dye observed upon retinal fluorescein angiography. Areas of leakage can be appreciated as showing gradual enlargement with blurring of margins.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
