        <owl:annotatedTarget xml:lang="tr">Sıcaklık (ateş dahil) ile iyileşen veya daha katlanılabilir hale gelen bir bulgu veya belirti için geçerlidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
