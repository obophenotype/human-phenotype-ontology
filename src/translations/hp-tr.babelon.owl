        <rdfs:label xml:lang="tr">Baş parmağın distal falanksının tam duplikasyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009606"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Baş parmağın distal falanksının tam duplikasyonu. X-ray&apos;de iki ayrık kemik kenar kenara gözükürler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complete duplication of the distal phalanx of the thumb. On x-ray two separate bones appear side to side.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
