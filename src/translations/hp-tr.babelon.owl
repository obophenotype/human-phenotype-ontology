        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal increase or decrease of any CD4+ T cell subpopulation, measured as percentage of total CD4+ T cells in the blood, compared to a reference range for a given sex and age-group.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
