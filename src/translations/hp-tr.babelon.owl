    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0550005">
        <obo:IAO_0000115 xml:lang="tr">Standart göğüs röntgeninde akciğerlerin en sık baziler kısımlarında belirgin olan lineer veya lineonodüler yoğunlukların iki taraflı retiküler paternidir. Skleroderma tanısında üçüncü minör kriterdir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Bilateral baziler pulmoner fibroz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0550005"/>
