    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003552">
        <obo:IAO_0000115 xml:lang="tr">Ağrı veya spazm eşlik etmeden kasların hızlı hareket ettirilememesi durumu</obo:IAO_0000115>
