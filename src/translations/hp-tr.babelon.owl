        <owl:annotatedTarget xml:lang="tr">Gözlerde yanma kuru veya yabancı cisim hissi ile genel olarak tahriş ve kızarıklıkla birlikte görülen kronik irritatif bir göz nezlesidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A chronic irritative conjunctivitis, which commonly presents with general irritation and redness of the eyes, with a burning, dry, or foreign-body sensation of the eyes.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
