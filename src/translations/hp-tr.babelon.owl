    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003347">
        <obo:IAO_0000115 xml:lang="tr">Normal periferik kan lenfositleri, fitohemaglutinin (PHA) tarafından stimüle edildiğinde homolog ve heterolog hücreler için sitotoksiktir ancak tek katmanlı kültürde otolog hücreler için değildir. Sitotoksik etki, lenfositlerin immünolojik yeterliliğinin göstergesi olarak düşünülmektedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fitohemaglutinin ile bozulmuş lenfosit transformasyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003347"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Normal periferik kan lenfositleri, fitohemaglutinin (PHA) tarafından stimüle edildiğinde homolog ve heterolog hücreler için sitotoksiktir ancak tek katmanlı kültürde otolog hücreler için değildir. Sitotoksik etki, lenfositlerin immünolojik yeterliliğinin göstergesi olarak düşünülmektedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Normal peripheral blood lymphocytes, when stimulated by phytohemagglutinin (PHA) are cytotoxic for homologous and heterologous cells but not for autologous cells in monolayer culture. The cytotoxic effect is thought to be indicative of the immunological competence of the lymphocytes</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003347"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Fitohemaglutinin ile bozulmuş lenfosit transformasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>obsolete Impaired lymphocyte transformation with phytohemagglutinin</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
