    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003383">
        <obo:IAO_0000115 xml:lang="tr">Segmental demiyelinizasyon ve remiyelinizasyonun tekrarlayan atakları soğan soğuması formasyonu olarak adlandırılan, aksonların etrafında ihtiyaç fazlası Schwann hücrelerinin birikmesine yol açar. Bu bulgu periferik sinirleri etkiler</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Soğan başı oluşumu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003383"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Segmental demiyelinizasyon ve remiyelinizasyonun tekrarlayan atakları soğan soğuması formasyonu olarak adlandırılan, aksonların etrafında ihtiyaç fazlası Schwann hücrelerinin birikmesine yol açar. Bu bulgu periferik sinirleri etkiler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Repeated episodes of segmental demyelination and remyelination lead to the accumulation of supernumerary Schwann cells around axons, which is referred to as onion bulb formation. This finding affects peripheral nerves.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
