        <babelon:source_value>Megakaryocyte nucleus hypolobulation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031386">
        <obo:IAO_0000115 xml:lang="tr">Kemik iliğinde anormal derecede artmış mikromegalokaryositlerin varlığı. Mikromegalokaryositler boyutu 30 mikrometreden küçük bir çekirdek ile myeloblast ya da promiyelositlere benzeyen mononükleer diploid hücrelerdir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Artmış mikromegakaryosit sayımı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031386"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kemik iliğinde anormal derecede artmış mikromegalokaryositlerin varlığı. Mikromegalokaryositler boyutu 30 mikrometreden küçük bir çekirdek ile myeloblast ya da promiyelositlere benzeyen mononükleer diploid hücrelerdir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of abnormally high numbers of micromegakaryocytes in the bone marrow. Micromegakaryocytes are mononuclear diploid cells, with a nucleus similar in size to that of a myeloblast or promyelocyte with the cell being less than 30 micrometers in diameter.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031386"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Artmış mikromegakaryosit sayımı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased micromegakaryocyte count</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031387">
