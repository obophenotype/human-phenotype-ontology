        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011587">
        <obo:IAO_0000115 xml:lang="tr">Sağ brakiosefalik arter, sol ortak karotid arter, sol subklaviyen arter veya proksimal vertebral arterlerin kökeninin veya seyrinin normalden sapması</obo:IAO_0000115>
