        <owl:annotatedTarget xml:lang="tr">Testikül içinde püy toplanması. Ultrasonografik özellikler kabarmış, düzensiz duvarları, intratestiküler lokalizasyonu, düşük seviye iç yansımayı ve nadiren hipervasküler sınırları içerir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A collection of pus within a testicle. Ultrasonographic features include shaggy, irregular walls, intratesticular location, low-level internal echoes, and occasionally, hypervascular margins.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
