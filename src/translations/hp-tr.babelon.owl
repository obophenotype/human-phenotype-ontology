    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011448">
        <obo:IAO_0000115 xml:lang="tr">Klonus tekrarlayan ayak fleksiyonu ve ekstensiyonuna neden olan istemsiz bir tendon refleksidir. Ayak bileği klonusu ayağın yukarı doğru fleksiyona getirilmesi ile test edilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ayak bileği klonusu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011448"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Klonus tekrarlayan ayak fleksiyonu ve ekstensiyonuna neden olan istemsiz bir tendon refleksidir. Ayak bileği klonusu ayağın yukarı doğru fleksiyona getirilmesi ile test edilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Clonus is an involuntary tendon reflex that causes repeated flexion and extension of the foot. Ankle clonus is tested by rapidly flexing the foot upward.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
