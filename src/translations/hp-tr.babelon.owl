    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100770">
        <obo:IAO_0000115 xml:lang="tr">Aşırı aktif peristaller (gastrointestinal sistemin tübüler organlarının kasılması dalgası), gıdanın mideye ve bağırsağa geçmesinin aşırı derecede hızlı olması ile belirgindir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hiperperistalsis</rdfs:label>
    </rdf:Description>
