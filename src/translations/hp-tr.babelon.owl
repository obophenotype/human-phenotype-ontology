    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010767">
        <obo:IAO_0000115 xml:lang="tr">Sakrokoksigeal bölgede (gluteal kırışıklık) bir kist, fistül veya apse varlığı, karakteristik olarak saç ve deri kıvrımları eşlik eder</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sakrokoksigeyal pilonidal anormallik</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010767"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sakrokoksigeal bölgede (gluteal kırışıklık) bir kist, fistül veya apse varlığı, karakteristik olarak saç ve deri kıvrımları eşlik eder</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of a cyst, fistula, or abscess in the sacrococcygeal region (gluteal crease) characteristically accompanied by hair and skin folds.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
