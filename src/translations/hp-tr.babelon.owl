    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030112">
        <obo:IAO_0000115 xml:lang="tr">Kas alfa-distroglcan ekspresyonunun normalinden deviasyon. Alpha-distroglikan, laminin alfa2&apos;ye ek olarak hücre dışı matriste perlecan ve agrini bağlayan, distrominle ilişkili glikoprotein kompleksinin (DAPC) aşırı glikozillenmiş periferik-membran bileşenidir, oysa aynı genden üretilen beta-distroglikan, hücre içi olarak distrofin bağlayan transmembran bir proteindir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal kas lifi alfa distroglikanı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030112"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kas alfa-distroglcan ekspresyonunun normalinden deviasyon. Alpha-distroglikan, laminin alfa2&apos;ye ek olarak hücre dışı matriste perlecan ve agrini bağlayan, distrominle ilişkili glikoprotein kompleksinin (DAPC) aşırı glikozillenmiş periferik-membran bileşenidir, oysa aynı genden üretilen beta-distroglikan, hücre içi olarak distrofin bağlayan transmembran bir proteindir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deviation from normal of muscle alpha-dystroglcan expression. Alpha-dystroglycan is a heavily glycosylated peripheral-membrane component of the dystrophin-associated glycoprotein complex (DAPC), which, in addition to laminin alpha2, binds perlecan and agrin in the extracellular matrix, whereas beta-dystroglycan, derived from the same gene, is a transmembrane protein that links to dystrophin intracellularly.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030112"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal kas lifi alfa distroglikanı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal muscle fiber alpha dystroglycan</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030113">
        <obo:IAO_0000115 xml:lang="tr">Kas dokusunda disferlin ekspresyonunda normalden bir sapma. Disferlin kalsiyum aracılı sarkolemma yeniden mühürlenmesinde yer alan übikütöz 230-KDa transmembran bir proteindir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal kas lifi disferlini</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030113"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kas dokusunda disferlin ekspresyonunda normalden bir sapma. Disferlin kalsiyum aracılı sarkolemma yeniden mühürlenmesinde yer alan übikütöz 230-KDa transmembran bir proteindir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deviation from normal in the expression of dysferlin in muscle tissue. Dysferlin is an ubiquitous 230-kDa transmembrane protein involved in calcium-mediated sarcolemma resealing.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
