        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011586">
        <obo:IAO_0000115 xml:lang="tr">Kalbin kısmi ya da total olarak ventral duvardaki kusur nedeniyle toraks boşluğunun dışına çıkması ve kısmi karın boşluğuna yerleşmesi ile giden ventral duvarın konjenital malformasyonu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Torakoabdominal ektopia kordis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011586"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kalbin kısmi ya da total olarak ventral duvardaki kusur nedeniyle toraks boşluğunun dışına çıkması ve kısmi karın boşluğuna yerleşmesi ile giden ventral duvarın konjenital malformasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Congenital malformation of the ventral wall with partial or total evisceration of the heart outside the thoracic cavity and displacement partially into the abdominal cavity.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
