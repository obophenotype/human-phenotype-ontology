        <babelon:source_value>Retinopathy of prematurity stage 5b</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500059">
        <obo:IAO_0000115 xml:lang="tr">Optik disk merkezinden, maküla merkezi ile optik disk merkezi arasındaki mesafenin iki katına uzanan retinopati</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Prematürite zon I retinopatisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500059"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Optik disk merkezinden, maküla merkezi ile optik disk merkezi arasındaki mesafenin iki katına uzanan retinopati</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy which extends from the center of the optic disc to twice the distance from the center of the optic disc to the center of the macula.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500059"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Prematürite zon I retinopatisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity zone I</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500060">
        <obo:IAO_0000115 xml:lang="tr">Zon I kenarından merkezden uzaklaşarak nazal ora serrataya uzanan retinopati</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Prematürite zon II retinopatisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500060"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Zon I kenarından merkezden uzaklaşarak nazal ora serrataya uzanan retinopati</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy which extends centrifugally from the edge of zone I to the nasal ora serrata.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500060"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Prematürite zon II retinopatisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity zone II</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
