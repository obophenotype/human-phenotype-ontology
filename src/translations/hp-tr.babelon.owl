        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009490">
        <obo:IAO_0000115 xml:lang="tr">Elin 2. parmağının epifizlerinin koni biçimli bir görünüşü, &apos;soket içinde bir top&apos; görüntüsü üretir. İlgili varlık &apos;melek şekilli&apos; epifiz, bir falanksın distal ucunda bir psödoepfiz ile birlikte belirgin bir koni şekilli epifizi ifade eder</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">2. parmağın koni şekilli epifizleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009490"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Elin 2. parmağının epifizlerinin koni biçimli bir görünüşü, &apos;soket içinde bir top&apos; görüntüsü üretir. İlgili varlık &apos;melek şekilli&apos; epifiz, bir falanksın distal ucunda bir psödoepfiz ile birlikte belirgin bir koni şekilli epifizi ifade eder</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cone-shaped appearance of the epiphyses of the 2nd finger of the hand, producing a &apos;ball-in-a-socket&apos; appearance. The related entity &apos;angel-shaped&apos; epiphysis refers to a pronounced cone-shaped epiphysis in combination with a pseudoepiphysis at the distal end of a phalanx.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
