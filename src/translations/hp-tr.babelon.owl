    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031590">
        <obo:IAO_0000115 xml:lang="tr">Sıklıkla göz yaşarması veya baş ağrısı ile eşlik eden okuma veya bilgisayarda çalışma gibi aktivitelerde gözlerin &apos;fazla kullanımı&apos; ile ilişkili gözlerin bitkinlik veya rahatsızlık hissi, göz zorlanması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Astenopi</rdfs:label>
    </rdf:Description>
