        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Medulloblastoma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002886">
        <obo:IAO_0000115 xml:lang="tr">Parapharngeal alanın retrostiloid bölmesinde gelişen, vagus sinirinde bulunan sinir başından elde edilen bir paragangliyon dokusu kümesinden kaynaklanan bir tümör</obo:IAO_0000115>
