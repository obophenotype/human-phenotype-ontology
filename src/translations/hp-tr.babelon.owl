        <owl:annotatedTarget xml:lang="tr">Hemopoietik açıdan aktif dokunun veya embriyonik hemopoietik potansiyele sahip olan dokunun çoğalması (fazla üretimi)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
