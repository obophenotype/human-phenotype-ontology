        <babelon:source_value>Elevated serum bicarbonate concentration</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032068">
        <obo:IAO_0000115 xml:lang="tr">Artmış bir idrar mukus miktarı. Küçük bir miktar mukus idrar kanalı epitelyal hücrelerinin mukus membranı tarafından üretilir. Artmış mukus miktarı idrar analizi veya diğer deneyler sonrası tespit edilebilir ve idrar yolu enfeksiyonu, bağırsak segment kullanımını içeren idrar yolu yeniden yapılanması veya idrar analizi öncesi idrar örneğinin kontaminasyonu gibi durumlara işaret edebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Artmış idrar mukusu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032068"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Artmış bir idrar mukus miktarı. Küçük bir miktar mukus idrar kanalı epitelyal hücrelerinin mukus membranı tarafından üretilir. Artmış mukus miktarı idrar analizi veya diğer deneyler sonrası tespit edilebilir ve idrar yolu enfeksiyonu, bağırsak segment kullanımını içeren idrar yolu yeniden yapılanması veya idrar analizi öncesi idrar örneğinin kontaminasyonu gibi durumlara işaret edebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An increased amount of urinary mucus. A small amount of mucus is produced by mucous membrane epithelial cells of the urinary tract. An increased amount of mucus can be detected upon urinalysis or other assays and may indicate conditions such as urinary tract infection, urinary tract reconstruction involving the use of bowel segments, or contamination of the urine sample prior to urinalysis.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032068"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Artmış idrar mukusu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased urinary mucus</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032069">
        <obo:IAO_0000115 xml:lang="tr">Tiroglobuline karşı serumda reaksiyon veren otoantikor (immünoglobulin) varlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anti-tiroglobulin antikor pozitifliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032069"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Tiroglobuline karşı serumda reaksiyon veren otoantikor (immünoglobulin) varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of autoantibodies (immunoglobulins) in the serum that react to thyroglobulin.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
