        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030432">
        <obo:IAO_0000115 xml:lang="tr">Kondroblasttan veya prekürsörlerinden meydana gelen hücrelerden oluşan ve kıkırdak hücrelerine dönüşmeye meyilli genellikle iyi huylu bir tümör</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kondroblastom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030432"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kondroblasttan veya prekürsörlerinden meydana gelen hücrelerden oluşan ve kıkırdak hücrelerine dönüşmeye meyilli genellikle iyi huylu bir tümör</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A usually benign tumor composed of cells which arise from chondroblasts or their precursors and which tend to differentiate into cartilage cells.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
