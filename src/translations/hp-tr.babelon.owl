        <obo:IAO_0000115 xml:lang="tr">Hayatta tecrübe edilenlere benzer şekilde öznel nitelikli duygusal, hatırlatıcı veya bileşik kavrayışsal auralar gerçek şartlar dışında meydana geldiği özne tarafından farkına varılır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Deneysel auralar</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
