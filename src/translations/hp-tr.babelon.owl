        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031179"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Boynun ekstansör kaslarının kas spazmının bir sonucu olarak boynun ekstansör kaslarının direnci ileriye doğru bükülmeye (örneğin, boyun fleksiyon bozukluğu) direnir. Nükal sertlik sabit bir sertlik değildir. Nükal sertlik meningizm için baş ucu testi olarak kullanılmıştır, bununla birlikte bu amaca için duyarlılığı tartışılmıştır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Resistance of the extensor muscles of the neck to being bent forwards (i.e., impaired neck flexion) as a result of muscle spasm of the extensor muscles of the neck. Nuchal rigidity is not a fixed rigidity. Nuchal rigidity has been used as a bedside test for meningism, although its sensitivity for this purpose has been debated.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031179"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Nukhal sertlik</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nuchal rigidity</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031180">
        <obo:IAO_0000115 xml:lang="tr">Genellikle yuvarlak veya oval, tanım olarak en az 5 cm boyutunda (en geniş çapında), genişleyen eritematöz (kırmızı) bir deri lezyonu</obo:IAO_0000115>
