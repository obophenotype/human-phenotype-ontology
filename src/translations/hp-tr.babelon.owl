    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011627">
        <obo:IAO_0000115 xml:lang="tr">Aorto-ventriküler tünel çıkan aortayı sinutübüler bileşke üzerinde sol, veya (daha az sıklıkla) sağ ventriküle bağlayan konjenital, ekstrakardiyak bir kanaldır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Aorto-ventriküler tünel</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011627"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Aorto-ventriküler tünel çıkan aortayı sinutübüler bileşke üzerinde sol, veya (daha az sıklıkla) sağ ventriküle bağlayan konjenital, ekstrakardiyak bir kanaldır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aorto-ventricular tunnel is a congenital, extracardiac channel which connects the ascending aorta above the sinotubular junction to the cavity of the left, or (less commonly) right ventricle.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011627"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Aorto-ventriküler tünel</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aorto-ventricular tunnel</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011628">
        <obo:IAO_0000115 xml:lang="tr">Perikardiyumun konjenital başlangıçlı gelişimsel bir defekti</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Perikardın konjenital defekti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011628"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Perikardiyumun konjenital başlangıçlı gelişimsel bir defekti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A developmental defect of the pericardium with congenital onset.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011628"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Perikardın konjenital defekti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Congenital defect of the pericardium</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011629">
        <obo:IAO_0000115 xml:lang="tr">Cerrahi perikardektomi sonucu değil, konjenital bir defekt olarak meydana gelen, kalbin etrafında perikard olmaması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Perikardın tamamen yokluğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011629"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Cerrahi perikardektomi sonucu değil, konjenital bir defekt olarak meydana gelen, kalbin etrafında perikard olmaması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>No pericardium around the heart, occurring as a congenital defect, not the result of a surgical pericardectomy.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011629"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Perikardın tamamen yokluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Total absence of the pericardium</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011630">
        <obo:IAO_0000115 xml:lang="tr">Kalbin diyafragmatik yüzeyi üzerinde perikardiyum yok. Perikardektomi sonucu değil, konjenital bir defekttir. Perikardiyum kalbin diğer kısımlarında mevcuttur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kalp zarının tam diyafragmatik yokluğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011630"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kalbin diyafragmatik yüzeyi üzerinde perikardiyum yok. Perikardektomi sonucu değil, konjenital bir defekttir. Perikardiyum kalbin diğer kısımlarında mevcuttur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>No pericardium over the diaphragmatic surface of the heart. It is a congenital defect, not the result of a pericardectomy. Pericardium is present on other parts of the heart.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011630"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kalp zarının tam diyafragmatik yokluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complete diaphragmatic absence of pericardium</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011631">
        <obo:IAO_0000115 xml:lang="tr">Kalbin sağ tarafı üzerinde perikardiyum yok. Perikardektomi sonucu olandan ziyade perikardiyumun konjenital bir defektidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kalp zarının sağ tarafının tam yokluğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011631"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kalbin sağ tarafı üzerinde perikardiyum yok. Perikardektomi sonucu olandan ziyade perikardiyumun konjenital bir defektidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>No pericardium is present on the righthand side of the heart. It is a congenital absence of pericardium rather than the result of a pericardectomy.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
