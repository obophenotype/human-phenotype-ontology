        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031658">
        <obo:IAO_0000115 xml:lang="tr">Üçüncü kalp sesi (S3) diastolde hızlı dolum ile ilişkilidir. S3 çocuklar ve ergenlerde normal bir bulgu olabilir, fakat daha ileri yaşlarda kalp yetmezliğini gösterir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Üçüncü kalp sesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031658"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Üçüncü kalp sesi (S3) diastolde hızlı dolum ile ilişkilidir. S3 çocuklar ve ergenlerde normal bir bulgu olabilir, fakat daha ileri yaşlarda kalp yetmezliğini gösterir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The third heart sound (S3) is related to rapid filling in diastole. S3 can be a normal finding in children and adolescents but suggests heart failure in older patients.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031658"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Üçüncü kalp sesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Third heart sound</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031659">
        <rdfs:label xml:lang="tr">Dördüncü kalp sesi</rdfs:label>
