        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Pakigiri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pachygyria</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001304">
        <obo:IAO_0000115 xml:lang="tr">Kıvrılma ve tekrarlayan vücut hareketleri üreten uzamış istemsiz kas kasılmaları</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Torsiyon distonisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001304"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kıvrılma ve tekrarlayan vücut hareketleri üreten uzamış istemsiz kas kasılmaları</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
