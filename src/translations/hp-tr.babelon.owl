        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025108"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anjiyoma serpentinum</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Angioma serpentinum</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025109">
        <obo:IAO_0000115 xml:lang="tr">Eritrositler içinde pirüvat kinaz (PK) aktivitesinde azalma. PK reaksiyonu katalizler: ATP + pirüvat = ADP + fosfoenolpirüvat</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Azalmış kırmızı hücre pirüvat kinaz aktivitesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025109"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Eritrositler içinde pirüvat kinaz (PK) aktivitesinde azalma. PK reaksiyonu katalizler: ATP + pirüvat = ADP + fosfoenolpirüvat</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decrease in the level of pyruvate kinase (PK) within erythrocytes. PK catalyzes the reaction: ATP + pyruvate = ADP + phosphoenolpyruvate.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025109"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Azalmış kırmızı hücre pirüvat kinaz aktivitesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced red cell pyruvate kinase level</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025110">
        <obo:IAO_0000115 xml:lang="tr">Tipik olarak inflamatuvar doğada, makülaya içine alan, sarı/beyaz, keskine çizilmiş lezyon</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Plak benzeri maküler lezyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025110"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Tipik olarak inflamatuvar doğada, makülaya içine alan, sarı/beyaz, keskine çizilmiş lezyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Large yellow/white, sharply delineated lesion, typically of inflammatory nature, involving the macula, more specifically at the outer retinal level (RPE/photoreceptor).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025110"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Plak benzeri maküler lezyon</owl:annotatedTarget>
