    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010797">
        <obo:IAO_0000115 xml:lang="tr">Hemanjiyoblastom, merkezi sinir sisteminde hemen hemen sadece kaynaklanan iyi huylu damar tümörüdür. Hemanjiyoblastomalar, çapı 1 veya 2 cm olan bir kütle oluşturan, sıkı bir şekilde paketlenmiş küçük kan damarları grubundan oluşur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hemanjiyoblastom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
