    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030357">
        <obo:IAO_0000115 xml:lang="tr">Küçük hücreli akciğer kanseri (SCLC), küçük oval hücrelerden oluşan oldukça kötü huylu bir akciğer kanseri türüdür. Geçmişte, hücrelerin mikroskobik görünüşü yulaf benzeri olduğu düşünülürse SCLC, yulaf hücreli karsinom olarak adlandırılmıştır. SLCLC genellikle bronşun yakınında bulunur ve birçok durumda hızla büyür ve metastaz yapar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Küçük hücreli akciğer karsinomu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030357"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Küçük hücreli akciğer kanseri (SCLC), küçük oval hücrelerden oluşan oldukça kötü huylu bir akciğer kanseri türüdür. Geçmişte, hücrelerin mikroskobik görünüşü yulaf benzeri olduğu düşünülürse SCLC, yulaf hücreli karsinom olarak adlandırılmıştır. SLCLC genellikle bronşun yakınında bulunur ve birçok durumda hızla büyür ve metastaz yapar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Small cell lung cancer (SCLC) is a type of highly malignant lung cancer that is composed of small ovoid cells. In the past, SCLC was called oat cell carcinoma because the microscopic appearance of the cells was felt to resemble oats. SLCLC usually originates near the bronchi and in many cases may grow and metastasize quickly.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030357"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Küçük hücreli akciğer karsinomu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Small cell lung carcinoma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030358">
        <rdfs:label xml:lang="tr">Küçük hücreli olmayan akciğer karsinomu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030358"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Küçük hücreli olmayan akciğer karsinomu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Non-small cell lung carcinoma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030359">
        <obo:IAO_0000115 xml:lang="tr">Stratifiye skuamöz epitelyal hücrelerinden köken alan küçük hücreli olmayan akciğer karsinom tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Skuamöz hücreli akciğer karsinomu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030359"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Stratifiye skuamöz epitelyal hücrelerinden köken alan küçük hücreli olmayan akciğer karsinom tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of non-small cell lung carcinoma that is derived from stratified squamous epithelial cells.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030359"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Skuamöz hücreli akciğer karsinomu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Squamous cell lung carcinoma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030360">
        <obo:IAO_0000115 xml:lang="tr">Akciğerde türevlenmiş epitel hücrelerinden kaynaklanan ve küçük hücreli akciğer karsinomasından farklılaşan, anaplastik hücrelerin daha büyük boyutu ile sitoplazmik-olmayan ancak sitoplazmik kanserlerden farklılaşan, farklılaşmamış malign neoplazmalardan türetilen küçük hücreli dışı akciğer karsinomu türüdür nükleer boyut oranı ve kromatin tuz-biber görünüm eksikliğidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Büyük hücreli akciğer karsinomu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030360"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Akciğerde türevlenmiş epitel hücrelerinden kaynaklanan ve küçük hücreli akciğer karsinomasından farklılaşan, anaplastik hücrelerin daha büyük boyutu ile sitoplazmik-olmayan ancak sitoplazmik kanserlerden farklılaşan, farklılaşmamış malign neoplazmalardan türetilen küçük hücreli dışı akciğer karsinomu türüdür nükleer boyut oranı ve kromatin tuz-biber görünüm eksikliğidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of non-small cell lung carcinoma that is derived from undifferentiated malignant neoplasms originating from transformed epithelial cells in the lung, and which is differentiate from small-cell lung carcinoma by the larger size of the anaplastic cells, a higher cytoplasmic-to-nuclear size ratio, and a lack of salt-and-pepper appearance of the chromatin.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
