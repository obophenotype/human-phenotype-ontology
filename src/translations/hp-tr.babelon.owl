        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032028"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Maküler noktalar</owl:annotatedTarget>
