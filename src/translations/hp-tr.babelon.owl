    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025473">
        <obo:IAO_0000115 xml:lang="tr">Bir papül (kısıtlanmış, görünür sıvı olmadan cildin katı yükseltisi, geniş noktada çapın 10mm &apos;den daha küçüğe bir toplu iğne başından boyutta değişmesi) çevreleyen cilde kıyasla artan pigmentasyon (koyu renktedir) sergileyen</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hiperpigmente papül</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025473"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir papül (kısıtlanmış, görünür sıvı olmadan cildin katı yükseltisi, geniş noktada çapın 10mm &apos;den daha küçüğe bir toplu iğne başından boyutta değişmesi) çevreleyen cilde kıyasla artan pigmentasyon (koyu renktedir) sergileyen</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A papule (circumscribed, solid elevation of skin with no visible fluid, varying in size from a pinhead to less than 10mm in diameter at the widest point) that exhibits increased pigmentation (is darker) compared to the surrounding skin.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
