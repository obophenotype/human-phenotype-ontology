        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030955">
        <obo:IAO_0000115 xml:lang="tr">Uzun süredir aşırı miktarda alkol tüketmesi, tüketilen alkol miktarını azaltmakta zorluk çekmesi, fazlasıyla alkol arzulama ve alkol almaması durumunda yoksunluk semptomlarının yaşanması şeklinde tanımlanan bağımlılık davranışı</obo:IAO_0000115>
