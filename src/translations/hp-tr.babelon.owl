        <babelon:source_value>Abnormal vena cava physiology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030972">
        <obo:IAO_0000115 xml:lang="tr">Sistemik arteriyel sistemde normal basınçtan kronik bir sapma</obo:IAO_0000115>
