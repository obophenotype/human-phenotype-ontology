        <owl:annotatedTarget xml:lang="tr">Yarık üst dudak</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cleft upper lip</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000205">
        <obo:IAO_0000115 xml:lang="tr">Sürekli olan dudak kontraksiyonu nedeniyle büzülmüş veya buruşmuş görünüme yol açan yüz görünümü anormalliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Büzülmüş dudaklar</rdfs:label>
