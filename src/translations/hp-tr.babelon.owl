    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032018">
        <obo:IAO_0000115 xml:lang="tr">En az iki farklı sinir gövdesinin hem motor hem de duyusal sinirlerinin periferik nöropatisi ile karakterize iki veya daha fazla farklı sinir alanlarına hasar olduğunda periferik bir nöropati tipi. Farklı sinirler ya eş zamanlı ya da sırayla etkilenir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Çoklu mononöropati</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032018"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">En az iki farklı sinir gövdesinin hem motor hem de duyusal sinirlerinin periferik nöropatisi ile karakterize iki veya daha fazla farklı sinir alanlarına hasar olduğunda periferik bir nöropati tipi. Farklı sinirler ya eş zamanlı ya da sırayla etkilenir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of peripheral neuropathy that happens when there is damage to two or more different nerve areas characterized by peripheral neuropathy of both the motor and sensory nerves of at least two different nerve trunks. Different nerves are affected either simultaneously or sequentially.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
