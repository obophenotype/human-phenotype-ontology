        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031272">
        <obo:IAO_0000115 xml:lang="tr">Pulmoner arterin iç duvarları boyunca lipidlerin ve inflamatuar hücrelerin birikimi</obo:IAO_0000115>
