    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0040243">
        <obo:IAO_0000115 xml:lang="tr">Fibrinolizi ölçmek için klinik deney kullanılmıştır. Plazmanın euglobulin fraksiyonu çöktürülür ve trombin ilavesiyle pıhtı oluşumu için kullanılır; pıhtı oluşumlarından sonra pıhtı parçalanma hızı (fibrinoliz) izlenebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Uzamış öglobulin pıhtı lizis süresi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040243"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Fibrinolizi ölçmek için klinik deney kullanılmıştır. Plazmanın euglobulin fraksiyonu çöktürülür ve trombin ilavesiyle pıhtı oluşumu için kullanılır; pıhtı oluşumlarından sonra pıhtı parçalanma hızı (fibrinoliz) izlenebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormally increased length of time required for an in vitro clot to dissolve in the absence of the normal plasmin inhibitors. This test is a clinical assay used to measure fibrinolysis. The euglobulin fraction of plasma is precipitated and used to form clot by addition of thrombin; after clot forms the rate of clot breakdown (fibrinolysis) can be monitored.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040243"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Uzamış öglobulin pıhtı lizis süresi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Prolonged euglobulin clot lysis time</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
