    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012484">
        <obo:IAO_0000115 xml:lang="tr">Yoğun granüllerin kusurlu yapısı, boyutu veya içeriği, adenosin difosfat (ADP), adenosin trifosfat (ATP), iyonize kalsiyum, histamin ve serotonin gibi granül ön dengeleyici faktörleri içeren trombosit organelleri</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal yoğun granüller</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012484"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Yoğun granüllerin kusurlu yapısı, boyutu veya içeriği, adenosin difosfat (ADP), adenosin trifosfat (ATP), iyonize kalsiyum, histamin ve serotonin gibi granül ön dengeleyici faktörleri içeren trombosit organelleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Defective structure, size or content of dense granules, platelet organelles that contain granules proaggregatory factors such as adenosine diphosphate (ADP), adenosine triphosphate (ATP), ionized calcium, histamine and serotonin.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
