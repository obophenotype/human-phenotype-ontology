        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030771">
        <obo:IAO_0000115 xml:lang="tr">Çekiç parmak, parmakların son ekleminin bükülmesi fakat kendi kendine düzeltilememesi durumudur. Bu durumda, eklem düz olarak itilebilir fakat kendi kendine bu pozisyonu koruyamayacaktır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Çekiç parmak</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030771"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çekiç parmak, parmakların son ekleminin bükülmesi fakat kendi kendine düzeltilememesi durumudur. Bu durumda, eklem düz olarak itilebilir fakat kendi kendine bu pozisyonu koruyamayacaktır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mallet finger refers to a condition in which the end joint of a finger bends but will not straighten by itself. In this situation, the joint can be pushed straight but will not hold that position on its own.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030771"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Çekiç parmak</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mallet finger</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030772">
        <obo:IAO_0000115 xml:lang="tr">Proksimal femoral fokal eksiklik bütün ekstremitenin kısalması ile değişen derecelerde femur hipoplazisi ile kendini gösteren bir deformitedir</obo:IAO_0000115>
