        <babelon:source_value>Abnormal muscle fiber laminin beta 1</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030094">
        <obo:IAO_0000115 xml:lang="tr">Kas lifi dokusunda azalmış laminin beta 1 miktarı. Laminin 2 iskelet kas hücresi bazal laminasının majör bir bileşenidir. 3 zincirden oluşmuş bir heterotrimerdir: merozin (laminan alfa 2 zinciri), beta 1 ve gama 1</obo:IAO_0000115>
