        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Fetor hepatikus ciddi parenkimal karaciğer hastalıklı hastaların çürümüş yumurta ve sarmısak karışımı bir kokuyu andırdığı söylenen karakteristik nefesidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fetor hepaticus is the characteristic breath of patients with severe parenchymal liver disease, which has been said to resemble the odor of a mixture of rotten eggs and garlic.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
