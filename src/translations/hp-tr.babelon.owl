        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012042"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Siklooksijenaz 1&apos;i (COX-1) inhibe eden aspirin ve diğer steroid olmayan anti inflamatuvar ilaçların (SOAİİ) bronkokonstriksiyonu alevlendirdiği bir astım tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of asthma in which aspirin and other nonsteroidal anti-inflammatory drugs (NSAIDs) that inhibit cyclooxygen-ase 1 (COX-1) exacerbate bronchoconstriction.</babelon:source_value>
