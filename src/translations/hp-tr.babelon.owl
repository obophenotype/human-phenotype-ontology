        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030759">
        <obo:IAO_0000115 xml:lang="tr">Ortalama adiposit hücre boyutunda bir artış. Bu özellik biyopsi ile elde edilen abdominal subkutanöz adipoz doku kullanılarak mikroskopik olarak adipositlerin ortalama hücre çapının belirlenmesi ile ölçülebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Adiposit hipertrofisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030759"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ortalama adiposit hücre boyutunda bir artış. Bu özellik biyopsi ile elde edilen abdominal subkutanöz adipoz doku kullanılarak mikroskopik olarak adipositlerin ortalama hücre çapının belirlenmesi ile ölçülebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An increase in mean adipocyte cell size. This feature can be measured by determining the average cell diameter of adipocytes microscopically using abdominal subcutaneous adipose tissue obtained by biopsy.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030759"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Adiposit hipertrofisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Adipocyte hypertrophy</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030760">
        <obo:IAO_0000115 xml:lang="tr">Renal fibroz kronik böbrek hastalığının hemen hemen her tipinde meydana gelen ekstraselüler matriksin aşırı birikimi sonucudur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Renal fibrozis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030760"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Renal fibroz kronik böbrek hastalığının hemen hemen her tipinde meydana gelen ekstraselüler matriksin aşırı birikimi sonucudur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Renal fibrosis is the consequence of an excessive accumulation of extracellular matrix that occurs in virtually every type of chronic kidney disease.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030760"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Renal fibrozis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Renal fibrosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030762">
        <obo:IAO_0000115 xml:lang="tr">Mezanjiyal matrisin çözünmesi veya zayıflaması ve mezanjiyal hücrelerin dejenerasyonu. Esas olarak, mesanjiyoliz, glomeruler mezanjiyumu kılcal damar tabakasına belirgin hasar vermeden etkileyen zararlı bir süreçtir. Matris şişer, gevşer ve sonunda çözünür; mezanjiyal hücreler sadece ödem ve vakuolizasyon gösterebilir veya ciddi dejenerasyona ve nekroza uğrayabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Mezangiolizis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030762"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Mezanjiyal matrisin çözünmesi veya zayıflaması ve mezanjiyal hücrelerin dejenerasyonu. Esas olarak, mesanjiyoliz, glomeruler mezanjiyumu kılcal damar tabakasına belirgin hasar vermeden etkileyen zararlı bir süreçtir. Matris şişer, gevşer ve sonunda çözünür; mezanjiyal hücreler sadece ödem ve vakuolizasyon gösterebilir veya ciddi dejenerasyona ve nekroza uğrayabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Partial or complete dissolution of the mesangial matrix, identified by reduced staining on a periodic acid-Schiff (PAS) or silver stain.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030762"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Mezangiolizis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mesangiolysis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030763">
        <obo:IAO_0000115 xml:lang="tr">Genişleyen koryon ve amniyon ile sarılmış uterin sineşiden kaynaklanabilen kağıt benzeri bir uzanım</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Amniyotik tabaka</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030763"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Genişleyen koryon ve amniyon ile sarılmış uterin sineşiden kaynaklanabilen kağıt benzeri bir uzanım</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A sheet like projection that can result from uterine synechiae that has been encompassed by the expanding chorion and amnion.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030763"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Amniyotik tabaka</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Amniotic Sheet</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030764">
        <obo:IAO_0000115 xml:lang="tr">Cildin kahverengi veya mavi-gri renkli renk değişikliği, aksiller ve kasık bölgelerinde, yüz, avuç içi veya ayak tabanlarında bulunabilir. Buna ek olarak, mavi-siyah renk değişikliği, kulak gibi pigmentin çökeldiği deri üstü kıkırdakta görülebilir. Bu, otozomal resesif olarak kalıtsal olarak homojenik asit oksidaz eksikliği olan alkaptönurinin, kolajenöz yapılarda homojenik asit birikimine neden olan, karakteristik bir göstergesidir. Tipik olarak sklera da bulaşmıştır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Okronozis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030764"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Cildin kahverengi veya mavi-gri renkli renk değişikliği, aksiller ve kasık bölgelerinde, yüz, avuç içi veya ayak tabanlarında bulunabilir. Buna ek olarak, mavi-siyah renk değişikliği, kulak gibi pigmentin çökeldiği deri üstü kıkırdakta görülebilir. Bu, otozomal resesif olarak kalıtsal olarak homojenik asit oksidaz eksikliği olan alkaptönurinin, kolajenöz yapılarda homojenik asit birikimine neden olan, karakteristik bir göstergesidir. Tipik olarak sklera da bulaşmıştır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Brown or blue-gray discoloration of the skin that can present on the axillary and inguinal areas, face, palms or soles. In addition, blue-black discoloration can be apparent on skin overlying cartilage in which the pigment is deposited, such as the ears. This is a characteristic manifestation of alkaptonuria, which is an autosomal recessively inherited deficiency of homogentisic acid oxidase that results in accumulation of homogentisic acid in collagenous structures. The sclerae are also typically involved.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030764"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Okronozis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ochronosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030765">
        <obo:IAO_0000115 xml:lang="tr">Etkilenmiş bireyler uykuda olmasına rağmen yoğun korku, çığlık ve pataklanma epizotları</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Karabasan</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030765"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Etkilenmiş bireyler uykuda olmasına rağmen yoğun korku, çığlık ve pataklanma epizotları</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Autonomic arousal, screaming, sweating, crying, outbursts during sleep, usually no recollection at the individual level; typically observed by others.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030765"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Karabasan</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sleep terror</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030766">
        <obo:IAO_0000115 xml:lang="tr">Ağrı otolojik bir hastalığın (primer veya otojenik otalji) sonucu olarak veya patolojik süreçten ve kulak harici yapılardan (ikincil veya otalji olarak adlandırılan) kaynaklanabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kulak ağrısı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030766"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ağrı otolojik bir hastalığın (primer veya otojenik otalji) sonucu olarak veya patolojik süreçten ve kulak harici yapılardan (ikincil veya otalji olarak adlandırılan) kaynaklanabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pain in the ear can be a consequence of otologic disease (primary or otogenic otalgia), or can arise from pathologic processes and structures other than the ear (secondary or referred otalgia).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030766"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kulak ağrısı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ear pain</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030767">
        <obo:IAO_0000115 xml:lang="tr">Epignatustur genellikle sfenoid kemik veya sert damak ile bağlantılı, üst çeneden köken alan bir teratomadır</obo:IAO_0000115>
