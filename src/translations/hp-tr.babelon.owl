    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030068">
        <obo:IAO_0000115 xml:lang="tr">Süperior burun boşluğu ve kribriform tabakanın olfaktör epitelinden kaynaklanan malign olfaktör bir nöroblastom</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Olfaktör esteziyonöroblastom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030068"/>
