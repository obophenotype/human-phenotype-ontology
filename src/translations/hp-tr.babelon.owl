    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001009">
        <obo:IAO_0000115 xml:lang="tr">Telenjiektazi deri veya mukoz membran yüzeyine yakın yerleşmiş 0.5 ve 1 milimetre çap arasında ölçülen küçük, genişlemiş kan damarlarına denmektedir. Telenjiektaziler özellikle dil, dudaklar, parmaklar, yüz, konjunktiva, gövde, tırnak yatakları ve parmak uçlarında yer alır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Telenjiektazi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001009"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Telenjiektazi deri veya mukoz membran yüzeyine yakın yerleşmiş 0.5 ve 1 milimetre çap arasında ölçülen küçük, genişlemiş kan damarlarına denmektedir. Telenjiektaziler özellikle dil, dudaklar, parmaklar, yüz, konjunktiva, gövde, tırnak yatakları ve parmak uçlarında yer alır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Telangiectasias refer to small dilated blood vessels located near the surface of the skin or mucous membranes, measuring between 0.5 and 1 millimeter in diameter. Telangiectasia are located especially on the tongue, lips, palate, fingers, face, conjunctiva, trunk, nail beds, and fingertips.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001009"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Telenjiektazi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Telangiectasia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001010">
        <obo:IAO_0000115 xml:lang="tr">Melanin üretiminde ve depolanmasında azalma ile ilişkili deri renginin açılması</obo:IAO_0000115>
