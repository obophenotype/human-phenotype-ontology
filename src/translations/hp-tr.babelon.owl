    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000870">
        <obo:IAO_0000115 xml:lang="tr">Kanda anormal olarak artmış prolaktin seviyesi varlığı. Prolaktin ön hipofiz bezi tarafından üretilen meme gelişiminde ve gebelik esnasında laktasyonda rol oynayan peptit bir hormondur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Prolaktin fazlalığı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000870"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kanda anormal olarak artmış prolaktin seviyesi varlığı. Prolaktin ön hipofiz bezi tarafından üretilen meme gelişiminde ve gebelik esnasında laktasyonda rol oynayan peptit bir hormondur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of abnormally increased levels of prolactin in the blood. Prolactin is a peptide hormone produced by the anterior pituitary gland that plays a role in breast development and lactation during pregnancy.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000870"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Prolaktin fazlalığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased circulating prolactin concentration</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000871">
        <obo:IAO_0000115 xml:lang="tr">Bütün ön hipofiz hormonları (büyüme hormonu, tiroid stimüle edici hormon, folikül stimüle edici hormon, lüteinize edici hormon, adrenokortikotropikhormon ve prolaktin) etkileyen pitüiter fonksiyonel eksiklik</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Panhipopitüitarizm</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000871"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bütün ön hipofiz hormonları (büyüme hormonu, tiroid stimüle edici hormon, folikül stimüle edici hormon, lüteinize edici hormon, adrenokortikotropikhormon ve prolaktin) etkileyen pitüiter fonksiyonel eksiklik</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A pituitary functional deficit affecting all the anterior pituitary hormones (growth hormone, thyroid-stimulating hormone, follicle-stimulating hormone, luteinizing hormone, adrenocorticotropic hormone, and prolactin).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000871"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Panhipopitüitarizm</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Panhypopituitarism</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000872">
        <obo:IAO_0000115 xml:lang="tr">Hipotiroidizm ile ilişkili kronik, otoimmün bir tiroidit tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Haşimoto tiroiditi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
