        <owl:annotatedTarget xml:lang="tr">Saçların üzerinde büyüdüğü kafanın deri ve deri altı dokusu olan kafa derisinin herhangi bir anomalisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
