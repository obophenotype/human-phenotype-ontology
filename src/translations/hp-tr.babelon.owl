    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001140">
        <obo:IAO_0000115 xml:lang="tr">Epibulbar dermoid tipik olarak kornea ve sklera (limbal epibullar dermoid) bileşkesinde bulunan selim bir tümördür</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Epibulbar dermoid</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001140"/>
