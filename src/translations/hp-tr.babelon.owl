        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced thickness of the outer, dense layer of the myocardium.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031196"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">İnce myokardiyum sıkı tabaka</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Thin myocardium compact layer</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031197">
        <obo:IAO_0000115 xml:lang="tr">Protein bir matriste birleşmiş hücrelerden oluşan bir idrar kümesi tipi. Hücreler idrar sedimentinde (eritrositler, lökositler, renal tübüler epitel hücreleri) bulunabilenlerdir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hücresel idrar kümeleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031197"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Protein bir matriste birleşmiş hücrelerden oluşan bir idrar kümesi tipi. Hücreler idrar sedimentinde (eritrositler, lökositler, renal tübüler epitel hücreleri) bulunabilenlerdir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of urinary cast composed of cells incorporated in a protein matrix. The cells can be those found in the urinary sediment (erythrocytes, leuklocytes, renal tubular epithelial cells).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031197"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hücresel idrar kümeleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cellular urinary casts</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031198">
        <obo:IAO_0000115 xml:lang="tr">Renal tübüler epitel hücrelerinden oluşan bir tip hücresel idrar kümesi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Renal tübüler epitelyal hücre kümeleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031198"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Renal tübüler epitel hücrelerinden oluşan bir tip hücresel idrar kümesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of cellular urinary cast composed of renal tubular epithelial cells.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031198"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Renal tübüler epitelyal hücre kümeleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Renal tubular epithelial cell casts</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031199">
        <obo:IAO_0000115 xml:lang="tr">Azımsanmayacak sayıda hücre olmadan protein benzeri matristen oluşan idrar kümesi tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Aselüler idrar kümeleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031199"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Azımsanmayacak sayıda hücre olmadan protein benzeri matristen oluşan idrar kümesi tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of urinary cast composed of a proteinaceous matrix without a substantial number of cells.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031199"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Aselüler idrar kümeleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Acellular urinary casts</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031200">
        <obo:IAO_0000115 xml:lang="tr">Düşük kırılma indeksini açıklayan, sadece Tamm-Horsfall glikoproteinden oluşan bir çeşit acelüler üriner silindirler. Hyaline silindirler, abarık, kompakt, kıvrık veya kırışmış silindirleri içeren bir morfoloji spektrumunu gösterebilir. Hyaline silindirler pürüzsüz bir dokuya sahiptir ve genellikle açık kenarları ve kör uçları olan paralel kenarları vardır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hyalin kümeler</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031200"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Düşük kırılma indeksini açıklayan, sadece Tamm-Horsfall glikoproteinden oluşan bir çeşit acelüler üriner silindirler. Hyaline silindirler, abarık, kompakt, kıvrık veya kırışmış silindirleri içeren bir morfoloji spektrumunu gösterebilir. Hyaline silindirler pürüzsüz bir dokuya sahiptir ve genellikle açık kenarları ve kör uçları olan paralel kenarları vardır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of acellular urinary cast that are composed only of Tamm-Horsfall glycoprotein, a fact which explains their low refractive index. Hyaline casts may display a spectrum of morphologies, which includes fluffy, compact, convoluted or wrinkled casts. Hyaline casts have a smooth texture and usually have parallel sides with clear margins and blunted ends.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031200"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hyalin kümeler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hyaline casts</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031201">
        <obo:IAO_0000115 xml:lang="tr">Boyut olarak değişebilen granüllerden oluşan bir yüzeye sahip aselüler küme tipi. Granüller detaylıdan (ince ince granüler küme), kaba (kabaca granüler küme), koyu, temiz ve pigmentliye değişebildiği gibi heterojen de olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Granüler kümeler</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031201"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Boyut olarak değişebilen granüllerden oluşan bir yüzeye sahip aselüler küme tipi. Granüller detaylıdan (ince ince granüler küme), kaba (kabaca granüler küme), koyu, temiz ve pigmentliye değişebildiği gibi heterojen de olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of acelluar casts that have a surface composed of granules, which can vary in size. The granules can be rather heterogeneous, ranging from fine (finely granular cast) up to coarse (coarsely granular cast), dark, clear, and pigmented.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031201"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Granüler kümeler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Granular casts</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031202">
        <obo:IAO_0000115 xml:lang="tr">Eritilmiş balmumu (mumlu) görünümü göstermek için aselüler üriner kalıbın bir türü, bu da onlara yüksek refraktif indeks verir. Sıklıkla karanlıktırlar, kör uzantılar ile, dişli ve kırık kenarlar ve büyük bir boyutları vardır, bu da genellikle diğer türdeki yayın türlerinin birkaç katıdır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Mumsu kümeler</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031202"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Eritilmiş balmumu (mumlu) görünümü göstermek için aselüler üriner kalıbın bir türü, bu da onlara yüksek refraktif indeks verir. Sıklıkla karanlıktırlar, kör uzantılar ile, dişli ve kırık kenarlar ve büyük bir boyutları vardır, bu da genellikle diğer türdeki yayın türlerinin birkaç katıdır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of acellular urinary casts that display a melted wax (waxy) appearance, which gives them a high refractive index. They are frequently dark, with blunt extremities, indented and cracked edges and a large size, which is often several times that of other types of casts.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031202"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Mumsu kümeler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Waxy casts</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031203">
        <obo:IAO_0000115 xml:lang="tr">Lipid damlacıkları içeren bir hücresiz ürinerin türü, oval yağlı vücutlar veya kolesterol kristalleri, ve sıklıkla bu öğelerin serbest biçimleri ile ilişkilidir. Onların kimliğini saptama polarize ışık mikroskopisinin kullanılmasını gerektirebilir, Malta haçı olarak döküm kalıba benzeyenin içine ki yağlı parçacıkları gömülenlerin altına</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yağlı kümeler</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031203"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Lipid damlacıkları içeren bir hücresiz ürinerin türü, oval yağlı vücutlar veya kolesterol kristalleri, ve sıklıkla bu öğelerin serbest biçimleri ile ilişkilidir. Onların kimliğini saptama polarize ışık mikroskopisinin kullanılmasını gerektirebilir, Malta haçı olarak döküm kalıba benzeyenin içine ki yağlı parçacıkları gömülenlerin altına</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of acellular urinary casts that contain lipid droplets, oval fat bodies or cholesterol crystals, and are often associated with the free forms of these elements. Their identification may require the use of polarized light microscopy, under which fatty particles embedded into the cast matrix appear as Maltese crosses.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031203"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Yağlı kümeler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fatty casts</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031204">
        <obo:IAO_0000115 xml:lang="tr">Bakteri içeren bir idrar küme tipi. Bakteriyel kümelerin tanımlanması zor olabilir ve diğer kümelerden faz kontrast mikroskobisi kullanılarak ayrılabilir. Bakteriyel kümeler akut pyelonefrit veya intrinsik renal enfeksiyon için tanı koydurucudur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Bakteriyel hücre kümeleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031204"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bakteri içeren bir idrar küme tipi. Bakteriyel kümelerin tanımlanması zor olabilir ve diğer kümelerden faz kontrast mikroskobisi kullanılarak ayrılabilir. Bakteriyel kümeler akut pyelonefrit veya intrinsik renal enfeksiyon için tanı koydurucudur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of urinary cast that contain bacteria. Bacterial casts can be difficult to identify and can be distinguished from other types of casts using phase contrast microscopy. Bacterial casts are diagnostic of acute pyelonephritis or intrinsic renal infection.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031204"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Bakteriyel hücre kümeleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bacterial cell casts</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031205">
        <obo:IAO_0000115 xml:lang="tr">Kanda lizozomal asit lipaz (LAL) aktivitesinde azalma. Lizozomal lipaz aktivitesi ölçülür. LAL plazma lipoproteinlerinin hücre içine alınmasından elde edilen kolesterol esterlerini hidrolize eder</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Azalmış lizozomal asit lipaz aktivitesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031205"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kanda lizozomal asit lipaz (LAL) aktivitesinde azalma. Lizozomal lipaz aktivitesi ölçülür. LAL plazma lipoproteinlerinin hücre içine alınmasından elde edilen kolesterol esterlerini hidrolize eder</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduction in the activity of lysosomal acid lipase (LAL) in the blood. Lysosomal lipase activity is measured. LAL hydrolyzes cholesteryl esters derived from cell internalization of plasma lipoproteins.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031205"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Azalmış lizozomal asit lipaz aktivitesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced lysosomal acid lipase activity</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031206">
        <obo:IAO_0000115 xml:lang="tr">Beyin manyetik rezonans görüntülemesinde striatumdan gelen anormal parlak T2 sinyali</obo:IAO_0000115>
