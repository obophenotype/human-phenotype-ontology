        <obo:IAO_0000115 xml:lang="tr">Aortun pulmoner arterin önünde ve birincil olarak sağında olduğu büyük arterlerin bir transpozisyon (TGA) tipi. Bu en sık TGA türüdür</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Büyük arterlerin dekstrotranspozisyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
