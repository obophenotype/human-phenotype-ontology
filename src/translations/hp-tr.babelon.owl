    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001638">
        <obo:IAO_0000115 xml:lang="tr">Gözlemlenebilen miyokardiyal anormalliğe sebep olacak yeterlilikte koroner arter hastalığı, hipertansiyon, kapak hastalığı ve konjenital kalp hastalığı yokluğunda kalp kasının yapısal ve fonksiyonel olarak anormal olduğu bir miyokardiyal hastalık</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kardiyomiyopati</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001638"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Gözlemlenebilen miyokardiyal anormalliğe sebep olacak yeterlilikte koroner arter hastalığı, hipertansiyon, kapak hastalığı ve konjenital kalp hastalığı yokluğunda kalp kasının yapısal ve fonksiyonel olarak anormal olduğu bir miyokardiyal hastalık</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A myocardial disorder in which the heart muscle is structurally and functionally abnormal, in the absence of coronary artery disease, hypertension, valvular disease and congenital heart disease sufficient to cause the observed myocardial abnormality.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001638"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kardiyomiyopati</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cardiomyopathy</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001639">
        <obo:IAO_0000115 xml:lang="tr">Hipertrofik kardiyomyopati (HKM), gözlenen anormalliğe sebep olmaya yetecek yüklenme durumlarının (hipertansiyon, kapak hastalığı) yokluğunda artmış ventriküler duvar kalınlığının veya kütlesinin varlığı ile tanımlanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hipertrofik kardiyomiyopati</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001639"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hipertrofik kardiyomyopati (HKM), gözlenen anormalliğe sebep olmaya yetecek yüklenme durumlarının (hipertansiyon, kapak hastalığı) yokluğunda artmış ventriküler duvar kalınlığının veya kütlesinin varlığı ile tanımlanır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypertrophic cardiomyopathy (HCM) is defined by the presence of increased ventricular wall thickness or mass in the absence of loading conditions (hypertension, valve disease) sufficient to cause the observed abnormality.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001639"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hipertrofik kardiyomiyopati</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypertrophic cardiomyopathy</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001640">
        <obo:IAO_0000115 xml:lang="tr">Artmış kalp boyutu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kardiyomegali</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001640"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Artmış kalp boyutu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased size of the heart, clinically defined as an increased transverse diameter of the cardiac silhouette that is greater than or equal to 50% of the transverse diameter of the chest (increased cardiothoracic ratio) on a posterior-anterior projection of a chest radiograph or a computed tomography.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001640"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kardiyomegali</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cardiomegaly</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001641">
        <obo:IAO_0000115 xml:lang="tr">Pulmoner kapağın bir anomalisi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Pulmoner kapak morfolojisi anormalliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001641"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Pulmoner kapağın bir anomalisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any structural abnormality of the pulmonary valve.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001641"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Pulmoner kapak morfolojisi anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal pulmonary valve morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001642">
        <obo:IAO_0000115 xml:lang="tr">Pulmoner kapakta (valvüler stenoz) veya pulmoner kapağın hemen aşağısında (infundibuler stenoz) meydana gelebilen sağ ventriküler çıkış yolu daralması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Pulmoner stenoz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001642"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Pulmoner kapakta (valvüler stenoz) veya pulmoner kapağın hemen aşağısında (infundibuler stenoz) meydana gelebilen sağ ventriküler çıkış yolu daralması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A narrowing of the right ventricular outflow tract that can occur at the pulmonary valve (valvular stenosis), below the pulmonary valve (infundibular stenosis), or above the pulmonary valve (supravalvar stenosis).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001642"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Pulmoner stenoz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pulmonic stenosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001643">
        <obo:IAO_0000115 xml:lang="tr">Duktus arteriozus (DA) ana pulmoner arteri inen aortaya bağlayarak ventriküler çıkışı in utero dönemde akciğerlerden plasentaya doğru yönlendirme görevi yapar. Patent duktus arteriozus (PDA) hayatın ilk 3 gününde sağlıklı olarak ve preterm yenidoğan infantlarda fizyolojik bir şanttır ve normal olarak büyük ölçüde doğumdan sonra yaklaşık 24 saat içinde kapanır ve yaklaşık üç hafta sonra tamamen kapanır. Fizyolojik kapanma yetersizliğine kalıcı veya patent duktus arteriozus (PDA) denir. Soldan sağa şant derecesine bağlı olarak PDA&apos;nın klinik sonuçları olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Patent duktus arteriozus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001643"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Duktus arteriozus (DA) ana pulmoner arteri inen aortaya bağlayarak ventriküler çıkışı in utero dönemde akciğerlerden plasentaya doğru yönlendirme görevi yapar. Patent duktus arteriozus (PDA) hayatın ilk 3 gününde sağlıklı olarak ve preterm yenidoğan infantlarda fizyolojik bir şanttır ve normal olarak büyük ölçüde doğumdan sonra yaklaşık 24 saat içinde kapanır ve yaklaşık üç hafta sonra tamamen kapanır. Fizyolojik kapanma yetersizliğine kalıcı veya patent duktus arteriozus (PDA) denir. Soldan sağa şant derecesine bağlı olarak PDA&apos;nın klinik sonuçları olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>In utero, the ductus arteriosus (DA) serves to divert ventricular output away from the lungs and toward the placenta by connecting the main pulmonary artery to the descending aorta. A patent ductus arteriosus (PDA) in the first 3 days of life is a physiologic shunt in healthy term and preterm newborn infants, and normally is substantially closed within about 24 hours after bith and completely closed after about three weeks. Failure of physiologcal closure is referred to a persistent or patent ductus arteriosus (PDA). Depending on the degree of left-to-right shunting, PDA can have clinical consequences.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001643"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Patent duktus arteriozus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Patent ductus arteriosus</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001644">
        <obo:IAO_0000115 xml:lang="tr">Anormal kalp yükü durumları (hipertansiyon, kapak hastalığı) olmaksızın sol ventrikül dilatasyonu ve sol ventrikül sistolik disfonksiyonu dilate kardiyomyopati (DKM) olarak tanımlanır ve genel sistolik bozukluk için yeterlidir. Sağ ventrikül dilatasyonu ve disfonksiyonu da bulunabilir ama tanı için gerekli değildir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dilate kardiyomiyopati</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001644"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Anormal kalp yükü durumları (hipertansiyon, kapak hastalığı) olmaksızın sol ventrikül dilatasyonu ve sol ventrikül sistolik disfonksiyonu dilate kardiyomyopati (DKM) olarak tanımlanır ve genel sistolik bozukluk için yeterlidir. Sağ ventrikül dilatasyonu ve disfonksiyonu da bulunabilir ama tanı için gerekli değildir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dilated cardiomyopathy (DCM) is defined by the presence of left ventricular dilatation and left ventricular systolic dysfunction in the absence of abnormal loading conditions (hypertension, valve disease) or coronary artery disease sufficient to cause global systolic impairment. Right ventricular dilation and dysfunction may be present but are not necessary for the diagnosis.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001644"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Dilate kardiyomiyopati</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dilated cardiomyopathy</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001645">
        <obo:IAO_0000115 xml:lang="tr">Ani ve beklenmedik bir şekilde kalp atımının durması ve kısa bir süre içinde ölümle sonuçlanması (genelde semptomların başlamasından itibaren 1 saat içinde)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ani kardiyak ölüm</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001645"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ani ve beklenmedik bir şekilde kalp atımının durması ve kısa bir süre içinde ölümle sonuçlanması (genelde semptomların başlamasından itibaren 1 saat içinde)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The heart suddenly and unexpectedly stops beating resulting in death within a short time period (generally within 1 h of symptom onset).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001645"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ani kardiyak ölüm</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sudden cardiac death</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001646">
        <obo:IAO_0000115 xml:lang="tr">Aort kapağının herhangi bir anomalisi</obo:IAO_0000115>
