    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025252">
        <obo:IAO_0000115 xml:lang="tr">Dilin filiform papillelerinin kaybedilmesi (atrofi) ile karakterize, eritem alanlarını (kızarıklık) türeten, serpijinöz, beyaz, hiperkeratotik bir sınırla çevrelenmiş bir anomalidir. Coğrafi dil adı, bir haritaya benzeyen bir görünümü ifade eder</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Harita dil</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025252"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Dilin filiform papillelerinin kaybedilmesi (atrofi) ile karakterize, eritem alanlarını (kızarıklık) türeten, serpijinöz, beyaz, hiperkeratotik bir sınırla çevrelenmiş bir anomalidir. Coğrafi dil adı, bir haritaya benzeyen bir görünümü ifade eder</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly of the tongue characterized by loss (atrophy) of filiform papillae of the tongue, leaving areas of erythema (redness), surrounded by a serpiginous, white, hyperkeratotic border. The name geographic tongue refers to an appearance that is said to be similar to a map.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025252"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Harita dil</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Geographic tongue</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025253">
        <obo:IAO_0000115 xml:lang="tr">Anormal olarak kaçma imkanının olmadığı kapalı veya dar alanda olma korkusu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Klostrofobi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025253"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Anormal olarak kaçma imkanının olmadığı kapalı veya dar alanda olma korkusu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal fear of being in a closed or narrow space with no escape is called claustrophobia.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
