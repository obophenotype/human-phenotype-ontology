    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005174">
        <obo:IAO_0000115 xml:lang="tr">Diyafram benzeri bir membranın sebep olduğu subvalvuler stenoz. Stenoz genellikle diğer aortik stenoz şekilleri gibi bulgu verir fakat sıklıkla biraz aort yetersizliği de bulunur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Membranöz subvalvuler aortik stenoz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
