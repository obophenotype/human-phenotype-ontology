    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030858">
        <obo:IAO_0000115 xml:lang="tr">Kişiye veya başkalarına zarar veren bir eylemi gerçekleştirmek için bir dürtü, itki veya ayartmaya başarısızlık tarafından karakterize edilen davranışın tekrarlayan kalıbı. Bu davranışlara tekrar tekrar devam etme, diğer alanlardaki işlevi yerine getirmeyi en sonunda engellemektedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Bağımlılık yapan davranış</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
