    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011822">
        <obo:IAO_0000115 xml:lang="tr">Üstü yumuşak doku ile kaplı mandibuların (zihinsel protüberans) orta noktasının artmış genişliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Geniş çene</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011822"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Üstü yumuşak doku ile kaplı mandibuların (zihinsel protüberans) orta noktasının artmış genişliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased width of the midpoint of the mandible (mental protuberance) and overlying soft tissue.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
