    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031248">
        <obo:IAO_0000115 xml:lang="tr">Pruritus bir kaşıntı veya bir kişinin kaşınmasını sağlayan bir histir. Bu terim, elin avuç içi(leri) üzerinde anormal derecede artmış kaşınma hissi anlamına gelir</obo:IAO_0000115>
