        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031437">
        <obo:IAO_0000115 xml:lang="tr">Hamile kadınların potansiyel olarak düşük, erken doğum, düşük doğum ağırlığı ve bazı durumlarda bebeklerde gelişme geriliği gibi sorunlar oluşturabilecek çevresel toksin ve kimyasallar gibi herhangi bir kaynaktan toksine maruziyeti</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hamilelikte maruziyet</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031437"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hamile kadınların potansiyel olarak düşük, erken doğum, düşük doğum ağırlığı ve bazı durumlarda bebeklerde gelişme geriliği gibi sorunlar oluşturabilecek çevresel toksin ve kimyasallar gibi herhangi bir kaynaktan toksine maruziyeti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Exposure of pregnant women to toxins from any source, such as environmental toxins or chemicals, that may potentially cause problems such as miscarriage, preterm delivery, low birth weight, and, in some cases, developmental delays in infants.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031437"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hamilelikte maruziyet</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pregnancy exposure</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
