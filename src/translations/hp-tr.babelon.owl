        <babelon:source_value>Triggered by excitement</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025228">
        <obo:IAO_0000115 xml:lang="tr">Ani bir hareket ile provoke edilen veya ortaya çıkarılan bir bulgu veya belirti için geçerlidir</obo:IAO_0000115>
