        <rdfs:label xml:lang="tr">Kardiyomiyosit dejenerasyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031332"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Miyofilaman kaybı, hücresel sekestrasyon meydana gelmesi, azalmış mitokondriyal boyut ve hücresel debris gibi anormal özellikler ile karakterize kardiyomyosit bozulması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Deterioration of cardiomyocyte characterized by abnormal features such as loss of myofilaments, occurrence of cellular sequestration, decreased mitochondrial sizes and cellular debris.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
