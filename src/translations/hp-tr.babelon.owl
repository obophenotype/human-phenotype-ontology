        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031241">
        <obo:IAO_0000115 xml:lang="tr">Neovaskülarizasyon sahasının fovea merkezi ile çakıştığı bir tip koroidal neovaskülarizasyon</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Subfoveal koroidal yeniden damarlanma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031241"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Neovaskülarizasyon sahasının fovea merkezi ile çakıştığı bir tip koroidal neovaskülarizasyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
