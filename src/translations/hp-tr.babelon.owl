        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A history of repeated fungal infections located on the sole of the foot, usually manifested by scaling, maceration, and itching.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
