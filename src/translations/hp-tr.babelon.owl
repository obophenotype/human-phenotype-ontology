    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025229">
        <obo:IAO_0000115 xml:lang="tr">Baş dönmesi, soğuk ısı, postürel değişiklikler veya dönen sandalye dahil vestibüler stimülasyon ile provoke edilen veya ortaya çıkarılan bir bulgu veya belirti için geçerlidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Vestibüler stimülasyon tarafından tetiklenen</rdfs:label>
