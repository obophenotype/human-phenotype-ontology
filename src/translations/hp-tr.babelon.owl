    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025035">
        <obo:IAO_0000115 xml:lang="tr">Prolifitroblastın anormal biçimi, yani, eritropoez evresini işgal eden olgunlaşmamış, çekirdekleşmiş eritrosit, eritroid progenitör hücrelerin oluşumunu takip eder. Bu hücre CD71 pozitiftir, Hem çekirdek hem de çekirdeği vardır ve hematopoietik soy belirteçlerinden yoksundur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal proeritroblast morfolojisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025035"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Prolifitroblastın anormal biçimi, yani, eritropoez evresini işgal eden olgunlaşmamış, çekirdekleşmiş eritrosit, eritroid progenitör hücrelerin oluşumunu takip eder. Bu hücre CD71 pozitiftir, Hem çekirdek hem de çekirdeği vardır ve hematopoietik soy belirteçlerinden yoksundur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anomalous form of the proerythroblast, i.e., the immature, nucleated erythrocyte occupying the stage of erythropoeisis that follows formation of erythroid progenitor cells. This cell is CD71-positive, has both a nucleus and a nucleolus, and lacks hematopoeitic lineage markers.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025035"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal proeritroblast morfolojisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal proerythroblast morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
