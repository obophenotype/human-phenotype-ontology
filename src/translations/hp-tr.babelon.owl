    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500009">
        <obo:IAO_0000115 xml:lang="tr">Serebellumun yavaş büyüyen, nadir bir tümörüdür, bazen bir hamartom olarak düşünülen, serebellumun granüler katmanında diffüz hipertrofi ile karakterize bir gangliositoma</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Serebellumun displastik gangliositomu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500009"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Serebellumun yavaş büyüyen, nadir bir tümörüdür, bazen bir hamartom olarak düşünülen, serebellumun granüler katmanında diffüz hipertrofi ile karakterize bir gangliositoma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>It is a rare, slowly growing tumor of the cerebellum, a gangliocytoma sometimes considered to be a hamartoma, characterized by diffuse hypertrophy of the granular layer of the cerebellum.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
