        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Multifokal atrial taşikardi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Multifocal atrial tachycardia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011702">
        <obo:IAO_0000115 xml:lang="tr">Sağ atriyumda sinoatriyal (SA) nod anormalliği. SA nod kalbin ritim hız ayarlayıcısı olarak görev yapar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sinoatriyal nod kökenli anormal elektrofizyoloji</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011702"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sağ atriyumda sinoatriyal (SA) nod anormalliği. SA nod kalbin ritim hız ayarlayıcısı olarak görev yapar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the sinoatrial (SA) node in the right atrium. THe SA node acts as the pacemaker of the heart.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011702"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Sinoatriyal nod kökenli anormal elektrofizyoloji</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal electrophysiology of sinoatrial node origin</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011703">
        <obo:IAO_0000115 xml:lang="tr">Dakikada 100 atımdan fazla kalp hızı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sinüs taşikardisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011703"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Dakikada 100 atımdan fazla kalp hızı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Heart rate of greater than 100 beats per minute.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011703"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Sinüs taşikardisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sinus tachycardia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011704">
        <obo:IAO_0000115 xml:lang="tr">Sinüs düğümü tarafından aksiyon potansiyelinin oluşumunu içeren bir anormallik fizyolojik gereksinimler için uygun olmayan bir atriyal hız ile karakterize edilir. Belirtileri arasında, ciddi sinüs bradikardisi, sinüs yumru çıkış kütlesi, kronik atriyal taşiaritmiler, atriyal bradiaritmilerin ve taşiaritmilerin değişen periyotları, ve egzersiz veya stres sırasında kalp hızının düzensizliği vardır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hasta sinüs sendromu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011704"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sinüs düğümü tarafından aksiyon potansiyelinin oluşumunu içeren bir anormallik fizyolojik gereksinimler için uygun olmayan bir atriyal hız ile karakterize edilir. Belirtileri arasında, ciddi sinüs bradikardisi, sinüs yumru çıkış kütlesi, kronik atriyal taşiaritmiler, atriyal bradiaritmilerin ve taşiaritmilerin değişen periyotları, ve egzersiz veya stres sırasında kalp hızının düzensizliği vardır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality involving the generation of the action potential by the sinus node and is characterized by an atrial rate inappropriate for physiological requirements. Manifestations include severe sinus bradycardia, sinus pauses or arrest, sinus node exit block, chronic atrial tachyarrhythmias, alternating periods of atrial bradyarrhythmias and tachyarrhythmias, and inappropriate responses of heart rate during exercise or stress.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011704"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hasta sinüs sendromu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sick sinus syndrome</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011705">
        <obo:IAO_0000115 xml:lang="tr">Elektrokardiyogramda (EKG) PR intervalinin uzaması olarak kendini gösteren atriyoventriküler noddan iletimin gecikmesi. Bütün atriyal iletiler ventriküle ulaşır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Birinci derece atrioventriküler blok</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011705"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Elektrokardiyogramda (EKG) PR intervalinin uzaması olarak kendini gösteren atriyoventriküler noddan iletimin gecikmesi. Bütün atriyal iletiler ventriküle ulaşır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Delay of conduction through the atrioventricular node, which is manifested as prolongation of the PR interval in the electrocardiogram (EKG). All atrial impulses reach the ventricles.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011705"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Birinci derece atrioventriküler blok</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>First degree atrioventricular block</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011706">
        <obo:IAO_0000115 xml:lang="tr">Bazı atriyal uyarıların ventriküllere iletilememesi, yani bütün uyarıların değil ancak bir kısım atriyal uyarının atriyoventriküler noddan iletilmesi ve ventriküler kontraksiyonu tetiklemesi ile olan aralıklı atriyoventriküler blok</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İkinci derece atrioventriküler blok</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011706"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bazı atriyal uyarıların ventriküllere iletilememesi, yani bütün uyarıların değil ancak bir kısım atriyal uyarının atriyoventriküler noddan iletilmesi ve ventriküler kontraksiyonu tetiklemesi ile olan aralıklı atriyoventriküler blok</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An intermittent atrioventricular block with failure of some atrial impulses to conduct to the ventricles, i.e., some but not all atrial impulses are conducted through the atrioventricular node and trigger ventricular contraction.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011706"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">İkinci derece atrioventriküler blok</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Second degree atrioventricular block</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011707">
        <obo:IAO_0000115 xml:lang="tr">Bir duraksamaya neden olan takip eden tek bir iletilmemiş P dalga oluşumlu ilerleyici PR aralığı uzaması. İletilmeyen uyarıyı takiben olan duraksama tam kompanse olma durumundan azdır (iki normal sinüs aralığının toplamından azdır)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Mobitz I atriyoventriküler blok</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011707"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir duraksamaya neden olan takip eden tek bir iletilmemiş P dalga oluşumlu ilerleyici PR aralığı uzaması. İletilmeyen uyarıyı takiben olan duraksama tam kompanse olma durumundan azdır (iki normal sinüs aralığının toplamından azdır)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Progressive PR interval prolongation with the subsequent occurrence of a single nonconducted P wave that results in a pause. The pause that follows the nonconducted impulse is less than fully compensatory (less than the sum of two normal sinus intervals).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011707"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Mobitz I atriyoventriküler blok</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mobitz I atrioventricular block</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011708">
        <obo:IAO_0000115 xml:lang="tr">Öncesinde PR intervalinde bir değişiklik olmadan AV noddan bir uyarının ani olarak iletilememesi ile karakterize ani ikinci derece bir atriyoventriküler (AV) blok tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Mobitz II atriyoventriküler blok</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011708"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Öncesinde PR intervalinde bir değişiklik olmadan AV noddan bir uyarının ani olarak iletilememesi ile karakterize ani ikinci derece bir atriyoventriküler (AV) blok tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of second degree atrioventricular (AV) block characterized by sudden failure to conduct an impulse through the AV node without a preceding change in the PR interval.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011708"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Mobitz II atriyoventriküler blok</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mobitz II atrioventricular block</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011709">
        <obo:IAO_0000115 xml:lang="tr">Atriyumlar ve ventriküller iki ayrı ritim ayarlayıcısı kontrolü altında ise atriyoventriküler (AV) disosiasyon mevcuttur. AV disosiasyon birincil AV iletim düzensizliği yokluğunda meydana gelebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Atriyoventriküler ayrışma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011709"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Atriyumlar ve ventriküller iki ayrı ritim ayarlayıcısı kontrolü altında ise atriyoventriküler (AV) disosiasyon mevcuttur. AV disosiasyon birincil AV iletim düzensizliği yokluğunda meydana gelebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrioventricular (AV) dissociation is present if the atria and the ventricles are under the control of two separate pacemakers. AV dissociation can occur in the absence of a primary AV conduction disturbance.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011709"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Atriyoventriküler ayrışma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrioventricular dissociation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011710">
        <obo:IAO_0000115 xml:lang="tr">His demeti boyunca veya onun demet dalları boyunca olan elektriksel uyarı iletim bloğu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Demet dal bloğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011710"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">His demeti boyunca veya onun demet dalları boyunca olan elektriksel uyarı iletim bloğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Block of conduction of electrical impulses along the Bundle of His or along one of its bundle branches.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011710"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
