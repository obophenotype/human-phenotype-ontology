    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000444">
        <obo:IAO_0000115 xml:lang="tr">Burun kökünü ve burun ucunu birbirine bağlayan hayali çizginin önüne doğru kavislenen burun sırtı. Burun sıklıkla belirgin ve kolumella aşağı olarak da gözükür</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dışbükey burun sırtı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000444"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Burun kökünü ve burun ucunu birbirine bağlayan hayali çizginin önüne doğru kavislenen burun sırtı. Burun sıklıkla belirgin ve kolumella aşağı olarak da gözükür</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nasal ridge curving anteriorly to an imaginary line that connects the nasal root and tip. The nose appears often also prominent, and the columella low.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
