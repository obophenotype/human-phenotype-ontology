    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000956">
        <obo:IAO_0000115 xml:lang="tr">Tipik olarak boynun nemli deri katlantıları üzerinde kalınlaşmış, hiperpigmente plaklar ile karakterize dermatozis</obo:IAO_0000115>
