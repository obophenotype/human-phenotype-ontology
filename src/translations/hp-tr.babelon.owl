        <rdfs:label xml:lang="tr">Palilaliya</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031814"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Birinin kendi kelimelerini veya ifadelerini tekrarı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Palilalia is the involuntary repetition of one&apos;s own phrases, words, or syllables 2 or more times in a row. Typically, palilalic utterances decrease in volume with the increasing number of repetitions. Sometimes, the repetitions are also uttered with an accelerating speed.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
