        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Sol demet dal bloğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Left bundle branch block</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011714">
        <obo:IAO_0000115 xml:lang="tr">Libman-Sacks valvüler lezyonları sol taraflı kal kapaklarını tercih eden ve mitral kapağın sıklıkla ventriküler yüzeyinde oluşan steril fibröfibrinöz vejetasyonlardır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Libman-Sacks lezyonları</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011714"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Libman-Sacks valvüler lezyonları sol taraflı kal kapaklarını tercih eden ve mitral kapağın sıklıkla ventriküler yüzeyinde oluşan steril fibröfibrinöz vejetasyonlardır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Libman-Sacks valvular lesions are sterile fibrofibrinous vegetations that favor the left-sided heart valves and usually form on the ventricular surface of the mitral valve.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011714"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Libman-Sacks lezyonları</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Libman-Sacks lesions</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011715">
        <obo:IAO_0000115 xml:lang="tr">İntraventriküler iletim dokusunun her üç kısmında anormal iletim</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Trifasiküler blok</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011715"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İntraventriküler iletim dokusunun her üç kısmında anormal iletim</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal conduction in all three divisions of the intraventricular conducting tissue.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
