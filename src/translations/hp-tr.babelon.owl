    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010026">
        <obo:IAO_0000115 xml:lang="tr">1. metakarpalı etkileyen aplazi veya hipoplazi. 2-5 metakarpallarının aksine, birinci metakarpal embriyolojik olarak falanks kaynaklıdır ve 2-5 rakamlarının proksimal falankslarına eşdeğerdir (başparmağın proksimal falanksı diğer rakamların orta falankslarına eşdeğer iken)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">1. metakarpal aplazisi/hipoplazisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010026"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">1. metakarpalı etkileyen aplazi veya hipoplazi. 2-5 metakarpallarının aksine, birinci metakarpal embriyolojik olarak falanks kaynaklıdır ve 2-5 rakamlarının proksimal falankslarına eşdeğerdir (başparmağın proksimal falanksı diğer rakamların orta falankslarına eşdeğer iken)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aplasia or Hypoplasia affecting the 1st metacarpal. In contrast to the metacarpals 2-5, the first metacarpal is embryologically of phalangeal origin and as such equivalent to the proximal phalanges of the digits 2-5 (whereas the proximal phalanx of the thumb is equivalent to the middle phalanges of the other digits).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010026"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">1. metakarpal aplazisi/hipoplazisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aplasia/Hypoplasia of the 1st metacarpal</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010027">
        <obo:IAO_0000115 xml:lang="tr">Artmış 1. metakarapal genişliği. 2-5 basamaklarının proksimal falankslarının aksine, başparmağın proksimal falanksı embriyolojik olarak diğer rakamların orta falankslarına eşdeğer iken, ilk metakarp embriyolojik olarak falanks kaynaklıdır ve bu şekilde proksimal diğer rakamların falankslarına eşittir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Geniş 1. metakarpal</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010027"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Artmış 1. metakarapal genişliği. 2-5 basamaklarının proksimal falankslarının aksine, başparmağın proksimal falanksı embriyolojik olarak diğer rakamların orta falankslarına eşdeğer iken, ilk metakarp embriyolojik olarak falanks kaynaklıdır ve bu şekilde proksimal diğer rakamların falankslarına eşittir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased width of the 1st metacarpal. In contrast to the proximal phalanges of the digits 2-5, the proximal phalanx of the thumb is embryologically equivalent to the middle phalanges of the other digits, whereas the first metacarpal is embryologically of phalangeal origin and as such equivalent to the proximal phalanges of the other digits.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010027"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Geniş 1. metakarpal</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Broad 1st metacarpal</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010028">
        <obo:IAO_0000115 xml:lang="tr">&quot;Distale doğru incelen (&quot;&quot;kurşun şekilli&quot;&quot;) kısa ve geniş 1. metakarpal varlığı&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Mermi şeklinde 1. metakarpal</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010028"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">&quot;Distale doğru incelen (&quot;&quot;kurşun şekilli&quot;&quot;) kısa ve geniş 1. metakarpal varlığı&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>&quot;The presence of short and wide 1st metacarpal which tapers distally (&quot;&quot;bullet shaped&quot;&quot;).&quot;</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
