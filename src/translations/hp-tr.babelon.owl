    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010373">
        <obo:IAO_0000115 xml:lang="tr">Distale doğru incelen kısa ve geniş bir falanks ile dördüncü ayak parmağının bir veya daha fazla falanksının anormal bir morfolojisi. Mermi şeklindeki falankslar normal diyafizyal daralmadan yoksundur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kurşun şekilli 4. ayak parmağı falanksı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010373"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Distale doğru incelen kısa ve geniş bir falanks ile dördüncü ayak parmağının bir veya daha fazla falanksının anormal bir morfolojisi. Mermi şeklindeki falankslar normal diyafizyal daralmadan yoksundur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal morphology of one or more phalanges of the fourth toe, with a short and wide phalanx that tapers distally. Bullet-shaped phalanges lack the normal diaphyseal constriction.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
