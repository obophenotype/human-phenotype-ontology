    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032027">
        <obo:IAO_0000115 xml:lang="tr">Retinada iyi tanımlı/ayırt edilebilen, bireysel ve çoğunlukla tek tip boyutta olan sarı, beyaz veya grimsi lezyonlar</obo:IAO_0000115>
