    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010448">
        <obo:IAO_0000115 xml:lang="tr">Kolon lümeninin tamamen tıkanması ile sonuçlanan gelişimsel bir defekt. Bu, kolonun tübüler yapısının anormal bir kapanmaya veya atreziye sahip olması demektir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kolonik atrezi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010448"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kolon lümeninin tamamen tıkanması ile sonuçlanan gelişimsel bir defekt. Bu, kolonun tübüler yapısının anormal bir kapanmaya veya atreziye sahip olması demektir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A developmental defect resulting in complete obliteration of the lumen of the colon. That is, there is an abnormal closure, or atresia of the tubular structure of the colon.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
