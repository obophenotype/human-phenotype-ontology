    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032146">
        <obo:IAO_0000115 xml:lang="tr">Başlangıç metiyonin rezidüsünün lizin tarafından takip edildiği pozisyon 7&apos;de glutamik asit rezidüsünün değişimi ile karakterize anormal bir hemoglobin tipi varlığı (6GAG&gt;6AAG). HbC varlığı hemoglobin elektroforezi tarafından belirlenmektedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">HbC hemoglobin</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032146"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Başlangıç metiyonin rezidüsünün lizin tarafından takip edildiği pozisyon 7&apos;de glutamik asit rezidüsünün değişimi ile karakterize anormal bir hemoglobin tipi varlığı (6GAG&gt;6AAG). HbC varlığı hemoglobin elektroforezi tarafından belirlenmektedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Presence of an abnormal type of hemoglobin characterized by the substitution of a glutamic acid residue at position 7 following the initial methionine residue by a lysine (6GAG&gt;6AAG). The presence of HbC can be determined by hemoglobin electrophoresis.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
