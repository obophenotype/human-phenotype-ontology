    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012475">
        <obo:IAO_0000115 xml:lang="tr">Özel bir antijene veya mikroorganizmaya karşı yöneltilen spesifik immünoglobülin eksikliği ile normal toplam immünoglobülin seviyelerinin varlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Özel antikor eksikliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012475"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Özel bir antijene veya mikroorganizmaya karşı yöneltilen spesifik immünoglobülin eksikliği ile normal toplam immünoglobülin seviyelerinin varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced ability of the immune system to produce targeted, protective antibodies (immunoglobulins) against specific pathogens or vaccines in the setting of normal or near-normal serum levels of total IgG, IgA, and IgM and normal absolute counts of B cells and T cells.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
