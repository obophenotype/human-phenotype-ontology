        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011996">
        <obo:IAO_0000115 xml:lang="tr">Çok küçük trombin miktarı vasıtası (ve çok fazla trombin miktarı ile inaktive edilen) ile faktör Va&apos;ya aktive olan Faktör V artmış koagülasyon faktör V aktivitesi. Aktive edilmiş faktör V (fVa) protrombinaz kompleksinin oluşumunda bir kofaktördür</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yükselmiş faktör V aktivitesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011996"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çok küçük trombin miktarı vasıtası (ve çok fazla trombin miktarı ile inaktive edilen) ile faktör Va&apos;ya aktive olan Faktör V artmış koagülasyon faktör V aktivitesi. Aktive edilmiş faktör V (fVa) protrombinaz kompleksinin oluşumunda bir kofaktördür</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased activity of coagulation factor V, Factor V, which is activated to factor Va by means of minute amounts of thrombin (and inactivated by larger amounts of thrombin). Activated factor V (fVa) is a cofactor in the formation of the prothrombinase complex.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
