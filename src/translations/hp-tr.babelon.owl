    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000396">
        <obo:IAO_0000115 xml:lang="tr">Heliksin normalden daha fazla derecede katlandığı bir durumdur. Bu da heliks kenarının aşırı kıvrımının, serbest kenarın kulak düzlemine paralel olmasıdır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Aşırı katlanmış heliks</rdfs:label>
    </rdf:Description>
