        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031278"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal torasik kanal morfolojisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal thoracic duct morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031279">
        <obo:IAO_0000115 xml:lang="tr">Gonadotropin salınım hormonunun (GnRH) uyarı testine karşı verdiği anormal yanıt. Bu test, genel olarak, leninizasyon hormonu (LH) ve folikül uyarıcı hormonu (FSH) ın kandaki mevcudiyet düzeylerini ölçmek için, GnRH&apos;nin intravenöz uygulanması ile birlikte çeşitli zaman aralıklarında tekrarlanan kan örneklerinin incelenmesinden oluşur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Gonadotropin salgılatıcı hormon stimülasyon testine anormal yanıt</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031279"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Gonadotropin salınım hormonunun (GnRH) uyarı testine karşı verdiği anormal yanıt. Bu test, genel olarak, leninizasyon hormonu (LH) ve folikül uyarıcı hormonu (FSH) ın kandaki mevcudiyet düzeylerini ölçmek için, GnRH&apos;nin intravenöz uygulanması ile birlikte çeşitli zaman aralıklarında tekrarlanan kan örneklerinin incelenmesinden oluşur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal response to the gonadotropin-releasing hormone (GnRH) stimulation test. This test typically involves intravenous administration of GnRH followed by repeated blood sampling at various time points to measure the levels of luteinizing hormone (LH) and follicle-stimulating hormone (FSH).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031279"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Gonadotropin salgılatıcı hormon stimülasyon testine anormal yanıt</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal response to gonadotropin-releasing hormone stimulation test</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031280">
        <obo:IAO_0000115 xml:lang="tr">Gonadotropin salgılatıcı hormon uyarı testini takiben anormal olarak yüksek lüteinize edici hormon (LH) miktarı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Gonadotropin salgılatıcı hormon stimülasyon testine artmış LH yanıtı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031280"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Gonadotropin salgılatıcı hormon uyarı testini takiben anormal olarak yüksek lüteinize edici hormon (LH) miktarı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormally high amount of luteinizing hormone (LH) is released upon gonadotropin-releasing hormone stimulation test.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031280"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Gonadotropin salgılatıcı hormon stimülasyon testine artmış LH yanıtı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased LH response to gonadotropin-releasing hormone stimulation test</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
