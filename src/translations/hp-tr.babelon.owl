        <owl:annotatedTarget xml:lang="tr">Bir ekstremitenin bütün parmaklarının bütün falankslarının ve ilişkili yumuşak dokularının yokluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
