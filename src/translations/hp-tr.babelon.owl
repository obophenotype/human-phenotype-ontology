    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025113">
        <obo:IAO_0000115 xml:lang="tr">Sesin hacmi ne olursa olsun, ses konusunda olumsuz bir yanıt (beğenilmeyen), bazen rahatsız edici sese ait kaynağın görülmesiyle daha tetiklenebilir yumuşak seslere karşı güçlü bir negatif tepki ile karakterize edilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Misofoni</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025113"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sesin hacmi ne olursa olsun, ses konusunda olumsuz bir yanıt (beğenilmeyen), bazen rahatsız edici sese ait kaynağın görülmesiyle daha tetiklenebilir yumuşak seslere karşı güçlü bir negatif tepki ile karakterize edilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Misophonia is characterized by strong physiological, emotional, and behavioral reactions to auditory, visual, and/or kinesthetic stimuli of different nature regardless of their physical characteristics. These misophonic responses include anger, general discomfort, disgust, anxiety, and avoidance and escape behaviors.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025113"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Misofoni</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Misophonia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025114">
        <obo:IAO_0000115 xml:lang="tr">Hipergranülozis stratum granülozumun artmış kalınlığıdır</obo:IAO_0000115>
