        <babelon:source_value>Ivory epiphysis of the 1st metacarpal</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010022">
        <obo:IAO_0000115 xml:lang="tr">Aksesuar epifiz metakarpalin distal ucunda yer alabilmesine rağmen birinci metakarpal epifizi metakarpal kemiğin proksimal ucunda yer alır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">1. metakarpalın psödoepifizi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010022"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Aksesuar epifiz metakarpalin distal ucunda yer alabilmesine rağmen birinci metakarpal epifizi metakarpal kemiğin proksimal ucunda yer alır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The epiphysis of the first metacarpal is localized at the proximal end of the metacarpal bone although an accessory epiphysis may be located at the distal end of the metacarpal.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
