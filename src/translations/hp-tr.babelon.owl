    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010874">
        <obo:IAO_0000115 xml:lang="tr">Ekstensor tendon (tipik olarak eklem, Aşil tendonları, diz ve dirsekler üzerinde) ksantomların varlığı (hücre içi ve hücre dışı kolesterol birikimleri)</obo:IAO_0000115>
