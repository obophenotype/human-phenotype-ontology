        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032085"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Elastik lifler için olan bir boya ile tanımlandığı üzere aort mediasının elastik liflerinin paralel olmayan düzenlenmesi/karışıklığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nonparallel arrangement/disarray of elastic fibers of the media of the aorta as identified on a stain for elastic fibers.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032085"/>
