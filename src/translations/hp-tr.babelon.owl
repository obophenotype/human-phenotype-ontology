    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031441">
        <obo:IAO_0000115 xml:lang="tr">Triküspit kapağın annulusunun herhangi bir yapısal anomalisi. Annulus, fibröz ve miyokardiyal dokudan oluşan bir halkadır ve kapak yaprakçıklarının üzerine birleştiği yapıdır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal triküspit kapak anulus morfolojisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031441"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Triküspit kapağın annulusunun herhangi bir yapısal anomalisi. Annulus, fibröz ve miyokardiyal dokudan oluşan bir halkadır ve kapak yaprakçıklarının üzerine birleştiği yapıdır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any structural anomaly of the annulus of the tricuspid valve. The annulus is a ring composed of fibrous and myocardial tissue and is the structure onto which the cusps of the valve attach.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
