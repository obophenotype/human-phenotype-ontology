        <owl:annotatedTarget xml:lang="tr">Malar bölgedeki (yanak kemikleri üzerinde) deriyi etkileyen ve burun köprüsü üzerine uzanan eritematöz (kırmızı), düz yüz kızarıklığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An erythematous (red), flat facial rash that affects the skin in the malar area (over the cheekbones) and extends over the bridge of the nose.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
