        <owl:annotatedTarget xml:lang="tr">Ön kamara hücreleri derece 0.5+</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anterior chamber cells grade 0.5+</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
