    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030776">
        <obo:IAO_0000115 xml:lang="tr">T1-ağırlıklı dizilerde düşük sinyalli ve T2-ağırlıklı dizilerde yüksek sinyalli vertebral son plaktan olan anormal bir manyetik rezonans tomografi sinyali. Modic tip I değişikliklerin kemik iliği ödemini ve inflamasyonunu temsil ettiği düşünülmektedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Modik tip I vertebral son plak değişiklikleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030776"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">T1-ağırlıklı dizilerde düşük sinyalli ve T2-ağırlıklı dizilerde yüksek sinyalli vertebral son plaktan olan anormal bir manyetik rezonans tomografi sinyali. Modic tip I değişikliklerin kemik iliği ödemini ve inflamasyonunu temsil ettiği düşünülmektedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal magnetic resonance tomography signal from a vertebral endplate with a low signal on T1-weighted sequences and high signal on T2-weighted sequences. Modic type I changes are thought to represent bone marrow edema and inflammation.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030776"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
