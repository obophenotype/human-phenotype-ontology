        <owl:annotatedTarget xml:lang="tr">El bileklerinde karpal tünel içinden karşıdan karşıya geçerken tuzaklanma sonucu mediyan sinire olan hasar. Klinik olarak konstriktif medyan nöropatisi elin medyan sinir dağılımında ağrı, parestezi ve zayıflık ile karakterizedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Injury to the median nerve caused by its entrapment at the wrist as it traverses through the carpal tunnel. Clinically, constrictive median neuropathy is characterized by pain, paresthesia, and weakness in the median nerve distribution of the hand.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012185"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Konstriktif mediyan nöropati</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Constrictive median neuropathy</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012186">
        <obo:IAO_0000115 xml:lang="tr">Kübital tünelde (dirsekte) ulnar sinir tuzaklanma nöropatisi yüzük ve küçük parmakta hissizlik ve elin intrinsik kaslarının zayıflığı ile karakterizedir</obo:IAO_0000115>
