        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500086">
        <obo:IAO_0000115 xml:lang="tr">Ortak olarak inferotemporal veya temporal nöroretinal sınır alanları boyunca gözüken disk sınırları içinde arduvaz grisi karakteristik bir pigmentasyon alan görünümüne sahip olan</obo:IAO_0000115>
