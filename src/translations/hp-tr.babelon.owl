        <babelon:source_value>Snoring</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025268">
        <obo:IAO_0000115 xml:lang="tr">Kelime veya kelime kısımlarının istemsiz tekrarları, konuşma sesinin uzaması veya konuşma üretiminin bir kaç saniye için tam blokajı ile olan konuşma sesi üretiminde bozulma</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kekemelik</rdfs:label>
    </rdf:Description>
