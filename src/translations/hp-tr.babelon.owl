        <owl:annotatedTarget xml:lang="tr">İnek, koyun veya keçi sütünde veya süt ürünlerinde kazein, alfa-laktalbümin, beta-laktoglubulin veya büyükbaş serum albümini dahil süt ürünlerine karşı artmış IgE antikor seviyesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased level of IgE antibody against dairy proteins, including casein, alpha-lactalbumin, beta-lactoglobulin or bovine serum albumin contained in cow, sheep or goat milk and milk products.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
