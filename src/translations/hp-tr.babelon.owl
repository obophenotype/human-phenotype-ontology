    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012450">
        <obo:IAO_0000115 xml:lang="tr">Gerilme, topak topak veya sert dışkı ve anorektal tıkanma veya tam olmayan defekasyon hissi, haftada 3 barsak hareketinden az olan, üç aydan uzun konstipasyon</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kronik kabızlık</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012450"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Gerilme, topak topak veya sert dışkı ve anorektal tıkanma veya tam olmayan defekasyon hissi, haftada 3 barsak hareketinden az olan, üç aydan uzun konstipasyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Constipation for longer than three months with fewer than 3 bowel movements per week, straining, lumpy or hard stools, and a sensation of anorectal obstruction or incomplete defecation.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
