    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000758">
        <obo:IAO_0000115 xml:lang="tr">Örneğin göz göze bakış, yüz ifadesi, vücut postürü ve işareti gibi iletişim için sözlü olmayan davranışların kullanımında azalmış kabiliyet</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sözlü olmayan davranışların bozulmuş kullanımı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000758"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Örneğin göz göze bakış, yüz ifadesi, vücut postürü ve işareti gibi iletişim için sözlü olmayan davranışların kullanımında azalmış kabiliyet</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormalities in eye contact, communicative facial expressions, gesture use, or the use of others&apos; bodies to communicate convey shared meanings within a culture that replace or supplement verbal communication.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
