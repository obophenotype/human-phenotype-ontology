    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001963">
        <obo:IAO_0000115 xml:lang="tr">Konuşmayı duymaktan ziyade, konuşmayı anlamada güçlük çeken işitme bozukluğu türü. Zayıf konuşma ayrımsaması, yüksek frekanslı işitme kaybının çok yaygın bir semptomudur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal konuşma ayırt ediciliği</rdfs:label>
    </rdf:Description>
