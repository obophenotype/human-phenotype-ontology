        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of megakaryocytes in the bone marrow whose nuclei are less lobulated than expected for the size of the nucleus.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
