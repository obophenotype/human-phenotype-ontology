        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002661">
        <obo:IAO_0000115 xml:lang="tr">Ağrısız meydana gelen kırıklar ile, travmayı takiben kırıklara olan artmış bir eğilim</obo:IAO_0000115>
