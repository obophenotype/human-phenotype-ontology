    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030671">
        <obo:IAO_0000115 xml:lang="tr">Orbita apeksinde giriş yerinde optik siniri çevreleyen fibröz doku halkasının herhangi bir anomalisi. Zinn anulusu veya anular tendon olarak da bilinen, ortak tendon benzeri halka yedi ekstraoküler kasın beşinin kökenidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal ortak tendon halka morfolojisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
