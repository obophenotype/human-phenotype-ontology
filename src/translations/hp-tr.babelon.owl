        <owl:annotatedTarget xml:lang="tr">Steatore</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Steatorrhea</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002571">
        <obo:IAO_0000115 xml:lang="tr">Özofagus vücudunun alt yarısında alt özofagus sfinkterinin yutma esnasında ve yetersiz ya da eksik peristaltikler tarafından rahatlamaması ile karakterize özofagus motilitesi bozukluğu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Akalazya</rdfs:label>
