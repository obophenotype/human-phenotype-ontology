        <owl:annotatedTarget xml:lang="tr">Burun kanatları arasındaki mesafenin yaşa göre ortalamadan iki standart sapma veya daha fazla olması, artmış belirgin burun tabanı ve burun kanadı genişliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
