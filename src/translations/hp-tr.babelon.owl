        <babelon:source_value>Tendon xanthomatosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010875">
        <obo:IAO_0000115 xml:lang="tr">Ayağın lateral malleolus yüzeyinde cildin uyarılmasıyla ortaya çıkan bir teşhis refleksi. Chaddock refleksi, dış inframalleoler cilt uyarılınca ayak parmaklarının bir veya daha fazlasının veya tümünün havalandırılması ya da havalandırılmaması durumunda ortaya çıkar. Babinski işaretine benzeyen Chaddock işareti, spinokortikal (piramidal) yolun hastalık belirtisi olarak kabul edilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Chaddock refleksi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010875"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ayağın lateral malleolus yüzeyinde cildin uyarılmasıyla ortaya çıkan bir teşhis refleksi. Chaddock refleksi, dış inframalleoler cilt uyarılınca ayak parmaklarının bir veya daha fazlasının veya tümünün havalandırılması ya da havalandırılmaması durumunda ortaya çıkar. Babinski işaretine benzeyen Chaddock işareti, spinokortikal (piramidal) yolun hastalık belirtisi olarak kabul edilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A diagnostic reflex elicited by stimulation of the skin over the surface of the lateral malleolus of the foot. The Chaddock refelx is present if there is extension of one or more or all of the toes with or without fanning of them when the external inframalleolar skin is stimulated. The Chaddock sign, similar to the Babinski sign, is taken to be an indication of disease of the spinocortical (pyramidal) tract.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010875"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Chaddock refleksi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chaddock reflex</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010876">
        <obo:IAO_0000115 xml:lang="tr">Kanda dolaşan bir proteinin anormal seviyesi</obo:IAO_0000115>
