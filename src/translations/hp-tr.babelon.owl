    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031881">
        <obo:IAO_0000115 xml:lang="tr">Nazolakrimal sistemin tıkanıklığı ile ilişkili bir sulu göz formu. Bu punktum, kanalikuli, kese veya nazolakrimal kanal seviyesinde kaynaklanabillir</obo:IAO_0000115>
