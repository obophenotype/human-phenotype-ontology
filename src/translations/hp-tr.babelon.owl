    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001629">
        <obo:IAO_0000115 xml:lang="tr">Kalbin iki alt odacığı (ventrikülleri) arasında bir delik. Defekt ventriküler septumun superioru civarında konumlanır</obo:IAO_0000115>
