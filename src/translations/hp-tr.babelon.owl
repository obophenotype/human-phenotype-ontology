    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011931">
        <obo:IAO_0000115 xml:lang="tr">Beyin sapçıkları anormalliği. Üst, orta ve inferior beyin sapçıkları beyincikten çıkmaktadır. Üst beyin sapçıkları beyincikle birleşir, beyincik ortabeyinle, orta beyin sapçıkları beyincikle, beyincik ponslarla ve inferiyor beyin sapçıkları omurilik ile birleşir, soğanilik de beyincik ile birleşir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Serebellar pedünkül anormalliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011931"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Beyin sapçıkları anormalliği. Üst, orta ve inferior beyin sapçıkları beyincikten çıkmaktadır. Üst beyin sapçıkları beyincikle birleşir, beyincik ortabeyinle, orta beyin sapçıkları beyincikle, beyincik ponslarla ve inferiyor beyin sapçıkları omurilik ile birleşir, soğanilik de beyincik ile birleşir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly of the cerebellar peduncles. The superior, middle, and inferior cerebellar peduncles emerge from the cerebellum. The superior cerebellar penduncles connect the cerebellum to the midbrain, the middle cerebellar peduncles connect the cerebellum to the pons, and the inferior cerebellar peduncle connects the medulla spinalis and medulla oblongata with the cerebellum.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011931"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Serebellar pedünkül anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal cerebellar peduncle morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011932">
        <obo:IAO_0000115 xml:lang="tr">Süperior serebellar pedünkülün bir anomalisi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Süperior serebellar pedünkülün anormalliği</rdfs:label>
    </rdf:Description>
