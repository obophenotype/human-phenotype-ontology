    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001133">
        <obo:IAO_0000115 xml:lang="tr">Görsel alanın kenarından (perifer) konsantrik bir paternde uzanan retinal duyarlılıkta mutlak veya göreceli bir azalma. Görsel alan sabitlenmiş bir göz tarafından eş zamanlı olarak algılanan alandır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Çevresel görme alanı konstriksiyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001133"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Görsel alanın kenarından (perifer) konsantrik bir paternde uzanan retinal duyarlılıkta mutlak veya göreceli bir azalma. Görsel alan sabitlenmiş bir göz tarafından eş zamanlı olarak algılanan alandır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An absolute or relative decrease in retinal sensitivity extending from edge (periphery) of the visual field in a concentric pattern. The visual field is the area that is perceived simultaneously by a fixating eye.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001133"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Çevresel görme alanı konstriksiyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Constriction of peripheral visual field</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001134">
