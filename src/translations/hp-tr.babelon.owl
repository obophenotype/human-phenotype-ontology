    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030376">
        <obo:IAO_0000115 xml:lang="tr">Olgunlaşmamış B hücrelerinin senkresyonundaki sayımın normalden saması. (CD19+/ CD21low). Olgunlaşmamış B hücreleri (IgM+), hala kemik iliği içerisindeki gelişmesinin son aşamasındadır. Henüz gelişmemiş B hücreleri, spesifik oldukları (IgM+/IgD+) antijenine bağlanmadan önce kemik iliğinden ayrılan hücrelerdir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal immatür B hücresi sayımı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030376"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Olgunlaşmamış B hücrelerinin senkresyonundaki sayımın normalden saması. (CD19+/ CD21low). Olgunlaşmamış B hücreleri (IgM+), hala kemik iliği içerisindeki gelişmesinin son aşamasındadır. Henüz gelişmemiş B hücreleri, spesifik oldukları (IgM+/IgD+) antijenine bağlanmadan önce kemik iliğinden ayrılan hücrelerdir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deviation from normal proportion of immature B cells (CD19+/ CD21low) in circulation relative to total number of B cells. Immature B cells (IgM+) are still in final stages of development within the bone marrow. Naive B cells are those which have left the bone marrow, before they bind to the antigen for which they&apos;re specific (IgM+/IgD+).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
