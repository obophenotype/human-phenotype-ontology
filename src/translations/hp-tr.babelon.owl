        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000582">
        <obo:IAO_0000115 xml:lang="tr">Palpebral fissür eğimi yaşa göre ortalamanın iki standart sapmadan daha fazla olması (nesnel); veya palpebral fissür eğiminin yaş için tipik olandan fazla olması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yukarı dönük palpebral fissürler</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000582"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Palpebral fissür eğimi yaşa göre ortalamanın iki standart sapmadan daha fazla olması (nesnel); veya palpebral fissür eğiminin yaş için tipik olandan fazla olması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The palpebral fissure inclination is more than two standard deviations above the mean for age (objective); or, the inclination of the palpebral fissure is greater than typical for age.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
