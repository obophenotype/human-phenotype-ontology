    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012054">
        <obo:IAO_0000115 xml:lang="tr">Koroid melanositlerinin kötü huylu tümörü. Koroidal melanomun klasik görünüşü eksüdatif retina dekolmanı ile pigmente edilmiş kubbe şeklinde veya yaka düğmesi şeklinde bir tümördür. Koroid melanoma genellikle pigmentlidir fakat değişken pigmentli hatta amelantonik (pigmentsiz) de olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Koroidal melanom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012054"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Koroid melanositlerinin kötü huylu tümörü. Koroidal melanomun klasik görünüşü eksüdatif retina dekolmanı ile pigmente edilmiş kubbe şeklinde veya yaka düğmesi şeklinde bir tümördür. Koroid melanoma genellikle pigmentlidir fakat değişken pigmentli hatta amelantonik (pigmentsiz) de olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Malignant tumor of melanocytes of the choroid. The classic appearance of choroidal melanoma is a pigmented dome-shaped or collar button-shaped tumor with an associated exudative retinal detachment. Choroidal melanoma is usually pigmented, but can be variably pigmented and even amelanotic (non-pigmented).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012054"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Koroidal melanom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Choroidal melanoma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012055">
