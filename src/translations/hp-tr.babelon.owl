        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Fazla parmağın veya parmakların el veya ayak baş parmağı tarafında yer aldığı bir polidaktili formu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
