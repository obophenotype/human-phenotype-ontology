        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Aşırı sıcak ve nemli hava gibi uygun bir uyaran olmamasına rağmen anormal aşırı terleme (perspirasyon)</owl:annotatedTarget>
