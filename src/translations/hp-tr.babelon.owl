    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001831">
        <obo:IAO_0000115 xml:lang="tr">Ayakla karşılaştırıldığında orantısız şekilde kısa olan bir ayak parmağı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kısa ayak parmağı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001831"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ayakla karşılaştırıldığında orantısız şekilde kısa olan bir ayak parmağı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A toe that appears disproportionately short compared to the foot.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
