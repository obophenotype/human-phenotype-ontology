    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011621">
        <obo:IAO_0000115 xml:lang="tr">Sol ventrikül ve sağ atriyum arasında direk olarak bağlantılı bir tip ventriküler septal defekt. Bu anatomik olarak mümkündür çünkü normal triküspid kapak mitral kapaktan daha apikale yerleşmiştir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Gerbode ventriküler septal defekt</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011621"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sol ventrikül ve sağ atriyum arasında direk olarak bağlantılı bir tip ventriküler septal defekt. Bu anatomik olarak mümkündür çünkü normal triküspid kapak mitral kapaktan daha apikale yerleşmiştir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of ventricular septal defect communicating directly between the left ventricle and right atrium. This is anatomically possible because the normal tricuspid valve is more apically displaced than the mitral valve.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011621"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Gerbode ventriküler septal defekt</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Gerbode ventricular septal defect</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011622">
        <obo:IAO_0000115 xml:lang="tr">Sağ ventriküler septum girişinin AV kapak aparatının hemen inferiorunda olduğu bir ventriküler septal defekt</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İnlet ventriküler septal defekt</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011622"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sağ ventriküler septum girişinin AV kapak aparatının hemen inferiorunda olduğu bir ventriküler septal defekt</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A ventricular septal defect that involves the inlet of the right ventricular septum immediately inferior to the AV valve apparatus.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011622"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">İnlet ventriküler septal defekt</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inlet ventricular septal defect</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011623">
        <obo:IAO_0000115 xml:lang="tr">Trabeküler septum interventriküler septumun en büyük kısmıdır. Membranöz septumdan apsise ve infundibular septumun üst kısmına kadar uzanır. Eğer kusur kas tarafından tamamen çerçevelenirse, trabeküler septuma ait bir kusura müsküler VSD denir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Musküler ventriküler septal defekt</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011623"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Trabeküler septum interventriküler septumun en büyük kısmıdır. Membranöz septumdan apsise ve infundibular septumun üst kısmına kadar uzanır. Eğer kusur kas tarafından tamamen çerçevelenirse, trabeküler septuma ait bir kusura müsküler VSD denir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The trabecular septum is the largest part of the interventricular septum. It extends from the membranous septum to the apex and superiorly to the infundibular septum. A defect in the trabecular septum is called muscular VSD if the defect is completely rimmed by muscle.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011623"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Musküler ventriküler septal defekt</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Muscular ventricular septal defect</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011624">
        <obo:IAO_0000115 xml:lang="tr">Kalbin apeksinde yer alan müsküler bir ventriküler septal defekt</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Apikal musküler ventriküler septal defekt</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011624"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kalbin apeksinde yer alan müsküler bir ventriküler septal defekt</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A muscular ventricular septal defect located at the apex of the heart.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011624"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Apikal musküler ventriküler septal defekt</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Apical muscular ventricular septal defect</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011625">
        <obo:IAO_0000115 xml:lang="tr">Ventriküler septumda çoklu küçük defektlerin varlığı ile karakterize bir tip müsküler ventriküler septal defekt</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Çoklu musküler ventriküler septal defektler</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011625"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ventriküler septumda çoklu küçük defektlerin varlığı ile karakterize bir tip müsküler ventriküler septal defekt</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of muscular ventricular septal defect characterized by the presence of multiple small defects in the ventricular septum.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011625"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Çoklu musküler ventriküler septal defektler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Multiple muscular ventricular septal defects</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011626">
