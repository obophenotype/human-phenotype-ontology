    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012646">
        <obo:IAO_0000115 xml:lang="tr">Üst skrotumda veya alt inguinal kanalda yer alan ve elle indirmeye direnç olmadan skrotum içine tamamen indirilebilen fakat kremasterik refleks ile orjinal pozisyonuna geri dönen bir testis</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Retraktil testis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012646"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Üst skrotumda veya alt inguinal kanalda yer alan ve elle indirmeye direnç olmadan skrotum içine tamamen indirilebilen fakat kremasterik refleks ile orjinal pozisyonuna geri dönen bir testis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A testis that is located at the upper scrotum or lower inguinal canal and that can be made to descend completely into the scrotum without resistance by manual reduction but returns to its original position by the cremasteric reflex.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
