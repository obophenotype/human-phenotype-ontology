        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025167">
        <obo:IAO_0000115 xml:lang="tr">Dermisteki elastik lifler elastik liflerin organize olmamış yapısı ile ilişkili artmış kırıklar sergiler</obo:IAO_0000115>
