    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000190">
        <obo:IAO_0000115 xml:lang="tr">Dil frenulumunun anormalliği, dili ağız tabanına tutturan küçük müköz membran katlantı, veya ağız boşluğunda aksesuar frenula varlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Oral frenulum anormalliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000190"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Dil frenulumunun anormalliği, dili ağız tabanına tutturan küçük müköz membran katlantı, veya ağız boşluğunda aksesuar frenula varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the lingual frenulum, that is of the small fold of mucous membrane that attaches the tongue to the floor of the mouth, or the presence of accessory frenula in the oral cavity.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
