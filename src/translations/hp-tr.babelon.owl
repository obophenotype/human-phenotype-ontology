        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Upper eyelid entropion</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025608">
        <obo:IAO_0000115 xml:lang="tr">Skarlaşma ile ilişkili ön veya orta lamellanın kısalmasından veya kontraksiyonundan kaynaklanan göz kapağı kenarının (ektropiyon) dışarıya dönmesi (eversiyon) veya rotasyonu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sikatrisyel ektropiyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025608"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Skarlaşma ile ilişkili ön veya orta lamellanın kısalmasından veya kontraksiyonundan kaynaklanan göz kapağı kenarının (ektropiyon) dışarıya dönmesi (eversiyon) veya rotasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An outward turning (eversion) or rotation of the eyelid margin (i.e., ectropion) caused by shortening or contraction of the anterior or middle lamellae related to scarring.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025608"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Sikatrisyel ektropiyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cicatricial ectropion</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025609">
        <obo:IAO_0000115 xml:lang="tr">Göz kapağı derisini, kirpik tabanını ve kirpik folikülünü etkileyen bir blefarit tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anterior blefarit</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025609"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Göz kapağı derisini, kirpik tabanını ve kirpik folikülünü etkileyen bir blefarit tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of blepharitis that affects the eyelid skin, base of the eyelashes, and the eyelash follicles.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
