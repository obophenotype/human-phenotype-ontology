        <obo:IAO_0000115 xml:lang="tr">Yumuşak dokudan köken alan bir tümör (anormal doku büyümesi). En sık tipleri lipomatöz (yağlı), vasküler, düz kas, fibröz ve fibrohistiyositik neoplazmlardır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yumuşak doku neoplazmı</rdfs:label>
    </rdf:Description>
