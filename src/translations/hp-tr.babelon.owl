        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030454"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Klinik elektro-okülogram (EOG) takip eden karanlık ve aydınlık adaptasyon periyodu esnasında RPE içinden elektrik potansiyelinde değişimlerin kaydedildiği dış retina ve retinal pigment epitelyumun (RPE) elektrofizyolojik fonksiyon testidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The clinical electro-oculogram (EOG) is an electrophysiological test of function of the outer retina and retinal pigment epithelium (RPE) in which changes in electrical potential across the RPE are recorded during successive periods of dark and light adaptation.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
