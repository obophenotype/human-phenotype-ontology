    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003554"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Primer tip 2 kas liflerini etkileyen atrofi (kayıp). Bu özellik genelde kas biyopsisinde gözlemlenebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
