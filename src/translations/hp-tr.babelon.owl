    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031622">
        <obo:IAO_0000115 xml:lang="tr">Etkilenmiş gözün(lerin) adduksiyonda yukarı bakmadığı fakat adduksiyonda tam depresyona sahip olduğu oküler motilite defekti. Süperior oblik tendon veya troklea defektinden veya zedelenmesinden doğumsal veya edinilmiş olabilir ve pozitif zorlu duksiyon test sonucuna sahip olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Brown anomalisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031622"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Etkilenmiş gözün(lerin) adduksiyonda yukarı bakmadığı fakat adduksiyonda tam depresyona sahip olduğu oküler motilite defekti. Süperior oblik tendon veya troklea defektinden veya zedelenmesinden doğumsal veya edinilmiş olabilir ve pozitif zorlu duksiyon test sonucuna sahip olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An ocular motility defect where the affected eye(s) does not elevate in adduction but has full depression in adduction. It can be congenital or acquired from injury to or defect of the superior oblique tendon or trochlea and has a positive forced duction test result.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
