    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001929">
        <obo:IAO_0000115 xml:lang="tr">Pıhtılaşma faktörü XI&apos;in azalmış aktivitesi. Plazma tromboplastin öncülü olarak da bilinen faktör XI, faktör IX&apos;u aktive eden bir serin proteinazdır</obo:IAO_0000115>
