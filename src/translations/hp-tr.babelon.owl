        <obo:IAO_0000115 xml:lang="tr">Hareketli siliyanın 9+2 mikrotübüler konfigürasyonlu iki merkezi mikrotübülünün yokluğu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Respiratuar motil siliyanın olmayan santral mikrotübüler çift morfolojisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
