    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025546">
        <obo:IAO_0000115 xml:lang="tr">Kırmızı kan hücresi başına ortalama hemoglobin miktarının normal aralığındaki bir azalma (27 ila 31 pikogram/hücre). Ortalama bir parçacıklı hemoglobin (MCH) hipokromik anemiyi gösterebilir, ancak toplam hemoglobin ve alyuvar sayımı azaltılırsa MCH normal olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal ortalama korpüsküler hemoglobin</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025546"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kırmızı kan hücresi başına ortalama hemoglobin miktarının normal aralığındaki bir azalma (27 ila 31 pikogram/hücre). Ortalama bir parçacıklı hemoglobin (MCH) hipokromik anemiyi gösterebilir, ancak toplam hemoglobin ve alyuvar sayımı azaltılırsa MCH normal olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deviation from the normal range of the average amount of hemoglobin per red blood cell (27 to 31 picograms/cell). A reduced mean corpuscular hemoglobin (MCH) may indicate a hypochromic anemia, but the MCH may be normal if both the total hemoglobin and the red blood cell count are reduced.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025546"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal ortalama korpüsküler hemoglobin</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal mean corpuscular hemoglobin concentration</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025547">
        <obo:IAO_0000115 xml:lang="tr">Kırmızı kan hücresi başına ortalama hemoglobin miktarının normal aralığındaki bir azalma (27 ila 31 pikogram/hücre). Ortalama bir parçacıklı hemoglobin (MCH) hipokromik anemiyi gösterebilir, ancak toplam hemoglobin ve alyuvar sayımı azaltılırsa MCH normal olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Azalmış ortalama korpüsküler hemoglobin</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025547"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kırmızı kan hücresi başına ortalama hemoglobin miktarının normal aralığındaki bir azalma (27 ila 31 pikogram/hücre). Ortalama bir parçacıklı hemoglobin (MCH) hipokromik anemiyi gösterebilir, ancak toplam hemoglobin ve alyuvar sayımı azaltılırsa MCH normal olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduction from the normal range of the average amount of hemoglobin per red blood cell (27 to 31 picograms/cell). A reduced mean corpuscular hemoglobin (MCH) may indicate a hypochromic anemia, but the MCH may be normal if both the total hemoglobin and the red blood cell count are reduced.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025547"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Azalmış ortalama korpüsküler hemoglobin</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased mean corpuscular hemoglobin concentration</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025548">
        <obo:IAO_0000115 xml:lang="tr">Kırmızı kan hücresi başına ortalama hemoglobin konsantrasyonu normal aralığı (27-31 pikogram/hücre) üzerine bir yükselme</obo:IAO_0000115>
