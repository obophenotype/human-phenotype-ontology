        <owl:annotatedTarget xml:lang="tr">Dayanılmaz uyku atakları ile aşırı gün içi uykusuzluk, katapleksi (ani bilateral kas tonusu kaybı), hipnagogik halüsinasyon ve uyku paralizi klasik tetradı ile karakterize anormal bir fenomen</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal phenomenon characterized by a classic tetrad of excessive daytime sleepiness with irresistible sleep attacks, cataplexy (sudden bilateral loss of muscle tone), hypnagogic hallucination, and sleep paralysis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
