    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031726">
        <obo:IAO_0000115 xml:lang="tr">Göz küresinin üst kutuplarının birbirine içe doğru (mediyal olarak) döndüğü bir siklotropi tipi (gözlerin görsel aksı etrafında bir veya her iki gözün torsiyonu)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İnsiklotropi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031726"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Göz küresinin üst kutuplarının birbirine içe doğru (mediyal olarak) döndüğü bir siklotropi tipi (gözlerin görsel aksı etrafında bir veya her iki gözün torsiyonu)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of cyclotropia (torsion of one or both eye around the visual axis of the eyes) in which the upper poles of the globes are rotated inward (medially) to each other.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
