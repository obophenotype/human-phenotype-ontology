        <babelon:source_value>Lichenoid skin lesion</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031453">
        <obo:IAO_0000115 xml:lang="tr">Liken planus hastalığı karakteristiğini andıran oral mukozanın çoklu deri lezyonları. Bunlar beyaz, dantel benzeri ağı andıran simetrik, retiküler lezyonlar olduğu gibi papül, plak, eritamatöz lezyonlar ve erozyonlardır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Oral liken benzeri lezyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031453"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Liken planus hastalığı karakteristiğini andıran oral mukozanın çoklu deri lezyonları. Bunlar beyaz, dantel benzeri ağı andıran simetrik, retiküler lezyonlar olduğu gibi papül, plak, eritamatöz lezyonlar ve erozyonlardır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Multiple lesions of the oral mucosa resembling those characteristic of the disease lichen planus. These are symmetric reticular lesions that resemble a white, lacelike network, as well as by papules, plaques, erythematous lesions, and erosions.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
