        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001212">
        <obo:IAO_0000115 xml:lang="tr">&quot;Parmak uçlarının ventral taraflarında yumuşak doku belirginliği. &quot;&quot;Kalıcı fetal parmak ucu yastıkçıkları&quot;&quot; sıklıkla eş anlamlı kullanılmaktadır, fakat genellikle var olmayan hasta hikayesi bilgisine işaret ettiğinden kullanılmaması tercih edilir&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Parmak ucu yastıkçığı belirginliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001212"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">&quot;Parmak uçlarının ventral taraflarında yumuşak doku belirginliği. &quot;&quot;Kalıcı fetal parmak ucu yastıkçıkları&quot;&quot; sıklıkla eş anlamlı kullanılmaktadır, fakat genellikle var olmayan hasta hikayesi bilgisine işaret ettiğinden kullanılmaması tercih edilir&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>&quot;A soft tissue prominence of the ventral aspects of the fingertips. The term &quot;&quot;persistent fetal fingertip pads&quot;&quot; is often used as a synonym, but should better not be used because it implies knowledge of history of the patient which often does not exist.&quot;</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001212"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Parmak ucu yastıkçığı belirginliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Prominent fingertip pads</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001215">
        <obo:IAO_0000115 xml:lang="tr">İkinciden beşinci parmakların distal ve/veya proksimal interfalangeyal eklemleri aktif veya pasif ekstensiyon ile 180 dereceye kadar esnetilemez</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">2.-5. parmakların kamptodaktilisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001215"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İkinciden beşinci parmakların distal ve/veya proksimal interfalangeyal eklemleri aktif veya pasif ekstensiyon ile 180 dereceye kadar esnetilemez</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The distal interphalangeal joint and/or the proximal interphalangeal joint of the second to fifth fingers cannot be extended to 180 degrees by either active or passive extension.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
