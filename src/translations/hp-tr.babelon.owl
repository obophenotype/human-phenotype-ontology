        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007642">
        <obo:IAO_0000115 xml:lang="tr">Doğumsal başlangıcı olan gece körlüğü ile ilerleyici olmayan (yani değişmeyen) zorluk biçimi</obo:IAO_0000115>
