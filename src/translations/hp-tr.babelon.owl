    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007670">
        <obo:IAO_0000115 xml:lang="tr">Vestibulo-oküler refleks (VOR) anormallik. Vor görüntüyü retinada sabit tutmaya çalışır. İdeal olarak, pasif veya aktif baş hareketleri bir yönde eşit büyüklükte göz hareketleri tarafından telafi edilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal vestibülo-oküler refleks</rdfs:label>
    </rdf:Description>
