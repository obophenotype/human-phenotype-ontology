    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011787">
        <obo:IAO_0000115 xml:lang="tr">Başka türlü normal olan tiroid bezinin yetersiz uyarılma nedeniyle olan bir hipotiroidi tipi. Santral hipotiroidizm ya pitüiter (ikincil hipotiroidizm) ya da hipotalamik (tersiyer hipotiroidizm) kusurlar tarafından oluşmaktadır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Santral hipotiroidizm</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
