        <owl:annotatedTarget xml:lang="tr">Epibulbar dermoid tipik olarak kornea ve sklera (limbal epibullar dermoid) bileşkesinde bulunan selim bir tümördür</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A benign tumor typically found at the junction of the cornea and sclera (limbal epibullar dermoid).</babelon:source_value>
