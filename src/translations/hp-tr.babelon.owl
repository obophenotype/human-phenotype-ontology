    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001061">
        <obo:IAO_0000115 xml:lang="tr">Açık komedonlar (siyah nokta), kapalı komedonlar (beyaz noktalar) ve püstüler nodüller (papüller, püstüller ve kistler) ile ilişkili pilosebaseöz aparat tarafından sebum üretiminde artışın olduğu bir deri durumu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Akne</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001061"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Açık komedonlar (siyah nokta), kapalı komedonlar (beyaz noktalar) ve püstüler nodüller (papüller, püstüller ve kistler) ile ilişkili pilosebaseöz aparat tarafından sebum üretiminde artışın olduğu bir deri durumu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A skin condition in which there is an increase in sebum secretion by the pilosebaceous apparatus associated with open comedones (blackheads), closed comedones (whiteheads), and pustular nodules (papules, pustules, and cysts).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001061"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Akne</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Acne</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001062">
        <obo:IAO_0000115 xml:lang="tr">5-15 mm çap arasında ölçülen, düzensiz, çentikli, sınırları belirsiz ve ten renginden koyu kahverengiye ya da pembeye değişen renkte olan geniş pigmente bir lezyon</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Atipik nevüs</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001062"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">5-15 mm çap arasında ölçülen, düzensiz, çentikli, sınırları belirsiz ve ten renginden koyu kahverengiye ya da pembeye değişen renkte olan geniş pigmente bir lezyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A large pigmented lesion measuring 5-15 mm in diameter with irregular, notched, and ill defined border and with color that may range from tan to dark brown to pink.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
