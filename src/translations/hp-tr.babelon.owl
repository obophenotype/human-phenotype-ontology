    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001141">
        <obo:IAO_0000115 xml:lang="tr">Görme keskinliğinin 6/60&apos;dan az (20/200 ABD&apos;deki sistem; 0.1 ondalık sistem) fakat en az 3/60 (20/400 ABD&apos;deki sistem; 0.05 ondalık sistem) olması şeklinde tanımlanan görme kabiliyetinin ciddi azalması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ciddi görme bozukluğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001141"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Görme keskinliğinin 6/60&apos;dan az (20/200 ABD&apos;deki sistem; 0.1 ondalık sistem) fakat en az 3/60 (20/400 ABD&apos;deki sistem; 0.05 ondalık sistem) olması şeklinde tanımlanan görme kabiliyetinin ciddi azalması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Severe reduction of the ability to see. On the 6m visual acuity scale, severe reduction is defined as less than 6/60 but at least 3/60. On the 20ft visual acuity scale, severe reduction is defined as less than 20/200 but at least 20/400. On the decimal visual acuity scale, severe reduction is defined as less than 0.1 but at least 0.05.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001141"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ciddi görme bozukluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Severely reduced visual acuity</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001142">
        <obo:IAO_0000115 xml:lang="tr">Gelişimsel bir anomali olarak meydana gelen lensin ön veya arka yüzeyinin konikal uzantısı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Lentikonus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001142"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Gelişimsel bir anomali olarak meydana gelen lensin ön veya arka yüzeyinin konikal uzantısı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A conical projection of the anterior or posterior surface of the lens, occurring as a developmental anomaly.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001142"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
