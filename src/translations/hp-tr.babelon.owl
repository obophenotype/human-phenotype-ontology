    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012097">
        <obo:IAO_0000115 xml:lang="tr">Nöral tüp kapanışında (embriyogenezin 3. ve 5. haftasında) ektodermayla işlenen hücrelerin dahil edilmesinden doğan konjenital inklüzyon kistleri. Dermoid kist kapsülleri, kollaj tarafından desteklenen basit epitelden oluşur. Daha kalın kısımlarda, astar, saç follikülleri, sebase bezler ve apokrin bezleri içeren dermişle desteklenir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İntrakraniyal dermoid kist</rdfs:label>
    </rdf:Description>
