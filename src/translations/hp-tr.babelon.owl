    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010864">
        <obo:IAO_0000115 xml:lang="tr">Ciddi mental retardasyon, 20-34 aralığında bir zeka bölümü (IQ) olarak tanımlanır</obo:IAO_0000115>
