        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025401">
        <obo:IAO_0000115 xml:lang="tr">Gözlerin kalıcı olarak açık kaldığı bir anormallik</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sabit bakış</rdfs:label>
