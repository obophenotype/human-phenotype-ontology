    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002833">
        <obo:IAO_0000115 xml:lang="tr">İskelet bölgesinde yayılmış multifokal hemanjiyomatöz veya lenfanjiomatöz lezyonlar. Lezyonlar, litik, iyi tanımlanmış, medüller boşluk içerisinde oval veya yuvarlak lezyonlardır ve bozulmamış korteksleri vardır, değişken periferik skleroz gösterirler ayrıca endostal scalloping gösterebilirler</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kemiğin kistik anjiyomatozu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002833"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İskelet bölgesinde yayılmış multifokal hemanjiyomatöz veya lenfanjiomatöz lezyonlar. Lezyonlar, litik, iyi tanımlanmış, medüller boşluk içerisinde oval veya yuvarlak lezyonlardır ve bozulmamış korteksleri vardır, değişken periferik skleroz gösterirler ayrıca endostal scalloping gösterebilirler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Disseminated multifocal hemangiomatous or lymphangiomatous lesions of the skeleton. The lesions are lytic, well-defined, round or oval lesions within the medullary cavity, and they have an intact cortex, and manifest variable peripheral sclerosis and may exhibit endosteal scalloping.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002833"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kemiğin kistik anjiyomatozu</owl:annotatedTarget>
