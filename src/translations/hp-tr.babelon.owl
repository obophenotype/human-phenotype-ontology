        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Motor birim potansiyelinde (MBP) tutarsız, an ve an değişen, istikrarsız veya olmayan nöromüsküler aktarım ile ilişkili bir elektromyografik bulgu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An electromyographic finding associated with erratic or absent neuromuscular transmission with erratic, moment-to-moment changes in the shape of the motor unit potential (MUP).</babelon:source_value>
