    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011576">
        <obo:IAO_0000115 xml:lang="tr">Primum atriyal septal defekt, yarık ön mitral kapak yaprakçığı ve inlet ventriküler septal defekt ile olan kalp defektlerinin özel bir kombinasyonu. Bir kapak anulusu ve iki kapak açıklığı vardir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Orta düzeyde atriyoventriküler kanal defekti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011576"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Primum atriyal septal defekt, yarık ön mitral kapak yaprakçığı ve inlet ventriküler septal defekt ile olan kalp defektlerinin özel bir kombinasyonu. Bir kapak anulusu ve iki kapak açıklığı vardir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A specific combination of heart defects with a primum atrial septal defect, cleft anterior mitral valve leaflet, and inlet ventricular defect. There is one valve annulus and two valve orifices.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011576"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
