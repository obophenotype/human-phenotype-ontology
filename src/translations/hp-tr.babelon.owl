    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010717">
        <obo:IAO_0000115 xml:lang="tr">&quot;Yumuşak kısımları ve ayak parmaklarının bireysel kemiklerinin füzyonu dahil olmak üzere, ayak parmaklarının ağ ile çevrilmesi veya füzyonu. Kemik füzyonları füzyonun tibial-fibular bir eksende gerçekleşmesi halinde &quot;&quot;kemikli&quot;&quot; Sindaktili olarak sayılır. Ayak parmaklarının kemiklerinin proksim-distal bir eksende füzyonuna &quot;&quot;Senfalanjizm&quot;&quot; denir&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ayak parmaklarının kemik sindaktilisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010717"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">&quot;Yumuşak kısımları ve ayak parmaklarının bireysel kemiklerinin füzyonu dahil olmak üzere, ayak parmaklarının ağ ile çevrilmesi veya füzyonu. Kemik füzyonları füzyonun tibial-fibular bir eksende gerçekleşmesi halinde &quot;&quot;kemikli&quot;&quot; Sindaktili olarak sayılır. Ayak parmaklarının kemiklerinin proksim-distal bir eksende füzyonuna &quot;&quot;Senfalanjizm&quot;&quot; denir&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>&quot;Webbing or fusion of the toes, involving soft parts and including fusion of individual bones of the toes. Bony fusions are referred to as &quot;&quot;bony&quot;&quot; Syndactyly if the fusion occurs in a tibial-fibular axis. Fusions of bones of the toes in a proximo-distal axis are referred to as &quot;&quot;Symphalangism&quot;&quot;.&quot;</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010717"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ayak parmaklarının kemik sindaktilisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Osseous syndactyly of toes</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
