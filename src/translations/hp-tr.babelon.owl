        <owl:annotatedTarget xml:lang="tr">Servikal kord basısı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cervical cord compression</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002342">
        <obo:IAO_0000115 xml:lang="tr">Orta derecede mental retardasyon, 35-49 aralığında bir zeka bölümü (IQ) olarak tanımlanır</obo:IAO_0000115>
