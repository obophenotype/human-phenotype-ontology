        <rdfs:label xml:lang="tr">Büyük sakrosiyatik çentik anormalliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010456"/>
