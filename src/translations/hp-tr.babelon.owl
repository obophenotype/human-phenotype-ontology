    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030103">
        <obo:IAO_0000115 xml:lang="tr">Kastaki beta sarkoglisin miktarının anormal deviasyonu. Alfa, beta, gama ve delta sarkoglikanları distrofin kompleksinin bileşenleridir. Bunların hepsi, korunmuş sisteinlerden oluşan büyük bir hücre dışı, hücre içi alanı ve tek bir zar geçiş bölgesi ile N-glikosile edilmiş transmembran proteinleridir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal kas lifi beta sarkoglikanı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030103"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kastaki beta sarkoglisin miktarının anormal deviasyonu. Alfa, beta, gama ve delta sarkoglikanları distrofin kompleksinin bileşenleridir. Bunların hepsi, korunmuş sisteinlerden oluşan büyük bir hücre dışı, hücre içi alanı ve tek bir zar geçiş bölgesi ile N-glikosile edilmiş transmembran proteinleridir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Deviation from normal in the amount of beta sarcoglycan in muscle. The alpha, beta, gamma, and delta sarcoglycans are components of the dystrophin-complex. They are all N-glycosylated transmembrane proteins with a short intra-cellular domain, a single transmembrane region and a large extra-cellular domain containing a cluster of conserved cysteines.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030103"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal kas lifi beta sarkoglikanı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal muscle fiber beta sarcoglycan</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030104">
        <obo:IAO_0000115 xml:lang="tr">Kastaki gama sargolikan miktarının normalden sapması. Alfa, beta, gama ve delta sarkoglikanları distrofin kompleksinin bileşenleridir. Bunların hepsi, hücre içinde kısa bir alanla, tek bir transmembran bölgesi ve korunmuş sistein kümesini içeren büyük bir hücre dışı alana sahip N-glikosile transmembran proteinleridir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal kas lifi gama sarkoglikanı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
