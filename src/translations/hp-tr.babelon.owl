    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500173">
        <obo:IAO_0000115 xml:lang="tr">Bazı veya bütün ekstremitleri etkileyen, sıklıkla epileptik nöbet şeklinde yanlış yorumlanan katılaşma ve klonik hareketlerin takip ettiği bir bilinç kaybı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Refleks asistolik senkop</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500173"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bazı veya bütün ekstremitleri etkileyen, sıklıkla epileptik nöbet şeklinde yanlış yorumlanan katılaşma ve klonik hareketlerin takip ettiği bir bilinç kaybı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A loss of consciousness followed by stiffening and brief clonic movements affecting some or all limbs, often misinterpreted as an epileptic seizure.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500173"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Refleks asistolik senkop</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reflex asystolic syncope</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0550003">
        <obo:IAO_0000115 xml:lang="tr">Parmak derisinin ve metakarpofalangeyal veya metatarsofalangeyal eklemlerin proksimalindeki derinin simetrik kalınlaşması, sıkılaşması ve sertleşmesi. Bu değişiklikler bütün ekstremiteyi, boynu ve gövdeyi içerebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Proksimal skleroderma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0550003"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Parmak derisinin ve metakarpofalangeyal veya metatarsofalangeyal eklemlerin proksimalindeki derinin simetrik kalınlaşması, sıkılaşması ve sertleşmesi. Bu değişiklikler bütün ekstremiteyi, boynu ve gövdeyi içerebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Symmetrical thickening, tightening and induration of the skin of the fingers and the skin proximal to the metacarpophalangeal or metatarsophalangeal joints. These changes can involve the entire limb, face, neck and trunk.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0550003"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Proksimal skleroderma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Proximal scleroderma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0550004">
        <obo:IAO_0000115 xml:lang="tr">Ortak olarak immünyetmez bireylerde sebat eden sıklıkla viral enfeksiyonlar ile ilişkili, hafifçe yükselmiş 2-5 mm çapında siğil</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Verruca plana</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0550004"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ortak olarak immünyetmez bireylerde sebat eden sıklıkla viral enfeksiyonlar ile ilişkili, hafifçe yükselmiş 2-5 mm çapında siğil</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Slightly raised wart 2-5 mm in diameter often associated with viral infections, commonly persistent in immunodeficient individuals.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
