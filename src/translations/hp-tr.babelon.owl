        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aortic elastic fiber disorganization</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032086">
        <obo:IAO_0000115 xml:lang="tr">Çoklu lamella dahil düz kas hücre çekirdeğinin hematoksilin ve eozin boyamasında net olarak tanımlanamadığı aort mediyası bölgesi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Aortik düz kas hücresi çekirdek kaybı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032086"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çoklu lamella dahil düz kas hücre çekirdeğinin hematoksilin ve eozin boyamasında net olarak tanımlanamadığı aort mediyası bölgesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A region of the aortic media in which smooth muscle cell nuclei, involving multiple lamellae, are not clearly identifiable on an hematoxylin and eosin stain.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032086"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Aortik düz kas hücresi çekirdek kaybı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aortic smooth muscle cell nuclei loss</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032087">
        <obo:IAO_0000115 xml:lang="tr">Elastik lifler için olan bir boya ile tanımlandığı üzere bant benzeri bir düz kas hücre kaybına ikincil olarak lamellar birimin incelmesini oluşturan aort mediasının elastik liflerinin mimari açıdan sıkışması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Aort laminar mediyal çöküş</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032087"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Elastik lifler için olan bir boya ile tanımlandığı üzere bant benzeri bir düz kas hücre kaybına ikincil olarak lamellar birimin incelmesini oluşturan aort mediasının elastik liflerinin mimari açıdan sıkışması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Architecturally, a compaction of aortic medial elastic fibers that creates thinning of the lamellar unit secondary to a band-like smooth muscle cell loss identified using a stain for elastic fibers.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032087"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Aort laminar mediyal çöküş</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aortic laminar medial collapse</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032088">
        <obo:IAO_0000115 xml:lang="tr">Fokal/multifokal karışıklığı veya bazen düz kas hücrelerinin nodüler birikimlerini oluşturan aort mediasının düz kas hücrelerinin paralel olmayan düzenlenmesi/karışıklığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Aortik düz kas hücre disorganizasyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032088"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Fokal/multifokal karışıklığı veya bazen düz kas hücrelerinin nodüler birikimlerini oluşturan aort mediasının düz kas hücrelerinin paralel olmayan düzenlenmesi/karışıklığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nonparallel arrangement/disarray of smooth muscle cells of the aortic media creating focal/multifocal disarray or sometimes nodular aggregates of smooth muscle cells.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032088"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Aortik düz kas hücre disorganizasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aortic smooth muscle cell disorganization</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032089">
        <obo:IAO_0000115 xml:lang="tr">Yerine geçen fibrozis alanları veya aort mediyasında intralamellar bir boşluk genişlemesi oluşturan kollajen liflerinde bir artış. Bu, elastik lamellanın (veya lamellar birimler) paralel düzenlenmesinin değişen derecelerde kaybı ile bağlantılı olarak görülebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Aortik mediyal fibrozis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032089"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Yerine geçen fibrozis alanları veya aort mediyasında intralamellar bir boşluk genişlemesi oluşturan kollajen liflerinde bir artış. Bu, elastik lamellanın (veya lamellar birimler) paralel düzenlenmesinin değişen derecelerde kaybı ile bağlantılı olarak görülebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An increase in collagen fibers creating areas of substitutive fibrosis or a widening of intralamellar spaces in the media of the aorta. This can be seen in conjunction with a loss to varying degrees of parallel arrangement of the elastic lamellae (or lamellar units).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032089"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Aortik mediyal fibrozis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aortic medial fibrosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032090">
        <obo:IAO_0000115 xml:lang="tr">Kollajende olan bir artışının lamellar birimlerinin düzenlenmesini anlamlı olarak değiştirmediği bir aort mediyal fibrozis tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İntralamellar aortik mediyal fibrozis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032090"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kollajende olan bir artışının lamellar birimlerinin düzenlenmesini anlamlı olarak değiştirmediği bir aort mediyal fibrozis tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of aortic medial fibrosis in which the increase in collagen does not significantly alter the arrangement of the lamellar units.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032090"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">İntralamellar aortik mediyal fibrozis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Intralamellar aortic medial fibrosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032091">
        <obo:IAO_0000115 xml:lang="tr">Kollajende olan bir artışının daha çok skar benzeri olduğu, lamellar birimlerinin düzenlenmesini değiştirdiği bir aort mediyal fibrozis tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Translamellar aortik mediyal fibrozis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032091"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kollajende olan bir artışının daha çok skar benzeri olduğu, lamellar birimlerinin düzenlenmesini değiştirdiği bir aort mediyal fibrozis tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of aortic medial fibrosis in which the increase in collagen is more scar-like, altering the arrangement of the lamellar units.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032091"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Translamellar aortik mediyal fibrozis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Translamellar aortic medial fibrosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032092">
        <obo:IAO_0000115 xml:lang="tr">Sol ventriküler çıkış yolu (SVÇY) tıkanıklığı valvüler, subvalvüler veya supravalvüler seviyede meydana gelebilir. Gene olarak ard yükü artıran ileri doğru bir tıkanma vardır ve eğer tedavi edilmezse hipertrofi, dilatasyon ve nihai olarak sol ventrikül yetmezliği ile sonuçlanabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sol ventriküler çıkış yolu tıkanması</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032092"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sol ventriküler çıkış yolu (SVÇY) tıkanıklığı valvüler, subvalvüler veya supravalvüler seviyede meydana gelebilir. Gene olarak ard yükü artıran ileri doğru bir tıkanma vardır ve eğer tedavi edilmezse hipertrofi, dilatasyon ve nihai olarak sol ventrikül yetmezliği ile sonuçlanabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Left ventricular outflow tract (LVOT) obstruction can occur at the valvular, subvalvular, or supravalvular level. In general, there is an obstruction to forward flow which increases afterload, and if untreated, can result in hypertrophy, dilatation, and eventual failure of the left ventricle.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032092"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Sol ventriküler çıkış yolu tıkanması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Left ventricular outflow tract obstruction</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032094">
        <obo:IAO_0000115 xml:lang="tr">Kan dolaşımında artmış sürfaktan protein konsantrasyonu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Artmış dolaşım surfaktan protein seviyesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032094"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kan dolaşımında artmış sürfaktan protein konsantrasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The concentration of surfactant protein in the blood circulation is above the upper limit of normal.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032094"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Artmış dolaşım surfaktan protein seviyesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elevated circulating surfactant protein concentration</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032096">
