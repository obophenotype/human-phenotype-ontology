        <rdfs:label xml:lang="tr">İntrapulmoner şant</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031225"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Akciğerleri terk eden kanın oksijenlenmesinde azalma ile sonuçlanan ventilasyonun az olduğu veya hiç olmadığı bir akciğer bölgesi içinden kan akımı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Blood flow through a region of the lung in which little or no ventilation takes place, resulting in reduced oxygenation of the blood leaving the lungs.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
