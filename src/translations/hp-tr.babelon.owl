    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007716">
        <obo:IAO_0000115 xml:lang="tr">Gözün içindeki malign melanoma. Tümör, üveadaki melanositlerden (iris, siliyer vücut ve koroid içerir) kaynaklanır</obo:IAO_0000115>
