    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012663">
        <obo:IAO_0000115 xml:lang="tr">Her kalp döngüsü ile sol ventrikülden pompalanan kan fraksiyonunda küçük bir azalma. Normal aralık erişkinlerde en az yüzde 55&apos;tir ve hafif azalma yüzde 45-54 olarak tanımlanmaktadır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hafif azalmış ejeksiyon fraksiyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012663"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Her kalp döngüsü ile sol ventrikülden pompalanan kan fraksiyonunda küçük bir azalma. Normal aralık erişkinlerde en az yüzde 55&apos;tir ve hafif azalma yüzde 45-54 olarak tanımlanmaktadır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A small reduction in the fraction of blood pumped from the left ventricle with each cardiac cycle. The normal range in adults is at least 50 percent, and a mild reduction is defined as 40-49 percent.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012663"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hafif azalmış ejeksiyon fraksiyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mildly reduced left ventricular ejection fraction</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012664">
        <obo:IAO_0000115 xml:lang="tr">Her kalp döngüsü ile ventrikülden dışarı pompalanan kan hacmi fraksiyonunda bir azalma</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Azalmış ejeksiyon fraksiyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012664"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Her kalp döngüsü ile ventrikülden dışarı pompalanan kan hacmi fraksiyonunda bir azalma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A diminution of the volumetric fraction of blood pumped out of the ventricle with each cardiac cycle.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012664"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Azalmış ejeksiyon fraksiyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced left ventricular ejection fraction</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012665">
        <obo:IAO_0000115 xml:lang="tr">Her kalp döngüsü ile sol ventrikülden pompalanan kan fraksiyonunda orta derece bir azalma. Normal aralık erişkinlerde en az yüzde 55&apos;tir ve orta derece azalma yüzde 30-44 olarak tanımlanmaktadır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Orta derecede azalmış ejeksiyon fraksiyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012665"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Her kalp döngüsü ile sol ventrikülden pompalanan kan fraksiyonunda orta derece bir azalma. Normal aralık erişkinlerde en az yüzde 55&apos;tir ve orta derece azalma yüzde 30-44 olarak tanımlanmaktadır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A medium reduction in the fraction of blood pumped from the left ventricle with each cardiac cycle, defined as a left ventricular ejection fraction of 30-39 percent.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012665"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Orta derecede azalmış ejeksiyon fraksiyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Moderately reduced left ventricular ejection fraction</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012666">
        <obo:IAO_0000115 xml:lang="tr">Her kalp döngüsü ile sol ventrikülden pompalanan kan fraksiyonunda büyük bir azalma. Normal aralık erişkinlerde en az yüzde 55&apos;tir ve büyük azalma yüzde 30&apos;dan az olarak tanımlanmaktadır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ciddi derecede azalmış ejeksiyon fraksiyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012666"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Her kalp döngüsü ile sol ventrikülden pompalanan kan fraksiyonunda büyük bir azalma. Normal aralık erişkinlerde en az yüzde 55&apos;tir ve büyük azalma yüzde 30&apos;dan az olarak tanımlanmaktadır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A large reduction in the fraction of blood pumped from the left ventricle with each cardiac cycle. The normal range in adults is at over 50 percent, and a severe reduction is defined as less than 30 percent.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012666"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ciddi derecede azalmış ejeksiyon fraksiyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Severely reduced left ventricular ejection fraction</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012667">
