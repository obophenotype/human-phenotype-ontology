    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031273">
        <obo:IAO_0000115 xml:lang="tr">Etkin doku perfüzyonunun derin ve yaygın azalmasının, ilk olarak dönüşümlü ve sonra eğer uzarsa dönüşümsüz hücre zedelenmesine yol açtığı bir durum</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Şok</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031273"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Etkin doku perfüzyonunun derin ve yaygın azalmasının, ilk olarak dönüşümlü ve sonra eğer uzarsa dönüşümsüz hücre zedelenmesine yol açtığı bir durum</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The state in which profound and widespread reduction of effective tissue perfusion leads first to reversible, and then if prolonged, to irreversible cellular injury.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031273"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Şok</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Shock</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031274">
        <obo:IAO_0000115 xml:lang="tr">Total vasküler kapasite ile ilişkili azalmış dolaşım kan hacmi ile karakterize bir şok durumu. Bu tip şok diyastolik dolum basıncı azalması ile karakterizedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hipovolemik şok</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031274"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Total vasküler kapasite ile ilişkili azalmış dolaşım kan hacmi ile karakterize bir şok durumu. Bu tip şok diyastolik dolum basıncı azalması ile karakterizedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A state of shock characterized by decreased circulating blood volume in relation to total vascular capacity. This type of shock is characterized by a reduction of diastolic filling pressures.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031274"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hipovolemik şok</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypovolemic shock</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031275">
        <obo:IAO_0000115 xml:lang="tr">Aşırı vazodilatasyondan kaynaklanan hiperdinamik bir süreç. Bozulmuş kan akımı son organ hasarına yol açabilen uygunsuz doku perfüzyonuna neden olur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dağıtımsal şok</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031275"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Aşırı vazodilatasyondan kaynaklanan hiperdinamik bir süreç. Bozulmuş kan akımı son organ hasarına yol açabilen uygunsuz doku perfüzyonuna neden olur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A hyperdynamic process resulting from excessive vasodilatation. Impaired blood flow causes inadequate tissue perfusion, which can lead to end-organ damage</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031275"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Dağıtımsal şok</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Distributive shock</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031276">
        <obo:IAO_0000115 xml:lang="tr">Venöz dönüşün engellenmesine bağlı olarak eksik kalp ön yüküyle karakterize edilen bir şok türü (örneğin, perikardiyal tamponad, gerilim pnömotoraks, karın bölmesi) veya arteryel kan akışının engellenmesi (örneğin, pulmoner emboli)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tıkanıklık şoku</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031276"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Venöz dönüşün engellenmesine bağlı olarak eksik kalp ön yüküyle karakterize edilen bir şok türü (örneğin, perikardiyal tamponad, gerilim pnömotoraks, karın bölmesi) veya arteryel kan akışının engellenmesi (örneğin, pulmoner emboli)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of shock characterized by inadequate cardiac preload due to obstructed venous return (e.g. pericardial tamponade, tension pneumothorax, abdominal compartment) or obstruction of arterial blood flow (e.g. pulmonary embolism).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031276"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Tıkanıklık şoku</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Obstructive shock</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031278">
