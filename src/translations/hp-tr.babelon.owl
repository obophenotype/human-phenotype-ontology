    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003547">
        <obo:IAO_0000115 xml:lang="tr">Omuz veya pektoral kemer, klavikula ve skapula&apos;lardan oluşur. Omuz kemeri zayıflığı, bu kemiklere eklenen kasların güçsüzlüğünü yani omuzların etrafındaki kasların güçsüzlüğünü gösterir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Omuz kemeri kas zayıflığı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003547"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Omuz veya pektoral kemer, klavikula ve skapula&apos;lardan oluşur. Omuz kemeri zayıflığı, bu kemiklere eklenen kasların güçsüzlüğünü yani omuzların etrafındaki kasların güçsüzlüğünü gösterir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The shoulder, or pectoral, girdle is composed of the clavicles and the scapulae. Shoulder-girdle weakness refers to lack of strength of the muscles attaching to these bones, that is, lack of strength of the muscles around the shoulders.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003547"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Omuz kemeri kas zayıflığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Shoulder girdle muscle weakness</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003548">
        <obo:IAO_0000115 xml:lang="tr">Sarkolemma (kas hücre zarı) bitişik olan sitoplazmada, mitokondrianın anormal bir morfolojiye sahip olduğu anormal şekilde artmış bir mitokondri sayısı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal şekilde şekillendirilmiş mitokondriyal alt sarkolemmal birikimler</rdfs:label>
