    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012798">
        <obo:IAO_0000115 xml:lang="tr">Lenf damarlarında ve akciğerde (plevra, alveoler septa, bronşi, pulmoner damarlar ve lenfatikler ile lenf düğümleri, özellikle de posterior mediasten ve retroperitoneumda) düz kas-benzeri hücrelerin infiltrasyonu. Hava yolu daralması sebebiyle fokal amfizem gelişebilir ve torakal kanal tıkanabilir. Pulmoner lenfanjiyomiyomatoz, duvarlarında hamartomatöz düz kas proliferasyonu ile çok sayıda küçük kiste neden olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Pulmoner lenfanjiomiyomatoz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012798"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Lenf damarlarında ve akciğerde (plevra, alveoler septa, bronşi, pulmoner damarlar ve lenfatikler ile lenf düğümleri, özellikle de posterior mediasten ve retroperitoneumda) düz kas-benzeri hücrelerin infiltrasyonu. Hava yolu daralması sebebiyle fokal amfizem gelişebilir ve torakal kanal tıkanabilir. Pulmoner lenfanjiyomiyomatoz, duvarlarında hamartomatöz düz kas proliferasyonu ile çok sayıda küçük kiste neden olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Infiltration of smooth muscle-like cells in lymph vessels as well as the lung (pleura, alveolar septa, bronchi, pulmonary vessels and lymphatics as well as lymph nodes, especially in posterior mediastinum and retroperitoneum). Focal emphysema can develop because of airway narrowing, and the thoracic duct may be obliterated. Pulmonary lymphangiomyomatosis may lead to multiple small cysts with a hamartomatous proliferation of smooth muscle in their walls.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012798"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Pulmoner lenfanjiomiyomatoz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pulmonary lymphangiomyomatosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012799">
