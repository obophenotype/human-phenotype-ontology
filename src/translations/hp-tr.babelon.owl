    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032242">
        <obo:IAO_0000115 xml:lang="tr">Servikal epitelin displazisi ile karakterize prekanseröz bir durum. Servikal intraepitelyal neoplazi (CIN) 1, 2 ve 3 prognozis ile ilişkisine dayanmaktadır. CIN 1 hafif bir displazidir doğal seyrinin bir kısmı olarak gözden kaybolduğu için çoğunlukla gözlenir. CIN 3 ciddi displazi ve karsinoma in situyu içerir ve invazif kansere gelişecek olması kuvvetle muhtemel olduğu için yönetimi tedaviyi içerir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Servikal intraepitelyal neoplazi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032242"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Servikal epitelin displazisi ile karakterize prekanseröz bir durum. Servikal intraepitelyal neoplazi (CIN) 1, 2 ve 3 prognozis ile ilişkisine dayanmaktadır. CIN 1 hafif bir displazidir doğal seyrinin bir kısmı olarak gözden kaybolduğu için çoğunlukla gözlenir. CIN 3 ciddi displazi ve karsinoma in situyu içerir ve invazif kansere gelişecek olması kuvvetle muhtemel olduğu için yönetimi tedaviyi içerir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A precancerous condition characterized by dysplasia of the cervical epithelium. Cervical intraepithelial neoplasia (CIN) 1, 2 and 3 based on its relationship with the prognosis. CIN 1 is mild dysplasia, which is mostly observed because it disappears as part of its natural course. CIN 3 includes severe dysplasia and carcinoma in situ, and management involves treatment because it is highly likely to develop into invasive cancer.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032242"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Servikal intraepitelyal neoplazi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cervical intraepithelial neoplasia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032243">
