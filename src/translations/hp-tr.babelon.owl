    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002666">
        <obo:IAO_0000115 xml:lang="tr">Feokromasitomalar (kromafin tümörleri olarak da bilinirler) katekolamin üretir, depolar ve salgılarlar. Feokromositomlar genellikle adrenal medulladan kaynaklanır ancak kromafin hücrelerinin içindeki veya yakınındaki sempatik sinir düğümlerinden de gelişebilir. Feokromositoma&apos;nın ortak bir bulgusu katekolaminlerin salınması nedeniyle hipertansiyondur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Feokromositoma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002666"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Feokromasitomalar (kromafin tümörleri olarak da bilinirler) katekolamin üretir, depolar ve salgılarlar. Feokromositomlar genellikle adrenal medulladan kaynaklanır ancak kromafin hücrelerinin içindeki veya yakınındaki sempatik sinir düğümlerinden de gelişebilir. Feokromositoma&apos;nın ortak bir bulgusu katekolaminlerin salınması nedeniyle hipertansiyondur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pheochromocytomas (also known as chromaffin tumors) produce, store, and secrete catecholamines. Pheochromocytomas usually originate from the adrenal medulla but may also develop from chromaffin cells in or about sympathetic ganglia. A common symptom of pheochromocytoma is hypertension owing to release of catecholamines.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002666"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Feokromositoma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pheochromocytoma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002667">
