        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011522"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Protanopi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Protanopia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011523">
        <obo:IAO_0000115 xml:lang="tr">Bir iris kisti tek bir hücre katmanından oluşmuştur ve sıvı ile doludur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İris kisti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011523"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir iris kisti tek bir hücre katmanından oluşmuştur ve sıvı ile doludur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An iris cyst is composed of a single cell layer of epithelium and is filled with fluid.</babelon:source_value>
