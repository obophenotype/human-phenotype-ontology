        <babelon:source_value>Acrania</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030717">
        <obo:IAO_0000115 xml:lang="tr">intrauterin intestinal rüptür nedeniyle olan peritonit ve fetal mekonyumun fetal peritoneal boşluk içine dökülmesi. İntra peritoneal mekonyum sıklıkla, bazen 24 saat içinde kalsifiye olur. Ultrason bulguları intraabdominal kalsikifasyonları içerebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Mekonyum peritoniti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030717"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">intrauterin intestinal rüptür nedeniyle olan peritonit ve fetal mekonyumun fetal peritoneal boşluk içine dökülmesi. İntra peritoneal mekonyum sıklıkla, bazen 24 saat içinde kalsifiye olur. Ultrason bulguları intraabdominal kalsikifasyonları içerebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Peritonitis caused by intrauterine intestinal rupture and spillage of fetal meconium into the fetal peritoneal cavity. Intra-peritoneal meconium usually calcifies, sometimes within 24 hours. Ultrasound findings may include intraabdominal calcifications.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030717"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Mekonyum peritoniti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Meconium peritonitis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
