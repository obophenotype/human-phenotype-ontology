    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025551">
        <obo:IAO_0000115 xml:lang="tr">Tipik olarak görsel uyarılmış potansiyeller (VEP) kullanarak tanımlanan görsel yolakların anormal çaprazlaşması (arka kafa derisi asimetrik VEP dağılımı)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Optik sinir yanlış yönlenmesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025551"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Tipik olarak görsel uyarılmış potansiyeller (VEP) kullanarak tanımlanan görsel yolakların anormal çaprazlaşması (arka kafa derisi asimetrik VEP dağılımı)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal decussation of the visual pathways, typically identified using visual evoked potentials (VEP) (asymmetrical distribution of the VEP over the posterior scalp).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025551"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Optik sinir yanlış yönlenmesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Optic nerve misrouting</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025552">
        <obo:IAO_0000115 xml:lang="tr">Basma ile solmayan (beyazlaşmayan) gözlerin etrafını çeviren deride çoklu kırmızı/mor benekler. Purpura subkutanöz kanama tarafından olmuştur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Periorbital purpura</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025552"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Basma ile solmayan (beyazlaşmayan) gözlerin etrafını çeviren deride çoklu kırmızı/mor benekler. Purpura subkutanöz kanama tarafından olmuştur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Multiple red/purple spots on the skin that surrounds the eyes that do not blanch (whiten) upon pressure. Purpura is caused by subcutaneous bleeding.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025552"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Periorbital purpura</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Periorbital purpura</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025553">
        <obo:IAO_0000115 xml:lang="tr">1 cm&apos;den büyük bir çaplı subkutan kanama (ekimoz). Kanama, tarsal plaka içine genişlemez (orantılı olarak kalın, göz kapağı içinde yoğun bağlayıcı dokusunun uzatılmış plakaları) orbital septum adı verilen bir anatomik yapı nedeniyle, tarsal plakanın ötesinde kanın ekstravazasyonunu sınırlayan</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tarsal düzlemi atlayan periorbital ekimoz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025553"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">1 cm&apos;den büyük bir çaplı subkutan kanama (ekimoz). Kanama, tarsal plaka içine genişlemez (orantılı olarak kalın, göz kapağı içinde yoğun bağlayıcı dokusunun uzatılmış plakaları) orbital septum adı verilen bir anatomik yapı nedeniyle, tarsal plakanın ötesinde kanın ekstravazasyonunu sınırlayan</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Subcutaneous bleeding with a diameter greater than 1 cm (ecchymosis). The bleeding does not extend into the tarsal plate (the comparatively thick, elongated plates of dense connective tissue within the eyelid) due to an anatomic structure called the orbital septum, which limits extravasation of blood beyond the tarsal plate.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025553"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Tarsal düzlemi atlayan periorbital ekimoz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Periorbital ecchymosis with tarsal plate sparing</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025554">
        <obo:IAO_0000115 xml:lang="tr">Sarı renkte (lezyonun yüksek bir lipid içeriğini ifade eden) bir cilt nodül türü (hem genişlik hem de derinlik olarak 10 mm&apos;den büyük lezyonlar, ve çoğunlukla alt deri veya subkütan yağın merkezinde)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sarı nodül</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025554"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sarı renkte (lezyonun yüksek bir lipid içeriğini ifade eden) bir cilt nodül türü (hem genişlik hem de derinlik olarak 10 mm&apos;den büyük lezyonlar, ve çoğunlukla alt deri veya subkütan yağın merkezinde)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of skin nodule (a lesions that is greater than either 10mm in both width and depth, and most frequently centered in the dermis or subcutaneous fat) with a yellowish coloration (that reflects a high lipid content of the lesion).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025554"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Sarı nodül</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Yellow nodule</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025555">
        <obo:IAO_0000115 xml:lang="tr">El veya ayak parmak tırnaklarının yakınında yer alan telanjiektazi (küçük dilate kan damarları)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Periungual telenjiektazi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025555"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">El veya ayak parmak tırnaklarının yakınında yer alan telanjiektazi (küçük dilate kan damarları)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Telangiectasia (small dilated blood vessels) located near to the fingernails or toenails.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025555"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Periungual telenjiektazi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Periungual teleangiectasia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025558">
        <obo:IAO_0000115 xml:lang="tr">Lensin periferine doğru ışınsal olarak uzanan çizgisel lens opasiteleri ile ilişkili lameller kataraktlar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Destekli lamellar katarakt</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025558"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Lensin periferine doğru ışınsal olarak uzanan çizgisel lens opasiteleri ile ilişkili lameller kataraktlar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lamellar cataracts with associated linear lens opacities radially extending towards the periphery of the lens.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025558"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Destekli lamellar katarakt</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lamellar cataract with riders</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025559">
        <obo:IAO_0000115 xml:lang="tr">Derin kortekste ışınsal olarak dağılan çomak şekilli ve nokta opasiteleri ile karakterize bir katarakt tipi. Bu lens opasiteleri bir tacı andıran görünümde nükleusu çevreler</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Koroner katarakt</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025559"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Derin kortekste ışınsal olarak dağılan çomak şekilli ve nokta opasiteleri ile karakterize bir katarakt tipi. Bu lens opasiteleri bir tacı andıran görünümde nükleusu çevreler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of cataract characterized by club-shaped and dot opacities distributed radially in the deep cortex. These lens opacities surround the nucleus in an appearance that is though to resemble a crown.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025559"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Koroner katarakt</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Coronary cataract</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025560">
        <obo:IAO_0000115 xml:lang="tr">Gözün ön bölmesinde serbest halde bulunan hücreleri tanımlayan küçük tortulardır. Bu görünüm, alışagelmiş şekilde, sulu bir kan bariyerin bozulmasına yol açan intraoküler inflamasyon ile ilişkilidir ve hücrelerin sayısının sudaki konsantrasyonunun artmasına sebep olur. Derecelendirmeler (GÜNEŞ Çalışma Grubu), 1 mm ye 1 mm yarık alanındaki hücrelerin sayısı hakkında tahminde bulunarak, bir yarık lamba üzerinde yeterli ışık şiddeti ve büyütme kullanılarak gerçekleştirilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ön kamara hücreleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025560"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Gözün ön bölmesinde serbest halde bulunan hücreleri tanımlayan küçük tortulardır. Bu görünüm, alışagelmiş şekilde, sulu bir kan bariyerin bozulmasına yol açan intraoküler inflamasyon ile ilişkilidir ve hücrelerin sayısının sudaki konsantrasyonunun artmasına sebep olur. Derecelendirmeler (GÜNEŞ Çalışma Grubu), 1 mm ye 1 mm yarık alanındaki hücrelerin sayısı hakkında tahminde bulunarak, bir yarık lamba üzerinde yeterli ışık şiddeti ve büyütme kullanılarak gerçekleştirilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tiny deposits corresponding to cells floating in the anterior chamber of the eye. This appearance is typically associated with intraocular inflammation leading to breakdown of the blood-aqueous barrier and resulting in an increase in the number of cells and in the aqueous humor. Grading (SUN Working Group) is performed by estimating the number of cells in a 1 mm by 1 mm slit beam field, employing adequate light intensity and magnification on a slit lamp.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025560"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ön kamara hücreleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anterior chamber cells</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025561">
        <obo:IAO_0000115 xml:lang="tr">Yarık ışıkta uygun ışık yoğunluğu ve büyütme uygulandığında 6-15 hücreli, 1 mm&apos;ye 1 mm yarık ışın alanında ön kamara hücreleri</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ön kamara hücreleri derece 1+</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025561"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Yarık ışıkta uygun ışık yoğunluğu ve büyütme uygulandığında 6-15 hücreli, 1 mm&apos;ye 1 mm yarık ışın alanında ön kamara hücreleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anterior chamber cells with 6-15 cells in a 1 mm by 1 mm slit beam field, employing adequate light intensity and magnification on a slit lamp.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025561"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ön kamara hücreleri derece 1+</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anterior chamber cells grade 1+</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
