    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003798">
        <obo:IAO_0000115 xml:lang="tr">Nemalin çubuklar, iskelet kas liflerinde görülen anormal cisimlerdir. Çubuklar, kas biyopsisi dokusunun histolojik analizi veya elektron mikroskopisi ile gözlemlenebilir; burada, Z-çizgilerine (çoğunlukla sarkomerlerin bulunmadığı bölgelerde) açıkça bağlanmadan rastgele dizide sarkomerik Z-çizgilerinin uzantıları olarak veya geniş sarkolemma veya interfibriler boşluklara lokalize kümeler şeklinde görülürler</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Nemalin cisimleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003798"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Nemalin çubuklar, iskelet kas liflerinde görülen anormal cisimlerdir. Çubuklar, kas biyopsisi dokusunun histolojik analizi veya elektron mikroskopisi ile gözlemlenebilir; burada, Z-çizgilerine (çoğunlukla sarkomerlerin bulunmadığı bölgelerde) açıkça bağlanmadan rastgele dizide sarkomerik Z-çizgilerinin uzantıları olarak veya geniş sarkolemma veya interfibriler boşluklara lokalize kümeler şeklinde görülürler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nemaline rods are abnormal bodies that can occur in skeletal muscle fibers. The rods can be observed on histological analysis of muscle biopsy tissue or upon electron microscopy, where they appear either as extensions of sarcomeric Z-lines, in random array without obvious attachment to Z-lines (often in areas devoid of sarcomeres) or in large clusters localized at the sarcolemma or intermyofibrillar spaces.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003798"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Nemalin cisimleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nemaline bodies</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
