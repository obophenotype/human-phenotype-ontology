        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of watery eye associated with obstruction of the nasolacrimal system. This may arise at the level of the punctum, the canaliculi, the sac or the nasolacrimal duct.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
