    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010830">
        <obo:IAO_0000115 xml:lang="tr">Azalmış dokunma duyusu hissi (taktil hissi). Bu genellikle bir pamuk parçası veya ince fırça ile hastaya uyarıyı hissettiği her defasında &apos;şimdi&apos; demesi istenerek test edilmektedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Bozulmuş dokunma duyusu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010830"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Azalmış dokunma duyusu hissi (taktil hissi). Bu genellikle bir pamuk parçası veya ince fırça ile hastaya uyarıyı hissettiği her defasında &apos;şimdi&apos; demesi istenerek test edilmektedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduced sense of touch (tactile sensation). This is usually tested with a wisp of cotton or a fine camel&apos;s hair brush, by asking patients to say &apos;now&apos; each time they feel the stimulus.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010830"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Bozulmuş dokunma duyusu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired tactile sensation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010831">
        <obo:IAO_0000115 xml:lang="tr">Vücut kısımlarının ve eklemin görece pozisyon hissinin kaybı veya bozukluğu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Bozulmuş propriyosepsiyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010831"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Vücut kısımlarının ve eklemin görece pozisyon hissinin kaybı veya bozukluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A loss or impairment of the sensation of the relative position of parts of the body and joint position.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
