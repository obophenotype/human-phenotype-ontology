    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004448">
        <obo:IAO_0000115 xml:lang="tr">Hepatik yetmezlik karaciğerin, daha önce sağlıklı olan birinin mental durumunuda koagülopati ve değişme ile sonuçlanabilecek, normal sentetik ve metabolik işlevlerini yerine getirememesidir. Hepatik yetmezlik, daha önce sağlıklı bir karaciğeri olan hastada semptomların başlamasından sonra 4 hafta içinde ansefalopati başlıyorsa fulminan olarak tanımlanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fulminan hepatik yetmezlik</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004448"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hepatik yetmezlik karaciğerin, daha önce sağlıklı olan birinin mental durumunuda koagülopati ve değişme ile sonuçlanabilecek, normal sentetik ve metabolik işlevlerini yerine getirememesidir. Hepatik yetmezlik, daha önce sağlıklı bir karaciğeri olan hastada semptomların başlamasından sonra 4 hafta içinde ansefalopati başlıyorsa fulminan olarak tanımlanır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hepatic failure refers to the inability of the liver to perform its normal synthetic and metabolic functions, which can result in coagulopathy and alteration in the mental status of a previously healthy individual. Hepatic failure is defined as fulminant if there is onset of encephalopathy within 4 weeks of the onset of symptoms in a patient with a previously healthy liver.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004448"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Fulminan hepatik yetmezlik</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fulminant hepatic failure</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
