    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031743">
        <obo:IAO_0000115 xml:lang="tr">Tipik olarak felcin veya ipsilateral antagonist veya kontralateral sinerjist sınırlamasının bir sonucu olarak artmış innervasyon nedeniyle oluşan inferior rektus kasının aşırı hareketi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İnferior rektus kas aşırı hareketi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031743"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Tipik olarak felcin veya ipsilateral antagonist veya kontralateral sinerjist sınırlamasının bir sonucu olarak artmış innervasyon nedeniyle oluşan inferior rektus kasının aşırı hareketi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Excessive action of the inferior rectus muscle caused by increased innervation typically as a consequence of palsy or limitation to the ipsilateral antagonist or contralateral synergist.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
