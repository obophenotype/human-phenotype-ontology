    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002308">
        <obo:IAO_0000115 xml:lang="tr">Arnold-Chiari malformasyonu, serebellar bademcikler ve medullanın foramen magnum yolu ile aşağı tarafa doğru yer değiştirmesinden oluşur, bazen BOS çıkışının tıkanmasından dolayı hidrosefaliye sebep olur</obo:IAO_0000115>
