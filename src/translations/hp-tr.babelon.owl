    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010867">
        <obo:IAO_0000115 xml:lang="tr">İstemli bir hareketin bileşenlerini uygun sıra ve hızda düzgün bir şekilde sergileme yeteneğinin bozulması ile karakterize bir ataksi tipi. Dissinerji ile, istemli bir hareket bileşen parçalarına ayrılmış gözükür</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dissinerji</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010867"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İstemli bir hareketin bileşenlerini uygun sıra ve hızda düzgün bir şekilde sergileme yeteneğinin bozulması ile karakterize bir ataksi tipi. Dissinerji ile, istemli bir hareket bileşen parçalarına ayrılmış gözükür</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of ataxia characterized by the impairment of the ability to smoothly perform the elements of a voluntary movement in the appropriate order and speed. With dyssynergia, a voluntary movement appears broken down into its component parts.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010867"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Dissinerji</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dyssynergia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010868">
        <obo:IAO_0000115 xml:lang="tr">Göz hareketlerini etkileyen ve görme alanı içindeki görsel bir hedefi düzgünce takip edememe ile karakterize bir tip dissinerji</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Oküler dissinerji</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010868"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Göz hareketlerini etkileyen ve görme alanı içindeki görsel bir hedefi düzgünce takip edememe ile karakterize bir tip dissinerji</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of dyssynergia affecting eye movements and characterized by the inability to smoothly follow a visual target across the visual field.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010868"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Oküler dissinerji</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ocular dyssynergia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010869">
        <obo:IAO_0000115 xml:lang="tr">İstemli bir hareketin bileşenlerini uygun sıra ve hızda gösterme kabiliyeti yokluğu ile karakterize bir dissinerji tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Asinerji</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010869"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İstemli bir hareketin bileşenlerini uygun sıra ve hızda gösterme kabiliyeti yokluğu ile karakterize bir dissinerji tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of dyssynergy characterized by the lack of the ability to smoothly perform the elements of a voluntary movement in the appropriate order and speed.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010869"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Asinerji</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Asynergia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010871">
        <obo:IAO_0000115 xml:lang="tr">Duyusal sinir sisteminde bir eksiklikten kaynaklanan hareketin koordinasyonu. Duyusal ataksi, hastanın gözlerini kapatmasını istemek suretiyle serebellar ataksi ile ayırt edilebilir. Serebellar ataksi olan kişiler belirtilerin hafifçe kötüleşmesine neden olurken, duyusal ataksi olan kişiler semptomların belirgin derecede kötüleşmesini göstermektedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Duyusal ataksi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010871"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Duyusal sinir sisteminde bir eksiklikten kaynaklanan hareketin koordinasyonu. Duyusal ataksi, hastanın gözlerini kapatmasını istemek suretiyle serebellar ataksi ile ayırt edilebilir. Serebellar ataksi olan kişiler belirtilerin hafifçe kötüleşmesine neden olurken, duyusal ataksi olan kişiler semptomların belirgin derecede kötüleşmesini göstermektedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Incoordination of movement caused by a deficit in the sensory nervous system. Sensory ataxia can be distinguished from cerebellar ataxia by asking the patient to close his or her eyes. Persons with cerebellar ataxia show only a minimal worsening of symptoms, whereas persons with sensory ataxia show a marked worsening of symptoms.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010871"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Duyusal ataksi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sensory ataxia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010872">
