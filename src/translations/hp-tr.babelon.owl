        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Delayed fine motor development</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010863">
        <obo:IAO_0000115 xml:lang="tr">Diğerlerinin konuşmasını anlama yeteneğinin kazanılmasında bir gecikme</obo:IAO_0000115>
