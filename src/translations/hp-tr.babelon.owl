        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Aksesuar dalak</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Accessory spleen</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001748">
        <obo:IAO_0000115 xml:lang="tr">Polispleni, çok sayıda küçük aksesuar dalak tarafından ortaya çıkan doğumsal bir hastalıktır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Polispleni</rdfs:label>
