    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031410">
        <obo:IAO_0000115 xml:lang="tr">Akış sitometrisi ile ölçülen CD56 parlak NK hücrelerinin sayısında anormal bir dağılım. Homotipik adezyona aracılık eden adezyon molekülü CD56 NK hücreleri için fonksiyonel belirteç olarak kullanılmaktadır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">CD56 parlak/loş doğal katil hücrelerinin anormal dağılımı</rdfs:label>
    </rdf:Description>
