    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010230">
        <obo:IAO_0000115 xml:lang="tr">&quot;El parmaklarının epifizlerinin, &quot;&quot;soket içinde bilye&quot;&quot; görünümü üreten, koni şeklindeki görünümü. İlgili öge &apos;melek şeklindeki&apos; epifiz, falanksın distal ucunda bir psödoepifiz ile birlikte belirgin koni şeklindeki bir epifizi belirtir&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">El falankslarının koni şeklindeki epifizleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010230"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">&quot;El parmaklarının epifizlerinin, &quot;&quot;soket içinde bilye&quot;&quot; görünümü üreten, koni şeklindeki görünümü. İlgili öge &apos;melek şeklindeki&apos; epifiz, falanksın distal ucunda bir psödoepifiz ile birlikte belirgin koni şeklindeki bir epifizi belirtir&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cone-shaped appearance of the epiphyses of the fingers of the hand, producing a &apos;ball-in-a-socket&apos; appearance. The related entity &apos;angel-shaped&apos; epiphysis refers to a pronounced cone-shaped epiphysis in combination with a pseudoepiphysis at the distal end of a phalanx.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010230"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">El falankslarının koni şeklindeki epifizleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cone-shaped epiphyses of the phalanges of the hand</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
