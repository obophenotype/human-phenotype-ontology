        <babelon:source_value>Abnormal vascular morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025016">
        <obo:IAO_0000115 xml:lang="tr">Arterioller ile venülleri bağlayan ve kan dolaşımı ve duvarları vücut dokuları arasında sıvı ve gaz difüzyonuna aracılık eden yarı geçirgen membran olarak hareket eden küçük kan damarlarının yapısal bir anomalisi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal kapiller morfoloji</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025016"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Arterioller ile venülleri bağlayan ve kan dolaşımı ve duvarları vücut dokuları arasında sıvı ve gaz difüzyonuna aracılık eden yarı geçirgen membran olarak hareket eden küçük kan damarlarının yapısal bir anomalisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A structural anomaly of the tiny blood vessels that connect arterioles with venules and whose walls act as semipermeable membranes that mediate the diffusion of fluids and gases between the blood circulation and body tissues.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025016"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal kapiller morfoloji</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal capillary morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025017">
        <obo:IAO_0000115 xml:lang="tr">Kapiller kan damalarının yırtılmasına azalmış direnç. Kapiller kırılganlık spontan ekimozlu (berelenme) kanama diatezi olarak ortaya çıkabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kapiller kırılganlık</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025017"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kapiller kan damalarının yırtılmasına azalmış direnç. Kapiller kırılganlık spontan ekimozlu (berelenme) kanama diatezi olarak ortaya çıkabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced resistance to rupture of capillary blood vessels. Capillary fragility may manifest as a bleeding diathesis with spontaneous ecchymoses (bruises).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025017"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kapiller kırılganlık</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Capillary fragility</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025018">
        <obo:IAO_0000115 xml:lang="tr">Arterioller ile venülleri bağlayan ve kan dolaşımı ve duvarları vücut dokuları arasında sıvı ve gaz difüzyonuna aracılık eden yarı geçirgen membran olarak hareket eden küçük kan damarlarının fonksiyonel bir anomalisi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal kapiller fizyolojisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025018"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Arterioller ile venülleri bağlayan ve kan dolaşımı ve duvarları vücut dokuları arasında sıvı ve gaz difüzyonuna aracılık eden yarı geçirgen membran olarak hareket eden küçük kan damarlarının fonksiyonel bir anomalisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A functional anomaly of the tiny blood vessels that connect arterioles with venules and whose walls act as semipermeable membranes that mediate the diffusion of fluids and gases between the blood circulation and body tissues.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025018"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal kapiller fizyolojisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal capillary physiology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025019">
        <obo:IAO_0000115 xml:lang="tr">Dolaşımdan kan kaçışına yol açan bir arterin ani çatlaması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Arteryel rüptür</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025019"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Dolaşımdan kan kaçışına yol açan bir arterin ani çatlaması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
