    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010862"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Parmakları ve eli kontrol etme yeteneği kazanmada gecikme ile karakterize bir motor gecikme itipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
