    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030957">
        <obo:IAO_0000115 xml:lang="tr">İnterventriküler septumun normal kalp hareketi esnasında herhangi bir tarafta erişkinlerde 15 mm&apos;den çocuklarda 5 mm&apos;den daha fazla eğilmesi (bir tarafa şişmesi)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ventriküler septal anevrizma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
