    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004813">
        <obo:IAO_0000115 xml:lang="tr">Kan ürünlerinin aktarımı 5-10 gün sonra ani trombositopeni başlangıcı (trombosit sayısında azalma). Klinik görüntü post-transfüzyon purpura (PTP), ağır şiddetli thrmbocytopenia, epistaksis ve kanamaları</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Post transfüzyon trombositopenisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004813"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
