    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001966">
        <obo:IAO_0000115 xml:lang="tr">Kapilerler arasında renal glomerulusun merkezi kısmı olan mezangiyumun bir anormalliği</obo:IAO_0000115>
