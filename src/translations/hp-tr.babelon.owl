    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002847">
        <obo:IAO_0000115 xml:lang="tr">Hafıza hücrelerinin bozuk üretimi, yıllarca ya da yaşam boyu devam eden ve sekonder zorluklara hızlı ve gelişmiş cevap veren B hücreleri</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Bozulmuş hafıza B hücresi oluşumu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002847"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hafıza hücrelerinin bozuk üretimi, yıllarca ya da yaşam boyu devam eden ve sekonder zorluklara hızlı ve gelişmiş cevap veren B hücreleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired production of memory cells, the B cells that persist for years or an entire lifetime and which confer rapid and enhanced response to secondary challenge.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
