    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0040227">
        <obo:IAO_0000115 xml:lang="tr">Bu seviyelerin azalması, fibrinoliz inhibisyonunun artışı ve koagülasyon inhibisyonunun azalmasıyla sonuçlanır</obo:IAO_0000115>
