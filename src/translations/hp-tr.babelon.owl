        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032066">
        <obo:IAO_0000115 xml:lang="tr">Dolaşımda normal bikarbonat, HCO3, konsantrasyonunun anormal bir düşüşü</obo:IAO_0000115>
