    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002280">
        <obo:IAO_0000115 xml:lang="tr">Serebellum ve medulla oblongatanın dorsal yüzeyi arasında bulunan, araknoid ile pia mater arasında subaraknoid boşlukta üç temel açıklıktan biri olan sisterna magna boyutunda artış</obo:IAO_0000115>
