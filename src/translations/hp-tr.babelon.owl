    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010492">
        <obo:IAO_0000115 xml:lang="tr">&quot;Yumuşak kısımları ve parmakların bireysel kemiklerinin füzyonu dahil olmak üzere, parmakların ağ ile çevrilmesi veya füzyonu. Kemik füzyonları füzyonun radyo-ulnar bir eksende gerçekleşmesi halinde &quot;&quot;kemikli&quot;&quot; Sindaktili olarak sayılır. Parmakların kemiklerinin proksim-distal bir eksende füzyonuna &quot;&quot;Senfalanjizm&quot;&quot; denir&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kemiksi parmak sindaktilisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010492"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">&quot;Yumuşak kısımları ve parmakların bireysel kemiklerinin füzyonu dahil olmak üzere, parmakların ağ ile çevrilmesi veya füzyonu. Kemik füzyonları füzyonun radyo-ulnar bir eksende gerçekleşmesi halinde &quot;&quot;kemikli&quot;&quot; Sindaktili olarak sayılır. Parmakların kemiklerinin proksim-distal bir eksende füzyonuna &quot;&quot;Senfalanjizm&quot;&quot; denir&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Webbing or fusion of the fingers, involving soft parts and including fusion of individual finger bones.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
