        <babelon:source_value>Transient global amnesia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010535">
        <obo:IAO_0000115 xml:lang="tr">Uyku esnasında ağız ve burunda hava akımının aralıklarla kesilmesi. 10 saniyeden fazla olan apneler önemli olarak değerlendirilir, fakat uyku apnesine sahip insanlar 20 saniyeden 2 veya 3 dakikaya kadar süren apnelere sahip olabilir. Hastalar uykuda saatte 15 olaya kadar sahip olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Uyku apnesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010535"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Uyku esnasında ağız ve burunda hava akımının aralıklarla kesilmesi. 10 saniyeden fazla olan apneler önemli olarak değerlendirilir, fakat uyku apnesine sahip insanlar 20 saniyeden 2 veya 3 dakikaya kadar süren apnelere sahip olabilir. Hastalar uykuda saatte 15 olaya kadar sahip olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An intermittent cessation of airflow at the mouth and nose during sleep is known as sleep apnea. Apneas that last at least 10 seconds are considered significant, but individuals with sleep apnea may experience apneas lasting from 20 seconds up to 2 or 3 minutes. Patients may have up to 15 events per hour of sleep.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010535"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Uyku apnesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sleep apnea</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010536">
        <obo:IAO_0000115 xml:lang="tr">Ventilasyon kaslarının merkezi çalışmasının geçiçi abolisyonundan kaynaklanan uyku apnesi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Merkezi uyku apnesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010536"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ventilasyon kaslarının merkezi çalışmasının geçiçi abolisyonundan kaynaklanan uyku apnesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sleep apnea results from a temporary loss of the central drive to the muscles responsible for breathing.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010536"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Merkezi uyku apnesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Central sleep apnea</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
