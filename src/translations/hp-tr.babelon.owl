    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000836">
        <obo:IAO_0000115 xml:lang="tr">Tiroksin (T4) ve/veya 3,3&apos;,5&apos;-triiyodo-L-tironin zwitterion (triiyodotironin veya T3) olan tiroid hormonlarının aşırı salınımı ile karakterize tiroid fizyolojisinin bir anormalliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hipertiroidizm</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000836"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Tiroksin (T4) ve/veya 3,3&apos;,5&apos;-triiyodo-L-tironin zwitterion (triiyodotironin veya T3) olan tiroid hormonlarının aşırı salınımı ile karakterize tiroid fizyolojisinin bir anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of thyroid physiology characterized by excessive secretion of the thyroid hormones thyroxine (i.e., T4) and/or 3,3&apos;,5-triiodo-L-thyronine zwitterion (i.e., triiodothyronine or T3).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000836"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hipertiroidizm</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hyperthyroidism</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000837">
        <obo:IAO_0000115 xml:lang="tr">Ön hipofiz bezinden gonadotropin (FSH, LH) üretiminin aşırı artması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dolaşımda artmış gonadotropin düzeyi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000837"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
