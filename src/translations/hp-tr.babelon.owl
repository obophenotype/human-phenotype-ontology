        <babelon:source_value>Abnormality iris morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000526">
        <obo:IAO_0000115 xml:lang="tr">Konjenital iris yokluğu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Aniridi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000526"/>
