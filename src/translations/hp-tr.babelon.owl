        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased length of the big toe.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001847"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Uzun ayak baş parmağı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Long hallux</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001848">
        <obo:IAO_0000115 xml:lang="tr">Bu ayağın kaval kemiğine ters yönde konumlandığı bir postür bozukluğudur. Topuk (kalkaneus) aşağıya doğru konumlanmış (yani, ayak bileği yukarıya doğru büküktür), ve topuk dışarıya dönüktür (valgus)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kalkaneovalgus deformitesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001848"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bu ayağın kaval kemiğine ters yönde konumlandığı bir postür bozukluğudur. Topuk (kalkaneus) aşağıya doğru konumlanmış (yani, ayak bileği yukarıya doğru büküktür), ve topuk dışarıya dönüktür (valgus)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>This is a postural deformity in which the foot is positioned up against the tibia. The heel (calcaneus) is positioned downward (that is, the ankle is flexed upward), and the heel is turned outward (valgus).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
