    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001907">
        <obo:IAO_0000115 xml:lang="tr">Bir kan damarının içindeki kan pıhtısı oluşması, daha sonra kan akımıyla oluştuğu yerden vücudun başka bir yerine götürülmesi, genellikle uzaktaki bölgede vasküler oklüzyona neden olur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tromboembolizm</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001907"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir kan damarının içindeki kan pıhtısı oluşması, daha sonra kan akımıyla oluştuğu yerden vücudun başka bir yerine götürülmesi, genellikle uzaktaki bölgede vasküler oklüzyona neden olur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The formation of a blood clot inside a blood vessel that subsequently travels through the blood stream from the site where it formed to another location in the body, generally leading to vascular occlusion at the distant site.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
