    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006929">
        <obo:IAO_0000115 xml:lang="tr">Kan şekerinin kritik bir seviyenin (yaklaşık 30 mg/dl) altına düşmesi ile ilgili beyin hasarı, karışıklığa, letarji ve deliryuma ve ardından nöbetler ve komaya sebep olabilir. Uzun süreli hipoglisemi, beyin hasarının geri dönüşsüz olmasına sebep olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hipoglisemik ensefalopati</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006929"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kan şekerinin kritik bir seviyenin (yaklaşık 30 mg/dl) altına düşmesi ile ilgili beyin hasarı, karışıklığa, letarji ve deliryuma ve ardından nöbetler ve komaya sebep olabilir. Uzun süreli hipoglisemi, beyin hasarının geri dönüşsüz olmasına sebep olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Brain damage related to a lowering of blood glucose below a critical level (around 30 mg/dl), which may lead to confusion, lethargy and delirium followed by seizures and coma. Prolonged hypoglycemia may lead to irreversible brain damage.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006929"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hipoglisemik ensefalopati</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypoglycemic encephalopathy</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
