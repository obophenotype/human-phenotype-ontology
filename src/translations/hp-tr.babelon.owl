    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030281">
        <obo:IAO_0000115 xml:lang="tr">Fetal gelişimin erken haftaları esnasında servikal vertebraların normal segmentasyonunda veya bölünmesinde bir yetersizlikten kaynaklanan servikal vertebraların C3&apos;te ve C4&apos;te füzyonu</obo:IAO_0000115>
