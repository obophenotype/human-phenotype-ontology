        <owl:annotatedTarget xml:lang="tr">Kas liflerinde azalmış bir merozin miktarı. Bu özellik genellikle kas biyopsi dokusunun immünohistokimyasal değerlendirmesi ile incelenir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduced amount of merosin in muscle fibers. This feature is usually assessed by immunohistochemical examination of muscle biopsy tissue.</babelon:source_value>
