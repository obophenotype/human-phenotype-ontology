        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100768">
        <obo:IAO_0000115 xml:lang="tr">Genelde plasentanın malign, trofoblastik ve agresif bir kanseridir. Akciğerlere erken hematojen dağılım gösterir ve germ hücreli tümörlerin bir alt kümesi olan gestasyonel trofoblastik hastalık (GTD) spektrumunun en uç noktasına aittir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Koryokarsinom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100768"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Genelde plasentanın malign, trofoblastik ve agresif bir kanseridir. Akciğerlere erken hematojen dağılım gösterir ve germ hücreli tümörlerin bir alt kümesi olan gestasyonel trofoblastik hastalık (GTD) spektrumunun en uç noktasına aittir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A malignant, trophoblastic and aggressive cancer, usually of the placenta. It is characterized by early hematogenous spread to the lungs and belongs to the far end of the spectrum of gestational trophoblastic disease (GTD), a subset of germ cell tumors.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
