        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030366">
        <obo:IAO_0000115 xml:lang="tr">Bebeğin kafası üzerine uygulanan ve doğum sürecini asiste etmek için traksiyon uygulanan Odon aygıtı yardımlı vajinal doğumlar için bir alettir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Odon aleti ile doğum</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030366"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bebeğin kafası üzerine uygulanan ve doğum sürecini asiste etmek için traksiyon uygulanan Odon aygıtı yardımlı vajinal doğumlar için bir alettir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The Odon device is an instrument for assisted vaginal deliveries that is applied on the head of the baby and used to apply traction to assist the birth process.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
