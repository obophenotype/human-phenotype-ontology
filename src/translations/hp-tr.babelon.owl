    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009302">
        <obo:IAO_0000115 xml:lang="tr">Kurşun şekilli falanks, distale doğru incelen kısa ve geniş bir falanks anlamına gelir. Kurşun-şekilli falankslar normal diyafiz daralmasına sahip değildirler. Bu terim, 4. parmak distal falanksı etkilenmiş ise kullanılır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">4. ayak parmağının mermi şeklindeki distal falanksı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009302"/>
