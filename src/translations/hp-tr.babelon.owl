    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031355">
        <obo:IAO_0000115 xml:lang="tr">Uykuda kalma anormal zorluk. Etkilenmiş bireyler gece uyanma eğilimindedir ve uykuya geri dönmede zorluğa sahiptir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Devamlılık insomniası</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
