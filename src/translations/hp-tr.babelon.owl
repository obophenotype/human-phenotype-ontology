        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009261">
        <obo:IAO_0000115 xml:lang="tr">4. parmağın proksimal falanksının proksimal ucunda lokalize olmuş epifizin yokluğu</obo:IAO_0000115>
