        <babelon:source_value>Increased naive B cell proportion</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030372">
        <obo:IAO_0000115 xml:lang="tr">B hücrelerinin toplam sayısına göreceli olarak saf B hücrelerinin (CD19+/CD27-/IgD+/IgM+) normal oranının altında bir azalma. Saf B hücreleri periferik kandaki B hücrelerinin bir alt grubunu ve antijene maruz kalmamış B hücrelerini temsil etmektedir</obo:IAO_0000115>
