        <obo:IAO_0000115 xml:lang="tr">Omuriliğin içinde dilate, glial-kaplı boşluk. Bu boşluk merkezi kanal ile iletişim kurmaz ve genellikle dorsal sütunlar arasında tek veya çift taraflı olarak kordonun kenarı boyunca bulunur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Siringomyeli</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
