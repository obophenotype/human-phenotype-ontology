    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030048">
        <obo:IAO_0000115 xml:lang="tr">Kolposefali beyinde, lateral ventriküllerin diğer bölümleriyle karşılaştırıldığında orantısız şekilde büyütülmüş oksipital boynuzlarla kendini gösteren anatomik bir bulgudur</obo:IAO_0000115>
