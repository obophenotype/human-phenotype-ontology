    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006640">
        <obo:IAO_0000115 xml:lang="tr">Kaburgaların birden fazla kırığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Çoklu kaburga kırıkları</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006640"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kaburgaların birden fazla kırığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>More than one fracture of the ribs. Callus formation around multiple rib fractures can produce a row of multiple rounded expansions (beadlike prominences) giving the appearance of beaded ribs. Note that rachitic rosary would have one bead per rib (a swelling at the costochondral junction), while beaded ribs in the context of multiple rib fractures have multiple beads (fractures) along the same rib.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006640"/>
