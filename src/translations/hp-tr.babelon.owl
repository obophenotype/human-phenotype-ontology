    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001685">
        <obo:IAO_0000115 xml:lang="tr">Miyokardiyal fibrozis, bozulmuş kollajen döngüsü (artmış sentez, değişmemiş veya azalmış degradasyon üzerine baskındır) ve miyofibroblastlar adı verilen fenotipik olarak dönüşmüş fibroblastlar dahil intersitisyel ve perivasküler boşluklarda aşırı yaygın kollajen birikimi ile karakterizedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Myokardiyal fibrozis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001685"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Miyokardiyal fibrozis, bozulmuş kollajen döngüsü (artmış sentez, değişmemiş veya azalmış degradasyon üzerine baskındır) ve miyofibroblastlar adı verilen fenotipik olarak dönüşmüş fibroblastlar dahil intersitisyel ve perivasküler boşluklarda aşırı yaygın kollajen birikimi ile karakterizedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Myocardial fibrosis is characterized by dysregulated collagen turnover (increased synthesis predominates over unchanged or decreased degradation) and excessive diffuse collagen accumulation in the interstitial and perivascular spaces as well as by phenotypically transformed fibroblasts, termed myofibroblasts.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001685"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Myokardiyal fibrozis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Myocardial fibrosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
