    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000556">
        <obo:IAO_0000115 xml:lang="tr">Retinal distrofi kalıtsal bir süreç ile ilişkili bir retina anormalliğidir. Retinal distrofiler çoğunlukla monogenik kalıtım tarafından tanımlanır ve sıklıkla asıl ya da ikincil olaylar olarak fotoreseptör hücrelerin kaybı ya da bozukluğu ile ilişkilidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Retinal distrofi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000556"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Retinal distrofi kalıtsal bir süreç ile ilişkili bir retina anormalliğidir. Retinal distrofiler çoğunlukla monogenik kalıtım tarafından tanımlanır ve sıklıkla asıl ya da ikincil olaylar olarak fotoreseptör hücrelerin kaybı ya da bozukluğu ile ilişkilidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinal dystrophy is an abnormality of the retina associated with a hereditary process. Retinal dystrophies are defined by their predominantly monogenic inheritance and they are frequently associated with loss or dysfunction of photoreceptor cells as a primary or secondary event.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000556"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Retinal distrofi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinal dystrophy</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000557">
        <obo:IAO_0000115 xml:lang="tr">Buftalmos gözün doğumsal açık açılı glokomuna verilen addır. Buftalmos terimi (Yunanca&apos;da &apos;bous&apos; veya öküz ve &apos;oftalmos&apos; veya göz) artmış göz içi basıncından kaynaklanan genişlemiş göz küresini tarif etmektedir. Göz küresi özellikle genleşmeye yenidoğan döneminde ve yaşamın ilk bir yılında meyillidir çünkü kollajen filamanları erişkinlerdeki gibi kaskatı değildir ve kolayca uzayabilmektedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Buftalmos</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000557"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Buftalmos gözün doğumsal açık açılı glokomuna verilen addır. Buftalmos terimi (Yunanca&apos;da &apos;bous&apos; veya öküz ve &apos;oftalmos&apos; veya göz) artmış göz içi basıncından kaynaklanan genişlemiş göz küresini tarif etmektedir. Göz küresi özellikle genleşmeye yenidoğan döneminde ve yaşamın ilk bir yılında meyillidir çünkü kollajen filamanları erişkinlerdeki gibi kaskatı değildir ve kolayca uzayabilmektedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Diffusely large eye (with megalocornea) associated with glaucoma.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
