        <obo:IAO_0000115 xml:lang="tr">Kemik iliğinde beklenen çekirdek boyutundan daha az lobüle olmuş çekirdekli megakaryositlerin varlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Megakaryosit çekirdek hipolobülasyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031385"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
