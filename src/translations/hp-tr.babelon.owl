        <owl:annotatedTarget xml:lang="tr">Lateral rektus kas kısıtlanması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lateral rectus muscle restriction</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031759">
        <obo:IAO_0000115 xml:lang="tr">Sapmanın tüm koşullarda (bütün mesafelerde ve bütün zamanlarda) mevcut olduğu yakınsak bir strabismus (ezotropi) formu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Basit sabit ezotropi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031759"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sapmanın tüm koşullarda (bütün mesafelerde ve bütün zamanlarda) mevcut olduğu yakınsak bir strabismus (ezotropi) formu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of convergent strabismus (esotropia) in which the deviation is present under all conditions (ie at all distances and at all times).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031759"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Basit sabit ezotropi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Basic constant esotropia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031760">
        <obo:IAO_0000115 xml:lang="tr">Sapma açısının uyum çabası tarafından etkilenmediği bir ezotropi formu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Akomodatif olmayan ezotropi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031760"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sapma açısının uyum çabası tarafından etkilenmediği bir ezotropi formu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of esotropia in which the angle of deviation is not affected by accommodative effort.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031760"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Akomodatif olmayan ezotropi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Non-accomodative esotropia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031761">
        <obo:IAO_0000115 xml:lang="tr">6 aydan önce meydana gelen sabit ezotropi. Tipik olarak geniş bir sapma açısı, değişken sabitleme (bu yüzden düşük ambiliyopi riski) ve binoküler tek görüş için zayıf potansiyel ile ilişkilidir. İnfantil (sabit) ezotropili bireylerde geç nistagmus veya belirgin geç nistagmus, ayrışmış dikey ıraksaklık, siklotropiya, anormal baş pozisyonu, sınırlı abdüksiyon dahil diğer özellikler mevcut olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İnfantil sabit ezotropi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031761"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">6 aydan önce meydana gelen sabit ezotropi. Tipik olarak geniş bir sapma açısı, değişken sabitleme (bu yüzden düşük ambiliyopi riski) ve binoküler tek görüş için zayıf potansiyel ile ilişkilidir. İnfantil (sabit) ezotropili bireylerde geç nistagmus veya belirgin geç nistagmus, ayrışmış dikey ıraksaklık, siklotropiya, anormal baş pozisyonu, sınırlı abdüksiyon dahil diğer özellikler mevcut olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Constant esotropia occurring before 6 months of age. It is typically associated with a large angle of deviation, alternating fixation (therefore low risk of amblyopia) and poor potential for binocular single vision. Other features that might be present in individuals with infantile (constant) esotropia include latent nystagmus or manifest latent nystagmus, dissociated vertical divergence, cyclotropia, abnormal head posture, limited abduction.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031761"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">İnfantil sabit ezotropi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Infantile constant esotropia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031762">
        <obo:IAO_0000115 xml:lang="tr">Uzak sabitlenmede bir ezotropiyanın ve yakın sabitlenmede binoküler tek görüşün mevcut olduğu orta dereceli bir ezotropiya. Sıklıkla myopi ve yaşlanma ile ilişkilidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Mesafe ezotropisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031762"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Uzak sabitlenmede bir ezotropiyanın ve yakın sabitlenmede binoküler tek görüşün mevcut olduğu orta dereceli bir ezotropiya. Sıklıkla myopi ve yaşlanma ile ilişkilidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An intermittent esotropia where binocular single vision is present on near fixation and an esotropia on distance fixation. Often associated with myopia and aging.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031762"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Mesafe ezotropisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Distance esotropia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031763">
        <obo:IAO_0000115 xml:lang="tr">Binoküler tek görüşün ritmik döngüde geniş açılı eksotropiya ile değiştiği ıraksak bir strabismus</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Döngüsel ezotropi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031763"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Binoküler tek görüşün ritmik döngüde geniş açılı eksotropiya ile değiştiği ıraksak bir strabismus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Convergent strabismus in which normal binocular single vision is alternating with large angle esotropia in rhythmic cycle.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031763"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Döngüsel ezotropi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cyclic esotropia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031764">
        <obo:IAO_0000115 xml:lang="tr">Hipermetropik kırılma kusurunun düzeltildiği zaman normal binoküler tek görüşün bütün mesafeler için var olduğu ezotropiya. Ezotropiya düzeltme olmadan yakın ve mesafe uyumu için mevcuttur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tam akomodatif ezotropi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031764"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hipermetropik kırılma kusurunun düzeltildiği zaman normal binoküler tek görüşün bütün mesafeler için var olduğu ezotropiya. Ezotropiya düzeltme olmadan yakın ve mesafe uyumu için mevcuttur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Esotropia in which normal binocular single vision is present for all distances when the hypermetropic refractive error is corrected. Esotropia is present for near and distance on accommodation without correction.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031764"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Tam akomodatif ezotropi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fully accomodative esotropia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031765">
        <obo:IAO_0000115 xml:lang="tr">Sapma açısının kısmi olarak uyum çabası tarafından etkilendiği sabir bir ezotropi formu. Tipik olarak yakında ve mesafede hipermetropik düzeltmeli ezotropiya mevcuttur ve sapma açısı gözlüksüz artar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kısmen uyumsal ezotropi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031765"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sapma açısının kısmi olarak uyum çabası tarafından etkilendiği sabir bir ezotropi formu. Tipik olarak yakında ve mesafede hipermetropik düzeltmeli ezotropiya mevcuttur ve sapma açısı gözlüksüz artar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of constant esotropia in which the angle of deviation is partially affected by accommodative effort. Typically there is esotropia at near and distance with hypermetropic correction and the angle of deviation increases without glasses.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031765"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kısmen uyumsal ezotropi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Partially accomodative esotropia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031766">
        <obo:IAO_0000115 xml:lang="tr">Uzak sabitlenmede var olan binoküler tek görüşlü aralıklı bir ezotropiya fakat yakın sabitlenme için uyumunda ezotropiya. Genellikle hipermetropi ile ilişkilidir fakat hastalar emmetropik ve nadiren myopik olabilir. Yüksek uyumsal yakınsaklık/uyumsallık (AC/A) oranı ile ilişkilidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yakınsama fazlalığı ezotropi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031766"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Uzak sabitlenmede var olan binoküler tek görüşlü aralıklı bir ezotropiya fakat yakın sabitlenme için uyumunda ezotropiya. Genellikle hipermetropi ile ilişkilidir fakat hastalar emmetropik ve nadiren myopik olabilir. Yüksek uyumsal yakınsaklık/uyumsallık (AC/A) oranı ile ilişkilidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An intermittent esotropia with binocular single vision present at distance fixation but esotropia on accommodation for near fixation. Usually associated with hypermetropia but patients can be emmetropic and rarely myopic. Associated with a high accommodative convergence/accommodation (AC/A) ratio.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031766"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Yakınsama fazlalığı ezotropi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Convergence excess esotropia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031767">
        <obo:IAO_0000115 xml:lang="tr">Önceden ekzotropiyaya veya ekzoforiye sahip olan bir hastada ezotropi sabit veya aralıklı olabilir ve genellikle cerrahi aşırı düzeltmeyi takip eder</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ardışık ezotropi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031767"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Önceden ekzotropiyaya veya ekzoforiye sahip olan bir hastada ezotropi sabit veya aralıklı olabilir ve genellikle cerrahi aşırı düzeltmeyi takip eder</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Esotropia in a patient who has previously had exotropia or exophoria; may be constant or intermittent and usually follows surgical overcorrection.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031767"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ardışık ezotropi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Consecutive esotropia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031768">
        <obo:IAO_0000115 xml:lang="tr">Foveaya bitişik alanda bir objenin sabitlenmesi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Parafoveal sabitlenme</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031768"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Foveaya bitişik alanda bir objenin sabitlenmesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fixation of an object in the area adjacent to the fovea.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031768"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Parafoveal sabitlenme</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Parafoveal fixation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031769">
        <obo:IAO_0000115 xml:lang="tr">Retinanın periferik alanında bir objenin sabitlenmesi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Periferik fiksasyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031769"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Retinanın periferik alanında bir objenin sabitlenmesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fixation of an object in a peripheral area of the retina.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031769"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Periferik fiksasyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Peripheral fixation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031770">
        <obo:IAO_0000115 xml:lang="tr">Üst ve alt kapakları arasında mediyal dikey katlantının var olduğu bir epikantus tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Epikantus palpebralis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031770"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Üst ve alt kapakları arasında mediyal dikey katlantının var olduğu bir epikantus tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of epicanthus in which a medial vertical fold is present between upper and lower lids.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031770"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Epikantus palpebralis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Epicanthus palpebralis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031771">
