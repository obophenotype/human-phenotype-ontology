    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007475">
        <obo:IAO_0000115 xml:lang="tr">Ciltte, doğumda veya kısa bir süre sonra jeneralize, eritem, kabarma, erozyon ve soyma ile ortaya çıkaran iktiyoziform bir anormallik. Sonraki aylarda eritem ve kabarcıklanma gelişir ancak hastalar eklem fleksiyon, boyun, el ve ayaklarında özellikle belirgin olan hiperkeratotik skala geliştirmeye devam eder</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Doğuştan büllöz iktiyoziform eritrodermi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007475"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ciltte, doğumda veya kısa bir süre sonra jeneralize, eritem, kabarma, erozyon ve soyma ile ortaya çıkaran iktiyoziform bir anormallik. Sonraki aylarda eritem ve kabarcıklanma gelişir ancak hastalar eklem fleksiyon, boyun, el ve ayaklarında özellikle belirgin olan hiperkeratotik skala geliştirmeye devam eder</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An ichthyosiform abnormality of the skin that presents at birth or shortly thereafter with generalized erythema, blistering, erosions, and peeling. In the subsequent months, erythema and blistering improves but patients go on to develop hyperkeratotic scaling that is especially prominent along the joint flexures, neck, hands and feet.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007475"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Doğuştan büllöz iktiyoziform eritrodermi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Congenital bullous ichthyosiform erythroderma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
