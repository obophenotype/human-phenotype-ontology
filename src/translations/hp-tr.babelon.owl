    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004950">
        <obo:IAO_0000115 xml:lang="tr">Ekstremite kan akışını azaltarak periferik arterlerin daraltılması. Bu özellik, 0.9 daha az ayak bileği-brakiyal indeksi olarak niceliksel olabilir ve klinik olarak claudication olarak tezahür edilebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Periferik arter stenozu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004950"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ekstremite kan akışını azaltarak periferik arterlerin daraltılması. Bu özellik, 0.9 daha az ayak bileği-brakiyal indeksi olarak niceliksel olabilir ve klinik olarak claudication olarak tezahür edilebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Narrowing of peripheral arteries with reduction of blood flow to the limbs. This feature may be quantified as an ankle-brachial index of less than 0.9, and may be manifested clinically as claudication.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
