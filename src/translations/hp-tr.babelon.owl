    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025149">
        <obo:IAO_0000115 xml:lang="tr">Bir zamanlar mevcut olan muskularois propria dokusunun kısmen veya tamamen boşa harcanması (kaybı). Atrofi, miyositlerin belirgin bir vaküol dejenerasyonunu kapsayabilir, kas liflerinin kaybı ve bazı durumlarda bir son derece karakteristik petek fibrosisi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Atrofik müskülaris propria</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025149"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir zamanlar mevcut olan muskularois propria dokusunun kısmen veya tamamen boşa harcanması (kaybı). Atrofi, miyositlerin belirgin bir vaküol dejenerasyonunu kapsayabilir, kas liflerinin kaybı ve bazı durumlarda bir son derece karakteristik petek fibrosisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Partial or complete wasting (loss) of muscularois propria tissue that was once present. The atrophy may involve a marked vacuolar degeneration of myocytes, loss of muscle fibers and some cases a highly characteristic honeycomb fibrosis.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
