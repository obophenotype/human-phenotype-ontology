        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Özel antikor eksikliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired specific antibody response</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012476">
        <obo:IAO_0000115 xml:lang="tr">Pnömokoklara karşı yönlendirilen spesifik immünoglobülin eksikliği ile normal toplam immünoglobülin seviyelerinin varlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Özel pnömokok antikor eksikliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012476"/>
