    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011895">
        <obo:IAO_0000115 xml:lang="tr">Periferik dolaşımdaki kırmızı kan hücrelerinin ortalama yaşam ömründe ki normalde yaklaşık 120 gündür, bir azalma ile ilişkili bir anemi tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kısalmış kırmızı hücre ömrüne bağlı anemi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
