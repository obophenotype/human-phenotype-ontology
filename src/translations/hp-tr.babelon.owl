        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A functional motor deficit where individuals whose responses to the challenges of exercise fail to achieve levels considered normal for their age and gender.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
