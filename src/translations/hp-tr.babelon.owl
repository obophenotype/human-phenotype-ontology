        <babelon:source_value>Postductal coarctation of the aorta</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011648">
        <obo:IAO_0000115 xml:lang="tr">37 hafta veya üzeri gebelik haftası tamamlandıktan sonra doğum olduğunda postnatal hayatta duktus arteriozusun anormal kalıcı açıklığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Termde doğumdan sonra patent duktus arteriozus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011648"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">37 hafta veya üzeri gebelik haftası tamamlandıktan sonra doğum olduğunda postnatal hayatta duktus arteriozusun anormal kalıcı açıklığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal persistent patency of the ductus arteriosus in postnatal life when birth was at 37 completed weeks of gestation or greater.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
