    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010021">
        <obo:IAO_0000115 xml:lang="tr">1. metakarpallerin epifizleri fildişi gibi sert ve yoğundur. Bunun gibi bir epifiz, radyograflarda tek tip yoğunluklu bir görünüme sahiptir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">1. metakarpalın fildişi epifizi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010021"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">1. metakarpallerin epifizleri fildişi gibi sert ve yoğundur. Bunun gibi bir epifiz, radyograflarda tek tip yoğunluklu bir görünüme sahiptir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The epiphysis of the 1st metacarpal appears hard and dense like ivory. An ivory epiphysis has a uniformly dense appearance on radiographs.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
