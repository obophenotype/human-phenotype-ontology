        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000309">
        <obo:IAO_0000115 xml:lang="tr">Orta yüz anomalisi anatomik bir terim değil bir bölgedir. Yukarıda alt orbital sınırdan aşağıda burun temeline kadar uzanmaktadır. Maksilla (üst çene), zigoma, yanaklar ve malar bölge tarafından oluşturulmaktadır. Geleneksel olarak, burun ve premaksilla orta yüzde yer almamaktadır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ortayüz anormalliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000309"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Orta yüz anomalisi anatomik bir terim değil bir bölgedir. Yukarıda alt orbital sınırdan aşağıda burun temeline kadar uzanmaktadır. Maksilla (üst çene), zigoma, yanaklar ve malar bölge tarafından oluşturulmaktadır. Geleneksel olarak, burun ve premaksilla orta yüzde yer almamaktadır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly of the midface, which is a region and not an anatomical term. It extends, superiorly, from the inferior orbital margin to, inferiorly, the level of nasal base. It is formed by the maxilla (upper jaw) and zygoma and cheeks and malar region. Traditionally, the nose and premaxilla are not included in the midface.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000309"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ortayüz anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal midface morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000311">
        <obo:IAO_0000115 xml:lang="tr">Önden bakıldığında yüz görünümü alışıldığından daha yuvarlaktır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yuvarlak yüz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
