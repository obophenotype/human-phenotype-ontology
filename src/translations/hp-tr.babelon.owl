    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025229"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Baş dönmesi, soğuk ısı, postürel değişiklikler veya dönen sandalye dahil vestibüler stimülasyon ile provoke edilen veya ortaya çıkarılan bir bulgu veya belirti için geçerlidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Applies to a sign or symptom that is provoked or brought about by vestibular stimulation, including head turning, cold calorics, postural changes, or rotating chair.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
