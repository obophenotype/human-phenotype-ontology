    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010458">
        <obo:IAO_0000115 xml:lang="tr">Hermafroditizm gonad morfolojisi ve dış genitalya arasındaki uyumsuzluğa işaret etmektedir. Dişi yalancı hermafroditizminde, genotip dişi (XX) ve gonadlar overlerdir fakat dış genitalya virilize olmuştur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dişi psödohermafroditizmi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010458"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hermafroditizm gonad morfolojisi ve dış genitalya arasındaki uyumsuzluğa işaret etmektedir. Dişi yalancı hermafroditizminde, genotip dişi (XX) ve gonadlar overlerdir fakat dış genitalya virilize olmuştur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hermaphroditism refers to a discrepancy between the morphology of the gonads and that of the external genitalia. In female pseudohermaphroditism, the genotype is female (XX) and the gonads are ovaries, but the external genitalia are virilized.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010458"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Dişi psödohermafroditizmi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Female pseudohermaphroditism</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010459">
        <obo:IAO_0000115 xml:lang="tr">Hem overyen hem de testiküler dokuların aynı veya karşıt gonadlarda varlığı. Etkilenmiş kişiler kuşkulu genitalyaya sahiptir ve 46,XX veya 46,XY karyotipe veya 46,XXX/XY mozaisizmine sahip olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Gerçek hermafroditizm</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010459"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hem overyen hem de testiküler dokuların aynı veya karşıt gonadlarda varlığı. Etkilenmiş kişiler kuşkulu genitalyaya sahiptir ve 46,XX veya 46,XY karyotipe veya 46,XXX/XY mozaisizmine sahip olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of both ovarian and testicular tissues either in the same or in opposite gonads. Affected persons have ambiguous genitalia and may have 46,XX or 46,XY karyotypes or 46,XX/XY mosaicism.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010459"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Gerçek hermafroditizm</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>True hermaphroditism</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
