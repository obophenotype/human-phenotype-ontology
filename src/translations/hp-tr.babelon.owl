        <obo:IAO_0000115 xml:lang="tr">Yaşa bağlı normlara bağlı olarak el başparmağının proksimal falanksının proksimal ucunda yer alan epifizinin anormal küçük boyutu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">El baş parmağının proksimal falanksının küçük epifizi</rdfs:label>
    </rdf:Description>
