        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006608">
        <obo:IAO_0000115 xml:lang="tr">Köprücük kemiği orta bölümünün az gelişmişliği</obo:IAO_0000115>
