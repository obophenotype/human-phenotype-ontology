    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0008202">
        <obo:IAO_0000115 xml:lang="tr">Prolaktin salgılama kabiliyetinde azalma, ön hipofiz bezinde laktotroflar tarafından salgılanan ve meme bezi gelişimini ve süt üretimini uyaran bir protein hormondur</obo:IAO_0000115>
