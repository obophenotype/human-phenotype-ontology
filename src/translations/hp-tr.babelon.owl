    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009270">
        <obo:IAO_0000115 xml:lang="tr">4. parmağın proksimal falanksının epifizinde anormal punktat (benekli, nokta gibi) kalsifikasyonu varlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">4. parmağın proksimal falanksının epifiz beneklenmesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
