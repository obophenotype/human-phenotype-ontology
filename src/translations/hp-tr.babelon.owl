    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010208">
        <obo:IAO_0000115 xml:lang="tr">Ayak baş parmaklarının bir veya birden fazla proksimal falankslarının kemik yoğunluğunda yamalı (düzensiz) artış. Bu, şiddetine ve grafilerde görülebileceği üzere dağılımına bağlı olarak çeşitli formlar alabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ayak parmağı distal falanksının yamalı sklerozu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010208"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ayak baş parmaklarının bir veya birden fazla proksimal falankslarının kemik yoğunluğunda yamalı (düzensiz) artış. Bu, şiddetine ve grafilerde görülebileceği üzere dağılımına bağlı olarak çeşitli formlar alabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Patchy (irregular) increase in bone density of one or more of the proximal phalanges of the toes. This can take on many forms depending on severity and distribution as can be seen on x-rays.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
