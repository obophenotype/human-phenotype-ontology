    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032195">
        <obo:IAO_0000115 xml:lang="tr">QRS dalga kompleksinin üçüncü bileşeni olan S dalgasının herhangi bir anormalisi. S dalgası kalp tabanında son ventrikül depolarizasyonu anlamına gelir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal S dalgası</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032195"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">QRS dalga kompleksinin üçüncü bileşeni olan S dalgasının herhangi bir anormalisi. S dalgası kalp tabanında son ventrikül depolarizasyonu anlamına gelir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any anomaly of the S wave, which is the third component of the QRS wave complex. The S wave signifies the final depolarization of the ventricles at the base of the heart.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
