    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002573">
        <obo:IAO_0000115 xml:lang="tr">Genellikle dışkı içinde veya dışkı ile birlikte, anüsten taze (kırmızı) kan gelmesi. Çoğu rektal kanama kolon, rektum veya anüsten gelir</obo:IAO_0000115>
