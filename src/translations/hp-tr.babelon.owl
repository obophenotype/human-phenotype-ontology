    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025233">
        <obo:IAO_0000115 xml:lang="tr">Saniyelerden dakikalara kadar süren uyku başlangıcında veya uyanmayı takiben vücudu hareket ettirememe</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Uyku felci</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025233"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Saniyelerden dakikalara kadar süren uyku başlangıcında veya uyanmayı takiben vücudu hareket ettirememe</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inability to move trunk and limbs and inability to speak during transition into or out of sleep; awareness is preserved and recall is present.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025233"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Uyku felci</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sleep paralysis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025234">
        <obo:IAO_0000115 xml:lang="tr">Uykuya dalma, uyku veya uyanma esnasında meydana gelen hoş olmayan fiziksel bir olay veya deneyim</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Parasomni</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025234"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Uykuya dalma, uyku veya uyanma esnasında meydana gelen hoş olmayan fiziksel bir olay veya deneyim</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A clinically observable or self-reported abnormal behavior, experience, or physiological event that occurs in association with sleep, specific sleep stages, or sleep-wake transitions.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025234"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Parasomni</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Parasomnia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025235">
        <obo:IAO_0000115 xml:lang="tr">Hızlı olmayan göz hareketleri (NREM) uykusunda meydana gelen bir parasomniya. Bu, yavaş dalgalı uyku (NREM evre 3 uyku) esnasında meydana gelen uyanma hastalığı olarak tanımlanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hızlı olmayan göz hareketi parasomniası</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025235"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hızlı olmayan göz hareketleri (NREM) uykusunda meydana gelen bir parasomniya. Bu, yavaş dalgalı uyku (NREM evre 3 uyku) esnasında meydana gelen uyanma hastalığı olarak tanımlanır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A parasomnia that occurs during non-rapid eye movement (NREM) sleep.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025235"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hızlı olmayan göz hareketi parasomniası</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>NREM parasomnia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025236">
        <obo:IAO_0000115 xml:lang="tr">Uyku halinde yataktan çıkarken oluşan ambulasyon veya diğer kompleks motor hareketleri. Uyurgezerlik sırasında, sonambulasyon yaşayan kişi şaşkın ve kafası karışık görünür, gözleri genellikle açıktır, mırıldanabilir veya sorularınıza uygunsuz cevaplar verebilir ya da bazen heyecanlı görünür</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Somnambulizm</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025236"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Uyku halinde yataktan çıkarken oluşan ambulasyon veya diğer kompleks motor hareketleri. Uyurgezerlik sırasında, sonambulasyon yaşayan kişi şaşkın ve kafası karışık görünür, gözleri genellikle açıktır, mırıldanabilir veya sorularınıza uygunsuz cevaplar verebilir ya da bazen heyecanlı görünür</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ambulation during sleep with lack awareness and limited or no recall of the event.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025236"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Somnambulizm</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sleep walking</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025237">
        <obo:IAO_0000115 xml:lang="tr">Yavaş dalga uykusundan uyanma ya da zorla dışardan uygulanan zorla uyandırılmaların ardından uyuşukluk, sendeleme(bilinçsizlik hali) ve bazen önemli sarsılmalar ile karakterize bir gece atağı.Bu karekterize belirtiler, sersemlik, ağlama veya inleme, yönelim bozukluğu ve özellikle uykudan uyanıklık (yani, uyku ataleti) şeklinde tanımlanabilir. belirtiler süresi genelde 5 ila 15 dk sürer ancak birkaç saatte sürebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Konfüzyonel uyarılma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025237"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Yavaş dalga uykusundan uyanma ya da zorla dışardan uygulanan zorla uyandırılmaların ardından uyuşukluk, sendeleme(bilinçsizlik hali) ve bazen önemli sarsılmalar ile karakterize bir gece atağı.Bu karekterize belirtiler, sersemlik, ağlama veya inleme, yönelim bozukluğu ve özellikle uykudan uyanıklık (yani, uyku ataleti) şeklinde tanımlanabilir. belirtiler süresi genelde 5 ila 15 dk sürer ancak birkaç saatte sürebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A nocturnal episode characterized by disorientation, grogginess, and, at times, substantial agitation upon awakening from slow-wave sleep or following forced awakenings. These characteristics might present as agitation, crying or moaning, disorientation, and particularly slow mentation on arousal from sleep (i.e., sleep inertia). The duration of episodes is typically 5 to 15 min but they might last up to several hours</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025237"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Konfüzyonel uyarılma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>obsolete Confusional arousal</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025238">
        <obo:IAO_0000115 xml:lang="tr">Ayağa lokalize fiziksel rahatsızlık (iğneleme, zonklama veya ağrıma) ile karakterize bir hoşnutsuzluk hissi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ayak ağrısı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025238"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ayağa lokalize fiziksel rahatsızlık (iğneleme, zonklama veya ağrıma) ile karakterize bir hoşnutsuzluk hissi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the foot.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025238"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ayak ağrısı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Foot pain</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025239">
        <obo:IAO_0000115 xml:lang="tr">Kan birikmesi nedeniyle vitrözün retinadan lokalize bir şekilde ayrılması. Maküler bölgede lokalize edilmesi ani görme kaybına neden olur. Subhyaloid premaküler kanama, tipik olarak, iç limitleyici zarın (ILM) alt veya merkezi maküler bölgede veya yakınında ILM ve hiyaloid yüzey sınırında, yuvarlak veya gülle şeklinde parlak kırmızı bir höyük ile karakterizedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Subhyaloid kanama</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025239"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kan birikmesi nedeniyle vitrözün retinadan lokalize bir şekilde ayrılması. Maküler bölgede lokalize edilmesi ani görme kaybına neden olur. Subhyaloid premaküler kanama, tipik olarak, iç limitleyici zarın (ILM) alt veya merkezi maküler bölgede veya yakınında ILM ve hiyaloid yüzey sınırında, yuvarlak veya gülle şeklinde parlak kırmızı bir höyük ile karakterizedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A localized detachment of the vitreous from the retina due to the accumulation of blood. When localized in the macular area, it results in sudden profound loss of vision. Subhyaloid premacular hemorrhage is typically characterized by a circumscribed, round or dumb-bell shaped, bright red mound of blood beneath the internal limiting membrane (ILM) or between the ILM and hyaloid face, in or near to the central macular area</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025239"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Subhyaloid kanama</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>obsolete Subhyaloid hemorrhage</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025240">
        <obo:IAO_0000115 xml:lang="tr">Retinanın iç sınırlayıcı membranı (LIM) arkasında ve sinir lif katmanı (NFL) önünde yer alan bir kan birikimi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Preretinal kanama</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025240"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Retinanın iç sınırlayıcı membranı (LIM) arkasında ve sinir lif katmanı (NFL) önünde yer alan bir kan birikimi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An accumulation of blood that is located between the retina and the detached posterior hyaloid, or in the vitreous cavity. Subhyaloid premacular hemorrhage is typically characterized by a circumscribed, round or dumb-bell shaped, bright red mound of blood beneath the internal limiting membrane (ILM) or between the ILM and hyaloid face, in or near to the central macular area.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025240"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Preretinal kanama</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Preretinal hemorrhage</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025241">
        <obo:IAO_0000115 xml:lang="tr">Retinanın sinir lif katmanı (NFL) içinde yer alan ve NFL (gangliyon hücrelerinin aksonları) yapılarının kısıtlanmasından kaynaklanan karakteristik alev şekli sergileyen bir retinal hemoraji tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Alev şekilli retinal kanama</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025241"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Retinanın sinir lif katmanı (NFL) içinde yer alan ve NFL (gangliyon hücrelerinin aksonları) yapılarının kısıtlanmasından kaynaklanan karakteristik alev şekli sergileyen bir retinal hemoraji tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of retinal hemorrhage that is located within the nerve fiber layer (NFL) of the retina and that exhibits a characteristic flame shape which results from constraints by the structure of the NFL (axons of the ganglion cells).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025241"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Alev şekilli retinal kanama</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Flame-shaped retinal hemorrhage</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025242">
        <obo:IAO_0000115 xml:lang="tr">Retinanın iç nükleer ve dış pleksiform tabakalarında kanın toplanması, ve nokta benzeri veya leke benzeri bir şekle sahip olmasıdır. intraretinal sıkıştırmada şekil sonuçları, belirli bir konum içinde kanamaların sınırlandırılması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Nokta ve leke retinal kanaması</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025242"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Retinanın iç nükleer ve dış pleksiform tabakalarında kanın toplanması, ve nokta benzeri veya leke benzeri bir şekle sahip olmasıdır. intraretinal sıkıştırmada şekil sonuçları, belirli bir konum içinde kanamaların sınırlandırılması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Accumulation of blood located in the retina&apos;s inner nuclear and outer plexiform layers, and having a dot-like or blot-like shape. THe shape results from intraretinal compression, restricting the hemorrhages within a specific location.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025242"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Nokta ve leke retinal kanaması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dot-and-blot retinal hemorrhage</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025243">
        <obo:IAO_0000115 xml:lang="tr">Nöroduysal retina ve retianl pigment arasındaki boşlukta nöroduysal retinanın altında yerleşmiş kan birikimi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Subretinal kanama</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025243"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Nöroduysal retina ve retianl pigment arasındaki boşlukta nöroduysal retinanın altında yerleşmiş kan birikimi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Accumulation of blood located beneath the neurosensory retina in the space between the neurosensory retina and the retinal pigment epithelium.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025243"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Subretinal kanama</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Subretinal hemorrhage</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025244">
        <obo:IAO_0000115 xml:lang="tr">Retinal pigment epiteli (RPE) ve Bruch membranı arasında yer alan bir kan birikimi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Subretinal pigment epitel kanaması</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025244"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Retinal pigment epiteli (RPE) ve Bruch membranı arasında yer alan bir kan birikimi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An accumulation of blood located between the retinal pigment epithelium (RPE) and Bruch membrane.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025244"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Subretinal pigment epitel kanaması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sub-retinal pigment epithelium haemorrhage</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025245">
        <obo:IAO_0000115 xml:lang="tr">Deri içine yerleştirilen çukur kitle, epitel kaplı bir duvarla çevrelenmiş ve bitişik dokudan iyi bir şekilde ayrılmıştır. Kistlerin sıklıkla kese şeklinde olduğu söylenir ve seröz sıvı veya yarı katı materyal içerebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kutanöz kist</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025245"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Deri içine yerleştirilen çukur kitle, epitel kaplı bir duvarla çevrelenmiş ve bitişik dokudan iyi bir şekilde ayrılmıştır. Kistlerin sıklıkla kese şeklinde olduğu söylenir ve seröz sıvı veya yarı katı materyal içerebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A hollow mass located in the skin that is surrounded by an epithelium-lined wall and is well demarcated from the adjacent tissue. Cysts are often said to be sac-like and may contain serous liquid or semisolid material.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025245"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kutanöz kist</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cutaneous cyst</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025246">
        <obo:IAO_0000115 xml:lang="tr">Çapı 0.5-5 cm olan yuvarlak ve sağlam, ancak hafif sıkışabilir, intradermal veya subkütan kist. Trikilemmal kistler doğuştan yerine sonradan kazanılır, ve yüz yerine kafa derisi üzerinde görünmek için yatkındır, ve subkutanöz olmak yerine intradermal olur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Trişilemmal kist</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025246"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çapı 0.5-5 cm olan yuvarlak ve sağlam, ancak hafif sıkışabilir, intradermal veya subkütan kist. Trikilemmal kistler doğuştan yerine sonradan kazanılır, ve yüz yerine kafa derisi üzerinde görünmek için yatkındır, ve subkutanöz olmak yerine intradermal olur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nontender, round and firm, but slightly compressible, intradermal or subcutaneous cyst measuring 0.5-5 cm in diameter. Trichilemmal cysts are acquired rather than congenital, and tend to appear on the scalp rather than the face, and to be intradermal rather than subcutaneous.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025246"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Trişilemmal kist</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Trichilemmal cyst</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025247">
        <obo:IAO_0000115 xml:lang="tr">Embriyonik füzyon çizgileri boyunca derinin hapsedilmesinden ortaya çıkan konjenital bir subkütan kist. Epidermal kistlerin aksine, dermoid kistler saç, sebase, ekrin veya apokrin bezler gibi çeşitli adneksiyal yapıları içerir. Dermoid kistler doğumda bulunurlar ve ağrısız, sağlam, derin, subkutanöz nodüllerdir. Genellikle baş ve boyun bölgesinde bulunurlar ve nadiren anogenital bölgede bulunurlar. Dermoid kistler yavaşça progresiftir ve 1 ila 4 cm boyutlarında büyüyebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dermoid kist</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025247"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Embriyonik füzyon çizgileri boyunca derinin hapsedilmesinden ortaya çıkan konjenital bir subkütan kist. Epidermal kistlerin aksine, dermoid kistler saç, sebase, ekrin veya apokrin bezler gibi çeşitli adneksiyal yapıları içerir. Dermoid kistler doğumda bulunurlar ve ağrısız, sağlam, derin, subkutanöz nodüllerdir. Genellikle baş ve boyun bölgesinde bulunurlar ve nadiren anogenital bölgede bulunurlar. Dermoid kistler yavaşça progresiftir ve 1 ila 4 cm boyutlarında büyüyebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A congenital subcutaneous cyst that arises from entrapment of skin along the lines of embryonic fusion. In contrast to epidermal cysts, dermoid cysts tend to contain various adnexal structures such as hair, sebaceous, eccrine or apocrine glands. Dermoid cysts are present at birth, and are indolent, firm, deep, subcutaneous nodules. They are often located on the head and neck, and rarely in the anogenital area. Dermoid cysts are slowly progressive and can grow to a size of 1 to 4 cm.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025247"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Dermoid kist</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dermoid cyst</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025248">
        <obo:IAO_0000115 xml:lang="tr">Küçük (bir veya iki milimetre çapında) ve ağrısız, genellikle deri renginde fakat kırmızımsı veya kahverengimsi renge sahip olabilen foliküler papül olarak beliren bir kutanöz bir kist</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Erüptif vellüz kıl kisti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025248"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Küçük (bir veya iki milimetre çapında) ve ağrısız, genellikle deri renginde fakat kırmızımsı veya kahverengimsi renge sahip olabilen foliküler papül olarak beliren bir kutanöz bir kist</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cutaneous cyst that is small (one or two millimeters in diameter) and painless, presenting as a follicular papule that usually is skin colored but may have a reddish or brownish tinge.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025248"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Erüptif vellüz kıl kisti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Eruptive vellus hair cyst</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025249">
        <obo:IAO_0000115 xml:lang="tr">Tıkanmış sebum salgılayan (genellikle kıl folükülü içine) bir deri bezi olan deri sebasöz folikülü</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Komedon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025249"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Tıkanmış sebum salgılayan (genellikle kıl folükülü içine) bir deri bezi olan deri sebasöz folikülü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A clogged cutaneous sebaceous follicle, which is a cutaneous gland that secretes sebum (usually into a hair follicle).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025249"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Komedon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Comedo</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025250">
        <obo:IAO_0000115 xml:lang="tr">Boşluğun ucunda açılmayan ve bu nedenle tıkalı kısmı (siyah olarak gözükecekti) ortaya çıkarmayan dolayısıyla beyaz baş adını alan bir komedo</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kapalı komedon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025250"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Boşluğun ucunda açılmayan ve bu nedenle tıkalı kısmı (siyah olarak gözükecekti) ortaya çıkarmayan dolayısıyla beyaz baş adını alan bir komedo</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A comedo in which the top of the pore is not stretched open and thus does not expose the clogged portion (which would appear black), hence the name whitehead.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025250"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kapalı komedon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Closed comedo</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025251">
        <obo:IAO_0000115 xml:lang="tr">Deri yüzeyinde boşluğun bir kısmının gerilerek açıldığı, komedonun içeriğini ortaya çıkaran, siyah görünen bir komedo</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Açık komedon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025251"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Deri yüzeyinde boşluğun bir kısmının gerilerek açıldığı, komedonun içeriğini ortaya çıkaran, siyah görünen bir komedo</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A comedo in which the part of the pore at the surface of the skin is stretched and open, exposing the contents of the comedo, which appear black.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
