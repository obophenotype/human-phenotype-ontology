        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Dil yüzeyinde ve/veya kenarında düzensiz yüzey sathı oluşturan birden fazla girinti ve/veya çıkıntı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
