        <owl:annotatedTarget xml:lang="tr">Antidromik atriyoventriküler yeniden giriş taşikardisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Antidromic atrioventricular reentrant tachycardia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031675">
        <obo:IAO_0000115 xml:lang="tr">Sağ demet dal bloğu (RBBB) ve elektrokardiyogramda (EKG) sol aks sapması (LAD) ile karakterize bir ventriküler taşikardi (VT)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fasiküler sol ventriküler taşikardi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031675"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sağ demet dal bloğu (RBBB) ve elektrokardiyogramda (EKG) sol aks sapması (LAD) ile karakterize bir ventriküler taşikardi (VT)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A ventricular tachycardia (VT) characterized by right bundle branch block (RBBB) and left axis deviation (LAD) on electrocardiogram (ECG).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
