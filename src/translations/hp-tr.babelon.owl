    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000580">
        <obo:IAO_0000115 xml:lang="tr">Pigment birikimiyle karakterize bir retina anormalliği. Tipik olarak makrofajların veya retinal pigment epitelyal hücrelerinin retinaya migrasyonu ve proliferasyonuyla ilişkilidir; bu hücrelerden olan melanin pigmenter değişimlere neden olur. Pigmenter retinopati birçok retinal durumun ortak nihai yoludur ve çoğunlukla görme kaybıyla ilişkilidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Pigmenter retinopati</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000580"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Pigment birikimiyle karakterize bir retina anormalliği. Tipik olarak makrofajların veya retinal pigment epitelyal hücrelerinin retinaya migrasyonu ve proliferasyonuyla ilişkilidir; bu hücrelerden olan melanin pigmenter değişimlere neden olur. Pigmenter retinopati birçok retinal durumun ortak nihai yoludur ve çoğunlukla görme kaybıyla ilişkilidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the retina characterized by pigment deposition. It is typically associated with migration and proliferation of macrophages or retinal pigment epithelial cells into the retina; melanin from these cells causes the pigmentary changes. Pigmentary retinopathy is a common final pathway of many retinal conditions and is often associated with visual loss.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000580"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Pigmenter retinopati</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pigmentary retinopathy</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000581">
        <obo:IAO_0000115 xml:lang="tr">Üst ve alt göz kapakları arasındaki dikey mesafede kısa palpebral fissür ile birlikte sabit bir azalma</obo:IAO_0000115>
