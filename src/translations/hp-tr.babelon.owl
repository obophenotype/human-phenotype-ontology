    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010529">
        <obo:IAO_0000115 xml:lang="tr">Diğer bir insan tarafından yapılan seslendirmeleri tekrar etme eğilimi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ekolali</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010529"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Diğer bir insan tarafından yapılan seslendirmeleri tekrar etme eğilimi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Echolalia is the automatic imitative repetition of sounds, words, or phrases in the absence of explicit awareness. The repeated words or phrases are typically odd or used in a non-social manner. These can be words or phrases that the affected individual has heard or invented.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010529"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ekolali</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Echolalia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010530">
        <obo:IAO_0000115 xml:lang="tr">Palatal myoklonus, yumuşak damağın myoklonik (ritmik istemsiz salınımlar) hareketleri ile karakterizedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Palatal myoklonus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010530"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Palatal myoklonus, yumuşak damağın myoklonik (ritmik istemsiz salınımlar) hareketleri ile karakterizedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Palatal tremor (PT) is an involuntary, rhythmic and oscillatory movement of the soft palate. PT is a rare type of tremor involving the soft palate. It can be unilateral or bilateral.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010530"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Palatal myoklonus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Palatal tremor</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010531">
        <obo:IAO_0000115 xml:lang="tr">Spinal miyoklonus genellikle omuriliğin tümörü, enfeksiyonu, yaralanması veya dejeneratif sürecinden kaynaklanır ve genellikle saniyede birden fazla oranda görülen istemsiz ritmik kas kontraksiyonları ile karakterize edilir. Miyoklonus birçok kasda eşzamanlı olarak oluşur ve yorgunluk veya stres ile şiddeti ve sıklığı artabilir ancak genellikle duyusal uyaranlardan etkilenmez. Spinal miyoklonus uyku veya anestezi sırasında kesilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Spinal myoklonus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010531"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Spinal miyoklonus genellikle omuriliğin tümörü, enfeksiyonu, yaralanması veya dejeneratif sürecinden kaynaklanır ve genellikle saniyede birden fazla oranda görülen istemsiz ritmik kas kontraksiyonları ile karakterize edilir. Miyoklonus birçok kasda eşzamanlı olarak oluşur ve yorgunluk veya stres ile şiddeti ve sıklığı artabilir ancak genellikle duyusal uyaranlardan etkilenmez. Spinal miyoklonus uyku veya anestezi sırasında kesilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Spinal myoclonus is generally due to a tumor, infection, injury, or degenerative process of the spinal cord, and is characterized by involuntary rhythmic muscle contractions, usually at a rate of more than one per second. Myoclonus occurs synchronously in several muscles and can be increased in severity and frequency by fatigue or stress, but is usually unaffected by sensory stimuli. Spinal myoclonus ceases during sleep or anesthesia.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010531"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Spinal myoklonus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Spinal myoclonus</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
