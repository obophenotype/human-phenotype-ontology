    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030467">
        <obo:IAO_0000115 xml:lang="tr">Patternli görsel uyaranlara sabit ortalama parlaklıkta -tipik olarak kontrastı ızgaralarda veya dama tahtalarında ters çeviren- kontrast modülasyonuna yanıt olarak elde edilen, karakteristik özellikleri yanıp sönen ışık yayılımına cevabı temel olarak geleneksel ERG&apos;den farklı olan, bir patern elektroretinograma (PERG) anormal tepki</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal elektroretinogram paterni</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030467"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Patternli görsel uyaranlara sabit ortalama parlaklıkta -tipik olarak kontrastı ızgaralarda veya dama tahtalarında ters çeviren- kontrast modülasyonuna yanıt olarak elde edilen, karakteristik özellikleri yanıp sönen ışık yayılımına cevabı temel olarak geleneksel ERG&apos;den farklı olan, bir patern elektroretinograma (PERG) anormal tepki</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomalous response to a pattern electroretinogram (PERG), a particular kind of ERG obtained in response to contrast modulation of patterned visual stimuli at constant mean luminance-typically contrast-reversing gratings or checkerboards-whose characteristics are fundamentally different from those of the traditional ERG in response to diffuse flashes of light.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030467"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal elektroretinogram paterni</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal pattern electroretinogram</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
