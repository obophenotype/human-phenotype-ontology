    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025361">
        <obo:IAO_0000115 xml:lang="tr">Renal korteksin ve papilla olarak adlandırılan dar apeks yanında geniş tabanlı koni şekilli yapılar olan erişkin böbrek piramidinin yapısal bir anomalisi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Medüller piramit anormalliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025361"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Renal korteksin ve papilla olarak adlandırılan dar apeks yanında geniş tabanlı koni şekilli yapılar olan erişkin böbrek piramidinin yapısal bir anomalisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A structural anomaly of the pyramid of the adult kidney, cone-shaped structures with a broad base adjacent to the renal cortex and the narrow apex that is termed papilla.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
