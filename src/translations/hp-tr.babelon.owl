        <owl:annotatedTarget xml:lang="tr">3. parmak distal falanksının epifizinde anormal punktat (benekli, nokta benzeri) kalsifikasyonlar varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
