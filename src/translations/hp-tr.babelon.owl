    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012759">
        <obo:IAO_0000115 xml:lang="tr">Bir çocuğun nörolojik gelişiminin normalden sapması, onun kişisel, sosyal, kaba veya ince motor ve bilişsel yeteneklerin gelişiminin herhangi birini veya tüm yönlerini içerebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Nörogelişimsel anormallik</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012759"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir çocuğun nörolojik gelişiminin normalden sapması, onun kişisel, sosyal, kaba veya ince motor ve bilişsel yeteneklerin gelişiminin herhangi birini veya tüm yönlerini içerebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deviation from normal of the neurological development of a child, which may include any or all of the aspects of the development of personal, social, gross or fine motor, and cognitive abilities.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
