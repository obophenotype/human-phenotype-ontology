    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006988">
        <obo:IAO_0000115 xml:lang="tr">Tek bir ventrikül varlığı ve serebral yarımkürenin ayrılması olmayan, holoprosensefali tipidir. Tek orta hat ventrikülü sık sık büyük ölçüde büyütülür</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Alobar holoprozensefali</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006988"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Tek bir ventrikül varlığı ve serebral yarımkürenin ayrılması olmayan, holoprosensefali tipidir. Tek orta hat ventrikülü sık sık büyük ölçüde büyütülür</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of holoprosencephaly characterized by the presence of a single ventricle and no separation of the cerebral hemisphere. The single midline ventricle is often greatly enlarged.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
