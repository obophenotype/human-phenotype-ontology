    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0008798">
        <obo:IAO_0000115 xml:lang="tr">Kemik pelvisteki sakroiliyak eklem güçlü ligamanlarla bağlanmış olan sakrum ve ilium kemiklerini birbirine bağlar. Çentik direk eklemin üst kısmında lokalizedir. Bu terim çentiğin lateral ebatında artış anlamına gelir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Genişlemiş sakroiskiyatik çentik</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
