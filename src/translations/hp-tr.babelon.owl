        <owl:annotatedTarget xml:lang="tr">Sarkolemma (kas hücre zarı) bitişik olan sitoplazmada, mitokondrianın anormal bir morfolojiye sahip olduğu anormal şekilde artmış bir mitokondri sayısı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormally increased number of mitochondria in the cytoplasma adjacent to the sarcolemma (muscle cell membrane), whereby the mitochondria also possess an abnormal morphology.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
