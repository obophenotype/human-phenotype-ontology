    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030817">
        <obo:IAO_0000115 xml:lang="tr">Şiddetli tırnak eğriliği, tırnağın ucunun parmağın eksenine göre aşağıya doğru gitmesine neden olur. Sivrilmiş tırnaklar, uzak parmağın rezorpsiyonundan kaynaklanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Gagalı tırnaklar</rdfs:label>
