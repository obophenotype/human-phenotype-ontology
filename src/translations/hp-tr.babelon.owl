    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002204">
        <obo:IAO_0000115 xml:lang="tr">Emboli (kan dolaşımındaki anormal partikül) akciğer atardamarında konumlanmış ve dolayısı ile akciğerde ki kan dolaşımını tıkamıştır. Genellikle emboli akciğer atardamarında sıkışmadan önce bir uçta (örneğin derin ven trombozu), bağımsız ve dolaşımda hareket ederek gelişen bir kan pıhtısıdır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Pulmoner emboli</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002204"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Emboli (kan dolaşımındaki anormal partikül) akciğer atardamarında konumlanmış ve dolayısı ile akciğerde ki kan dolaşımını tıkamıştır. Genellikle emboli akciğer atardamarında sıkışmadan önce bir uçta (örneğin derin ven trombozu), bağımsız ve dolaşımda hareket ederek gelişen bir kan pıhtısıdır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An embolus (that is, an abnormal particle circulating in the blood) located in the pulmonary artery and thereby blocking blood circulation to the lung. Usually the embolus is a blood clot that has developed in an extremity (for instance, a deep venous thrombosis), detached, and traveled through the circulation before becoming trapped in the pulmonary artery.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002204"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Pulmoner emboli</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pulmonary embolism</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002205">
        <obo:IAO_0000115 xml:lang="tr">Tekrarlayan solunum yolu enfeksiyonları öyküsü ile kendini gösteren solunum yolu enfeksiyonlarına artmış bir duyarlılık</obo:IAO_0000115>
