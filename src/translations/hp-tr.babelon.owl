    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002304"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Faaliyette veya harekette değişiklik başlatamama ve sıradan istemli hareketleri hızlı ve kolay bir şekilde yerine getirememe</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
