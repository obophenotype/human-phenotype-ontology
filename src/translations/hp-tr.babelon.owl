        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032141">
        <obo:IAO_0000115 xml:lang="tr">Sıklıkla zonklama, saplanma veya yanma olarak tarif edilen ve saatler veya daha uzun süren sol memede veya altında oluşan bir tip göğüs ağrısı. Ağrı efor ile veya sonra oluşabilir ve sol kola veya boynun sol tarafına yayılabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Prekordiyal ağrı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032141"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sıklıkla zonklama, saplanma veya yanma olarak tarif edilen ve saatler veya daha uzun süren sol memede veya altında oluşan bir tip göğüs ağrısı. Ağrı efor ile veya sonra oluşabilir ve sol kola veya boynun sol tarafına yayılabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of chest pain that arises in the or under the left breast and often described as throbbing, stabbing, or burning, and lasting hours or longer. The pain may arise with or after effort, and may spread to the left arm or left side of the neck.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032141"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Prekordiyal ağrı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Precordial pain</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032142">
        <obo:IAO_0000115 xml:lang="tr">Fetor hepatikus ciddi parenkimal karaciğer hastalıklı hastaların çürümüş yumurta ve sarmısak karışımı bir kokuyu andırdığı söylenen karakteristik nefesidir</obo:IAO_0000115>
