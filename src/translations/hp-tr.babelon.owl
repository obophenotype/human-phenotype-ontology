    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025480">
        <obo:IAO_0000115 xml:lang="tr">Lipomatöz doku ile ilişkili ve deri ile kapatılan bir spinal defekt olan deri altı yağ kitlesi olarak ortaya çıkan bir spinal disrafizm tipi. En olağan lipomyelomeningosel yerleşkesi gluteal yarıktadır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Lipomyelomeningosel</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025480"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Lipomatöz doku ile ilişkili ve deri ile kapatılan bir spinal defekt olan deri altı yağ kitlesi olarak ortaya çıkan bir spinal disrafizm tipi. En olağan lipomyelomeningosel yerleşkesi gluteal yarıktadır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of spinal dysraphism presenting as a subcutaneous fatty mass, that is, a spinal defect associated with lipomatous tissue, and covered by skin. The most usual location for lipomyelomeningocele is at the gluteal cleft.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025480"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Lipomyelomeningosel</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lipomyelomeningocele</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
