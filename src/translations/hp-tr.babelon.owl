        <obo:IAO_0000115 xml:lang="tr">Ani beklenmedik bir görsel veya akustik uyarıya veya yüz yakınındaki hızlı bir harekete yanıt olarak abartılı bir irkilme reaksiyonu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Abartılı irkilme tepkisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002267"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ani beklenmedik bir görsel veya akustik uyarıya veya yüz yakınındaki hızlı bir harekete yanıt olarak abartılı bir irkilme reaksiyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An exaggerated startle reaction in response to a sudden unexpected visual or acoustic stimulus, or a quick movement near the face.</babelon:source_value>
