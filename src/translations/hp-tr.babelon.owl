        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypertonia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001278">
        <obo:IAO_0000115 xml:lang="tr">Bir kişinin ayakta olduğu varsayıldığında kan basıncında ani bir düşüş ile karakterize bir hipotansiyon formu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ortostatik hipotansiyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001278"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir kişinin ayakta olduğu varsayıldığında kan basıncında ani bir düşüş ile karakterize bir hipotansiyon formu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of hypotension characterized by a sudden fall in blood pressure that occurs when a person assumes a standing position.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001278"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ortostatik hipotansiyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Orthostatic hypotension</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001279">
        <obo:IAO_0000115 xml:lang="tr">Senkop, duruş tonusunun kaybı, ayakta duramama ve bilinç kaybı ile genel bir zayıflığa denmektedir. Hasta yatay pozisyona geldiğinde, beyine olan kan akışı daha fazla yer çekimi ile engellenmez ve bilinç geri kazanılır. Bilinçsizlik sıklıkla saniyeler ya da dakikalar içinde sonlanır. Baş ağrısı ve sersemlik (genellikle nöbeti takip eder) senkop atağını takip etmez. Senkop serebral kan akışının azalmasına bağlı olarak beyin metabolizmasının ani bozulması ile meydana gelir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Senkop</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001279"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Senkop, duruş tonusunun kaybı, ayakta duramama ve bilinç kaybı ile genel bir zayıflığa denmektedir. Hasta yatay pozisyona geldiğinde, beyine olan kan akışı daha fazla yer çekimi ile engellenmez ve bilinç geri kazanılır. Bilinçsizlik sıklıkla saniyeler ya da dakikalar içinde sonlanır. Baş ağrısı ve sersemlik (genellikle nöbeti takip eder) senkop atağını takip etmez. Senkop serebral kan akışının azalmasına bağlı olarak beyin metabolizmasının ani bozulması ile meydana gelir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A transient loss of consciousness (i.e., characterized by a rapid onset, a short duration, and a spontaneous and complete recovery) due to cerebral hypoperfusion.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001279"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Senkop</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Syncope</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001281">
        <obo:IAO_0000115 xml:lang="tr">Hipokalsemi veya bazen magnezyum eksikliği ile ilişkili aralıklı istemsiz kas kasılması (spazm) ile karakterize bir durum</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tetani</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001281"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hipokalsemi veya bazen magnezyum eksikliği ile ilişkili aralıklı istemsiz kas kasılması (spazm) ile karakterize bir durum</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A condition characterized by intermittent involuntary contraction of muscles (spasms) related to hypocalcemia or occasionally magnesium deficiency.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001281"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Tetani</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tetany</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001283">
        <obo:IAO_0000115 xml:lang="tr">Bulbar zayıflık (veya bulbar felç) medulladaki çekirdek veya fasiküler seviyedeki veya beyin sapı dışındaki aşağı kraniyal sinirlerin iki taraflı aşağı motor nöron lezyonuna bağlı olarak oluşan aşağı kraniyal sinirleri IX, X, XI ve XII&apos;nin iki taraflı fonksiyon bozukluğuna denir. Bulbar zayıflık sıklıkla çiğnemede güçlük, yüz kaslarının zayıflığı, disartri, damak zayıflığı ve sıvı geri kaçışı, disfaji ve disfoni ile ilişkilidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Bulbar felç</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001283"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bulbar zayıflık (veya bulbar felç) medulladaki çekirdek veya fasiküler seviyedeki veya beyin sapı dışındaki aşağı kraniyal sinirlerin iki taraflı aşağı motor nöron lezyonuna bağlı olarak oluşan aşağı kraniyal sinirleri IX, X, XI ve XII&apos;nin iki taraflı fonksiyon bozukluğuna denir. Bulbar zayıflık sıklıkla çiğnemede güçlük, yüz kaslarının zayıflığı, disartri, damak zayıflığı ve sıvı geri kaçışı, disfaji ve disfoni ile ilişkilidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bulbar weakness (or bulbar palsy) refers to bilateral impairment of function of the lower cranial nerves IX, X, XI and XII, which occurs due to lower motor neuron lesion either at nuclear or fascicular level in the medulla or from bilateral lesions of the lower cranial nerves outside the brain-stem. Bulbar weakness is often associated with difficulty in chewing, weakness of the facial muscles, dysarthria, palatal weakness and regurgitation of fluids, dysphagia, and dysphonia.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001283"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Bulbar felç</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bulbar palsy</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001284">
