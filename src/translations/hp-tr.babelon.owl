    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007002">
        <obo:IAO_0000115 xml:lang="tr">Kas güçsüzlüğü, atrofi ve kramplarla motor aksonların işlevinin progresif olarak bozulması. Eksiklik uzunluğa bağlıdır, yani en uzun sinirlerin innerve ettiği kaslar önce etkilenir, böylece örneğin kollar, alt bacaktaki eksiklik başlangıcından daha geç yaşta etkilenir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Motor aksonal nöropati</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kas güçsüzlüğü, atrofi ve kramplarla motor aksonların işlevinin progresif olarak bozulması. Eksiklik uzunluğa bağlıdır, yani en uzun sinirlerin innerve ettiği kaslar önce etkilenir, böylece örneğin kollar, alt bacaktaki eksiklik başlangıcından daha geç yaşta etkilenir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Progressive impairment of function of motor axons with muscle weakness, atrophy, and cramps. The deficits are length-dependent, meaning that muscles innervated by the longest nerves are affected first, so that for instance the arms are affected at a later age than the onset of deficits involving the lower leg.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007002"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Motor aksonal nöropati</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Motor axonal neuropathy</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
