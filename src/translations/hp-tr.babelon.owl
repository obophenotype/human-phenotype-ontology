        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010862">
        <obo:IAO_0000115 xml:lang="tr">Parmakları ve eli kontrol etme yeteneği kazanmada gecikme ile karakterize bir motor gecikme itipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Gecikmiş ince motor gelişim</rdfs:label>
