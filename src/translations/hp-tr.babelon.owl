        <owl:annotatedTarget xml:lang="tr">Anormal olarak belirgin heliks krusu varlığı. Bu, krus heliksin ortalama bir antiheliks kök veya heliks ile aynı dereceye gelişmesidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
