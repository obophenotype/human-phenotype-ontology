    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010853">
        <obo:IAO_0000115 xml:lang="tr">Periyodik lateralize epileptiform boşalımlar (PLED) periyodik, lateralize ve epileptiformdur. PLED&apos;ler boşalımlar arasında göreceli sabit bir aralık (0.5 - 3 saniye) gösterirler</obo:IAO_0000115>
