    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0008138">
        <obo:IAO_0000115 xml:lang="tr">Kalkaneusun tibia uzunlamasına olan eksenine göre anormal plantar fleksiyonu. Bu, tibia&apos;nın uzun ekseni ile topuk kemiğinin uzunlamasına ekseni (kalkaneus) arasındaki açının 90 dereceden daha çok olmasına sebep olur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ekinus kalkaneus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0008138"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kalkaneusun tibia uzunlamasına olan eksenine göre anormal plantar fleksiyonu. Bu, tibia&apos;nın uzun ekseni ile topuk kemiğinin uzunlamasına ekseni (kalkaneus) arasındaki açının 90 dereceden daha çok olmasına sebep olur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal plantar flexion of the calcaneus relative to the longitudinal axis of the tibia. This results in the angle between the long axis of the tibia and the long axis of the heel bone (calcaneus) being greater than 90 degrees.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
