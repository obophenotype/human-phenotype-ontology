    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005165">
        <obo:IAO_0000115 xml:lang="tr">PR intervali için kısalmış zaman (P dalgasının başlangıcından QRS kompleksinin başlangıcına kadar). Erişkinlerde normal değer 120 ile 200 ms uzunluğundadır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kısalmış PR aralığı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
