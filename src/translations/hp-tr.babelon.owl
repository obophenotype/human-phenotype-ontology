        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Aşırı aktif peristaller (gastrointestinal sistemin tübüler organlarının kasılması dalgası), gıdanın mideye ve bağırsağa geçmesinin aşırı derecede hızlı olması ile belirgindir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Excessively active peristalsis (wave of contraction of the tubular organs of the gastrointestinal tract) marked by excessive rapidity of the passage of food through the stomach and intestine.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
