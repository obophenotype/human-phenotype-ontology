        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000729">
        <obo:IAO_0000115 xml:lang="tr">Çocuklukta başlayan bir hastalıktır. Sosyal etkileşim ve iletişimde belirgin anormallik veya bozulmuş gelişme varlığı ve belirgin şekilde sınırlı aktivite ve ilgi repertuvarı ile fark edilmektedir. Hastalığın belirtileri gelişimsel seviye ve bireyin kronolojik yaşına göre oldukça değişkenlik göstermektedir (DSM-IV)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Otistik davranış</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000729"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çocuklukta başlayan bir hastalıktır. Sosyal etkileşim ve iletişimde belirgin anormallik veya bozulmuş gelişme varlığı ve belirgin şekilde sınırlı aktivite ve ilgi repertuvarı ile fark edilmektedir. Hastalığın belirtileri gelişimsel seviye ve bireyin kronolojik yaşına göre oldukça değişkenlik göstermektedir (DSM-IV)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Persistent deficits in social interaction and communication and interaction as well as a markedly restricted repertoire of activity and interest as well as repetitive patterns of behavior.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000729"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Otistik davranış</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Autistic behavior</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000732">
        <rdfs:label xml:lang="tr">Rutin veya ritüellere katı bağlılık</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
