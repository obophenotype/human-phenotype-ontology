        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031633">
        <obo:IAO_0000115 xml:lang="tr">Sol subklaviyen arter ve aort arasında patent (PDA) veya patent olmayan duktus arteriyozus ile homolateral pulmoner artere kalıcı bağlantı ile devamlılığın kaybı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sol subklaviyen arterin izolasyonu</rdfs:label>
    </rdf:Description>
