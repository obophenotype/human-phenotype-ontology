    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012063">
        <obo:IAO_0000115 xml:lang="tr">Radyografik özellikleri dilate, radyolusen, tipik olarak kemiğin metafizyel kısmı içinde eksantrik olarak yerleşen, manyetik rezonans görüntülemede sıvı seviyeleri ile olan lezyonu içerir</obo:IAO_0000115>
