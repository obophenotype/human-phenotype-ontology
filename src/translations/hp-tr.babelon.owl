    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031247">
        <obo:IAO_0000115 xml:lang="tr">Hava inhalasyonu tarafından üretilen yüksek perdeli boğmaca sesinin eşlik ettiği uzun soluk alma eforunu takiben çeşitli ve hızlı öksürük patlamaları ile karakterize bir tip öksürük</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Boğmaca öksürüğü</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031247"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hava inhalasyonu tarafından üretilen yüksek perdeli boğmaca sesinin eşlik ettiği uzun soluk alma eforunu takiben çeşitli ve hızlı öksürük patlamaları ile karakterize bir tip öksürük</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of cough characterized by a burst of numerous and rapid coughs followed by a long inhaling effort that is accompanied by a high-pitched whooping sound produced by the inhalation of air.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
