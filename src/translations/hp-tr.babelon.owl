        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012044">
        <obo:IAO_0000115 xml:lang="tr">Tahterevalli nistagmusuö yarım döngünün bir gözün elevasyonunu ve intorsiyonunu eş zamanlı olarak da diğer gözün depresyonunu ve ekstorsiyonunu içerdiği bir pendüler nistagmus tipidir. Döngünün diğer yarısında oküler hareketlerin inversiyonu vardır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tahterevalli nistagmus</rdfs:label>
    </rdf:Description>
