        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410281"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Epigastrik bölgede lokalize olan heterojen bir semptom grubu. Tipik dispeptik semptomlar postprandial dolgunluk, erken doygunluk, epigastrik ağrı ve epigastrik yanmayı içerir, ancak bulantı, geğirme veya abdominal şişkinlik gibi diğer üst gastrointestinal semptomlar sıklıkla ortaya çıkar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A heterogeneous group of symptoms that are localized in the epigastric region. Typical dyspeptic symptoms include postprandial fullness, early satiation, epigastric pain and epigastric burning, but other upper gastrointestinal symptoms such as nausea, belching or abdominal bloating often occur.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410281"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Dispepsi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dyspepsia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
