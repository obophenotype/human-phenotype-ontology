    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0008341">
        <obo:IAO_0000115 xml:lang="tr">Distal nefronun kortikal toplama kanalının alfa interkale hücreleri tarafından asit salınımının başarısız olması ile karakterize renal tübüler asidoz tipidir. İdrar, asidemi ve hipokalemi ile ilişkili olarak, pH 5.3&apos;ün altında asitlendirilemez</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Distal renal tübüler asidoz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0008341"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Distal nefronun kortikal toplama kanalının alfa interkale hücreleri tarafından asit salınımının başarısız olması ile karakterize renal tübüler asidoz tipidir. İdrar, asidemi ve hipokalemi ile ilişkili olarak, pH 5.3&apos;ün altında asitlendirilemez</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of renal tubular acidosis characterized by a failure of acid secretion by the alpha intercalated cells of the cortical collecting duct of the distal nephron. The urine cannot be acidified below a pH of 5.3, associated with acidemia and hypokalemia.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0008341"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Distal renal tübüler asidoz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Distal renal tubular acidosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
