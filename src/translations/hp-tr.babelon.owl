    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007179">
        <obo:IAO_0000115 xml:lang="tr">Tam bir oküler düzgün takip sistemiyle nesneleri takip etme yeteneği eksikliği, retinal hedef hareketini en aza indiren oldukça yavaş göz hareketleri sınıfı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Düzgün takip yok</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007179"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Tam bir oküler düzgün takip sistemiyle nesneleri takip etme yeteneği eksikliği, retinal hedef hareketini en aza indiren oldukça yavaş göz hareketleri sınıfı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A complete lack of the ability to track objects with the ocular smooth pursuit system, a class of rather slow eye movements that minimizes retinal target motion.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
