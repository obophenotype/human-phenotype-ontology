    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000452">
        <obo:IAO_0000115 xml:lang="tr">Koananın (posterior nazal açıklık) anormal darlaşması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Koanal stenoz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000452"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Koananın (posterior nazal açıklık) anormal darlaşması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal narrowing of the choana (the posterior nasal aperture).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
