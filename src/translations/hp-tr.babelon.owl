        <owl:annotatedTarget xml:lang="tr">Kol ve bacaklar, boyun, gövde veya yüz kaslarının istemsiz hareketlerin önde gelen sebebi istemsiz kasılmalarıdır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Involuntary contractions of muscle leading to involuntary movements of extremities, neck, trunk, or face.</babelon:source_value>
