        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011619"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Her iki akciğerin sol akciğer morfolojisinde olduğu sağ ve sol akciğerlerin morfolojik yanlılığı, yani pulmoner situsun bir anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the pulmonary situs, i.e., of the sidedness of the morphological right and left lungs, in which both lungs have the morphology of a left lung.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
