    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007443">
        <obo:IAO_0000115 xml:lang="tr">Çeşitli bölgelerde doğuştan olan ve kalıcı olan melanin pigmenti yokluğu. Lezyonlar ak deri olarak bilinir ve genellikle yüzde, gözdede veya uzuvlarda bulunur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kısmi albinizm</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007443"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çeşitli bölgelerde doğuştan olan ve kalıcı olan melanin pigmenti yokluğu. Lezyonlar ak deri olarak bilinir ve genellikle yüzde, gözdede veya uzuvlarda bulunur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of melanin pigment in various areas, which is found at birth and is permanent. The lesions are known as leucoderma and are often found on the face, trunk, or limbs.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
