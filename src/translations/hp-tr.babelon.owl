        <owl:annotatedTarget xml:lang="tr">EKG&apos;de sinüs ritmi esnasında görünmediği için gizli olarak adlandırılan aksesuvar bağlantı aracılı yolaklı supraventriküler taşikardi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
