        <owl:annotatedTarget xml:lang="tr">Göz kapağı rahatsızlık testi ve/veya göz kapağı çekme testi tarafından ortaya konabilen doku gevşemesi ile ilişkili anormal olarak gevşek göz kapağı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
