    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011620">
        <obo:IAO_0000115 xml:lang="tr">Abdomenin ve organlarının taraflılığı olan abdominal situsun bir anormalliği</obo:IAO_0000115>
