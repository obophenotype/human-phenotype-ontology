    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004736">
        <obo:IAO_0000115 xml:lang="tr">Böbreklerin orta hattın kenarı aynı tarafında kaynaştığı ve lokalize olduğu bir gelişimsel anomali. Bu anomalinin böbreklerin normal embriyolojik yerdeğiştirimin bozulmasından kaynaklandığı düşünülmektedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Çaprazlama kaynaşmış renal ektopi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004736"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Böbreklerin orta hattın kenarı aynı tarafında kaynaştığı ve lokalize olduğu bir gelişimsel anomali. Bu anomalinin böbreklerin normal embriyolojik yerdeğiştirimin bozulmasından kaynaklandığı düşünülmektedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A developmental anomaly in which the kidneys are fused and localized on the same side of the midline. This anomaly is thought to result from disruption of the normal embryologic migration of the kidneys.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
