        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Stroke-like episode</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002403">
        <obo:IAO_0000115 xml:lang="tr">Hasta ayağı beraber yerleştirilir ve dengesi sağlanır ve gözlerini kapatması istenir. Göz kapandıktan sonra bir denge kaybı pozitif bir Romberg işaretidir ve propriyosepsiyonda açığı belirten olarak yorumlanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Pozitif Romberg bulgusu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002403"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hasta ayağı beraber yerleştirilir ve dengesi sağlanır ve gözlerini kapatması istenir. Göz kapandıktan sonra bir denge kaybı pozitif bir Romberg işaretidir ve propriyosepsiyonda açığı belirten olarak yorumlanır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The patient stands with the feet placed together and balance and is asked to close his or her eyes. A loss of balance upon eye closure is a positive Romberg sign and is interpreted as indicating a deficit in proprioception.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
