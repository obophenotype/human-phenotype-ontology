    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004234">
        <obo:IAO_0000115 xml:lang="tr">Kemik içi kemik belirtisi, nispeten normal kemik yoğunluğuna sahip bölgelerde aralıklı olarak ortaya çıkan, artmış skleroz (anormal yoğunluktaki kemik) tarafından üretilen radyolojik bir bulgudur. Bu terim, karpal kemiklerdeki böyle bir bulguyu tanımlamak için kullanılmalıdır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Karpal kemiklerinde kemik görünümü</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004234"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kemik içi kemik belirtisi, nispeten normal kemik yoğunluğuna sahip bölgelerde aralıklı olarak ortaya çıkan, artmış skleroz (anormal yoğunluktaki kemik) tarafından üretilen radyolojik bir bulgudur. Bu terim, karpal kemiklerdeki böyle bir bulguyu tanımlamak için kullanılmalıdır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The bone-in-bone sign is a radiographic finding produced by increased sclerosis (abnormally dense bone) occurring intermittently with zones of relatively normal bone density. This term should be used to describe such a finding in the carpal bones.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
