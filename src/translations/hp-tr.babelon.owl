        <owl:annotatedTarget xml:lang="tr">Bir sütçocuğunda erken kapanma ile birlikte veya olmaksızın kafatası kemik plakaların üst üste gelmesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
