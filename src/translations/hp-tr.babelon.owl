    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000793">
        <obo:IAO_0000115 xml:lang="tr">Diffüz mezangiyal hücre çoğalması ve mezangiyumun subendotelyal genişlemesine bağlı olarak kapiller damar duvarlarının kalınlaşması ile karakterize bir glomerülonefrit tipi. Membranoproliferatif glomerülonefrit terimi sıklıkla tek bir hastalığı tanımlamaktan ziyade, ortak patojenik mekanizmayı paylaşan çeşitli hastalık süreçlerinde gözlenen glomerüler hasarın genel bir paternini ifade etmek için kullanılmaktadır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Membranoproliferatif glomerülonefrit</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000793"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Diffüz mezangiyal hücre çoğalması ve mezangiyumun subendotelyal genişlemesine bağlı olarak kapiller damar duvarlarının kalınlaşması ile karakterize bir glomerülonefrit tipi. Membranoproliferatif glomerülonefrit terimi sıklıkla tek bir hastalığı tanımlamaktan ziyade, ortak patojenik mekanizmayı paylaşan çeşitli hastalık süreçlerinde gözlenen glomerüler hasarın genel bir paternini ifade etmek için kullanılmaktadır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of glomerulonephritis characterized by diffuse mesangial cell proliferation and the thickening of capillary walls due to subendothelial extension of the mesangium. The term membranoproliferative glomerulonephritis is often employed to denote a general pattern of glomerular injury seen in a variety of disease processes that share a common pathogenetic mechanism, rather than to describe a single disease entity</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000793"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Membranoproliferatif glomerülonefrit</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Membranoproliferative glomerulonephritis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
