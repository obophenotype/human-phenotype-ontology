    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007976">
        <obo:IAO_0000115 xml:lang="tr">Cerulean kataraktları, konjenital katarakttır ve merkezi lezyonlar radyal olarak yerleştirilmiştir, konsantrik tabakalarda periferik mavimsi ve beyaz renkte opasifikasyonlar gösterirler. Opaklıklar fetal gelişme ve çocukluk çağında gözlemlenebilmesine rağmen, genellikle görme keskinliği yetişkinliğe kadar genellikle lens ekstraksiyonu gerekli olduğunda az da olsa azaltılabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Serulen katarakt</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007976"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Cerulean kataraktları, konjenital katarakttır ve merkezi lezyonlar radyal olarak yerleştirilmiştir, konsantrik tabakalarda periferik mavimsi ve beyaz renkte opasifikasyonlar gösterirler. Opaklıklar fetal gelişme ve çocukluk çağında gözlemlenebilmesine rağmen, genellikle görme keskinliği yetişkinliğe kadar genellikle lens ekstraksiyonu gerekli olduğunda az da olsa azaltılabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cerulean cataracts are a kind of congenital cataract having peripheral bluish and white opacifications in concentric layers with occasional central lesions arranged radially. Although the opacities may be observed during fetal development and childhood, usually visual acuity is only mildly reduced until adulthood, when lens extraction is generally necessary.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007976"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Serulen katarakt</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cerulean cataract</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
