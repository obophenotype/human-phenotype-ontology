    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012470">
        <obo:IAO_0000115 xml:lang="tr">Küçük çocuklarda oftalmolojik bir belirti, ilerlemiş göz felcinden kaynaklanır. Bu durumda, gözler aşağı doğru sürükleniyormuş gibi görünür, sklera üst göz kapağı ve iris arasında görülebilir, ve göz bebeğinin alt kısmı alt göz kapağı ile kaplanabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Batan güneş göz fenomeni</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012470"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Küçük çocuklarda oftalmolojik bir belirti, ilerlemiş göz felcinden kaynaklanır. Bu durumda, gözler aşağı doğru sürükleniyormuş gibi görünür, sklera üst göz kapağı ve iris arasında görülebilir, ve göz bebeğinin alt kısmı alt göz kapağı ile kaplanabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An ophthalmologic sign in young children resulting from upward-gaze paresis. In this condition, the eyes appear driven downward, the sclera may be seen between the upper eyelid and the iris, and part of the lower pupil may be covered by the lower eyelid.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
