    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000957">
        <obo:IAO_0000115 xml:lang="tr">Cafe-au-lait lekeleri açık kahverengiden koyu kahverengiye değişkenlik gösteren, düzenli kenara sahip, erişkinlerde 1.5 cm veya daha büyük ve çocuklarda 0.5 cm veya daha büyük boyutta olan hiperpigmente lezyonlardır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sütlü kahverengi noktalar</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000957"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Cafe-au-lait lekeleri açık kahverengiden koyu kahverengiye değişkenlik gösteren, düzenli kenara sahip, erişkinlerde 1.5 cm veya daha büyük ve çocuklarda 0.5 cm veya daha büyük boyutta olan hiperpigmente lezyonlardır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cafe-au-lait spots are hyperpigmented lesions that can vary in color from light brown to dark brown with smooth borders and having a size of 1.5 cm or more in adults and 0.5 cm or more in children.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000957"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Sütlü kahverengi noktalar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cafe-au-lait spot</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000958">
        <obo:IAO_0000115 xml:lang="tr">Doğal veya normal nem eksikliği ile karakterize deri</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kuru cilt</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000958"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Doğal veya normal nem eksikliği ile karakterize deri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Skin characterized by the lack of natural or normal moisture.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
