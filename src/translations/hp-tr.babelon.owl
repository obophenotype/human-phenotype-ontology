        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Olfactory esthesioneuroblastoma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030069">
        <obo:IAO_0000115 xml:lang="tr">Genellikle beyinden, leptomeninkslerden, spinal korttan veya gözlerden köken alan geniş hücreli veya immünoblastik tip ve tipik olarak MSS&apos;ye sınırlı kalan ekstranodal, yüksek dereceli non-Hodgkin B hücreli neoplazm</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Primer merkezi sinir sistemi lenfoması</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030069"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Genellikle beyinden, leptomeninkslerden, spinal korttan veya gözlerden köken alan geniş hücreli veya immünoblastik tip ve tipik olarak MSS&apos;ye sınırlı kalan ekstranodal, yüksek dereceli non-Hodgkin B hücreli neoplazm</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of extranodal, high-grade non-Hodgkin B-cell neoplasm, usually large cell or immunoblastic type that originates in the brain, leptomeninges, spinal cord, or eyes and typically remains confined to the CNS.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030069"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Primer merkezi sinir sistemi lenfoması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Primary central nervous system lymphoma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030070">
        <obo:IAO_0000115 xml:lang="tr">Merkezi sinir sisteminde meydana gelen primitif nöroektodermal bir neoplazi</obo:IAO_0000115>
