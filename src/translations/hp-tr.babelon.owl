    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003106">
        <obo:IAO_0000115 xml:lang="tr">Kemik kitlesi kaybı periostum altında meydana gelen (periosteum eklem yüzeyleri hariç tüm kemikleri çevreleyen bağ doku zarıdır). Bu işlem periost kortikal kemiğinde tırtıklı ve dantel benzeri bir görünüm oluşturabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Subperiostal kemik rezorpsiyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003106"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kemik kitlesi kaybı periostum altında meydana gelen (periosteum eklem yüzeyleri hariç tüm kemikleri çevreleyen bağ doku zarıdır). Bu işlem periost kortikal kemiğinde tırtıklı ve dantel benzeri bir görünüm oluşturabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Loss of bone mass occurring beneath the periosteum (the periosteum is the connective-tissue membrane that surrounds all bones except at the articular surfaces). This process may create a serrated and lace-like appearance in periosteal cortical bone.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
