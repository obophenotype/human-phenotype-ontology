        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000324">
        <obo:IAO_0000115 xml:lang="tr">Yüzün sağ ve sol tarafları arasında anormal farklılık</obo:IAO_0000115>
