        <owl:annotatedTarget xml:lang="tr">Molluskoid psödotümörler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Molluscoid pseudotumors</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000995">
        <obo:IAO_0000115 xml:lang="tr">Oval ve yuvarlak, renkli (çoğunlukla orta koyu kahverengiden, kırmızımsı kahverengiye veya ten rengi) bir lezyon. Tipik olarak, melanositik nevüs çapı 6 mm&apos;den daha azdır fakat daha küçük veya daha büyük olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Melanositik nevüs</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000995"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Oval ve yuvarlak, renkli (çoğunlukla orta koyu kahverengiden, kırmızımsı kahverengiye veya ten rengi) bir lezyon. Tipik olarak, melanositik nevüs çapı 6 mm&apos;den daha azdır fakat daha küçük veya daha büyük olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A oval and round, colored (usually medium-to dark brown, reddish brown, or flesh colored) lesion. Typically, a melanocytic nevus is less than 6 mm in diameter, but may be much smaller or larger.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000995"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Melanositik nevüs</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Melanocytic nevus</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000996">
        <obo:IAO_0000115 xml:lang="tr">Küçük endotelyal boşluklu vasküler endotelyal hücrelerin selim bir tümörü, yüzde olan hemanjiyoma</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yüz kapiller hemanjiyomu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000996"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Küçük endotelyal boşluklu vasküler endotelyal hücrelerin selim bir tümörü, yüzde olan hemanjiyoma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hemangioma, a benign tumor of the vascular endothelial cells with small endothelial spaces, occurring in the face.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000996"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
