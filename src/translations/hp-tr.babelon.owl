    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025254">
        <obo:IAO_0000115 xml:lang="tr">İyileştirici bir faktör bir kişide bir bulgu veya belirtinin ortaya çıkmasını iyileştiren veya daha katlanılabilir yapan bir dış faktör olarak tanımlanmaktadır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tarafından iyileşen</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025254"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İyileştirici bir faktör bir kişide bir bulgu veya belirtinin ortaya çıkmasını iyileştiren veya daha katlanılabilir yapan bir dış faktör olarak tanımlanmaktadır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An ameliorating factor is defined as an external factor that leads to a sign or symptom that is already present improving or becoming more bearable</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
