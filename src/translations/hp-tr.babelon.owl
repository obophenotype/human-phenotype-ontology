    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030952">
        <obo:IAO_0000115 xml:lang="tr">Boyutları, yaklaşık olarak optik diskin yarısının dörtte biri kadar olan ve konumları çevreye yayılmış optik sinir etrafında kümelenme eğilimi gösteren çok sayıda krem sarısı renkli hipopigmente koroid anomalisi. Lezyonların deseninin birdshot&apos;tan kurşun sıkıldığında oluşan şekle benzediği söylenir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Saçma şeklinde koroidal lezyonlar</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030952"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Boyutları, yaklaşık olarak optik diskin yarısının dörtte biri kadar olan ve konumları çevreye yayılmış optik sinir etrafında kümelenme eğilimi gösteren çok sayıda krem sarısı renkli hipopigmente koroid anomalisi. Lezyonların deseninin birdshot&apos;tan kurşun sıkıldığında oluşan şekle benzediği söylenir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Multiple cream-yellow colored hypopigmented lesions typically located at the level of the outer choroid. They are between 50 and 1,500 micrometers in size with a characteristic nasal, radial distribution in the postequatorial fundus.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030952"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Saçma şeklinde koroidal lezyonlar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Birdshot choroidal lesions</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030953">
        <obo:IAO_0000115 xml:lang="tr">Konjunktivadaki kan damarlarının genişlemesi skleranın kırmızı bir görüntü kazanmasına yol açar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Konjunktival hiperemi</rdfs:label>
