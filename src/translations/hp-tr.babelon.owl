    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030283">
        <obo:IAO_0000115 xml:lang="tr">Septum pellucidum&apos;un (beynin yanal ventriküllerini ayıran ince, üçgen, dikey bir zar) sadece bir kısmı mevcuttur. Bu özellik, manyetik rezonans tomografisinde veya bilgisayarlı beyin tomografisinde değerlendirilebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Septum pellusidumun kısmi yokluğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030283"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Septum pellucidum&apos;un (beynin yanal ventriküllerini ayıran ince, üçgen, dikey bir zar) sadece bir kısmı mevcuttur. Bu özellik, manyetik rezonans tomografisinde veya bilgisayarlı beyin tomografisinde değerlendirilebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Only part of the septum pellucidum (a thin, triangular, vertical membrane separating the lateral ventricles of the brain) is present. This feature can be appreciated on magnetic resonance tomography or computed tomography of the brain.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
