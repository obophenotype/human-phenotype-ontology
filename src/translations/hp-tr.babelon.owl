    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0040232">
        <obo:IAO_0000115 xml:lang="tr">Bir prosedür veya travmayla alakalı ilk travma anında başlamayan, en az 24 saatlik bir gecikmeden sonra başlayan anormal kanama</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Gecikmiş başlangıçlı kanama</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040232"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir prosedür veya travmayla alakalı ilk travma anında başlamayan, en az 24 saatlik bir gecikmeden sonra başlayan anormal kanama</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal bleeding related to a procedure or trauma which does not start at the time of the initial insult, but after delay by at least 24 hours.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
