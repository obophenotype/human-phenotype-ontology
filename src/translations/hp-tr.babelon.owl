        <owl:annotatedTarget xml:lang="tr">Respiratuar motil siliyanın olmayan santral mikrotübüler çift morfolojisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absent central microtubular pair morphology of respiratory motile cilia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012265">
        <obo:IAO_0000115 xml:lang="tr">Normal olarak hücreler arası ve hücre içi iyi düzenlenmiş hareketli siliya eşzamanlılığı paterninden bir sapma. Diskinetik siliya komşu siliyalara göre genellikle eşzamanlılık harici vuru yapar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Siliyer diskinezi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012265"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Normal olarak hücreler arası ve hücre içi iyi düzenlenmiş hareketli siliya eşzamanlılığı paterninden bir sapma. Diskinetik siliya komşu siliyalara göre genellikle eşzamanlılık harici vuru yapar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deviation from the normally well coordinated pattern of intracellular and intercellular synchrony of motile cilia. Dyskinetic cilia usually beat out of synchrony relative to neighboring cilia.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012265"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Siliyer diskinezi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ciliary dyskinesia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
