        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Gecikmiş başlangıçlı kanama</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Delayed onset bleeding</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0040233">
        <obo:IAO_0000115 xml:lang="tr">Faktör XIII altbirim A&apos;nın eksikliği, faktör XIII etkinliğinin azalmasına neden olur. Aktif Faktör XIII, pıhtılaşan fibrin polimerlerlerle çapraz bağlıdır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Faktör XIII alt birim A eksikliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040233"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Faktör XIII altbirim A&apos;nın eksikliği, faktör XIII etkinliğinin azalmasına neden olur. Aktif Faktör XIII, pıhtılaşan fibrin polimerlerlerle çapraz bağlıdır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Deficiency of factor XIII subunit A, leading to a reduced factor XIII activity. Activated Factor XIII cross-links fibrin polymers solidifying the clot.</babelon:source_value>
