    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011243">
        <obo:IAO_0000115 xml:lang="tr">Yukarı çıkan heliks katlantısının altında sonlanan antiheliks bifurkasyonundan köken alan alt kıkırdağımsı sırt olan antiheliks inferior krusunun bir anormalliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Antiheliksin inferior krusunun anormalliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011243"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Yukarı çıkan heliks katlantısının altında sonlanan antiheliks bifurkasyonundan köken alan alt kıkırdağımsı sırt olan antiheliks inferior krusunun bir anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the inferior crus of the antihelix is the lower cartilaginous ridge arising at the bifurcation of the antihelix that ends beneath the fold of the ascending helix, and separates the concha from the triangular fossa.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011243"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
