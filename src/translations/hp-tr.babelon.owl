        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lacrimal duct atresia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000565">
        <obo:IAO_0000115 xml:lang="tr">Bir veya iki gözün içe döndüğü (&apos;çaprazlaştığı&apos;) sıklıkla 10 diyoptri veya daha fazla olarak tanımlanan göreceli ciddi olabilen bir şaşılık türü</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ezotropi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000565"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir veya iki gözün içe döndüğü (&apos;çaprazlaştığı&apos;) sıklıkla 10 diyoptri veya daha fazla olarak tanımlanan göreceli ciddi olabilen bir şaşılık türü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of strabismus with one or both eyes turned inward (&apos;crossed&apos;) to a relatively severe degree, usually defined as 10 diopters or more.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
