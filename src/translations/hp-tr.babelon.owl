        <owl:annotatedTarget xml:lang="tr">Sağ brakiosefalik arter, sol ortak karotid arter, sol subklaviyen arter veya proksimal vertebral arterlerin kökeninin veya seyrinin normalden sapması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deviance from the norm of the origin or course of the right brachiocephalic artery, the left common carotid artery, the left subclavian artery or the proximal vertebral arteries.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
