    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001269">
        <obo:IAO_0000115 xml:lang="tr">Vücudun bir tarafında kolda, bacakta ve bazen yüzde kuvvet kaybı. Hemipleji kuvvetin tamamen kaybına işaret ederken, hemiparezis kısmi kuvvet kaybına denir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hemiparezis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001269"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Vücudun bir tarafında kolda, bacakta ve bazen yüzde kuvvet kaybı. Hemipleji kuvvetin tamamen kaybına işaret ederken, hemiparezis kısmi kuvvet kaybına denir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Loss of strength in the arm, leg, and sometimes face on one side of the body. Hemiplegia refers to a complete loss of strength, whereas hemiparesis refers to an incomplete loss of strength.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001269"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hemiparezis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hemiparesis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001270">
        <obo:IAO_0000115 xml:lang="tr">Motor becerilerin kazanılmasındaki gecikme ile karakterize bir tip gelişim gecikmesi</obo:IAO_0000115>
