        <babelon:source_value>Neurocytic rosette</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031931">
        <obo:IAO_0000115 xml:lang="tr">Oküler fluter tekrarlayan, düzensiz, salınımlar arası aralık olmadan olan yatay salınımların istemsiz patlamalarından oluşan anormal bir göz hareketidir. Genellikle normal okülomotor davranış üzerine binen ve meydana gelişi göz kırpması, normal salınımların tetiklenmesi veya optokinetik uyarı gibi çeşitli olaylar tarafından mümkün olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Oküler fluter</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031931"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Oküler fluter tekrarlayan, düzensiz, salınımlar arası aralık olmadan olan yatay salınımların istemsiz patlamalarından oluşan anormal bir göz hareketidir. Genellikle normal okülomotor davranış üzerine binen ve meydana gelişi göz kırpması, normal salınımların tetiklenmesi veya optokinetik uyarı gibi çeşitli olaylar tarafından mümkün olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ocular flutter is an abnormal eye movement consisting of repetitive, irregular, involuntary bursts of horizontal saccades without an intersaccadic interval. It is generally superimposed on normal oculomotor behavior and its occurrence may be favored by various events, such as blinks, the triggering of normal saccades or optokinetic stimulation.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031931"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Oküler fluter</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ocular flutter</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031932">
        <obo:IAO_0000115 xml:lang="tr">Aorto-sol ventriküler tünel (ALVT) çıkan aortayı sinotübüler bileşke üzerinde herhangi bir sol ventriküler boşluğa bağlayan ekstrakardiyak bir kanaldır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Aorto-sol ventriküler tünel</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031932"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Aorto-sol ventriküler tünel (ALVT) çıkan aortayı sinotübüler bileşke üzerinde herhangi bir sol ventriküler boşluğa bağlayan ekstrakardiyak bir kanaldır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aorto-left ventricular tunnel (ALVT) is a congenital extracardiac channel connecting the ascending aorta above the sino-tubular junction to either left or right ventricular cavity.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031932"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Aorto-sol ventriküler tünel</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aorto-left ventricular tunnel</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031933">
        <obo:IAO_0000115 xml:lang="tr">Çıkan aortu sinotübüler bileşke üzerinde sağ ventriküler boşluğa bağlayan ekstrakardiyak kanal varlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Aorto-sağ ventriküler tünel</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031933"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çıkan aortu sinotübüler bileşke üzerinde sağ ventriküler boşluğa bağlayan ekstrakardiyak kanal varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of an extracardiac channel that connects the ascending aorta above the sinotubular junction to the cavity of the right ventricle.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031933"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Aorto-sağ ventriküler tünel</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aorto-right ventricular tunnel</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031934">
        <obo:IAO_0000115 xml:lang="tr">Aortik arktan başlayan ve sonra göğüs ve abdomen içinden aşağı inen aort kısmının yapısal bir anormalliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal inen aort morfolojisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031934"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Aortik arktan başlayan ve sonra göğüs ve abdomen içinden aşağı inen aort kısmının yapısal bir anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A structural abnormality of the part of the aorta that begins at the aortic arch and then descends through the chest and abdomen.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031934"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal inen aort morfolojisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal descending aorta morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031935">
        <obo:IAO_0000115 xml:lang="tr">Uzun bir segmentin veya bütün çıkan aortun belirgin luminal daralması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Çıkan aort hipoplazisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031935"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Uzun bir segmentin veya bütün çıkan aortun belirgin luminal daralması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Significant luminal narrowing of a long segment of or the entire ascending aorta.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031935"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Çıkan aort hipoplazisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ascending aorta hypoplasia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031936">
        <obo:IAO_0000115 xml:lang="tr">Uygun gelişimsel evrede yürüme kabiliyeti kazanılmasında bir yetersizlik. Çoğu çocuk yürümeyi bir dizi basamakta öğrenir ve bağımsız olarak kısa mesafe yürümeyi 12 ve 15 ay arasında öğrenir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Gecikmiş yürüme kabiliyeti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031936"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Uygun gelişimsel evrede yürüme kabiliyeti kazanılmasında bir yetersizlik. Çoğu çocuk yürümeyi bir dizi basamakta öğrenir ve bağımsız olarak kısa mesafe yürümeyi 12 ve 15 ay arasında öğrenir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A failure to achieve the ability to walk at an appropriate developmental stage. Most children learn to walk in a series of stages, and learn to walk short distances independently between 12 and 15 months.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031936"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Gecikmiş yürüme kabiliyeti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Delayed ability to walk</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031937">
        <obo:IAO_0000115 xml:lang="tr">Konuşmanın aşırı hızlılığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Takilali</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031937"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Konuşmanın aşırı hızlılığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Speech that is abnormally fast as compared to the perceived cultural norm.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031937"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Takilali</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tachylalia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031938">
        <obo:IAO_0000115 xml:lang="tr">Spinal kordun inceldiği ve sonlandığı yerleşimde spinal kordun distal bulböz kısmı olan konus terminalisin herhangi yapısal bir anomalisi (genellikle L1 ve L2 lumbar vertebra arasında)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal konus terminalis morfolojisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031938"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Spinal kordun inceldiği ve sonlandığı yerleşimde spinal kordun distal bulböz kısmı olan konus terminalisin herhangi yapısal bir anomalisi (genellikle L1 ve L2 lumbar vertebra arasında)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any structural anomaly of the conus terminalis, which is the distal bulbous part of the spinal cord at the location where the spinal cord tapers and ends (usually between the L1 and L2 lumbar vertebrae).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031938"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal konus terminalis morfolojisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal conus terminalis morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031939">
        <rdfs:label xml:lang="tr">Konus terminalis arteriyovenöz malformasyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031939"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Konus terminalis arteriyovenöz malformasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Conus terminalis arteriovenous malformation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031941">
        <obo:IAO_0000115 xml:lang="tr">Alt özofagusu içeren fakat alt anal kanal hariç sindirim kanalının abdominal kısmını drene eden bütün venlerden oluşan portal venöz sistemin herhangi yapısal bir anomalisi. Portal ven organlardan kan taşır ve karaciğerde sinüzoidlerde sonlanan bir arter gibi kollara ayrılır. Portal venöz sistemi yapan portal veni oluşturan splenik, süperior mezentrik, sol gastrik, sağ gastrik, paraumbilikal ve kistik venlerdir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal portal venöz sistem morfolojisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031941"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Alt özofagusu içeren fakat alt anal kanal hariç sindirim kanalının abdominal kısmını drene eden bütün venlerden oluşan portal venöz sistemin herhangi yapısal bir anomalisi. Portal ven organlardan kan taşır ve karaciğerde sinüzoidlerde sonlanan bir arter gibi kollara ayrılır. Portal venöz sistemi yapan portal veni oluşturan splenik, süperior mezentrik, sol gastrik, sağ gastrik, paraumbilikal ve kistik venlerdir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any structural anomaly of the portal venous system, which comprises all of the veins draining the abdominal part of the digestive tract, including the lower esophagus but excluding the lower anal canal. The portal vein conveys blood from viscera and ramifies like an artery at the liver, ending at the sinusoids. Tributaries of the portal vein, which make up the portal venous system, are the splenic, superior mesenteric, left gastric, right gastric, paraumbilical, and cystic veins.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031941"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal portal venöz sistem morfolojisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal portal venous system morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031942">
        <obo:IAO_0000115 xml:lang="tr">İntestinal ve splenik venöz drenajın karaciğeri pas geçtiği ve muhtelemen diğer venöz şantlar içinden sistemik venlerin içine drene olduğu anomali</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Portal venin konjenital yokluğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031942"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İntestinal ve splenik venöz drenajın karaciğeri pas geçtiği ve muhtelemen diğer venöz şantlar içinden sistemik venlerin içine drene olduğu anomali</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anomaly where the intestinal and the splenic venous drainage bypass the liver and drain into systemic veins through other possible venous shunts.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031942"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Portal venin konjenital yokluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Congenital absence of portal vein</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031943">
        <obo:IAO_0000115 xml:lang="tr">Sıklıkla fakat her zaman olmayan öznel iç huzursuzluk hissinin, hareket etme dürtüsünün ve anksiyetenin veya disforinin eşlik ettiği genelilkle alt ekstremitelerde bir motor huzursuzluk hissi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Akatiziya</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031943"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sıklıkla fakat her zaman olmayan öznel iç huzursuzluk hissinin, hareket etme dürtüsünün ve anksiyetenin veya disforinin eşlik ettiği genelilkle alt ekstremitelerde bir motor huzursuzluk hissi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A state of motor restlessness, usually in the lower extremities, that is often but not always accompanied by a subjective sense of inner restlessness, an urge to move, and anxiety or dysphoria.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031943"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Akatiziya</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Akathisia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031944">
        <obo:IAO_0000115 xml:lang="tr">Genellikle plevral doku skarlaşması ile ilişkili, plevra kalınlığında bir artış</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Plevral kalınlaşma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031944"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Genellikle plevral doku skarlaşması ile ilişkili, plevra kalınlığında bir artış</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An increase in the thickness of the pleura, generally related to scarring of the pleural tissue.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031944"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Plevral kalınlaşma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pleural thickening</babelon:source_value>
