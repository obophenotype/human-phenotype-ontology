        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007720">
        <obo:IAO_0000115 xml:lang="tr">Kornea plana korneanın göz akındaki normal çıkıntısının kaybolduğu şekilde anormal derecede düz bir şekilde kornea şeklindedir. Azaltılmış korneal kavis hipermetropluğa yol açabilir ve erken yaşlarda bulanık korneal limbus ve arcus lipoidler gelişebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Düz kornea</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007720"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kornea plana korneanın göz akındaki normal çıkıntısının kaybolduğu şekilde anormal derecede düz bir şekilde kornea şeklindedir. Azaltılmış korneal kavis hipermetropluğa yol açabilir ve erken yaşlarda bulanık korneal limbus ve arcus lipoidler gelişebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cornea plana is an abnormally flat shape of the cornea such that the normal protrusion of the cornea from the sclera is missing. The reduced corneal curvature can lead to hyperopia, and a hazy corneal limbus and arcus lipoides may develop at an early age.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007720"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Düz kornea</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Flat cornea</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007721">
