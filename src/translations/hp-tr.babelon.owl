        <rdfs:label xml:lang="tr">Pelvik kavşak amyotrofisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0008946"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Pelvik kemer kaslarının (kalça kemeri olarak da bilinir) yani gluteal kaslar, lateral rotator kaslar, addüktörler, psoas major ve iliyak kasların atrofisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrophy of the muscles of the pelvic girdle (also known as hip girdle), i.e., the gluteal muscles, the lateral rotators, the adductors, the psoas major and the iliacus muscle.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
