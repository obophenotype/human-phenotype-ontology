        <owl:annotatedTarget xml:lang="tr">Vücut ağırlığını dağıtan ve hareket esnasında diz ekleminin sürtünmesini azaltan iki hilal şekilli fibrokartilajinöz yastıklar olan dizin menisküsünün anormal yapısı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
