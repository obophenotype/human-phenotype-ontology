        <owl:annotatedTarget xml:lang="tr">Asterognozya</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Astereognosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010528">
        <obo:IAO_0000115 xml:lang="tr">Tanıdık insanların yüzlerini tanımada yetersizlik</obo:IAO_0000115>
