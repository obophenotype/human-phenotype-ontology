        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031108"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Normal olarak dirseğim uzatılması (düzelmesi) ve belli başlı omuz hareketlerinin gerçekleştirilmesini sağlayan triseps kasında güç eksikliği</owl:annotatedTarget>
