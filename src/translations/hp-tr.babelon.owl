        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010527">
        <obo:IAO_0000115 xml:lang="tr">Görsel girdi olmadan dokunma ile nesnelerin formlarını tanımada yetersizlik. Bu, herhangi büyük sematoduysal bir eksiklik yokluğunda nesnenin sadece doku, ağırlık ve üç boyutlu formuna dayalı nesne tanınmasındaki bir bozukluktur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Asterognozya</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010527"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Görsel girdi olmadan dokunma ile nesnelerin formlarını tanımada yetersizlik. Bu, herhangi büyük sematoduysal bir eksiklik yokluğunda nesnenin sadece doku, ağırlık ve üç boyutlu formuna dayalı nesne tanınmasındaki bir bozukluktur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tactile agnosia refers to the inability to recognize objects by touch, while the inability to discriminate shape and size by touch is also a related condition.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
