        <babelon:source_value>Abnormal S wave</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032196">
        <obo:IAO_0000115 xml:lang="tr">Elektrokardiyogramda kablo I&apos;de ölçüldüğü gibi S dalgasının artmış genliği (0.1 mV veya daha fazla) ve/veya süresi (40 ms veya daha fazla)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kablo I&apos;de belirgin S dalgası</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032196"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Elektrokardiyogramda kablo I&apos;de ölçüldüğü gibi S dalgasının artmış genliği (0.1 mV veya daha fazla) ve/veya süresi (40 ms veya daha fazla)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased amplitude (0.1 mV or more) and/or duration (40 ms or more) of the S wave as measured in lead I of the electrocardiogram.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032196"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kablo I&apos;de belirgin S dalgası</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Prominent S wave in lead I</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032197">
        <obo:IAO_0000115 xml:lang="tr">Elektrokardiyogramın V5 kablosunda S dalgasının anormal derinliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kablo V5&apos;te derin S dalgası</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032197"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Elektrokardiyogramın V5 kablosunda S dalgasının anormal derinliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal depth of the S wave in lead V5 of the electrocardiogram.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032197"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
