    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009945"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bu terim, ciddiyetine bağlı olarak geniş veya bifid bir görünüme yol açtığı 2. parmağın bir veya daha fazla falanksının ya kısmi duplike olduğu ya da tam duplike olduğu durumda kullanılır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>This term applies if one or more of the phalanges of the 2nd finger are either partially duplicated, depending on severity leading to a broad or bifid appearance of the phalanges, or completely duplicated.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
