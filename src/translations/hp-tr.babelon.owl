        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cone-shaped deformity of the cornea characterized by the presence of corneal distortion secondary to thinning of the apex.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
