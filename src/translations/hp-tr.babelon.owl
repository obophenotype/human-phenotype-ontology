    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100884">
        <obo:IAO_0000115 xml:lang="tr">Bacak uzunluğunda (hemihifertrofi ya dahemihipotrofiye sebebiyle ortaya çıkan) bir farklılığın sonucu olan skolyoz ve bunun sonucunda ortaya çıkan pelvis eğilimi. Tedavi edilmediği durumlarda, zamanla skolyoz gelişmesine sebep olacaktır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dengeleyici skolyoz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
