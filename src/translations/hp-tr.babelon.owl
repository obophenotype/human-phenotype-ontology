        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005743"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">&quot;Büyümekte olan çocuklarda femurun proksimal epifizinin avasküler nekrozu ve kalça eklemine yakın femur başındaki kan akımının kesilmesinden kaynaklanmaktadır. Nekroz karakteristik olarak femur başının düzleştirilmesiyle ilişkilidir, bu nedenle tıp literatüründe bu özelliğe değinmek için &quot;&quot;coxa plana&quot;&quot; terimi kullanılmıştır&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Avascular necrosis of the proximal epiphysis of the femur occurring in growing children and caused by an interruption of the blood supply to the head of the femur close to the hip joint. The necrosis is characteristically associated with flattening of the femoral head, for which reason the term coxa plana has been used to refer to this feature in the medical literature.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005743"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Femoral kapital epifizinin avasküler nekrozu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Avascular necrosis of the capital femoral epiphysis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
