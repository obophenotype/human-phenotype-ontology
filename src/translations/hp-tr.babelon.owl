        <babelon:source_value>Widely spaced teeth</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000689">
        <obo:IAO_0000115 xml:lang="tr">Dental maloklüzyon üst ve alt dişlerin birbirine uymadığı ve dişlerin kalabalıklaşmasına veya anormal ısırık paternine yol açan bir oklüzyon anomalisini veya yanlış dizilimi tarif eder</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dental maloklüzyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000689"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Dental maloklüzyon üst ve alt dişlerin birbirine uymadığı ve dişlerin kalabalıklaşmasına veya anormal ısırık paternine yol açan bir oklüzyon anomalisini veya yanlış dizilimi tarif eder</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dental malocclusion refers to an abnormality of the occlusion, or alignment, of the teeth and the way the upper and lower teeth fit together, resulting in overcrowding of teeth or in abnormal bite patterns.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000689"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Dental maloklüzyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dental malocclusion</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000690">
        <obo:IAO_0000115 xml:lang="tr">Maksiller lateral primer kesiciyi ve maksiller lateral ikincil kesiciyi de içine alan bir veya daha fazla maksiller lateral kesici agenezisi</obo:IAO_0000115>
