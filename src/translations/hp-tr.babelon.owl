    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003467">
        <obo:IAO_0000115 xml:lang="tr">Kemikli ya da ligamentöz bir anormalliğin sonucu olarak ilk servikal (atlas) ve ikinci servikal (axis) vertebra arasındaki birleşimdeki anormal artmış hareket</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Atlantoaksiyal instabilite</rdfs:label>
    </rdf:Description>
