    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011961"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Testislerde spermatozoa üretimindeki bir kusurdan kaynaklanan, menide ölçülebilir seviyede sperm yokluğu. Testiküler biyopsi zemininde tıkayıcı azoospermiadan ayrılabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of any measurable level of sperm in his semen, resulting from a defect in the production of spermatozoa in the testes. This can be differentiated from obstructive azoospermia on the basis of testicular biopsy.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011961"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Obstrüktif olmayan azospermi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Non-obstructive azoospermia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011962">
        <obo:IAO_0000115 xml:lang="tr">Posttestiküler tıkanma veya retrograd ejakülasyondan kaynaklanan, menide ölçülebilir seviyede sperm yokluğu. Testiküler biyopsi zemininde tıkayıcı azoospermiadan ayrılabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Obstrüktif azospermi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011962"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Posttestiküler tıkanma veya retrograd ejakülasyondan kaynaklanan, menide ölçülebilir seviyede sperm yokluğu. Testiküler biyopsi zemininde tıkayıcı azoospermiadan ayrılabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of any measurable level of sperm in his semen, resulting from post-testicular obstruction or retrograde ejaculation. This can be differentiated from obstructive azoospermia on the basis of testicular biopsy.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
