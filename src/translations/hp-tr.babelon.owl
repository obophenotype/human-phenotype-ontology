    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012209">
        <obo:IAO_0000115 xml:lang="tr">Juvenil miyelomonositik lösemi (JMML), genç çocukluğun ölümcül miyeloproliferatif bir hastalığıdır ve klinik olarak miyelomonositik hücrelerin fazla üretilmesi ve in vitro olarak granülosit-makrofaj koloni uyarıcı faktöre hematopoietik öncül aşırı duyarlılığının fenotipi ile karakterize edilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Juvneil myelomonositik lösemi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012209"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Juvenil miyelomonositik lösemi (JMML), genç çocukluğun ölümcül miyeloproliferatif bir hastalığıdır ve klinik olarak miyelomonositik hücrelerin fazla üretilmesi ve in vitro olarak granülosit-makrofaj koloni uyarıcı faktöre hematopoietik öncül aşırı duyarlılığının fenotipi ile karakterize edilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Juvenile myelomonocytic leukemia (JMML) is a lethal myeloproliferative disease of young childhood characterized clinically by overproduction of myelomonocytic cells and by the in vitro phenotype of hematopoietic progenitor hypersensitivity to granulocyte-macrophage colony-stimulating factor.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012209"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Juvneil myelomonositik lösemi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Juvenile myelomonocytic leukemia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
