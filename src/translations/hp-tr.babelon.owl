    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006145">
        <obo:IAO_0000115 xml:lang="tr">Merkezi Y-şekilli olan bir metakarpal, Y&apos;nin iki kolu distal yönde işaret etmesiyle beraber elin iki merkezi metakarpunun (yani metakarpal 2-4) kısmi bir füzyonu ile sonuçlanır. Merkezi Y şeklindeki metakarplar, merkezi bir polidaktili ile çoğaltılan metakarpanın kısmi füzyonunun sonucu olarak görülebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Merkezi Y şeklinde metakarp</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006145"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Merkezi Y-şekilli olan bir metakarpal, Y&apos;nin iki kolu distal yönde işaret etmesiyle beraber elin iki merkezi metakarpunun (yani metakarpal 2-4) kısmi bir füzyonu ile sonuçlanır. Merkezi Y şeklindeki metakarplar, merkezi bir polidaktili ile çoğaltılan metakarpanın kısmi füzyonunun sonucu olarak görülebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A central Y-shaped metacarpal is the result of a partial fusion of two central metacarpals (i.e., metacarpals 2-4) of the hand, with the two arms of the Y pointing in the distal direction. Central Y-shaped metacarpals may be seen as a result of a central polydactyly with partial fusion of the duplicated metacarpal.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006145"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Merkezi Y şeklinde metakarp</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Central Y-shaped metacarpal</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
