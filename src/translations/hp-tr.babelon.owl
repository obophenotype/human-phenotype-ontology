    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0040229">
        <obo:IAO_0000115 xml:lang="tr">Trombomodulin, Protein C&apos;nin aktivasyonu esnasında trombin tarafından uyarılan bir ko-faktördür. Eksikliğin olması durumunda Protein C daha az ve pıhtılaşma eğilimi olacaktır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Azalmış trombomodülin seviyesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040229"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Trombomodulin, Protein C&apos;nin aktivasyonu esnasında trombin tarafından uyarılan bir ko-faktördür. Eksikliğin olması durumunda Protein C daha az ve pıhtılaşma eğilimi olacaktır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Thrombomodulin is a cofactor in the thrombin induced activation of Protein C. In the case of deficiency there will be less Protein C and tendency to clot</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040229"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Azalmış trombomodülin seviyesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased level of thrombomodulin</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0040230">
        <obo:IAO_0000115 xml:lang="tr">tPA, plazminojenin plazmin&apos;e dönüşmesini katalizler ve böylece pıhtıları parçalar. Bir eksiklik olduğunda trombozda artış olur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Azalmış doku plazminojen aktivatörü seviyesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040230"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">tPA, plazminojenin plazmin&apos;e dönüşmesini katalizler ve böylece pıhtıları parçalar. Bir eksiklik olduğunda trombozda artış olur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The tPA protein catalyzes the conversion of plasiminogen to plasmin, and thus break down of clots. When there is a deficiency there will be an increase of thrombosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040230"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Azalmış doku plazminojen aktivatörü seviyesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased level of tissue plasminogen activator</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0040231">
        <rdfs:label xml:lang="tr">Anormal kanama başlangıcı</rdfs:label>
