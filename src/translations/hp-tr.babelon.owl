    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001057">
        <obo:IAO_0000115 xml:lang="tr">Çoklu veya tek, inflamatuvar olmayan, sınırları belirgin, yaklaşık 1-2 cm çapında oval veya yuvarlak ülser şeklinde derinin doğumsal yokluğu ile sonuçlanan bir gelişimsel defekt. Aplazi kutis konjenita en sık saçlı deride meydana gelir, ancak yüz, gövde veya üyelerde olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Aplazi kutis konjenita</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001057"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çoklu veya tek, inflamatuvar olmayan, sınırları belirgin, yaklaşık 1-2 cm çapında oval veya yuvarlak ülser şeklinde derinin doğumsal yokluğu ile sonuçlanan bir gelişimsel defekt. Aplazi kutis konjenita en sık saçlı deride meydana gelir, ancak yüz, gövde veya üyelerde olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A developmental defect resulting in the congenital absence of skin in multiple or solitary non-inflammatory, well-demarcated, oval or circular ulcers with a diameter of about 1 to 2 cm. Aplasia cutis congenita most commonly occurs on the scalp, but may present in the face, trunk, or limbs.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001057"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Aplazi kutis konjenita</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aplasia cutis congenita</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001058">
