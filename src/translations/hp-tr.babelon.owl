        <owl:annotatedTarget xml:lang="tr">Genellikle ikincil olarak adrenal korteks tarafından aşırı kortizol üretimine yol açan adrenokortikotropik hormonun (ACTH) aşırı üretimi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Overproduction of adrenocorticotropic hormone (ACTH), which generally leads secondarily to overproduction of cortisol by the adrenal cortex.</babelon:source_value>
