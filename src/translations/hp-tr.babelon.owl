    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031174">
        <obo:IAO_0000115 xml:lang="tr">Yan diz grafisinde görülebilir sagital oryantasyonda bir katmanın diğer katmanın önünde olduğu iki katman ile karakterize bir patella anomalisi (PMID:12966518 Figür 2A&apos;ya ve 3B&apos;ye bakınız). Bu bulgular erişkinlikte devam eder</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Çift katmanlı patella</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031174"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Yan diz grafisinde görülebilir sagital oryantasyonda bir katmanın diğer katmanın önünde olduğu iki katman ile karakterize bir patella anomalisi (PMID:12966518 Figür 2A&apos;ya ve 3B&apos;ye bakınız). Bu bulgular erişkinlikte devam eder</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly of the patella characterized by two layers visible on lateral knee X-ray such that one layer is in front of the other in the sagittal orientation (See Figure 2A and 3B of PMID:12966518). This finding persists into adulthood.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
