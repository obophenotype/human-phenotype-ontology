    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000316">
        <obo:IAO_0000115 xml:lang="tr">Pupiller arası mesafenin ortalamadan 2 SD daha fazla olması (Alternatif olarak, artmış interpupiller mesafe görünümü veya genişçe yerleşmiş gözler)</obo:IAO_0000115>
