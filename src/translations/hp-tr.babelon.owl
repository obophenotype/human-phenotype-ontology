    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005520">
        <obo:IAO_0000115 xml:lang="tr">Sürekli zayıf veya aralıklı aktif edici uyarıcı; mevcut, tahripçi ve pıhtılaşma faktörlerinin ve trombositlerin üretimi dengeli olan yaygın intravasküler pıhtılaşmanın kronik bir şeklidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kronik dissemine intravasküler koagülasyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005520"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sürekli zayıf veya aralıklı aktif edici uyarıcı; mevcut, tahripçi ve pıhtılaşma faktörlerinin ve trombositlerin üretimi dengeli olan yaygın intravasküler pıhtılaşmanın kronik bir şeklidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A chronic form of disseminated intravascular coagulation in which a persistent weak or intermittent activating stimulus is present and destruction and production of coagulation factors and platelets are balanced.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005520"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kronik dissemine intravasküler koagülasyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic disseminated intravascular coagulation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005521">
        <obo:IAO_0000115 xml:lang="tr">Dağılımlı intravasküler pıhtılaşma, pıhtılaşmanın yaygın şekilde harekete geçirilmesiyle karakterize edilir, bu da fibrinin damar içi oluşumuyla ve nihayetinde de küçük ve orta boy damarların tromboz tıkanmasıyla sonuçlanır.</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dissemine intravasküler koagülasyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005521"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Dağılımlı intravasküler pıhtılaşma, pıhtılaşmanın yaygın şekilde harekete geçirilmesiyle karakterize edilir, bu da fibrinin damar içi oluşumuyla ve nihayetinde de küçük ve orta boy damarların tromboz tıkanmasıyla sonuçlanır.</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Disseminated intravascular coagulation is characterized by the widespread activation of coagulation, which results in the intravascular formation of fibrin and ultimately thrombotic occlusion of small and midsize vessels.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
