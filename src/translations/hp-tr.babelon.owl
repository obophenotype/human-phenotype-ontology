        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009898">
        <obo:IAO_0000115 xml:lang="tr">Heliks krusunun gelişimsel hipoplazisi. Bu, ortalamadan daha düz ve/veya kısa heliks krusudur</obo:IAO_0000115>
