        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Intralamellar mucoid extracellular matrix accumulation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032082">
        <obo:IAO_0000115 xml:lang="tr">Mukoid ekstraselüler matrikste artış lamellar birimlerinin değişen derecelerde düzenlenmesini değiştirdiği bir mukoid ekstraselüler matriks birikimi tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Translamellar mukoid ekstraselüler matriks birikimi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032082"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Mukoid ekstraselüler matrikste artış lamellar birimlerinin değişen derecelerde düzenlenmesini değiştirdiği bir mukoid ekstraselüler matriks birikimi tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of mucoid extracellular matrix accumulation in which the increase in mucoid extracellular matrix alters the arrangement of the lamellar units to varying degrees.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032082"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Translamellar mukoid ekstraselüler matriks birikimi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Translamellar mucoid extracellular matrix accumulation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032083">
        <obo:IAO_0000115 xml:lang="tr">Elastik liflerin yokluğu ve elastik lifler için olan bir boya ile tanımlandığı üzere elastik lif lamellasında artmış boşluklar ile artan derecede genişlemiş translamellar boşluklar oluşturan aort mediasının elastik liflerinin kaybı ve/veya fragmantasyonu</obo:IAO_0000115>
