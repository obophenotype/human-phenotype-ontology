    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030372"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">B hücrelerinin toplam sayısına göreceli olarak saf B hücrelerinin (CD19+/CD27-/IgD+/IgM+) normal oranının altında bir azalma. Saf B hücreleri periferik kandaki B hücrelerinin bir alt grubunu ve antijene maruz kalmamış B hücrelerini temsil etmektedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The proportion of naive B cellsin the blood circulation is below the lower limit of normal with respect to the reference range for a given sex and age-group.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
