    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012479">
        <obo:IAO_0000115 xml:lang="tr">Mandibüler hareket (örn, çiğneme) esnasında temporomandibüler eklemden ses gelmesi. Temporomandibüler eklem krepitusu sıklıkla tıklama, patlama, tırmalama sesi olarak tarif edilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Temporomandibüler eklem krepitusu</rdfs:label>
    </rdf:Description>
