        <owl:annotatedTarget xml:lang="tr">Ektodermal displazi deri, saç, tırnaklar veya ter bezlerinin anormal gelişiminin bulunduğu bir grup durumdur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
