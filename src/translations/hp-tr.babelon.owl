    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500076">
        <obo:IAO_0000115 xml:lang="tr">Bir göz sabitlediğinde, diğer gözün yukarı doğru saptığı bir tip dikey tropi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Değişken hipertropi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
