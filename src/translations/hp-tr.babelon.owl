    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002673">
        <obo:IAO_0000115 xml:lang="tr">Coxa valga femur şaftı ve femur boynu arasındaki açının yaşa göre düzeltilmiş değerlere (yetişkinlerde aşamalı olarak 120-130 dereceye düşen yeni doğanlarda yaklaşık 150 derece) göre yükseliş gösterdiği bir kalça deformitesidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Koksa valga</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002673"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Coxa valga femur şaftı ve femur boynu arasındaki açının yaşa göre düzeltilmiş değerlere (yetişkinlerde aşamalı olarak 120-130 dereceye düşen yeni doğanlarda yaklaşık 150 derece) göre yükseliş gösterdiği bir kalça deformitesidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Coxa valga is a deformity of the hip in which the angle between the femoral shaft and the femoral neck is increased compared to age-adjusted values (about 150 degrees in newborns gradually reducing to 120-130 degrees in adults).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
