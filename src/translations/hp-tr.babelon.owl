    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002251"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kolon genişlemesi ile bağırsak tıkanmasına yol açan intestinal gangliyon hücrelerinin (yani bağırsakların agangliyonik bir kısmı) eksikliğinden kaynaklanan bir anormallik</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
