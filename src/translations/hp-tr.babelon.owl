        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000191">
        <obo:IAO_0000115 xml:lang="tr">Alveolar kenardan üst veya alt dudağın iç yüzüne uzanan fazladan doku katlantısı</obo:IAO_0000115>
