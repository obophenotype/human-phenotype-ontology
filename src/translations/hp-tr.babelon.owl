        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001274">
        <obo:IAO_0000115 xml:lang="tr">Hücresel çoğalma ve göç, aksonal büyüme veya orta hatta glial biçimlenmeyi içeren kallozal gelişimin çeşitli basamaklarından herhangi birinin yetersizliğinden kaynaklanan korpus kallozum gelişim yetersizliği sonucu olarak korpus kallozum yokluğu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Korpus kallozum agenezisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001274"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hücresel çoğalma ve göç, aksonal büyüme veya orta hatta glial biçimlenmeyi içeren kallozal gelişimin çeşitli basamaklarından herhangi birinin yetersizliğinden kaynaklanan korpus kallozum gelişim yetersizliği sonucu olarak korpus kallozum yokluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of the corpus callosum as a result of the failure of the corpus callosum to develop, which can be the result of a failure in any one of the multiple steps of callosal development including cellular proliferation and migration, axonal growth or glial patterning at the midline.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001274"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Korpus kallozum agenezisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Agenesis of corpus callosum</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001276">
        <obo:IAO_0000115 xml:lang="tr">Artmış kas tonusunun olduğu bir durum böylelikle örneğin kollar ve bacaklar katıdır ve hareket etmede güçlük çekilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hipertoni</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001276"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Artmış kas tonusunun olduğu bir durum böylelikle örneğin kollar ve bacaklar katıdır ve hareket etmede güçlük çekilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A condition in which there is increased muscle tone so that arms or legs, for example, are stiff and difficult to move.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001276"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
