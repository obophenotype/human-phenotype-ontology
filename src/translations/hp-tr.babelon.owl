        <owl:annotatedTarget xml:lang="tr">Pıhtılaşma faktörü XI&apos;in azalmış aktivitesi. Plazma tromboplastin öncülü olarak da bilinen faktör XI, faktör IX&apos;u aktive eden bir serin proteinazdır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased activity of coagulation factor XI. Factor XI, also known as plasma thromboplastin antecedent, is a serine proteinase that activates factor IX.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
