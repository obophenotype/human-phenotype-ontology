    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010522">
        <obo:IAO_0000115 xml:lang="tr">Bir öğrenme bozukluğu öncelikle okumayı ve hecelemeyi öğrenmede zorluklarla karakterizedir. Disleksi çocukların kelimeleri sağdan sola okuma ve yönelimleri kimlikleri için önemli olan b ve d gibi harfleri karıştırma eğilimi de gösterir. Disleksisi olan çocuklar sesli becerilerde (görsel sembolleri temsil ettikleri seslerle ilişkilendirme becerisi) bozulmuş gibi görünürler</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Disleksi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010522"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir öğrenme bozukluğu öncelikle okumayı ve hecelemeyi öğrenmede zorluklarla karakterizedir. Disleksi çocukların kelimeleri sağdan sola okuma ve yönelimleri kimlikleri için önemli olan b ve d gibi harfleri karıştırma eğilimi de gösterir. Disleksisi olan çocuklar sesli becerilerde (görsel sembolleri temsil ettikleri seslerle ilişkilendirme becerisi) bozulmuş gibi görünürler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A learning disorder characterized primarily by difficulties in learning to read and spell. Dyslectic children also exhibit a tendency to read words from right to left and to confuse letters such as b and d whose orientation is important for their identification. Children with dyslexia appear to be impaired in phonemic skills (the ability to associate visual symbols with the sounds they represent).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010522"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Disleksi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dyslexia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010523">
        <obo:IAO_0000115 xml:lang="tr">Beyne olan zararın okuma kabiliyeti kaybına yol açtığı kazanılmış duyusal bir afazi tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Aleksi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010523"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Beyne olan zararın okuma kabiliyeti kaybına yol açtığı kazanılmış duyusal bir afazi tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An acquired type of sensory aphasia where damage to the brain leads to the loss of the ability to read.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010523"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Aleksi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Alexia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010524">
        <obo:IAO_0000115 xml:lang="tr">Nesneleri, duyusal açıdan değil, duyusal izlenim bileşenlerini eksiksiz bir biçimde birleştirmenin yetersizliği yüzünden tanıyamamak. Böylece, agnozya görme, işitsel veya dokunsal izlenimleri bilmek, isim vermek, tanımlamak ve anlam çıkarmak için yetersizlikle sonuçlanan nörolojik bir durumdur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Agnozi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010524"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Nesneleri, duyusal açıdan değil, duyusal izlenim bileşenlerini eksiksiz bir biçimde birleştirmenin yetersizliği yüzünden tanıyamamak. Böylece, agnozya görme, işitsel veya dokunsal izlenimleri bilmek, isim vermek, tanımlamak ve anlam çıkarmak için yetersizlikle sonuçlanan nörolojik bir durumdur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Alteration or impairment in the processing or interpretation of sensory information can lead to abnormal perceptions or experiences.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010524"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Agnozi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Disturbed sensory perception</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010525">
        <obo:IAO_0000115 xml:lang="tr">Herhangi bir elin hem de başka kişilerin parmakları arasında ayırt etmede yetersizlik veya güçlük</obo:IAO_0000115>
