    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031561">
        <obo:IAO_0000115 xml:lang="tr">Bir koroner arter terminusu arasında myokardiyal kapiller yatağı bypass eden ve sağ ventriküle giren anormal bir bağlantı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sağ ventriküle olan koroner kamara fistülü</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031561"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir koroner arter terminusu arasında myokardiyal kapiller yatağı bypass eden ve sağ ventriküle giren anormal bir bağlantı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal communication between the terminus of a coronary artery, bypassing the myocardial capillary bed and entering the right ventricle.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
