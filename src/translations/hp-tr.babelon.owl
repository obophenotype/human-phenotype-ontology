        <rdfs:label xml:lang="tr">Kronik iritatif konjunktivit</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007717"/>
