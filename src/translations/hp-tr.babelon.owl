    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000845">
        <obo:IAO_0000115 xml:lang="tr">Akromegali, vücudun uç kısımlarının genişlemesinde merkezi rol alan epifizlerin kapalı olduğu kişilerde hipofiz bezi tarafından aşırı büyüme hormonu üretiminden kaynaklanan bir durumdur. Kafatası çapı artar, burun ve dil geniş hale gelir, yüz hatları kabalaşır, mandibula aşırı büyür ve dişler birbirinden ayrılır. El ve ayak parmakları esas olarak kalınlaşır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Büyüme hormonu aşırılığı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000845"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Akromegali, vücudun uç kısımlarının genişlemesinde merkezi rol alan epifizlerin kapalı olduğu kişilerde hipofiz bezi tarafından aşırı büyüme hormonu üretiminden kaynaklanan bir durumdur. Kafatası çapı artar, burun ve dil geniş hale gelir, yüz hatları kabalaşır, mandibula aşırı büyür ve dişler birbirinden ayrılır. El ve ayak parmakları esas olarak kalınlaşır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Acromegaly is a condition resulting from overproduction of growth hormone by the pituitary gland in persons with closed epiphyses, and consists chiefly in the enlargement of the distal parts of the body. The circumference of the skull increases, the nose becomes broad, the tongue becomes enlarged, the facial features become coarsened, the mandible grows excessively, and the teeth become separated. The fingers and toes grow chiefly in thickness.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000845"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Büyüme hormonu aşırılığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elevated circulating growth hormone concentration</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000846">
        <obo:IAO_0000115 xml:lang="tr">Steroid hormonların (primer kortizol) adrenal bezler tarafından, bezlerdeki primer defekt sonucu yetersiz üretimi</obo:IAO_0000115>
