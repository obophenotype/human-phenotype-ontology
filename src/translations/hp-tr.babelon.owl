    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031713">
        <obo:IAO_0000115 xml:lang="tr">Bütün mesafelerde ve bütün zamanlarda gözün dışa döndüğü ıraksal bir strabismus (eksotropiya) formu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sabit ekzotropi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031713"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bütün mesafelerde ve bütün zamanlarda gözün dışa döndüğü ıraksal bir strabismus (eksotropiya) formu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of divergent strabismus (exotropia) in which the eye turns outward at all distances and at all times.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031713"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Sabit ekzotropi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Constant exotropia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031714">
        <obo:IAO_0000115 xml:lang="tr">Esas olarak uzak nesnelere bakıldığında gözün dışa dönme (göz şaşı bakar) eğiliminde olduğu ıraksal bir strabismus (eksotropiya) formu. Gözler yakın nesnelere baktığında düz duema eğilimindedir. Mesafe eksotropiyası sabit veya kesikli olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Mesafe ekzotropisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031714"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Esas olarak uzak nesnelere bakıldığında gözün dışa dönme (göz şaşı bakar) eğiliminde olduğu ıraksal bir strabismus (eksotropiya) formu. Gözler yakın nesnelere baktığında düz duema eğilimindedir. Mesafe eksotropiyası sabit veya kesikli olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of divergent strabismus (exotropia) in which an eye tends to turn outwards (i.e., the eye squints) mainly when looking at distant objects. The eyes tend to remain straight when they look at near objects. Distance exotropia may be constant or intermittent.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031714"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Mesafe ekzotropisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Distance exotropia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031715">
        <obo:IAO_0000115 xml:lang="tr">Uzak sabitlenmede binoküler tek görüşün ve yakında eksotropiyanın olduğu orta dereceli bir eksotropiya (kesikli veya sabit)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yakın ekzotropi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031715"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Uzak sabitlenmede binoküler tek görüşün ve yakında eksotropiyanın olduğu orta dereceli bir eksotropiya (kesikli veya sabit)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An intermittent exotropia where there is binocular single vision on distance fixation and exotropia at near (intermittent or constant).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031715"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Yakın ekzotropi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Near exotropia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031716">
        <obo:IAO_0000115 xml:lang="tr">Binoküler tek görüşün ritmik döngüde geniş açılı eksotropiya ile değiştiği bir eksotropiya tipi (ıraksak strabismus)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Döngüsel ekzotropi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031716"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Binoküler tek görüşün ritmik döngüde geniş açılı eksotropiya ile değiştiği bir eksotropiya tipi (ıraksak strabismus)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of exotropia (divergent strabismus) in which binocular single vision alternates with large angle exotropia in rhythmic cycle.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031716"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Döngüsel ekzotropi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cyclic exotropia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031717">
        <obo:IAO_0000115 xml:lang="tr">Her iki gözden birinin fiksasyon için kullanılabileceği bir ezotropi tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Değişken ekzotropi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031717"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Her iki gözden birinin fiksasyon için kullanılabileceği bir ezotropi tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of exotropia in which either eye may be used for fixation.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031717"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Değişken ekzotropi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Alternating exotropia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031718">
        <obo:IAO_0000115 xml:lang="tr">Önceden ezotropiye veya ezoforiye sahip olmuş bir bireyde ekzotropi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ardışık ekzotropi</rdfs:label>
    </rdf:Description>
