    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005495">
        <obo:IAO_0000115 xml:lang="tr">Frontal sütür bebeklerdeki frontal kemiği iki yarıya böler ve genellikle altı yaşına kadar kaynaşır. Sütür bregmadan (koronal sütürün sagital sütür ile kafatasında dikey olarak kesiştikleri yerden) nasion veya burun köküne kadar uzanır. Bu terim, sütür bregma&apos;dan burun köküne kadar geniş çapta patent veriyorsa geçerlidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Nazal köke patent metopik sütür</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005495"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Frontal sütür bebeklerdeki frontal kemiği iki yarıya böler ve genellikle altı yaşına kadar kaynaşır. Sütür bregmadan (koronal sütürün sagital sütür ile kafatasında dikey olarak kesiştikleri yerden) nasion veya burun köküne kadar uzanır. Bu terim, sütür bregma&apos;dan burun köküne kadar geniş çapta patent veriyorsa geçerlidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The frontal suture divides the two halves of the frontal bone in infants and usually fuses by the age of six years. The suture runs from the bregma (the point on the skull at which the coronal suture is intersected perpendicularly by the sagittal suture) to the nasion or nasal root. This term applies if the suture is widely patent from bregma to nasal root.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005495"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Nazal köke patent metopik sütür</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Metopic suture patent to nasal root</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
