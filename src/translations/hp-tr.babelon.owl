    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002401">
        <obo:IAO_0000115 xml:lang="tr">İnme benzeri bir öykünün ne olduğu konusunda uzlaşma yoktur ama bu öyküler fonksiyonel olarak 24 saatten fazla süren nöbetler bağlamı içinde veya dışında olan yeni bir nörolojik eksiklik olarak tanımlanabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İnme benzeri epizotlar</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002401"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İnme benzeri bir öykünün ne olduğu konusunda uzlaşma yoktur ama bu öyküler fonksiyonel olarak 24 saatten fazla süren nöbetler bağlamı içinde veya dışında olan yeni bir nörolojik eksiklik olarak tanımlanabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>No consensus exists on what a stroke-like episode is, but these episodes can be functionally defined as a new neurological deficit, occurring with or without the context of seizures, which last longer than 24 hours.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
