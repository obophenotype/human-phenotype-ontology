    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010212">
        <obo:IAO_0000115 xml:lang="tr">Birinci ayak (baş) parmağı eklemlerinin bir veya daha fazlasının aktif veya pasif olarak düzeltilemeyecek şekilde bükülmesi (esnemesi)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ayak baş parmağının fleksiyon kontraktürü</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010212"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Birinci ayak (baş) parmağı eklemlerinin bir veya daha fazlasının aktif veya pasif olarak düzeltilemeyecek şekilde bükülmesi (esnemesi)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>One or more bent (flexed) joints of the first (big) toe that cannot be straightened actively or passively.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
