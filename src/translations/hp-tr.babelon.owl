    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030946">
        <obo:IAO_0000115 xml:lang="tr">Yükselmiş doku kitleleri, palpebral konjunktiva üzerinde merkezi bir damar ile bulunur. Papiller inflamatuvar hücrelerin odak infiltrasyonu ile oluşur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Konjonktival papilla</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030946"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Yükselmiş doku kitleleri, palpebral konjunktiva üzerinde merkezi bir damar ile bulunur. Papiller inflamatuvar hücrelerin odak infiltrasyonu ile oluşur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Raised tissue masses located on the palpebral conjunctiva with a central vessel. Papillae are created by a focal infiltration of inflammatory cells.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030946"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Konjonktival papilla</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Conjunctival papillae</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030947">
        <obo:IAO_0000115 xml:lang="tr">Konjonktiva üzerinde belirgin bir merkezi damar bulunmayan kubbe şeklinde küçük nodüller. Lenfoid folliküller konjunktivanın subendotelial bölgesinde bulunurlar. Olgunlaşmamış, çoğalan lenfositleri içeren bir germinal merkezin dışında ayrıca olgun lenfositleri ve plazma hücrelerini içeren bir korona içerirler</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Konjonktival folliküller</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030947"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Konjonktiva üzerinde belirgin bir merkezi damar bulunmayan kubbe şeklinde küçük nodüller. Lenfoid folliküller konjunktivanın subendotelial bölgesinde bulunurlar. Olgunlaşmamış, çoğalan lenfositleri içeren bir germinal merkezin dışında ayrıca olgun lenfositleri ve plazma hücrelerini içeren bir korona içerirler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Small, dome-shaped nodules without a prominent central vessel located on the conjunctiva. The lymphoid follicles are located in the subendothelial region of the conjunctiva. They consist of a germinal center that contains immature, proliferating lymphocytes, as well as a corona that contains mature lymphocytes and plasma cells.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030947"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Konjonktival folliküller</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Conjunctival follicles</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030948">
        <obo:IAO_0000115 xml:lang="tr">Gama-glutamiltransferaz enziminin (GGT) etkinliğinin artması. GGT esas olarak böbrek, karaciğer ve pankreatik hücrelerde bulunur, ancak diğer dokularda da küçük miktarlar bulunur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yükselmiş gama-glutamiltransferaz aktivitesi</rdfs:label>
    </rdf:Description>
