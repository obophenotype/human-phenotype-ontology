        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032245"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Besinlerin girişi için dönüştürülmesi, protein, lipid, nükleik asit ve karbonhidrat sentezi veya atık ürünlerin itrahı dahil süreçler ile ilişkili kimyasal reaksiyonların fonksiyonunda bir anormallik</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality in the function of the chemical reactions related to processes including conversion of food to enter, synthesis of proteins, lipids, nucleic acids, and carbohydrates, or the elimination of waste products.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
