        <owl:annotatedTarget xml:lang="tr">Steroid hormonların (primer kortizol) adrenal bezler tarafından, bezlerdeki primer defekt sonucu yetersiz üretimi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
