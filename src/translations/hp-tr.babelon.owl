    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031069">
        <obo:IAO_0000115 xml:lang="tr">Femur rotasyonu veya femur versiyonu olarak da bilinen femur bürkülme, enine düzlemdeki femurun proksimal ve merkezden uzak kısımları arasındaki bükülmeye başvurur. Femur anteversiyon ortalama doğumda 30-40 derece arasında ve yetişkinlerde 8-14 derece arasında bulunur. Bu terim, eğer femurtorsiyon miktarı bu aralıktan saparsa uygulanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal femoral torsiyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031069"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Femur rotasyonu veya femur versiyonu olarak da bilinen femur bürkülme, enine düzlemdeki femurun proksimal ve merkezden uzak kısımları arasındaki bükülmeye başvurur. Femur anteversiyon ortalama doğumda 30-40 derece arasında ve yetişkinlerde 8-14 derece arasında bulunur. Bu terim, eğer femurtorsiyon miktarı bu aralıktan saparsa uygulanır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Femoral torsion, also known as femoral rotation or femoral version, refers to the twist between the proximal and distal parts of the femur on the transverse plane. Femoral anteversion averages between 30-40 degrees at birth, and between 8-14 degrees in adults. This term applies if the amount of femoral torsion deviates from this range.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031069"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal femoral torsiyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal femoral torsion</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
