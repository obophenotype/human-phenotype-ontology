    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000991">
        <obo:IAO_0000115 xml:lang="tr">Çoklu ksantomların (ksantomata) derideki varlığı. Ksantomlar deride sarımsı, sert, lipid yüklü nodüllerdir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ksantomatozis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000991"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çoklu ksantomların (ksantomata) derideki varlığı. Ksantomlar deride sarımsı, sert, lipid yüklü nodüllerdir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of multiple xanthomas (xanthomata) in the skin. Xanthomas are yellowish, firm, lipid-laden nodules in the skin.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000991"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ksantomatozis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Xanthomatosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000992">
        <obo:IAO_0000115 xml:lang="tr">Derinin ışığa artmış hassaslığı. Fotosensitivite güneşe maruziyet (fotodermatozis) sonrası döküntü ile sonuçlanabilir. Fotosensitiviteye derinin küçük alanlarına ışık tutulması şeklinde olan fototestler ile tanı konabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kutanöz fotosensitivite</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000992"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Derinin ışığa artmış hassaslığı. Fotosensitivite güneşe maruziyet (fotodermatozis) sonrası döküntü ile sonuçlanabilir. Fotosensitiviteye derinin küçük alanlarına ışık tutulması şeklinde olan fototestler ile tanı konabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An increased sensitivity of the skin to light. Photosensitivity may result in a rash upon exposure to the sun (which is known as photodermatosis). Photosensitivity can be diagnosed by phototests in which light is shone on small areas of skin.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000992"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kutanöz fotosensitivite</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cutaneous photosensitivity</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000993">
        <obo:IAO_0000115 xml:lang="tr">Dirsekler ve dizler gibi kolayca travmaya uğrayan alanlar ve baskı noktaları üzerindeki skarlar ile ilişkili mavimsi-gri, süngerimsi nodüller</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Molluskoid psödotümörler</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000993"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Dirsekler ve dizler gibi kolayca travmaya uğrayan alanlar ve baskı noktaları üzerindeki skarlar ile ilişkili mavimsi-gri, süngerimsi nodüller</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bluish-grey, spongy nodules associated with scars over pressure points and easily traumatized areas like the elbows and knees.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000993"/>
