        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100764">
        <obo:IAO_0000115 xml:lang="tr">Lenfanjomalar, çok kistik ya da sünger benzeri yapılarda iyi diferansiye edilmiş lenfatik dokunun fokal çoğalmalarından oluşan nadir konjenital malformasyonlardandır. Lenfanjiyum genelde yumuşak yapıya sahip olduğundan dolayı asemptomatiktir, fakat komşu yapıların sıkışması büyük bir tkitlenin kütle etkisi sebebi ile görülebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Lenfanjiyoma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100764"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Lenfanjomalar, çok kistik ya da sünger benzeri yapılarda iyi diferansiye edilmiş lenfatik dokunun fokal çoğalmalarından oluşan nadir konjenital malformasyonlardandır. Lenfanjiyum genelde yumuşak yapıya sahip olduğundan dolayı asemptomatiktir, fakat komşu yapıların sıkışması büyük bir tkitlenin kütle etkisi sebebi ile görülebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lymphangiomas are rare congenital malformations consisting of focal proliferations of well-differentiated lymphatic tissue in multi cystic or sponge like structures. Lymphangioma is usually asymptomatic due to its soft consistency but compression of adjacent structures can be seen due to the mass effect of a large tumor.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100764"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Lenfanjiyoma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lymphangioma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
