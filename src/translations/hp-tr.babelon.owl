    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010942">
        <obo:IAO_0000115 xml:lang="tr">Fetusun doğumdan önce ultrason muayenesinde artmış ekojenite bulgusu. Odaklar bir veya her iki ventrikülde mevcut olabilir. Ekojenik intrakardiyak odak (EICF), fetal kalpte bir veya iki ventrikülde papiller kas bölgesinde kemik ile karşılaştırılabilir bir ekojenite odaklaması olarak tanımlanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ekojenik intrakardiyak odak</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010942"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Fetusun doğumdan önce ultrason muayenesinde artmış ekojenite bulgusu. Odaklar bir veya her iki ventrikülde mevcut olabilir. Ekojenik intrakardiyak odak (EICF), fetal kalpte bir veya iki ventrikülde papiller kas bölgesinde kemik ile karşılaştırılabilir bir ekojenite odaklaması olarak tanımlanır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A finding of a focus of increased echogenicity upon prenatal ultrasound examination of the fetus. The foci may be present in one or both ventricles. Echogenic intracardiac focus (EICF) is defined as a focus of echogenicity comparable to bone, in the region of the papillary muscle in either or both ventricles of the fetal heart.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010942"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ekojenik intrakardiyak odak</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Echogenic intracardiac focus</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010943">
        <obo:IAO_0000115 xml:lang="tr">Ekojenik bağırsak, etrafını saran kemikten daha fazla ya da ona eşit homojen ekojenite alanları olan fetal bağırsaklardır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ekojenik fetal bağırsak</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010943"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ekojenik bağırsak, etrafını saran kemikten daha fazla ya da ona eşit homojen ekojenite alanları olan fetal bağırsaklardır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Echogenic bowel is defined as fetal bowel with homogenous areas of echogenicity that are equal to or greater than that of surrounding bone.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
