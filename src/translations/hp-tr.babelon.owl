    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009736">
        <obo:IAO_0000115 xml:lang="tr">&quot;Psödoartroz veya tibianın &quot;&quot;yanlış eklemi&quot;&quot;, tibiada doğal kırık ve ardından fibröz kaynamaya ilerleyen gelişimsel bir hatanın sonucudur. Kırık doğumda nadiren görülür, ancak yaygın olarak doğumdan sonraki ilk 18 ay içinde gelişir&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tibiai psödoartroz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009736"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">&quot;Psödoartroz veya tibianın &quot;&quot;yanlış eklemi&quot;&quot;, tibiada doğal kırık ve ardından fibröz kaynamaya ilerleyen gelişimsel bir hatanın sonucudur. Kırık doğumda nadiren görülür, ancak yaygın olarak doğumdan sonraki ilk 18 ay içinde gelişir&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>&quot;Pseudarthrosis, or &quot;&quot;false joint&quot;&quot; of the tibia is the result of a developmental failure in the tibia progressing to spontaneous fracture and subsequent fibrous nonunion. The fracture is rarely present at birth but commonly develops during the first 18 months of life.&quot;</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009736"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Tibiai psödoartroz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tibial pseudarthrosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
