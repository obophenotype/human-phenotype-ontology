    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025506"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Valsalva ya ait sol tarafta konumlanmış sinüsten sağ koroner arterin (RCA) kökeni, Valsalva&apos;nın sağ tarafta konumlanmış sinüsünden sol ana (LM) veya sol ön inen (LAD) koroner arterin ve iki büyük arterin başlangıcıdır. Bu, bu işlem iki damar tarafından arterin sıkıştırılması gibi bazı riskler taşır,</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Origin of the right coronary artery (RCA) from the left sinus of Valsalva or of the left main (LM) or left anterior descending (LAD) coronary artery from the right sinus of Valsalva, with the additional feature that the artery passes between the two great arteries. This carries a risk of the artery being compressed by these two vessels,</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025506"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Koroner arter sandviç anomalisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Coronary artery sandwich anomaly</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
