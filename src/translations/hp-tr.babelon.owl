        <obo:IAO_0000115 xml:lang="tr">&quot;Tekrarlanan talimatlar olmaksızın (gözleri kapalı tutmak, dili dışarı çıkmak, konjonktür bakışı sabit bir yönde sabit tutmak veya uzun süre &quot;&quot;ah&quot;&quot; sesi çıkarmamak gibi), duruşları veya konumları korumak&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Motor devamsızlığı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040200"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">&quot;Tekrarlanan talimatlar olmaksızın (gözleri kapalı tutmak, dili dışarı çıkmak, konjonktür bakışı sabit bir yönde sabit tutmak veya uzun süre &quot;&quot;ah&quot;&quot; sesi çıkarmamak gibi), duruşları veya konumları korumak&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The inability to maintain postures or positions (such as keeping eyes closed, protruding the tongue, maintaining conjugate gaze steadily in a fixed direction, or making a prolonged &apos;ah&apos; sound) without repeated prompts.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
