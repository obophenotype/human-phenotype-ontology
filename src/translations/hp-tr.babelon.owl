    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009624">
        <obo:IAO_0000115 xml:lang="tr">Kemiksiz dokudaki yapısal değişiklikler nedeniyle baş parmağın karpometakarpal ekleminin hareketinin kronik kaybı. Bu eklem, ilk metakarp ve trapez kemik tarafından oluşturulur ve aynı zamanda Articulatio carpometacarpalis pollicis, baş parmağın karpometakarpal eklemi, başparmağın karpometakarpal eklemi veya eklemin ilk karpometakarpal artikülasyonu olarak da adlandırılır. Nadiren başparmak birliği olarak anılır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Baş parmağın karpometakarpal ekleminin kontraktürleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009624"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kemiksiz dokudaki yapısal değişiklikler nedeniyle baş parmağın karpometakarpal ekleminin hareketinin kronik kaybı. Bu eklem, ilk metakarp ve trapez kemik tarafından oluşturulur ve aynı zamanda Articulatio carpometacarpalis pollicis, baş parmağın karpometakarpal eklemi, başparmağın karpometakarpal eklemi veya eklemin ilk karpometakarpal artikülasyonu olarak da adlandırılır. Nadiren başparmak birliği olarak anılır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic loss of joint motion of the carpometacarpal joint of the thumb due to structural changes in non-bony tissue. This joint is formed by the first metacarpal and the trapezial bone and is also called Articulatio carpometacarpalis pollicis, carpometacarpal articulation of thumb, carpometacarpal joint of thumb or first carpometacarpal articulation. Seldom referred to as thumb saddle joint.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009624"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Baş parmağın karpometakarpal ekleminin kontraktürleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Carpometacarpal thumb joint contracture</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009625">
        <obo:IAO_0000115 xml:lang="tr">Kemiksi olmayan dokudaki yapısal değişikliklere bağlı olarak baş parmağın metakarpofalangeyal ekleminin kronik eklem hareketi kaybı. Bu eklem Articulatio metacarpophalangealis pollicis olarak da adlandırılır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Baş parmağın metakarpofalangeyal ekleminin kontraktürleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009625"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kemiksi olmayan dokudaki yapısal değişikliklere bağlı olarak baş parmağın metakarpofalangeyal ekleminin kronik eklem hareketi kaybı. Bu eklem Articulatio metacarpophalangealis pollicis olarak da adlandırılır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic loss of joint motion of the metacarpophalangeal joint of the thumb due to structural changes in non-bony tissue. This joint is also called Articulatio metacarpophalangealis pollicis.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
