        <owl:annotatedTarget xml:lang="tr">1. metakarpalin çoklu kemik parçalarına sahip epifizi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Epiphysis of the 1st metacarpal having multiple bony fragments.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
