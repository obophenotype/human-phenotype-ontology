    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032016">
        <obo:IAO_0000115 xml:lang="tr">Solunum sisteminden tükürerek çıkarılan (öksürerek çıkarmak) ve mukustan oluşan fakat püy, kan, mikroorganizma ve fibrin gibi diğer maddeleri içerebilen materyalin anormal görnümü</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal balgam</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032016"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Solunum sisteminden tükürerek çıkarılan (öksürerek çıkarmak) ve mukustan oluşan fakat püy, kan, mikroorganizma ve fibrin gibi diğer maddeleri içerebilen materyalin anormal görnümü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal appearance of material expectorated (coughed up) from the respiratory system and that is composed of mucus but may contain other substances such as pus, blood, microorganisms, and fibrin.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
