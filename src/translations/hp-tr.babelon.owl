        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal branching pattern of the aortic arch</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011588">
        <obo:IAO_0000115 xml:lang="tr">Aortik ark aşagı inen aorta olmak için aşagıya dönmeden önce boynun yumuşak dokuları içine uzanır</obo:IAO_0000115>
