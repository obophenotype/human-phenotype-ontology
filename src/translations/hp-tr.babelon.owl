    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007822">
        <rdfs:label xml:lang="tr">Merkezi retinal eksudat</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007822"/>
