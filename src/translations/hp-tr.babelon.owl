    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009695">
        <obo:IAO_0000115 xml:lang="tr">El baş parmağının bir veya daha fazla epifizinde anormal punktat (benekli, nokta gibi) kireçlenme varlığı</obo:IAO_0000115>
