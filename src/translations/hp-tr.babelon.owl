        <owl:annotatedTarget xml:lang="tr">Antitragusun anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal antitragus morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009897">
        <obo:IAO_0000115 xml:lang="tr">Heliks krusunun anormal yatay aks oryantasyonu. Bu, heliks krusunun inferoposterior olarak eğiminden ziyade ana aksı kulağın mediyal longitidunal aksına diktir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Heliksin yatay krusu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009897"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Heliks krusunun anormal yatay aks oryantasyonu. Bu, heliks krusunun inferoposterior olarak eğiminden ziyade ana aksı kulağın mediyal longitidunal aksına diktir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal horizontal axis orientation of the crus of the helix. That is, the main axis of the crus of the helix is perpendicular to the medial longitudinal axis of the ear, instead of sloping inferoposteriorly.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
