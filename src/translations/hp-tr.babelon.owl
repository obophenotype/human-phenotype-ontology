    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009687">
        <obo:IAO_0000115 xml:lang="tr">Parantez epifizi, epifizin bir falanks kemiğini çevrelediği, parantez benzeri bir forma sahip olduğu ve falanksın proksimal tarafından distal tarafına kadar uzandığı bir anormallik anlamına gelir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Baş parmağın parantez şeklinde epifizi</rdfs:label>
    </rdf:Description>
