    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001105">
        <obo:IAO_0000115 xml:lang="tr">İlişkili retinal fotoseptör kaybı ile retinal pigment epitelinin atrofisini yansıtan, fundusta kısmen veya tamamen depigmentasyonun iyi-demarke alanı(ları)</obo:IAO_0000115>
