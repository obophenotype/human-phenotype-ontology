        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025472">
        <obo:IAO_0000115 xml:lang="tr">Genellikle pullanma, maserasyon ve kaşınma ile ortaya çıkan ayak tabanında yer alan tekrarlayan fungal enfeksiyon öyküsü</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tekrarlayan plantar mikoz</rdfs:label>
    </rdf:Description>
