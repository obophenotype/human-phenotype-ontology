    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010945">
        <obo:IAO_0000115 xml:lang="tr">Hafif piyelektazi, en az 5 mm ve en fazla 10 mm ölçülen böbrek pelvis içinde hipoekoik küresel veya eliptik boşluk olarak tanımlanır. Ölçüm, maksimum anterior-to-posterior ölçümü kullanılarak yanal böbrek pelvisi sayesinde aykırı kesit üzerinde tutulmuştur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fetal piyalektezi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010945"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hafif piyelektazi, en az 5 mm ve en fazla 10 mm ölçülen böbrek pelvis içinde hipoekoik küresel veya eliptik boşluk olarak tanımlanır. Ölçüm, maksimum anterior-to-posterior ölçümü kullanılarak yanal böbrek pelvisi sayesinde aykırı kesit üzerinde tutulmuştur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mild pyelectasis is defined as a hypoechoic spherical or elliptical space within the renal pelvis that measures at least 5mm and not more than 10 mm. The measurement is taken on a transverse section through the fetal renal pelvis using the maximum anterior-to-posterior measurement.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010945"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Fetal piyalektezi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fetal pyelectasis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
