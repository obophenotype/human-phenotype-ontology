        <owl:annotatedTarget xml:lang="tr">Sözlü olmayan davranışların bozulmuş kullanımı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal nonverbal communicative behavior</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000759">
        <obo:IAO_0000115 xml:lang="tr">Merkezi sinir sistemine doğru ilerleyen veya oradan dallanan sinirlerden oluşan periferik sinir sisteminin anormalliği. Kafa sinirlerini de içermektedir (olfaktör ve optik sinirler teknik olarak merkezi sinir sisteminin parçasıdır)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal periferik sinir sistemi morfolojisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000759"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Merkezi sinir sistemine doğru ilerleyen veya oradan dallanan sinirlerden oluşan periferik sinir sisteminin anormalliği. Kafa sinirlerini de içermektedir (olfaktör ve optik sinirler teknik olarak merkezi sinir sisteminin parçasıdır)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A structural abnormality of the peripheral nervous system, which is composed of the nerves that lead to or branch off from the central nervous system. This includes the cranial nerves (olfactory and optic nerves are technically part of the central nervous system).</babelon:source_value>
