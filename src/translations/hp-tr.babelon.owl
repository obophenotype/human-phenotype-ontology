        <rdfs:label xml:lang="tr">Anormal kemik kollajen lif morfolojisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011862"/>
