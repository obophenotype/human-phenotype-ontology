        <obo:IAO_0000115 xml:lang="tr">Aortik kemerin normal olarak (sağ aortik kemere karşıt olarak) sola doğru indiği, sağ brakiyosefalik arter, sol genel karotid arteri, sol subklavian arter veya proksimal vertebral arterlerin kökeni veya seyrinin normundan deviasyonu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sol aortik arkın anormal dallanma paterni</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031055"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Aortik kemerin normal olarak (sağ aortik kemere karşıt olarak) sola doğru indiği, sağ brakiyosefalik arter, sol genel karotid arteri, sol subklavian arter veya proksimal vertebral arterlerin kökeni veya seyrinin normundan deviasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deviance from the norm of the origin or course of the right brachiocephalic artery, the left common carotid artery, the left subclavian artery or the proximal vertebral arteries, whereby the aortic arch descends on the left as normal (as opposed to right aortic arch).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
