    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011641">
        <obo:IAO_0000115 xml:lang="tr">Koroner arterlerin biri ve kalp odacığı veya başka kan damarları arasında anormal bağlantılı konjenital bir malformasyon</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Koroner arter fistülü</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011641"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Koroner arterlerin biri ve kalp odacığı veya başka kan damarları arasında anormal bağlantılı konjenital bir malformasyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A congenital malformation with abnormal connection between one of the coronary arteries and a heart chamber or another blood vessel.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011641"/>
