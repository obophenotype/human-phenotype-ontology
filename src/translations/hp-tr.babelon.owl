        <owl:annotatedTarget xml:lang="tr">Kas dokusunda azalmış kollajen VI miktarı. Kollajen VI birincil olarak iskelet kası ekstraselüler matriksi ile ilişkilidr</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A decreased amount of collagen VI in muscle tissue. Collagen VI is a primarily associated with the extracellular matrix of skeletal muscle.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
