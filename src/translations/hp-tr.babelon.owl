        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003185"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kemik pelvisindeki sakroiliak eklem, güçlü ligamentler ile birleştirilen sakrum ve pelvis ilyasını birbirine bağlar. Çentik, eklemin doğrudan üstünde bulunur. Bu terim, çentiğin yüksekliğinde bir azalmaya işaret eder</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The sacroiliac joint in the bony pelvis connects the sacrum and the ilium of the pelvis, which are joined by strong ligaments. The notch is located directly superior to the joint. This term refers to a reduction in the height of the notch.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
