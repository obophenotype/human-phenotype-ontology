        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009412">
        <obo:IAO_0000115 xml:lang="tr">Elin 3. parmağının epifizlerinin koni biçimli bir görünüşü, &apos;soket içinde bir top&apos; görüntüsü üretir. İlgili varlık &apos;melek şekilli&apos; epifiz, bir falanksın distal ucunda bir psödoepfiz ile birlikte belirgin bir koni şekilli epifizi ifade eder</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">3. el parmağının koni şekilli epifizleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
