        <obo:IAO_0000115 xml:lang="tr">Motor yeteneğinde konuşmayı sağlayan bir defekt</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anartri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002425"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Motor yeteneğinde konuşmayı sağlayan bir defekt</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A defect in the motor ability that enables speech.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
