    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009145">
        <obo:IAO_0000115 xml:lang="tr">Serebral arterde herhangi bir yapısal anormallik. Serebral arter beynin serebrumunu destekleyen üç adet ana atardamar çiftinden ve onların dallarından oluşur. Bunlar anteriyor serebral arter, orta serebral arter ve posteriyor serebral arterdir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal serebral arter morfolojisi</rdfs:label>
    </rdf:Description>
