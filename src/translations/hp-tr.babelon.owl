        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal optic chiasm morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025164">
        <obo:IAO_0000115 xml:lang="tr">Retiküler dermiste hücre dışı matristeki protein ve glikoprotein yığınları olan, elastik liflerin sayısının artması. Elastik lifler esnetilebilir ve orijinal uzunluğuna geri çekilebilir. Bu özellik, hematoksilin ve eozin veya diğer yöntemlerle histolojide değerlendirilebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dermiste elastik liflerin artmış sayısı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025164"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Retiküler dermiste hücre dışı matristeki protein ve glikoprotein yığınları olan, elastik liflerin sayısının artması. Elastik lifler esnetilebilir ve orijinal uzunluğuna geri çekilebilir. Bu özellik, hematoksilin ve eozin veya diğer yöntemlerle histolojide değerlendirilebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An elevated number of elastic fibers, that is of bundles of proteins and glycoproteins in the extracellular matrix in the reticular dermis. Elastic fibers can stretch and recoil back to their original length. This feature can be appreciated on histology with hematoxylin and eosin or other staining methods.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025164"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Dermiste elastik liflerin artmış sayısı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased number of elastic fibers in the dermis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025165">
        <obo:IAO_0000115 xml:lang="tr">Dermis içinde (özellikle retiküler dermis) elastik liflerden küçük yumrular oluşturan küme veya birikim oluşumu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dermiste elastik liflerin kümeleşmesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025165"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Dermis içinde (özellikle retiküler dermis) elastik liflerden küçük yumrular oluşturan küme veya birikim oluşumu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Formation of clumps or aggregates that make up small protuberances from elastic fibers within the dermis (especially the reticular dermis).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025165"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Dermiste elastik liflerin kümeleşmesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
