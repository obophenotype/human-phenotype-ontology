    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012657">
        <obo:IAO_0000115 xml:lang="tr">Pozitron emisyon tomografisi (PET) ile tespit edilebilen fonksiyonel bir beyin anomalisi. PET taraması fonksiyonel beyin görüntülemesi metodudur, ölçümleri beynin çeşitli bölgelerindeki beyin aktivitesi miktarını yansıtır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal beyin pozitron emisyon tomografisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012657"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Pozitron emisyon tomografisi (PET) ile tespit edilebilen fonksiyonel bir beyin anomalisi. PET taraması fonksiyonel beyin görüntülemesi metodudur, ölçümleri beynin çeşitli bölgelerindeki beyin aktivitesi miktarını yansıtır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A functional brain anomaly detectable by positron emission tomography (PET). PET scanning is a method for functional brain imaging, and its measurements reflect the amount of brain activity in the various regions of the brain.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
