        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kemiksi olmayan dokuda yapısal değişiklikler yüzünden 4. parmağın distal interfalanksiyal ekleminde kronik eklem hareketi kaybı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic loss of joint motion of the distal interphalangeal joint of the 4th finger due to structural changes in non-bony tissue.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
