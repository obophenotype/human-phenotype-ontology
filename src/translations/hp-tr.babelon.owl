        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007818"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İrisin orta (periferil) bölümünde, orta periferik (siliyer) bölgeden farklı renklerin oluşu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of distinct colors in the central (pupillary) zone of the iris than in the mid-peripheral (ciliary) zone.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
