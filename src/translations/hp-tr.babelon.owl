        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031853">
        <obo:IAO_0000115 xml:lang="tr">İzomerizm, doğumsal olarak malforme kalp bağlamında vücut sol-sağ aksının karşı tarafında bazı eşli yapıların morfolojik terimle birbirinin simetrik ayna görüntüsünde olmasıdır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İzomerizm</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031853"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İzomerizm, doğumsal olarak malforme kalp bağlamında vücut sol-sağ aksının karşı tarafında bazı eşli yapıların morfolojik terimle birbirinin simetrik ayna görüntüsünde olmasıdır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Isomerism in the context of the congenitally malformed heart is defined as a situation where some paired structures on opposite sides of the left-right axis of the body are, in morphologic terms, symmetrical mirror images of each other.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031853"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">İzomerizm</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Isomerism</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031854">
        <obo:IAO_0000115 xml:lang="tr">Sağ izomerizm vücut sol-sağ aksının karşı tarafında bazı eşli yapıların birbirinin simetrik ayna görüntüsünde olduğu bir heterotaksi tipi ve normal sol taraflı yapıların morfolojisine sahiptir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sol izomerizm</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031854"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sağ izomerizm vücut sol-sağ aksının karşı tarafında bazı eşli yapıların birbirinin simetrik ayna görüntüsünde olduğu bir heterotaksi tipi ve normal sol taraflı yapıların morfolojisine sahiptir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of heterotaxy where some paired structures on opposite sides of the left-right axis of the body are symmetrical mirror images of each other, and have the morphology of the normal left-sided structures.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
