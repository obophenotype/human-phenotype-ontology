        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010761">
        <obo:IAO_0000115 xml:lang="tr">Artmış kolumella genişliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Geniş kolumella</rdfs:label>
    </rdf:Description>
