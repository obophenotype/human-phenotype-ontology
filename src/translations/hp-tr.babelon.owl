        <babelon:source_value>Abnormal medullary pyramid morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025362">
        <obo:IAO_0000115 xml:lang="tr">Renal korteksin ve papilla olarak adlandırılan dar apeks yanında geniş tabanlı koni şekilli yapılar olan erişkin böbrek piramidinin tam gelişmemesi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Böbrek medüller piramit hipoplazisi</rdfs:label>
    </rdf:Description>
