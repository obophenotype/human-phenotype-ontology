    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0410281">
        <obo:IAO_0000115 xml:lang="tr">Epigastrik bölgede lokalize olan heterojen bir semptom grubu. Tipik dispeptik semptomlar postprandial dolgunluk, erken doygunluk, epigastrik ağrı ve epigastrik yanmayı içerir, ancak bulantı, geğirme veya abdominal şişkinlik gibi diğer üst gastrointestinal semptomlar sıklıkla ortaya çıkar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dispepsi</rdfs:label>
    </rdf:Description>
