        <owl:annotatedTarget xml:lang="tr">Her iki göz açık iken bir gözün aşağıya deviye olduğu bir strabismus (heterotropiya) belirti formu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
