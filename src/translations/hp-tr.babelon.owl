    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012003">
        <obo:IAO_0000115 xml:lang="tr">Hayatta tecrübe edilenlere benzer şekilde öznel nitelikli duygusal auralar gerçek şartlar dışında meydana geldiği özne tarafından farkına varılır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Duygusal auralar</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012003"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hayatta tecrübe edilenlere benzer şekilde öznel nitelikli duygusal auralar gerçek şartlar dışında meydana geldiği özne tarafından farkına varılır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Affective auras with subjective qualities similar to those experienced in life but are recognized by the subject as occurring outside of actual context.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
