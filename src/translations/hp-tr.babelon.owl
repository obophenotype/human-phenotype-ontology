    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030431">
        <obo:IAO_0000115 xml:lang="tr">Uzun bir kemiğin kıkırdak başlıklı kemiksi aşırı büyümesi. Osteokondroma alttaki kemik ile devamlılıkta olan ilik boşluğu içeren kemiğin dış yüzeyinde gelişir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Osteokondrom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030431"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Uzun bir kemiğin kıkırdak başlıklı kemiksi aşırı büyümesi. Osteokondroma alttaki kemik ile devamlılıkta olan ilik boşluğu içeren kemiğin dış yüzeyinde gelişir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A cartilage capped bony outgrowth of a long bone. Osteochondroma arises on the external surface of bone containing a marrow cavity that is continuous with that of the underlying bone.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
