    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100807">
        <obo:IAO_0000115 xml:lang="tr">Orta parmak doğumdan 16 yaşına kadar olan çocuklar için 27-41 hafta EGA ya da 97. persantilin üzerindeki yenidoğanlar için ortalaması 2 SD&apos;den fazla ve beş basamak normal uzunluk oranlarını birbirine göre korur (yani, orta parmağın tek uzatılmış parmak olduğu durumda değil), veya elin avuç içi kıyasla orantısız olarak uzun parmaklar görülür</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Uzun parmaklar</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100807"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Orta parmak doğumdan 16 yaşına kadar olan çocuklar için 27-41 hafta EGA ya da 97. persantilin üzerindeki yenidoğanlar için ortalaması 2 SD&apos;den fazla ve beş basamak normal uzunluk oranlarını birbirine göre korur (yani, orta parmağın tek uzatılmış parmak olduğu durumda değil), veya elin avuç içi kıyasla orantısız olarak uzun parmaklar görülür</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The middle finger is more than 2 SD above the mean for newborns 27 to 41 weeks EGA or above the 97th centile for children from birth to 16 years of age AND the five digits retain their normal length proportions relative to each other (i.e., it is not the case that the middle finger is the only lengthened digit), or, Fingers that appear disproportionately long compared to the palm of the hand.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100807"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Uzun parmaklar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Long fingers</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
