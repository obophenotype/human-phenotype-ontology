        <babelon:source_value>Left anterior fascicular block</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011712">
        <obo:IAO_0000115 xml:lang="tr">His demetinin sağ dalının bir iletim bloğu. Sağ ventrikülün gecikmiş aktivasyonu ve EKG&apos;de terminal gecikme ile QRS kompleksinin uzaması (0.12 sn&apos;den daha büyük) olarak ortaya çıkar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sağ demet dal bloğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011712"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">His demetinin sağ dalının bir iletim bloğu. Sağ ventrikülün gecikmiş aktivasyonu ve EKG&apos;de terminal gecikme ile QRS kompleksinin uzaması (0.12 sn&apos;den daha büyük) olarak ortaya çıkar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A conduction block of the right branch of the bundle of His. This manifests as a prolongation of the QRS complex (greater than 0.12 s) with delayed activation of the right ventricle and terminal delay on the EKG.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011712"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Sağ demet dal bloğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complete right bundle branch block</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011713">
        <obo:IAO_0000115 xml:lang="tr">His demetinin sağ dalının bir iletim bloğu. EKG&apos;de QRS morfolojisinin genel düzensizliği olarak ortaya çıkar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sol demet dal bloğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011713"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">His demetinin sağ dalının bir iletim bloğu. EKG&apos;de QRS morfolojisinin genel düzensizliği olarak ortaya çıkar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A conduction block of the left branch of the bundle of His. This manifests as a generalized disturbance of QRS morphology on EKG.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
