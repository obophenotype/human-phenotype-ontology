        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Snowball lesion of corpus callosum</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031949">
        <obo:IAO_0000115 xml:lang="tr">Üst solunum sistemi bakteriyel enfeksiyonlarına karşı artmış hassasiyet kendini tekrarlayan bakteriyel üst solunum sistemi enfeksiyonları (iltihaplı kulaklar- kulak iltihabı, sinüzit, farenjit, bademcik iltihabı) seklinde gösterir</obo:IAO_0000115>
