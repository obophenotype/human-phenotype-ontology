    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032051">
        <obo:IAO_0000115 xml:lang="tr">Bozulmuş kortikal tabakalanma ve özel sitolojik anormallikler ile karakterize bir fokal kortikal displazi tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fokal kortikal displazi tip II</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032051"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bozulmuş kortikal tabakalanma ve özel sitolojik anormallikler ile karakterize bir fokal kortikal displazi tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of focal cortical dysplasia that is characterized by disrupted cortical lamination and specific cytological abnormalities.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032051"/>
