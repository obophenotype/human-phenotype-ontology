    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031433">
        <obo:IAO_0000115 xml:lang="tr">Diğerleri ile ayrılmış bağlantının eşlik ettiği, başkalarında duyguların yüz ipuçlarına veya diğer işaretlerine yanıt olarak sınırlı kabiliyet ile ortaya konan, hisleri ve duyguları tanımlamada ve ifade etmede zorluk ile karakterize duygusal farkındalıkta bir eksiklik</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Aleksitimi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031433"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Diğerleri ile ayrılmış bağlantının eşlik ettiği, başkalarında duyguların yüz ipuçlarına veya diğer işaretlerine yanıt olarak sınırlı kabiliyet ile ortaya konan, hisleri ve duyguları tanımlamada ve ifade etmede zorluk ile karakterize duygusal farkındalıkta bir eksiklik</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Alexithymia is characterized by an impaired ability to be aware of, explicitly identify, and describe one&apos;s feelings.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031433"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Aleksitimi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Alexithymia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031434">
        <obo:IAO_0000115 xml:lang="tr">Ses şiddeti varyasyonları, duraksama, söyleyiş gücü ve ritmi içeren tonlama, stres paterni, konuşmanın ifadesel paterninin bir anomalisi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal konuşma vezni</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031434"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ses şiddeti varyasyonları, duraksama, söyleyiş gücü ve ritmi içeren tonlama, stres paterni, konuşmanın ifadesel paterninin bir anomalisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Prosody refers to the patterns of rhythm, stress, and intonation in spoken language. Abnormal prosody refers to abnormalities in the patterns of rhythm, stress, or intonation of speech or vocalization that can be heard by the observer. In general, this refers to overt and clear deviations in patterns from culturally accepted norms but many also include differences noted in comparison to the usual patterns of the individual (a quiet person suddenly becomes loud or vice versa).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031434"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal konuşma vezni</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal prosody</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031435">
        <obo:IAO_0000115 xml:lang="tr">Ses perdesinin anormal olarak azalmış veya eksik olan değişkenliği ile karakterize bir konuşma paterni</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Monotonik konuşma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031435"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ses perdesinin anormal olarak azalmış veya eksik olan değişkenliği ile karakterize bir konuşma paterni</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A speech pattern characterized by a persistently abnormal lack of tone in the voice. Monotonic speech is typically ongoing, lasting throughout the day, but may have a diurnal variation in the pattern, i.e. slower at specific times of the day.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031435"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Monotonik konuşma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Monotonic speech</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031436">
        <obo:IAO_0000115 xml:lang="tr">Ses perdesinin anormal olarak yükselmiş değişkenliği ile karakterize bir konuşma paterni</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Konuşmanın artmış perde değişkenliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031436"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ses perdesinin anormal olarak yükselmiş değişkenliği ile karakterize bir konuşma paterni</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A speech pattern characterized by abnormal fluctuations in the pitch of the voice.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031436"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Konuşmanın artmış perde değişkenliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
