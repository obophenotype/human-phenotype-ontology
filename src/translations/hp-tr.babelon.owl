        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025123"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çizgilenme veya lekelenme formunda diş (enamel) yüzeyinde görülebilir beyaz renk değişimi alanları</owl:annotatedTarget>
