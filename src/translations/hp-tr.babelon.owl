    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009636">
        <obo:IAO_0000115 xml:lang="tr">Baş parmağın üçgen şekilli proksimal falanksı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Baş parmağın üçgen şekilli proksimal falanksı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009636"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
