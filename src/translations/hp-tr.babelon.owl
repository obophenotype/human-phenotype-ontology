    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003774">
        <obo:IAO_0000115 xml:lang="tr">Glomerüler filtrasyon hızında (15 ml/dk/1.73 m2&apos;den az) ciddi bir azalma ve serum kreatinin düzeyinde artış gibi diğer belirtilerle karakterize, hayatta kalmak için diyaliz ya da böbrek transplantasyonunu gerektirecek düzeyde ciddi böbrek yetmezliği derecesi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Evre 5 kronik böbrek hastalığı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003774"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Glomerüler filtrasyon hızında (15 ml/dk/1.73 m2&apos;den az) ciddi bir azalma ve serum kreatinin düzeyinde artış gibi diğer belirtilerle karakterize, hayatta kalmak için diyaliz ya da böbrek transplantasyonunu gerektirecek düzeyde ciddi böbrek yetmezliği derecesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A degree of kidney failure severe enough to require dialysis or kidney transplantation for survival characterized by a severe reduction in glomerular filtration rate (less than 15 ml/min/1.73 m2) and other manifestations including increased serum creatinine.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
