        <owl:annotatedTarget xml:lang="tr">Ventriküler hipertrofi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ventricular hypertrophy</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001716">
        <obo:IAO_0000115 xml:lang="tr">Anormal bir aksesuar atriyoventriküler elektriksel iletim yolunun varlığına bağlı ventriküler önceden uyarma ile karakterize edilen kalbin kardiyak iletim sistemindeki bir bozukluk</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Wolff-Parkinson-White sendromu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001716"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Anormal bir aksesuar atriyoventriküler elektriksel iletim yolunun varlığına bağlı ventriküler önceden uyarma ile karakterize edilen kalbin kardiyak iletim sistemindeki bir bozukluk</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A disorder of the cardiac conduction system of the heart characterized by ventricular preexcitation due to the presence of an abnormal accessory atrioventricular electrical conduction pathway.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
