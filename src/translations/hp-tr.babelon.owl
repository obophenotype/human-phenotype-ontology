    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004841">
        <obo:IAO_0000115 xml:lang="tr">Azalmış pıhtılaşma faktörü XII aktivitesi. Faktör XII (fXII) intrensek pıhtılaşma yolağının bir parçasıdır ve yüksek MA kininojen ve kallikrein tarafından aktive edilen, böylelikle koagülasyon kaskadını başlatan damar duvarı zedelenme alanında açığa çıkan kollajene bağlanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Azalmış faktör XII aktivitesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
