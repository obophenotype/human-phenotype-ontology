    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012466">
        <obo:IAO_0000115 xml:lang="tr">Ventilasyondaki uzun süreli bozukluk öyle ki, böbrek kompansasyonuna sekonder olan normal veya normale yakın normal pH ve serum bikarbonat seviyesinin yükselmesiyle (30 mEq/L&apos;den fazla) beraber, karbondioksitin kısmi basıncının (PaCO2) referans aralığının üst sınırının (45 mm Hg&apos;ın üstünde) üzerine çıkması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kronik respiratuar asidoz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012466"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ventilasyondaki uzun süreli bozukluk öyle ki, böbrek kompansasyonuna sekonder olan normal veya normale yakın normal pH ve serum bikarbonat seviyesinin yükselmesiyle (30 mEq/L&apos;den fazla) beraber, karbondioksitin kısmi basıncının (PaCO2) referans aralığının üst sınırının (45 mm Hg&apos;ın üstünde) üzerine çıkması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Longstanding impairment in ventilation such that the partial pressure of carbon dioxide (PaCO2) is elevated above the upper limit of the reference range (more than 45 mm Hg), with a normal or near-normal pH secondary to renal compensation and an elevated serum bicarbonate levels (more than30 mEq/L).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012466"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kronik respiratuar asidoz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic respiratory acidosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012467">
        <obo:IAO_0000115 xml:lang="tr">Solunum sisteminde karbondioksitin alınmasının dokulardaki karbon dioksit üretiminden daha düşük olacağı şekilde ventilasyonda bozulma aniden başlamış ve karbondioksit kısmi basıncının (PaCO2) normal sınırların üzerine çıkmasına (daha fazla 45 mm Hg) eşlik eden bir asidemidir.(pH 7.35&apos;den düşük)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Akut respiratuar asidoz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012467"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Solunum sisteminde karbondioksitin alınmasının dokulardaki karbon dioksit üretiminden daha düşük olacağı şekilde ventilasyonda bozulma aniden başlamış ve karbondioksit kısmi basıncının (PaCO2) normal sınırların üzerine çıkmasına (daha fazla 45 mm Hg) eşlik eden bir asidemidir.(pH 7.35&apos;den düşük)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sudden onset of impairment in ventilation such that the removal of carbon dioxide by the respiratory system is less than the production of carbon dioxide in the tissues, leading to an elevation of the partial pressure of carbon dioxide (PaCO2) above the normal limits (more than 45 mm Hg) with an accompanying acidemia (pH less than 7.35).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012467"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Akut respiratuar asidoz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Acute respiratory acidosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
