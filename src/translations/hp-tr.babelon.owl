        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0200032">
        <obo:IAO_0000115 xml:lang="tr">Korneanın dış kenarındaki derin epitel tabakalarında gri-yeşil veya kahverengimsi pigmentli halka</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kayser-Fleischer halkası</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200032"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Korneanın dış kenarındaki derin epitel tabakalarında gri-yeşil veya kahverengimsi pigmentli halka</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Grey-green or brownish-pigmented ring in the deep epithelial layers at the outer border of the cornea.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200032"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kayser-Fleischer halkası</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Kayser-Fleischer ring</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0200034">
        <obo:IAO_0000115 xml:lang="tr">Görünür bir sıvısı olmayan, bir cımbızdan daha geniş noktasında 10 mm&apos;den daha küçük çapta değişen ciltli, katı bir cilt kabarması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Papül</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200034"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Görünür bir sıvısı olmayan, bir cımbızdan daha geniş noktasında 10 mm&apos;den daha küçük çapta değişen ciltli, katı bir cilt kabarması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A circumscribed, solid elevation of skin with no visible fluid, varying in size from a pinhead to less than 10mm in diameter at the widest point.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200034"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Papül</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Papule</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0200035">
        <obo:IAO_0000115 xml:lang="tr">Bir plak sert, kabarık, plato benzeri (üstü düzleşmiş) 1 cm çapından daha büyük bir lezyondur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Deri plağı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200035"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir plak sert, kabarık, plato benzeri (üstü düzleşmiş) 1 cm çapından daha büyük bir lezyondur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A plaque is a solid, raised, plateau-like (flat-topped) lesion greater than 1 cm in diameter.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200035"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Deri plağı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Skin plaque</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0200036">
        <obo:IAO_0000115 xml:lang="tr">Morfolojik açıdan bir papüle benzemekle birlikte hem genişlik hem de derinlik olarak 10 mm&apos;den daha büyüktür ve sıklıkla deri veya deri altı yağda ortalanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Deri nodülü</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200036"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Morfolojik açıdan bir papüle benzemekle birlikte hem genişlik hem de derinlik olarak 10 mm&apos;den daha büyüktür ve sıklıkla deri veya deri altı yağda ortalanır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Morphologically similar to a papule, but greater than either 10mm in both width and depth, and most frequently centered in the dermis or subcutaneous fat.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200036"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Deri nodülü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Skin nodule</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0200037">
        <obo:IAO_0000115 xml:lang="tr">Çapraz, sıvı içeren, epidermal yükselme genellikle en geniş noktada çapı 10 mm&apos;den az olarak kabul edilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Cilt vezikülü</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200037"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çapraz, sıvı içeren, epidermal yükselme genellikle en geniş noktada çapı 10 mm&apos;den az olarak kabul edilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A circumscribed, fluid-containing, epidermal elevation less than 10mm in diameter at the widest point that (i) Contain serous exudates or serum mixed with blood or pus; (ii) Are discrete, grouped, irregularly distributed, or linear as in Rhus dermatitis; (iii) Are short-lived. Vesicles may break spontaneously or evolve into bullae by enlarging or coalescing with other vesicles.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200037"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Cilt vezikülü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Skin vesicle</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0200039">
        <obo:IAO_0000115 xml:lang="tr">Genellikle nekrotik inflamatuvar hücrelerden oluşan bulutlu veya pürülan materyal içeren küçük bir deri kabarıklığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Püstül</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200039"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Genellikle nekrotik inflamatuvar hücrelerden oluşan bulutlu veya pürülan materyal içeren küçük bir deri kabarıklığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A small elevation of the skin containing cloudy or purulent material usually consisting of necrotic inflammatory cells.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200039"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Püstül</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pustule</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0200040">
        <obo:IAO_0000115 xml:lang="tr">Çapı 0.5-5 cm olan yuvarlak ve sağlam, fakat hafif sıkışabilir, intradermal ya da subkütan kist. Epidermal kistler intradermal ya da subkütan tümörlerdir, yavaş büyür ve yüz, boyun, sırt ve skrotumda oluşur. Genelde ergenlik döneminde ya da civarında görülürler ve kural olarak etkilenen bir bireyin tek bir ya da birkaç kisti vardır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Epidermal kist</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200040"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çapı 0.5-5 cm olan yuvarlak ve sağlam, fakat hafif sıkışabilir, intradermal ya da subkütan kist. Epidermal kistler intradermal ya da subkütan tümörlerdir, yavaş büyür ve yüz, boyun, sırt ve skrotumda oluşur. Genelde ergenlik döneminde ya da civarında görülürler ve kural olarak etkilenen bir bireyin tek bir ya da birkaç kisti vardır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Nontender, round and firm, but slightly compressible, intradermal or subcutaneous cyst measuring 0.5-5 cm in diameter. Epidermal cysts are intradermal or subcutaneous tumors, grow slowly and occur on the face, neck, back and scrotum. They usually appear at or around puberty, and as a rule an affected individual has one solitary or a few cysts. A central, dark comedone opening (punctum) may be present.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200040"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Epidermal kist</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Epidermoid cyst</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0200041">
        <obo:IAO_0000115 xml:lang="tr">Bir cilt eksikliği epidermisin inkomplet, nemli, sınırlanmış ve genellikle deprese lezyonu sergiliyor</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Cilt erozyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200041"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir cilt eksikliği epidermisin inkomplet, nemli, sınırlanmış ve genellikle deprese lezyonu sergiliyor</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A discontinuity of the skin exhibiting incomplete loss of the epidermis, a lesion that is moist, circumscribed, and usually depressed.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200041"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Cilt erozyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Skin erosion</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0200042">
        <obo:IAO_0000115 xml:lang="tr">Cildin bir süreksizliği, epidermisin tamamını ve çoğunlukla deri kısımlarını ve hatta deri altı yağını kaybeder</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Cilt ülseri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200042"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Cildin bir süreksizliği, epidermisin tamamını ve çoğunlukla deri kısımlarını ve hatta deri altı yağını kaybeder</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A discontinuity of the skin exhibiting complete loss of the epidermis and often portions of the dermis and even subcutaneous fat.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200042"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Cilt ülseri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Skin ulcer</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0200043">
        <obo:IAO_0000115 xml:lang="tr">Siğiller, cildi veya mukozaya zararlı tehlikesiz büyümeleri, kozmetik problemlerin yanı sıra ağrı ve rahatsızlık verir. Siğiller çoğunlukla eller, ayaklar ve genital bölgede görülür</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Siğil</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200043"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Siğiller, cildi veya mukozaya zararlı tehlikesiz büyümeleri, kozmetik problemlerin yanı sıra ağrı ve rahatsızlık verir. Siğiller çoğunlukla eller, ayaklar ve genital bölgede görülür</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Warts, benign growths on the skin or mucous membranes that cause cosmetic problems as well as pain and discomfort. Warts most often occur on the hands, feet, and genital areas.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200043"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Siğil</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Verrucae</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0200044">
        <obo:IAO_0000115 xml:lang="tr">Kornoid lamel denilen klinik olarak ve histolojik açıdan ayırıcı bir hiperkeratotik sırta benzer sınırla çevrili bir veya çoklu atrofik lekeler ile keratinizasyonun klonal bir bozukluğu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Porokeratoz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200044"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kornoid lamel denilen klinik olarak ve histolojik açıdan ayırıcı bir hiperkeratotik sırta benzer sınırla çevrili bir veya çoklu atrofik lekeler ile keratinizasyonun klonal bir bozukluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A clonal disorder of keratinization with one or multiple atrophic patches surrounded by a clinically and histologically distinctive hyperkeratotic ridgelike border called the cornoid lamella.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0200044"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Porokeratoz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Porokeratosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0200046">
        <obo:IAO_0000115 xml:lang="tr">Kedi miyavlamasına benzer, karakteristik, yüksek perdeli ağlama varlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kedi ağlaması</rdfs:label>
    </rdf:Description>
