    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003642">
        <obo:IAO_0000115 xml:lang="tr">Anormal transferrin izoform profili tip 1 doğuştan glikosilasyon bozukluğu ile tutarlı. Glikozilasyonun doğuştan bozuklukları için geleneksel klasifikasyonda, tüm glikanların bulunmaması tip 1 olarak ve bir veya daha fazla monosakkarit kaybı tip 2 olarak adlandırılmıştır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tip I transferrin izoform profili</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003642"/>
