        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Nazolakrimal kanalın gecikmiş kanalizasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Delayed canalization of nasolacrimal duct</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500049">
        <obo:IAO_0000115 xml:lang="tr">Avasküler veya anormal olarak vaskülarize retina prematür infantlarda meydana gelebilir ve körlüğe yol açabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Prematürite retinopatisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500049"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Avasküler veya anormal olarak vaskülarize retina prematür infantlarda meydana gelebilir ve körlüğe yol açabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An avascular or abnormally vascularized retina that occurs in premature infants and can lead to blindness.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500049"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Prematürite retinopatisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500050">
        <obo:IAO_0000115 xml:lang="tr">Retina damarları gelişimi durur ve daha sonra genellikle vasküler retinanın çevresini çalıştıran doğrusal düz beyaz bir çizgi bulunur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Prematürite evre 1 retinopatisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500050"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Retina damarları gelişimi durur ve daha sonra genellikle vasküler retinanın çevresini çalıştıran doğrusal düz beyaz bir çizgi bulunur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The retinal vessels stop and then a linear flat white line is present that usually runs the circumference of the vascular retina.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500050"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Prematürite evre 1 retinopatisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 1</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500051">
        <obo:IAO_0000115 xml:lang="tr">Biriken neovaskülarizasyon kalınlaşır ve doğrusal bir yumru olarak ortaya çıkar. Neovaskülarizasyon retinanın yüzeyi boyunca kalır ve retinanın kortikal vitröz içerisine uzanmaz</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Prematürite evre 2 retinopatisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500051"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Biriken neovaskülarizasyon kalınlaşır ve doğrusal bir yumru olarak ortaya çıkar. Neovaskülarizasyon retinanın yüzeyi boyunca kalır ve retinanın kortikal vitröz içerisine uzanmaz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The accumulating neovascularization thickens and manifests as a linear bump. The neovascularization remains along the surface of the retina and does not extend off the retina into the cortical vitreous.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500051"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Prematürite evre 2 retinopatisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 2</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500052">
        <obo:IAO_0000115 xml:lang="tr">Neovaskülarizasyon vaskülarize retinanın kenarında birikir ve vitreusa uzanır (ekstraretinal fibroz proliferasyonu da denir). zone 2 ve zone 3 vakalarında bu, sosis şeklinde olabilir. Daha posterior tutulumu olan zone 1 hastalığında, evre 3 avasküler retina üzerinde teğet olarak uzanan normal retina damarlarının doğrudan bir uzantısı olarak görülebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Prematürite evre 3 retinopatisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500052"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Neovaskülarizasyon vaskülarize retinanın kenarında birikir ve vitreusa uzanır (ekstraretinal fibroz proliferasyonu da denir). zone 2 ve zone 3 vakalarında bu, sosis şeklinde olabilir. Daha posterior tutulumu olan zone 1 hastalığında, evre 3 avasküler retina üzerinde teğet olarak uzanan normal retina damarlarının doğrudan bir uzantısı olarak görülebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The neovascularization accumulates at the edge of the vascularized retina and extends into the vitreous (also called extra retinal fibrosis proliferation). In cases of Zone 2 and Zone 3, this may be sausage shaped. In more posterior Zone 1 disease, the stage 3 can appear as a direct extension of the normal retinal vessels but extending tangentially over the avascular retina.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500052"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Prematürite evre 3 retinopatisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 3</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500053">
        <obo:IAO_0000115 xml:lang="tr">Vaskülarize retinanın kenarından gelen sürekli bir tabaka oluşturan skar dokusu. Bu skar dokusu çekilme, bozulma ve hatta dekolman ile sonuçlanan vitröz tabana/posterior lens kapsülüne doğru büyüyebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Prematürite evre 4 retinopatisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500053"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Vaskülarize retinanın kenarından gelen sürekli bir tabaka oluşturan skar dokusu. Bu skar dokusu çekilme, bozulma ve hatta dekolman ile sonuçlanan vitröz tabana/posterior lens kapsülüne doğru büyüyebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Scar tissue that forms a continuous sheet coming up from the edge of the vascularized retina. This scar tissue can grow toward the vitreous base/posterior lens capsule resulting in traction, distortion, and even detachment.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500053"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Prematürite evre 4 retinopatisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 4</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500054">
        <obo:IAO_0000115 xml:lang="tr">Maküla içine uzanmayan periferal retinayı içeren bir dekolman</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Prematürite evre 4a retinopatisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500054"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Maküla içine uzanmayan periferal retinayı içeren bir dekolman</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A detachment that involves the peripheral retina that does not extend into the macula.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500054"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Prematürite evre 4a retinopatisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 4a</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500055">
        <obo:IAO_0000115 xml:lang="tr">Makülanın kendisini içeren periferal retinayı içeren bir dekolman. Dekolman nazal retinayı da içerebilmesine rağmen genellikle temporal periferde başlar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Prematürite evre 4b retinopatisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500055"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Makülanın kendisini içeren periferal retinayı içeren bir dekolman. Dekolman nazal retinayı da içerebilmesine rağmen genellikle temporal periferde başlar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A detachment that involves the peripheral retina that involves the macula itself. The detachment usually starts in the temporal periphery although can also involve the nasal retina as well.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500055"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Prematürite evre 4b retinopatisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 4b</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500056">
        <obo:IAO_0000115 xml:lang="tr">Genellikle her bir dört kadranda çekilmeli retinanın bir huni dekolmanı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Prematürite evre 5 retinopatisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500056"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Genellikle her bir dört kadranda çekilmeli retinanın bir huni dekolmanı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Funnel detachment from the retina with generally traction in all four quadrants.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500056"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Prematürite evre 5 retinopatisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 5</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500057">
        <obo:IAO_0000115 xml:lang="tr">Genellikle her bir dört kadranda çekilmeli retinanın açık bir huni dekolmanı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Prematürite evre 5a retinopatisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500057"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Genellikle her bir dört kadranda çekilmeli retinanın açık bir huni dekolmanı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An open funnel detachment of the retina with generally traction in all four quadrants.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500057"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Prematürite evre 5a retinopatisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinopathy of prematurity stage 5a</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500058">
        <obo:IAO_0000115 xml:lang="tr">Genellikle her bir dört kadranda çekilmeli retinanın kapalı bir huni dekolmanı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Prematürite evre 5b retinopatisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500058"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Genellikle her bir dört kadranda çekilmeli retinanın kapalı bir huni dekolmanı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A closed funnel detachment of the retina with generally traction in all four quadrants.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0500058"/>
