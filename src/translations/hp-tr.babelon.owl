    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030044">
        <obo:IAO_0000115 xml:lang="tr">Aktif ya da pasif hale düzeltilemeyen bükülmüş (parmakla sıkılmış) bir parmak ya da ayak parmak eklemidir. Böylece eklemlerin normal hareketlerine engel olan kas, tendonlar, bağlar, veya derilerde yapısal değişiklikler nedeniyle eklem hareketiniz kronik şekilde kaybedilmesi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Parmağın fleksiyon kontraktürü</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030044"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Aktif ya da pasif hale düzeltilemeyen bükülmüş (parmakla sıkılmış) bir parmak ya da ayak parmak eklemidir. Böylece eklemlerin normal hareketlerine engel olan kas, tendonlar, bağlar, veya derilerde yapısal değişiklikler nedeniyle eklem hareketiniz kronik şekilde kaybedilmesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A bent (flexed) finger or toe joint that cannot be straightened actively or passively. It is thus a chronic loss of joint motion due to structural changes in muscle, tendons, ligaments, or skin that prevents normal movement of joints.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
