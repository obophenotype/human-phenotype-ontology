    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001348">
        <obo:IAO_0000115 xml:lang="tr">Tendon refleksleri fark edilir şekilde olağandan daha aktiftir (geleneksel olarak klinik muayenede 3+ olarak ifade edilir). Canlı refleksler nörolojik bir lezyona işaret edebilir veya etmeyebilir. Hiperrefleksinin her zaman anormal olarak değerlendirilen hiperaktif tekrarlayan (klonik) refleksler ile karakterize olması gerçeği ile hiperrefleksiden ayrılmaktadır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Canlı refleksler</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001348"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Tendon refleksleri fark edilir şekilde olağandan daha aktiftir (geleneksel olarak klinik muayenede 3+ olarak ifade edilir). Canlı refleksler nörolojik bir lezyona işaret edebilir veya etmeyebilir. Hiperrefleksinin her zaman anormal olarak değerlendirilen hiperaktif tekrarlayan (klonik) refleksler ile karakterize olması gerçeği ile hiperrefleksiden ayrılmaktadır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tendon reflexes that are noticeably more active than usual (conventionally denoted 3+ on clinical examination). Brisk reflexes may or may not indicate a neurological lesion. They are distinguished from hyperreflexia by the fact that hyerreflexia is characterized by hyperactive repeating (clonic) reflexes, which are considered to be always abnormal.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001348"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Canlı refleksler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Brisk reflexes</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001349">
