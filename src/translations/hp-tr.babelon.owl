        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031592">
        <obo:IAO_0000115 xml:lang="tr">Kalbin normal olarak solda yerleştiği torasik ve abdominal organların situs inversusu; büyük arterlerin transpozisyonu ve/veya aspleni veya polispleni dahil dalak defektleri gibi genellikle konjenital kardiyak anormallikler ile ilişkilidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Levokardiyalı situs inversus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031592"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kalbin normal olarak solda yerleştiği torasik ve abdominal organların situs inversusu; büyük arterlerin transpozisyonu ve/veya aspleni veya polispleni dahil dalak defektleri gibi genellikle konjenital kardiyak anormallikler ile ilişkilidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Situs inversus of thoracic and abdominal viscera with the heart remaining normally situated on the left; usually associated with congenital cardiac abnormalities such as transposition of the great vessels and/or spleen defects including asplenia or polysplenia.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
