    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030213">
        <obo:IAO_0000115 xml:lang="tr">Duygusal reaktivite ve olaylara veya insanlara karşı empati yoksunluğu, bazen aile bireylerine karşı da olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Duygusal küntleşme</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030213"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Duygusal reaktivite ve olaylara veya insanlara karşı empati yoksunluğu, bazen aile bireylerine karşı da olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>&quot;A diminished ability to experience, express, or connect with emotions across both positive and negative valences. This state is often characterized by a pervasive sense of emotional disconnection or detachment, where the individual may report feeling &quot;&quot;numb&quot;&quot; or lacking emotional responses that were previously present. The reduction can range from mild dampening of emotional responses to a near-total absence of emotional engagement. It is important to consider the individual&apos;s baseline emotional competence, as changes in emotional capacity may be more indicative of this phenomenon in those with a previously broad emotional range.&quot;</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030213"/>
