        <babelon:source_value>True ependymal rosette</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031929">
        <obo:IAO_0000115 xml:lang="tr">Konik hücresel süreçler merkezi yerleşmiş damar duvarı etrafında yayılan hücrelerin jant düzenlenmesinde olduğu bir rozet tipi</obo:IAO_0000115>
