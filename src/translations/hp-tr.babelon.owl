        <babelon:source_value>Abnormal circulating manganese concentration</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032097">
        <obo:IAO_0000115 xml:lang="tr">Kanda normal manganez konsantrasyonu üstüne bir yükselme</obo:IAO_0000115>
