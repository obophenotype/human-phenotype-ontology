        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Penisin şaft ve glans kısmının ventral, lateral veya ventrolateal yönde 30 derece veya daha fazla olan eğikliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
