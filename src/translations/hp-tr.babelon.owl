    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000829">
        <obo:IAO_0000115 xml:lang="tr">Paratiroid hormon eksikliğinden kaynaklanan, hipokalsemi ve hiperfosfatemi ile karakterize bir durum</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hipoparatiroidizm</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000829"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Paratiroid hormon eksikliğinden kaynaklanan, hipokalsemi ve hiperfosfatemi ile karakterize bir durum</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A condition caused by a deficiency of parathyroid hormone characterized by hypocalcemia and hyperphosphatemia.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000829"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hipoparatiroidizm</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypoparathyroidism</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000830">
        <obo:IAO_0000115 xml:lang="tr">Büyüme hormonu, tiroid stimüle edici hormon, adrenokortikotropik hormon, prolaktin, lüteinize edici hormon ve folikül stimüle edici hormon gibi bir veya birden fazla hipofiz hormonunun salınımının azalması ile karakterize ön hipofiz bez fonksiyonunun azaldığı durum</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ön hipoparatiroidizm</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000830"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Büyüme hormonu, tiroid stimüle edici hormon, adrenokortikotropik hormon, prolaktin, lüteinize edici hormon ve folikül stimüle edici hormon gibi bir veya birden fazla hipofiz hormonunun salınımının azalması ile karakterize ön hipofiz bez fonksiyonunun azaldığı durum</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A condition of reduced function of the anterior pituitary gland characterized by decreased secretion of one or more of the pituitary hormones growth hormone, thyroid-stimulating hormone, adrenocorticotropic hormone, prolactin, luteinizing hormone, and follicle-stimulating hormone.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000830"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ön hipoparatiroidizm</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anterior hypopituitarism</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000831">
        <obo:IAO_0000115 xml:lang="tr">İnsülin eksikliği ile değil fakat insülinin kas, yağ ve karaciğer hücreleri gibi hedef dokuları kısmında insüline yanıt eksikliği ile ilişkili bir diyabetes mellitus tipi. Bu tip diyabet tipik olarak hem kan glukoz konsantrasyonu hem de açlık ve tokluk serum insülin seviyesi artışları ile ilişkilidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İnsüline dirençli diabetes mellitus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000831"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İnsülin eksikliği ile değil fakat insülinin kas, yağ ve karaciğer hücreleri gibi hedef dokuları kısmında insüline yanıt eksikliği ile ilişkili bir diyabetes mellitus tipi. Bu tip diyabet tipik olarak hem kan glukoz konsantrasyonu hem de açlık ve tokluk serum insülin seviyesi artışları ile ilişkilidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of diabetes mellitus related not to lack of insulin but rather to lack of response to insulin on the part of the target tissues of insulin such as muscle, fat, and liver cells. This type of diabetes is typically associated with increases both in blood glucose concentrations as well as in fasting and postprandial serum insulin levels.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000831"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">İnsüline dirençli diabetes mellitus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Insulin-resistant diabetes mellitus</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000832">
