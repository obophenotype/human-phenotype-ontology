        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Plazmada yağ dokusunda lipoliz sonucu olarak ve plazma triaçilgliserollerinin doku içine alındığı zaman meydana gelen normal seviyelerden daha yüksek bir yağ asidi seviyesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A higher than normal levels of the fatty acids which can occur in plasma as a result of lipolysis in adipose tissue or when plasma triacyglycerols are taken into tissues.</babelon:source_value>
