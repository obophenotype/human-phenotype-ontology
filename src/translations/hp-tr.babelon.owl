        <owl:annotatedTarget xml:lang="tr">Etkilenmiş falanksların üçgeni andırdığı baş parmağın bir veya daha fazla falanksının anormal şekli</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal shape of one or more phalanges of the thumb such that affected phalanges resemble a triangle.</babelon:source_value>
