        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tongue fasciculations</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001310">
        <obo:IAO_0000115 xml:lang="tr">Hedefe yönelik hareketler için gereken mesafenin yanlış tahmini ile ilişkili bir veya birden fazla eklem düzleminde hareketleri doğru aralık ve hareket ile devam ettirememe ile karakterize bir tip ataksi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dismetri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001310"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hedefe yönelik hareketler için gereken mesafenin yanlış tahmini ile ilişkili bir veya birden fazla eklem düzleminde hareketleri doğru aralık ve hareket ile devam ettirememe ile karakterize bir tip ataksi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of ataxia characterized by the inability to carry out movements with the correct range and motion across the plane of more than one joint related to incorrect estimation of the distances required for targeted movements.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001310"/>
