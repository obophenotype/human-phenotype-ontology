        <owl:annotatedTarget xml:lang="tr">Dıştaki oküler kasların sadece bir kısmının fibrozu, etkilenen bireylerin gözleri kısmen ya da tamamen şaşılık pozisyonunda sabitlenir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
