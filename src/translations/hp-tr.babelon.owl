        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Karın ağrısını, bitkinliği, baş ağrısını ve paresteziyi veya çölyak hastalığını içerebilen besindeki gluten varlığına zararlı bir reaksiyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A detrimental reaction to the presence of gluten in food, which may include abdominal pain, fatigue, headaches and paresthesia, or celiac disease.</babelon:source_value>
