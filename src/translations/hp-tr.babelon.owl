        <babelon:source_value>Chronic constipation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012451">
        <obo:IAO_0000115 xml:lang="tr">Ani başlangıçlı ve üç aydan az süren kabızlık</obo:IAO_0000115>
