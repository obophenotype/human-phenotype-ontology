    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001055">
        <obo:IAO_0000115 xml:lang="tr">Tipi olarak lenfatik sistemi içine alan derinin yüzeysel enfeksiyonu olan tekrarlayan erizipel episot öyküsü ile belirti veren erizipele artmış yatkınlık</obo:IAO_0000115>
