        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Abdominal kavitede anormal olarak azalmış yağ doku miktarı</owl:annotatedTarget>
