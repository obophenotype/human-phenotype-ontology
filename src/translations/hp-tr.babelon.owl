    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001204">
        <obo:IAO_0000115 xml:lang="tr">Distal simfalangizm terimi el parmaklarının distal ve orta falankslarının kemiksi füzyonuna denir, diğer bir deyişle röntgende görülebilen distal interfalangeyal eklem (DIE) eksikliği veya distal interfalangeyal parmak çizgilerinin yokluğu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ellerin distal simfalangizmi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001204"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Distal simfalangizm terimi el parmaklarının distal ve orta falankslarının kemiksi füzyonuna denir, diğer bir deyişle röntgende görülebilen distal interfalangeyal eklem (DIE) eksikliği veya distal interfalangeyal parmak çizgilerinin yokluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The term distal symphalangism refers to a bony fusion of the distal and middle phalanges of the digits of the hand, in other words the distal interphalangeal joint (DIJ) is missing which can be seen either on x-rays or as an absence of the distal interphalangeal finger creases.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001204"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ellerin distal simfalangizmi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Distal finger symphalangism</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001211">
        <obo:IAO_0000115 xml:lang="tr">Bir parmağın ucunun (son) anormal bir yapısı</obo:IAO_0000115>
