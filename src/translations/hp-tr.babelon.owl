    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009319">
        <obo:IAO_0000115 xml:lang="tr">Kemiksi olmayan dokulardaki yapısal değişikliklerden dolayı 3. parmakta kronik eklem hareketi kaybı. 3. parmakta kamptodaktili terimi distal ve/veya proksimal interfalanksiyal eklemler etkilendiyse kullanılır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">3. el parmağının eklem kontraktürü</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009319"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kemiksi olmayan dokulardaki yapısal değişikliklerden dolayı 3. parmakta kronik eklem hareketi kaybı. 3. parmakta kamptodaktili terimi distal ve/veya proksimal interfalanksiyal eklemler etkilendiyse kullanılır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic loss of joint motion in the 3rd finger due to structural changes in non-bony tissue. The term camptodactyly of the 3rd finger is used if the distal and/or proximal interphalangeal joints are affected.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
