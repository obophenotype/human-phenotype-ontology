        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025300">
        <obo:IAO_0000115 xml:lang="tr">Malar bölgedeki (yanak kemikleri üzerinde) deriyi etkileyen ve burun köprüsü üzerine uzanan eritematöz (kırmızı), düz yüz kızarıklığı</obo:IAO_0000115>
