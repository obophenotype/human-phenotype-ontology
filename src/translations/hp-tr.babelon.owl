    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031287">
        <obo:IAO_0000115 xml:lang="tr">Yaşlı bireylerin derisi üzerinde yükselmiş bir büyüme. Lezyon genellikle başlangıçta açık deri rengindedir ve koyu kahverengi veya siyaha yakın olarak koyulaşabilir. Seboreik keratozisin kalıcı özelliği mumsu, yapışmış veya yapıştırılmış görüntüsüdür</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Seboreik keratoz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031287"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Yaşlı bireylerin derisi üzerinde yükselmiş bir büyüme. Lezyon genellikle başlangıçta açık deri rengindedir ve koyu kahverengi veya siyaha yakın olarak koyulaşabilir. Seboreik keratozisin kalıcı özelliği mumsu, yapışmış veya yapıştırılmış görüntüsüdür</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A raised growth on the skin of older individuals. The lesion usually is initially light tan and may darken to dark brown or nearly black. The consistent feature of seborrheic keratoses is their waxy, pasted-on or stuck-on look.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
