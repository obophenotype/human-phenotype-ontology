    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000570">
        <obo:IAO_0000115 xml:lang="tr">Hızlı (sıçrayıcı) göz hareketlerinin bozukluğu ile karakterize göz hareket anormalliği</obo:IAO_0000115>
