    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100767">
        <obo:IAO_0000115 xml:lang="tr">Plasenta, besin alımını, atık eliminasyonunu ve gaz değişimini sağlamak amacı ile gelişmekte olan fetüsü uterus duvarına bağlayan organın anormalliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Plasenta anormalliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100767"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Plasenta, besin alımını, atık eliminasyonunu ve gaz değişimini sağlamak amacı ile gelişmekte olan fetüsü uterus duvarına bağlayan organın anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the placenta, the organ that connects the developing fetus to the uterine wall to enable nutrient uptake, waste elimination, and gas exchange.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
