        <rdfs:label xml:lang="tr">Sinoti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100663"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kulakların boynun önünde birleşmesi ya da yakınlaşması ile karakterize, sıklıkla alt çene yokluğunun veya yetersiz gelişiminin eşlik ettiği bir doğumsal malformasyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A congenital malformation characterized by the union or approximation of the ears in front of the neck, often accompanied by the absence or defective development of the lower jaw.</babelon:source_value>
