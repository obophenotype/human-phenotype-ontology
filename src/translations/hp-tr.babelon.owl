    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001013">
        <obo:IAO_0000115 xml:lang="tr">Erüptif ksantomlar sıklıkla eritamatöz hale ile çevrelenmiş sarı-kavun içiden kırmızı-kahverengiye değişen papüllerdir. Basenlerde, ekstremitelerin ekstensör yüzeylerinde ve fleksural kıvrımlarında meydana gelir. Akut olarak, değişen derecelerde pruritus ve ağrı oluşur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Erüptif ksantomlar</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001013"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Erüptif ksantomlar sıklıkla eritamatöz hale ile çevrelenmiş sarı-kavun içiden kırmızı-kahverengiye değişen papüllerdir. Basenlerde, ekstremitelerin ekstensör yüzeylerinde ve fleksural kıvrımlarında meydana gelir. Akut olarak, değişen derecelerde pruritus ve ağrı oluşur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Eruptive xanthomas are yellow-orange-to-red-brown papules that are often surrounded by an erythematous halo. They appear in crops on the buttocks, extensor surfaces of the extremities, and flexural creases. Acutely, variable amounts of pruritus and pain occur.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001013"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Erüptif ksantomlar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Eruptive xanthomas</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001014">
        <obo:IAO_0000115 xml:lang="tr">Direk subepidermal olarak yer alan ve epidermal proliferatif reaksiyon gösteren vasküler bir lezyon bir veya birden fazla genişlemiş kan damarı olarak histolojik olarak tanımlanır. Klinik olarak, anjiyokeratoma küçük, zeminden yükselmiş, koyu kırmızı nokta olarak ortaya çıkar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anjiyokeratom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001014"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Direk subepidermal olarak yer alan ve epidermal proliferatif reaksiyon gösteren vasküler bir lezyon bir veya birden fazla genişlemiş kan damarı olarak histolojik olarak tanımlanır. Klinik olarak, anjiyokeratoma küçük, zeminden yükselmiş, koyu kırmızı nokta olarak ortaya çıkar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Angiokeratomas are hyperkeratotic papules that are characterized histologically by superficial ectatic (i.e., dilated) blood vessels with epidermal proliferation. Clinically, angiokeratoma presents as a small, raised, dark-red spot.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001014"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anjiyokeratom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Angiokeratoma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001015">
        <obo:IAO_0000115 xml:lang="tr">Yüzeysel damarların (derinin hemen altındaki damarlar) normalden belli veya fark edilir olduğu bir durumdur</obo:IAO_0000115>
