    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000381">
        <obo:IAO_0000115 xml:lang="tr">Üzengi ankilozisi, ses-iletim mekanizmasının (dış kulak yolu, timpanik membran ve/veya orta kulak kemikçikleri) yetersizliğinden kaynaklanan iletimsel işitme kaybı ile ilişkili olup üzenginin (orta kulakta üzengi şekilli küçük kemik veya kemikçik) doğumsal veya kazanılmış sabitliğidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Üzengi ankilozisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000381"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Üzengi ankilozisi, ses-iletim mekanizmasının (dış kulak yolu, timpanik membran ve/veya orta kulak kemikçikleri) yetersizliğinden kaynaklanan iletimsel işitme kaybı ile ilişkili olup üzenginin (orta kulakta üzengi şekilli küçük kemik veya kemikçik) doğumsal veya kazanılmış sabitliğidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Stapes ankylosis refers to congenital or acquired fixation of the stapes (the stirrup-shaped small bone or ossicle in the middle ear), which is associated with conductive hearing resulting from impairment of the sound-conduction mechanism (the external auditory canal, tympanic membrane, and/or middle-ear ossicles).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000381"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Üzengi ankilozisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Stapes ankylosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
