    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025030">
        <obo:IAO_0000115 xml:lang="tr">Enterik nöronal yapının bozulması yüzünden bozulan enterik nöronlar. Tipik nöropatolojik bulgular, nitel (örn., nöronal şişme, intranükleer inklüzyonlar, aksonal dejenerasyon) ve nicel (örn., nöron sayısındaki azalma) enterik nöronların anormalliklerini içerir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Enterik nöronal dejenerasyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025030"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Enterik nöronal yapının bozulması yüzünden bozulan enterik nöronlar. Tipik nöropatolojik bulgular, nitel (örn., nöronal şişme, intranükleer inklüzyonlar, aksonal dejenerasyon) ve nicel (örn., nöron sayısındaki azalma) enterik nöronların anormalliklerini içerir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Deterioration of enteric neurons with impairment of enteric neuronal structure. Typical neuropathological findings include qualitative (e.g., neuronal swelling, intranuclear inclusions, axonal degeneration) and quantitative (e.g., reduction in the number of neurons) abnormalities of the enteric neurons.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025030"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Enterik nöronal dejenerasyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Enteric neuronal degeneration</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
