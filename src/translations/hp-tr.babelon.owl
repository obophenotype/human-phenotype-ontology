        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031359">
        <obo:IAO_0000115 xml:lang="tr">Etkilenmiş deri alanının (kollajen kalınlaşması ile ilişkili) katılaşması (sklerozis) ile karakterize çap olarak 1 cm&apos;den daha büyük tek, yükselmiş, plato benzeri (düz tepeli) bir lezyon</obo:IAO_0000115>
