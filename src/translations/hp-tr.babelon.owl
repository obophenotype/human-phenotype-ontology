        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Alveolar soft part sarcoma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012219">
        <obo:IAO_0000115 xml:lang="tr">Sıklıkla gergin, çoklu ve bilateral inflamatuvar nodüller ile karakterize sıklıkla ilaç etkisi ve enfeksiyon ile ilişkili bir eritamatöz döküntü</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Eritema nodozum</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012219"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sıklıkla gergin, çoklu ve bilateral inflamatuvar nodüller ile karakterize sıklıkla ilaç etkisi ve enfeksiyon ile ilişkili bir eritamatöz döküntü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An erythematous eruption commonly associated with drug reactions or infection and characterized by inflammatory nodules that are usually tender, multiple, and bilateral.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
