    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010657">
        <obo:IAO_0000115 xml:lang="tr">Kemik yoğunluğunda yamalı (düzensiz) azalma. Bu, röntgenlerde görülebileceği gibi şiddete ve dağılıma bağlı olarak birçok şekil alabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kemik mineral yoğunluğunun yamalı azalması</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010657"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kemik yoğunluğunda yamalı (düzensiz) azalma. Bu, röntgenlerde görülebileceği gibi şiddete ve dağılıma bağlı olarak birçok şekil alabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Patchy (irregular) reduction in bone density. This can take on many forms depending on severity and distribution as can be seen on x-rays.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010657"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kemik mineral yoğunluğunun yamalı azalması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Patchy reduction of bone mineral density</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010658">
        <obo:IAO_0000115 xml:lang="tr">Kemik mineral yoğunluğundaki düzensiz (düzgün olmayan) değişiklikler. Bu değişiklikler, x-ışınlarında görüldüğü gibi mineral yoğunluğun düzensiz şekilde azalma veya artması olabilir. Patomekanizmaya ve altta yatan hastalığa bağlı olarak, bu değişiklikler ya yalnızca azalma ya da artma ya da her ikisinin birleşimi olarak görülebilir (diğerleri mineral yoğunluğunun azaltılmasından etkilenirken artmış yoğunluğu gösteren kemik parçaları)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kemik mineral yoğunluğunun yamalı değişiklikleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010658"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kemik mineral yoğunluğundaki düzensiz (düzgün olmayan) değişiklikler. Bu değişiklikler, x-ışınlarında görüldüğü gibi mineral yoğunluğun düzensiz şekilde azalma veya artması olabilir. Patomekanizmaya ve altta yatan hastalığa bağlı olarak, bu değişiklikler ya yalnızca azalma ya da artma ya da her ikisinin birleşimi olarak görülebilir (diğerleri mineral yoğunluğunun azaltılmasından etkilenirken artmış yoğunluğu gösteren kemik parçaları)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Patchy (irregular) changes in bone mineral density. These changes can either be patchy reduction or increase of mineral density as seen on x-rays. Depending on the pathomechanism and the underlying disease, these changes can either appear solely as reduction or increase or as a combination of both (patches of bone showing an increased density while others are affected by reduction of mineral density).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010658"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kemik mineral yoğunluğunun yamalı değişiklikleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Patchy changes of bone mineral density</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010659">
        <obo:IAO_0000115 xml:lang="tr">Kemik yoğunluğunun azalması ile etkilenmiş bir taraftan diğer tarafa artmış yoğunluk gösteren kemik yamaları ile kemik mineral yoğunluğunda yamalı (düzensiz) değişiklikler. Bu bazen filmlerde güve yeniği görünümü olarak da tariflenir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kemik mineral yoğunluğunda yamalı varyasyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010659"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kemik yoğunluğunun azalması ile etkilenmiş bir taraftan diğer tarafa artmış yoğunluk gösteren kemik yamaları ile kemik mineral yoğunluğunda yamalı (düzensiz) değişiklikler. Bu bazen filmlerde güve yeniği görünümü olarak da tariflenir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Patchy (irregular) changes in bone mineral density with patches of bone showing an increased density side to side with patches that are affected by reduction of mineral density. This is sometimes referred to as a moth-eaten appearance on x-rays.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010659"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kemik mineral yoğunluğunda yamalı varyasyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Patchy variation in bone mineral density</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
