        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Topuk kemiğinin distal falanksının epifiz anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of the epiphysis of the distal phalanx of the hallux</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010125">
        <obo:IAO_0000115 xml:lang="tr">2-5 metatarsaların tersine, ilk metatarsal embriyolojik olarak falanks kaynaklıdır ve 2.- 5. parmakların proksimal falankslarına eşdeğerdir, oysa ki ayak başparmağının proksimal falanksı diğer parmakların orta falankslarına eşdeğerdir. Bu terim, ilk metatarsal kemiğin epifiz anomalileri için geçerlidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">1. metatarsalın epifiz anormalliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010125"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">2-5 metatarsaların tersine, ilk metatarsal embriyolojik olarak falanks kaynaklıdır ve 2.- 5. parmakların proksimal falankslarına eşdeğerdir, oysa ki ayak başparmağının proksimal falanksı diğer parmakların orta falankslarına eşdeğerdir. Bu terim, ilk metatarsal kemiğin epifiz anomalileri için geçerlidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>In contrast to the metatarsals 2-5, the first metatarsal is embryologically of phalangeal origin and as such equivalent to the proximal phalanges of the digits 2-5, whereas the proximal phalanx of the big toe is equivalent to the middle phalanges of the other digits. This term applies to abnormalities of the epiphysis of the first metatarsal bone.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010125"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">1. metatarsalın epifiz anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of the epiphysis of the 1st metatarsal</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010126">
        <obo:IAO_0000115 xml:lang="tr">2-5 metatarsals in aksine, birinci metatarsal embriyolojik olarak falanks kaynaklıdır ve ayak parmaklarının proksimal falanksları diğer rakamların orta falankslarına denk gelirken 2-5 rakamlarının proksimal falankslarına eşdeğerdir. Bu terim halluksun proksimal falanksına etki eden anormallikler için geçerlidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Topuk kemiğinin proksimal falanksının epifiz anormalliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010126"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">2-5 metatarsals in aksine, birinci metatarsal embriyolojik olarak falanks kaynaklıdır ve ayak parmaklarının proksimal falanksları diğer rakamların orta falankslarına denk gelirken 2-5 rakamlarının proksimal falankslarına eşdeğerdir. Bu terim halluksun proksimal falanksına etki eden anormallikler için geçerlidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>In contrast to the metatarsals 2-5, the first metatarsal is embryologically of phalangeal origin and as such equivalent to the proximal phalanges of the digits 2-5, whereas the proximal phalanx of the big toe is equivalent to the middle phalanges of the other digits. This term applies to abnormalities affecting the proximal phalanx of the hallux.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010126"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Topuk kemiğinin proksimal falanksının epifiz anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
