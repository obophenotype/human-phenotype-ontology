        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003203">
        <obo:IAO_0000115 xml:lang="tr">NBT testinde, nötrofiller, renksiz bileşik NBT&apos;yi, koyu mavi bir renge sahip bir bileşik haline getirir. Bu test negatif ise (yani, mavi renk üretilmez), o zaman süperoksit üreten NADPH oksidaz aktivitesindeki bir hasarı gösterir ve fagositize bakterileri etkili bir biçimde öldürmez</obo:IAO_0000115>
