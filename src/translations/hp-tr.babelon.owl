    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011479">
        <obo:IAO_0000115 xml:lang="tr">Aynı gözde konjunktival keseden lakrimal kanala göz yaşını drene eden, mediyal kantusa yakın göz kapağı üzerinde bir açıklık olan lakrimal punktumun bir anormalliği</obo:IAO_0000115>
