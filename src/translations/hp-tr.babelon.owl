        <obo:IAO_0000115 xml:lang="tr">Sıçrayıcı kaçırma, örneğin sıçrayıcı göz hareketlerinin nesneye odaklanmak için gerekenden daha az büyüklüğe sahip olması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hipometrik sıçramalar</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
