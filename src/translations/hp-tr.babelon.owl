        <babelon:source_value>Septate vagina</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001155">
        <obo:IAO_0000115 xml:lang="tr">Tek veya her iki eli etkileyen bir anormallik</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">El anormalliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001155"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Tek veya her iki eli etkileyen bir anormallik</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality affecting one or both hands.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001155"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">El anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of the hand</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001156">
        <obo:IAO_0000115 xml:lang="tr">El/ayak ile karşılaştırıldığında orantısız olarak kısa görünen parmaklar. Brakidaktili kelimesi tipik kısalmış parmak (brakidaktili tip A-E) biçimleri ile karakterize bir dizi Mendeliyen hastalığı tarif etmek için kullanılmıştır. Burada kullanılmasına rağmen, gözlemlenen fenotipik anormalliklerin net olarak tanımlanması tercih edilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Brakidaktili</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001156"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">El/ayak ile karşılaştırıldığında orantısız olarak kısa görünen parmaklar. Brakidaktili kelimesi tipik kısalmış parmak (brakidaktili tip A-E) biçimleri ile karakterize bir dizi Mendeliyen hastalığı tarif etmek için kullanılmıştır. Burada kullanılmasına rağmen, gözlemlenen fenotipik anormalliklerin net olarak tanımlanması tercih edilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Digits that appear disproportionately short compared to the hand/foot. The word brachydactyly is used here to describe a series distinct patterns of shortened digits (brachydactyly types A-E). This is the sense used here.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001156"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Brakidaktili</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Brachydactyly</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001159">
        <obo:IAO_0000115 xml:lang="tr">&quot;El veya ayak parmaklarının sadece yumuşak doku içeren veya kemik yapıyı da içeren perdeleşmesi veya birleşmesi. Kemik füzyon &quot;&quot;kemiksi&quot;&quot; sindaktili eğer radiyo-ulnar aksta gerçekleşirse kullanılır. Proksimo-distal aksta olan el veya ayak kemiklerinin füzyonu &quot;&quot;sinfalangizm&quot;&quot; olarak adlandırılır&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sindaktili</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001159"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">&quot;El veya ayak parmaklarının sadece yumuşak doku içeren veya kemik yapıyı da içeren perdeleşmesi veya birleşmesi. Kemik füzyon &quot;&quot;kemiksi&quot;&quot; sindaktili eğer radiyo-ulnar aksta gerçekleşirse kullanılır. Proksimo-distal aksta olan el veya ayak kemiklerinin füzyonu &quot;&quot;sinfalangizm&quot;&quot; olarak adlandırılır&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>&quot;Webbing or fusion of the fingers or toes, involving soft parts only or including bone structure. Bony fusions are referred to as &quot;&quot;bony&quot;&quot; syndactyly if the fusion occurs in a radio-ulnar axis. Fusions of bones of the fingers or toes in a proximo-distal axis are referred to as &quot;&quot;symphalangism&quot;&quot;.&quot;</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001159"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Sindaktili</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Syndactyly</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001161">
        <obo:IAO_0000115 xml:lang="tr">Fazladan parmak veya parmakların varlığı ile karakterize bir polidaktili çeşidi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">El polidaktilisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001161"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Fazladan parmak veya parmakların varlığı ile karakterize bir polidaktili çeşidi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A kind of polydactyly characterized by the presence of a supernumerary finger or fingers.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001161"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">El polidaktilisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hand polydactyly</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001162">
        <obo:IAO_0000115 xml:lang="tr">Elin ulnar tarafında (serçe parmak tarafında yer alan) yer alan fazladan parmak</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Postaksiyel el polidaktilisi</rdfs:label>
