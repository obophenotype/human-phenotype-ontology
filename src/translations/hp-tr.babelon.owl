    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000321">
        <obo:IAO_0000115 xml:lang="tr">Önden bakıldığında yüz dış çizgisinin kare görünümü ortaya çıkarttığı geniş üst yüz/kraniyum ve alt yüz/çene</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kare yüz</rdfs:label>
