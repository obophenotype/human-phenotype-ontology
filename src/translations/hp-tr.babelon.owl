        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">4. el parmağının distal interfalangeyal eklem kontraktürü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Contracture of the distal interphalangeal joint of the 4th finger</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009276">
        <obo:IAO_0000115 xml:lang="tr">Kemiksiz dokuda yapısal değişiklikler nedeniyle 4. parmağın proksimal interfalangeal ekleminin eklem hareketinin kronik kaybı. Dördüncü parmağın PIP eklemi bükülu kalmış ve aktif veya pasif şekilde kıpırdatılamıyor. Kas, tendonlar, bağlar veya cildin yapısal değişikliklerinden ötürü normal hareketi engelleyen eklem hareketinin kronik kaybının sonucudur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">4. el parmağının proksimal interfalangeyal eklem kontraktürü</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009276"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kemiksiz dokuda yapısal değişiklikler nedeniyle 4. parmağın proksimal interfalangeal ekleminin eklem hareketinin kronik kaybı. Dördüncü parmağın PIP eklemi bükülu kalmış ve aktif veya pasif şekilde kıpırdatılamıyor. Kas, tendonlar, bağlar veya cildin yapısal değişikliklerinden ötürü normal hareketi engelleyen eklem hareketinin kronik kaybının sonucudur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic loss of joint motion of the proximal interphalangeal joint of the 4th finger due to structural changes in non-bony tissue. That is, the PIP joint of a fourth finger is bent (flexed) and cannot be straightened actively or passively. It is thus a chronic loss of joint motion due to structural changes in muscle, tendons, ligaments, or skin that prevents normal movement.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009276"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">4. el parmağının proksimal interfalangeyal eklem kontraktürü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Contracture of the proximal interphalangeal joint of the 4th finger</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
