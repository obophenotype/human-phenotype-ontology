    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002349">
        <obo:IAO_0000115 xml:lang="tr">Bilincin korunduğu fokal başlangıçlı bir nöbet tipi. Bir nöbet esnasındaki bilinç, hareket edemese de nöbet boyunca hastaların kendilerinin ve çevresinin tamamen farkında olması olarak tanımlanabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Bilinç ve farkındalık bozukluğu olmadan fokal nöbetler</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002349"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bilincin korunduğu fokal başlangıçlı bir nöbet tipi. Bir nöbet esnasındaki bilinç, hareket edemese de nöbet boyunca hastaların kendilerinin ve çevresinin tamamen farkında olması olarak tanımlanabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of focal-onset seizure in which awareness is preserved. Awareness during a seizure is defined as the patient being fully aware of themself and their environment throughout the seizure, even if immobile.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
