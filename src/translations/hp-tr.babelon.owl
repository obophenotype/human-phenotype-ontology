        <obo:IAO_0000115 xml:lang="tr">Kurşun şekilli falankslar distale doğru giderek incelen kısa ve geniş falankslara denir. Kurşun şekilli falansklar normal diyafizyal daralmadan yoksundur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">4. parmağın mermi şeklindeki falanksları</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
