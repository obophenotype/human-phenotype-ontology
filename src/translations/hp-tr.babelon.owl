    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000002">
        <obo:IAO_0000115 xml:lang="tr">Yaş ve cinsiyete göre beklenen boy normları ile karşılaştırıldığında boy normlarından sapma</obo:IAO_0000115>
