    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012410">
        <obo:IAO_0000115 xml:lang="tr">Lökosit veya platelet üretimi anormalliğinin çok az olduğu veya hiç olmadığı eritropoez baskılanmasından kaynaklanan bir anemi tipi. Eritroblastlar kemik iliğinde neredeyse yoktur; bununla birlikte lökosit ve platelet üretimi çok az azalma gösterir veya hiç azalma göstermez</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Saf kırmızı hücre aplazisi</rdfs:label>
    </rdf:Description>
