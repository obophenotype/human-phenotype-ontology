        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of inferior crus of antihelix</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011244">
        <obo:IAO_0000115 xml:lang="tr">Antiheliks bifurkasyonunun altındaki inferior ve süperior kruralar içine olan kısmi olan antiheliks kökünün bir anormalliği</obo:IAO_0000115>
