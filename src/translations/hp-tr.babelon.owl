    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004012">
        <obo:IAO_0000115 xml:lang="tr">Radyusun epifizyal plaklarının bir prematüre füzyonu. Epifizyal plaklar uzun kemiklerin distal ve proksimal sonlarında konumlanır, radyus ve prematüre füzyonun radyal kemiğin büyümesi üzerinde etkisi olması durumunda kemiğin gelişimi ve normal büyümesi engellenir ya da en azından rahatsız edilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Radyal epifizle alakalı yassılaştırılmış çıkıntıların erken füzyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004012"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Radyusun epifizyal plaklarının bir prematüre füzyonu. Epifizyal plaklar uzun kemiklerin distal ve proksimal sonlarında konumlanır, radyus ve prematüre füzyonun radyal kemiğin büyümesi üzerinde etkisi olması durumunda kemiğin gelişimi ve normal büyümesi engellenir ya da en azından rahatsız edilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A premature fusion of the epiphyseal plates of the radius. Epiphyseal plates are located at the distal and proximal ends of the long bones, in this case of the radius and premature fusion will have an effect on the growh of the radial bone, inhibiting or at least disturbing the normal growth and development of the bone.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004012"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Radyal epifizle alakalı yassılaştırılmış çıkıntıların erken füzyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Premature fusion of the radial epiphyseal plates</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
