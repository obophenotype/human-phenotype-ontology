    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0045059">
        <obo:IAO_0000115 xml:lang="tr">En geniş noktasında toplu iğne başından 10 mm&apos;den daha küçük boyutlara değişen lokalize hiperkeratozisden oluşan (son olan histopatolojik olarak gösterilebilir), sınırlanmış, görünen sıvı olmadan derinin katı olan yükselmesi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hiperkeratotik papül</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0045059"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">En geniş noktasında toplu iğne başından 10 mm&apos;den daha küçük boyutlara değişen lokalize hiperkeratozisden oluşan (son olan histopatolojik olarak gösterilebilir), sınırlanmış, görünen sıvı olmadan derinin katı olan yükselmesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A circumscribed, solid elevation of skin with no visible fluid, varying in size from a pinhead to less than 10mm in diameter at the widest point that is composed of localized hyperkeratosis (the latter may be demonstrated histopathologically).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
