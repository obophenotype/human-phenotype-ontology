    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006521">
        <obo:IAO_0000115 xml:lang="tr">Pulmoner lenfatik damarların anormal dilatasyonu. Akciğerdeki Lenf sıvısı, akciğerdeki kan kılcal damarlarındaki sıvının normal sızıntısından kaynaklanır. Pulmoner lenfanjektazide pulmoner lenfatikler düzgün bir şekilde bağlanmaz ve sıvı ile dilate olur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Pulmoner lenfanjiektazi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006521"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Pulmoner lenfatik damarların anormal dilatasyonu. Akciğerdeki Lenf sıvısı, akciğerdeki kan kılcal damarlarındaki sıvının normal sızıntısından kaynaklanır. Pulmoner lenfanjektazide pulmoner lenfatikler düzgün bir şekilde bağlanmaz ve sıvı ile dilate olur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal dilatation of the pulmonary lymphatic vessels. Lymphatic fluid in the lung is derived from normal leakage of fluid out of the blood capillaries in the lung. In pulmonary lymphangiectasia, the pulmonary lymphatics are not properly connected and become dilated with fluid.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
