    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009800">
        <obo:IAO_0000115 xml:lang="tr">Annelik diyabeti, genellikle tip 2 yada tip 1 diyabet, gebeliğe bağlı olabilir. Esasen, hem tip 1 hem de tip 2 diyabetli gebelere aynı konjenital malformasyon riski getiren spesifik olmayan bir teratojen olan anne hiperglisemisi ile sonuçlanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Maternal diyabet</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009800"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Annelik diyabeti, genellikle tip 2 yada tip 1 diyabet, gebeliğe bağlı olabilir. Esasen, hem tip 1 hem de tip 2 diyabetli gebelere aynı konjenital malformasyon riski getiren spesifik olmayan bir teratojen olan anne hiperglisemisi ile sonuçlanır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Maternal diabetes can either be a gestational, mostly type 2 diabetes, or a type 1 diabetes. Essential is the resulting maternal hyperglycemia as a non-specific teratogen, imposing the same risk of congenital malformations to pregnant women with both type 1 and type2 diabetes.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009800"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Maternal diyabet</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Maternal diabetes</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
