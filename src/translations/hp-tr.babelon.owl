        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025362"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Renal korteksin ve papilla olarak adlandırılan dar apeks yanında geniş tabanlı koni şekilli yapılar olan erişkin böbrek piramidinin tam gelişmemesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Undergrowth of the pyramid of the adult kidney, cone-shaped structures with a broad base adjacent to the renal cortex and the narrow apex that is termed papilla.</babelon:source_value>
