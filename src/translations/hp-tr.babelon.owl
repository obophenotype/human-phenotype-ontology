    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000340">
        <obo:IAO_0000115 xml:lang="tr">Alnın ön yüzeyi eğiminin iki standart sapmadan daha fazla olması (nesnel); veya yandan görünümde alnın belirgin posterior eğim artışı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Eğimli alın</rdfs:label>
    </rdf:Description>
