    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040201"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Motor pasifliğin bir alt kümesi, basit gönüllülük esnasında aynı anda iki taneden fazlasını yerine getirememe, örneğin gözlerin kapanması ve dilin çıkması gibi işlevler olarak tanımlanır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A subset of motor impersistence, defined as the inability to perform more than two of the simple voluntary acts simultaneously, such as closing the eyes and protruding the tongue.</babelon:source_value>
