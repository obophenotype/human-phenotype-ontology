    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025355">
        <obo:IAO_0000115 xml:lang="tr">Boyutu 100-200 mikrometre çapında değişen genellikle ikinci sıra retinal arteriyollerin, retinal arter dallarının kazanılmış fokal dilatasyonu. Makroanevrizmalar genellikle temporal retinada yer alır ve hemorajik veya eksüdatif olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Retinal arteriyel makroanevrizması</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025355"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Boyutu 100-200 mikrometre çapında değişen genellikle ikinci sıra retinal arteriyollerin, retinal arter dallarının kazanılmış fokal dilatasyonu. Makroanevrizmalar genellikle temporal retinada yer alır ve hemorajik veya eksüdatif olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Acquired focal dilatations of branches of the retinal artery, usually second-order retinal arterioles, that range in size from 100 to 200 micrometers in diameter. Macroaneurysms are generally located at the temporal retina and may be hemorrhagic or exudative.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025355"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Retinal arteriyel makroanevrizması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinal arteriolar macroaneurysms</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025357">
        <obo:IAO_0000115 xml:lang="tr">Miyoklonilerin vücut bölgesinden rastgele ve asenkronize biçimde başka bir bölgeye kaydığı bir çeşit miyoklonus. Düzensiz miyoklonus yüzü veya uzuvları etkileyebilir, kısa, tek veya tekrarlayan, çok sık ve neredeyse aralıksızdır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tutarsız myoklonus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025357"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Miyoklonilerin vücut bölgesinden rastgele ve asenkronize biçimde başka bir bölgeye kaydığı bir çeşit miyoklonus. Düzensiz miyoklonus yüzü veya uzuvları etkileyebilir, kısa, tek veya tekrarlayan, çok sık ve neredeyse aralıksızdır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of myoclonus in which the myoclonias shift from body region to another in a random and asynchronous fashion. Erratic myoclonus can affect the face or limbs, are brief, single or repetitive, very frequent and nearly continuous.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025357"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Tutarsız myoklonus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Erratic myoclonus</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
