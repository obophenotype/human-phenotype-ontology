        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Disproportionate tall stature</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001520">
        <obo:IAO_0000115 xml:lang="tr">Gestasyonel yaşa göre büyük terimi doğum kilosu gestasyonel yaşa göre 90. persantilin üstünde olan bebekler için kullanılır</obo:IAO_0000115>
