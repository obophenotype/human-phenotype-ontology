        <owl:annotatedTarget xml:lang="tr">Azalmış antitrombin antijen. Azalmış bir antitrombin seviyesi, trombüs oluşma riskinin artışına yol açabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced antithrombin antigen. A reduced level of antithrombin may lead to an increased risk of thrombus formation.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
