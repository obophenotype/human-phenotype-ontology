        <owl:annotatedTarget xml:lang="tr">Koksigeyal bölgede (intergluteal yarık bölgesi) bir sinüs. Pilonidal sinüs sıklıkla saç ve deri artığı içerir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A sinus in the coccygeal region (the region of the intergluteal cleft). A pilonidal sinus often contains hair and skin debris.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
