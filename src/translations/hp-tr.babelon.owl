    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025297">
        <obo:IAO_0000115 xml:lang="tr">Süresi beklenenden veya olağandan (genellikle bir enfeksiyon ile birden fazla uzamış ateş) daha uzun bir zaman periyoduna ulaşan bir anormallik için geçerlidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Uzamış</rdfs:label>
    </rdf:Description>
