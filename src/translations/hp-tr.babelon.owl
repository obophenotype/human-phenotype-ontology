        <obo:IAO_0000115 xml:lang="tr">Bir koroner arter normal olarak aort kökünden ziyade pulmoner arterden başlar (dallanır)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Koroner arterin pulmoner arterden olan anormal kökeni</rdfs:label>
    </rdf:Description>
