        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sclerosis of the epiphysis of the distal phalanx of the ring finger, leading to an increased degree of radiopacity (white or ivory appearance) in X-rays.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
