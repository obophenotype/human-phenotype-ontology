        <owl:annotatedTarget xml:lang="tr">En yakın neovaskülarizasyon sahası kenarının fovea merkezinden 1-199 mikrometrede yer aldığı bir tip koroidal neovaskülarizasyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of choroidal neovascularization in which the nearest edge of the area of neovascularization is located 1 to 199 micrometers from the center of the fovea.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
