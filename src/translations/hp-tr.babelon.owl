    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006937">
        <obo:IAO_0000115 xml:lang="tr">Distal ekstremitelerin derisinde azalmış dokunuş hissi (taktil duyu). Genelde, pamuk ya da ince bir deve saç fırçası teli ile test edilir; hastalara, uyarıyı her hissettikleri zaman &apos;şimdi&apos; demeleri istenir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Bozulmuş distal dokunma hissi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006937"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Distal ekstremitelerin derisinde azalmış dokunuş hissi (taktil duyu). Genelde, pamuk ya da ince bir deve saç fırçası teli ile test edilir; hastalara, uyarıyı her hissettikleri zaman &apos;şimdi&apos; demeleri istenir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduced sense of touch (tactile sensation) on the skin of the distal limbs. This is usually tested with a wisp of cotton or a fine camel&apos;s hair brush, by asking patients to say &apos;now&apos; each time they feel the stimulus.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006937"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Bozulmuş distal dokunma hissi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired distal tactile sensation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006938">
        <obo:IAO_0000115 xml:lang="tr">Bileklerde titreşimi algılama yetisinin düşüşü. Klinik olarak, bu durum 128 Hz ile titreşen bir diyapazon ile test edilir ve bileklerin malleollerine uygulanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ayak bileklerinde bozulmuş titreşim hissi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006938"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bileklerde titreşimi algılama yetisinin düşüşü. Klinik olarak, bu durum 128 Hz ile titreşen bir diyapazon ile test edilir ve bileklerin malleollerine uygulanır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A decrease in the ability to perceive vibration at the ankles. Clinically, this is usually tested with a tuning fork which vibrates at 128 Hz and is applied to the malleoli of the ankles.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
