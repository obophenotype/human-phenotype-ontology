        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002786"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bronş ve trakea içindeki kıkırdağının zayıflığı, sarkık solunum yoluna (rigid olmayan) sebep olabilir. Etkilenen bireyler solunum yollarının açıklığı konusunda sorun yaşayabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Weakness of the cartilage in the trachea and the bronchi, resulting in a floppy (non-rigid) airway. Affected persons may have difficulties to maintain patency of the airways.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
