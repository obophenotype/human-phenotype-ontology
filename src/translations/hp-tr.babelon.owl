    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001773">
        <obo:IAO_0000115 xml:lang="tr">27-41 haftalık bir gebelik sonrası doğan bir yenidoğan için ortalamadan 2 SD daha aşağıda ölçülmüş bir ayak uzunluğu, veya doğumdan 16 yaşına kadar olan bireyler için 3. persentilden daha az olan ayak (nesnel). Alternatif olarak, orantısız olarak kısa gözüken bir ayak (öznel)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kısa ayak</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001773"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">27-41 haftalık bir gebelik sonrası doğan bir yenidoğan için ortalamadan 2 SD daha aşağıda ölçülmüş bir ayak uzunluğu, veya doğumdan 16 yaşına kadar olan bireyler için 3. persentilden daha az olan ayak (nesnel). Alternatif olarak, orantısız olarak kısa gözüken bir ayak (öznel)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A measured foot length that is more than 2 SD below the mean for a newborn of 27 - 41 weeks gestation, or foot that is less than the 3rd centile for individuals from birth to 16 years of age (objective). Alternatively, a foot that appears disproportionately short (subjective).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
