        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Triangular shaped middle phalanx of the 5th finger</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009183">
        <obo:IAO_0000115 xml:lang="tr">Non-kemik dokusunda yapısal değişiklikler nedeniyle 5. parmak eklem hareket kronik kaybı. Distal ve / veya proksimal interfalangeal eklemler etkilenirse 5. parmağın kamptodaktili terimi kullanılır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">5. parmağın eklem kontraktürü</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009183"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Non-kemik dokusunda yapısal değişiklikler nedeniyle 5. parmak eklem hareket kronik kaybı. Distal ve / veya proksimal interfalangeal eklemler etkilenirse 5. parmağın kamptodaktili terimi kullanılır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic loss of joint motion in the 5th finger due to structural changes in non-bony tissue. The term camptodactyly of the 5th finger is used if the distal and/or proximal interphalangeal joints are affected.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
