    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011684"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ventriküler septal defektin (VSD) her iki tarafı arasında etkin bir şekilde basınç gradiyenti oluşturmaya yetecek karşı akımı kısıtlamayan herhangi bir VSD</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any ventricular septal defect (VSD) that does not restrict flow across it sufficiently to generate a pressure gradient between the two sides of the VSD.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
