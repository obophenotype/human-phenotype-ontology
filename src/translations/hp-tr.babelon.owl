        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030955"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Uzun süredir aşırı miktarda alkol tüketmesi, tüketilen alkol miktarını azaltmakta zorluk çekmesi, fazlasıyla alkol arzulama ve alkol almaması durumunda yoksunluk semptomlarının yaşanması şeklinde tanımlanan bağımlılık davranışı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An addictive behavior is defined as drinking excessive amounts of alcohol over a prolonged period of time, having difficulty in reducing the amount of alcohol consumed, strongly desiring alcohol, and experiencing withdrawal symptoms when not drinking alcohol.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030955"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Alkoliklik</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Addictive alcohol use</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
