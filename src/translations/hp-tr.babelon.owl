        <owl:annotatedTarget xml:lang="tr">Bakteriyel polisakaritlere karşı yönlendirilen spesifik immünoglobülin eksikliği ile normal toplam immünoglobülin seviyelerinin varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of normal overall immunoglobulin levels with deficiency of specific immunoglobulins directed against bacterial polysaccharides.</babelon:source_value>
