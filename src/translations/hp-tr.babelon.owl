        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bony fusion of the mandibular condyle to the base of the skull, resulting in limitation of jaw opening.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
