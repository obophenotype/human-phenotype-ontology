        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010219">
        <obo:IAO_0000115 xml:lang="tr">Ayak kemiklerini (kas ve yumuşak doku da dahil) etkileyen bir anormalliğe bağlı olarak oluşan bir ayak deformitesi. Karşıt olarak eğer sadece kas ve yumuşak doku etkilenmişse pozisyonel ayak deformitesi terimi kullanılır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yapısal ayak deformitesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010219"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ayak kemiklerini (kas ve yumuşak doku da dahil) etkileyen bir anormalliğe bağlı olarak oluşan bir ayak deformitesi. Karşıt olarak eğer sadece kas ve yumuşak doku etkilenmişse pozisyonel ayak deformitesi terimi kullanılır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A foot deformity resulting due to an abnormality affecting the bones of the foot (as well as muscle and soft tissue). In contrast if only the muscle and soft tissue are affected the term positional foot deformity applies.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010219"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Yapısal ayak deformitesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Structural foot deformity</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010220">
