    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025295">
        <obo:IAO_0000115 xml:lang="tr">Görünümü ve dağılımı Herpes simpleks ve herpes zoster enfeksiyonlarında görülen gruplaşmış göbekli vezikülleri andıran bir anormallik için geçerlidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Herpetiform</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025295"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
