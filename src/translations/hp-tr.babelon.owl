    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100580">
        <obo:IAO_0000115 xml:lang="tr">Özofagusun alt bölümündeki hücrelerde anormal bir değişiklik (metaplazi). Özofagusun normal skuamöz epitel astarının yerini metaplastik kolumnar epitel alır. Kolumnar epitel tipik olarak gastrointestinal sistemin daha distal bölümlerinde bulunan bir hücre türünü ifade eder</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Barrett özofagus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100580"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Özofagusun alt bölümündeki hücrelerde anormal bir değişiklik (metaplazi). Özofagusun normal skuamöz epitel astarının yerini metaplastik kolumnar epitel alır. Kolumnar epitel tipik olarak gastrointestinal sistemin daha distal bölümlerinde bulunan bir hücre türünü ifade eder</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal change (metaplasia) in the cells of the inferior portion of the esophagus. The normal squamous epithelium lining of the esophagus is replaced by metaplastic columnar epithelium. Columnar epithelium refers to a cell type that is typically found in more distal parts of the gastrointestinal system.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
