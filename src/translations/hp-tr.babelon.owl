    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032159">
        <obo:IAO_0000115 xml:lang="tr">Bir mantar kaynaklı meninks enfeksiyonu. Genel olarak sadece bağışıklık sistemi eksiklik bireyler fungal menenjite yakalanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fungal menenjit</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032159"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir mantar kaynaklı meninks enfeksiyonu. Genel olarak sadece bağışıklık sistemi eksiklik bireyler fungal menenjite yakalanır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A meningitis caused by fungal infection, with the principal causative organism being Cryptococcus neoformans (cryptococcal meningitis); other causes include Candida and Coccidioides species. A fungal meningitis is most often a manifestation of unusual susceptibility to infection, particularly in severe T-cell deficiencies.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032159"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Fungal menenjit</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fungal meningitis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032160">
        <obo:IAO_0000115 xml:lang="tr">Cryptococcus cinsine ait olan kapsüllü bir mayadan kaynaklanan bir tip fungal menenjit. Cryptococcus neoformans ve Cryptococcus gattii insan kriptokokkoz vakalarının çoğundan sorumludur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kriptokokal menenjit</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032160"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Cryptococcus cinsine ait olan kapsüllü bir mayadan kaynaklanan bir tip fungal menenjit. Cryptococcus neoformans ve Cryptococcus gattii insan kriptokokkoz vakalarının çoğundan sorumludur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of fungal meningitis caused by an encapsulated yeast that belongs to the genus Cryptococcus. Cryptococcus neoformans and Cryptococcus gattii are responsible for the majority of cases of human cryptococcosis.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032160"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kriptokokal menenjit</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cryptococcal meningitis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032161">
        <obo:IAO_0000115 xml:lang="tr">Baziler meninks yaygın koksidiyoides kaynaklı bir fungal menenjit tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Koksidiodiyal menenjit</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032161"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Baziler meninks yaygın koksidiyoides kaynaklı bir fungal menenjit tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of fungal meningitis caused by dissemination of coccidioides to basilar meninges.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032161"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Koksidiodiyal menenjit</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Coccidioidal meningitis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032162">
        <obo:IAO_0000115 xml:lang="tr">Enfeksiyona patolojik bir yatkınlık belirtisi olarak değerlendirilebilecek derinin bir enfeksiyon tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Olağan olmayan deri enfeksiyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032162"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Enfeksiyona patolojik bir yatkınlık belirtisi olarak değerlendirilebilecek derinin bir enfeksiyon tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased susceptibility to infection of the skin, nails, or mucous membranes, as manifested by recurrent or severe cutaneous or mucosal infection, or by skin or mucous membrane infection caused by an atypical or opportunistic organism.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
