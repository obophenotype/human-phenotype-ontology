    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011373">
        <obo:IAO_0000115 xml:lang="tr">Kohlear bölümlenmenin tam olmayan formasyonu. Skala vestibuli ve skala timpani apikal dönüş haricinde iki skalanın helikotrema aracılığıyla devamlılıkta olduğu kohlear bölümlenme tarafından ayrılmıştır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kohleanın kısmi bölümlenmesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011373"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kohlear bölümlenmenin tam olmayan formasyonu. Skala vestibuli ve skala timpani apikal dönüş haricinde iki skalanın helikotrema aracılığıyla devamlılıkta olduğu kohlear bölümlenme tarafından ayrılmıştır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Incomplete formation of the cochlear partition. The scala vestibuli and scala tympani separated by the cochlear partition, except in the apical turn where the two scalae are in continuity via the helicotrema.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011373"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kohleanın kısmi bölümlenmesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Incomplete partition of the cochlea</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011374">
        <obo:IAO_0000115 xml:lang="tr">Kohlea bütün modiolus ve kribriform alandan yoksun olup kistik bir görünüm ile sonuçlanmaktadır. Buna geniş kistik vestibül eşlik etmektedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kohleanın kısmi bölümlenmesi tip I</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011374"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kohlea bütün modiolus ve kribriform alandan yoksun olup kistik bir görünüm ile sonuçlanmaktadır. Buna geniş kistik vestibül eşlik etmektedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Incomplete partition I is also known as cystic cochleovestibular malformation, where the cochlea has no bony modiolus, resulting in an empty cystic cochlea. This is accompanied by a dilated cystic vestibule with developmental arrest at the fifth week of gestation.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011374"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kohleanın kısmi bölümlenmesi tip I</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Incomplete partition of the cochlea type I</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011375">
        <obo:IAO_0000115 xml:lang="tr">Gelişimsel bir defekte bağlı iç kulakta spiral şekilli bir boşluk olan kohlea yokluğu</obo:IAO_0000115>
