        <owl:annotatedTarget xml:lang="tr">Çizgisel formlu, sınırları yükselmiş ve sarımsı renkli bir çeşit nevüs sebaseus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
