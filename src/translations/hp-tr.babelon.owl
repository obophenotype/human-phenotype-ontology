    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032275">
        <obo:IAO_0000115 xml:lang="tr">Varisella zoster virüsü (VZV) reaktivasyonu ile ilişkili bir veya iki bitişik dermatomda karakteristik bir döküntü ile karakterize yerleşmiş, ağrılı kutanöz erupsiyonun tekrarlayan epizotları</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tekrarlayan zona</rdfs:label>
