    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011513">
        <obo:IAO_0000115 xml:lang="tr">İç retinal katmanlar içinde veya optik diskin yüzeyinde kan dolu keseciklerin gruplaşması olarak görünen retinanın selim bir tümörü. Retinal kavernöz anjiyomlar &apos;üzüm salkımı&apos; görünüme sahip olarak tariflenir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Retinal kavernöz anjiyom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011513"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İç retinal katmanlar içinde veya optik diskin yüzeyinde kan dolu keseciklerin gruplaşması olarak görünen retinanın selim bir tümörü. Retinal kavernöz anjiyomlar &apos;üzüm salkımı&apos; görünüme sahip olarak tariflenir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A benign tumor of the retina that appears as a grouping of blood-filled saccules within the inner retinal layers or on the surface of the optic disc. Retinal cavernous hemangioma are described as having a &apos;cluster of grapes&apos; appearance.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011513"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Retinal kavernöz anjiyom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Retinal cavernous hemangioma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011514">
        <obo:IAO_0000115 xml:lang="tr">Her iki gözden görsel girdileri derinlik algısı ile tek bir görüntüye sentezleme yeteneği olan binoküler görüşün bir anormalliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Binoküler vizyon anormalliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011514"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Her iki gözden görsel girdileri derinlik algısı ile tek bir görüntüye sentezleme yeteneği olan binoküler görüşün bir anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of binocular vision, that is of the ability to synthesize the visual inputs from both eyes to a single image with perception of depth.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011514"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Binoküler vizyon anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of binocular vision</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011515">
        <obo:IAO_0000115 xml:lang="tr">Başın üzerinde iki gözün farklı pozisyonlari ile ıraklıktan elde edilen ince derin ayrımlar yapamama</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal stereopsis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011515"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Başın üzerinde iki gözün farklı pozisyonlari ile ıraklıktan elde edilen ince derin ayrımlar yapamama</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inability to make fine depth discriminations from parallax provided by the two eyes&apos; different positions on the head.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011515"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal stereopsis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal stereopsis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011516">
        <obo:IAO_0000115 xml:lang="tr">Retinanın hiç fonksiyonel hücre içermediği bir durum, böylece renk ayırımı yokluğuna ek olarak, normal yoğunluktaki ışıkta görüş zordur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Akromatopsia</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011516"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Retinanın hiç fonksiyonel hücre içermediği bir durum, böylece renk ayırımı yokluğuna ek olarak, normal yoğunluktaki ışıkta görüş zordur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A condition where the retina contains no functional cone cells, so that in addition to the absence of color discrimination, vision in lights of normal intensity is difficult.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011516"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Akromatopsia</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Achromatopsia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011517">
        <obo:IAO_0000115 xml:lang="tr">Sadece tek bir tür koninin olduğu, hem çubukların hem de konilerin olduğu durum. Etkilenmiş bireyler gün ışığında iyi görüş paternine sahiptir, fakat renkler arasında ayrım yapamaz</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Koni monokromasisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011517"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sadece tek bir tür koninin olduğu, hem çubukların hem de konilerin olduğu durum. Etkilenmiş bireyler gün ışığında iyi görüş paternine sahiptir, fakat renkler arasında ayrım yapamaz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The condition of having both rods and cones, but only a single kind of cone. Affected individuals have good pattern vision in daylight, but cannot distinguish between colors.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011517"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Koni monokromasisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cone monochromacy</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011518">
        <obo:IAO_0000115 xml:lang="tr">Dikkoziteden etkilenen yetişkinler üç yerine iki koni türüne sahiptirler</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dikromasi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011518"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Dikkoziteden etkilenen yetişkinler üç yerine iki koni türüne sahiptirler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Individuals affected by dichromacy possess only two types of cones, instead of three.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011518"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Dikromasi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dichromacy</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011519">
        <obo:IAO_0000115 xml:lang="tr">Anormal trikromasili bireyler üç tip koniye sahiptir, fakat üç tip koniden biri normal konilere kıyaslandığında anormal spektral duyarlılığa sahiptir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anomalili trikromasi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011519"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Anormal trikromasili bireyler üç tip koniye sahiptir, fakat üç tip koniden biri normal konilere kıyaslandığında anormal spektral duyarlılığa sahiptir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Individuals with anomalous trichromacy possess three types of cones, but one of the three types of cones has an abnormal spectral sensitivity compared to normal cones.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011519"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anomalili trikromasi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anomalous trichromacy</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011520">
        <obo:IAO_0000115 xml:lang="tr">Absorpsiyon spektrumu L dalga boyuna kayan anormal M fotopigmenti ile ilişkili bir tip anormal trikromasi. Etkilenmiş bireyler kırmızı ve yeşili birbirinden ayırt etmede zorluklara sahiptir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Döteranomali</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011520"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Absorpsiyon spektrumu L dalga boyuna kayan anormal M fotopigmenti ile ilişkili bir tip anormal trikromasi. Etkilenmiş bireyler kırmızı ve yeşili birbirinden ayırt etmede zorluklara sahiptir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of anomalous trichromacy associated with abnormal M photopigment, such that the absorption spectrum is shifted toward L wavelengths. Affected individuals have difficulties distinguishing between red and green.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011520"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Döteranomali</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Deuteranomaly</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011521">
        <obo:IAO_0000115 xml:lang="tr">L fotopigmenti ile yer degiştirmiş M fotopigmentinin tam yokluğu. Etkilenmiş bireyler kırmızı ve yeşili karıştırma eğilimindedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Döteranopi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011521"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">L fotopigmenti ile yer degiştirmiş M fotopigmentinin tam yokluğu. Etkilenmiş bireyler kırmızı ve yeşili karıştırma eğilimindedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complete lack of the M photopigment, which is replaced with the L photopigment. Affected individuals tend to confuse red and green.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011521"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Döteranopi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Deuteranopia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011522">
        <obo:IAO_0000115 xml:lang="tr">Sadece mavi ve yeşil koniler; fonksiyonel kırmızı koni yok</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Protanopi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011522"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sadece mavi ve yeşil koniler; fonksiyonel kırmızı koni yok</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
