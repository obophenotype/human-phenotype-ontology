    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000641">
        <obo:IAO_0000115 xml:lang="tr">Salınımsal göz hareketleri için kontrol edici sinyalin iki bileşeni vardır: gözü bir noktadan diğerine hızlıca hareket ettiren uyarı ve gözü yeni noktada tutan basamak. Hem uyarı hem de basamak doğru boyutta olmadığında, dismetrik yeniden odaklanma şeklinde göz hareketi ile sonuçlanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dismetrik sıçramalar</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000641"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Salınımsal göz hareketleri için kontrol edici sinyalin iki bileşeni vardır: gözü bir noktadan diğerine hızlıca hareket ettiren uyarı ve gözü yeni noktada tutan basamak. Hem uyarı hem de basamak doğru boyutta olmadığında, dismetrik yeniden odaklanma şeklinde göz hareketi ile sonuçlanır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The controller signal for saccadic eye movements has two components: the pulse that moves the eye rapidly from one point to the next, and the step that holds the eye in the new position. When both the pulse and the step are not the correct size, a dysmetric refixation eye movement results.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000641"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Dismetrik sıçramalar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dysmetric saccades</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
