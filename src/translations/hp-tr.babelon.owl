    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030201">
        <obo:IAO_0000115 xml:lang="tr">Belirli ilaçlar nöromüsküler iletim ile alakalı farklı hücresel mekanizmalar ile seçerek çatışır (sentez, depolama, salma, eylem ve transmiterin inaktivasyonu). Bu sebeple, bir hastanın belirli bir ilaca cevabı ayırıcı tanı için kullanışlı bilgiler barındırabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Nöromüsküler iletim üzerine etki gösteren ilaçlara cevap</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030201"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Belirli ilaçlar nöromüsküler iletim ile alakalı farklı hücresel mekanizmalar ile seçerek çatışır (sentez, depolama, salma, eylem ve transmiterin inaktivasyonu). Bu sebeple, bir hastanın belirli bir ilaca cevabı ayırıcı tanı için kullanışlı bilgiler barındırabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Specific drugs interfere selectively with the different cellular mechanisms involved in neuromuscular transmission (synthesis, storage, release, action and inactivation of transmitter). The response of a patient to a specific drug can therefore be useful information for the differential diagnosis.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030201"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Nöromüsküler iletim üzerine etki gösteren ilaçlara cevap</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Response to drugs acting on neuromuscular transmission</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030202">
        <obo:IAO_0000115 xml:lang="tr">Asetilkolin esteraz inhibitörü uygulamasına yanıt olarak kas gücünün iyileşmesi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Zayıflığa karşı asetilkolin esteraz inhibitörlerine olumlu yanıt</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030202"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Asetilkolin esteraz inhibitörü uygulamasına yanıt olarak kas gücünün iyileşmesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Improvement of muscle strength in response to administration of an acetylcholine esterase inhibitor.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030202"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Zayıflığa karşı asetilkolin esteraz inhibitörlerine olumlu yanıt</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Favorable response of weakness to acetylcholine esterase inhibitors</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030203">
        <obo:IAO_0000115 xml:lang="tr">Asetilkolin esteraz inhibitörü uygulamasına yanıt olarak kas gücünün iyileşmesi eksikliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kas zayıflığına karşı asetilkolin esteraz inhibitörlerine olumsuz yanıt</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030203"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Asetilkolin esteraz inhibitörü uygulamasına yanıt olarak kas gücünün iyileşmesi eksikliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lack of improvement of muscle strength in response to administration of an acetylcholine esterase inhibitor.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030203"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kas zayıflığına karşı asetilkolin esteraz inhibitörlerine olumsuz yanıt</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Unfavorable response of muscle weakness to acetylcholine esterase inhibitors</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030205">
        <obo:IAO_0000115 xml:lang="tr">Aynı motor ünitesinin iki aksiyon potansiyeli arasındaki zaman aralığındaki değişime jitter denir. Bu nedenle bu terim, elektromiyografi (EMG) ile ölçülen, aynı motor ünitesinin ardışık eylem potansiyelleri arasındaki aralığın değişkenli artışı için uygulanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tek lif EMG&apos;sinde artmış seğirme</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030205"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Aynı motor ünitesinin iki aksiyon potansiyeli arasındaki zaman aralığındaki değişime jitter denir. Bu nedenle bu terim, elektromiyografi (EMG) ile ölçülen, aynı motor ünitesinin ardışık eylem potansiyelleri arasındaki aralığın değişkenli artışı için uygulanır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The variation in the time interval between the two action potentials of the same motor unit is called jitter. This term therefore applies to increased variability in the interval between successive action potentials of the same motor unit, which is measured by electromyography (EMG).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030205"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Tek lif EMG&apos;sinde artmış seğirme</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased jitter at single fiber EMG</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030206">
        <obo:IAO_0000115 xml:lang="tr">Birleşik kas hareket potansiyeli (CMAP), bir çeşit elektromiyografidir (EMG). CMAP, motor sinir uyarımı ile uyandırılan aynı bölgedeki birkaç kas lifinden hemen hemen eş zamanlı hareket potansiyelleri grubunu ifade eder ve birçok eylem potansiyeli olduğu kaydedilir. Bu anormallik, araştırma süresince bolca anormal bir artışı işaret eder</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">EMG: tekrarlayan sinir uyarımına bileşik kas aksiyon potansiyelinin çoğalan yanıtı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030206"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Birleşik kas hareket potansiyeli (CMAP), bir çeşit elektromiyografidir (EMG). CMAP, motor sinir uyarımı ile uyandırılan aynı bölgedeki birkaç kas lifinden hemen hemen eş zamanlı hareket potansiyelleri grubunu ifade eder ve birçok eylem potansiyeli olduğu kaydedilir. Bu anormallik, araştırma süresince bolca anormal bir artışı işaret eder</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A compound muscle action potential (CMAP) is a type of electromyography (EMG). CMAP refers to a group of almost simultaneous action potentials from several muscle fibers in the same area evoked by stimulation of the supplying motor nerve and are recorded as one multipeaked summated action potential. This abnormality refers to an abnormal increase in the amplitude during the course of the investigation.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030206"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">EMG: tekrarlayan sinir uyarımına bileşik kas aksiyon potansiyelinin çoğalan yanıtı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>EMG: incremental response of compound muscle action potential to repetitive nerve stimulation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030207">
        <obo:IAO_0000115 xml:lang="tr">Normal hareketlerin tersine, göğüs duvarının inspirasyonda ve ekspirasyonda hareket ettiği solunum hareketleridir. İnspirasyon sırasında interkostal boşlukların çıkmasıyla sonuçlanan herhangi bir nedenle solunum sıkıntısı olan çocuklarda görülebilir. Kronik hava yolu tıkanıklığı olan hastalar, basınçlı ve düzleşmiş bir diyaframın çarpık hareketi nedeniyle, inspirasyon esnasında alt kaburgaların içeriye çekilmesini de gösterir. Çatlak kaburgalar ve göğüs kafesi ile göğüsün ezilme yaralanmaları, şiddetli derecede paradoksal soluma neden olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Paradoksik solunum</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030207"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Normal hareketlerin tersine, göğüs duvarının inspirasyonda ve ekspirasyonda hareket ettiği solunum hareketleridir. İnspirasyon sırasında interkostal boşlukların çıkmasıyla sonuçlanan herhangi bir nedenle solunum sıkıntısı olan çocuklarda görülebilir. Kronik hava yolu tıkanıklığı olan hastalar, basınçlı ve düzleşmiş bir diyaframın çarpık hareketi nedeniyle, inspirasyon esnasında alt kaburgaların içeriye çekilmesini de gösterir. Çatlak kaburgalar ve göğüs kafesi ile göğüsün ezilme yaralanmaları, şiddetli derecede paradoksal soluma neden olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Breathing movements in which the chest wall moves in on inspiration and out on expiration, in reverse of the normal movements. It may be seen in children with respiratory distress of any cause, which leads to indrawing of the intercostal spaces during inspiration. Patients with chronic airways obstruction also show indrawing of the lower ribs during inspiration, due to the distorted action of a depressed and flattened diaphragm. Crush injuries of the chest, with fractured ribs and sternum, can lead to a severe degree of paradoxical breathing.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030207"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Paradoksik solunum</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Paradoxical respiration</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030208">
        <obo:IAO_0000115 xml:lang="tr">Asetilkolin reseptörlerine karşı serumda reaksiyon veren otoantikorların (immünoglobulin) varlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Asetilkolin reseptör antikoru pozitifliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030208"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Asetilkolin reseptörlerine karşı serumda reaksiyon veren otoantikorların (immünoglobulin) varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of autoantibodies (immunoglobulins) in the blood circulation that react against neuromuscular junction acetylcholine receptors.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030208"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Asetilkolin reseptör antikoru pozitifliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anti-neuromuscular Junction acetylcholine receptor antibody positivity</babelon:source_value>
