        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Maruz kalınan fosfatidilserin aracılığı ile anneksin V&apos;in platelet membranına artmış bağlanması. Bu akım sitometrisi ile ölçülebilir</owl:annotatedTarget>
