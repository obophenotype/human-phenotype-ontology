        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003403">
        <obo:IAO_0000115 xml:lang="tr">Birleşik kas hareket potansiyeli (CMAP), bir çeşit elektromiyografidir (EMG). CMAP, motor sinir uyarımı ile uyandırılan aynı bölgedeki birkaç kas lifinden hemen hemen eş zamanlı hareket potansiyelleri grubunu ifade eder ve birçok eylem potansiyeli olduğu kaydedilir. Bu anormallik, araştırma süresince genlikte anormal bir artışı ifade eder</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">EMG: tekrarlayan sinir uyarımına bileşik kas aksiyon potansiyelinin azalan yanıtı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003403"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Birleşik kas hareket potansiyeli (CMAP), bir çeşit elektromiyografidir (EMG). CMAP, motor sinir uyarımı ile uyandırılan aynı bölgedeki birkaç kas lifinden hemen hemen eş zamanlı hareket potansiyelleri grubunu ifade eder ve birçok eylem potansiyeli olduğu kaydedilir. Bu anormallik, araştırma süresince genlikte anormal bir artışı ifade eder</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A compound muscle action potential (CMAP) is a type of electromyography (EMG). CMAP refers to a group of almost simultaneous action potentials from several muscle fibers in the same area evoked by stimulation of the supplying motor nerve and are recorded as one multipeaked summated action potential. This abnormality refers to a greater than normal decrease in the amplitude during the course of the investigation.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003403"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">EMG: tekrarlayan sinir uyarımına bileşik kas aksiyon potansiyelinin azalan yanıtı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>EMG: decremental response of compound muscle action potential to repetitive nerve stimulation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
