    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007181">
        <obo:IAO_0000115 xml:lang="tr">Kemikler arası kasların atrofisi (metakarpallerin ön yüzünde bulunan palmar interossei, interkarpalların arasında yer alan elin kemikler arası dorsal kasları, metatarsal kemiklerin altında yer alan plantar kemikler arası kasları, metatarsal kemikler arasında bulunan dorsal interossei dahil olmak üzere</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Interosseus kası atrofisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007181"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kemikler arası kasların atrofisi (metakarpallerin ön yüzünde bulunan palmar interossei, interkarpalların arasında yer alan elin kemikler arası dorsal kasları, metatarsal kemiklerin altında yer alan plantar kemikler arası kasları, metatarsal kemikler arasında bulunan dorsal interossei dahil olmak üzere</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrophy of the interosseus muscles (including the palmar interossei that lie on the anterior aspect of the metacarpals, the dorsal interosseus muscles of the hand, which lie between the intercarpals, the plantar interosseus muscles, which lie underneath the metatarsal bones, and the dorsal interossei, which are located between the metatarsal bones.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
