        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005507">
        <obo:IAO_0000115 xml:lang="tr">Normal yetişkin hemoglobini alfa ve beta globin olmak üzere iki zincirden oluşur. Hb Barts (Hemoglobin Barts) dört gama globin zincirine sahip bir tetramerdir ve alfa talaseminin bir veya diğer türleri için özünde patonomoniktir. Hb Bartsın oksijen alma eğilimi çok yüksektir ve bu sebeple neredeyse dokulara hiç oksijen vermez</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hemoglobin Barts</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005507"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Normal yetişkin hemoglobini alfa ve beta globin olmak üzere iki zincirden oluşur. Hb Barts (Hemoglobin Barts) dört gama globin zincirine sahip bir tetramerdir ve alfa talaseminin bir veya diğer türleri için özünde patonomoniktir. Hb Bartsın oksijen alma eğilimi çok yüksektir ve bu sebeple neredeyse dokulara hiç oksijen vermez</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Normal adult hemoglobin is composed of two chains each of alpha and beta globin. Hb Barts (Hemoglobin Barts) is a tetramer with four gamma globin chains, and is essentially pathognomonic for one or another form of alpha thalassemia. Hb Barts has an extremely high affinity for oxygen, resulting in almost no oxygen delivery to the tissues.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005507"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hemoglobin Barts</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hemoglobin Barts</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
