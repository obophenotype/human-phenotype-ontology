    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000317">
        <obo:IAO_0000115 xml:lang="tr">Yüz myokimisi yüz siniri (yedinci kafa siniri) tarafından inerve edilen bir veya daha fazla kasın ince fibriler aktivitesidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yüz myokimisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000317"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Yüz myokimisi yüz siniri (yedinci kafa siniri) tarafından inerve edilen bir veya daha fazla kasın ince fibriler aktivitesidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Facial myokymia is a fine fibrillary activity of one or more muscles innervated by the facial nerve (the seventh cranial nerve).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
