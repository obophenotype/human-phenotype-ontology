        <owl:annotatedTarget xml:lang="tr">Kapak gecikmesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lid lag on downgaze</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025606">
        <obo:IAO_0000115 xml:lang="tr">Okülomotor sinirin inferior bölümü tarafından inerve edilen ve tek aksiyonu göz küresinin addüksiyonu olan ekstraoküler bir kasın, mediyal rektus kasının fonksiyonel bir anomalisi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal mediyal rektus kas fizyolojisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025606"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Okülomotor sinirin inferior bölümü tarafından inerve edilen ve tek aksiyonu göz küresinin addüksiyonu olan ekstraoküler bir kasın, mediyal rektus kasının fonksiyonel bir anomalisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A functional anomaly of the medial rectus muscle, an extraocular muscle that is innervated by the inferior division of the oculomotor nerve and whose sole action is the adduction of the eyeball.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025606"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal mediyal rektus kas fizyolojisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal medial rectus muscle physiology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025607">
        <obo:IAO_0000115 xml:lang="tr">Üst göz kapağı sınırının içe dönüşü (inversiyon)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Üst göz kapağı entropiyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025607"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Üst göz kapağı sınırının içe dönüşü (inversiyon)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An inward turning (inversion) of the margin of the upper eyelid.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025607"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
