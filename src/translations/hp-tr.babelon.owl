        <rdfs:label xml:lang="tr">Anemik solgunluk</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001017"/>
