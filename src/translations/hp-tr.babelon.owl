        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deviation from the normal straight shape of the proximal phalanx of the thumb.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009632"/>
