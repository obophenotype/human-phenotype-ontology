        <owl:annotatedTarget xml:lang="tr">Platelet alfa granüllerinin yokluğu. Bu tipik olarak plateletlerin giemsa boyalı kan sürüntüsünde gri gözükmesi ile sonuçlanır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
