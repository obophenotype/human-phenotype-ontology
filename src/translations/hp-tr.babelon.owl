    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009193">
        <obo:IAO_0000115 xml:lang="tr">Bir psödoepfiz, normal epifizden farklı olarak bir ikincil ossifikasyon merkezidir. Normal metakarpal epifizleri metakarpal kemiklerin distal uçlarında bulunur. Aksesuvar epifizler (psödoepifiz olarak da bilinir), genellikle 2. metakarpal kemiği de içine alarak nadiren metakarpallerin proksimal uçlarında da görülebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Metakarpallerin psödoepifizleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009193"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir psödoepfiz, normal epifizden farklı olarak bir ikincil ossifikasyon merkezidir. Normal metakarpal epifizleri metakarpal kemiklerin distal uçlarında bulunur. Aksesuvar epifizler (psödoepifiz olarak da bilinir), genellikle 2. metakarpal kemiği de içine alarak nadiren metakarpallerin proksimal uçlarında da görülebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A pseudoepiphysis is a secondary ossification center distinct from the normal epiphysis. The normal metacarpal epiphyses are located at the distal ends of the metacarpal bones. Accessory epiphyses (which are also known as pseudoepiphyses) can also occasionally be observed at the proximal ends of the metacarpals, usually involving the 2nd metacarpal bone.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009193"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Metakarpallerin psödoepifizleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Metacarpal pseudoepiphysis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
