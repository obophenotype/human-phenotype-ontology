    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0008455">
        <obo:IAO_0000115 xml:lang="tr">Normalde beş sakral vertebra S1-S5&apos;in füzyonu ile oluşturulan sakrum bölümlerinin normal olarak oluşturulamaması veya başarısız olmasıyla oluşan sakrumun kısmi veya düzensiz gelişimi ile karakterize sakrumun gelişimsel bir kusuru</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Displastik sakrum</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0008455"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Normalde beş sakral vertebra S1-S5&apos;in füzyonu ile oluşturulan sakrum bölümlerinin normal olarak oluşturulamaması veya başarısız olmasıyla oluşan sakrumun kısmi veya düzensiz gelişimi ile karakterize sakrumun gelişimsel bir kusuru</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A developmental defect of the sacrum characterized by partial or disordered development of the sacrum in which portions of the sacrum, which normally is formed by fusion of five sacral vertebrae S1-S5, fail to form or fail to form normally.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
