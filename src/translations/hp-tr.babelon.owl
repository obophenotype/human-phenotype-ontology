        <owl:annotatedTarget xml:lang="tr">4. parmağın distal falanksının epifizinde anormal punktat (benekli, nokta gibi) varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of abnormal punctate (speckled, dot-like) calcifications in the epiphysis of the distal phalanx of the 4th finger.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
