    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025312">
        <obo:IAO_0000115 xml:lang="tr">Her iki gözün, genellikle 10 prizm dioptirisinden daha az olarak tanımlanan göreceli hafif derece içe döndüğü bir strabismus formu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Özofori</rdfs:label>
