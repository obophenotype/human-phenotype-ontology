    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003908">
        <obo:IAO_0000115 xml:lang="tr">Uzun bir kemiğin metafizinin yan kısmında kırık veya parçalanma. Metafizin küçük bir köşesinin metafizik kenardan ince doğrusal radyolüsansla ayrılması, radyografik görünümdür. Bu özellik, çocuk istismarında gözlenebilir; ancak, metafizin parçalanmış görüntüsü ya da facture benzeri lezyonlar, belirli iskelet displazilerinin oluşumunda da tespit edilebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Metafizin köşe kırığı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003908"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Uzun bir kemiğin metafizinin yan kısmında kırık veya parçalanma. Metafizin küçük bir köşesinin metafizik kenardan ince doğrusal radyolüsansla ayrılması, radyografik görünümdür. Bu özellik, çocuk istismarında gözlenebilir; ancak, metafizin parçalanmış görüntüsü ya da facture benzeri lezyonlar, belirli iskelet displazilerinin oluşumunda da tespit edilebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fracture or fragmentation at the lateral portion of the metaphysis of a long bone. The radiographic appearance is that of a small corner of metaphysis separated from the metaphyseal edge by thin linear radiolucency. This feature can be observed in child abuse but fragmented appearance of the metaphysis or facture-like lesions can also be detected in the setting of certain skeletal dysplasias.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003908"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Metafizin köşe kırığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Corner fracture of metaphysis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
