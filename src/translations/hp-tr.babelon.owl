    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010850">
        <obo:IAO_0000115 xml:lang="tr">Elektroensefalografi (EEG) ile kafa derisi üzerinden kayıt edilen serebral elektrik aktivitede epilepsi ile güçlü ilişkisi bulunan geçici keskin dalgalar olan diken (&lt;70 ms) ve keskin dalga (70-200 ms) kompleksleri</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Diken-dalga kompleksli EEG</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010850"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Elektroensefalografi (EEG) ile kafa derisi üzerinden kayıt edilen serebral elektrik aktivitede epilepsi ile güçlü ilişkisi bulunan geçici keskin dalgalar olan diken (&lt;70 ms) ve keskin dalga (70-200 ms) kompleksleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complexes of spikes (&lt;70 ms) and sharp waves (70-200 ms), which are sharp transient waves that have a strong association with epilepsy, in cerebral electrical activity recorded along the scalp by electroencephalography (EEG).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010850"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Diken-dalga kompleksli EEG</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>EEG with spike-wave complexes</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010851">
        <obo:IAO_0000115 xml:lang="tr">Elektroensefalografideki boşalım baskılanım paterni karakteristik bir periyodik düşük voltaj (&lt;10 mikrovolt) paternine, baskılanmış arka plana ve yüksek genlikli yavaş, keskin, ve diken kompleksilerinin göreceli kısa paternine denmektedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Patlama baskılanmalı EEG</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010851"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Elektroensefalografideki boşalım baskılanım paterni karakteristik bir periyodik düşük voltaj (&lt;10 mikrovolt) paternine, baskılanmış arka plana ve yüksek genlikli yavaş, keskin, ve diken kompleksilerinin göreceli kısa paternine denmektedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The burst suppression pattern in electroencephalography refers to a characteristic periodic pattern of low voltage (&lt;10 microvolts) suppressed background and a relatively shorter pattern of higher amplitude slow, sharp, and spiking complexes.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010851"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Patlama baskılanmalı EEG</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>EEG with burst suppression</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010852">
        <obo:IAO_0000115 xml:lang="tr">Flaşlı ışıklar veya siyah beyaz çizgili paternler ile uyarılan EEG anormallikleri (epileptiform değişiklikler)</obo:IAO_0000115>
