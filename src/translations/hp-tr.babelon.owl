    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100288">
        <obo:IAO_0000115 xml:lang="tr">Saniyede 2-10 defa düzenli aralıklarda meydana gelen ve istemli gayret ile etkilenmeyen hızlı ateşleyeci potansiyellerin spontan patlaması varlığı. Bu elektromyografik (EMG) bir bulgudur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">EMG: miyokimik boşaltımlar</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100288"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Saniyede 2-10 defa düzenli aralıklarda meydana gelen ve istemli gayret ile etkilenmeyen hızlı ateşleyeci potansiyellerin spontan patlaması varlığı. Bu elektromyografik (EMG) bir bulgudur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of spontaneous bursts of rapidly firing potentials that recur at regular intervals of 2-10 per second and are unaffected by voluntary effort. This is an electromyographic (EMG) finding.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
