        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Tipik olarak boynun nemli deri katlantıları üzerinde kalınlaşmış, hiperpigmente plaklar ile karakterize dermatozis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A dermatosis characterized by thickened, hyperpigmented plaques, typically on the intertriginous surfaces and neck.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
