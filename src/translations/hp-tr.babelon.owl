    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011761">
        <obo:IAO_0000115 xml:lang="tr">Hücresel kökeni bilinmeyen ve immünohistokimyasal veya detaylı yapısal belirteçlerden yoksun bir pitüiter adenoma tipi. Null hücreli adenomlar hormon fazlalığı ile ilişkili değildir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Pitüiter boş hücreli adenom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011761"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hücresel kökeni bilinmeyen ve immünohistokimyasal veya detaylı yapısal belirteçlerden yoksun bir pitüiter adenoma tipi. Null hücreli adenomlar hormon fazlalığı ile ilişkili değildir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of pituitary adenoma that is of unknown cellular origin and that lacks immunocytochemical or fine structural markers. Null cell adenomas are not associated with hormone excess.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
