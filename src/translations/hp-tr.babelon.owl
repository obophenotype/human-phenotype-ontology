        <owl:annotatedTarget xml:lang="tr">&quot;Yüz bölgesinde bölgedeki iki bilateral yumuşak doku yüz yapısı yanağının bir anormalliği gözlere göre daha aşağıda ve burun ile kulak arasında. &quot;&quot;Bukkal&quot;&quot; yanakla ilgili demektir. Yanak orta yüzdesinin bir parçasıdır&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>&quot;An abnormality of the cheek- one of two bilateral soft tissue facial structures in the region of the face inferior to the eyes and between the nose and the ear. &quot;&quot;Buccal&quot;&quot; means relating to the cheek. The cheek is part of the midface&quot;</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004426"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Yanak anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal cheek morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004428">
        <obo:IAO_0000115 xml:lang="tr">Bu, daha önce, kısa kalkık burunlu, geniş ağızlı, geniş aralıklı gözlü ve dolgun yanaklı bir yüz formunu tanımlamak için kullanılan bir tanımlamadır. Bu tanımın yanlış olmasından dolayı, bu özelliklerin tam olarak tanımlanması tercih edilir. Bu terim, geçmişte sıklıkla kullanıldığı için kayıt edilmektedir, ancak yeni ek açıklamalar için kullanılmamalıdır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Elf benzeri yüz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004428"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bu, daha önce, kısa kalkık burunlu, geniş ağızlı, geniş aralıklı gözlü ve dolgun yanaklı bir yüz formunu tanımlamak için kullanılan bir tanımlamadır. Bu tanımın yanlış olmasından dolayı, bu özelliklerin tam olarak tanımlanması tercih edilir. Bu terim, geçmişte sıklıkla kullanıldığı için kayıt edilmektedir, ancak yeni ek açıklamalar için kullanılmamalıdır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>This is a description previously used to describe a facial form characterized by a short, upturned nose, wide mouth, widely spaced eyes, and full cheeks. Because of the imprecision in this definition it is preferable to describe these features precisely. This term is retained because it was often used in the past, but it should not be used for new annotations.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004428"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Elf benzeri yüz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Elfin facies</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
