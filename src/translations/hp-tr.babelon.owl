        <rdfs:label xml:lang="tr">Çoklu lipomalar</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001012"/>
