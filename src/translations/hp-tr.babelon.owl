    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030197">
        <obo:IAO_0000115 xml:lang="tr">Bir kas grubu kullanıldığında ortaya çıkan ve biraz dinlenince azalan bir iskelet kası zayıflığı tipi. Bu, tekrarlayan kas hareketleriyle güç azalması demektir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İskelet kaslarının kolay yorulma zayıflığı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030197"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir kas grubu kullanıldığında ortaya çıkan ve biraz dinlenince azalan bir iskelet kası zayıflığı tipi. Bu, tekrarlayan kas hareketleriyle güç azalması demektir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of weakness of skeletal muscle that occurs after a muscle group is used and lessens if the muscle group has some rest. That is, there is diminution of strength with repetitive muscle actions.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
