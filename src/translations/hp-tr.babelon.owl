        <obo:IAO_0000115 xml:lang="tr">Parmakların bir veya daha fazla distal interfalangeyal ekleminde kronik eklem hareketi kaybı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Parmakların distal interfalangeyal eklem kontraktürü</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009697"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Parmakların bir veya daha fazla distal interfalangeyal ekleminde kronik eklem hareketi kaybı</owl:annotatedTarget>
