    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031011">
        <obo:IAO_0000115 xml:lang="tr">Arterlerin intimal yüzeyi üzerinde sarı renkli çizgiler, yamalar veya noktalar. Yağlı çizgiler Sudan III veya Sudan IV ile kırmızı boyanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yağlı çizgilenme</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031011"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Arterlerin intimal yüzeyi üzerinde sarı renkli çizgiler, yamalar veya noktalar. Yağlı çizgiler Sudan III veya Sudan IV ile kırmızı boyanır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Yellow-colored streaks, patches, or spots on the intimal surface of arteries. Fatty streaks stain red with Sudan III or Sudan IV.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031011"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Yağlı çizgilenme</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fatty streak</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031012">
        <obo:IAO_0000115 xml:lang="tr">İnce kapsül fibroaterom, tipik olarak çok sayıda makrofaj içeren, &lt;65 μm ölçülerinde, üzerinde ince ince bir fibröz kapsül bulunan nispeten büyük bir nekrotik iç kısım ile karakterize edilir ve koroner trombozun en yaygın nedeni olan plak rüptürünün öncü lezyonu olarak düşünülür</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İnce başlıklı fibroaterom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031012"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İnce kapsül fibroaterom, tipik olarak çok sayıda makrofaj içeren, &lt;65 μm ölçülerinde, üzerinde ince ince bir fibröz kapsül bulunan nispeten büyük bir nekrotik iç kısım ile karakterize edilir ve koroner trombozun en yaygın nedeni olan plak rüptürünün öncü lezyonu olarak düşünülür</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Thin-cap fibroatheroma is characterized by a relatively large necrotic core with an overlying thin fibrous cap measuring less than 65 micrometers and typically containing numerous macrophages, and is considered to be the precursor lesion of plaque rupture which is the most common cause of coronary thrombosis.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031012"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">İnce başlıklı fibroaterom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Thin-cap fibroatheroma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031013">
        <obo:IAO_0000115 xml:lang="tr">Eklem yüzeylerini içeren değişikliklerden kaynaklanan eklem hareketliliği azalması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ankiloz</rdfs:label>
