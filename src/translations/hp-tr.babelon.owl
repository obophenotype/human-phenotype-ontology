    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012537">
        <obo:IAO_0000115 xml:lang="tr">Bir veya daha fazla vücut organında ve sisteminde belirtilere yol açan, bağışıklık reaksiyonu tarafından yönetilmeyen yiyecek, içecek, yiyeceklerde bulunan besin katkı maddesi veya bileşenine karşı olan bir reaksiyon</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Gıda intoleransı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012537"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir veya daha fazla vücut organında ve sisteminde belirtilere yol açan, bağışıklık reaksiyonu tarafından yönetilmeyen yiyecek, içecek, yiyeceklerde bulunan besin katkı maddesi veya bileşenine karşı olan bir reaksiyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A detrimental reaction to a food, beverage, food additive, or compound found in foods that produces symptoms in one or more body organs and systems that is not mediated by an immune reaction.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
