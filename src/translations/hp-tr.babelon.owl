        <babelon:source_value>Modic type I vertebral endplate changes</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030777">
        <obo:IAO_0000115 xml:lang="tr">T1-ağırlıklı dizilerde yüksek sinyalli ve T2 dizilerde yüksek veya izoyoğun sinyalli vertebral son plaktan olan anormal bir manyetik rezonans tomografi sinyali. Modic tip II değişikliklerin kemik iliğinde yağlı değişime işaret ettiği düşünülmektedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Modik tip II vertebral son plak değişiklikleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
