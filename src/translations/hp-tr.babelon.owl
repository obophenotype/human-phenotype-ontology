        <obo:IAO_0000115 xml:lang="tr">Bağaşıklığı tam bir konakta kan dolaşımında normalden daha uzun virüs sürekliliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kalıcı viremi</rdfs:label>
