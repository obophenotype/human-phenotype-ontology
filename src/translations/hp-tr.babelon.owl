        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Maxillary teeth cover the mandibular teeth when biting to an increased degree. The feature is defined as a vertical overlap of the maxillary incisors over the mandibular incisors that exceeds 2 mm.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
