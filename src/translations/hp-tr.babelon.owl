        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025173"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İnterlobüler septanın nodüler veya boncuklu görünümü ile yüksek çözünürlüklü bilgisayarlı tomografide görüldüğü üzere interlobüler septanın kalınlaşması</owl:annotatedTarget>
