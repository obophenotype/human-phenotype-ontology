        <owl:annotatedTarget xml:lang="tr">Yerleşimleri dermatomlar, yani sinir kökü dağılımı ile uyuşan bir anormallik için geçerlidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Applies to an abnormality whose localization corresponds to the dermatomes, i.e., the nerve root distribution.</babelon:source_value>
