        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002583">
        <obo:IAO_0000115 xml:lang="tr">Kolit, kalın bağırsak iltihabını kasteder ve çoğunlukla kalın bağırsağın (kolon, çekum ve rektum) iltihaplannı tarif etmek için kullanılır. Kolititler akut ve kendi kendine sınırlanmış veya kronik olabilir ve geniş anlamda sindirim hastalıkları kategorisine girer</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kolit</rdfs:label>
