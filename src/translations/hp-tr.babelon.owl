        <owl:annotatedTarget xml:lang="tr">Spontan ağrı hissi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Spontaneous pain sensation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010834">
        <obo:IAO_0000115 xml:lang="tr">Trofik değişiklikler öncelikle cildin, dokuların veya kasın boşa gitmesi, kemiklerin inceltilmesi ve kılların veya tırnakların nasıl büyüdüğü, saçların kalınlaştırılması veya inceltilmesi veya kırılgan tırnaklar gibi değişiklikler içeren ağrı alanlarındaki anormallikleri tanımlamak için kullanılan bir terimdir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ağrı ilişkili trofik değişiklikler</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010834"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Trofik değişiklikler öncelikle cildin, dokuların veya kasın boşa gitmesi, kemiklerin inceltilmesi ve kılların veya tırnakların nasıl büyüdüğü, saçların kalınlaştırılması veya inceltilmesi veya kırılgan tırnaklar gibi değişiklikler içeren ağrı alanlarındaki anormallikleri tanımlamak için kullanılan bir terimdir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Trophic changes is a term used to describe abnormalities in the area of pain that include primarily wasting away of the skin, tissues, or muscle, thinning of the bones, and changes in how the hair or nails grow, including thickening or thinning of hair or brittle nails.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010834"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ağrı ilişkili trofik değişiklikler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Trophic changes related to pain</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010835">
        <obo:IAO_0000115 xml:lang="tr">Ağrı, sıcaklık kaybı veya tersi olmadan dokunma hissi ve propriyosepsiyonun seçici kaybı ile olan bir his kaybı paterni</obo:IAO_0000115>
