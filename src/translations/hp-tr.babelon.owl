    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031407">
        <obo:IAO_0000115 xml:lang="tr">Bir sitokinin hücre yüzeyindeki bir reseptöre bağlanması ile tetiklenen ve takip eden hücresel süreçlerin düzenlenmesi ile biten örneğin transkripsiyon gibi bir moleküler sinyal serisinde bir defekt veya bozulma</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Bozulmuş sitokin sinyali</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031407"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir sitokinin hücre yüzeyindeki bir reseptöre bağlanması ile tetiklenen ve takip eden hücresel süreçlerin düzenlenmesi ile biten örneğin transkripsiyon gibi bir moleküler sinyal serisinde bir defekt veya bozulma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A defect or impairment in the series of molecular signals initiated by the binding of a cytokine to a receptor on the surface of a cell, and ending with regulation of a downstream cellular process, e.g. transcription.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
