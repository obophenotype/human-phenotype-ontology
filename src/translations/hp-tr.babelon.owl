        <babelon:source_value>Pica</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011857">
        <obo:IAO_0000115 xml:lang="tr">Ya kemik iliğinde ya da ekstramedüller lokasyonda neoplastik monoklonal plazma hücrelerinin göze çarpan kitlesi</obo:IAO_0000115>
