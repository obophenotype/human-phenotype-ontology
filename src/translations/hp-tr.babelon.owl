        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mechanical percussion (i.e., striking a muscle with a reflex hammer) leads to spreading waves of muscle contractions that begin proximally and spread laterally across the muscle.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
