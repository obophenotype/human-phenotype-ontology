    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002786">
        <obo:IAO_0000115 xml:lang="tr">Bronş ve trakea içindeki kıkırdağının zayıflığı, sarkık solunum yoluna (rigid olmayan) sebep olabilir. Etkilenen bireyler solunum yollarının açıklığı konusunda sorun yaşayabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Trakeobronkomalazi</rdfs:label>
    </rdf:Description>
