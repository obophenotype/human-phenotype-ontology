        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ciddi enfeksiyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Severe infection</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032170">
        <obo:IAO_0000115 xml:lang="tr">Varisella zoster virüsü (VZV) enfeksiyonunun olağan dışı ciddi bir formu. Çoğu vakada, özellikle çocuklarda varisella deri lezyonları, düşük dereceli ateş ve halsizlik ile karakterize çok hafif bir enfeksiyondur. Ciddi enfeksiyon VZV pnömonisi, hepatit, menenjit ve yaygın varisella dahil bulgular ile karakterizedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ciddi varisella zoster enfeksiyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032170"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Varisella zoster virüsü (VZV) enfeksiyonunun olağan dışı ciddi bir formu. Çoğu vakada, özellikle çocuklarda varisella deri lezyonları, düşük dereceli ateş ve halsizlik ile karakterize çok hafif bir enfeksiyondur. Ciddi enfeksiyon VZV pnömonisi, hepatit, menenjit ve yaygın varisella dahil bulgular ile karakterizedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An unusually severe form of varicella zoster virus (VZV) infection. In the majority of the cases, especially in children, varicella is a very mild infection characterized by skin lesions, low grade fever and malaise. Severe infection is characterized by manifestations including VZV pneumonia, hepatitis, meningitis, and disseminated varicella.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032170"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ciddi varisella zoster enfeksiyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Severe varicella zoster infection</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032171">
        <obo:IAO_0000115 xml:lang="tr">Mesaneye lokalize fiziksel rahatsızlık (iğneleme, zonklama veya ağrıma) ile karakterize bir hoşnutsuzluk hissi. Mesane ağrısı tam dolu bir mesane ile daha belirgin olabilir ve idrar yapma sonrası rahatlayabilir, fakat bu her zaman geçerli değildir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Mesane ağrısı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032171"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Mesaneye lokalize fiziksel rahatsızlık (iğneleme, zonklama veya ağrıma) ile karakterize bir hoşnutsuzluk hissi. Mesane ağrısı tam dolu bir mesane ile daha belirgin olabilir ve idrar yapma sonrası rahatlayabilir, fakat bu her zaman geçerli değildir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the urinary bladder. Bladder pain may be more pronounced with a full bladder and relieved upon urination, but this is not always the case.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032171"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Mesane ağrısı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bladder pain</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032172">
        <obo:IAO_0000115 xml:lang="tr">Pulmoner bir boşlukta yumuşak bir doku kitlesini çevreleyen ve hem düz röntgende hem de BT taramada görülebilen hava hilali</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hava hilali işareti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032172"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Pulmoner bir boşlukta yumuşak bir doku kitlesini çevreleyen ve hem düz röntgende hem de BT taramada görülebilen hava hilali</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A crescent of air surrounding a soft-tissue mass in a pulmonary cavity and can be seen in both plain X-ray and CT scan</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032172"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hava hilali işareti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>obsolete Air crescent sign</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032173">
        <obo:IAO_0000115 xml:lang="tr">Bu işaret, göğüs röntgeninde diyaframın tamamen görülmesi ile sonuçlanan bu nedenle devamlı diyafram işareti olarak adlandırılan, kalbin alt sınırı ve diyaframın üst kısmı arasında hava biriktiği pnömomediastinumda görülür</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kesintisiz diyafram işareti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032173"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bu işaret, göğüs röntgeninde diyaframın tamamen görülmesi ile sonuçlanan bu nedenle devamlı diyafram işareti olarak adlandırılan, kalbin alt sınırı ve diyaframın üst kısmı arasında hava biriktiği pnömomediastinumda görülür</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>This sign is seen in pneumomediastinum in which air accumulates between the lower border of the heart and the superior part of the diaphragm, which results in complete visualization of the diaphragm in chest X-ray, hence named continuous diaphragm sign.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032173"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kesintisiz diyafram işareti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Continuous diaphragm sign</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032174">
        <obo:IAO_0000115 xml:lang="tr">Tomurcuklu ağaç paterni tomurcuklanan bir ağacı andıran sentrilobüler dallanan yapıları temsil eder. Patern mukoid sıkışma, inflamasyon ve/veya fibrozis dahil endo ve peribronşiyoler hastalık spektrumunu yansıtır (PMID: 18195376 Figür 70)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tomurcuklu ağaç işareti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032174"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Tomurcuklu ağaç paterni tomurcuklanan bir ağacı andıran sentrilobüler dallanan yapıları temsil eder. Patern mukoid sıkışma, inflamasyon ve/veya fibrozis dahil endo ve peribronşiyoler hastalık spektrumunu yansıtır (PMID: 18195376 Figür 70)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The tree-in-bud pattern represents centrilobular branching structures that resemble a budding tree. The pattern reflects a spectrum of endo- and peribronchiolar disorders, including mucoid impaction, inflammation, and/or fibrosis (See Figure 70 of PMID:18195376).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032174"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Tomurcuklu ağaç işareti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tree-in-bud pattern</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032175">
        <obo:IAO_0000115 xml:lang="tr">Bu bulgu çapraz kesitte genişlemiş bir bronkusu temsil eden halka şekilli bir opasiteden ve pulmoner arterini temsil eden mühür (veya inci) halkasını andıran kombinasyonlu daha küçük bir bitişik opasiteden oluşmuştur. Pulmoner bilgisayarlı tomografi görüntülemesinde bronşiektazinin esas belirtisidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kaşe halkası işareti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032175"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bu bulgu çapraz kesitte genişlemiş bir bronkusu temsil eden halka şekilli bir opasiteden ve pulmoner arterini temsil eden mühür (veya inci) halkasını andıran kombinasyonlu daha küçük bir bitişik opasiteden oluşmuştur. Pulmoner bilgisayarlı tomografi görüntülemesinde bronşiektazinin esas belirtisidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>This finding is composed of a ring-shaped opacity representing a dilated bronchus in cross section and a smaller adjacent opacity representing its pulmonary artery, with the combination resembling a signet (or pearl) ring. It is the basic sign of bronchiectasis in pulmonary computed tomography imaging.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032175"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kaşe halkası işareti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Signet ring sign</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032176">
        <obo:IAO_0000115 xml:lang="tr">Apikal kep genellikle intrapulmoner ve plevral fibroz tarafından ekstraplevral yağı aşağıya çeken veya muhtemelen viseral plevra üzerinde hyalin plak oluşumu ile sonuçlanan kronik iskemi tarafından kaynaklı akciğer tepesinde başlık benzeri bir lezyondur. Prevelans yaş ile artar. Aort rüptüründen kaynaklı hematomda veya enfeksiyon veya tümör ile ilişkili diğer sıvı toplanmasında da ya paryetal plevra dışında ya da plevral boşluk içinde loküllenmiş olarak görülebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Apikal pulmoner opasite</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032176"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Apikal kep genellikle intrapulmoner ve plevral fibroz tarafından ekstraplevral yağı aşağıya çeken veya muhtemelen viseral plevra üzerinde hyalin plak oluşumu ile sonuçlanan kronik iskemi tarafından kaynaklı akciğer tepesinde başlık benzeri bir lezyondur. Prevelans yaş ile artar. Aort rüptüründen kaynaklı hematomda veya enfeksiyon veya tümör ile ilişkili diğer sıvı toplanmasında da ya paryetal plevra dışında ya da plevral boşluk içinde loküllenmiş olarak görülebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An apical cap is a caplike lesion at the lung apex, usually caused by intrapulmonary and pleural fibrosis pulling down extrapleural fat or possibly by chronic ischemia resulting in hyaline plaque formation on the visceral pleura. The prevalence increases with age. It can also be seen in hematoma resulting from aortic rupture or in other fluid collection associated with infection or tumor, either outside the parietal pleura or loculated within the pleural space.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032176"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Apikal pulmoner opasite</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Apical pulmonary opacity</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032177">
        <obo:IAO_0000115 xml:lang="tr">Konsolidasyon, akciğeri katı hale getiren (enfektif pnömonideki gibi) alveolar havanın yerine geçen hastalığın eksüdatına veya diğer ürününe denir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Parankimal konsolidasyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032177"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Konsolidasyon, akciğeri katı hale getiren (enfektif pnömonideki gibi) alveolar havanın yerine geçen hastalığın eksüdatına veya diğer ürününe denir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Consolidation refers to an exudate or other product of disease that replaces alveolar air, rendering the lung solid (as in infective pneumonia).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032177"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Parankimal konsolidasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Parenchymal consolidation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032178">
        <obo:IAO_0000115 xml:lang="tr">Genel olarak parlak, enamel benzeri, düzensiz bir paternde hiperpigmente pulcuk ile karakterize bir dermatozis. Pulcuklar eski, güneşte yanmış kabarcıklanmış boya sıklıkla altta yatan hipopigmente sahalar şeklinde soyulabilir veya deskuamasyona uğrayabilir. Bu, soyulan boyaya veya pulsu boya dermatozisine yol açar (PMID:24285001&apos;deki Figüre bakınız)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Lapa lapa boyanmış dermatozis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032178"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Genel olarak parlak, enamel benzeri, düzensiz bir paternde hiperpigmente pulcuk ile karakterize bir dermatozis. Pulcuklar eski, güneşte yanmış kabarcıklanmış boya sıklıkla altta yatan hipopigmente sahalar şeklinde soyulabilir veya deskuamasyona uğrayabilir. Bu, soyulan boyaya veya pulsu boya dermatozisine yol açar (PMID:24285001&apos;deki Figüre bakınız)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A dermatosis characterized by generalized shiny, enamel-like, hyperpigmented scales in an irregular pattern. The scales may peel or desquamate, rather like old, sun-baked blistered paint, often with areas of underlying hypopigmentation. This has led to the terms peeling paint or flaky paint dermatosis (See the Figure in PMID:24285001).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032178"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Lapa lapa boyanmış dermatozis</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Flaky paint dermatosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032179">
        <obo:IAO_0000115 xml:lang="tr">Kanda anormal globulin konsantrasyonu. Albümin serumda var olan total proteinin yarısından fazlasını yapar. Albümin ve fibrinojen (serumda değildir) hariç geri kalan kan proteinleri globulinler olarak tanımlanır. Globulin bölümü taşıyıcı proteinler, enzimler, kompleman ve immünoglobulinler dahil yüzlerce serum proteinini içerir. İmmünoglobulinler plazma hücrelerinde sentezlenmesine rağmen bunların çoğu karaciğerde sentezlenir. Globulinler elektroforez ile dört gruba ayrılmıştır. Dört bölüm anot ve katot arasında göç etme paternine bağlı olarak alfa1, alfa2, beta ve gamadır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal dolaşım globulin seviyesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032179"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kanda anormal globulin konsantrasyonu. Albümin serumda var olan total proteinin yarısından fazlasını yapar. Albümin ve fibrinojen (serumda değildir) hariç geri kalan kan proteinleri globulinler olarak tanımlanır. Globulin bölümü taşıyıcı proteinler, enzimler, kompleman ve immünoglobulinler dahil yüzlerce serum proteinini içerir. İmmünoglobulinler plazma hücrelerinde sentezlenmesine rağmen bunların çoğu karaciğerde sentezlenir. Globulinler elektroforez ile dört gruba ayrılmıştır. Dört bölüm anot ve katot arasında göç etme paternine bağlı olarak alfa1, alfa2, beta ve gamadır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any deviation from the normal concentration of globulins in the blood circulation.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032179"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal dolaşım globulin seviyesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal circulating globulin concentration</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032180">
        <obo:IAO_0000115 xml:lang="tr">Kanda ölçülen bir analitin anormal bir seviyesi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal dolaşım metabolit konsantrasyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032180"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kanda ölçülen bir analitin anormal bir seviyesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal level of an analyte measured in the blood.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032180"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal dolaşım metabolit konsantrasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal circulating metabolite concentration</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032181">
        <obo:IAO_0000115 xml:lang="tr">Normal olarak deoksijene kanı karaciğerden inferior vena kavaya drene eden ve hepatik venler vasıtası ile sol atriyuma drene eden hepatik venlerin anormalliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sol atriyum içine anomalili hepatik venöz drenaj</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032181"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Normal olarak deoksijene kanı karaciğerden inferior vena kavaya drene eden ve hepatik venler vasıtası ile sol atriyuma drene eden hepatik venlerin anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the hepatic veins, which normally drain de-oxygenated blood from the liver into the inferior vena cava, whereby the hepatic veins drain into the left atrium.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032181"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Sol atriyum içine anomalili hepatik venöz drenaj</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anomalous hepatic venous drainage into the left atrium</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032182">
        <obo:IAO_0000115 xml:lang="tr">Kandaki total T hücre sayısı ile karşılaştırıldığında hafıza T hücrelerinin anormal bir oranı. Hafıza T hücreleri daha önceden karşılaşmış ve aynı kökten olan antijenlerine yanıt vermiştir ve antijen ile tekrarlayan karşılaşma sonrası daha hızlı ve daha güçlü yanıt ortaya koyabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hafıza T hücrelerinin anormal oranı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032182"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kandaki total T hücre sayısı ile karşılaştırıldığında hafıza T hücrelerinin anormal bir oranı. Hafıza T hücreleri daha önceden karşılaşmış ve aynı kökten olan antijenlerine yanıt vermiştir ve antijen ile tekrarlayan karşılaşma sonrası daha hızlı ve daha güçlü yanıt ortaya koyabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal proportion of memory T cells compared to the total number of T cells in the blood. Memory T cells have previously encountered and responded to their cognate antigen and upon a repeated encounter with the antigen can mount a faster and stronger response.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032182"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hafıza T hücrelerinin anormal oranı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal memory T cell proportion</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032183">
        <obo:IAO_0000115 xml:lang="tr">Kanda total T hücre sayısı ile karşılaştırıldığında anormal olarak azalmış hafıza T hücreleri oranı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hafıza T hücrelerinin azalmış oranı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032183"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kanda total T hücre sayısı ile karşılaştırıldığında anormal olarak azalmış hafıza T hücreleri oranı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormally reduced proportion of memory T cells compared to the total number of T cells in the blood.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032183"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hafıza T hücrelerinin azalmış oranı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased memory T cell proportion</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032184">
        <obo:IAO_0000115 xml:lang="tr">Kanda total T hücre sayısı ile karşılaştırıldığında anormal olarak artmış hafıza T hücreleri oranı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hafıza T hücrelerinin artmış oranı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032184"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kanda total T hücre sayısı ile karşılaştırıldığında anormal olarak artmış hafıza T hücreleri oranı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormally elevated proportion of memory T cells compared to the total number of T cells in the blood.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032184"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hafıza T hücrelerinin artmış oranı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased memory T cell proportion</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032185">
        <obo:IAO_0000115 xml:lang="tr">Vücudun birden çok kısmı boyunca molluskum kontagiyozum varlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yaygın molluskum kontagiyozum</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032185"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Vücudun birden çok kısmı boyunca molluskum kontagiyozum varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased susceptibility to Molluscum contagiosum infections as manifested by a severe, invasive, or disseminated infection with Molluscum contagiosum over the body.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
