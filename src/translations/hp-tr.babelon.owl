        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011945">
        <obo:IAO_0000115 xml:lang="tr">Bronşiolitis obliterans organize pnömoni (BOOP) ve histopatolojik olarak karakterize interstisyel akciğer anormalliği, küçük hava yolları, alveoler kanallar ve alveoller içine yerleşen kabarcık dokusu anormalliği ve alveolar duvarlarda kronik inflamatuvar hücre infiltrasyonu ile karakterizedir. BOOP hastaları genellikle nefes darlığı, ateş, halsizlik ve kilo kaybı gibi subakut hastalıklar ile kendini gösterir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Pnömoniyi organize eden bronşiyolitis obliterans</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011945"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bronşiolitis obliterans organize pnömoni (BOOP) ve histopatolojik olarak karakterize interstisyel akciğer anormalliği, küçük hava yolları, alveoler kanallar ve alveoller içine yerleşen kabarcık dokusu anormalliği ve alveolar duvarlarda kronik inflamatuvar hücre infiltrasyonu ile karakterizedir. BOOP hastaları genellikle nefes darlığı, ateş, halsizlik ve kilo kaybı gibi subakut hastalıklar ile kendini gösterir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bronchiolitis obliterans organizing pneumonia (BOOP) is and interstitial lung abnormalitiy characterized histopathologically by plugs of granulation tissue lying within small airways, alveolar ducts, and alveoli and by chronic inflammatory cell infiltration in alveolar walls. Patients with BOOP generally present with subacute illness, including shortness of breath, fever, malaise, and weight loss.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011945"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Pnömoniyi organize eden bronşiyolitis obliterans</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bronchiolitis obliterans organizing pneumonia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011946">
        <obo:IAO_0000115 xml:lang="tr">Bronşiyollerin kısmi veya tam tıkanmasına yol açan bu hava yollarının inflamasyonu ve fibrozisi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Bronşiyolitis obliterans</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011946"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bronşiyollerin kısmi veya tam tıkanmasına yol açan bu hava yollarının inflamasyonu ve fibrozisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inflammation and fibrosis of the bronchioles leading to partial or complete obstruction of these airways.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011946"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Bronşiyolitis obliterans</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bronchiolitis obliterans</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
