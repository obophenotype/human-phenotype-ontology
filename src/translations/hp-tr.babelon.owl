        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of the premaxilla, which is the embryonic structure that forms the anterior part of the maxilla.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010757"/>
