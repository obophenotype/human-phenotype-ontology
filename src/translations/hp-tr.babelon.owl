    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009259">
        <obo:IAO_0000115 xml:lang="tr">4. parmağın distal falanksının epifizinde anormal punktat (benekli, nokta gibi) varlığı</obo:IAO_0000115>
