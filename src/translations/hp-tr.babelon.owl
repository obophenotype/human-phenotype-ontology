    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002508">
        <obo:IAO_0000115 xml:lang="tr">Beynin sancısı gibi, orta beyin (arada mesencephalon), pons (aons pons Varolii) ve medulla oblongata&apos;yı içeren gelişimsel bir yapısal anomali ve serebral hemisferleri servikal omurilik ile birbirine bağlar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Beyin sapı displazisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002508"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Beynin sancısı gibi, orta beyin (arada mesencephalon), pons (aons pons Varolii) ve medulla oblongata&apos;yı içeren gelişimsel bir yapısal anomali ve serebral hemisferleri servikal omurilik ile birbirine bağlar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A developmental structural anomaly of the stalk-like part of the brain that comprises the midbrain (aka mesencephalon), the pons (aka pons Varolii), and the medulla oblongata, and connects the cerebral hemispheres with the cervical spinal cord.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
