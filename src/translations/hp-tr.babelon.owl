    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0006101">
        <obo:IAO_0000115 xml:lang="tr">&quot;Kemik yapısı dahil olmak üzere sadece yumuşak parçalar içeren el flebekeleri yada füzyonlar. Kemikli füzyonlar, füzyonun bir radyo-ulnar ekseninde oluşması halinde Syndactyly olarak &quot;&quot;kemikli&quot;&quot; sayılır. Parmak kemiklerinin yakın-uzak bir eksende füzyonuna &quot;&quot;Senfalangizm&quot;&quot; denir&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Parmak sindaktilisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006101"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">&quot;Kemik yapısı dahil olmak üzere sadece yumuşak parçalar içeren el flebekeleri yada füzyonlar. Kemikli füzyonlar, füzyonun bir radyo-ulnar ekseninde oluşması halinde Syndactyly olarak &quot;&quot;kemikli&quot;&quot; sayılır. Parmak kemiklerinin yakın-uzak bir eksende füzyonuna &quot;&quot;Senfalangizm&quot;&quot; denir&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>&quot;Webbing or fusion of the fingers, involving soft parts only or including bone structure. Bony fusions are referred to as &quot;&quot;bony&quot;&quot; Syndactyly if the fusion occurs in a radio-ulnar axis. Fusions of bones of the fingers in a proximo-distal axis are referred to as &quot;&quot;Symphalangism&quot;&quot;.&quot;</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006101"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Parmak sindaktilisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Finger syndactyly</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
