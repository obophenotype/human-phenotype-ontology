    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012712">
        <obo:IAO_0000115 xml:lang="tr">İşitme bozukluğunun hafif bir formunun varlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hafif işitme bozukluğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012712"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İşitme bozukluğunun hafif bir formunun varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A mild form of hearing impairment (26-40 dB) in which individuals can hear speech at a normal volume from about one meter away but may struggle with softer sounds, such as whispers or quiet conversations. Understanding speech in noisy environments can also be challenging.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012712"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hafif işitme bozukluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mild hearing impairment</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012713">
        <obo:IAO_0000115 xml:lang="tr">İşitme bozukluğunun orta dereceli bir formunun varlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Orta düzey işitme bozukluğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012713"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İşitme bozukluğunun orta dereceli bir formunun varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A moderate form of hearing impairment (41-60 dB) in which speech must be spoken at a raised volume from one meter away for individuals to hear clearly. Normal conversations, particularly in the presence of background noise, may be difficult to follow.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012713"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Orta düzey işitme bozukluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Moderate hearing impairment</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012714">
        <obo:IAO_0000115 xml:lang="tr">İşitme bozukluğunun ciddi bir türü</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ciddi işitme bozukluğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012714"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İşitme bozukluğunun ciddi bir türü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A severe form of hearing impairment (61-80 dB) in which individuals can only hear a few words spoken at a high volume and experience significant difficulty perceiving speech at normal levels.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012714"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ciddi işitme bozukluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Severe hearing impairment</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012715">
        <obo:IAO_0000115 xml:lang="tr">İşitme bozukluğunun şiddetli (esasen tam) bir formu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Belirgin işitme bozukluğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012715"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İşitme bozukluğunun şiddetli (esasen tam) bir formu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A profound (essentially complete) form of hearing impairment (over 80 dB) in which speech is inaudible, even when spoken loudly.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012715"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Belirgin işitme bozukluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Profound hearing impairment</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012716">
        <obo:IAO_0000115 xml:lang="tr">İletimsel işitme bozukluğunun orta dereceli bir formunun varlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Orta derecede iletimsel işitme bozukluğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
