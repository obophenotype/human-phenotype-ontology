    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009637">
        <obo:IAO_0000115 xml:lang="tr">Baş parmakta proksimal falanksın yokluğu. 2.-5. parmakların proksimal falankslarının aksine, başparmağın proksimal falanksı embriyolojik olarak diğer parmakların orta falankslarına eşdeğerdir, oysa ilk metakarp, embriyolojik olarak falanks kaynaklıdır ve diğer parmakların proksimal falankslarına eşdeğerdir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Baş parmağın olmayan proksimal falanksı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009637"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Baş parmakta proksimal falanksın yokluğu. 2.-5. parmakların proksimal falankslarının aksine, başparmağın proksimal falanksı embriyolojik olarak diğer parmakların orta falankslarına eşdeğerdir, oysa ilk metakarp, embriyolojik olarak falanks kaynaklıdır ve diğer parmakların proksimal falankslarına eşdeğerdir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of the proximal phalanx of the thumb. In contrast to the proximal phalanges of the digits 2-5, the proximal phalanx of the thumb is embryologically equivalent to the middle phalanges of the other digits, whereas the first metacarpal is embryologically of phalangeal origin and as such equivalent to the proximal phalanges of the other digits.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009637"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Baş parmağın olmayan proksimal falanksı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absent proximal phalanx of thumb</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009638">
        <obo:IAO_0000115 xml:lang="tr">Başparmakta hipoplastik (kısa) proksimal falanks. 2-5 rakamlarının proksimal falankslarının aksine, başparmağın proksimal falanksı embriyolojik olarak diğer rakamların orta falankslarına eşdeğer iken, ilk metakarpal embriyolojik olarak falanks kaynaklıdır ve bu şekilde diğer rakamların proksimal falankslarına eşittir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">El baş parmağının kısa proksimal falanksı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009638"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Başparmakta hipoplastik (kısa) proksimal falanks. 2-5 rakamlarının proksimal falankslarının aksine, başparmağın proksimal falanksı embriyolojik olarak diğer rakamların orta falankslarına eşdeğer iken, ilk metakarpal embriyolojik olarak falanks kaynaklıdır ve bu şekilde diğer rakamların proksimal falankslarına eşittir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypoplastic (short) proximal phalanx of the thumb. In contrast to the proximal phalanges of the digits 2-5, the proximal phalanx of the thumb is embryologically equivalent to the middle phalanges of the other digits, whereas the first metacarpal is embryologically of phalangeal origin and as such equivalent to the proximal phalanges of the other digits.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009638"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">El baş parmağının kısa proksimal falanksı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Short proximal phalanx of thumb</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
