    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004321">
        <obo:IAO_0000115 xml:lang="tr">Mesaneyi başka bir organa veya cilde bağlayan bir fistül varlığı. Fistül bağırsağı, vajinayı veya nadiren cildi içerebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Mesane fistülü</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004321"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Mesaneyi başka bir organa veya cilde bağlayan bir fistül varlığı. Fistül bağırsağı, vajinayı veya nadiren cildi içerebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of a fistula connecting the urinary bladder to another organ or the skin. The fistula can involve the bowel, the vagina, or rarely, the skin.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004321"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Mesane fistülü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bladder fistula</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004322">
        <obo:IAO_0000115 xml:lang="tr">&quot;Yaş ve cinsiyet normlarına göre beklenenden düşük bir uzunluktur. Evrensel olarak kabul edilmiş bir kısa boy tanımı olmamasına rağmen, çoğunluk &quot;&quot;kısa boy&quot;&quot; yüksekliğinin, 2 standart sapmadan daha büyük olacak sekilde yaş ve cinsiyet ortalamasının aşağısında olduğunu referans almaktadır (veya yaş ve cinsiyete bağlı normlarda yüzde 3 lük kısımdan aşağıda olması)&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kısa boy</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004322"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">&quot;Yaş ve cinsiyet normlarına göre beklenenden düşük bir uzunluktur. Evrensel olarak kabul edilmiş bir kısa boy tanımı olmamasına rağmen, çoğunluk &quot;&quot;kısa boy&quot;&quot; yüksekliğinin, 2 standart sapmadan daha büyük olacak sekilde yaş ve cinsiyet ortalamasının aşağısında olduğunu referans almaktadır (veya yaş ve cinsiyete bağlı normlarda yüzde 3 lük kısımdan aşağıda olması)&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>&quot;A height below that which is expected according to age and gender norms. Although there is no universally accepted definition of short stature, many refer to &quot;&quot;short stature&quot;&quot; as height more than 2 standard deviations below the mean for age and gender (or below the 3rd percentile for age and gender dependent norms).&quot;</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004322"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kısa boy</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Short stature</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004323">
