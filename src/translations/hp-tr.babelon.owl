        <babelon:source_value>An abnormality of the function of the veins that return deoxygenated blood from the body into the heart, i.e., the superior vena cava and the inferior vena cava.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
