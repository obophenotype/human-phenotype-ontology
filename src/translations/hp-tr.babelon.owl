        <obo:IAO_0000115 xml:lang="tr">Triküspid kapağın gelişimindeki yetersizlik ve bu sebeple sağ atriyum ve sağ ventrikül arasında olan normal bağlantının eksikliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Triküspid atrezisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011662"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Triküspid kapağın gelişimindeki yetersizlik ve bu sebeple sağ atriyum ve sağ ventrikül arasında olan normal bağlantının eksikliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Failure to develop of the tricuspid valve and thus lack of the normal connection between the right atrium and the right ventricle.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
