        <babelon:source_value>Paroxysmal ventricular tachycardia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004752">
        <obo:IAO_0000115 xml:lang="tr">Konjenital başlangıçlı atriyoventriküler (AV) disosiyasyon (yani, atriyum ve ventriküller iki ayrı pacemaker&apos;ın kontrolü altındadır) biçimindedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Konjenital atriyoventriküler ayrışma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004752"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Konjenital başlangıçlı atriyoventriküler (AV) disosiyasyon (yani, atriyum ve ventriküller iki ayrı pacemaker&apos;ın kontrolü altındadır) biçimindedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of atrioventricular (AV) dissociation (i.e., the atria and the ventricles are under the control of two separate pacemakers) with congenital onset.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004752"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Konjenital atriyoventriküler ayrışma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Congenital atrioventricular dissociation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004754">
        <obo:IAO_0000115 xml:lang="tr">Kardiyoversiyon ile başarıyla sonlandırılamayan AF ve uzun süredir (1 yıldan fazla) AF, kardiyoversiyonun belirtilmediği veya denenmediği yerlerde, kalıcı olarak adlandırılır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kalıcı atriyal fibrilasyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004754"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kardiyoversiyon ile başarıyla sonlandırılamayan AF ve uzun süredir (1 yıldan fazla) AF, kardiyoversiyonun belirtilmediği veya denenmediği yerlerde, kalıcı olarak adlandırılır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrial fibrillation (AF) that cannot be successfully terminated by cardioversion, and longstanding (more than 1 year) AF, where cardioversion is not indicated or has not been attempted, is termed permanent.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004754"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kalıcı atriyal fibrilasyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Permanent atrial fibrillation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004755">
        <obo:IAO_0000115 xml:lang="tr">Supraventriküler taşikardi (SVT), anormal derecede artmış bir kalp hızıdır (dinlenme esnasında dakikada 100 vuruştan fazla) ve köken ventriküllerin seviyesinin üstünde bulunur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Supraventriküler taşikardi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004755"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Supraventriküler taşikardi (SVT), anormal derecede artmış bir kalp hızıdır (dinlenme esnasında dakikada 100 vuruştan fazla) ve köken ventriküllerin seviyesinin üstünde bulunur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Supraventricular tachycardia (SVT) is an abnormally increased heart rate (over 100 beats per minute at rest) with origin above the level of the ventricles.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
