    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009888">
        <obo:IAO_0000115 xml:lang="tr">Normalde Ergenlik döneminde ortaya çıkan ikincil cinsel kıl büyümesinin anormalliği. erkeklerde ikincil cinsel kıllar genellikle koltuk altı, karın, göğüs ve kasık bölgelerinde vücut kıllarından oluşur. Dişilerde, ikincil cinsel kıllar genellikle daha az vücut kılları, en belirgin olarak koltuk altı ve kasık kılı içerir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İkincil cinsiyet kıllarının anormalliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009888"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Normalde Ergenlik döneminde ortaya çıkan ikincil cinsel kıl büyümesinin anormalliği. erkeklerde ikincil cinsel kıllar genellikle koltuk altı, karın, göğüs ve kasık bölgelerinde vücut kıllarından oluşur. Dişilerde, ikincil cinsel kıllar genellikle daha az vücut kılları, en belirgin olarak koltuk altı ve kasık kılı içerir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of the growth of secondary sexual hair, which normally ensues during puberty. In males, secondary sexual hair usually comprises body hair, including underarm, abdominal, chest, and pubic hair. In females, secondary sexual hair usually comprises a lesser degree of body hair, most prominently underarm and pubic hair.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009888"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">İkincil cinsiyet kıllarının anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of secondary sexual hair</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009889">
