    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025526">
        <obo:IAO_0000115 xml:lang="tr">Sedefli hastalarda rastlanan lezyonları andıran cilt lezyonları, yani, ince gümüş renkli pullarla kaplı eritemli bir plak olan Psoriasiform lezyonları, tıpkı sedef hastalığında olduğu gibi alerjik temas ile dermatit, seboreik dermatit, atopik dermatit, pityriazis rubra ve liken simpleks kronikus gibi diğer durumlarda da gözlemlenebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Psöriaziform lezyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025526"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sedefli hastalarda rastlanan lezyonları andıran cilt lezyonları, yani, ince gümüş renkli pullarla kaplı eritemli bir plak olan Psoriasiform lezyonları, tıpkı sedef hastalığında olduğu gibi alerjik temas ile dermatit, seboreik dermatit, atopik dermatit, pityriazis rubra ve liken simpleks kronikus gibi diğer durumlarda da gözlemlenebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A skin lesions that resembles the lesions observed in psoriasis, viz., an erythematous plaque covered by fine silvery scales. Psoriasiform lesions can be observed in psoriasis as well as in other conditions including allergic contact dermatitis, seborrhoeic dermatitis, Atopic dermatitis, pityriasis rubra, and lichen simplex chronicus.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025526"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Psöriaziform lezyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Psoriasiform lesion</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
