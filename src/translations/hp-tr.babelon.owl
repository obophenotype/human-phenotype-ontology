    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031656">
        <obo:IAO_0000115 xml:lang="tr">Mitral kapağın sistolik anterior hareketi (SAM) ön ve zaman zaman arka mitral kapak yaprakçığının sistol esnasında sol ventriküler çıkış yoluna (LVOT) doğru olan paradoksal bir hareketidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Mitral kapağın sistolik ön hareketi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031656"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Mitral kapağın sistolik anterior hareketi (SAM) ön ve zaman zaman arka mitral kapak yaprakçığının sistol esnasında sol ventriküler çıkış yoluna (LVOT) doğru olan paradoksal bir hareketidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Systolic anterior motion of the mitral valve (SAM) is a paradoxical motion of the anterior, and occasionally posterior, mitral valve leaflet towards the left ventricular outflow tract (LVOT) during systole.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031656"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Mitral kapağın sistolik ön hareketi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Systolic anterior motion of the mitral valve</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031657">
        <obo:IAO_0000115 xml:lang="tr">Atan kalp tarafından oluşturulan herhangi bir anormal ses</obo:IAO_0000115>
