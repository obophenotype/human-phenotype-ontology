        <babelon:source_value>Intermediate atrioventricular canal defect</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011577">
        <obo:IAO_0000115 xml:lang="tr">Primum atriyal septal kusurve yarık anterior mitral kapakçık içeren kalp kusurlarının belirli kombinasyonlarıdır. Giriş ventriküler septal kusur mevcut değildir. İki ventil annulusu ve iki ventil ağız deliği vardır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kısmi atriyoventriküler kanal defekti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011577"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Primum atriyal septal kusurve yarık anterior mitral kapakçık içeren kalp kusurlarının belirli kombinasyonlarıdır. Giriş ventriküler septal kusur mevcut değildir. İki ventil annulusu ve iki ventil ağız deliği vardır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A specific combination of heart defects including a primum atrial septal defect and cleft anterior mitral valve leaflet. There is not an inlet ventricular septal defect present. There are two valve annuluses and two valve orifices.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
