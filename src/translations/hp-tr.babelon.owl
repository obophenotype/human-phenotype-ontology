    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025080">
        <obo:IAO_0000115 xml:lang="tr">Çekirdeksiz boynuzlu katmanın kalınlaşması ile karakterize bir hiperkeratozis formu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ortokeratotik hiperkeratozis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025080"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
