        <owl:annotatedTarget xml:lang="tr">Skleranın tek taraflı yamalı fakat yaygın arduvaz grisi veya mavimsi renk değişimi ile karakterize doğumsal bir sklera lezyonu. Konjunktiva korunmuştur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A congenital lesion of the sclera characterized by unilateral patchy but extensive slate-gray or bluish discoloration of the sclera . The conjunctiva are spared.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
