        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Trifasiküler blok</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Trifascicular block</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011716">
        <obo:IAO_0000115 xml:lang="tr">Bileşkesel ektopik taşikardi (BET), dar QRS kompleksleri ve atriyoventriküler (AV) ayrışma veya 1:1 paterninde retrograd atriyal iletim ile tanımlanan supraventriküler aritminin bensersiz bir tipidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Bileşkesel ektopik taşikardi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011716"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bileşkesel ektopik taşikardi (BET), dar QRS kompleksleri ve atriyoventriküler (AV) ayrışma veya 1:1 paterninde retrograd atriyal iletim ile tanımlanan supraventriküler aritminin bensersiz bir tipidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Junctional ectopic tachycardia (JET) is a unique type of supraventricular arrhythmia defined by narrow QRS complex and atrioventricular (AV) dissociation or retrograde atrial conduction in a 1:1 pattern.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011716"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Bileşkesel ektopik taşikardi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Junctional ectopic tachycardia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011717">
        <obo:IAO_0000115 xml:lang="tr">Aksesuvar yolak ilişkili atriyoventriküler yeniden giriş taşikardisi (AVRT) aksesuvar yolağın anormal elektrik iletimini içerir. Atriyum ve ventrikül arasında uyarıyı birleştiren aksesuvar yolak AV olukta herhangi bir yerde görülebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Atriyoventriküler yeniden giriş taşikardisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011717"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Aksesuvar yolak ilişkili atriyoventriküler yeniden giriş taşikardisi (AVRT) aksesuvar yolağın anormal elektrik iletimini içerir. Atriyum ve ventrikül arasında uyarıyı birleştiren aksesuvar yolak AV olukta herhangi bir yerde görülebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Accessory pathway-related atrioventricular reentrant tachycardia (AVRT) involves an abnormal electrical conduction of the accessory pathway. The accessory pathway connecting impulses between the atrium and the ventricle can be seen at any site in the AV groove.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011717"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Atriyoventriküler yeniden giriş taşikardisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Atrioventricular reentrant tachycardia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011718">
