        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Deri ekleri morfolojisinin anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal skin adnexa morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011139">
        <obo:IAO_0000115 xml:lang="tr">Gastrik duplikasyon genellikle gastrointestinal kanalın kistik bir malformasyonudur, genellikle midenin büyük kurvatürüne eklenmiştir ve mide ile hiç bir iletişimi yoktur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Gastrik duplikasyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011139"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Gastrik duplikasyon genellikle gastrointestinal kanalın kistik bir malformasyonudur, genellikle midenin büyük kurvatürüne eklenmiştir ve mide ile hiç bir iletişimi yoktur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Gastric duplication is a usually cystic malformation of gastrointestinal tract, usually attached to the greater curvature of the stomach and has no communication with the stomach.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
