        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Facial myokymia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000319">
        <obo:IAO_0000115 xml:lang="tr">Burun tabanı ve üst vermiliyon sınırı arasındaki üst dudağın orta bölgesinin sınırları olmayan veya düz deri yüzeyi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Düz filtrum</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000319"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Burun tabanı ve üst vermiliyon sınırı arasındaki üst dudağın orta bölgesinin sınırları olmayan veya düz deri yüzeyi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Flat skin surface, with no ridge formation in the central region of the upper lip between the nasal base and upper vermilion border.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
