    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000873">
        <obo:IAO_0000115 xml:lang="tr">Aşırı su alımı ve hipotonik (dilüe) poliüri durumu. Diabetes insipidus vazopressin (AVP) salınımı bozukluğu (santral veya nörojenik diabetes insipidus) veya böbreklerin AVP&apos;ye yanıt vermesindeki bozukluktan (nefrojenik diabetes insipidus) kaynaklanabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Diabetes insipidus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000873"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Aşırı su alımı ve hipotonik (dilüe) poliüri durumu. Diabetes insipidus vazopressin (AVP) salınımı bozukluğu (santral veya nörojenik diabetes insipidus) veya böbreklerin AVP&apos;ye yanıt vermesindeki bozukluktan (nefrojenik diabetes insipidus) kaynaklanabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A state of excessive water intake and hypotonic (dilute) polyuria. Diabetes insipidus may be due to failure of vasopressin (AVP) release (central or neurogenic diabetes insipidus) or to a failure of the kidney to respond to AVP (nephrogenic diabetes insipidus).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000873"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Diabetes insipidus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Diabetes insipidus</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
