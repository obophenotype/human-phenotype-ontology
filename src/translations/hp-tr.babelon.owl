        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of the crus of the helix</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009896">
        <obo:IAO_0000115 xml:lang="tr">Kulak tragusunun karşı tarafında küçük bir tüberkül olan antitragus anormalliği. Antitragus ve tragus intertragik çentik tarafından ayrılmıştır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Antitragusun anormalliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009896"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kulak tragusunun karşı tarafında küçük bir tüberkül olan antitragus anormalliği. Antitragus ve tragus intertragik çentik tarafından ayrılmıştır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of the antitragus, which is a small tubercle opposite to the tragus of the ear. The antitragus and the tragus are separated by the intertragic notch.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
