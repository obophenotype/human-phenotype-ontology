    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012043">
        <obo:IAO_0000115 xml:lang="tr">Bir veya iki gözün ritmik, istemsiz sinüzoidal osilasyonları. Pendular nistagmusun dalga formu herhangi bir yönde olabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Pendüler nistagmus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012043"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir veya iki gözün ritmik, istemsiz sinüzoidal osilasyonları. Pendular nistagmusun dalga formu herhangi bir yönde olabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Rhythmic, involuntary sinusoidal oscillations of one or both eyes. The waveform of pendular nystagmus may occur in any direction.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
