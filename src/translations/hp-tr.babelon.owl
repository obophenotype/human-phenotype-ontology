        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal brain positron emission tomography</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012658">
        <obo:IAO_0000115 xml:lang="tr">Flurodeoksiglukoz (FDG) pozitron emisyon tomografisi (PET) beyin taramasında tespit edilebilen bir anomali. FDG-PET ile ölçülen glukoz alımı nöronal metabolik aktivitenin bir belirtecidir</obo:IAO_0000115>
