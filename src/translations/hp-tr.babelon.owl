    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001491">
        <obo:IAO_0000115 xml:lang="tr">Çoklu ekstraoküler sınırlamalar ile birlikte ilerleyici olmayan doğumsal oftalmopleji. Tipik olarak, pitozis ve değişen derecede yatay ve dikey göz hareketlerinin kısıtlılığı mevcuttur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ekstraoküler kasların konjenital fibrozisi</rdfs:label>
    </rdf:Description>
