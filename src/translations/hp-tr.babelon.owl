    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012230">
        <obo:IAO_0000115 xml:lang="tr">Vitröz boşluktan duysal retina ve retinal pigment epitel arasındaki boşluğa, subretinal alana sıvı geçişine izin veren retinada bir yırtık olan retinal yırtılma ile ilişkili bir retinal dekolman tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Regmatogenöz retinal dekolman</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012230"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Vitröz boşluktan duysal retina ve retinal pigment epitel arasındaki boşluğa, subretinal alana sıvı geçişine izin veren retinada bir yırtık olan retinal yırtılma ile ilişkili bir retinal dekolman tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of retinal detachment associated with a full-thickness defect in the retina that allows fluid to pass from the vitreous space into the subretinal space between the sensory retina and the retinal pigment epithelium.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012230"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Regmatogenöz retinal dekolman</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Rhegmatogenous retinal detachment</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012231">
        <obo:IAO_0000115 xml:lang="tr">Subretinal boşluğa sıvıların geçmesine izin veren ve nöroduysal retinayı retinal pigment epitelinden ayıran kan-retinal dış bariyerine olan zedelenmeden kaynaklanan retinal ayrılmanın bir tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Eksüdatif retina dekolmanı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012231"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Subretinal boşluğa sıvıların geçmesine izin veren ve nöroduysal retinayı retinal pigment epitelinden ayıran kan-retinal dış bariyerine olan zedelenmeden kaynaklanan retinal ayrılmanın bir tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of retinal detachment such that fluid is present in the subretinal space and separate the neurosensory retina from the retinal pigment epithelium. It is not associated with a full-thickness break nor a tractional component. Due to breakdown of outer blood-retina barrier or increased exudation from abnormal vasculature or defective outflow.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012231"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Eksüdatif retina dekolmanı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Serous retinal detachment</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012232">
