        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of cyclophoria (latent strabismus in which the occluded eye wheel-rotates on dissociation.) in which the upper poles of the globes are rotated outward (laterally) to each other.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
