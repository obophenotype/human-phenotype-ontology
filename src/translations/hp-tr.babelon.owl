        <owl:annotatedTarget xml:lang="tr">Fundus pigmentasyon anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal fundus pigmentation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031606">
        <obo:IAO_0000115 xml:lang="tr">Retinadaki yumuşak beyaz yama, retinal sinir lifi tabakasının yoğun beyaz şişmelerinin lokalize bölgelerini temsil eder. Çoğunlukla zikzak dahili yapıya sahiptirler, tüylü bir kenar ancak bunun dışında iyi betimlenmiş bir biçim ve yaklaşık olarak 1 mm boyut; vitreusa içine hafifçe yansırlar ve bazen retinal damarları saptırırlar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Retinal pamuk noktası</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031606"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Retinadaki yumuşak beyaz yama, retinal sinir lifi tabakasının yoğun beyaz şişmelerinin lokalize bölgelerini temsil eder. Çoğunlukla zikzak dahili yapıya sahiptirler, tüylü bir kenar ancak bunun dışında iyi betimlenmiş bir biçim ve yaklaşık olarak 1 mm boyut; vitreusa içine hafifçe yansırlar ve bazen retinal damarları saptırırlar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fluffy white patch in the inner retina, representing localized areas of dense white swelling of the retinal nerve fiber layer.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
