        <owl:annotatedTarget xml:lang="tr">Azalan kardiyak çıkış ile karakterize bir kalp yetmezliği şekli. kalp yetmezliğinden dolayı hastalarda iskemik kalp hastalığı, hipertansiyon, kardiyomiyopati ve diğer nedenlerle görülebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
