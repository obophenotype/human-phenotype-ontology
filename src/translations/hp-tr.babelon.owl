        <babelon:source_value>Hypohidrosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000967">
        <obo:IAO_0000115 xml:lang="tr">Peteşi, kapillerler yırtıldığında ve deri içine bazı yüzeysel kanamalar meydana geldiğinde döküntüyü andıran, deri veya mukoz membranın hemen altında görünen iğne ucu büyüklüğünde kırmızımsı/morumsu noktalardır. Bu terim peteşi geliştirmeye anormal yatkınlık artışını da tanımlar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Peteşi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000967"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Peteşi, kapillerler yırtıldığında ve deri içine bazı yüzeysel kanamalar meydana geldiğinde döküntüyü andıran, deri veya mukoz membranın hemen altında görünen iğne ucu büyüklüğünde kırmızımsı/morumsu noktalardır. Bu terim peteşi geliştirmeye anormal yatkınlık artışını da tanımlar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Petechiae are pinpoint-sized reddish/purple spots, resembling a rash, that appear just under the skin or a mucous membrane when capillaries have ruptured and some superficial bleeding into the skin has happened. This term refers to an abnormally increased susceptibility to developing petechiae.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000967"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Peteşi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Petechiae</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
