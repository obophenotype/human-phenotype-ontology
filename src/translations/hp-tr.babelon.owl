        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kare dalga sıçramalar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Square-wave jerks</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025403">
        <obo:IAO_0000115 xml:lang="tr">Kafa ve üst sırtın öne eğildiği habitüel bir vücut pozisyonu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Eğilmiş duruş</rdfs:label>
    </rdf:Description>
