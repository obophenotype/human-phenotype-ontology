        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bundle branch block</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011711">
        <obo:IAO_0000115 xml:lang="tr">His demetinin sol demet dal anterior kısmındaki iletim bloğu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sol ön fasiküler blok</rdfs:label>
