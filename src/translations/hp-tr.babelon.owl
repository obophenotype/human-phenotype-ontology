    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025129">
        <obo:IAO_0000115 xml:lang="tr">İnce bağırsağın müköz duvarının yapısal bir anomalisi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İnce bağırsak anormal mukoza morfolojisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025129"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İnce bağırsağın müköz duvarının yapısal bir anomalisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A structural anomaly of the mucous lining of the small intestine.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025129"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">İnce bağırsak anormal mukoza morfolojisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal small intestinal mucosa morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025130">
        <obo:IAO_0000115 xml:lang="tr">Laktaz, insanlardaki ince bağırsakta üretilirken, Laktaz enzimlerin beta-galaktosidaz ailesinin bir üyesidir ve D-galaktoz ve D-glukozu oluşturmak üzere D-laktozu hidroliz eder ve ince bağırsak tarafından absorbe edilebilir. Laktaz aktivitesini değerlendirmenin birçok yolu vardır. Bir testte, postbulbar duodenumdan alınan endoskopik biyopsi, bir test plakasında laktoz ile kuluçkalanır ve normolaktasisi olan hastalarda hidrolize laktoz (olumlu bir sonuç) sonucunda 20 dakika içinde renk reaksiyonu gelişirken, Şiddetli hipolaktasisi olan hastalarda ise hiçbir reaksiyon (negatif Sonuç) gelişmez. Diğer, daha az doğrudan testler hidrojen nefes testini ve laktoz sorunlarını takip eden kan testlerini içerir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İnce bağırsak mukozası azalmış laktaz aktivitesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025130"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Laktaz, insanlardaki ince bağırsakta üretilirken, Laktaz enzimlerin beta-galaktosidaz ailesinin bir üyesidir ve D-galaktoz ve D-glukozu oluşturmak üzere D-laktozu hidroliz eder ve ince bağırsak tarafından absorbe edilebilir. Laktaz aktivitesini değerlendirmenin birçok yolu vardır. Bir testte, postbulbar duodenumdan alınan endoskopik biyopsi, bir test plakasında laktoz ile kuluçkalanır ve normolaktasisi olan hastalarda hidrolize laktoz (olumlu bir sonuç) sonucunda 20 dakika içinde renk reaksiyonu gelişirken, Şiddetli hipolaktasisi olan hastalarda ise hiçbir reaksiyon (negatif Sonuç) gelişmez. Diğer, daha az doğrudan testler hidrojen nefes testini ve laktoz sorunlarını takip eden kan testlerini içerir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lactase is produced in the small intestine in humans, Lactase is a member of the beta-galactosidase family of enzymes, and hydrolyzes D-lactose to form D-galactose and D-glucose, which can be absorbed by the small intestine. There are many ways of assessing lactase activity. In one test, an endoscopic biopsy from the postbulbar duodenum is incubated with lactose on a test plate, and a color reaction develops within 20 min as a result of hydrolyzed lactose (a positive result) in patients with normolactasia, whereas no reaction (a negative result) develops in patients with severe hypolactasia. Other, less direct, tests include the hydrogen breath test, and blood tests following lactose challenges.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025130"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">İnce bağırsak mukozası azalmış laktaz aktivitesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased small intestinal mucosa lactase level</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
