    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001655">
        <obo:IAO_0000115 xml:lang="tr">Foramen ovalenin sol ve sağ kardiyak atriyumlar arasında potansiyel bir kanal bırakarak postnatal olarak sızdırmaz hale gelme yetersizliği</obo:IAO_0000115>
