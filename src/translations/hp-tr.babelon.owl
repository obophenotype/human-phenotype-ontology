        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Solunum güçlüğü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Respiratory distress</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002099">
        <obo:IAO_0000115 xml:lang="tr">Astım, trakeobronşiyal yapının birden fazla uyarana artan duyarlılığı ile karakterize olur; solunum güçlüğü, öksürük ve hırıltılı solunum ile sonuçlanan hava kanallarında daralmaya yol açar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Astım</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002099"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Astım, trakeobronşiyal yapının birden fazla uyarana artan duyarlılığı ile karakterize olur; solunum güçlüğü, öksürük ve hırıltılı solunum ile sonuçlanan hava kanallarında daralmaya yol açar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Asthma is characterized by increased responsiveness of the tracheobronchial tree to multiple stimuli, leading to narrowing of the air passages with resultant dyspnea, cough, and wheezing.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002099"/>
