    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031282">
        <obo:IAO_0000115 xml:lang="tr">Ayak baş parmağı tırnak yatağının tırnak matriksinin lateral rotasyonu sonucu uzun eksen boyunca lateral deviasyonu. Tırnak yatağı sırtların dışında büyür</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ayak baş parmağı tırnağının yanlış dizilimi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031282"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ayak baş parmağı tırnak yatağının tırnak matriksinin lateral rotasyonu sonucu uzun eksen boyunca lateral deviasyonu. Tırnak yatağı sırtların dışında büyür</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A lateral deviation of the nail plate of the great toe along the longitudinal axis due to the lateral rotation of the nail matrix. The nail plate grows out in ridges.</babelon:source_value>
