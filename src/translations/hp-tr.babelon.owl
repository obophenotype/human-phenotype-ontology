    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030770">
        <obo:IAO_0000115 xml:lang="tr">Hem beyin hem de spinal kord çeşitli derecelerde açık kaldığı bir nöral tüp defekti</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kraniyoraşişizis</rdfs:label>
