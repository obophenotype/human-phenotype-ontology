    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010499">
        <obo:IAO_0000115 xml:lang="tr">Diz kapağı normal olarak distal femur üzerinde trohlea olarak adlandırılan olukta yer almaktadır ve burada aşağı ve yukarı kayabilir. Patellar subluksasyon oluk içerisinde merkezi olarak kaymayan sabit olmayan diz kapağına, yani patellanın kısmi dislokasyonuna denir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Patellar subluksasyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010499"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Diz kapağı normal olarak distal femur üzerinde trohlea olarak adlandırılan olukta yer almaktadır ve burada aşağı ve yukarı kayabilir. Patellar subluksasyon oluk içerisinde merkezi olarak kaymayan sabit olmayan diz kapağına, yani patellanın kısmi dislokasyonuna denir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The kneecap normally is located within the groove termed trochlea on the distal femur and can slide up and down in it. Patellar subluxation refers to an unstable kneecap that does not slide centrally within its groove, i.e., a partial dislocation of the patella.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010499"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Patellar subluksasyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Patellar subluxation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010500">
