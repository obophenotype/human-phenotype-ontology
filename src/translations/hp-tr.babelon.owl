    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031607"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Pelvik organların aşağı inmesine veya bir veya daha fazla pelvik organın normal pozisyonundan düşmesine izin veren pelvik zemini destekleyen yapılarda zayıflık</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pelvic organ prolapse (POP) refers to the protrusion of one or more female pelvic organs outside the pelvis through the vagina including uterus, bladder and intestines, and causes the pelvic organs to drop downward to the vaginal wall. That is, POP is defined as the anatomical prolapse with descent of at least one of the vaginal walls to or beyond the vaginal hymen with maximal Valsalva effort with the presence either of bothersome characteristic symptoms, most commonly the sensation of vaginal bulge, or of functional or medical compromise due to prolapse without symptom bother.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031607"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Pelvik organ prolapsusu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pelvic organ prolapse</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031609">
        <obo:IAO_0000115 xml:lang="tr">Birleşmiş retinal fotoreseptör kaybı ile retinal pigment epitelyumun göz dibi yansıtma atrofisinin kismi veya tam renksizleşmesinin keskince ayrılmış alanı. Pigmente alınmış alanın kenarları genellikle taraklıdır ve büyük koroidal damarı atrofik retinal pigment epitelyumu sayesinde görülebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Harita atrofisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
