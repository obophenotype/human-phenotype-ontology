    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031035">
        <obo:IAO_0000115 xml:lang="tr">Enfeksiyonu temizleyemeyen bağışıklık sisteminin potansiyel olarak altta yatan bir anormalliği ile ilişkili bir patojen tarafından olan uzun süren veya kalıcı enfeksiyon varlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kronik enfeksiyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031035"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Enfeksiyonu temizleyemeyen bağışıklık sisteminin potansiyel olarak altta yatan bir anormalliği ile ilişkili bir patojen tarafından olan uzun süren veya kalıcı enfeksiyon varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Presence of a protracted or persistent infection by a pathogen potentially related to an underlying abnormality of the immune system that is not able to clear the infection.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
