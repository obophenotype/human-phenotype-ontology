    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011646">
        <obo:IAO_0000115 xml:lang="tr">Duktus arteriyozusun insersiyonunda, yani aortik arkın jukstaduktal bölgesinde yer alan aort daralması veya konstriksiyonu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Jukstaduktal aort koarktasyonu</rdfs:label>
    </rdf:Description>
