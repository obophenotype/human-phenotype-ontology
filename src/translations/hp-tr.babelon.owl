        <owl:annotatedTarget xml:lang="tr">Çene kapanmasını takiben maksiller dişin mandibüler dişlerin düzleminden anormal şekilde anteroposterior uzanması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
