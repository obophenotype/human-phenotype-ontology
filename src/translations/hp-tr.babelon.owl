        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anti-tiroglobulin antikor pozitifliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Anti-thyroglobulin antibody positivity</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032070">
        <obo:IAO_0000115 xml:lang="tr">Pia materin kontrast madde artması veya sulkusun subaraknoid boşlukları ve sisternaları içine uzandığı artış leptomeningeyal artışdır. Leptomeningeyal artış genellikle bakteriyel, viral veya fungal olabilen menenjit ile ilişkilidir. Bu artışın birincil mekanizması anjiyogenezis olmadan kan beyin bariyerinin bozulmasıdır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Leptomeningeyal iyileştirme</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032070"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Pia materin kontrast madde artması veya sulkusun subaraknoid boşlukları ve sisternaları içine uzandığı artış leptomeningeyal artışdır. Leptomeningeyal artış genellikle bakteriyel, viral veya fungal olabilen menenjit ile ilişkilidir. Bu artışın birincil mekanizması anjiyogenezis olmadan kan beyin bariyerinin bozulmasıdır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Contrast material enhancement of the pia mater or enhancement that extends into the subarachnoid spaces of the sulci and cisterns is leptomeningeal enhancement. Leptomeningeal enhancement is usually associated with meningitis, which may be bacterial, viral, or fungal. The primary mechanism of this enhancement is breakdown of the blood-brain barrier without angiogenesis.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032070"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Leptomeningeyal iyileştirme</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Leptomeningeal enhancement</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032071">
        <obo:IAO_0000115 xml:lang="tr">Kan eozinofili ile birlikte olan veya olmayan, bronkoalveoler lavaj veya doku biyopsisi tarafından tespit edildiği üzere akciğerlerde eozinofillerin varlığı</obo:IAO_0000115>
