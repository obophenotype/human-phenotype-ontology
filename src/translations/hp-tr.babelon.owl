    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100651">
        <obo:IAO_0000115 xml:lang="tr">Pankreasta çok az insülin üreten ya da hiç insülin üretmeyen kronik bir durum. Tip I diabetes mellitus, insülin ile tedavi edilmediği sürece diyabetik ketoasidoz&apos;a hızla ilerleyen şiddetli hipergliseminin aniden ortaya çıkmasıyla kendini gösterir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tip I diabetes mellitus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100651"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Pankreasta çok az insülin üreten ya da hiç insülin üretmeyen kronik bir durum. Tip I diabetes mellitus, insülin ile tedavi edilmediği sürece diyabetik ketoasidoz&apos;a hızla ilerleyen şiddetli hipergliseminin aniden ortaya çıkmasıyla kendini gösterir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A chronic condition in which the pancreas produces little or no insulin. Type I diabetes mellitus is manifested by the sudden onset of severe hyperglycemia with rapid progression to diabetic ketoacidosis unless treated with insulin.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
