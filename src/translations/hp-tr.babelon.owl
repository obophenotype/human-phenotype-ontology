    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001769">
        <obo:IAO_0000115 xml:lang="tr">Yaşa göre 95. yüzdelik dilimin üstünde genişliği ölçülen ayak; veya uzunluğa göre genişliğin uygunsuz olarak geniş görüldüğü bir ayak</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Geniş ayak</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001769"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Yaşa göre 95. yüzdelik dilimin üstünde genişliği ölçülen ayak; veya uzunluğa göre genişliğin uygunsuz olarak geniş görüldüğü bir ayak</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A foot for which the measured width is above the 95th centile for age; or, a foot that appears disproportionately wide for its length.</babelon:source_value>
