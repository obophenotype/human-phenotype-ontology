    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000518">
        <obo:IAO_0000115 xml:lang="tr">Katarakt gözün kristal lensinde veya kapsülünde meydana gelen opasite veya bulanıklaşmadır</obo:IAO_0000115>
