    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007817">
        <obo:IAO_0000115 xml:lang="tr">Bir supranükleer bakış felci beyinsel bozukluğun bir sonucu olarak yatay bir yönde bakmadaki yetersizliktir. Göz hareketlerinin istemli tarafı kaybolur, ancak beyin sapı henüz bozulmamış olduğu için tüm refleks eşli göz hareketleri normaldir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yatay supranükleer bakış felci</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007817"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir supranükleer bakış felci beyinsel bozukluğun bir sonucu olarak yatay bir yönde bakmadaki yetersizliktir. Göz hareketlerinin istemli tarafı kaybolur, ancak beyin sapı henüz bozulmamış olduğu için tüm refleks eşli göz hareketleri normaldir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A supranuclear gaze palsy is an inability to look in a horizontal direction as a result of cerebral impairment. There is a loss of the voluntary aspect of eye movements, but, as the brainstem is still intact, all the reflex conjugate eye movements are normal.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007817"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Yatay supranükleer bakış felci</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Horizontal supranuclear gaze palsy</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007818">
        <obo:IAO_0000115 xml:lang="tr">İrisin orta (periferil) bölümünde, orta periferik (siliyer) bölgeden farklı renklerin oluşu</obo:IAO_0000115>
