    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031856">
        <obo:IAO_0000115 xml:lang="tr">Parmak ucu yürüyüşü, katı bacaklar ve sekme ile karakterize anormal bir yürüyüş. Yürüyüş paterni horoz yürüyüşünü andırır fakat etkilenmiş bireyler distonik yürüyüşlerini geriye doğru yürüyerek iyileştirebilir</obo:IAO_0000115>
