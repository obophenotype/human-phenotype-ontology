        <owl:annotatedTarget xml:lang="tr">Besin tetikli anaflaksi allerjiye neden olan bir besin ile temas sonrası aniden meydana gelen ciddi, potansiyel olarak ölümcül, sistemik bir allerjik reaksiyondur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Food-induced anaphylaxis is a severe, potentially fatal, systemic allergic reaction that occurs suddenly after contact with an allergy-causing food.</babelon:source_value>
