    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010861">
        <obo:IAO_0000115 xml:lang="tr">Bir veya her iki kalçanın ekstende ve fetüsün bir veya her iki ayağının aşağı işaret ettiği ve doğum kanalına girdiği bir tür kıç geliş</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kısmi makat geliş</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010861"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir veya her iki kalçanın ekstende ve fetüsün bir veya her iki ayağının aşağı işaret ettiği ve doğum kanalına girdiği bir tür kıç geliş</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A kind of breech presentation in which one or both hips are extended and one or both of the fetus&apos; feet are pointing down and entering the birth canal.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
