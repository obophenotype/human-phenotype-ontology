        <rdfs:label xml:lang="tr">Kuadriküspit aort kapağı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031655"/>
