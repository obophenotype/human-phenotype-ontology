        <babelon:source_value>Delayed puberty</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000824">
        <obo:IAO_0000115 xml:lang="tr">Ön hipofiz bezi tarafından üretilen büyüme hormonunun yetersiz üretimi. Büyüme hormonu büyüme ve metabolizmanın kontrolünde önemli bir paya sahiptir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Büyüme hormonu eksikliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000824"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ön hipofiz bezi tarafından üretilen büyüme hormonunun yetersiz üretimi. Büyüme hormonu büyüme ve metabolizmanın kontrolünde önemli bir paya sahiptir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Insufficient responses to growth hormone (GH) provocation tests. GH deficiency is defined as a serum peak GH concentration less than 10 ng/mL on provocation with a combination of at least two separate stimulation tests.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000824"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Büyüme hormonu eksikliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased response to growth hormone stimulation test</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000825">
        <obo:IAO_0000115 xml:lang="tr">Kandaki düşmüş glukoz konsantrasyonu ile birlikte olan artmış insülin konsantrasyonu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hiperinsülinemik hipoglisemi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000825"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kandaki düşmüş glukoz konsantrasyonu ile birlikte olan artmış insülin konsantrasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An increased concentration of insulin combined with a decreased concentration of glucose in the blood.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000825"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hiperinsülinemik hipoglisemi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hyperinsulinemic hypoglycemia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000826">
        <obo:IAO_0000115 xml:lang="tr">İkincil cinsiyet karakteristiklerinin normal yaştan önce başlamasıdır. Normal yaş aralıklarını normal çocuklarda puberte başlangıcının belirgin varyasyonları sebebiyle tanımlamak güç olsa da, erken başlangıçlı puberte kızlarda 8 yaşından veya erkeklerde 9 yaşından önce puberte başlaması olarak tanımlanabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Puberte prekoks</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000826"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İkincil cinsiyet karakteristiklerinin normal yaştan önce başlamasıdır. Normal yaş aralıklarını normal çocuklarda puberte başlangıcının belirgin varyasyonları sebebiyle tanımlamak güç olsa da, erken başlangıçlı puberte kızlarda 8 yaşından veya erkeklerde 9 yaşından önce puberte başlaması olarak tanımlanabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The onset of secondary sexual characteristics before a normal age. Although it is difficult to define normal age ranges because of the marked variation with which puberty begins in normal children, precocious puberty can be defined as the onset of puberty before the age of 8 years in girls or 9 years in boys.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000826"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Puberte prekoks</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Precocious puberty</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000828">
