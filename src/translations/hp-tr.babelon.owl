    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002680">
        <obo:IAO_0000115 xml:lang="tr">Sellanın normalden daha öne uzandığı, ön klinoid çıkıntının üzerine sarkar gibi göründügü ve kafatası görüntülemesinde J harfi görünümünü verdiği bir sella tursika kusuru</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">J şekilli sella tursika</rdfs:label>
    </rdf:Description>
