    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030061">
        <obo:IAO_0000115 xml:lang="tr">Merkezi ve çevresel sinir sistemine gelişen erken embriyo ektoderm kısmı olan bazı glial hücreleri içeren nöroektodermde oluşan bir neoplazm</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Nöroektodermal neoplazm</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030061"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Merkezi ve çevresel sinir sistemine gelişen erken embriyo ektoderm kısmı olan bazı glial hücreleri içeren nöroektodermde oluşan bir neoplazm</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A neoplasm arising in the neuroectoderm, the portion of the ectoderm of the early embryo that gives rise to the central and peripheral nervous systems, including some glial cells.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030061"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Nöroektodermal neoplazm</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neuroectodermal neoplasm</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030062">
        <obo:IAO_0000115 xml:lang="tr">Rathke kesesinden köken alan selim bir pitüiter bölge neoplazmı. Kraniyofaranjiyomlar merkezi sinir sisteminin sellar ve parasellar bölgeleri içinde yer alan selim, yavaş büyüyen tümörlerdir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kraniyofarinjiyoma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030062"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Rathke kesesinden köken alan selim bir pitüiter bölge neoplazmı. Kraniyofaranjiyomlar merkezi sinir sisteminin sellar ve parasellar bölgeleri içinde yer alan selim, yavaş büyüyen tümörlerdir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A benign pituitary-region neoplasm that originates from Rathke&apos;s pouch. Craniopharyngiomas are benign slow growing tumors that are located within the sellar and para sellar region of the central nervous system.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030062"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kraniyofarinjiyoma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Craniopharyngioma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030063">
        <obo:IAO_0000115 xml:lang="tr">Nöral epitelden oluşan bir neoplazm, nöral epitel veya nöroepitelyumda yer almasa da olan bir neoplazm</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Nöroepitelyal neoplazm</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030063"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Nöral epitelden oluşan bir neoplazm, nöral epitel veya nöroepitelyumda yer almasa da olan bir neoplazm</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A neoplasm composed of neural epithelium, not necessarily a neoplasm located in the neural epithelium or neuroepithelium.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030063"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Nöroepitelyal neoplazm</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neuroepithelial neoplasm</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030064">
        <obo:IAO_0000115 xml:lang="tr">Sıklıkla septum pellusidum ve lateral ventrikül duvarlarından köken alan nöral bileşenlerden oluşan selim bir beyin tümörü</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Nörositoma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030064"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sıklıkla septum pellusidum ve lateral ventrikül duvarlarından köken alan nöral bileşenlerden oluşan selim bir beyin tümörü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A benign brain tumor composed of neural elements which most often arise from the septum pellucidum and the walls of the lateral ventricles.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030064"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Nörositoma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Neurocytoma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030065">
        <obo:IAO_0000115 xml:lang="tr">Primitif nöral krestteki hücrelerden köken alan bir tümör. Bu grup tümörler nöronal ve/veya glial farklılaşma unsurları ile primitif hücrelerin varlığı ile karakterizedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İlkel nöroektodermal tümör</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030065"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Primitif nöral krestteki hücrelerden köken alan bir tümör. Bu grup tümörler nöronal ve/veya glial farklılaşma unsurları ile primitif hücrelerin varlığı ile karakterizedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A tumor that originates in cells from the primitive neural crest. This group of tumors is characteirzed by the presence of primitive cells with elements of neuronal and/or glial differentiation.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030065"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">İlkel nöroektodermal tümör</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Primitive neuroectodermal tumor</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030066">
        <obo:IAO_0000115 xml:lang="tr">Bebeklik ve genç çocukluk döneminin oldukça kötü huylu bir embriyonal tümörü, ayırt edici çok tabakalı rozetlerde organize edilen nöroektodermal elementlerle karakterize edilir. Ependimoblastomalar, supratentorial bölmede meydana gelen, genellikle ventriküler sistemde fiziksel bir bağlantı gösteren geniş lezyonlardır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ependimoblastom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030066"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bebeklik ve genç çocukluk döneminin oldukça kötü huylu bir embriyonal tümörü, ayırt edici çok tabakalı rozetlerde organize edilen nöroektodermal elementlerle karakterize edilir. Ependimoblastomalar, supratentorial bölmede meydana gelen, genellikle ventriküler sistemde fiziksel bir bağlantı gösteren geniş lezyonlardır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A highly malignant embryonal tumor of infancy and young childhood characterized by neuroectodermal elements organized in distinctive multilayered rosettes. Ependymoblastomas are large lesions that occur in the supratentorial compartment, typically displaying a physical connection to the ventricular system.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030066"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ependimoblastom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ependymoblastoma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030067">
        <obo:IAO_0000115 xml:lang="tr">Ekstrakraniyal olarak yumuşak doku ve kemikte meydana gelen primitif nöroektodermal bir neoplazi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Periferik ilkel nöroektodermal neoplazm</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030067"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ekstrakraniyal olarak yumuşak doku ve kemikte meydana gelen primitif nöroektodermal bir neoplazi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A primitive neuroectodermal neoplasm that occurs extracranially in soft tissue and bone.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
