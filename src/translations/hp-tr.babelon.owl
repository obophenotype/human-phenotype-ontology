        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032052">
        <obo:IAO_0000115 xml:lang="tr">Belirgin olarak genişlemiş hücre vücudu ve çekirdeği, maloryantasyon, anormal olarak dağılmış intraselüler Nissl cismi ve nörofilaman proteinlerinin sitoplazmik birikimi ile ortaya çıkan dismorfik nöronlar ile karakterize bir fokal kortikal displazi tip II alt tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fokal kortikal displazi tip IIa</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032052"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Belirgin olarak genişlemiş hücre vücudu ve çekirdeği, maloryantasyon, anormal olarak dağılmış intraselüler Nissl cismi ve nörofilaman proteinlerinin sitoplazmik birikimi ile ortaya çıkan dismorfik nöronlar ile karakterize bir fokal kortikal displazi tip II alt tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A subtype of focal cortical dysplasia type II that is characterized by dysmorphic neurons, which present with a significantly enlarged cell body and nucleus, malorientation, abnormally distributed intracellular Nissl substance and cytoplasmic accumulation of neurofilament proteins.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032052"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Fokal kortikal displazi tip IIa</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cortical dysplasia type IIa</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032053">
        <obo:IAO_0000115 xml:lang="tr">Dismorfik nöronlar (nörofilaman proteinlerinin birikimi ile anlamlı olarak genişlemiş) ve bolan hücreleri ile karakterize bir fokal kortikal displazi tip II alt tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fokal kortikal displazi tip IIb</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032053"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Dismorfik nöronlar (nörofilaman proteinlerinin birikimi ile anlamlı olarak genişlemiş) ve bolan hücreleri ile karakterize bir fokal kortikal displazi tip II alt tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A subtype of focal cortical dysplasia type II that is characterized by dysmorphic neurons (significantly enlarged with accumulation of neurofilament proteins) and balloon cells.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032053"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Fokal kortikal displazi tip IIb</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cortical dysplasia type IIb</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032054">
        <obo:IAO_0000115 xml:lang="tr">Genellikle bitişik veya aynı kortikal sahayı/lobu etkileyen ana bir lezyon ile ilişkili kortikal laminasyon anormallikleri ile karakterize bir fokal kortikal displazi tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fokal kortikal displazi tip III</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032054"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Genellikle bitişik veya aynı kortikal sahayı/lobu etkileyen ana bir lezyon ile ilişkili kortikal laminasyon anormallikleri ile karakterize bir fokal kortikal displazi tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of focal cortical dysplasia that is characterized by cortical lamination abnormalities associated with a principal lesion, usually adjacent to or affecting the same cortical area/lobe.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032054"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Fokal kortikal displazi tip III</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cortical dysplasia type III</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032055">
        <obo:IAO_0000115 xml:lang="tr">Hipokampal sklerozisli hastalarda (HS, sinonim Ammon&apos;un boynuz sklerozu) mimari organizasyonda (kortikal dislaminasyon) veya hücresel mimari bileşimde (Katman 5&apos;in dışında hipertrofik nöronlar) değişimler ile karakterize bir fokal kortikal displazi tip III alt tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fokal kortikal displazi tip IIIa</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032055"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hipokampal sklerozisli hastalarda (HS, sinonim Ammon&apos;un boynuz sklerozu) mimari organizasyonda (kortikal dislaminasyon) veya hücresel mimari bileşimde (Katman 5&apos;in dışında hipertrofik nöronlar) değişimler ile karakterize bir fokal kortikal displazi tip III alt tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A subtype of focal cortical dysplasia type III that is characterized by alterations in architectural organization (cortical dyslamination) or cytoarchitectural composition (hypertrophic neurons outside Layer 5) in patients with hippocampal sclerosis (also known as Ammon&apos;s horn sclerosis).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032055"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Fokal kortikal displazi tip IIIa</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cortical dysplasia type IIIa</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032056">
        <obo:IAO_0000115 xml:lang="tr">Gliyal veya gliyonöral tümöre bitişik meydana gelen, neokorteksin değişmiş mimarisi (kortikal dislaminasyon, altı katlmanlı yapısız hipoplazi) ve/veya hücresel mimari bileşimi (hipertrofik nöronlar) ile karakterize bir fokal kortikal displazi tip II alt tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fokal kortikal displazi tip IIIb</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032056"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Gliyal veya gliyonöral tümöre bitişik meydana gelen, neokorteksin değişmiş mimarisi (kortikal dislaminasyon, altı katlmanlı yapısız hipoplazi) ve/veya hücresel mimari bileşimi (hipertrofik nöronlar) ile karakterize bir fokal kortikal displazi tip II alt tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A subtype of focal cortical dysplasia type III that is characterized by altered architectural (cortical dyslamination, hypoplasia without six-layered structure) and/or cytoarchitectural composition (hypertrophic neurons) of the neocortex, which occur adjacent to glial or glioneuronal tumor.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032056"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Fokal kortikal displazi tip IIIb</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cortical dysplasia type IIIb</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032057">
        <obo:IAO_0000115 xml:lang="tr">Vasküler malformasyonlara (kavernomlar, arteriyovenöz malformasyonlar, leptomeningeyal vasküler malformasyonlar, telenjiektaziler, meningioanjiyomatozis) bitişik meydana gelen, neokorteks mimarisinde (kortikal dislaminasyon, hipoplazi) veya hücresel mimari bileşiminde (hipertrofik nöronlar) değişimler ile karakterize bir fokal kortikal displazi tip III alt tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fokal kortikal displazi tip IIIc</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032057"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Vasküler malformasyonlara (kavernomlar, arteriyovenöz malformasyonlar, leptomeningeyal vasküler malformasyonlar, telenjiektaziler, meningioanjiyomatozis) bitişik meydana gelen, neokorteks mimarisinde (kortikal dislaminasyon, hipoplazi) veya hücresel mimari bileşiminde (hipertrofik nöronlar) değişimler ile karakterize bir fokal kortikal displazi tip III alt tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A subtype of focal cortical dysplasia type III that is characterized by alterations in architectural (cortical dyslamination, hypoplasia) or cytoarchitectural composition of the neocortex (hypertrophic neurons), which occur adjacent to vascular malformations (cavernomas, arteriovenous malformations, leptomeningeal vascular malformations, telangiectasias, meningioangiomatosis).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032057"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Fokal kortikal displazi tip IIIc</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cortical dysplasia type IIIc</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032058">
        <obo:IAO_0000115 xml:lang="tr">Yaşam boyunca edinilmiş diğer lezyonlara (FKD tip IIIa-c&apos;ye dahil edilmemiş) bitişik meydana gelen, neokorteksin değişmiş mimarisi (kortikal dislaminasyon, altı katmanlı yapısız hipoplazi) veya hücresel mimari bileşimi (hipertrofik nöronlar) ile karakterize bir fokal kortikal displazi tip III alt tipi. Bu lezyonlar travmatik beyin hasarı, prenatal veya perinatal iskemik hasar veya kanama sonrası gliyal skarlaşma ve inflamatuvar veya Rasmussen ensefaliti, limbik ensefalit, bakteriyel veya viral enfeksiyonlar gibi enfeksiyöz hastalıklar dahil geniş bir spektrum içerir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fokal kortikal displazi tip IIId</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032058"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Yaşam boyunca edinilmiş diğer lezyonlara (FKD tip IIIa-c&apos;ye dahil edilmemiş) bitişik meydana gelen, neokorteksin değişmiş mimarisi (kortikal dislaminasyon, altı katmanlı yapısız hipoplazi) veya hücresel mimari bileşimi (hipertrofik nöronlar) ile karakterize bir fokal kortikal displazi tip III alt tipi. Bu lezyonlar travmatik beyin hasarı, prenatal veya perinatal iskemik hasar veya kanama sonrası gliyal skarlaşma ve inflamatuvar veya Rasmussen ensefaliti, limbik ensefalit, bakteriyel veya viral enfeksiyonlar gibi enfeksiyöz hastalıklar dahil geniş bir spektrum içerir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A subtype of focal cortical dysplasia type III that is characterized by altered architectural (cortical dyslamination, hypoplasia without six-layered structure) or cytoarchitectural composition (hypertrophic neurons) of the neocortex, which occur adjacent to other lesions acquired during early life (not included into FCD Type IIIa-c). These lesions comprise a large spectrum including traumatic brain injury, glial scarring after prenatal or perinatal ischemic injury or bleeding, and inflammatory or infectious diseases, i.e. Rasmussen encephalitis, limbic encephalitis, bacterial or viral infections.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032058"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Fokal kortikal displazi tip IIId</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal cortical dysplasia type IIId</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032059">
        <obo:IAO_0000115 xml:lang="tr">Korteksin hafif anormallikleri ile karakterize bir kortikal gelişim malformasyonu: Katman 1&apos;de aşırı heterotopik nöronlar veya mikroskobik nöronal kümeler veya normal derin beyaz cevherin aşırı tek nöronları</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kortikal gelişimin hafif malformasyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032059"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Korteksin hafif anormallikleri ile karakterize bir kortikal gelişim malformasyonu: Katman 1&apos;de aşırı heterotopik nöronlar veya mikroskobik nöronal kümeler veya normal derin beyaz cevherin aşırı tek nöronları</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A malformation of cortical development characterized by mild abnormalities of the cortex: excessive heterotopic neurons in Layer 1 or microscopic neuronal clusters or excess of single neurons of normal morphology in deep white matter.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032059"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kortikal gelişimin hafif malformasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Mild malformation of cortical development</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032060">
        <obo:IAO_0000115 xml:lang="tr">Çoğunlukla kulak ve periauriküler alanı etkileyen et/erik renkli pruritik nodüller ve papüller olarak ortaya çıkan kan damar proliferasyonu ve yoğun eozinofilik inflamatuvar bir infiltrat içeren selim bir neoplazm</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Epiteloid hemanjiyoma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032060"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çoğunlukla kulak ve periauriküler alanı etkileyen et/erik renkli pruritik nodüller ve papüller olarak ortaya çıkan kan damar proliferasyonu ve yoğun eozinofilik inflamatuvar bir infiltrat içeren selim bir neoplazm</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A benign neoplasm that includes blood vessel proliferation and a dense eosinophilic inflammatory infiltrate, manifesting as flesh/plum-colored pruritic nodules and papules, most commonly affecting the ear and the periauricular area.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032060"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Epiteloid hemanjiyoma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Epithelioid hemangioma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032061">
        <obo:IAO_0000115 xml:lang="tr">Kan eozinofil sayısının 1.5 × 10e9/L veya daha fazla (litre başına bir buçuk milyar hücre) olarak tanımlandığı kanda ciddi olarak artmış eozinofil sayısı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hipereozinofili</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032061"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kan eozinofil sayısının 1.5 × 10e9/L veya daha fazla (litre başına bir buçuk milyar hücre) olarak tanımlandığı kanda ciddi olarak artmış eozinofil sayısı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Severe increase in circulating eosinophils, usually characterized as more than 1500 eosinophils per microlitre.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
