        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031660">
        <obo:IAO_0000115 xml:lang="tr">Birinci kalp sesinin anormal olarak artmış hacmi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yüksek birinci kalp sesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031660"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Birinci kalp sesinin anormal olarak artmış hacmi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
