    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002380">
        <obo:IAO_0000115 xml:lang="tr">Fasikülasyonlar, cildin alt kısmında görülebilen küçük, lokal ve istem dışı kas kasılmaları (seğirme) olarak gözlemlenir. Fasikülasyonlar, bir aksonun artmış olan irritabilitesinden kaynaklanır (ki bu da genellikle bir motor nöron hastalığının bir belirtisidir). Akson tarafından kontrol edilen tüm kas liflerinin sporadik deşarjları, diğer motor ünitelere öncülük eder</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fasikülasyonlar</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002380"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Fasikülasyonlar, cildin alt kısmında görülebilen küçük, lokal ve istem dışı kas kasılmaları (seğirme) olarak gözlemlenir. Fasikülasyonlar, bir aksonun artmış olan irritabilitesinden kaynaklanır (ki bu da genellikle bir motor nöron hastalığının bir belirtisidir). Akson tarafından kontrol edilen tüm kas liflerinin sporadik deşarjları, diğer motor ünitelere öncülük eder</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fasciculations are observed as small, local, involuntary muscle contractions (twitching) visible under the skin. Fasciculations result from increased irritability of an axon (which in turn is often a manifestation of disease of a motor neuron). This leads to sporadic discharges of all the muscle fibers controlled by the axon in isolation from other motor units.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002380"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Fasikülasyonlar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Fasciculations</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002381">
        <obo:IAO_0000115 xml:lang="tr">Zamanla kazanılan bir dil konuşmada üretme ya da kavrama ve yazma ya da okuma yeteneklerinin bir kısmını ya da tamamını zedeler</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Afazi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002381"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Zamanla kazanılan bir dil konuşmada üretme ya da kavrama ve yazma ya da okuma yeteneklerinin bir kısmını ya da tamamını zedeler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An acquired language impairment of some or all of the abilities to produce or comprehend speech and to read or write.</babelon:source_value>
