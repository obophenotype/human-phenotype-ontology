    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001518">
        <obo:IAO_0000115 xml:lang="tr">Cinsiyet ve gestasyonel yaş ilişkili normlara göre normal boyuttan daha küçük, gestasyonel yaş için 10. yüzdelik dilim altındaki ağırlık olarak tanımlanmıştır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Gestasyonel yaşa göre küçük</rdfs:label>
    </rdf:Description>
