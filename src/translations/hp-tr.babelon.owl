    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000185">
        <obo:IAO_0000115 xml:lang="tr">Yarık yumuşak damak (velum veya müsküler damak olarak da bilinen) gebeliğin 7. ve 12. haftası arasında oluşan gelişimsel bir defekt sonucu meydana gelir. Yarık yumuşak damak orta kulak ve işitme güçlüğü ile sonuçlanan östaki borusunun işlevsel anomalilerine ve velofaringeyal yetmezlik nedeniyle olan hipernazal konuşma ilişkili konuşma sorunlarına yol açar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yarık yumuşak damak</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000185"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Yarık yumuşak damak (velum veya müsküler damak olarak da bilinen) gebeliğin 7. ve 12. haftası arasında oluşan gelişimsel bir defekt sonucu meydana gelir. Yarık yumuşak damak orta kulak ve işitme güçlüğü ile sonuçlanan östaki borusunun işlevsel anomalilerine ve velofaringeyal yetmezlik nedeniyle olan hipernazal konuşma ilişkili konuşma sorunlarına yol açar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cleft of the soft palate (also known as the velum, or muscular palate) as a result of a developmental defect occurring between the 7th and 12th week of pregnancy. Cleft soft palate can cause functional abnormalities of the Eustachian tube with resulting middle ear anomalies and hearing difficulties, as well as speech problems associated with hypernasal speech due to velopharyngeal insufficiency.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000185"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Yarık yumuşak damak</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cleft soft palate</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
