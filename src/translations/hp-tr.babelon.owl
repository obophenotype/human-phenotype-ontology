    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005155">
        <obo:IAO_0000115 xml:lang="tr">Ventriküler çıkış ritmi av kavşağı veya sinüs düğümünde yüksek kollu pacemakers ventriküler aktivasyonu kontrol etmek için başarısız olduğunda oluşur. Çıkış oranı genelde 20-40 bpm&apos;dir, sıklıkla geniş QRS kompleksleriyle ilişkilidir (en az 120 ms)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ventriküler kaçış ritimleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005155"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ventriküler çıkış ritmi av kavşağı veya sinüs düğümünde yüksek kollu pacemakers ventriküler aktivasyonu kontrol etmek için başarısız olduğunda oluşur. Çıkış oranı genelde 20-40 bpm&apos;dir, sıklıkla geniş QRS kompleksleriyle ilişkilidir (en az 120 ms)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A ventricular escape rhythm occurs whenever higher-lever pacemakers in AV junction or sinus node fail to control ventricular activation. Escape rate is usually 20-40 bpm, often associated with broad QRS complexes (at least 120 ms).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
