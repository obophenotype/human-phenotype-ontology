        <babelon:source_value>Peripheral arterial stenosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004952">
        <obo:IAO_0000115 xml:lang="tr">Pulmoner arter ve pulmoner ven arasında direkt bir iletişimle birlikte araya giren kılcal yatak olmaksızın nadir görülen bir vasküler anomali</obo:IAO_0000115>
