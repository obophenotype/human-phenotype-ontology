    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009182">
        <obo:IAO_0000115 xml:lang="tr">5. (küçük) parmağın üçgen şeklindeki orta falanksı. Üçgen veya denildiği üzre delta şekilli falanks etkilenmiş falanksın parantez epifizi sonrası tipik bir sonucudur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">5. parmağın üçgen şekilli orta falanksı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009182"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">5. (küçük) parmağın üçgen şeklindeki orta falanksı. Üçgen veya denildiği üzre delta şekilli falanks etkilenmiş falanksın parantez epifizi sonrası tipik bir sonucudur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Triangular shaped middle phalanx of the 5th (little) finger. A triangular or so called delta shaped phalanx is a typical result after a bracket epiphysis of the affected phalanx.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
