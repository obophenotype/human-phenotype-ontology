        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A usually benign neoplasm originating in the chemoreceptor tissue of the carotid body, glomus jugulare, glomus tympanicum, aortic bodies, or the female genital tract.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
