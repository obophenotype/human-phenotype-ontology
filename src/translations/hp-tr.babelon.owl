    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000480">
        <obo:IAO_0000115 xml:lang="tr">Retinanın çentiği veya yarığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Retinal koloboma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000480"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
