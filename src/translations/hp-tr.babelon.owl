        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Palmar pits</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010612">
        <obo:IAO_0000115 xml:lang="tr">Çoklu çukurcukların (deri yüzeyinde küçük, iğne başı büyüklüğünde çentikleşmesi) varlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Plantar çukurlar</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010612"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çoklu çukurcukların (deri yüzeyinde küçük, iğne başı büyüklüğünde çentikleşmesi) varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of multiple pits (small, pinpoint-large indentations on the surface of the skin) located on the skin of sole of foot.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
