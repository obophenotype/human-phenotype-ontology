    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0410292">
        <obo:IAO_0000115 xml:lang="tr">Kanda anormal bir izohemaglütinin seviyesi. Bir izohemaglütinin ABO kan grubu sisteminde (örneğin, bir grup B kişisinde anti-A, bir grup A kişisinde anti-B, ve bir 0 kişisinde anti-A ve anti-B ve anti-A,B) doğal olarak meydana gelen antikorlara denir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal izohemaglütinin seviyesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410292"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kanda anormal bir izohemaglütinin seviyesi. Bir izohemaglütinin ABO kan grubu sisteminde (örneğin, bir grup B kişisinde anti-A, bir grup A kişisinde anti-B, ve bir 0 kişisinde anti-A ve anti-B ve anti-A,B) doğal olarak meydana gelen antikorlara denir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal level of isohemagglutinin in the blood. An isohemagglutinin refers to the naturally occurring antibodies in the ABO blood group system (i.e., anti-A in a group B person, anti-B in a group A person, and anti-A, anti-B, and anti-A,B in a group O person).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410292"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal izohemaglütinin seviyesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal circulating isohemagglutinin concentration</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0410293">
        <obo:IAO_0000115 xml:lang="tr">Olmayan veya tespit edilemeyen izohemaglütinin seviyesi. Bir izohemaglütinin ABO kan grubu sisteminde (örneğin, bir grup B kişisinde anti-A, bir grup A kişisinde anti-B, ve bir 0 kişisinde anti-A ve anti-B ve anti-A,B) doğal olarak meydana gelen antikorlara denir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Olmayan izohemaglütinin seviyesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410293"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Olmayan veya tespit edilemeyen izohemaglütinin seviyesi. Bir izohemaglütinin ABO kan grubu sisteminde (örneğin, bir grup B kişisinde anti-A, bir grup A kişisinde anti-B, ve bir 0 kişisinde anti-A ve anti-B ve anti-A,B) doğal olarak meydana gelen antikorlara denir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absent or undetectable level of isohemagglutinin. An isohemagglutinin refers to the naturally occurring antibodies in the ABO blood group system (i.e., anti-A in a group B person, anti-B in a group A person, and anti-A, anti-B, and anti-A,B in a group O person).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410293"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Olmayan izohemaglütinin seviyesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absent circulating isohemagglutinin</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
