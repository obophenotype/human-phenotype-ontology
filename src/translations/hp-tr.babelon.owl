    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025471">
        <obo:IAO_0000115 xml:lang="tr">Gelişimin çeşitli evrelerinde malforme kıl foliküllerini içeren hamartamatöz proliferasyon. Panfolikülomlar foliküler farklılaşmanın bütün evrelerini gösteren iyi sınırlanmış lezyonlardır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Konjenital panfoliküler nevüs</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
