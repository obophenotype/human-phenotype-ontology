        <owl:annotatedTarget xml:lang="tr">Posterior tibiyal arter veya dorsalis pedis arter vurusu fizik muayenede internal malleolus arkasından tespit edilemez</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The pulsation of the posterior tibial artery behind the internal malleolus, or of the dorsalis pedis artery, cannot be detected on physical examination.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
