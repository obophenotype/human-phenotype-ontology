        <owl:annotatedTarget xml:lang="tr">Ayak bileği klonusu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ankle clonus</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011449">
        <obo:IAO_0000115 xml:lang="tr">Klonus tekrarlayan ayak fleksiyonu ve ekstensiyonuna neden olan istemsiz bir tendon refleksidir. Diz klonusu patellanın hızla ayak parmaklarına doğru itilmesi ile test edilebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Diz klonusu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011449"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Klonus tekrarlayan ayak fleksiyonu ve ekstensiyonuna neden olan istemsiz bir tendon refleksidir. Diz klonusu patellanın hızla ayak parmaklarına doğru itilmesi ile test edilebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Clonus is an involuntary tendon reflex that causes repeated flexion and extension of the foot. Knee clonus can be tested by rapidly pushing the patella towards the toes.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
