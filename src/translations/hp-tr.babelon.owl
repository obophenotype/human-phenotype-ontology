        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ağız tabanının altında submandibüler bezlerin önünde yer alan salgı bezleri olan sublingual bezlerin herhangi bir anormalliği</owl:annotatedTarget>
