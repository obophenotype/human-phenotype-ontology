    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012670"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Yatıyorken ayağa kalkılması ile hızlı pozisyon değişimini takiben olan senkop</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
