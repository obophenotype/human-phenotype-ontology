        <babelon:source_value>Vasculitis in the skin</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0200030">
        <rdfs:label xml:lang="tr">Benekli vaskülit cilt lezyonları</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
