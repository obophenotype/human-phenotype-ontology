    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031722">
        <obo:IAO_0000115 xml:lang="tr">Uzak sabitlenmede binoküler tek görüşün ve uyum ortadan kalktığında dahi yakında ezotropiyanın olduğu orta dereceli bir ezotropiya</obo:IAO_0000115>
