        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Baş parmağın metakarpofalangeyal ekleminin kontraktürleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Metacarpophalangeal thumb joint contracture</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009626">
        <obo:IAO_0000115 xml:lang="tr">Kemiksi olmayan dokudaki yapısal değişikliklere bağlı olarak baş parmağın interfalangeyal ekleminin kronik eklem hareketi kaybı. Bu eklem Articulatio interphalangealis pollicis olarak da adlandırılır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">El baş parmağının interfalangeyal eklem kontraktürleri</rdfs:label>
    </rdf:Description>
