    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009274">
        <obo:IAO_0000115 xml:lang="tr">Kemiksi olmayan dokuda yapısal değişiklikler yüzünden 4. parmakta kronik eklem hareketi kaybı. 4. parmağın kamptodaktilisi terimi distal ve/veya proksimal interfalanksiyal eklemler etkilendiyse kullanılır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">4. el parmağının eklem kontraktürü</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009274"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kemiksi olmayan dokuda yapısal değişiklikler yüzünden 4. parmakta kronik eklem hareketi kaybı. 4. parmağın kamptodaktilisi terimi distal ve/veya proksimal interfalanksiyal eklemler etkilendiyse kullanılır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic loss of joint motion in the 4th finger due to structural changes in non-bony tissue. The term camptodactyly of the 4th finger is used if the distal and/or proximal interphalangeal joints are affected.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009274"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">4. el parmağının eklem kontraktürü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Joint contracture of the 4th finger</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009275">
