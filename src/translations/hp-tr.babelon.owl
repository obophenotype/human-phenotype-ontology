    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025265">
        <obo:IAO_0000115 xml:lang="tr">Özellikle hareketsiz bir periyot sonrası hareket ettirmek için çabalandığında, ayak parmağı ekleminde sertlik hissi</obo:IAO_0000115>
