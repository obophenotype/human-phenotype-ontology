    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030794">
        <obo:IAO_0000115 xml:lang="tr">Proinsülin içinde insülin A ve B zincirlerini birbirine bağlayan ve böylelikle insülin biyosentezi sırasında endoplazmik retikulümdeki katlanmalarını ve birleştirilmesini kolaylaştıran bir araç sağlan bağlayıcı (C) peptidinin düzensiz dolaşım konsantrasyonu. Proinsülinin bölünmesinden sonra, C-peptid, salgı granüllerinin çözünür fazında insülin ile birlikte depolanır ve daha sonra, insülin sekresyonunun faydalı bağımsız bir gösterge sağlayarak, insülin ile eş molar miktarlarda salınır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal C peptit seviyesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030794"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Proinsülin içinde insülin A ve B zincirlerini birbirine bağlayan ve böylelikle insülin biyosentezi sırasında endoplazmik retikulümdeki katlanmalarını ve birleştirilmesini kolaylaştıran bir araç sağlan bağlayıcı (C) peptidinin düzensiz dolaşım konsantrasyonu. Proinsülinin bölünmesinden sonra, C-peptid, salgı granüllerinin çözünür fazında insülin ile birlikte depolanır ve daha sonra, insülin sekresyonunun faydalı bağımsız bir gösterge sağlayarak, insülin ile eş molar miktarlarda salınır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any deviation from the normal concentration of C-peptide in the blood circulation.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
