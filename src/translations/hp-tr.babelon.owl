        <rdfs:label xml:lang="tr">Tikler</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100033"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Tekrarlayan, bireysel olarak algılanabilen, çoğu zaman kısmen bastırılabilir ve genellikle hareketi gerçekleştirmeye yönelik bir istek uyandırması ile ilişkili olan aralıklı hareketler veya hareket parçaları</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Repeated, individually recognizable, intermittent movements or movement fragments that are almost always briefly suppressible and are usually associated with awareness of an urge to perform the movement.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
