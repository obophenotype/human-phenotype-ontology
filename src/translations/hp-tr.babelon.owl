    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012869"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Herhangi çekirdeksel materyalden yoksun çok küçük kraniyal uçlu yani tipik sperm başı eksik olan spermatozoa</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Spermatozoa with very small cranial ends devoid of any nuclear material, that is, lacking a typical sperm head.</babelon:source_value>
