        <owl:annotatedTarget xml:lang="tr">Morfolojik sol ventrikülden hem pulmoner arter hem de aorta kökeni ile karakterize kalp gelişiminin konjenital bir defekti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A congenital defect of heart development characterized by origin of both pulmonary artery and aorta from the morphological left ventricle.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
