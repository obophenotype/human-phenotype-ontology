    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031948">
        <obo:IAO_0000115 xml:lang="tr">Manyetik rezonans görüntüleme (T2 veya sagital sıvı azalmış inversiyon düzelmesi sekansları ile) sonrası kartopunu andırdığı söylenen merkezi olarak yerleşmiş korpus kallozum hiperintensiteleri. Kallozumda merkezi yerleşim Susac sendromu içim patognomonik yapmaktadır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Korpus kallozumun kartopu lezyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031948"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Manyetik rezonans görüntüleme (T2 veya sagital sıvı azalmış inversiyon düzelmesi sekansları ile) sonrası kartopunu andırdığı söylenen merkezi olarak yerleşmiş korpus kallozum hiperintensiteleri. Kallozumda merkezi yerleşim Susac sendromu içim patognomonik yapmaktadır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Centrally located corpus callosum hyperintensities said to resemble snowballs upon magnetic resonance imaging (with T2 or Sagittal fluid attenuated inversion recovery [FLAIR] sequences). The central location in the callosum makes them pathognomonic for Susac syndrome.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
