        <owl:annotatedTarget xml:lang="tr">Baskın olarak nötrofillerin sitoplazmik granüllerinde eksprese edilen proteinlere karşı tepki veren otoantikorların serumda varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of autoantibodies in the serum that react against proteins predominantly expressed in cytoplasmic granules of neutrophils.</babelon:source_value>
