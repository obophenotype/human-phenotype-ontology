        <owl:annotatedTarget xml:lang="tr">Derinin etkilenmiş alanlarının sıcaklık ve yanma hissi ile birlikte derinin tekrarlayan kırmızılık epizotları</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
