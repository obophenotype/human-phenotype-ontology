    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000524">
        <obo:IAO_0000115 xml:lang="tr">Konjunktivanın müköz membranlarının yüzeyine yakın küçük (yaklaşık 0.5-1.0 mm) genişlemiş kan damarları varlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Konjunktival telenjiektazi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000524"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Konjunktivanın müköz membranlarının yüzeyine yakın küçük (yaklaşık 0.5-1.0 mm) genişlemiş kan damarları varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of small (ca. 0.5-1.0 mm) dilated blood vessels near the surface of the mucous membranes of the conjunctiva.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
