        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001836">
        <obo:IAO_0000115 xml:lang="tr">Kamptodaktili, proksimal interfalangiyal (PİF) eklemlerin sıklıkla kademeli olarak ilerleyen ağrısız bir fleksiyon kontraktürüdür. Bu terim bir veya birden fazla ayak baş parmağının kamptodaktilisine denir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ayak parmağı kamptodaktilisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001836"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kamptodaktili, proksimal interfalangiyal (PİF) eklemlerin sıklıkla kademeli olarak ilerleyen ağrısız bir fleksiyon kontraktürüdür. Bu terim bir veya birden fazla ayak baş parmağının kamptodaktilisine denir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Camptodactyly is a painless flexion contracture of the proximal interphalangeal (PIP) joint that is usually gradually progressive. This term refers to camptodactyly of one or more toes.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001836"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ayak parmağı kamptodaktilisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Camptodactyly of toe</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001837">
        <obo:IAO_0000115 xml:lang="tr">Başparmak dışındaki bir parmağın dorso-ventral boyutunda bir artış olmaksızın genişliğindeki görünür artış</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Geniş ayak parmağı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001837"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Başparmak dışındaki bir parmağın dorso-ventral boyutunda bir artış olmaksızın genişliğindeki görünür artış</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Visible increase in width of the non-hallux digit without an increase in the dorso-ventral dimension.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001837"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Geniş ayak parmağı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Broad toe</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001838">
        <obo:IAO_0000115 xml:lang="tr">Ayak tabanının dış bükey biçiminin ve topuk belirginliğinin bir arada bulunması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sallanan sandalye ayağına benzer ayak</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001838"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ayak tabanının dış bükey biçiminin ve topuk belirginliğinin bir arada bulunması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of both a prominent heel and a convex contour of the sole.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001838"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Sallanan sandalye ayağına benzer ayak</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Rocker bottom foot</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001839">
        <obo:IAO_0000115 xml:lang="tr">Ayağın orta kısımlarının (ayak parmakları ve metatarsaller) eksik olduğu yarık görünümü veren bir durum. Hafif hipoplastik 3. ayak parmağından 2. veya 3. ayak parmağı yokluğuna oligo- ya da monodaktil ayaklara kadar ciddiyeti çok değişkendir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ayrılmış ayak</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001839"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ayağın orta kısımlarının (ayak parmakları ve metatarsaller) eksik olduğu yarık görünümü veren bir durum. Hafif hipoplastik 3. ayak parmağından 2. veya 3. ayak parmağı yokluğuna oligo- ya da monodaktil ayaklara kadar ciddiyeti çok değişkendir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A condition in which middle parts of the foot (toes and metatarsals) are missing giving a cleft appearance. The severity is very variable ranging from slightly hypoplastic 3rd toe over absent 2nd or 3rd toes as far as oligo- or monodactyl feet.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001839"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ayrılmış ayak</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Split foot</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001840">
        <obo:IAO_0000115 xml:lang="tr">Ayak tarağı kemikleri ortaya doğru sapmış (tibiyal olarak), yani ayağın ön yarısındaki kemikler eğilmiş veya vücuda doğru dönmüş</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Metatarsus adduktus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001840"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ayak tarağı kemikleri ortaya doğru sapmış (tibiyal olarak), yani ayağın ön yarısındaki kemikler eğilmiş veya vücuda doğru dönmüş</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The metatarsals are deviated medially (tibially), that is, the bones in the front half of the foot bend or turn in toward the body.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001840"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Metatarsus adduktus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Metatarsus adductus</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001841">
        <obo:IAO_0000115 xml:lang="tr">Birinci uzanımın bir kısmının ya da tamamının duplikasyonu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Preaksiyel ayak polidaktilisi</rdfs:label>
