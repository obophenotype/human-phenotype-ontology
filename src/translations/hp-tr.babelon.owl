    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0008205">
        <obo:IAO_0000115 xml:lang="tr">Ketoz-rezistant diyabet tip 2 diyabetin sinonimidir. Bu terim hastaların insüline bağlı olduğu bir tür tip 2 diyabettir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İnsüline bağımlı fakat ketoza dirençli diyabet</rdfs:label>
