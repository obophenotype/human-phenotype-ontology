    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012522">
        <obo:IAO_0000115 xml:lang="tr">Bir arteriolü ifade eden, küçük bir kan damarı olan, örümcek ayaklarına benzer şekilde yayılmış merkezi kırmızı nokta ile karakterize telenjiektazi. Karakteristik olarak, merkezi arteriolün sıkıştırılması tüm lezyonun ağarmasına neden olur ve lezyon sıkıştırma bırakıldıktan hemen sonra tekrar doldurulur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Spider hemanjiyom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012522"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir arteriolü ifade eden, küçük bir kan damarı olan, örümcek ayaklarına benzer şekilde yayılmış merkezi kırmızı nokta ile karakterize telenjiektazi. Karakteristik olarak, merkezi arteriolün sıkıştırılması tüm lezyonun ağarmasına neden olur ve lezyon sıkıştırma bırakıldıktan hemen sonra tekrar doldurulur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of telangiectasis characterized by a central elevated red dot the size of a pinhead, representing an arteriole, with numerous small blood vessels that radiate out thereby resembling the legs of a spider. Characteristically, compression of the central arteriole causes the entire lesion to blanch, and the lesion quickly refills once the compression is released.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012522"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Spider hemanjiyom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Spider hemangioma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012523">
        <obo:IAO_0000115 xml:lang="tr">Öğürme, kusma, başını yemekten uzağa çevirme veya ağız etrafındaki veya içindeki histen kaçınma (örn. diş fırçalama veya yüz yıkama) ile kendini belli eden bir çocuğun emmeyi veya yemek yemeyi istememesi veya reddetmesi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Oral aversiyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012523"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Öğürme, kusma, başını yemekten uzağa çevirme veya ağız etrafındaki veya içindeki histen kaçınma (örn. diş fırçalama veya yüz yıkama) ile kendini belli eden bir çocuğun emmeyi veya yemek yemeyi istememesi veya reddetmesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reluctance or refusal of a child to be breastfed or eat, manifested as gagging, vomiting, turning head away from food, or avoidance of sensation in or around the mouth (i.e. toothbrushing or face-washing).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012523"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Oral aversiyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Oral aversion</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
