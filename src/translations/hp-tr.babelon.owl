    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000867">
        <obo:IAO_0000115 xml:lang="tr">İkincil hiperparatiroidizm, hipokalsemi varlığında normal seviyelerinden yüksek paratiroid hormon üretimine denir</obo:IAO_0000115>
