    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030406">
        <obo:IAO_0000115 xml:lang="tr">Peritoneumda köken alan bir kanser tipi. Peritoneumun metastatik kanserinden ayrılmalıdır. Paritoneal kanser abdominal boşlukta herhangi bir yerde meydana gelebilir ve peritoneum içinde yer alan organların yüzeyini etkiler</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Primer peritoneal karsinom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030406"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Peritoneumda köken alan bir kanser tipi. Peritoneumun metastatik kanserinden ayrılmalıdır. Paritoneal kanser abdominal boşlukta herhangi bir yerde meydana gelebilir ve peritoneum içinde yer alan organların yüzeyini etkiler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of cancer that originates in the peritoneum. It is to be distinguished from metastatic cancer of the peritoneum. Peritoneal cancer can occur anywhere in the abdominal space, and affects the surface of organs contained inside the peritoneum.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030406"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
