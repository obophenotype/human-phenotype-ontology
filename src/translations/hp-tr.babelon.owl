    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030465">
        <obo:IAO_0000115 xml:lang="tr">Işığa adapte 3.0 ERG&apos;ye (tek flaş koni yanıtı) tespit edilebilir yanıt yok. Bu tip ERG koni sisteminin yanıtını ölçer; a dalgaları koni fotoreseptörlerinden ve koni kapalı-bipolar hücrelerinden doğar; b dalgası açık ve kapalı-koni bipolar hücrelerinden gelir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tespit edilemeyen ışığa adapte olmuş elektroretinogram</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030465"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Işığa adapte 3.0 ERG&apos;ye (tek flaş koni yanıtı) tespit edilebilir yanıt yok. Bu tip ERG koni sisteminin yanıtını ölçer; a dalgaları koni fotoreseptörlerinden ve koni kapalı-bipolar hücrelerinden doğar; b dalgası açık ve kapalı-koni bipolar hücrelerinden gelir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>No detectable response to the light-adapted 3.0 ERG (single-flash cone response). This type of ERG measures responses of the cone system; a-waves arise from cone photoreceptors and cone off-bipolar cells; the b-wave comes from On- and Off-cone bipolar cells.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030465"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Tespit edilemeyen ışığa adapte olmuş elektroretinogram</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Undetectable light-adapted electroretinogram</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
