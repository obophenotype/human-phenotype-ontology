        <owl:annotatedTarget xml:lang="tr">Prolaktin salgılama kabiliyetinde azalma, ön hipofiz bezinde laktotroflar tarafından salgılanan ve meme bezi gelişimini ve süt üretimini uyaran bir protein hormondur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduced level of prolactin in the blood circulation. Prolactin is a protein hormone that is secreted by lactotrophs in the anterior pituitary and that stimulates mammary gland development and milk production.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
