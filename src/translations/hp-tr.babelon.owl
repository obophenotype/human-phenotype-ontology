    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005170">
        <obo:IAO_0000115 xml:lang="tr">Bir tür üçüncü derece kalp bloğu içinde kaçış ritmi iletim sisteminin nispeten düşük bir parçası (atrioventriküler düğüm altında), geniş QRS kompleksi üreten oluşur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Geniş RS kompleksli tam kalp bloğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005170"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir tür üçüncü derece kalp bloğu içinde kaçış ritmi iletim sisteminin nispeten düşük bir parçası (atrioventriküler düğüm altında), geniş QRS kompleksi üreten oluşur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of third degree heart block in which the escape rhythm arises at a relatively low part of the conduction system (below the atrioventricular node), which produces a wide QRS complex.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
