    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000691">
        <obo:IAO_0000115 xml:lang="tr">Azalmış diş boyutu meziodistal diş çapının (genişlik) ortlamadan 2 SD aşağıda olması olarak tanımlanabilir. Alternatif olarak, belirgin şekilde azalmış maksimum diş genişliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Mikrodonti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000691"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Azalmış diş boyutu meziodistal diş çapının (genişlik) ortlamadan 2 SD aşağıda olması olarak tanımlanabilir. Alternatif olarak, belirgin şekilde azalmış maksimum diş genişliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased size of the teeth, which can be defined as a mesiodistal tooth diameter (width) more than 2 SD below mean. Alternatively, an apparently decreased maximum width of tooth.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000691"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Mikrodonti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Microdontia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000692">
        <obo:IAO_0000115 xml:lang="tr">Dişlerin anormal dizilimi, pozisyonu veya konumlanması, örn. yanlış dizilmiş dişler</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dişlerin yanlış dizilimi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000692"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
