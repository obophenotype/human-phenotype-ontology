        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000248">
        <obo:IAO_0000115 xml:lang="tr">Ön-arka çapın azaldığı kafatası şekli anormalliğidir. Sefalik indeks %81&apos;den büyüktür. Alternatif olarak, genişlik ile kıyaslandığında belirgin kısalmış anteroposterior boyut (uzunluk)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Brakisefali</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000248"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ön-arka çapın azaldığı kafatası şekli anormalliğidir. Sefalik indeks %81&apos;den büyüktür. Alternatif olarak, genişlik ile kıyaslandığında belirgin kısalmış anteroposterior boyut (uzunluk)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of skull shape characterized by a decreased anterior-posterior diameter. That is, a cephalic index greater than 81%. Alternatively, an apparently shortened anteroposterior dimension (length) of the head compared to width.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
