    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012228">
        <obo:IAO_0000115 xml:lang="tr">Hafif veya orta yoğunlukta devam eden ağrılı, bilateral yerleşimli, baskılı/sıkıştırıcı (nabız eşlik etmeyen) nitelikte saatler içinde sonlanan ve yürüme veya merdiven çıkma gibi rutin fiziksel aktivite ile kötüleşmeyen bir baş ağrısı tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Gerilim tipi başağrısı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012228"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hafif veya orta yoğunlukta devam eden ağrılı, bilateral yerleşimli, baskılı/sıkıştırıcı (nabız eşlik etmeyen) nitelikte saatler içinde sonlanan ve yürüme veya merdiven çıkma gibi rutin fiziksel aktivite ile kötüleşmeyen bir baş ağrısı tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of headache that last hours with continuous pain of mild or moderate intensity, bilateral location, a pressing/tightening (non-pulsating) quality and that is not aggravated by routine physical activity such as walking or climbing stairs.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
