    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007915">
        <obo:IAO_0000115 xml:lang="tr">Bu kornea distrofisi, korneanın posterior sınırlayıcı zarını etkiler ve bu, korneanın derin stromal katmanlarında polimorf plak kalsiyum birikintileri ve genellikle endotelin veziküler lezyonlar ve derin kornea stromasında ödem olarak, karakterize edilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Polimorf posterior korneal distrofi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007915"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bu kornea distrofisi, korneanın posterior sınırlayıcı zarını etkiler ve bu, korneanın derin stromal katmanlarında polimorf plak kalsiyum birikintileri ve genellikle endotelin veziküler lezyonlar ve derin kornea stromasında ödem olarak, karakterize edilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>This corneal dystrophy affects the posterior limiting membrane of the cornea and is characterized by polymorphous plaques of calcium deposits in the deep stromal layers of the cornea, and occasionally by vesicular lesions of the endothelium and edema of the deep corneal stroma.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
