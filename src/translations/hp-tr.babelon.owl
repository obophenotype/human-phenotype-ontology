        <obo:IAO_0000115 xml:lang="tr">Dolaşımda normal bikarbonat, HCO3, konsantrasyonunun anormal bir artışı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Artmış serum bikarbonat konsantrasyonu</rdfs:label>
