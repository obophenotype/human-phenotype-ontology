    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001924">
        <obo:IAO_0000115 xml:lang="tr">Sideroblastik anemi, demirin heme molekülüne dahil edilmesindeki bir bozukluktan kaynaklanır. Bir sideroblast sitoplazmada boyanabilir demir birikimine sahip bir eritroblasttır (bu, Prusya mavisi boyaması ile gösterilebilir)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sideroblastik anemi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001924"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sideroblastik anemi, demirin heme molekülüne dahil edilmesindeki bir bozukluktan kaynaklanır. Bir sideroblast sitoplazmada boyanabilir demir birikimine sahip bir eritroblasttır (bu, Prusya mavisi boyaması ile gösterilebilir)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sideroblastic anemia results from a defect in the incorporation of iron into the heme molecule. A sideroblast is an erythroblast that has stainable deposits of iron in cytoplasm (this can be demonstrated by Prussian blue staining).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
