    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009257">
        <obo:IAO_0000115 xml:lang="tr">Bir psödoepifis, normal epifizden farklı ikincil bir ossifikasyon merkezidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">4. parmak distal falanksının psödoepifizi</rdfs:label>
    </rdf:Description>
