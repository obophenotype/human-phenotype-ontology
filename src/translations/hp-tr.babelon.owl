        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010832">
        <obo:IAO_0000115 xml:lang="tr">Ağrı, hafif, lokalize rahatsızlıktan acıya kadar değişebilen, fiziksel kısmının sinir uyarımından kaynaklandığı, hoşnutsuz bir histir ve genellikle duygusal bir bileşene eşlik eder. Bu terim, ağrı uyarılarını beyne taşıyan spesifik sinir liflerine bağlı anormalliklerden kaynaklandığı düşünülen ağrı hissi anormalliklerini gruplar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ağrı hissi anormalliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010832"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ağrı, hafif, lokalize rahatsızlıktan acıya kadar değişebilen, fiziksel kısmının sinir uyarımından kaynaklandığı, hoşnutsuz bir histir ve genellikle duygusal bir bileşene eşlik eder. Bu terim, ağrı uyarılarını beyne taşıyan spesifik sinir liflerine bağlı anormalliklerden kaynaklandığı düşünülen ağrı hissi anormalliklerini gruplar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pain is an unpleasant sensation that can range from mild, localized discomfort to agony, whereby the physical part of pain results from nerve stimulation and is often accompanied by an emotional component. This term groups abnormalities in pain sensation presumed to result from abnormalities related to the specific nerve fibers that carry the pain impulses to the brain.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010832"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ağrı hissi anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of pain sensation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010833">
        <obo:IAO_0000115 xml:lang="tr">Spontan ağrı tanımlanabilir bir tetikleyici olmadan meydana gelen nöropatik ağrı çeşididir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Spontan ağrı hissi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010833"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Spontan ağrı tanımlanabilir bir tetikleyici olmadan meydana gelen nöropatik ağrı çeşididir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Spontaneous pain is a kind of neuropathic pain which occurs without an identifiable trigger.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
