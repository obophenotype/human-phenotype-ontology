    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011619">
        <obo:IAO_0000115 xml:lang="tr">Her iki akciğerin sol akciğer morfolojisinde olduğu sağ ve sol akciğerlerin morfolojik yanlılığı, yani pulmoner situsun bir anormalliği</obo:IAO_0000115>
