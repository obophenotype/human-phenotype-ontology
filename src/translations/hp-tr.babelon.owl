    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025342">
        <obo:IAO_0000115 xml:lang="tr">Santral retinal arterde kan akımı blokajı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Santral retinal arter tıkanıklığı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025342"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Santral retinal arterde kan akımı blokajı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Blockage of the main artery in the retina. In the acute phase, the fundus may show cherry red spot and stasis of retinal flow. The typical presentation is one of profound monocular visual loss.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
