        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A condition in which superficial veins (i.e., veins just under the skin) are more conspicuous or noticeable than normal.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
