        <owl:annotatedTarget xml:lang="tr">Parantez benzeri forma sahip olan halluksun proksimal falanks epifizi diyafizi çevreler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The epiphysis of the proximal phalanx of the hallux surrounds the diaphysis, having a bracket-like form.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
