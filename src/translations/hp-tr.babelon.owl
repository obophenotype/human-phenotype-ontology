        <obo:IAO_0000115 xml:lang="tr">CD4-negatif, CD8-negatif (çift negatif veya DN), alfa-beta düzenleyici T hücreleri (tregs) toplam T hücrelerinin sayısına göre anormal derecede artmış bir oran</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Alfa/beta şeklinde T hücre reseptörlerini ifade eden CD4-/CD8- T hücrelerinin sayısının artışı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002851"/>
