        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal increase or decrease of the absolute number of cytotoxic CD3+CD8+ T cells (measured the absolute count per volume or as percentage of total CD3+ T cells in the blood), compared to a reference range for a given sex and age-group. These are usually measured within the TCR alpha/beta positive population.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
