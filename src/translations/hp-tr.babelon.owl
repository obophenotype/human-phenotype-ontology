        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025169"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sıklıkla operasyonel olarak yüzde 40&apos;dan daha az ejeksiyon fraksiyonu ile tanımlanan sol ventriküler kontraksiyon anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
