        <owl:annotatedTarget xml:lang="tr">Her bir vücut yarısında iki farklı vücut rengi ile sonuçlanan deri renginde ani bir değişimi içeren Harlequin fenomeni</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
