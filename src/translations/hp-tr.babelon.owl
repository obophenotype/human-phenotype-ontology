    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0040222">
        <obo:IAO_0000115 xml:lang="tr">Annede gebelik esnasında tromboza doğru artan bir eğilim</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Maternal trombofili</rdfs:label>
    </rdf:Description>
