        <babelon:source_value>Spontaneous hemolytic crises</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005526">
        <obo:IAO_0000115 xml:lang="tr">Temel olarak kemik iliğini ve periferal kanı içeren kötü huylu lenfositik B-hücresi veya T-hücresi kökenli neoplazma. Bu kategori prekürsör ya da akut lenfoblastik lösemi ve kronik lösemiyi içerir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Lenfoid lösemi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005526"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Temel olarak kemik iliğini ve periferal kanı içeren kötü huylu lenfositik B-hücresi veya T-hücresi kökenli neoplazma. Bu kategori prekürsör ya da akut lenfoblastik lösemi ve kronik lösemiyi içerir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A malignant lymphocytic neoplasm of B-cell or T-cell lineage involving primarily the bone marrow and the peripheral blood. This category includes precursor or acute lymphoblastic leukemias and chronic leukemias.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005526"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Lenfoid lösemi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Lymphoid leukemia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005527">
        <obo:IAO_0000115 xml:lang="tr">İç kan pıhtılaşma kaskadının temas aşamasında kofaktör olarak işlev gören kininojen miktarında azalma</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Azalmış kininojen aktivitesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005527"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İç kan pıhtılaşma kaskadının temas aşamasında kofaktör olarak işlev gören kininojen miktarında azalma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Amount or activity of kininogen is below the lower limit of normal. Kininogen functions as a cofactor in the contact phase of the intrinsic blood coagulation cascade.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005527"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Azalmış kininojen aktivitesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Reduced kininogen activity</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005528">
        <obo:IAO_0000115 xml:lang="tr">Kemik iliğinde bulunan hematopoetik hücrelerin sayısının azlığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kemik iliği hiposelüleritesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005528"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kemik iliğinde bulunan hematopoetik hücrelerin sayısının azlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduced number of hematopoietic cells present in the bone marrow relative to marrow fat.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005528"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kemik iliği hiposelüleritesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bone marrow hypocellularity</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005531">
        <obo:IAO_0000115 xml:lang="tr">Hem miyeloid hem de lenfoid türlerinin özelliklerine sahip bir çeşit aktuel lösemi. Bu nedenle, bu lösemiler karışık tür hibrid veya bifenotipik akut lösemiler olarak belirlenmiştir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Bifenotipik akut lösemi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005531"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hem miyeloid hem de lenfoid türlerinin özelliklerine sahip bir çeşit aktuel lösemi. Bu nedenle, bu lösemiler karışık tür hibrid veya bifenotipik akut lösemiler olarak belirlenmiştir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of actue leukemia with features characteristic of both the myeloid and lymphoid lineages. These leukemias are for this reason are designated mixed-lineage, hybrid or biphenotypic acute leukemias.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005531"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Bifenotipik akut lösemi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Biphenotypic acute leukemia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005532">
        <rdfs:label xml:lang="tr">Makrositer diseritropoetik anemi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005532"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Makrositer diseritropoetik anemi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Macrocytic dyserythropoietic anemia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005534">
        <obo:IAO_0000115 xml:lang="tr">Trizomi 21 ile bağlantılı eşsiz bir klonal neoplastik bozukluk, yenidoğum dönemiyle sınırlıdır ve kendiliğinden düzelir. Genellikle megakaryositik soyların özelliklerine sahiptir ve miyeloblastlarda GATA1 mutasyonları ile ilişkilidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Geçici miyeloproliferatif sendrom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005534"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Trizomi 21 ile bağlantılı eşsiz bir klonal neoplastik bozukluk, yenidoğum dönemiyle sınırlıdır ve kendiliğinden düzelir. Genellikle megakaryositik soyların özelliklerine sahiptir ve miyeloblastlarda GATA1 mutasyonları ile ilişkilidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A unique clonal neoplastic disorder that is linked to trisomy 21, is restricted to neonatal period, and spontaneously regresses. It often has characteristics of megakaryocytic lineage and is associated with GATA1 mutations in myeloblasts.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005534"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Geçici miyeloproliferatif sendrom</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Transient myeloproliferative syndrome</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005535">
        <obo:IAO_0000115 xml:lang="tr">Çaba ile harekete geçirilebilen bir hemolitik anemi şekli</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Egzersize bağlı hemoliz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005535"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çaba ile harekete geçirilebilen bir hemolitik anemi şekli</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of hemolytic anemia that can be triggered by exertion.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005535"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Egzersize bağlı hemoliz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Exercise-induced hemolysis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005537">
        <obo:IAO_0000115 xml:lang="tr">Normal referans aralığının alt limitinin altında ortalama platelet hacmi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Azalmış ortalama platelet hacmi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005537"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Normal referans aralığının alt limitinin altında ortalama platelet hacmi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Average platelet volume below the lower limit of the normal reference interval.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005537"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Azalmış ortalama platelet hacmi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased mean platelet volume</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005539">
        <obo:IAO_0000115 xml:lang="tr">Kan, kemik iliği ve dokularında çok fazla T hücre lenfoblastının bulunduğu bir çeşit lenfoid lösemi veya lenfoma. Lösemi veya lenfoma sınıflandırılması hangi özelliğin daha belirgin olduğuna bağlıdır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">T hücreli kronik lenfositik lenfoma / lösemi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005539"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kan, kemik iliği ve dokularında çok fazla T hücre lenfoblastının bulunduğu bir çeşit lenfoid lösemi veya lenfoma. Lösemi veya lenfoma sınıflandırılması hangi özelliğin daha belirgin olduğuna bağlıdır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of lymphoid leukemia or lymphoma in which too many T-cell lymphoblasts are found in the blood, bone marrow, and tissues. Leukemia or lymphoma classification depends on which feature is more prominent.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005539"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">T hücreli kronik lenfositik lenfoma / lösemi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>T cell chronic lymphocytic lymphoma/leukemia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005540">
        <obo:IAO_0000115 xml:lang="tr">Anormal şekilde şekillendirilmiş eritrositlerin boynuzlara benzeyen çıkıntılarla sonuçlanan çentiklere sahip olduğu bir poikilositoz şekli</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kırmızı kan hücresi keratositozu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005540"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Anormal şekilde şekillendirilmiş eritrositlerin boynuzlara benzeyen çıkıntılarla sonuçlanan çentiklere sahip olduğu bir poikilositoz şekli</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of poikilocytosis in which the abnormally shaped erythrocytes have notches that results in projections that look like horns</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005540"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Kırmızı kan hücresi keratositozu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>obsolete Red blood cell keratocytosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005541">
        <obo:IAO_0000115 xml:lang="tr">Granülosit sayısındaki belirgin azalmanın doğuştan başlangıcı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Konjenital agranülositoz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005541"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Granülosit sayısındaki belirgin azalmanın doğuştan başlangıcı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Persistent absence of detectable circulating granulocytes in the blood with no detected secondary cause. Usually a value of less than 50 granulocytes per microliter is considered to be an absence.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005541"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Konjenital agranülositoz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Congenital agranulocytosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005542">
        <obo:IAO_0000115 xml:lang="tr">Tam kanın görünür bir pıhtı oluşturması için gereken sürede anormal bir uzama (gecikme)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Uzamış tam kan pıhtılaşma süresi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005542"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Tam kanın görünür bir pıhtı oluşturması için gereken sürede anormal bir uzama (gecikme)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal prolongation (delay) in the time required by whole blood to produce a visible clot.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005542"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Uzamış tam kan pıhtılaşma süresi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Prolonged whole-blood clotting time</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005543">
        <obo:IAO_0000115 xml:lang="tr">K vitamini bağımlı C proteininin konsantrasyonunun azalmasına bağlı pıhtılaşma anormaliği. C proteini, trombomodulin&apos;e bağlı trombiniyle Ca proteinini aktive edilir. Aktive edilmiş C proteini VIIIa ve Va faktörlerini indirgemektedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Azalmış protein C aktivitesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005543"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">K vitamini bağımlı C proteininin konsantrasyonunun azalmasına bağlı pıhtılaşma anormaliği. C proteini, trombomodulin&apos;e bağlı trombiniyle Ca proteinini aktive edilir. Aktive edilmiş C proteini VIIIa ve Va faktörlerini indirgemektedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of coagulation related to a decreased concentration of vitamin K-dependent protein C. Protein C is activated to protein Ca by thrombin bound to thrombomodulin. Activated protein C degrades factors VIIIa and Va.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005543"/>
