        <babelon:source_value>Irregular epiphysis of the proximal phalanx of the thumb</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009670">
        <obo:IAO_0000115 xml:lang="tr">El baş parmağının proksimal falanksının epifizinin sklerosu, X-rayde artmış radyoopaklık (beyaz ve fil dişi görünüm) derecesine sebep olur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Baş parmağın proksimal falanksının fildişi epifizi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009670"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">El baş parmağının proksimal falanksının epifizinin sklerosu, X-rayde artmış radyoopaklık (beyaz ve fil dişi görünüm) derecesine sebep olur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sclerosis of the epiphysis of the proximal phalanx of the thumb, leading to an increased degree of radiopacity (white or ivory appearance) in X-rays.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009670"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Baş parmağın proksimal falanksının fildişi epifizi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ivory epiphysis of the proximal phalanx of the thumb</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009671">
        <obo:IAO_0000115 xml:lang="tr">El baş parmağının proksimal falanksının psödoepifizi (normal epifizden ayrı ikincil osifikasyon merkezi)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">El baş parmağının proksimal falanksının psödoepifizi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009671"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">El baş parmağının proksimal falanksının psödoepifizi (normal epifizden ayrı ikincil osifikasyon merkezi)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A pseudoepiphysis (which is a secondary ossification center distinct from the normal epiphysis) of the proximal phalanx of the thumb.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009671"/>
