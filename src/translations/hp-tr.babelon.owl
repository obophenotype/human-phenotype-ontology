        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">3. el parmağının eklem kontraktürü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Joint contracture of the 3rd finger</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009320">
        <obo:IAO_0000115 xml:lang="tr">3. parmağın proksimal, orta ve distal falanjlarının bir veya tüm epifizlerinde anormallik</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">3. el parmak epifizlerinin anormalliği</rdfs:label>
