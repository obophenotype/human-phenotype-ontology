        <owl:annotatedTarget xml:lang="tr">Retina üzerinde çeşitli boyutta ve konfigürasyonda vasküler lezyon ile ilgili olmayan çoklu sarımsı-beyaz lezyonların varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
