        <owl:annotatedTarget xml:lang="tr">Pnömokoklara karşı yönlendirilen spesifik immünoglobülin eksikliği ile normal toplam immünoglobülin seviyelerinin varlığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The concentration in the blood circulation of specific immunoglobulins directed against pneumococci is below the lower limit of normal.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
