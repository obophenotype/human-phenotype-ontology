    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001829">
        <obo:IAO_0000115 xml:lang="tr">Fazladan bir ayak parmağı ya da parmaklarının varlığı olarak nitelendirilen bir polidaktili türü</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ayak polidaktilisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001829"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Fazladan bir ayak parmağı ya da parmaklarının varlığı olarak nitelendirilen bir polidaktili türü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A kind of polydactyly characterized by the presence of a supernumerary toe or toes.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001829"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ayak polidaktilisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Foot polydactyly</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001830">
        <obo:IAO_0000115 xml:lang="tr">Ayak polidaktilisi en yaygın olarak bir ayakta altı parmağın varlığını ifade eder. Postaksiyel polidaktili yan uzanımı ve duplikasyon boğumlu düzgün biçimli bir parmaktan tam gelişmemiş bir parmağa kadar değişebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Postaksiyel ayak polidaktilisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001830"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ayak polidaktilisi en yaygın olarak bir ayakta altı parmağın varlığını ifade eder. Postaksiyel polidaktili yan uzanımı ve duplikasyon boğumlu düzgün biçimli bir parmaktan tam gelişmemiş bir parmağa kadar değişebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Polydactyly of the foot most commonly refers to the presence of six toes on one foot. Postaxial polydactyly affects the lateral ray and the duplication may range from a well-formed articulated digit to a rudimentary digit.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001830"/>
