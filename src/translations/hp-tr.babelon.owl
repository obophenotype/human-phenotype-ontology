    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031398">
        <obo:IAO_0000115 xml:lang="tr">Toplam T hücrelerinin sayısı ile ilişkili naif T hücrelerinin anormal bir artış oranı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Saf T hücrelerinin artmış oranı</rdfs:label>
