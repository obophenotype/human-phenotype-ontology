    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0045063">
        <obo:IAO_0000115 xml:lang="tr">Des-gamma karboksiprotrombin (DCP) veya K vitamini yokluğu ile indüklenen pro-trombin-II (PIVKA-II), HCC&apos;li hastaların serumunda artan anormal bir protrombin proteinidir. DCP&apos;nin üretilmesinin habis hücrelerdeki protrombin prekürsörünün post-translasyonel karboksilasyonundaki kazanılmış bir kusurun bir sonucu olduğu düşünülmektedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Artmış PIVKA-II</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0045063"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Des-gamma karboksiprotrombin (DCP) veya K vitamini yokluğu ile indüklenen pro-trombin-II (PIVKA-II), HCC&apos;li hastaların serumunda artan anormal bir protrombin proteinidir. DCP&apos;nin üretilmesinin habis hücrelerdeki protrombin prekürsörünün post-translasyonel karboksilasyonundaki kazanılmış bir kusurun bir sonucu olduğu düşünülmektedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Des-gamma carboxyprothrombin (DCP) or pro-thrombin induced by vitamin K absence-II (PIVKA-II) is an abnormal prothrombin protein that is increased in the serum of patients with HCC. Generation of DCP is thought to be a result of an acquired defect in the post- translational carboxylation of the prothrombin precursor in malignant cells.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0045063"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Artmış PIVKA-II</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased PIVKA-II</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
