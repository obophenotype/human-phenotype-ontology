    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002464">
        <obo:IAO_0000115 xml:lang="tr">Piramidal ve ekstrapiramidal yolların üst motor nöron yollarının bilateral harabiyeti ile ialakalı bir dizartri tipidir. Etkilenen kişilerin konuşması yavaş, çabalı ve sert bir ses kalitesine sahiptir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Spastik disartri</rdfs:label>
    </rdf:Description>
