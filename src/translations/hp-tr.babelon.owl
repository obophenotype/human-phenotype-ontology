    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002521">
        <obo:IAO_0000115 xml:lang="tr">Hiparitmi, anormal interiktal yüksek genlikli dalgaların ve düzensiz sivriliklerin arka planıdır. Organize olmayan arka plan sürekli genetiği (&gt;200 Hz) genelleştirilmiş polimorfik yavaşlama ve elektroensefalografi (EEG) ile sürekli olarak belirtilen çok odaklı sivri uçlardır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hipsiaritmi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002521"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hiparitmi, anormal interiktal yüksek genlikli dalgaların ve düzensiz sivriliklerin arka planıdır. Organize olmayan arka plan sürekli genetiği (&gt;200 Hz) genelleştirilmiş polimorfik yavaşlama ve elektroensefalografi (EEG) ile sürekli olarak belirtilen çok odaklı sivri uçlardır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypsarrhythmia is abnormal interictal high amplitude waves and a background of irregular spikes. There is continuous (during wakefulness), high-amplitude (&gt;200 Hz), generalized polymorphic slowing with no organized background and multifocal spikes demonstrated by electroencephalography (EEG).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002521"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hipsiaritmi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hypsarrhythmia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
