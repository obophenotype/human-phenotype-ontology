        <owl:annotatedTarget xml:lang="tr">Kemiksi olmayan dokuda yapısal değişiklikler yüzünden 4. parmağın distal metakarpofalanksiyal ekleminde kronik eklem hareketi kaybı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
