    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012690">
        <obo:IAO_0000115 xml:lang="tr">Talamusun manyetik rezonans görüntülemesinde (MRG) beklenenden daha koyu T2 sinyali. Bu terim, talamusun tümünü etkileyen yaygın bir hipointensiteye işaret etmektedir</obo:IAO_0000115>
