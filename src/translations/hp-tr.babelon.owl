        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Burun boşluğunu ve larinksi, trakeayı ve bronşları içeren iletici havayolu kısmının çoğunu kapatan yalancı katmanlı siliyalı epitelyumun herhangi yapısal bir anomalisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any structural anomaly of the pseudostratified ciliated epithelium that lines much of the conducting portion of the airway, including part of the nasal cavity and larynx, the trachea, and bronchi.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012253"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal solunum epiteli morfolojisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal respiratory epithelium morphology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012254">
        <obo:IAO_0000115 xml:lang="tr">Sıklıkla silindirik kemiklerde meydana gelen, her zaman medüller dokudan köken alan malignan bir kemik tümörü</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ewing sarkomu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012254"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sıklıkla silindirik kemiklerde meydana gelen, her zaman medüller dokudan köken alan malignan bir kemik tümörü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A malignant tumor of the bone which always arises in the medullary tissue, occurring more often in cylindrical bones.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012254"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ewing sarkomu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Ewing sarcoma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012255">
        <obo:IAO_0000115 xml:lang="tr">Motil siliyanın dineyin kollarının bir anomalisi. Bu özellik genellikle elektron mikroskobi ile anlaşılabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Respiratuar motil siliyanın dineyin kol defekti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012255"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Motil siliyanın dineyin kollarının bir anomalisi. Bu özellik genellikle elektron mikroskobi ile anlaşılabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly of the dynein arms of motile cilia. This feature is usually appreciated by electron microscopy.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012255"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Respiratuar motil siliyanın dineyin kol defekti</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Dynein arm defect of respiratory motile cilia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012256">
        <obo:IAO_0000115 xml:lang="tr">Normalde motil siliyanın periferik mikrotübüllerinin dışında yerleşmiş respiratuvar motil siliyanın dış dineyin kollarının yokluğu. Bu özellik genellikle elektron mikroskobi ile anlaşılabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dış dineyin kolları yokluğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012256"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Normalde motil siliyanın periferik mikrotübüllerinin dışında yerleşmiş respiratuvar motil siliyanın dış dineyin kollarının yokluğu. Bu özellik genellikle elektron mikroskobi ile anlaşılabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of the outer dynein arms of respiratory motile cilia, which normally are situated outside of the peripheral microtubules of motile cilia. This feature is usually appreciated by electron microscopy.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012256"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Dış dineyin kolları yokluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absent outer dynein arms</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012257">
        <obo:IAO_0000115 xml:lang="tr">Normalde motil siliyanın periferik mikrotübüllerinin içinde yerleşmiş respiratuvar motil siliyanın dış dineyin kollarının yokluğu. Bu özellik genellikle elektron mikroskobi ile anlaşılabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İç dineyin kolları yokluğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012257"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Normalde motil siliyanın periferik mikrotübüllerinin içinde yerleşmiş respiratuvar motil siliyanın dış dineyin kollarının yokluğu. Bu özellik genellikle elektron mikroskobi ile anlaşılabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absence of the inner dynein arms of respiratory motile cilia, which normally are situated within the peripheral microtubules of motile cilia. This feature is usually appreciated by electron microscopy.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012257"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">İç dineyin kolları yokluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absent inner dynein arms</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012258">
        <obo:IAO_0000115 xml:lang="tr">Hareketli siliyumun iç çekirdeğini oluşturan ve hareketli siliyanın dineyin kollari ile çivilenmiş standart 9+2 mikrotübüler paterni gösteren hücre iskelet yapısı olan aksonem yapılarının anormal düzenlenmesi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Respiratuvar motil siliyanın anormal aksonemal organizasyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012258"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hareketli siliyumun iç çekirdeğini oluşturan ve hareketli siliyanın dineyin kollari ile çivilenmiş standart 9+2 mikrotübüler paterni gösteren hücre iskelet yapısı olan aksonem yapılarının anormal düzenlenmesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal arrangement of the structures of the axoneme, which is the cytoskeletal structure that forms the inner core of the motile cilium and displays a canonical 9+2 microtubular pattern of motile cilia studded with dynein arms.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012258"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Respiratuvar motil siliyanın anormal aksonemal organizasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal axonemal organization of respiratory motile cilia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012259">
        <obo:IAO_0000115 xml:lang="tr">Solunumla ilgilenen hareketli siliyanın dinein kollarının tamamen eksikliği. Yani, iç ve dış dinein kollarının olmaması, bu da normalde hareketli siliyanın çevresel mikrotübülleri içerisinde ve dışında bulunmaktadır. Bu özellik, genellikle elektron mikroskobu ile değerlendirilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İç ve dış dineyin kolları yok</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012259"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Solunumla ilgilenen hareketli siliyanın dinein kollarının tamamen eksikliği. Yani, iç ve dış dinein kollarının olmaması, bu da normalde hareketli siliyanın çevresel mikrotübülleri içerisinde ve dışında bulunmaktadır. Bu özellik, genellikle elektron mikroskobu ile değerlendirilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Complete absence of the dynein arms of respiratory motile cilia, that is, absence of the inner and the outer dynein arms, which normally are situated inside and outside of the peripheral microtubules of motile cilia. This feature is usually appreciated by electron microscopy.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012259"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">İç ve dış dineyin kolları yok</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Absent inner and outer dynein arms</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012260">
        <obo:IAO_0000115 xml:lang="tr">Hareketli siliyanın 9+2 mikrotübüler konfigürasyonlu iki merkezi mikrotübülünün yapısal bir anomalisi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Respiratuar motil siliyanın anormal santral mikrotübüler çift morfolojisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012260"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hareketli siliyanın 9+2 mikrotübüler konfigürasyonlu iki merkezi mikrotübülünün yapısal bir anomalisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A structural anomaly of the two central microtubules of motile cilia with a 9+2 microtubuluar configuration.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012260"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Respiratuar motil siliyanın anormal santral mikrotübüler çift morfolojisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal central microtubular pair morphology of respiratory motile cilia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012261">
        <obo:IAO_0000115 xml:lang="tr">Respiratuvar motil siliyanın herhangi bir fonksiyonel anomalisi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal solunum hareketli siliyum fizyolojisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012261"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Respiratuvar motil siliyanın herhangi bir fonksiyonel anomalisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any functional anomaly of the respiratory motile cilia.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012261"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal solunum hareketli siliyum fizyolojisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal respiratory motile cilium physiology</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012262">
        <obo:IAO_0000115 xml:lang="tr">Hareketli siliyanın normal hareketliliğinin herhangi bir anomalisi. Siliyer vuru frekansı değerlendirmesi ve siliyer vuru paterni kültür besiyerinde kontrol edilmiş koşullarda bakılan taze elde edilmiş siliyer biyopsilerin yüksek hızlı videomikroskobisine ihtiyaç duyar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal siliyer hareketliliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012262"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Hareketli siliyanın normal hareketliliğinin herhangi bir anomalisi. Siliyer vuru frekansı değerlendirmesi ve siliyer vuru paterni kültür besiyerinde kontrol edilmiş koşullarda bakılan taze elde edilmiş siliyer biyopsilerin yüksek hızlı videomikroskobisine ihtiyaç duyar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any anomaly of the normal motility of motile cilia. Evaluation of ciliary beat frequency and ciliary beat pattern requires high-speed videomicroscopy of freshly obtained ciliary biopsies that are maintained in culture media under controlled conditions.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012262"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal siliyer hareketliliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal ciliary motility</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012263">
