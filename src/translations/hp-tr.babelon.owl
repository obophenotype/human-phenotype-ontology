    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031291">
        <obo:IAO_0000115 xml:lang="tr">İktiyozis folikülaris yaygın, inflamutvar olmayan, diken benzeri foliküler uzantılar ile karakterizedir. Diskeratotik papüller ekstansör ekstremiteler ve kafa derisi üzerinde belirgindir ve simetrik olarak dağılmıştır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İktiyozis folikülaris</rdfs:label>
