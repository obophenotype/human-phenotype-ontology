    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002756">
        <obo:IAO_0000115 xml:lang="tr">Patolojik bir kırık, bir tümör, enfeksiyon ve belirli kalıtsal kemik bozuklukları gibi başka bir hastalık sürecinde ikincil olarak zayıflayan bir bölgede kırıldığında ortaya çıkar. Sağlıklı bir kemikte kırılmaya sebep olmak için travma derecesi olmadan patolojik bir kırılma meydana gelebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Patolojik kırık</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002756"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Patolojik bir kırık, bir tümör, enfeksiyon ve belirli kalıtsal kemik bozuklukları gibi başka bir hastalık sürecinde ikincil olarak zayıflayan bir bölgede kırıldığında ortaya çıkar. Sağlıklı bir kemikte kırılmaya sebep olmak için travma derecesi olmadan patolojik bir kırılma meydana gelebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A pathologic fracture occurs when a bone breaks in an area that is weakened secondarily to another disease process such as tumor, infection, and certain inherited bone disorders. A pathologic fracture can occur without a degree of trauma required to cause fracture in healthy bone.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002756"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Patolojik kırık</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pathologic fracture</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
