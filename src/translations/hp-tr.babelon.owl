    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011861">
        <obo:IAO_0000115 xml:lang="tr">Her iki akciğer üç loba sahiptir. Normal olarak sol akciğer iki loba sahipken sağ akciğer üç loba sahiptir</obo:IAO_0000115>
