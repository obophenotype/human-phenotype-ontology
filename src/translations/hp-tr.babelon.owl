    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002870">
        <obo:IAO_0000115 xml:lang="tr">Solunum yolunda tıkanıklık ve uyku esnasında gece boyunca birçok kez solunumun durmasıyla karakterize edilen bir durumdur. Obstrüktif uyku apnesi solunum yolunda yumuşak dokuların kısmi çöküşüne yol açan kas tonusunun gevşemesi (normalde uyku esnasında olur) olayı ile ilgilidir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Obstrüktif uyku apnesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002870"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Solunum yolunda tıkanıklık ve uyku esnasında gece boyunca birçok kez solunumun durmasıyla karakterize edilen bir durumdur. Obstrüktif uyku apnesi solunum yolunda yumuşak dokuların kısmi çöküşüne yol açan kas tonusunun gevşemesi (normalde uyku esnasında olur) olayı ile ilgilidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Obstructive Sleep Apnea is a condition characterized by the obstruction of the airway and pauses in breathing during sleep, which occur multiple times throughout the night. It is related to the relaxation of muscle tone that typically happens during sleep, leading to a partial collapse of the soft tissues in the airway and causing airflow obstruction.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002870"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Obstrüktif uyku apnesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Obstructive sleep apnea</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002871">
        <obo:IAO_0000115 xml:lang="tr">Medulla oblongata&apos;daki solunum merkezlerinin depresyonundan kaynaklanan apne. Hava akışının engellenmesi yerine solunum eksikliği olması</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Santral apne</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002871"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Medulla oblongata&apos;daki solunum merkezlerinin depresyonundan kaynaklanan apne. Hava akışının engellenmesi yerine solunum eksikliği olması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Apnea resulting from depression of the respiratory centers in the medulla oblongata. There is a lack of respiratory effort rather than obstruction of airflow.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
