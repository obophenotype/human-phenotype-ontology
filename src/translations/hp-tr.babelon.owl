    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030365">
        <obo:IAO_0000115 xml:lang="tr">Sezaryen seksiyon sonrası vajinal doğum (SSVD) önceden Sezaryen doğum yapmış annenin şimdi vajinal olarak doğum yaptığına işaret eden bir durumdur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sezeryan sonrası vajinal doğum</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
