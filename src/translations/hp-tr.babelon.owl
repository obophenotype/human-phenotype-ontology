    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011636">
        <obo:IAO_0000115 xml:lang="tr">Koroner arter kökenlerinin izole anomalileri. Bu diğer yapısal kalp anomalileri ile ilişkili olabilir fakat koroner arterlerin anormal seyri ile sonuçlanan kompleks yapısal kalp malformasyonları paterni ile değil</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal koroner arter kökeni</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
