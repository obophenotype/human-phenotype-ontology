        <babelon:source_value>Expressive aphasia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002435">
        <obo:IAO_0000115 xml:lang="tr">Menenjlerin vertebral kolon kusuru ile çıkıntısı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Meningosel</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002435"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
