    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100301">
        <obo:IAO_0000115 xml:lang="tr">Membranöz inklüzyonlar olarak ortaya çıkan, sarkoplazmik retikülum ve mitokondri membranlarından köken almış, çeşitli enzimatik aktiviteli muhtelif proteinleri içeren, tübüler kümelenmeler olarak bilinen yoğun bir biçimde paketlenmiş membranöz tübüllerin alışılmamış bölgeleri</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kas lifi tübüler inklüzyonları</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100301"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Membranöz inklüzyonlar olarak ortaya çıkan, sarkoplazmik retikülum ve mitokondri membranlarından köken almış, çeşitli enzimatik aktiviteli muhtelif proteinleri içeren, tübüler kümelenmeler olarak bilinen yoğun bir biçimde paketlenmiş membranöz tübüllerin alışılmamış bölgeleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Unusual regions of densely packed membranous tubules known as tubular aggregates which present as membranous inclusions, derived from membranes of sarcoplasmic reticulum and mitochondria, containing miscellaneous proteins with a variety of enzymatic activities.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
