        <babelon:source_value>Primary peritoneal carcinoma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030407">
        <obo:IAO_0000115 xml:lang="tr">Olgun iyi farklılaşmış bir tümör (WHO derece I) olan pineal parenkimal hücre neoplazmı tipi</obo:IAO_0000115>
