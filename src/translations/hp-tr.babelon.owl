    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003185">
        <obo:IAO_0000115 xml:lang="tr">Kemik pelvisindeki sakroiliak eklem, güçlü ligamentler ile birleştirilen sakrum ve pelvis ilyasını birbirine bağlar. Çentik, eklemin doğrudan üstünde bulunur. Bu terim, çentiğin yüksekliğinde bir azalmaya işaret eder</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kısa sakroiliyak çentik</rdfs:label>
    </rdf:Description>
