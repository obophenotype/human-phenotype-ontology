    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010001">
        <obo:IAO_0000115 xml:lang="tr">Elin bir veya daha fazla distal falankslarını etkileye tamamen duplikasyon</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Elin distal falankslarının tamamen duplikasyonu</rdfs:label>
    </rdf:Description>
