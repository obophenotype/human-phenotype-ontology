    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005110">
        <obo:IAO_0000115 xml:lang="tr">Yüzey EKG&apos;sinde ayrı P dalgaları olmaksızın düzensiz atriyal aktivite ile karakterize edilen atriyal aritminin yerine, dalgalı bir taban çizgisi veya değişen genlikteki daha keskin sınırlanmış atriyal defleksiyonları dakikada 350-600 aralığında değişen bir frekansla karakterizedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Atriyal fibrilasyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005110"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Yüzey EKG&apos;sinde ayrı P dalgaları olmaksızın düzensiz atriyal aktivite ile karakterize edilen atriyal aritminin yerine, dalgalı bir taban çizgisi veya değişen genlikteki daha keskin sınırlanmış atriyal defleksiyonları dakikada 350-600 aralığında değişen bir frekansla karakterizedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An atrial arrhythmia characterized by disorganized atrial activity without discrete P waves on the surface EKG, but instead by an undulating baseline or more sharply circumscribed atrial deflections of varying amplitude an frequency ranging from 350 to 600 per minute.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
