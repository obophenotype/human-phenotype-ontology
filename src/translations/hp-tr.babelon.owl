        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Beyin omurilik sıvısı (BOS) albumin konsantrasyonunun serum albumin konsantrasyonuna oranının normal sınırların altına olan bir düşüş</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduction below normal limits of the ratio of the cerebrospinal fluid (CSF) albumin concentration to serum albumin concentration.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
