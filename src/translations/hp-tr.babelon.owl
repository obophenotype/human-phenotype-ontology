    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012047">
        <obo:IAO_0000115 xml:lang="tr">Parlak ışıkta loş ışıkta olduğundan daha berrak görme yeteneğinin kaybedilmesi ile karakterize bir görsel defekt. Hemeralopia kelime manası olarak gündüz körlüğü demektir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hemeralopi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012047"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Parlak ışıkta loş ışıkta olduğundan daha berrak görme yeteneğinin kaybedilmesi ile karakterize bir görsel defekt. Hemeralopia kelime manası olarak gündüz körlüğü demektir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A visual defect characterized by the inability to see as clearly in bright light as in dim light. The word hemeralopia literally means day blindness.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012047"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Hemeralopi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hemeralopia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012048">
        <obo:IAO_0000115 xml:lang="tr">Ağzı açmada ve kapamada zorluğa sebep olan ve sıklıkla çiğneme ve konuşmayı etkileyen, güçlü yüz, çene ve/veya dil kontraksiyonları ile karakterize bir fokal distoni türü</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Oromandibüler distoni</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012048"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Ağzı açmada ve kapamada zorluğa sebep olan ve sıklıkla çiğneme ve konuşmayı etkileyen, güçlü yüz, çene ve/veya dil kontraksiyonları ile karakterize bir fokal distoni türü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A kind of focal dystonia characterized by forceful contractions of the face, jaw, and/or tongue causing difficulty in opening and closing the mouth and often affecting chewing and speech.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012048"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Oromandibüler distoni</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Oromandibular dystonia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012049">
        <obo:IAO_0000115 xml:lang="tr">Konuşma kesilmesine yol açan ve ses kalitesini etkileyen ve sıklıkla konuşmada biçimli tekrarlı kesilmelere yol açan, vokal kordların istemsiz kasılmalari ile ilişkili vokal kordları etkileyen bir fokal distoni formu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Laringeyal distoni</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012049"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Konuşma kesilmesine yol açan ve ses kalitesini etkileyen ve sıklıkla konuşmada biçimli tekrarlı kesilmelere yol açan, vokal kordların istemsiz kasılmalari ile ilişkili vokal kordları etkileyen bir fokal distoni formu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A form of focal dystonia that affects the vocal cords, associated with involuntary contractions of the vocal cords causing interruptions of speech and affecting the voice quality and often leading to patterned, repeated breaks in speech.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
