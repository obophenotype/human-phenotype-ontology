    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032220">
        <obo:IAO_0000115 xml:lang="tr">Portal inflamatuvar hücrelerin portal kanal ve karaciğer parankimi arasındaki sınırlayan plaka boyunca uzanan mononükleer hücre infiltratı ile karakterize karaciğer inflamasyonu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Arayüz hepatiti</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032220"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Portal inflamatuvar hücrelerin portal kanal ve karaciğer parankimi arasındaki sınırlayan plaka boyunca uzanan mononükleer hücre infiltratı ile karakterize karaciğer inflamasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Inflammation of the liver characterized by a mononuclear cell infiltrate whereby portal inflammatory cells extend through the limiting plate between the portal tract and liver parenchyma.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
