        <owl:annotatedTarget xml:lang="tr">Oftalmopleji, göz hareketini kontrol eden kaslardan birinin veya daha fazlasının güçlüğü ve felcidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
