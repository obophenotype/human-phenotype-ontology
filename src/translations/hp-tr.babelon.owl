        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A benign peripheral nerve sheath tumor that generally appears as a soft, skin-colored papule or small subcutaneous nodule. Individuals with neurofibromatosis can have numerous neurofibromas.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
