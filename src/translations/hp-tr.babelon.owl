        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500075">
        <obo:IAO_0000115 xml:lang="tr">İki gözden görsel girdi dengesinde bir değişiklik ile tek olarak getirilen akomodasyon ile ilişkisiz yatay oküler hizalanmada bir değişiklik</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ayrışmış yatay sapma</rdfs:label>
