        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100284">
        <obo:IAO_0000115 xml:lang="tr">Genlik ve frekansta çeşitlilik gösteren, saniyede 150&apos;den 20&apos;ye kadar düşen ateşleme sıklığı değişimi ile birlikte sürekli artan ve azalan ve tıpkı bir bombardıman uçağı gibi bir ses üreten elektromiyografi&apos;de (EMG) yüksek sıklıklı boşaltımlar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">EMG: miyotonik boşaltım</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100284"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Genlik ve frekansta çeşitlilik gösteren, saniyede 150&apos;den 20&apos;ye kadar düşen ateşleme sıklığı değişimi ile birlikte sürekli artan ve azalan ve tıpkı bir bombardıman uçağı gibi bir ses üreten elektromiyografi&apos;de (EMG) yüksek sıklıklı boşaltımlar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>High frequency discharges in electromyography (EMG) that vary in amplitude and frequency, waxing and waning continuously with firing frequencies ranging from 150/second down to 20/second and producing a sound that has been referred to as a dive bomber sound.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100284"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
