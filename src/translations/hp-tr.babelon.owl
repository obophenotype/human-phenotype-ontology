        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Pulmoner YÇBT&apos;de bileşik kistik ve buzlu cam paterni</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Combined cystic and ground-glass pattern on pulmonary HRCT</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025396">
        <obo:IAO_0000115 xml:lang="tr">Pulmoner yüksek çözünürlüklü bilgisayarlı tomografide gözlendiği üzre parenkimal yıkıma ve azalmış perfüzyona ve pulmoner damarlanma sönümlenmesine karşılık gelen düşük yoğunluk alanları</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Pulmoner YÇBT&apos;de azalmış sönümlenme paterni</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025396"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Pulmoner yüksek çözünürlüklü bilgisayarlı tomografide gözlendiği üzre parenkimal yıkıma ve azalmış perfüzyona ve pulmoner damarlanma sönümlenmesine karşılık gelen düşük yoğunluk alanları</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Areas of low density corresponding to parenchymal destruction and reduced perfusion, and attenuation of the pulmonary vasculature, as visualized on pulmonary high-resolution computed tomography.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
