    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012218">
        <obo:IAO_0000115 xml:lang="tr">Epitelyal hücreleri andıran ve alveolda bağ dokusu ile çevrelenmiş sarkoma hücreleri gruplarını çevreleyen ağsı fibröz stromadan dolayı alveolleri andıran histolojik görünümlü bir yumuşak doku sarkoma tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Alveolar yumuşak kısım sarkomu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012218"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Epitelyal hücreleri andıran ve alveolda bağ dokusu ile çevrelenmiş sarkoma hücreleri gruplarını çevreleyen ağsı fibröz stromadan dolayı alveolleri andıran histolojik görünümlü bir yumuşak doku sarkoma tipi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of soft tissue sarcoma with a histological appearance reminiscent of alveoli because of its reticulated fibrous stroma enclosing groups of sarcoma cells, which resemble epithelial cells and are enclosed in alveoli walled with connective tissue.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
