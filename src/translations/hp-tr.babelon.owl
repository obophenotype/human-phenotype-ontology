    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000280">
        <obo:IAO_0000115 xml:lang="tr">Sıklıkla yuvarlak ve ağır görünümlerinden veya kalınlaşmış deri ile birlikte olabilen subkutanöz ve kemik dokusu kalınlaşması nedeniyle olan kaşların, burnun, dudakların, ağzın ve çenenin ince ve keskin görüntüsünün yokluğu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kaba yüz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
