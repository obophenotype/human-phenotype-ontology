    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025613">
        <obo:IAO_0000115 xml:lang="tr">Nöbet başlangıcnda, ruh halinde veya duyguda değişimler veya öznel duygu olmadan değişmiş duygu görünümü ile karakterize fokal başlangıçlı bir nöbet tipi. Bu duygusal nöbetler gözlemciye belli bir nöbetin nesnel klinik bulgusu ile veya olmadan meydana gelebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fokal duygusal nöbet</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025613"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Nöbet başlangıcnda, ruh halinde veya duyguda değişimler veya öznel duygu olmadan değişmiş duygu görünümü ile karakterize fokal başlangıçlı bir nöbet tipi. Bu duygusal nöbetler gözlemciye belli bir nöbetin nesnel klinik bulgusu ile veya olmadan meydana gelebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Seizures presenting with an emotion or the appearance of having an emotion as an early prominent feature, such as fear, spontaneous joy or euphoria, laughing (gelastic), or crying, (dacrystic). These emotional seizures may occur with or without objective clinical signs of a seizure evident to the observer.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025613"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Fokal duygusal nöbet</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Focal emotional seizure</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030000">
        <obo:IAO_0000115 xml:lang="tr">Çalışılan sinir elektriksel olarak altı, on defa 2 veya 3 Herz&apos;te uyarıldığında elektromyografide gözlenen anormallik</obo:IAO_0000115>
