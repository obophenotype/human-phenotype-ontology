    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0008682">
        <obo:IAO_0000115 xml:lang="tr">Renal tübüler hücrelerin akut ölümleri genellikle uzun süreli böbrek iskemisi, nefrotoksinler veya sepsis sonucu ortaya çıkar. Akut tübüler nekrozun klinik gidişi başlangıç, bakım ve iyileşme safhalarına bölünebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Akut tübüler nekroz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0008682"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Renal tübüler hücrelerin akut ölümleri genellikle uzun süreli böbrek iskemisi, nefrotoksinler veya sepsis sonucu ortaya çıkar. Akut tübüler nekrozun klinik gidişi başlangıç, bakım ve iyileşme safhalarına bölünebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Coagulative necrosis of tubular epithelial cells, defined as cells with increased cytoplasmic eosinophilia and nucleus that has a condensed chromatin pattern with fuzzy nuclear contour or has barely visible nuclear basophilic staining. The extent of cortical tubular necrosis is scoredsemiquantitatively as none, mild (less than 25% tubules with necrosis), moderate (25-50 percent), and severe (over 50%).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0008682"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Akut tübüler nekroz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Renal tubular epithelial necrosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
