        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010023">
        <obo:IAO_0000115 xml:lang="tr">1. metakarpal epifizlerinin yaşa bağlı normlara göre anormal küçük boyutu</obo:IAO_0000115>
