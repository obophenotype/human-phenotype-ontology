    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000919">
        <obo:IAO_0000115 xml:lang="tr">Konstakondral bileşkenin bir anomalisi. Kostakondral bileşkeler kaburgaların distal kısımları ve kaburgaları sternuma bağlayan hyalin kıkırdak çubukları olan kostal kıkırdak arasında yer alır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Kostokondral bileşke anormalliği</rdfs:label>
    </rdf:Description>
