        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025351">
        <obo:IAO_0000115 xml:lang="tr">Genellikle pullanma, maserasyon ve kaşınma ile ortaya çıkan parmaklar veya ayak parmakları arasında yer alan tekrarlayan mantar enfeksiyonları öyküsü. Ayak parmakları ellerden daha sık etkilenir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tekrarlayan parmaklar arası mikoz</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025351"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Genellikle pullanma, maserasyon ve kaşınma ile ortaya çıkan parmaklar veya ayak parmakları arasında yer alan tekrarlayan mantar enfeksiyonları öyküsü. Ayak parmakları ellerden daha sık etkilenir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A history of repeated fungal infections located between the fingers or toes, usually manifested by scaling, maceration, and itching. The toes are more commonly affected than the fingers.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025351"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Tekrarlayan parmaklar arası mikoz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Recurrent interdigital mycosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025352">
        <obo:IAO_0000115 xml:lang="tr">Fertilizasyona katılan gametin bir mutasyonuna ilişkindir. Ortaya çıkan organizmanın tüm hücreleri bundan etkilenecektir ve varyant sonraki nesle geçirilebilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Otosomal baskın germ hattı de novo mutasyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025352"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Fertilizasyona katılan gametin bir mutasyonuna ilişkindir. Ortaya çıkan organizmanın tüm hücreleri bundan etkilenecektir ve varyant sonraki nesle geçirilebilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Description of conditions that are exclusively or predominantly observed to display de novo variants. In some cases, this may be due to the limited reproductive fitness of affected individuals.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025352"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
