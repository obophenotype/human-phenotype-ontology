        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0410277">
        <obo:IAO_0000115 xml:lang="tr">Sternal çukur, göğüste sternumun üstündeki ciltte küçük bir çentik veya gamzedir. Bazı durumlarda, cilt defekti sternum üzerinde lineer şekilde birkaç santime kadar uzayabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sternal çukur</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410277"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sternal çukur, göğüste sternumun üstündeki ciltte küçük bir çentik veya gamzedir. Bazı durumlarda, cilt defekti sternum üzerinde lineer şekilde birkaç santime kadar uzayabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A sternal pit is a small indentation or dimple in the skin overlying the sternum of the chest. In some cases, the skin defect can be linear, extending several inches over the sternum.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
