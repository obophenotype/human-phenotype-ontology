        <babelon:source_value>Epiphyses of the 5th toe are hard and dense like ivory. Such an epiphysis has a uniformly dense appearance on radiographs.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
