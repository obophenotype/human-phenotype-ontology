    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011864">
        <obo:IAO_0000115 xml:lang="tr">Kanda anormal olarak artmış difosfat (4-) konsanstrasyonu. Difosfat (4-) iki fosfat gruplu ester olması sebebiyle pirofosfat olarak da bilinir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Yükselmiş plazma pirofosfatı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011864"/>
