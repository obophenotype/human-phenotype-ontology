        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031410"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Akış sitometrisi ile ölçülen CD56 parlak NK hücrelerinin sayısında anormal bir dağılım. Homotipik adezyona aracılık eden adezyon molekülü CD56 NK hücreleri için fonksiyonel belirteç olarak kullanılmaktadır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal distribution in the number of CD56 bright NK cells, as measured by flow cytometry. CD56, an adhesion molecule mediating homotypic adhesion, is used as a functional marker for NK cells.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
