        <rdfs:label xml:lang="tr">Onikomikozis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012203"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Tırnakların kalınlaşmasına, lekelenmesine, biçimsizleşmesine ve ayrılmasına neden olan ayak veya el tırnaklarının bir mantar enfeksiyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased susceptibility to fungal infection of the nail apparatus (onychomycosis), as manifested by recurrent or severe infection of the nail plate, nail bed, or nail matrix caused by fungal organisms. Causative agents include dermatophytes (Trichophyton species) and Candida species.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
