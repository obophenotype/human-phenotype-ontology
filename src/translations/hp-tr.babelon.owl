    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0005458">
        <obo:IAO_0000115 xml:lang="tr">Normalde posterior ve lateral fontanelller doğumdan yaklaşık altı ay sonra yok olur, anterior fontanelle ikinci yılın ortalarında kapanır. Bu terim, fontanellerin, uygun olmayan erken bir zamanda kapanmasını açıklar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fontanellerin erken kapanması</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005458"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Normalde posterior ve lateral fontanelller doğumdan yaklaşık altı ay sonra yok olur, anterior fontanelle ikinci yılın ortalarında kapanır. Bu terim, fontanellerin, uygun olmayan erken bir zamanda kapanmasını açıklar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Normally, the posterior and lateral fontanelles are obliterated by about six months after birth, the anterior fontanelle closes by about the middle of the second year. This term refers to the situation in which the fontanelles close at an inappropriately early time point.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005458"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Fontanellerin erken kapanması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Premature closure of fontanelles</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
