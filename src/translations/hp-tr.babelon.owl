    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031591">
        <obo:IAO_0000115 xml:lang="tr">Anormal olarak geniş Östaki kapağı (postnatal olarak). İnferior vena kava kapağı olarak da bilinen Östaki kapağı inferior vena kava kapağının embriyolojik bir artığıdır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Genişlemiş Östaki borusu</rdfs:label>
