        <owl:annotatedTarget xml:lang="tr">Levokardiyalı situs inversus</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Situs inversus with levocardia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031593">
        <obo:IAO_0000115 xml:lang="tr">P dalgasının sonundan QRS kompleksinin başlangıcına kadar olan EKG kısmı olan PR aralığının bir anomalisi. Normal PR aralığı erişkinlerde 0.12-0.2 saniyedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal PR aralığı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031593"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">P dalgasının sonundan QRS kompleksinin başlangıcına kadar olan EKG kısmı olan PR aralığının bir anomalisi. Normal PR aralığı erişkinlerde 0.12-0.2 saniyedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An anomaly of the PR interval, which is the portion of the ECG from the onset of the P wave to the beginning of the QRS complex. A normal PR interval in adults is 0.12-0.2 seconds.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
