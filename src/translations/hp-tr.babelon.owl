        <owl:annotatedTarget xml:lang="tr">Küçük ağız açıklığı ve dudakların sürekli kasılması ile karakterize sanki hasta ıslık çalıyormuş gibi görünen yüz morfolojisi anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of facial morphology characterized by a small mouth opening and constant contraction of the lips as if the patient were whistling.</babelon:source_value>
