    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030374">
        <obo:IAO_0000115 xml:lang="tr">Kandaki B hafıza hücrelerinin (CD19+/CD27+) sayısında normalin altındaki bir düşüş. B hafıza hücreleri toy B hücrelerinden oluşmaktadır. Antijen görevinin üzerine, B hafıza hücreleri hızla genişler ve Th hafıza hücrelerinin (Phase IV) eş asıllı kontrolü altında plazma hücrelerine dönüşürler</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Azalmış hafıza B hücresi sayımı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030374"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kandaki B hafıza hücrelerinin (CD19+/CD27+) sayısında normalin altındaki bir düşüş. B hafıza hücreleri toy B hücrelerinden oluşmaktadır. Antijen görevinin üzerine, B hafıza hücreleri hızla genişler ve Th hafıza hücrelerinin (Phase IV) eş asıllı kontrolü altında plazma hücrelerine dönüşürler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduction in the normal proportion of memory B cells (CD19+/CD27+) in circulation relative to the total number of B cells. Memory B cells develop from naive B cells. Upon antigen rechallenge, memory B cells rapidly expand and differentiate into plasma cells under the cognate control of memory Th cells (Phase IV).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
