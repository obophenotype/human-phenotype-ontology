        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0001770">
        <obo:IAO_0000115 xml:lang="tr">&quot;Ayak parmaklarının sadece yumuşak doku içeren veya kemik yapıyı da içeren perdeleşmesi veya birleşmesi. Kemik füzyon &quot;&quot;kemiksi&quot;&quot; sindaktili eğer antero-posterior aksta gerçekleşirse kullanılır. Proksimo-distal aksta olan ayak kemiklerinin füzyonu &quot;&quot;sinfalangizm&quot;&quot; olarak adlandırılır&quot;</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ayak parmağı sindaktilisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001770"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">&quot;Ayak parmaklarının sadece yumuşak doku içeren veya kemik yapıyı da içeren perdeleşmesi veya birleşmesi. Kemik füzyon &quot;&quot;kemiksi&quot;&quot; sindaktili eğer antero-posterior aksta gerçekleşirse kullanılır. Proksimo-distal aksta olan ayak kemiklerinin füzyonu &quot;&quot;sinfalangizm&quot;&quot; olarak adlandırılır&quot;</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>&quot;Webbing or fusion of the toes, involving soft parts only or including bone structure. Bony fusions are referred to as &quot;&quot;bony&quot;&quot; Syndactyly if the fusion occurs in a radio-ulnar axis. Fusions of bones of the toes in a proximo-distal axis are referred to as &quot;&quot;Symphalangism&quot;&quot;.&quot;</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001770"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ayak parmağı sindaktilisi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Toe syndactyly</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
