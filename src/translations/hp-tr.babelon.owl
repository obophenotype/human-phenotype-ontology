        <owl:annotatedTarget xml:lang="tr">Anormal derecede yükselmiş veya sinir bozucu bir ruh hali, uyarılma ve veya enerji seviyeleri</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
