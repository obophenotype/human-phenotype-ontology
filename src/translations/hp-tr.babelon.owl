        <rdfs:label xml:lang="tr">Lipemia retinalis</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000660"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Retinal damarların açık pembeden sütümsü beyaz renge değiştiği ve koroidal damarlardan refleksleri soluklaştıran, retinal damarların kandaki lipid konsantrasyonu aşırı yükseldiği zaman retinal kan damarlarının krem benzeri görünümü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A creamy appearance of the retinal blood vessels that occurs when the concentration of lipids in the blood is extremely increased, with pale pink to milky white retinal vessels and altered pale reflexes from choroidal vasculature.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
