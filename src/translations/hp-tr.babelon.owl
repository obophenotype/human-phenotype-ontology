    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012647">
        <obo:IAO_0000115 xml:lang="tr">Lokal vazodilatasyon, hücreler arası boşluklara plazma ekstravazasyonu ile beyaz kan hücreleri ve makrofajların birikimi ile karakterize, bir yaralanmaya veya enfeksiyona yanıtın, yani inflamatuar yanıtın herhangi bir anomalisi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal inflamatuar yanıt</rdfs:label>
    </rdf:Description>
