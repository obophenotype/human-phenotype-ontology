    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011995">
        <obo:IAO_0000115 xml:lang="tr">Tek taraf yönünde interatriyal septumun şişmesi. Yetişkinlerde, atriyal septum anevrizma, transözofageal ekokardiyografi ile ölçülen atriyal septum düzleminin &gt;10 mm ilerisindeki anevrizmanın bir çıkıntısı olarak tanımlanabilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Atriyal septal dilatasyon</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011995"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Tek taraf yönünde interatriyal septumun şişmesi. Yetişkinlerde, atriyal septum anevrizma, transözofageal ekokardiyografi ile ölçülen atriyal septum düzleminin &gt;10 mm ilerisindeki anevrizmanın bir çıkıntısı olarak tanımlanabilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A bulging of the interatrial septum towards one side. In adults, atrial septal aneurysm can be defined as a protrusion of the aneurysm of &gt;10 mm beyond the plane of the atrial septum as measured by transesophageal echocardiography.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
