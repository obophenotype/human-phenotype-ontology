        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0040201">
        <obo:IAO_0000115 xml:lang="tr">Motor pasifliğin bir alt kümesi, basit gönüllülük esnasında aynı anda iki taneden fazlasını yerine getirememe, örneğin gözlerin kapanması ve dilin çıkması gibi işlevler olarak tanımlanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Simültanapraksi</rdfs:label>
