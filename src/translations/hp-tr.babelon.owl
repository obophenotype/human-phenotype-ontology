    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000752">
        <obo:IAO_0000115 xml:lang="tr">Hiperaktivite, uygun olmayan durumlar dahil sabit olarak olağan dışı veya anormal olarak aktif olma hali</obo:IAO_0000115>
