    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031848">
        <obo:IAO_0000115 xml:lang="tr">Topuklar zemine değmeden parmak üzerinde yürürken bir bireyin gerilmiş gövde ve flekse kollar ile yürüdüğü distonik postürlü bireylerde gözlenebilecek bir yürüyüş anormalliği</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Horoz yürüyüşü</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031848"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Topuklar zemine değmeden parmak üzerinde yürürken bir bireyin gerilmiş gövde ve flekse kollar ile yürüdüğü distonik postürlü bireylerde gözlenebilecek bir yürüyüş anormalliği</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormality of gait that can be observed in individuals with dystonic posture in which the individual walks with an extended trunk and flexed arms, while strutting on the toes without the heels touching the floor.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031848"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Horoz yürüyüşü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Cock-walk gait</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031849">
        <obo:IAO_0000115 xml:lang="tr">Gün içinde uyuma ve gece uyanık olma eğilimi ile uyku alışkanlıklarının tersine dönmesi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Uyku-uyanık inversiyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031849"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Gün içinde uyuma ve gece uyanık olma eğilimi ile uyku alışkanlıklarının tersine dönmesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reversal of sleeping habits, with a tendency to sleep during the day and be awake at night.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031849"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Uyku-uyanık inversiyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sleep-wake inversion</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031850">
