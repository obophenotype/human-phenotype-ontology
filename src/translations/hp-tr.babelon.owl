        <babelon:source_value>Paroxysmal dystonia</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002269">
        <obo:IAO_0000115 xml:lang="tr">Nöronların kökenlerinden beyindeki son pozisyonlarına göç ettigi süreç yani nöronal migrasyon anomalisi sonucu ortaya çıkan bir anormallik</obo:IAO_0000115>
