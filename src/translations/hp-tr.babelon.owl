    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010769">
        <obo:IAO_0000115 xml:lang="tr">Koksigeyal bölgede (intergluteal yarık bölgesi) bir sinüs. Pilonidal sinüs sıklıkla saç ve deri artığı içerir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Pilonidal sinus</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010769"/>
