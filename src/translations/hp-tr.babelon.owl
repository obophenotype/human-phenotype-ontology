        <owl:annotatedTarget xml:lang="tr">Özofagusun skuamöz epitelyum içine çok sayıda eozinofilin (genellikle mikroskopta büyütülerek bakılan alan başına 15&apos;ten fazla) infiltrasyonu ve özofagusun yüzey katmanında eozinofillerin katmanlandırılması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Infiltration of numerous eosinophils (usually greater than 15 per high power field) into the squamous epithelium of the esophagus, and layering of eosinophils on the surface layer of the esophagus.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410151"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Özofagusun eozinofilik infiltrasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Eosinophilic infiltration of the esophagus</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0410152">
        <obo:IAO_0000115 xml:lang="tr">Özofagusta küçük lokalize eozinofil (eozinofilik bir mikroapse) koleksiyonu oluşumu. Genellikle eksüdat veya beyaz noktalar veya beyaz plaklar olarak gözüken 4 eozinofile eşit veya daha büyük kümeler görülür</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Özofagusta eozinofilik mikroapse oluşumu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410152"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Özofagusta küçük lokalize eozinofil (eozinofilik bir mikroapse) koleksiyonu oluşumu. Genellikle eksüdat veya beyaz noktalar veya beyaz plaklar olarak gözüken 4 eozinofile eşit veya daha büyük kümeler görülür</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The formation of small localized collection of eosinophiles (an eosinophilic microabscess) in the esophagus. Usually clusters of greater than or equal to 4 eosinophils are seen, that appear as exudates or white spots or white plaques.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0410152"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Özofagusta eozinofilik mikroapse oluşumu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Eosinophilic microabscess formation in the esophagus</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
