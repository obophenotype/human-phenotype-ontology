        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>HbC hemoglobin</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032147">
        <obo:IAO_0000115 xml:lang="tr">Ağırlıklı olarak ayakları içeren semptomlar ile ısıya maruziyeti veya egzersizi takiben tekrarlayan kırmızılık, yanma ağrısı ve ekstremitelerin sıcaklığı epizotları</obo:IAO_0000115>
