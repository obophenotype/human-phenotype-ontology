        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of the posterior hairline</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030142">
        <obo:IAO_0000115 xml:lang="tr">Abdominal seslerin yapısı veya miktarındaki bir anormallik. Abdominal sesler (bağırsak sesleri) peristaltizm ile abdominal içeriğin geçişini sağlayan bağırsak hareketleri ile oluşur</obo:IAO_0000115>
