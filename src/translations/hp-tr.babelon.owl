    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031871">
        <obo:IAO_0000115 xml:lang="tr">Dendritik hücrelerin epidermiste ve bazı diğer yerleşimlerde olduğu Langerhans hücrelerinin herhangi bir fonksiyonel anomalisi. Langerhans hücreleri bağışıklık gözetiminde ve homeostazında rol oynar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal Langerhans hücre morfolojisi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031871"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Dendritik hücrelerin epidermiste ve bazı diğer yerleşimlerde olduğu Langerhans hücrelerinin herhangi bir fonksiyonel anomalisi. Langerhans hücreleri bağışıklık gözetiminde ve homeostazında rol oynar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any functional anomaly of Langerhans cells, which are dendritic cells in the epidermis and some other locations. Langerhans cells play roles in immune surveillance and homeostasis.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
