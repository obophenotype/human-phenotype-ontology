    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011749">
        <obo:IAO_0000115 xml:lang="tr">Genellikle ikincil olarak adrenal korteks tarafından aşırı kortizol üretimine yol açan adrenokortikotropik hormonun (ACTH) aşırı üretimi</obo:IAO_0000115>
