        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002427">
        <obo:IAO_0000115 xml:lang="tr">Anlamlı dilin bozulması ve alıcı dil becerilerinin göreli olarak korunması. Bu demek oluyor ki hasta dil biliyor (konuşma, yazma) fakat bunu ifade edemiyor</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Motor afazi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002427"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Anlamlı dilin bozulması ve alıcı dil becerilerinin göreli olarak korunması. Bu demek oluyor ki hasta dil biliyor (konuşma, yazma) fakat bunu ifade edemiyor</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impairment of expressive language and relative preservation of receptive language abilities. That is, the patient understands language (speech, writing) but cannot express it.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002427"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
