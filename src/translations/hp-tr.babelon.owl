        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal double-negative T cell proportion</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031401">
        <obo:IAO_0000115 xml:lang="tr">Toplam T hücre sayısı ile karşılaştırıldığında CD4-negatif, CD8-negatif (çift negatif veya ÇN), alfa-beta düzenleyici T hücrelerinin (Tregs) anormal azalmış oranı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">CD4 negatif, CD8 negatif, alfa beta düzenleyici T hücrelerinin azalmış oranı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031401"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Toplam T hücre sayısı ile karşılaştırıldığında CD4-negatif, CD8-negatif (çift negatif veya ÇN), alfa-beta düzenleyici T hücrelerinin (Tregs) anormal azalmış oranı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal decrease of double negative (DN) CD3+CD4-CD8- T cells, measured as percentage of total CD3+ T cells in the blood, compared to a reference range for a given sex and age-group. These are usually measured within the TCR alpha/beta positive population.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031401"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">CD4 negatif, CD8 negatif, alfa beta düzenleyici T hücrelerinin azalmış oranı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased double-negative T cell number</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031402">
        <obo:IAO_0000115 xml:lang="tr">Antijenik uyarı ile aktivasyonu takiben T hücre popülasyonunun bozulmuş genişlemesi ve proliferasyonu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Azalmış antijen spesifik T hücre çoğalması</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031402"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Antijenik uyarı ile aktivasyonu takiben T hücre popülasyonunun bozulmuş genişlemesi ve proliferasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired proliferation and expansion of a T cell population following activation by an antigenic stimulus.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031402"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Azalmış antijen spesifik T hücre çoğalması</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased antigen-specific T cell proliferation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031403">
        <obo:IAO_0000115 xml:lang="tr">CD8 T hücrelerinin patojenlere bozulmuş yanıtı. CD8 T hücreleri sitotoksik aracıları içeren granüllerin salınımı veya ölüm reseptörlerinin angajmanı aracılığıyla bir hedef hücrenin öldürülmesini yönetir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Bozulmuş patojene özgü CD8 sitotoksisitesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031403"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">CD8 T hücrelerinin patojenlere bozulmuş yanıtı. CD8 T hücreleri sitotoksik aracıları içeren granüllerin salınımı veya ölüm reseptörlerinin angajmanı aracılığıyla bir hedef hücrenin öldürülmesini yönetir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired response of CD8 T cells to pathogens. CD8 T cells direct the killing of a target cell through the release of granules containing cytotoxic mediators or through the engagement of death receptors.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031403"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Bozulmuş patojene özgü CD8 sitotoksisitesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired pathogen-specific CD8 cytoxicity</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031404">
        <obo:IAO_0000115 xml:lang="tr">Somatik farklılaşma işlemi ile üretilen ve aynı antijene daha sonra olan maruziyet ile geliştirilmiş ikincil yanıta izin veren (bağışıklık hafızası) antijen için özel reseptörler eksprese eden hücreler tarafından yönetilen bozulmuş bir bağışıklık yanıtı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Bozulmuş antijene özel yanıt</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031404"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Somatik farklılaşma işlemi ile üretilen ve aynı antijene daha sonra olan maruziyet ile geliştirilmiş ikincil yanıta izin veren (bağışıklık hafızası) antijen için özel reseptörler eksprese eden hücreler tarafından yönetilen bozulmuş bir bağışıklık yanıtı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An impaired immune response mediated by cells expressing specific receptors for antigen produced through a somatic diversification process, and allowing for an enhanced secondary response to subsequent exposures to the same antigen (immunological memory).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031404"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Bozulmuş antijene özel yanıt</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Impaired antigen-specific response</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031405">
        <obo:IAO_0000115 xml:lang="tr">İyi huylu olan, ekkrine veya apokrin diferansiyasyonluyla sağlıklı çevrelenmiş, ter bezi neoplazması. Akral bölgelerde genellikle yalnız başına, kubbe şeklinde bir kabarcık olarak, yumru veya plak olarak bulunur. Altderide tekdüze basaloid hücrelerin çoğalmasıyla karakterize edilir ve fokal duktal ve kistik yapıların varlığıklarıyla bağlantılıdır [NCIT:C27273]</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Poroma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031405"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">İyi huylu olan, ekkrine veya apokrin diferansiyasyonluyla sağlıklı çevrelenmiş, ter bezi neoplazması. Akral bölgelerde genellikle yalnız başına, kubbe şeklinde bir kabarcık olarak, yumru veya plak olarak bulunur. Altderide tekdüze basaloid hücrelerin çoğalmasıyla karakterize edilir ve fokal duktal ve kistik yapıların varlığıklarıyla bağlantılıdır [NCIT:C27273]</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A benign, well circumscribed sweat gland neoplasm with eccrine or apocrine differentiation. It usually presents as a solitary, dome-shaped papule, nodule, or plaque on acral sites. It is characterized by a proliferation of uniform basaloid cells in the dermis and it is associated with the presence of focal ductal and cystic structures [NCIT:C27273].</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031405"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Poroma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Poroma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031406">
        <obo:IAO_0000115 xml:lang="tr">Bir sitokinin hücre yüzeyindeki bir reseptöre bağlanması ile tetiklenen ve takip eden hücresel süreçlerin düzenlenmesi ile biten örneğin transkripsiyon gibi bir moleküler sinyal serisinde herhangi bir anormallik</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal sitokin sinyali</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031406"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Bir sitokinin hücre yüzeyindeki bir reseptöre bağlanması ile tetiklenen ve takip eden hücresel süreçlerin düzenlenmesi ile biten örneğin transkripsiyon gibi bir moleküler sinyal serisinde herhangi bir anormallik</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Any abnormality in the series of molecular signals initiated by the binding of a cytokine to a receptor on the surface of a cell, and ending with regulation of a downstream cellular process, e.g. transcription.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031406"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Anormal sitokin sinyali</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormal cytokine signaling</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
