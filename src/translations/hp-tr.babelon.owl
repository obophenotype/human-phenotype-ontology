    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030715">
        <obo:IAO_0000115 xml:lang="tr">Bir bronşun proksimal segmentinin fokal obliterasyonu ile karakterize bir gelişimsel anomali. Bronşiyal patern stenoz kısmının distalinde tamamen normaldir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Bronşiyal atrezi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
