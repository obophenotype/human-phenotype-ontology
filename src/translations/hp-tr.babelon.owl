        <rdfs:label xml:lang="tr">Duygulanım ile tetiklenen</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025334"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Güçlü spontan mental durum, reaksiyon veya his (duygu) kaynaklanması ile provoke edilen veya ortaya çıkarılan bir bulgu veya belirti için geçerlidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Applies to a sign or symptom that is provoked or brought about by a strong spontaneously arising mental state, reaction or feeling (emotion).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025334"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Duygulanım ile tetiklenen</owl:annotatedTarget>
