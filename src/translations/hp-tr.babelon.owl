    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012905">
        <obo:IAO_0000115 xml:lang="tr">Euryblefaron, palpebral fissürün yatay olarak büyümesiyle karakterize edilen bir doğuştan olan göz kapağı anomalisidir. Göz kapağı yatay boyut ile kısaltılmış dikine kıyaslanır, birleşmiş yanal kantal malpozisyonu ve yanal ektropiyon anormal geniş kapak açıklığı ile birlikte</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Öblefaron</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012905"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Euryblefaron, palpebral fissürün yatay olarak büyümesiyle karakterize edilen bir doğuştan olan göz kapağı anomalisidir. Göz kapağı yatay boyut ile kısaltılmış dikine kıyaslanır, birleşmiş yanal kantal malpozisyonu ve yanal ektropiyon anormal geniş kapak açıklığı ile birlikte</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Euryblepharon is a congenital eyelid anomaly characterized by horizontal enlargement of the palpebral fissure. The eyelid is shortened vertically compared with the horizontal dimension, with associated lateral canthal malpositioning and lateral ectropion abnormally wide lid opening.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012905"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Öblefaron</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Euryblepharon</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
