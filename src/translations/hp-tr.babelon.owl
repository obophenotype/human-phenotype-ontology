        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kişilerin ayaklarını geniş bir biçimde ayrık durarak yürüdüğü ve ayakta durduğu anormal bir yürüyüş şekli. Bu sıklıkla serebellar ataksinin bir bileşenidir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An abnormal gait pattern in which persons stand and walk with their feet spaced widely apart. This is often a component of cerebellar ataxia.</babelon:source_value>
