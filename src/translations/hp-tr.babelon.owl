        <owl:annotatedTarget xml:lang="tr">Mitral kapak annulusunun herhangi bir yapısal anomalisi. Annulus, fibröz ve miyokardiyal dokudan oluşan bir halkadır ve kapak yaprakçıklarının üzerine birleştiği yapıdır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
