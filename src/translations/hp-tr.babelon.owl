    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002608">
        <obo:IAO_0000115 xml:lang="tr">Çölyak hastalığı (ÇH), buğday, arpa ve çavdarın protein fraksiyonu olan glutenin alımıyla tetiklenen, ince bağırsağı etkileyen otoimmün bir durumdur. ÇH&apos;nin klinik bulguları oldukça değişkendir ve hem gastrointestinal hem de gastrointestinal olmayan özellikleri içerir. ÇH&apos;nin en belirgin özelliği bağışıklık yanıtı sonucu gelişen bir enteropatidir. ÇH&apos;nin görülmesi bir takım diğer hastalıkların bir özelliği olarak görüldüğü için bu terim dahil edilmiştir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Çölyak hastalığı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002608"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çölyak hastalığı (ÇH), buğday, arpa ve çavdarın protein fraksiyonu olan glutenin alımıyla tetiklenen, ince bağırsağı etkileyen otoimmün bir durumdur. ÇH&apos;nin klinik bulguları oldukça değişkendir ve hem gastrointestinal hem de gastrointestinal olmayan özellikleri içerir. ÇH&apos;nin en belirgin özelliği bağışıklık yanıtı sonucu gelişen bir enteropatidir. ÇH&apos;nin görülmesi bir takım diğer hastalıkların bir özelliği olarak görüldüğü için bu terim dahil edilmiştir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Celiac disease (CD) is an autoimmune condition affecting the small intestine, triggered by the ingestion of gluten, the protein fraction of wheat, barley, and rye. Clinical manifestations of CD are highly variable and include both gastrointestinal and non-gastrointestinal features. The hallmark of CD is an immune-mediated enteropathy. This term is included because the occurrence of CD is seen as a feature of a number of other diseases.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002608"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Çölyak hastalığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Celiac disease</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
