    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000189">
        <obo:IAO_0000115 xml:lang="tr">Damak genişliğinin ortalamadan 2 SD az olması (nesnel) veya palatal genişliğin belirgin şekilde azalması (öznel)</obo:IAO_0000115>
