        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031036">
        <obo:IAO_0000115 xml:lang="tr">Büyüme hormonu bağlayıcı proteininin azalmış kan konsantrasyonu</obo:IAO_0000115>
