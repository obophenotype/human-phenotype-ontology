        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031727">
        <obo:IAO_0000115 xml:lang="tr">Göz küresinin üst kutuplarının birbirine dışa doğru (lateral olarak) döndüğü bir siklotropi tipi (gözlerin görsel aksı etrafında bir veya her iki gözün torsiyonu)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ekssiklotropi</rdfs:label>
    </rdf:Description>
