        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032083"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Elastik liflerin yokluğu ve elastik lifler için olan bir boya ile tanımlandığı üzere elastik lif lamellasında artmış boşluklar ile artan derecede genişlemiş translamellar boşluklar oluşturan aort mediasının elastik liflerinin kaybı ve/veya fragmantasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Loss and/or fragmentation of elastic fibers of the media of the aorta creating increasingly extended translamellar spaces, with absence of elastic fibers, and increased gaps in elastic fiber lamellae as identified on a stain for elastic fibers.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032083"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Aortik elastik lif fragmantasyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aortic elastic fiber fragmentation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032084">
        <obo:IAO_0000115 xml:lang="tr">Elastik lifler için olan bir boya ile tanımlandığı üzere genişleyen intralamellar boşluklar oluşturan aort mediasının elastik liflerinin incelmesi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Aortik elastik lif incelmesi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032084"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Elastik lifler için olan bir boya ile tanımlandığı üzere genişleyen intralamellar boşluklar oluşturan aort mediasının elastik liflerinin incelmesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A thinning out of elastic fibers of the media of the aorta that creates widening of intralamellar spaces, as identified on a stain for elastic fibers.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032084"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Aortik elastik lif incelmesi</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Aortic elastic fiber thinning</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0032085">
        <obo:IAO_0000115 xml:lang="tr">Elastik lifler için olan bir boya ile tanımlandığı üzere aort mediasının elastik liflerinin paralel olmayan düzenlenmesi/karışıklığı</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Aortik elastik lif disorganizasyonu</rdfs:label>
    </rdf:Description>
