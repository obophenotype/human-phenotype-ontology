    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000892">
        <obo:IAO_0000115 xml:lang="tr">Çift kaburga, kaburgaların sternal ucunun genellikle tek taraflı çentiklenmesine denmektedir. Çift kaburgalar genellikle asemptomatiktir ve sıklıkla göğüs grafisinde rastlantısal olarak saptanır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Çift kaburgalar</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000892"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Çift kaburga, kaburgaların sternal ucunun genellikle tek taraflı çentiklenmesine denmektedir. Çift kaburgalar genellikle asemptomatiktir ve sıklıkla göğüs grafisinde rastlantısal olarak saptanır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A bifid rib refers to cleavage of the sternal end of a rib, usually unilateral. Bifid ribs are usually asymptomatic, and are often discovered incidentally by chest x-ray.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
