        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">TCR aktivasyonu sonrası azalmış CD25 reseptör sayısı artışı</owl:annotatedTarget>
