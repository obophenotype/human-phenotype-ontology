        <babelon:source_value>Flexion contracture of the hallux</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010213">
        <obo:IAO_0000115 xml:lang="tr">Kemik olmayan dokuda yapısal değişikliklere bağlı olarak halluksun tarsometatarsal ekleminde kronik eklem hareketi kaybı. Ayakların tarsometatarsal eklemleri Lisfranc&apos;ın eklemleri olarak adlandırılır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Ayak baş parmağı tarsometatarsal ekleminin kontraktürü</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010213"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kemik olmayan dokuda yapısal değişikliklere bağlı olarak halluksun tarsometatarsal ekleminde kronik eklem hareketi kaybı. Ayakların tarsometatarsal eklemleri Lisfranc&apos;ın eklemleri olarak adlandırılır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Chronic loss of joint motion in the tarsometatarsal joint of the hallux due to structural changes in non-bony tissue. The tarsometatarsal joints of the feet are also called Lisfranc&apos;s joints.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010213"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Ayak baş parmağı tarsometatarsal ekleminin kontraktürü</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Contracture of the tarsometatarsal joint of the hallux</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010214">
