        <owl:annotatedTarget xml:lang="tr">Alveolar kenardan üst veya alt dudağın iç yüzüne uzanan fazladan doku katlantısı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Extra fold of tissue extending from the alveolar ridge to the inner surface of the upper or lower lip.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
