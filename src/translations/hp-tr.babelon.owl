    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0007018">
        <obo:IAO_0000115 xml:lang="tr">Dikkat eksikliği hiperaktivite bozukluğu (DEHB) 2-3 yaşlarında ya da en geç birinci sınıfta ortaya çıkmaktadır. Başlıca belirtiler dikkat dağınıklığı, dürtüsellik, hiperaktivite ve sıklıkla görev ve projelerin düzenlenmesinde sorunlar, uyku güçlüğü ve agresif, yüksek ya da sabırsız olan sosyal problemlerdir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Dikkat eksikliği ve hiperaktivite bozukluğu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007018"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Dikkat eksikliği hiperaktivite bozukluğu (DEHB) 2-3 yaşlarında ya da en geç birinci sınıfta ortaya çıkmaktadır. Başlıca belirtiler dikkat dağınıklığı, dürtüsellik, hiperaktivite ve sıklıkla görev ve projelerin düzenlenmesinde sorunlar, uyku güçlüğü ve agresif, yüksek ya da sabırsız olan sosyal problemlerdir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Attention deficit hyperactivity disorder (ADHD) manifests at age 2-3 years or by first grade at the latest. The main symptoms are distractibility, impulsivity, hyperactivity, and often trouble organizing tasks and projects, difficulty going to sleep, and social problems from being aggressive, loud, or impatient.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007018"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Dikkat eksikliği ve hiperaktivite bozukluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Attention deficit hyperactivity disorder</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
