        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Thalamic arteriovenous malformation</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031255">
        <obo:IAO_0000115 xml:lang="tr">Arterlerin veya arteriyollerin herhangi kapiller bir yatağı atlayarak direk olarak venöz toplama sistemine bağlandığı normal vasküler paternin bozulması. Bu terim hipotalamusta yer alan arteriyovenöz malformasyon için kullanılır</obo:IAO_0000115>
