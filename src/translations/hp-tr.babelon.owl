        <owl:annotatedTarget xml:lang="tr">Metatarsal-falangeyal eklem hiperekstansiyonu ile proksimal interfalangeyal (PIF) eklem hiperfleksiyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hyperextension of the metatarsal-phalangeal joint with hyperflexion of the proximal interphalangeal (PIP) joint.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
