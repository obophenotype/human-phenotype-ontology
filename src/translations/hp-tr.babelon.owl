    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025589">
        <obo:IAO_0000115 xml:lang="tr">Siklodeviasyon bir göz küresinin anteroposterior aks boyunca rotasyonu ve siklotropisi ve iki göz arasında siklodeviasyonun yanlış sıralaması olarak tanımlanır</obo:IAO_0000115>
