        <obo:IAO_0000115 xml:lang="tr">Duktus arteriyozusun distalinde, yani aortik arkın postduktal bölgesinde yer alan aort daralması veya konstriksiyonu</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Postduktal aort koarktasyonu</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011647"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Duktus arteriyozusun distalinde, yani aortik arkın postduktal bölgesinde yer alan aort daralması veya konstriksiyonu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Narrowing or constriction of the aorta localized distal to the ductus arteriosus, i.e., to the postductal region of aortic arch.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011647"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Postduktal aort koarktasyonu</owl:annotatedTarget>
