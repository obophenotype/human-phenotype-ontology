        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Vücudun bir kısmında kolun, bacağın ve bazı vakalarda yüzün geçici güçsüzlük epizotları</owl:annotatedTarget>
