    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100035">
        <obo:IAO_0000115 xml:lang="tr">Burun, ağız veya boğaz yoluyla havanın hareket ettirilmesiyle ortaya çıkan istemsiz sesler. Ses telleri, ses üreten her tikte yer almaz</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Fonik tikler</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100035"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Burun, ağız veya boğaz yoluyla havanın hareket ettirilmesiyle ortaya çıkan istemsiz sesler. Ses telleri, ses üreten her tikte yer almaz</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tics are defined as movements or sounds that resemble physiological motor behaviors, but are typically inopportune to social context and appear sudden, repetitive, and often exaggerated. Tic vocalizations commonly termed vocal or phonic tics may include any possible sound (eg, sniffing, coughing, throat clearing, whistling, or grunting), word, or sentence and are most commonly encountered within the spectrum of primary tic disorders, as Tourette syndrome.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100035"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Fonik tikler</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Phonic tics</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100036">
        <obo:IAO_0000115 xml:lang="tr">Periostun kalınlaşmasıyla birlikte kortikal kemiğin yüzeyi boyunca azalan yoğunluğun bir kemik malzemesi bandı. Etkilenen bölgede kallus oluşumu yaygındır ve yanlış kırık görünümü verir</obo:IAO_0000115>
