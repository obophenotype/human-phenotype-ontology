    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0002511">
        <obo:IAO_0000115 xml:lang="tr">Demansın sinsi başlangıcı ile karakterize edilen, beynin dejeneratif bir hastalığı. Hafıza, yargılama, dikkat süresi ve problem çözme becerilerindeki bozulmayı, şiddetli apraksi ve kognitif yeteneklerin küresel kaybı izler. Durum öncelikle 60 yaşından sonra ortaya çıkar ve patolojik olarak şiddetli kortikal atrofi ve yaşlılık plakları, nörofibriler yumrular ve nöropil ipliklerinin üçlü takımıyla işaretlenir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Alzheimer hastalığı</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002511"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Demansın sinsi başlangıcı ile karakterize edilen, beynin dejeneratif bir hastalığı. Hafıza, yargılama, dikkat süresi ve problem çözme becerilerindeki bozulmayı, şiddetli apraksi ve kognitif yeteneklerin küresel kaybı izler. Durum öncelikle 60 yaşından sonra ortaya çıkar ve patolojik olarak şiddetli kortikal atrofi ve yaşlılık plakları, nörofibriler yumrular ve nöropil ipliklerinin üçlü takımıyla işaretlenir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A degenerative disease of the brain characterized by the insidious onset of dementia. Impairment of memory, judgment, attention span, and problem solving skills are followed by severe apraxia and a global loss of cognitive abilities. The condition primarily occurs after age 60, and is marked pathologically by severe cortical atrophy and the triad of senile plaques, neurofibrillary tangles, and neuropil threads.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002511"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Alzheimer hastalığı</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Alzheimer disease</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
