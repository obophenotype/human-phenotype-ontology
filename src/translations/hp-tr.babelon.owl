        <owl:annotatedTarget xml:lang="tr">3. parmak distal falanksının proksimal ucunda yer alan epifizin yaşa bağlı normal değerlere göre anormal büyük boyutu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormally large size of the epiphysis located at the proximal end of the distal phalanx of the 3rd finger with respect to age-dependent norms.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
