        <rdfs:label xml:lang="tr">5. parmağın proksimal falanksının fildişi epifizi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009157"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Küçük parmağın proksimal falanksının epifizinde skleroz, X-rayde artmış derecede radyoopasiteye (beyaz veya fil dişi görüntü) yol açar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Sclerosis of the epiphysis of the proximal phalanx of the little finger, leading to an increased degree of radiopacity (white or ivory appearance) in X-rays.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
