    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030769">
        <obo:IAO_0000115 xml:lang="tr">Büyük miktarda fıtıklaşmış beyin dokusu ve kalvariyum yokluğu ile olan bir nöral tüp malformasyonu</obo:IAO_0000115>
