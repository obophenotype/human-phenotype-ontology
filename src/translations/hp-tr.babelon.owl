        <owl:annotatedTarget xml:lang="tr">Deride desmozin ölçümü artmış miktarı. Desmozin elastindeki lizil rezidülerinden oluşan çapraz bağlı bir aminoasittir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
