    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0009345">
        <obo:IAO_0000115 xml:lang="tr">Elin 3. parmağının distal falanks epifizinin üçgen görünüşü. Bu epifiz falanksın proksimal ucunda yer alır ve normalde neredeyse düzdür</obo:IAO_0000115>
