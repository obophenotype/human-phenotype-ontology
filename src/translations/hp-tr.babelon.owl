    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031855">
        <obo:IAO_0000115 xml:lang="tr">Sağ izomerizm vücut sol-sağ aksının karşı tarafında bazı eşli yapıların birbirinin simetrik ayna görüntüsünde olduğu bir heterotaksi tipi ve normal sağ taraflı yapıların morfolojisine sahiptir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sağ izomerizm</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031855"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sağ izomerizm vücut sol-sağ aksının karşı tarafında bazı eşli yapıların birbirinin simetrik ayna görüntüsünde olduğu bir heterotaksi tipi ve normal sağ taraflı yapıların morfolojisine sahiptir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of heterotaxy where some paired structures on opposite sides of the left-right axis of the body are symmetrical mirror images of each other, and have the morphology of the normal right-sided structures.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
