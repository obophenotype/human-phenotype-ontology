    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0500012">
        <obo:IAO_0000115 xml:lang="tr">Hipofiz bezinden salınan gonadotropin hormonun normal salınım seviyesinde bir sapma</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Gonadotropin salgılayıcı hormon seviyesi anormalliği</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
