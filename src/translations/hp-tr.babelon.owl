    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0003651">
        <obo:IAO_0000115 xml:lang="tr">Köpük hücrelerinin oluşumunda, ateromdaki hücreler makrofajlar veya düz kasların az yogunlukdaki lipoprotein partikulleri değiştirmeyle köpüksü görünüm kazanırlar</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Köpük hücreleri</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003651"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Köpük hücrelerinin oluşumunda, ateromdaki hücreler makrofajlar veya düz kasların az yogunlukdaki lipoprotein partikulleri değiştirmeyle köpüksü görünüm kazanırlar</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of foam cells, a type of macrophage that localizes to fatty deposits on blood vessel walls, where they ingest low-density lipoproteins and become laden with lipids, giving them a foamy appearance.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
