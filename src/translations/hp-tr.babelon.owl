    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000558">
        <obo:IAO_0000115 xml:lang="tr">İridokorneal malformasyon, glokom, iris stroma hipoplazisi, posterior embriyotokson ve korneal opasiteler ile karakterize ön kamaranın doğumsal malformasyonudur</obo:IAO_0000115>
