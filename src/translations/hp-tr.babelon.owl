        <owl:annotatedTarget xml:lang="tr">Endojen veya ekzojen nedenlerden ötürü bağırsağın kas aktivitesini koordine etme kabiliyetini kaybetmesi ile ilgili spazm ve intestinal paralizi gibi anormal bağırsak kasılmaları</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
