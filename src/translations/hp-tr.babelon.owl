    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030093">
        <obo:IAO_0000115 xml:lang="tr">Kas lifi dokusunda laminin beta 1 miktarının normalden sapması. Laminin 2 iskelet kas hücresi bazal laminasının majör bir bileşenidir. 3 zincirden oluşmuş bir heterotrimerdir: merozin (laminan alfa 2 zinciri), beta 1 ve gama 1</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Anormal kas lifi laminin beta 1</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030093"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kas lifi dokusunda laminin beta 1 miktarının normalden sapması. Laminin 2 iskelet kas hücresi bazal laminasının majör bir bileşenidir. 3 zincirden oluşmuş bir heterotrimerdir: merozin (laminan alfa 2 zinciri), beta 1 ve gama 1</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A deviation from normal of the amount of laminin beta 1 in muscle fiber tissue. Laminin 2 is a major component of the basal lamina of skeletal muscle cells. It is a heterotrimer composed of 3 chains: merosin (laminin alpha 2 chain), beta 1, and gamma 1.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
