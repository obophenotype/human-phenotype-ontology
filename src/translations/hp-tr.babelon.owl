    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031136">
        <obo:IAO_0000115 xml:lang="tr">Sperm başı akrozomunda akrozin enziminin azalmış miktarı. Akrozom spermatozoa başının ön yarısında bir organeldir ve akrozin döllenme sürecinde zona pellusida sindirimine katkı veren bir proteazdır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Sperm başında azalmış akrozin</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031136"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Sperm başı akrozomunda akrozin enziminin azalmış miktarı. Akrozom spermatozoa başının ön yarısında bir organeldir ve akrozin döllenme sürecinde zona pellusida sindirimine katkı veren bir proteazdır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A reduced amount of the enzyme acrosin in the sperm head acrosome. The acrosome is an organelle in the anterior half of the head of spermatozoa, and acrosin is a protease that contributes to the digestation of the zona pellucida in the fertilization process.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031136"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Sperm başında azalmış akrozin</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased acrosin in sperm head</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031137">
        <obo:IAO_0000115 xml:lang="tr">Biriken materyal tarafından sitoplazmanın genişlemesi sonucu şişmiş bir görünüm sergileyen hepatositler (karaciğer parankimal hücreleri)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Hepatositlerde depolanma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031137"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Biriken materyal tarafından sitoplazmanın genişlemesi sonucu şişmiş bir görünüm sergileyen hepatositler (karaciğer parankimal hücreleri)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Hepatocytes (liver parenchymal cells) exhibit a bloated appearance because of expansion of the cytoplasm by accumulated material.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031137"/>
