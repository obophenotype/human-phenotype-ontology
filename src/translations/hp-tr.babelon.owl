        <owl:annotatedTarget xml:lang="tr">Sol ventriküler sistolik disfonksiyon</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Left ventricular systolic dysfunction</babelon:source_value>
