        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Vücuttaki anormal laktik asit birikimi, kan ve diğer vücut sıvılarının asitleşmesine sebebiyet verir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
