    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031045">
        <obo:IAO_0000115 xml:lang="tr">Akral (el ve ayak gibi periferik bölgeleri etkileyen) dağılımlı büller (ince duvarlı çapı 5 mm&apos;den fazla sıvı dolu kabarcıklar olarak tanımlanır)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Akral su toplanması</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031045"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Akral (el ve ayak gibi periferik bölgeleri etkileyen) dağılımlı büller (ince duvarlı çapı 5 mm&apos;den fazla sıvı dolu kabarcıklar olarak tanımlanır)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Bullae (defined as fluid-filled blisters more than 5 mm in diameter with thin walls) of the skin with an acral distribution (affecting peripheral regions such as hands and feet).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
