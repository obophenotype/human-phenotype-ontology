        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Osteopetrosis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0011003">
        <obo:IAO_0000115 xml:lang="tr">-6.00 dioptr&apos;dan büyük ciddi bir myopi formu</obo:IAO_0000115>
