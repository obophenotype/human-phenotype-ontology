        <owl:annotatedTarget xml:lang="tr">Gelişimsel bir defekte bağlı iç kulakta spiral şekilli bir boşluk olan kohlea yokluğu</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
