        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Poligenik kalıtım</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Polygenic inheritance</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0010983">
        <obo:IAO_0000115 xml:lang="tr">Birkaç gen konumunun eşzamanlı etkisi tarafından yönetilen multifatöryel kalıtımın bir türü. Bu terimin literatürdeki kullanımının tekdüze olmadığına işaret edilmesine rağmen bu terimin üç konum tarafından yönetilen özellikler için kullanılması önerilmektedir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Oligogenik kalıtım</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010983"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Birkaç gen konumunun eşzamanlı etkisi tarafından yönetilen multifatöryel kalıtımın bir türü. Bu terimin literatürdeki kullanımının tekdüze olmadığına işaret edilmesine rağmen bu terimin üç konum tarafından yönetilen özellikler için kullanılması önerilmektedir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A type of multifactorial inheritance governed by the simultaneous action of a few gene loci. It is recommended this term be used for traits governed by three loci, although it is noted that usage of this term in the literature is not uniform.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
