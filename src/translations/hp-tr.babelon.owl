        <obo:IAO_0000115 xml:lang="tr">Kolon ve ince bağırsağın bir inflamasyonu. Fakat çoğu durum ya Enterit (ince bağırsak inflamasyonu) ya da Kolit (kalın bağırsak inflamasyonu) olarak kategorize edilir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Enterokolit</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004387"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kolon ve ince bağırsağın bir inflamasyonu. Fakat çoğu durum ya Enterit (ince bağırsak inflamasyonu) ya da Kolit (kalın bağırsak inflamasyonu) olarak kategorize edilir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An inflammation of the colon and small intestine. However, most conditions are either categorized as Enteritis (inflammation of the small intestine) or Colitis (inflammation of the large intestine).</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004387"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Enterokolit</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Enterocolitis</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0004388">
        <obo:IAO_0000115 xml:lang="tr">Anormal derecede küçük çaplı bir kolon</obo:IAO_0000115>
