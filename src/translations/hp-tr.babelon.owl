        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001048"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kavernöz hemanjiyom varlığı. Geniş endoteliyal boşluklar (oyuk) ile karakterize bir hemanjiyom kavernöz hemanjiyom olarak adlandırılmaktadır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>The presence of a cavernous hemangioma. A hemangioma characterized by large endothelial spaces (caverns) is called a cavernous hemangioma.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
