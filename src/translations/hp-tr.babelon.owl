    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025583">
        <obo:IAO_0000115 xml:lang="tr">Fundus muayenesinde (foveanın korunduğu tipik olarak makülada) altın, ışıldayan, tanecikli yansıma. Tapetal terimi belli hayvanların gözlerinde gözlenen &apos;tapetal&apos; reflekse benzer olduğu düşünüldüğü için bu &apos;metalik&apos; parlak görünümü tarif etmek için kullanılır</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Tapetal benzeri fundal refleks</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025583"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Fundus muayenesinde (foveanın korunduğu tipik olarak makülada) altın, ışıldayan, tanecikli yansıma. Tapetal terimi belli hayvanların gözlerinde gözlenen &apos;tapetal&apos; reflekse benzer olduğu düşünüldüğü için bu &apos;metalik&apos; parlak görünümü tarif etmek için kullanılır</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Golden, scintillating, particulate reflection noted on fundus examination (typically in the macula and sparing the fovea). The term tapetal is used to describe this &apos;metallic&apos; sheen appearance as it is thought to be similar to the &apos;tapetal&apos; reflex seen in the eyes of certain animals.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025583"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Tapetal benzeri fundal refleks</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Tapetal-like fundal reflex</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0025584">
        <obo:IAO_0000115 xml:lang="tr">Her iki göz açık iken bir gözün aşağıya deviye olduğu bir strabismus (heterotropiya) belirti formu</obo:IAO_0000115>
