        <babelon:source_value>Isolation of the left subclavian artery</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031634">
        <obo:IAO_0000115 xml:lang="tr">Sol ortak karotid arter normal olarak aortik arktan köken alır. Bu terim bu arterin ana pulmoner arterden olan kökenine işaret etmektedir</obo:IAO_0000115>
