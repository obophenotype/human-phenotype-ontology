        <owl:annotatedTarget xml:lang="tr">Uzak sabitlenmede binoküler tek görüşün ve uyum ortadan kalktığında dahi yakında ezotropiyanın olduğu orta dereceli bir ezotropiya</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>An intermittent esotropia where there is binocular single vision on distance fixation and esotropia at near even when the accommodation is relieved.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
