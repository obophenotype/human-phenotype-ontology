    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012577">
        <obo:IAO_0000115 xml:lang="tr">Böbrek glomerülünün bazal lamina kalınlığında azalma</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">İnce glomerüler bazal membran</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012577"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Böbrek glomerülünün bazal lamina kalınlığında azalma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Decreased thickness of the glomerular basement membrane (GBM), measured from endothelial to visceral epithelial plasma membrane and mainly attributable to a decrease in thickness of the lamina densa, generally to an overall thickness more than 2 standard deviations less than that of the normal mean GBM thickness for health age- and sex matched individuals. May be focal or diffuse, although the term thin GBMs generally implies thinning of over 50% of GBMs.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012577"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">İnce glomerüler bazal membran</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Thin glomerular basement membrane</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0012578">
        <obo:IAO_0000115 xml:lang="tr">Bazal membran kalınlaşması ve subepitelyal boşlukta immün komplekslerin birikimi ile karakterize bir glomerülonefropati tipi</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Membranöz nefropati</rdfs:label>
    </rdf:Description>
