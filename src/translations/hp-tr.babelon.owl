    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0020037">
        <obo:IAO_0000115 xml:lang="tr">Yeterli kas gücüne sahip olmasına rağmen dış destek olmadan ayakta duramama ile karakterize bir postural anormallik</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Astazi</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020037"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Yeterli kas gücüne sahip olmasına rağmen dış destek olmadan ayakta duramama ile karakterize bir postural anormallik</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A postural abnormality characterized by the inability to stand without external support despite having sufficient muscle strength.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0020037"/>
