        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0030434">
        <obo:IAO_0000115 xml:lang="tr">Pilomatrikoma kıl folikülünün kıl matriksine doğru yavaş büyüyen, selim, asemptomatik, kutanöz bir tümördür. Normal veya hiperemik deri ile örtülüdür ve genellikle boyut olarak 0.5&apos;ten 3 cm&apos;ye değişir</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Pilomatriksom</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030434"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Pilomatrikoma kıl folikülünün kıl matriksine doğru yavaş büyüyen, selim, asemptomatik, kutanöz bir tümördür. Normal veya hiperemik deri ile örtülüdür ve genellikle boyut olarak 0.5&apos;ten 3 cm&apos;ye değişir</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pilomatricoma is an asymptomatic slowly growing benign cutaneous tumor, differentiating towards the hair matrix of the hair follicle. It is covered by normal or hyperemic skin, and usually varies in size from 0.5 to 3 cm.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
