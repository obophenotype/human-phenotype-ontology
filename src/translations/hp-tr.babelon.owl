    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0000687">
        <obo:IAO_0000115 xml:lang="tr">Aynı dental arkta yer alan çoğu dişin arasında artmış mesafe (diastema)</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Genişçe yerleşmiş dişler</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000687"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Aynı dental arkta yer alan çoğu dişin arasında artmış mesafe (diastema)</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Increased spaces (diastemata) between most of the teeth in the same dental arch.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
