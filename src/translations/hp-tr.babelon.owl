        <babelon:source_value>Cardiomyocyte degeneration</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0031333">
        <obo:IAO_0000115 xml:lang="tr">Kardiyomiyositlerin sarkomlarının yapısının bozulması. Sarkomer, büyük ölçüde miyozinden oluşan iki Z hattı arasındaki tekrar eden birimdir ve kontraktiliteye aracılık eden eylemdir, ve normalde sarkomerler hücrelerin uzun eksenleri ile hizalanır, Z bantları ile kardiyak miyositlerin uzunluğu boyunca kayıtlı olur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Miyokardiyal sarkomerik düzensizlik</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031333"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="tr">Kardiyomiyositlerin sarkomlarının yapısının bozulması. Sarkomer, büyük ölçüde miyozinden oluşan iki Z hattı arasındaki tekrar eden birimdir ve kontraktiliteye aracılık eden eylemdir, ve normalde sarkomerler hücrelerin uzun eksenleri ile hizalanır, Z bantları ile kardiyak miyositlerin uzunluğu boyunca kayıtlı olur</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>A disruption of the structure of the sarcomeres of cardiomyocytes. The sarcomere is the repeating unit between two Z lines comprised largely of myosin and actin that mediates contractility, and normally sarcomeres are aligned with the long axis of cells, with the Z bands being in register throughout the length of the cardiac myocytes.</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>CANDIDATE</babelon:translation_status>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031333"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Miyokardiyal sarkomerik düzensizlik</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Myocardial sarcomeric disarray</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
