        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <owl:annotatedTarget xml:lang="tr">Plevral mezotelyoma</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Pleural mesothelioma</babelon:source_value>
        <babelon:translation_language>tr</babelon:translation_language>
        <babelon:translation_status>OFFICIAL</babelon:translation_status>
    </owl:Axiom>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/HP_0100003">
        <obo:IAO_0000115 xml:lang="tr">Periton (abdomeni saran ince mezotel tabakası) hücrelerinden köken alan bir malign mezotelyoma. Peritoneal mezotelyoma, plevral mezotelyomanın ardından ikinci en sık mezotelyoma formudur</obo:IAO_0000115>
        <rdfs:label xml:lang="tr">Peritoneal mezotelyoma</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
