property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2023-07-01T10:11:21Z" xsd:dateTime

[Term]
id: HP:0034804
name: Corneal foreign body sensation
def: "A perception that an object is in contact with the eye." []
synonym: "Conjunctival foreign body sensation" EXACT []
synonym: "Foreign body sensation in the eye" EXACT []
is_a: HP:0012373 ! Abnormal eye physiology
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2023-07-01T11:00:20Z" xsd:dateTime

[Term]
id: HP:0034805
name: Buttock pain
def: "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the buttock (round fleshy area at the lower rear area of a human trunk)." []
is_a: HP:0012531 ! Pain
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2023-07-01T11:04:00Z" xsd:dateTime

[Term]
id: HP:0034806
name: Vaginal foreign body sensation
