property_value: terms:contributor https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2023-12-30T23:26:21Z" xsd:dateTime

[Term]
id: HP:6000072
name: Thinning of outer muscular layer of small bowel
def: "The depth of the outer muscular layer of the small bowel is below the lower limit of normal." [PMID:717927]
