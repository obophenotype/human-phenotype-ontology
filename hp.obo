property_value: terms:contributor https://orcid.org/0000-0003-3777-1389
property_value: terms:date "2022-08-29T13:04:27Z" xsd:dateTime

[Term]
id: HP:4000093
name: Ectopic tooth eruption
def: "A condition in which the permanent teeth, because of deficiency of growth in the jaw or segment of jaw, assume a path of eruption that intercepts a primary tooth, causes its premature loss and produces a consequent malposition of the permanent tooth." [PMID:22114445]
is_a: HP:0006292 ! Abnormality of dental eruption
property_value: terms:date "2023-01-16T07:30:03Z" xsd:dateTime

