property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2023-03-26T18:27:07Z" xsd:dateTime

[Term]
id: HP:0034693
name: Reduced hepatic methionine adenosyltransferase activity
