property_value: terms:date "2017-12-17T13:30:31Z" xsd:dateTime

[Term]
id: HP:0031643
name: Fusiform ascending tubular aorta aneurysm
def: "A concentric abnormal localized widening (dilatation) of the ascending tubular aorta that involves the full circumference of the vessel wall." []
