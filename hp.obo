property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2019-01-12T13:45:59Z" xsd:dateTime

[Term]
id: HP:0032181
name: Anomalous hepatic venous drainage into the left atrium
def: "An abnormality of the hepatic veins, which normally drain de-oxygenated blood from the liver into the inferior vena cava, whereby the hepatic veins drain into the left atrium." [PMID:12556263, PMID:16122505, PMID:20552624]
