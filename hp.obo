property_value: terms:date "2010-07-20T11:00:32Z" xsd:dateTime

[Term]
id: HP:0100259
name: Postaxial polydactyly
alt_id: HP:0005808
def: "A form of polydactyly in which the extra digit or digits are localized on the side of the fifth finger or fifth toe." [https://orcid.org/0000-0002-0736-9199]
synonym: "Polydactyly, postaxial" EXACT []
synonym: "Postaxial hexadactyly" EXACT []
is_a: HP:0010442 ! Polydactyly
property_value: terms:creator https://orcid.org/0009-0006-4530-3154
property_value: terms:date "2010-07-20T11:00:32Z" xsd:dateTime

[Term]
id: HP:0100260
name: Mesoaxial polydactyly
def: "The presence of a supernumerary finger or toe (not a thumb or hallux) involving the third or fourth metacarpal/tarsal with associated osseous syndactyly." [PMID:19125433]
