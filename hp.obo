property_value: terms:contributor https://orcid.org/0000-0001-8481-3559
property_value: terms:date "2023-12-14T12:47:02Z" xsd:dateTime

[Term]
id: HP:6000023
name: Lack of sufficient daily physical activity
def: "Physical activity levels less than those required for optimal health and prevention of premature death." [PMID:23798298]
synonym: "physical inactivity" EXACT []
is_a: HP:0032443 ! Past medical history
