def: "A developmental anomaly characterized by undergrowth of the corpus cavernosum." [PMID:21220346]
is_a: HP:0100623 ! Abnormal corpus cavernosum morphology
property_value: terms:date "2023-01-16T07:43:02Z" xsd:dateTime

[Term]
id: HP:4000095
