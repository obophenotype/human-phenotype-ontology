def: "Deposition of calcium salts in the leaflets (cusps) of the aortic valve." [https://orcid.org/0000-0002-4095-8489, PMID:22896576]
synonym: "Aortic cusp calcification" EXACT []
synonym: "Aortic valve cusp calcification" EXACT []
is_a: HP:0004380 ! Aortic valve calcification
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2021-02-03T13:39:04Z" xsd:dateTime

