[Term]
id: HP:0031648
name: Penetrating aortic ulcer
def: "A focal defect in the elastic lamina of the aortic wall that leads to localized medial disruption and potential rupture." []
comment: Pentrating aortic ulcers are typically caused by atherosclerotic lesions.
is_a: HP:0001679 ! Abnormal aortic morphology
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2017-12-17T14:55:54Z" xsd:dateTime

