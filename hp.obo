synonym: "Choroidal hyperpermeability" EXACT []
is_a: HP:0000610 ! Abnormal choroid morphology
is_a: HP:0030605 ! Abnormal indocyanine green angiography
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2017-12-14T13:49:33Z" xsd:dateTime

[Term]
id: HP:0025571
