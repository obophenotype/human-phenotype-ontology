property_value: terms:contributor https://orcid.org/0000-0001-8612-1062
property_value: terms:date "2024-07-06T11:45:23Z" xsd:dateTime

[Term]
id: HP:6000942
name: Thumb hypoplasia grade 4
def: "A type of developmental undergrowth of the thumb characterized by attachment to the hand only by the skin and digital neurovascular structures." [PMID:24362256]
synonym: "Floating thumb" EXACT []
synonym: "Hypoplasia of the thumb grade IV" EXACT []
synonym: "Pouce flottant" EXACT []
