[Term]
id: HP:6001324
name: Exacerbated by colchicine
def: "Applied to a sign or symptom that is worsened by treatment with colchizine." []
synonym: "Colchicine worsens symptoms" EXACT []
is_a: HP:4000176 ! Aggravated by exposure to medication
property_value: IAO:0000233 https://github.com/obophenotype/human-phenotype-ontology/issues/11082
