property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2020-02-09T09:26:16Z" xsd:dateTime

[Term]
id: HP:0032647
name: Renal tubular epithelial cell apoptosis
def: "Increased apoptosis (programmed cell death) of tubular epithelial cells. The cells are rounded with increased eosinophilia and contain fragmented, densely basophilic nuclear debris." [https://orcid.org/0000-0003-2356-950X, PMID:29537990]
