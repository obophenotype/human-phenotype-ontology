property_value: terms:contributor https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2024-02-24T10:53:49Z" xsd:dateTime

[Term]
id: HP:6000350
name: Ameliorated by gastric acid-reducing therapy
def: "Applies to a sign or symptom that is improved or made more bearable by treatment with an agent that reduces gastric acidity such as proton pump inhibitors, histamine receptor blockers,omeprazole, esomeprazole, dexlansoprazole, pantoprazole, lansoprazole, famotidine, or ranitidine." []
