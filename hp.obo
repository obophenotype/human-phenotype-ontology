synonym: "Growth resumption lines" EXACT []
synonym: "Harris lines" EXACT []
is_a: HP:0031367 ! Metaphyseal striations
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2017-06-18T18:03:33Z" xsd:dateTime

[Term]
id: HP:0031165
name: Multifocal seizures
def: "Seizures that start from several different areas of the brain (i.e., with multiple ictal onset locations)." [PMID:27091239]
synonym: "Multifocal onset seizures" EXACT []
is_a: HP:0007359 ! Focal-onset seizure
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2017-06-18T18:13:43Z" xsd:dateTime

[Term]
id: HP:0031166
name: Eyelid myokymia
def: "Involuntary, fine, continuous, undulating contractions of the eyelid." []
synonym: "Myokymia orbicularis" EXACT []
synonym: "Orbicularis myokymia" EXACT []
