is_obsolete: true
consider: HP:0001875

[Term]
id: HP:0005550
name: Chronic lymphatic leukemia
alt_id: HP:0006734
alt_id: HP:0006760
def: "A chronic lymphocytic/lymphatic/lymphoblastic leukemia (CLL) is a neoplastic disease characterized by proliferation and accumulation (blood, marrow and lymphoid organs) of morphologically mature but immunologically dysfunctional lymphocytes. A CLL is always a B-cell lymphocytic leukemia as there are no reports of cases of T-cell lymphocytic leukemias." [https://orcid.org/0000-0002-0736-9199]
synonym: "Chronic lymphatic leukaemia" EXACT uk_spelling []
synonym: "Chronic lymphocytic leukaemia" EXACT uk_spelling []
synonym: "Chronic lymphocytic leukemia" EXACT []
is_a: HP:0005558 ! Chronic leukemia

