property_value: terms:date "2024-02-25T14:23:32Z" xsd:dateTime

[Term]
id: HP:6000386
name: Positive cold agglutinin test
def: "Cold agglutinin are erythrocyte antibodies which possess the property of agglutinating red blood cells at temperatures of below 37 degrees C, this phenomenon is reversible after heating." [PMID:34285751]
