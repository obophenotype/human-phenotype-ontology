property_value: terms:date "2025-03-01T12:20:53Z" xsd:dateTime

[Term]
id: HP:0025802
name: Talipes varus
def: "Inversion of the foot, resulting in the outer side of the sole only touching the ground; usually some degree of talipes equinus is associated with it, and often talipes cavus." [PMID:22887726]
comment: This finding is a component of clubfoot (talipes equinovarus).
synonym: "Pes adductus" EXACT []
synonym: "Pes varus" EXACT []
is_a: HP:0034673 ! Abnormal ankle morphology
is_a: HP:5210430 ! Hindfoot deformity
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2025-03-01T12:22:37Z" xsd:dateTime

[Term]
id: HP:0025803
name: Mucocutaneous lesion painful
def: "Applies to pain that colocalizes with lesions in the skin or mucous membranes." []
synonym: "Skin or mucosal lesions painful" EXACT []
