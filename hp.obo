property_value: terms:date "2009-09-20T09:33:50Z" xsd:dateTime

[Term]
id: HP:0010535
name: Sleep apnea
def: "An intermittent cessation of airflow at the mouth and nose during sleep is known as sleep apnea. Apneas that last at least 10 seconds are considered significant, but individuals with sleep apnea may experience apneas lasting from 20 seconds up to 2 or 3 minutes. Patients may have up to 15 events per hour of sleep." []
synonym: "Pauses in breathing while sleeping" EXACT layperson [https://orcid.org/0000-0002-6548-5200]
synonym: "Sleep apnoea" EXACT []
is_a: HP:5200283 ! Sleep-related breathing disorders
