property_value: terms:contributor https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2023-12-28T15:12:28Z" xsd:dateTime

[Term]
id: HP:6000045
name: Ameliorated by nitroglycerin
def: "Applies to a sign or symptom that is improved or made more bearable by treatment with nitroglycerin." []
is_a: HP:0034536 ! Ameliorated by exposure to medication
property_value: IAO:0000233 https://github.com/obophenotype/human-phenotype-ontology/issues/10131
