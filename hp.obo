property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2012-08-01T01:02:39Z" xsd:dateTime

[Term]
id: HP:0012053
name: Decreased circulating calcifediol concentration
def: "A reduced concentration of calcifediol in the blood. Calcifediol is also known as calcidiol, 25-hydroxycholecalciferol and 25-Hydroxyvitamin D3." [https://orcid.org/0000-0002-0736-9199]
synonym: "Decreased 25-hydroxyvitamin D3" EXACT []
synonym: "Low serum 25-hydroxycholecalciferol" EXACT []
synonym: "Low serum calcidiol" EXACT []
synonym: "Low serum calcifediol" EXACT []
