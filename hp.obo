property_value: terms:contributor https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2024-02-24T10:53:49Z" xsd:dateTime

[Term]
id: HP:6000365
name: Brown pigmentation of the conjunctiva
def: "Deposition of brown pigmentation in the conjunctiva." [PMID:15249376, PMID:20301627]
comment: This feature is a manifestation of alkaptonuria.
is_a: HP:0000502 ! Abnormal conjunctiva morphology
