property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2016-11-14T02:33:27Z" xsd:dateTime

[Term]
id: HP:0025129
name: Abnormal small intestinal mucosa morphology
def: "A structural anomaly of the mucous lining of the small intestine." []
is_a: HP:0002244 ! Abnormal small intestine morphology
