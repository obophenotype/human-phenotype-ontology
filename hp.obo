property_value: terms:date "2018-06-22T14:04:14Z" xsd:dateTime

[Term]
id: HP:0500107
name: Isolated diastolic hypotension
def: "A decrease in diastolic blood pressure (<60 mmHg) without a decrease in systolic blood pressure (> or = to 100 mmHg)." [PMID:21947466]
comment: Isolated diastolic hypotension is a risk factor for incident heart failure. {xref="PMID:21947466"}
is_a: HP:0500104 ! Decreased diastolic blood pressure
