synonym: "Illusory aura" EXACT []
synonym: "Illusory auras" EXACT plural_form []
is_a: HP:0032680 ! Focal cognitive seizure
is_a: HP:0033347 ! Cognitive epileptic aura
property_value: terms:creator https://orcid.org/0000-0002-6996-5279
property_value: terms:date "2012-07-20T11:57:32Z" xsd:dateTime

