property_value: terms:contributor https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2024-07-05T10:44:08Z" xsd:dateTime

[Term]
id: HP:6000927
name: Positive CSF Borrelia burgdorferi antibody positivity
def: "The presence of antibodies in the cerebrospinal fluid (CSF) that react against a component of Borrelia burgdorferi." []
is_a: HP:0430139 ! CSF pathogen-specific antibody positivity
