property_value: terms:date "2021-06-24T12:29:21Z" xsd:dateTime

[Term]
id: HP:0033957
name: Cortical radial artery neutrophil hypercellularity
def: "A type of cortical radial artery endoarterial leukocyte hypercellularity due to the presence of increased numbers of neutrophils in the lumen of cortical radial arteries." []
synonym: "Endocapillary hypercellularity within interlobular arterial endothelium consisting of neutrophils" EXACT []
