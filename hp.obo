id: HP:0033530
name: Increased cardiac index
def: "An elevated cardiac index, defined as cardiac output divided by body surface area." [https://orcid.org/0000-0002-4095-8489, PMID:30969727]
is_a: HP:0033529 ! Abnormal cardiac index
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2021-01-15T12:53:42Z" xsd:dateTime

