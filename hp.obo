[Term]
id: HP:0100267
name: Lip pit
def: "A depression located on a lip." [https://orcid.org/0000-0002-0736-9199]
is_a: HP:0000159 ! Abnormal lip morphology
is_a: HP:0100276 ! Skin pit
property_value: terms:creator https://orcid.org/0009-0006-4530-3154
