property_value: terms:date "2016-12-18T15:18:09Z" xsd:dateTime

[Term]
id: HP:0025280
name: Pain characteristic
def: "A pain characteristic is defined as a subjective category or type of pain." []
is_a: HP:0012823 ! Clinical modifier
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2016-12-18T15:21:51Z" xsd:dateTime

[Term]
id: HP:0025281
name: Sharp
def: "Applied to pain that is described as sharp, i.e., sudden and severe." []
synonym: "Stabbing pain" EXACT []
is_a: HP:0025280 ! Pain characteristic
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2016-12-18T15:23:03Z" xsd:dateTime

[Term]
id: HP:0025282
name: Dull
def: "Applied to pain that is dull, i.e., not severe but that continues over a long period of time." []
synonym: "Dull pain" EXACT []
is_a: HP:0025280 ! Pain characteristic
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2016-12-18T15:23:43Z" xsd:dateTime

[Term]
id: HP:0025283
name: Tender
def: "Applied to pain that is tender, i.e., elicited by touching the affected body part." []
is_a: HP:0025280 ! Pain characteristic
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2016-12-18T15:25:03Z" xsd:dateTime

[Term]
id: HP:0025284
name: Sleep-interrupting
def: "Applied to pain that wakes the affecting individual from sleep." []
is_a: HP:0025280 ! Pain characteristic
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2016-12-18T15:26:21Z" xsd:dateTime

[Term]
id: HP:0025285
name: Aggravated by
def: "An aggravating factor is defined as an external factor that leads to a sign or symptom that is already present getting worse or becoming more severe." []
synonym: "Exacerbated by" EXACT []
is_a: HP:0012823 ! Clinical modifier
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2016-12-18T15:29:42Z" xsd:dateTime

[Term]
id: HP:0025286
name: Aggravated by activity
def: "Applied to a sign or symptom that is aggravated by activity, exertion, or exercise." []
synonym: "Aggravated by exercise" EXACT []
synonym: "Aggravated by exertion" EXACT []
synonym: "Worse with activity" EXACT []
synonym: "Worsened by activity" EXACT []
