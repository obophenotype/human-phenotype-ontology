property_value: terms:date "2021-05-02T20:07:50Z" xsd:dateTime

[Term]
id: HP:4000037
name: Congenital hydrocele
def: "Congenital hydrocele occurs when processus vaginalis is patent and communicates with the peritoneal cavity. This communication allows the movement of peritoneal fluid but is too small to allow the intra-abdominal contents to herniate through." [PMID:32644551]
is_a: HP:0000034 ! Hydrocele testis
