property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2018-05-04T02:39:32Z" xsd:dateTime

[Term]
id: HP:0031834
name: Aortopulmonary collateral arteries
def: "Small ectopic arteries or arterial branches that connect the aorta, aortic branches and/or subclavian artery regions directly to the lung parenchyma, usually seen in conjunction with pulmonary atresia, ventricular septal defect (VSD) and/or closed ductus arteriosus." [MP:0010635, PMID:26467877]
is_a: HP:0001679 ! Abnormal aortic morphology
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2018-05-04T03:10:02Z" xsd:dateTime

[Term]
id: HP:0031835
name: Abnormal circulating superoxide dismutase activity
def: "Concentration or activity of superoxide dismutase is above or below the limits of normal in the blood circulation." [HPO_CONTRIBUTOR:RGD_gthayman, PMID:25276767]
comment: Superoxidase dismutase catalyzes the reaction: 2 superoxide + 2 H+ = O2 + hydrogen peroxide.
synonym: "Abnormal superoxide dismutase level" EXACT []
synonym: "Abnormal superoxide:superoxide oxidoreductase activity" EXACT []
