property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2017-12-16T12:58:27Z" xsd:dateTime

[Term]
id: HP:0031615
name: Hypopyon
def: "Presence of pus (appears as a white fluid) producing a fluid level in the inferior part of the anterior chamber." []
