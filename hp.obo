name: Orthodeoxia
def: "Low level of blood oxygen induced by changing from a recumbent to an upright position." [https://orcid.org/0000-0003-0113-912X, PMID:27669319]
is_a: HP:0012418 ! Hypoxemia
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2020-12-16T11:53:55Z" xsd:dateTime

