property_value: terms:contributor https://orcid.org/0000-0001-9042-0508
property_value: terms:date "2025-08-31T17:29:42Z" xsd:dateTime

[Term]
id: HP:6001302
name: Aphakia
def: "Absence of the crystalline lens in the eye, which may be congenital or acquired (e.g., following surgical removal of the lens for cataracts or trauma)." []
