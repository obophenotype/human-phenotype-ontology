def: "Seizure precipitated by listening to music or other complex sounds." [PMID:11422340]
is_a: HP:0020207 ! Reflex seizure
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2020-03-18T14:11:19Z" xsd:dateTime

