synonym: "Increased superoxide dismutase level" EXACT []
synonym: "Increased superoxide:superoxide oxidoreductase activity" EXACT []
is_a: HP:0031835 ! Abnormal circulating superoxide dismutase activity
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2018-05-05T13:01:09Z" xsd:dateTime

