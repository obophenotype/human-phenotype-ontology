property_value: terms:contributor https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2024-02-10T18:56:37Z" xsd:dateTime

[Term]
id: HP:6000288
name: Deep neck abscess
def: "An abscess (i.e., a circumscribed area of pus or necrotic debris) localized in the area surrounded by the deep fascia of the neck including the pharynx, larynx, trachea, upper esophagus, thyroid, and parathyroid glands. Infections of pharyngeal, tonsillar, and laryngeal origin affect this space, which includes the parapharyngeal and retropharyngeal spaces." [PMID:30020634]
is_a: HP:0025615 ! Abscess
property_value: IAO:0000233 https://github.com/obophenotype/human-phenotype-ontology/issues/9017
property_value: terms:contributor https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2024-02-10T18:56:37Z" xsd:dateTime

[Term]
id: HP:6000289
name: Epiglottic enlargement
def: "Anlarged and edematous epiglottis. This sign can be observed on a lateral radiograph of the neck and it suggests a diagnosis of acute infectious epiglottitis." [PMID:21812674]
synonym: "Epiglottis thumb sign" EXACT []
synonym: "Swollen epiglottis" EXACT []
is_a: HP:0005483 ! Abnormal epiglottis morphology
property_value: IAO:0000233 https://github.com/obophenotype/human-phenotype-ontology/issues/9018
property_value: terms:contributor https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2024-02-10T18:56:37Z" xsd:dateTime

[Term]
id: HP:6000290
name: Prevertebral space enlargement
def: "Increase in the anterior posterior dimension of the prevertebral space, which is located in the neck region between the anterior part of the cervical spine and the deep layer of the deep cervical fascia running between the transverse processes of the spine." [PMID:19001541]
synonym: "Increased pre-vertebral space" EXACT []
is_a: HP:0033151 ! Abnormal pharynx morphology
