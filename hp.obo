property_value: terms:date "2018-09-16T11:50:05Z" xsd:dateTime

[Term]
id: HP:0032061
name: Severely increased total eosinophil count
def: "Severe increase in circulating eosinophils, usually characterized as more than 1500 eosinophils per microlitre." [PMID:20538328]
comment: Typically eosinophils in the blood are less than 0.5 billion cells per liter, corresponding to less than 5 percent of leukocytes. This term refers to a marked degree of eosinophilia with more than 1.5 billion cells per liter.
synonym: "Hypereosinophilia" EXACT []
is_a: HP:0001880 ! Increased total eosinophil count
property_value: terms:creator https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2018-09-16T11:54:44Z" xsd:dateTime

