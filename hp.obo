property_value: terms:contributor https://orcid.org/0009-0005-6714-5727
property_value: terms:date "2024-07-01T09:06:35Z" xsd:dateTime

[Term]
id: HP:6000883
name: Recent history of sedation by propofol infusion
def: "A history of exposure to anesthesia by propofanol infusion recently before the presenting complaint." [PMID:17567345]
comment: Propofol is commonly used in anaesthesia and in intensive care where its favourable pharmacokinetics and rapidly reversible sedation make it an ideal drug for short-term sedation. However, propofol has been associated with a number of serious adverse effects such as metabolic acidosis, cardiac asystole, myocardial failure, rhabdomyolysis, and death.
is_a: HP:4000144 ! Recent past medical history
property_value: IAO:0000233 https://github.com/obophenotype/human-phenotype-ontology/issues/10268
property_value: terms:contributor https://orcid.org/0000-0002-0736-9199
property_value: terms:date "2024-07-01T10:01:12Z" xsd:dateTime

